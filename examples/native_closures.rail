-- native_closures.rail — tests closures and higher-order functions in native codegen
--
-- KNOWN BROKEN: prints 10 and 15 (named-function application works), then
-- segfaults at the first partial application (make_adder 10) -- the closure
-- path crashes, so the last two prints never run (exit 139 when the compiled
-- binary is run directly).
-- Reproduce: ./rail_native run examples/native_closures.rail
-- Working closures: examples/closures.rail. Tracked in examples/README.md.

double : i32 -> i32
double x = x * 2

triple : i32 -> i32
triple x = x * 3

apply : (i32 -> i32) -> i32 -> i32
apply f x = f x

make_adder : i32 -> i32 -> i32
make_adder n x = n + x

main =
  let _ = print (apply double 5)
  let _ = print (apply triple 5)
  let _ = print (apply (make_adder 10) 5)
  let _ = print (apply (make_adder 100) 7)
  0
