-- examples/m4_systick.rail
-- SysTick interrupt-driven counter, qemu-verifiable.
-- ISR increments a counter at a fixed SRAM address. main configures SysTick,
-- busy-waits via bounded recursion (gives interrupts time to fire), then
-- prints the counter and exits.
--
-- Run:  tools/garmin/m4_qemu.sh examples/m4_systick.rail
-- Expected: prints a non-zero count, exits 0.

write_char c = mmio_write 0x40004000 c
init_uart    = mmio_write 0x40004008 1
newline      = write_char 10

print_digit d = write_char (48 + d)
print_int n =
  if n < 10 then print_digit n
  else
    let n10 = n / 10 in
    let _ = print_int n10 in
    print_digit (n - n10 * 10)

counter_addr = 0x20000000

SYSTICK_CTRL = 0xE000E010
SYSTICK_LOAD = 0xE000E014

-- ISR: increment counter on each tick.
SysTick_Handler =
  let cur = mmio_read counter_addr in
  mmio_write counter_addr (cur + 1)

-- Bounded countdown to give SysTick time to fire several times.
-- Without TCO each call adds a stack frame; bounded depth keeps us safe.
delay n = if n <= 0 then 0 else delay (n - 1)

main =
  let _ = init_uart in
  let _ = mmio_write counter_addr 0 in
  let _ = mmio_write SYSTICK_LOAD 100 in
  let _ = mmio_write SYSTICK_CTRL 7 in
  let _ = delay 5000 in
  let n = mmio_read counter_addr in
  let _ = print_int n in
  let _ = newline in
  0
