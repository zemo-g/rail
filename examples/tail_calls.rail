-- tail_calls.rail — tail call optimization
--
-- Demonstrates: TCO enables constant-stack recursion on deep call chains.
-- Without TCO these would stack overflow.
--
-- KNOWN BROKEN: the first two demos print correctly (0, then
-- 500000500000), then the gcd demo never terminates (confirmed
-- 2026-06-10: 70 CPU-minutes before SIGKILL). Root cause, from the
-- disassembly: division inside a tail-recursive self-call argument
-- re-enters the loop TAGGED -- the self-loop fallback computes the
-- arg with generic tagged codegen (lsl/orr, sdiv, retag) and moves
-- it into the raw untagged loop register without untagging, so n
-- becomes 2*(n/2)+1 and never reaches 0.
-- Minimal repro (hangs):  cnt n = if n == 0 then 0 else cnt (n / 2)
-- Workaround (verified): hoist the division into a helper function --
--   mod_ a b = a - ((a / b) * b)
--   gcd a b = if b == 0 then a else gcd b (mod_ a b)   -- prints 6, 21
-- Working TCO receipt: examples/tco_test.rail (0 / 500000500000).
-- Tracked in examples/README.md and docs/site/TODO.md.

-- Count down from n to 0
countDown n =
  if n == 0 then 0 else countDown (n - 1)

-- Sum 1..n with accumulator (tail-recursive)
sumAcc n acc =
  if n == 0 then acc else sumAcc (n - 1) (acc + n)

-- GCD via Euclid's algorithm (tail-recursive)
gcd a b =
  if b == 0 then a
  else gcd b (a - ((a / b) * b))

main =
  -- Deep recursion (1 million calls — would overflow without TCO)
  let _ = print (show (countDown 1000000))

  -- Sum of 1..1000000 = 500000500000
  let _ = print (show (sumAcc 1000000 0))

  -- GCD
  let _ = print (show (gcd 48 18))
  let _ = print (show (gcd 1071 462))

  0
