-- examples/m4_uart_echo.rail
-- Bare-metal Cortex-M4: read N bytes from UART RX, echo each byte to TX.
-- Demonstrates UART input + bit_and intrinsic + busy-wait polling.
--
-- Run:  printf 'Rail!' | tools/garmin/m4_qemu.sh examples/m4_uart_echo.rail
-- Expected: qemu prints 'Rail!' (the echoed bytes), exits 0.

write_char c = mmio_write 0x40004000 c

-- CTRL bit 0 = TX enable, bit 1 = RX enable. Set both.
init_uart = mmio_write 0x40004008 3

-- STATE bit 1 = RX-buffer-full. mmio_read returns the whole word; mask it.
rx_ready = bit_and (mmio_read 0x40004004) 2

-- Busy-wait until RX has a byte, then read DATA. Returns the byte.
read_char =
  if rx_ready == 0 then read_char
  else mmio_read 0x40004000

echo_loop n =
  if n <= 0 then 0
  else
    let c = read_char in
    let _ = write_char c in
    echo_loop (n - 1)

main =
  let _ = init_uart in
  echo_loop 5
