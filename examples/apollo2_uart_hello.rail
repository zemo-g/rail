-- examples/apollo2_uart_hello.rail
-- Send "RailOS\n" out Apollo2 UART0 at 115200 8N1.
--
-- Build:  ./rail_native cortexm examples/apollo2_uart_hello.rail
-- Verify: objdump shape only; qemu's mps2-an386 has different UART map.
-- Hardware day: connect 3.3V USB-serial RX to the Instinct's UART0 TX pad.
--
-- Register map cross-checked against
--   github.com/sparkfun/AmbiqSuiteSDK/blob/master/mcu/apollo2/regs/am_reg_uart.h
-- on 2026-05-08.
--
-- KNOWN GAPS:
-- 1. PADREG funcsel not configured: assumes Apollo2 reset-default UART pin mux.
--    Real Instinct PCB may route UART0 to non-default pins; needs FW RE.
-- 2. Baud computed for HFRC=48 MHz (Apollo2 nominal). If Garmin's CLKGEN sets a
--    divided core clock, baud will be off by that factor — visible as garbled
--    serial output. Switch to a slower baud (9600) and/or scope the line to
--    measure actual baud, then back-solve clock.
-- 3. No TX polling: 32-byte FIFO swallows the 7-byte message from cold boot.
--    Longer messages need a polling helper (no while-loops in Rail yet; needs
--    either iterative construct or bounded-depth wrapper).

-- ---------- Apollo2 UART0 register addresses ----------

UART0_DR    = 0x4001C000
UART0_FR    = 0x4001C018
UART0_IBRD  = 0x4001C024
UART0_FBRD  = 0x4001C028
UART0_LCRH  = 0x4001C02C
UART0_CR    = 0x4001C030

-- 115200 baud at HFRC 48 MHz: 48e6 / (16 * 115200) = 26.0417
-- IBRD = 26, FBRD = round(0.0417 * 64) = 3
UART_IBRD_VAL = 26
UART_FBRD_VAL = 3

-- LCRH: WLEN=8 (bits 6:5 = 11 → 0x60) + FEN (bit 4 → 0x10) = 0x70
UART_LCRH_8N1_FIFO = 0x70

-- CR: UARTEN (bit 0) + TXE (bit 8) = 0x101
UART_CR_TX_ENABLE  = 0x101

-- ---------- Init + write ----------

uart_init =
  let _ = mmio_write UART0_CR 0 in
  let _ = mmio_write UART0_IBRD UART_IBRD_VAL in
  let _ = mmio_write UART0_FBRD UART_FBRD_VAL in
  let _ = mmio_write UART0_LCRH UART_LCRH_8N1_FIFO in
  mmio_write UART0_CR UART_CR_TX_ENABLE

uart_putc c = mmio_write UART0_DR c

main =
  let _ = uart_init in
  let _ = uart_putc 82 in   -- 'R'
  let _ = uart_putc 97 in   -- 'a'
  let _ = uart_putc 105 in  -- 'i'
  let _ = uart_putc 108 in  -- 'l'
  let _ = uart_putc 79 in   -- 'O'
  let _ = uart_putc 83 in   -- 'S'
  let _ = uart_putc 10 in   -- '\n'
  spin 0

spin n = spin (n + 1)
