-- Higher-order, pipes, real I/O
add a b = a + b
gt3 x = x > 3

main =
  let _ = print (show (fold add 0 (range 101)))              -- 5050
  let _ = print (show (length (filter gt3 [1,2,3,4,5,6])))   -- 3
  let _ = write_file "/tmp/out.txt" "hello"
  let _ = print (read_file "/tmp/out.txt")                   -- hello
  0
