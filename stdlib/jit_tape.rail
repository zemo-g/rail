-- stdlib/jit_tape.rail — JIT op-DAG tracer wrappers.
--
-- Phase 2.7 split (2026-05-15): types + tape primitives moved to
-- stdlib/jit_node.rail.  This file holds only the traced_* wrappers
-- that need stdlib/transformer.rail for rmsnorm_save / tensor_matmul.
-- Consumers that just need the DAG structure (jit_match, jit_emit)
-- should import jit_node directly to avoid the transformer dependency
-- chain.

import "stdlib/jit_node.rail"
import "stdlib/transformer.rail"

-- Wrap an existing Tensor as a leaf TracedTensor.  Pushes a "leaf" node
-- onto the tape that codegen treats as a kernel input buffer.
jit_leaf tape t dtype = match t
  | Tensor d s _ ->
    let node = JitNode "leaf" s dtype []
    let res = jit_tape_push tape node
    let new_tape = head res
    let idx = head (tail res)
    cons new_tape (cons (Traced t idx) [])

-- traced_rmsnorm: trace + execute rmsnorm.  Returns updated tape + a
-- TracedTensor for the y output (rstd is dropped for now; Phase 3 may
-- need it as a separate tape entry for backward).
traced_rmsnorm tape x g dtype = match x
  | Traced x_val x_idx -> match g
    | Traced g_val g_idx ->
      let pack = rmsnorm_save x_val g_val
      let y = head pack
      let y_shape = match y | Tensor _ s _ -> s
      let parents = cons x_idx (cons g_idx [])
      let node = JitNode "rmsnorm" y_shape dtype parents
      let res = jit_tape_push tape node
      let new_tape = head res
      let idx = head (tail res)
      cons new_tape (cons (Traced y idx) [])

-- traced_matmul: trace + execute (default f64) matmul.
traced_matmul tape a b dtype = match a
  | Traced a_val a_idx -> match b
    | Traced b_val b_idx ->
      let c = tensor_matmul a_val b_val
      let c_shape = match c | Tensor _ s _ -> s
      let parents = cons a_idx (cons b_idx [])
      let node = JitNode "matmul" c_shape dtype parents
      let res = jit_tape_push tape node
      let new_tape = head res
      let idx = head (tail res)
      cons new_tape (cons (Traced c idx) [])
