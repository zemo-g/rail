-- Rail GPT — softmax + cross-entropy loss/gradient twin (Phase 3, importable, no main).
--
-- Verbatim from the certified FAST engine softmax (sm_max/sm_exp/sm_norm, F=24,
-- bx4_exp_neg for exp(x-max)). CE gradient wrt logits is the fused softmax-minus-
-- onehot form dl[i] = p[i] - [i==target]*ONE (the numerically stable combined grad).

import "stdlib/gpt/gpt_optim.rail"

gp_sm_max lg n i m = if i >= n then m else gp_sm_max lg n (i + 1) (let v = arr_get lg i in if v > m then v else m)
gp_sm_exp lg ex n m i sum = if i >= n then sum else let e = bx4_exp_neg (m - (arr_get lg i)) in let _ = arr_set ex i e in gp_sm_exp lg ex n m (i + 1) (sum + e)
gp_sm_norm ex p n sum i = if i >= n then 0 else let _ = arr_set p i (((arr_get ex i) * 16777216) / sum) in gp_sm_norm ex p n sum (i + 1)

-- softmax logits[n] -> p[n] (ex is scratch[n]); returns the exp-sum.
gp_softmax lg ex p n =
  let m = gp_sm_max lg n 1 (arr_get lg 0) in
  let sum = gp_sm_exp lg ex n m 0 0 in
  let _ = gp_sm_norm ex p n sum 0 in sum

-- CE gradient wrt logits: dl[i] = p[i] - onehot(target)[i].
gp_ce_grad p dl n target i =
  if i >= n then 0
  else let _ = arr_set dl i ((arr_get p i) - (if i == target then 16777216 else 0)) in gp_ce_grad p dl n target (i + 1)

-- CE loss proxy in F=24: -ln(p[target]). Uses a fixed-point ln via -exp^-1 is awkward;
-- instead we report p[target] directly (rises to ONE as loss -> 0) -- exact, no ln needed.
gp_ptarget p target = arr_get p target
