-- Rail GPT — backward-pass op twins (Phase 3b, importable, no main).
--
-- Verbatim from the certified backward demos (attested_backward_demo act-9/10,
-- GPU==CPU byte-exact). W stored [out,in] row-major (same raw convention as the
-- forward). All rescales floor via mul_shr, matching the GPU shift.

import "stdlib/gpt/gpt_loss.rail"

-- linear backward: dx = W^T . dy   (dx length in_d; W[o*in_d+i]).
gp_mbwd_col W dy out_d in_d i o acc =
  if o >= out_d then acc
  else gp_mbwd_col W dy out_d in_d i (o + 1) (acc + (arr_get W (o * in_d + i)) * (arr_get dy o))
gp_mbwd_dx W dy dx out_d in_d i =
  if i >= in_d then 0
  else let _ = arr_set dx i (mul_shr (gp_mbwd_col W dy out_d in_d i 0 0) 1 24) in gp_mbwd_dx W dy dx out_d in_d (i + 1)

-- weight gradient (single token): dW[o*in_d+i] = dy[o] * x[i].
gp_wgrad dy x dW out_d in_d o i =
  if o >= out_d then 0
  else if i >= in_d then gp_wgrad dy x dW out_d in_d (o + 1) 0
  else let _ = arr_set dW (o * in_d + i) (mul_shr (arr_get dy o) (arr_get x i) 24) in gp_wgrad dy x dW out_d in_d o (i + 1)

-- weight gradient accumulate (adds into dW, for multi-token / minibatch).
gp_wgrad_acc dy x dW out_d in_d o i =
  if o >= out_d then 0
  else if i >= in_d then gp_wgrad_acc dy x dW out_d in_d (o + 1) 0
  else let _ = arr_set dW (o * in_d + i) ((arr_get dW (o * in_d + i)) + (mul_shr (arr_get dy o) (arr_get x i) 24)) in gp_wgrad_acc dy x dW out_d in_d o (i + 1)

-- GELU backward: dx[i] = dy[i] * gelu'(x[i])   (bx4_gelu_grad from bx_fixed).
gp_gelu_bwd dy x dx n i =
  if i >= n then 0
  else let _ = arr_set dx i (mul_shr (arr_get dy i) (bx4_gelu_grad (arr_get x i)) 24) in gp_gelu_bwd dy x dx n (i + 1)

-- residual backward is just gradient pass-through (add): handled by gp_addinto in the
-- forward module; dResidual = dOut for both branches (accumulate at the split).
