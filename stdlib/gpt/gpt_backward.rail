-- Rail GPT — backward-pass op twins (Phase 3b, importable, no main).
--
-- Verbatim from the certified backward demos (attested_backward_demo act-9/10,
-- GPU==CPU byte-exact). W stored [out,in] row-major (same raw convention as the
-- forward). All rescales floor via mul_shr, matching the GPU shift.

import "stdlib/gpt/gpt_loss.rail"

-- linear backward: dx = W^T . dy   (dx length in_d; W[o*in_d+i]).
gp_mbwd_col W dy out_d in_d i o acc =
  if o >= out_d then acc
  else gp_mbwd_col W dy out_d in_d i (o + 1) (acc + (arr_get W (o * in_d + i)) * (arr_get dy o))
gp_mbwd_dx W dy dx out_d in_d i =
  if i >= in_d then 0
  else let _ = arr_set dx i (mul_shr (gp_mbwd_col W dy out_d in_d i 0 0) 1 24) in gp_mbwd_dx W dy dx out_d in_d (i + 1)

-- weight gradient (single token): dW[o*in_d+i] = dy[o] * x[i].
gp_wgrad dy x dW out_d in_d o i =
  if o >= out_d then 0
  else if i >= in_d then gp_wgrad dy x dW out_d in_d (o + 1) 0
  else let _ = arr_set dW (o * in_d + i) (mul_shr (arr_get dy o) (arr_get x i) 24) in gp_wgrad dy x dW out_d in_d o (i + 1)

-- weight gradient accumulate (adds into dW, for multi-token / minibatch).
gp_wgrad_acc dy x dW out_d in_d o i =
  if o >= out_d then 0
  else if i >= in_d then gp_wgrad_acc dy x dW out_d in_d (o + 1) 0
  else let _ = arr_set dW (o * in_d + i) ((arr_get dW (o * in_d + i)) + (mul_shr (arr_get dy o) (arr_get x i) 24)) in gp_wgrad_acc dy x dW out_d in_d o (i + 1)

-- GELU backward: dx[i] = dy[i] * gelu'(x[i])   (bx4_gelu_grad from bx_fixed).
gp_gelu_bwd dy x dx n i =
  if i >= n then 0
  else let _ = arr_set dx i (mul_shr (arr_get dy i) (bx4_gelu_grad (arr_get x i)) 24) in gp_gelu_bwd dy x dx n (i + 1)

-- residual backward is just gradient pass-through (add): handled by gp_addinto in the
-- forward module; dResidual = dOut for both branches (accumulate at the split).

-- ===== LayerNorm backward (dx) -- verbatim from attested_ln_bwd_demo act-17 =====
-- dxhat_i = dy_i*g_i ; dx_i = inv*(dxhat_i - mean(dxhat) - xhat_i*mean(dxhat*xhat))
gp_lnb_sum1 g dy base d i acc =
  if i >= d then acc else gp_lnb_sum1 g dy base d (i + 1) (acc + (mul_shr (arr_get dy (base + i)) (arr_get g i) 24))
gp_lnb_sum2 x g dy base d mean inv i acc =
  if i >= d then acc
  else let xhat = mul_shr ((arr_get x (base + i)) - mean) inv 24 in
       let dxh = mul_shr (arr_get dy (base + i)) (arr_get g i) 24 in
       gp_lnb_sum2 x g dy base d mean inv (i + 1) (acc + (mul_shr dxh xhat 24))
gp_lnb_dxrow x g dy dxo base d mean inv m1 m2 i =
  if i >= d then 0
  else let xhat = mul_shr ((arr_get x (base + i)) - mean) inv 24 in
       let dxh = mul_shr (arr_get dy (base + i)) (arr_get g i) 24 in
       let _ = arr_set dxo (base + i) (mul_shr inv (dxh - m1 - (mul_shr xhat m2 24)) 24) in
       gp_lnb_dxrow x g dy dxo base d mean inv m1 m2 (i + 1)
-- one token row [base..base+d): x input, g gamma, dy grad-out -> dxo grad-in.
gp_ln_bwd_dx x g dy dxo base d eps =
  let mean = (gp_ln_sum x base d 0 0) / d in
  let var = (gp_ln_var x base d mean 0 0) / d in
  let inv = gfx_fxrsqrt (var + eps) in
  let m1 = (gp_lnb_sum1 g dy base d 0 0) / d in
  let m2 = (gp_lnb_sum2 x g dy base d mean inv 0 0) / d in
  gp_lnb_dxrow x g dy dxo base d mean inv m1 m2 0

gp_zero a n i = if i >= n then 0 else let _ = arr_set a i 0 in gp_zero a n (i + 1)

-- ===== causal MHA backward (dQ/dK/dV) -- verbatim from attested_attn_bwd_demo act-18 =====
-- dp[i,j]=sum_c dO[i,c]V[j,c]; dsc=p*(dp-sum p*dp); draw=dsc*SCALEQ/S;
-- dQ[i,c]=sum_{j<=i} draw*K[j,c]; dK[j,c]+=sum_{i>=j} draw*Q[i,c]; dV[j,c]+=sum_{i>=j} dO[i,c]*p[i,j].
-- scaleq passed in (= round(2^24/sqrt(hd))). Reuses forward ga_scores/ga_rowmax/ga_exprow.
gab_fillp ex p sum i j = if j > i then 0 else let _ = arr_set p j (((arr_get ex j) * 16777216) / sum) in gab_fillp ex p sum i (j + 1)
gab_dpc dO v i j qb hd qdim c acc = if c >= hd then acc else gab_dpc dO v i j qb hd qdim (c + 1) (acc + (mul_shr (arr_get dO (i * qdim + qb + c)) (arr_get v (j * qdim + qb + c)) 24))
gab_filldp dO v dp i qb hd qdim j = if j > i then 0 else let _ = arr_set dp j (gab_dpc dO v i j qb hd qdim 0 0) in gab_filldp dO v dp i qb hd qdim (j + 1)
gab_dot p dp i j acc = if j > i then acc else gab_dot p dp i (j + 1) (acc + (mul_shr (arr_get p j) (arr_get dp j) 24))
gab_filldraw p dp draw dot i scaleq j = if j > i then 0 else let ds = mul_shr (arr_get p j) ((arr_get dp j) - dot) 24 in let _ = arr_set draw j ((ds * scaleq) / 16777216) in gab_filldraw p dp draw dot i scaleq (j + 1)
gab_dqc draw k i qb hd qdim c j acc = if j > i then acc else gab_dqc draw k i qb hd qdim c (j + 1) (acc + (mul_shr (arr_get draw j) (arr_get k (j * qdim + qb + c)) 24))
gab_dq draw k dQ i qb hd qdim c = if c >= hd then 0 else let _ = arr_set dQ (i * qdim + qb + c) (gab_dqc draw k i qb hd qdim c 0 0) in gab_dq draw k dQ i qb hd qdim (c + 1)
gab_dk_c draw q dK i j qb hd qdim c = if c >= hd then 0 else let idx = (j * qdim + qb + c) in let _ = arr_set dK idx ((arr_get dK idx) + (mul_shr (arr_get draw j) (arr_get q (i * qdim + qb + c)) 24)) in gab_dk_c draw q dK i j qb hd qdim (c + 1)
gab_dk draw q dK i qb hd qdim j = if j > i then 0 else let _ = gab_dk_c draw q dK i j qb hd qdim 0 in gab_dk draw q dK i qb hd qdim (j + 1)
gab_dv_c dO p dV i j qb hd qdim c = if c >= hd then 0 else let idx = (j * qdim + qb + c) in let _ = arr_set dV idx ((arr_get dV idx) + (mul_shr (arr_get dO (i * qdim + qb + c)) (arr_get p j) 24)) in gab_dv_c dO p dV i j qb hd qdim (c + 1)
gab_dv dO p dV i qb hd qdim j = if j > i then 0 else let _ = gab_dv_c dO p dV i j qb hd qdim 0 in gab_dv dO p dV i qb hd qdim (j + 1)
gab_head q k v dO sc ex p dp draw dQ dK dV i h qdim hd seqL scaleq =
  let _ = ga_scores q k sc i h qdim hd seqL scaleq 0 in
  let m = ga_rowmax sc seqL 1 (arr_get sc 0) in
  let sum = ga_exprow sc ex seqL m 0 0 in
  let qb = h * hd in
  let _ = gab_fillp ex p sum i 0 in
  let _ = gab_filldp dO v dp i qb hd qdim 0 in
  let dot = gab_dot p dp i 0 0 in
  let _ = gab_filldraw p dp draw dot i scaleq 0 in
  let _ = gab_dq draw k dQ i qb hd qdim 0 in
  let _ = gab_dk draw q dK i qb hd qdim 0 in
  let _ = gab_dv dO p dV i qb hd qdim 0 in 0
gab_heads q k v dO sc ex p dp draw dQ dK dV i nh qdim hd seqL scaleq h = if h >= nh then 0 else let _ = gab_head q k v dO sc ex p dp draw dQ dK dV i h qdim hd seqL scaleq in gab_heads q k v dO sc ex p dp draw dQ dK dV i nh qdim hd seqL scaleq (h + 1)
gab_tokens q k v dO sc ex p dp draw dQ dK dV nh qdim hd seqL scaleq i = if i >= seqL then 0 else let _ = gab_heads q k v dO sc ex p dp draw dQ dK dV i nh qdim hd seqL scaleq 0 in gab_tokens q k v dO sc ex p dp draw dQ dK dV nh qdim hd seqL scaleq (i + 1)

-- wrapper: zero dQ/dK/dV, then run. q,k,v,dO,dQ,dK,dV : [seqL*qdim]; sc,ex,p,dp,draw : [seqL].
gp_attn_bwd q k v dO sc ex p dp draw dQ dK dV nh qdim hd seqL scaleq =
  let _ = gp_zero dQ (seqL * qdim) 0 in let _ = gp_zero dK (seqL * qdim) 0 in let _ = gp_zero dV (seqL * qdim) 0 in
  gab_tokens q k v dO sc ex p dp draw dQ dK dV nh qdim hd seqL scaleq 0
