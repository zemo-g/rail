-- Rail GPT — position-wise FFN (MLP) twin (Phase 2, importable, no main).
--
-- GPT-2 MLP sublayer: out = W2 @ gelu(W1 @ x + b1) + b2, tanh-approx GELU.
-- bx4_gelu is the proven transcendental (bx_fixed.rail, truncating divides, twin
-- of fx_gelu on GPU). Linear via gfx_matvec (gpt_fx). W1 stored [d, d_ff], W2
-- [d_ff, d] (resident pre-transposed layout).

import "stdlib/gpt/gpt_ln.rail"

gp_gelu_vec x y d i =
  if i >= d then y
  else let _ = arr_set y i (bx4_gelu (arr_get x i)) in gp_gelu_vec x y d (i + 1)

-- x[d] -> out[d]. tmp is scratch[d_ff]. up-proj, GELU in place, down-proj.
gp_mlp x W1 b1 W2 b2 d dff tmp out =
  let _ = gfx_matvec W1 x b1 tmp d dff 0 in
  let _ = gp_gelu_vec tmp tmp dff 0 in
  gfx_matvec W2 tmp b2 out dff d 0
