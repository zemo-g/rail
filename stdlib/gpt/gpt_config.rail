-- Rail GPT — canonical model config (Phase 0 frozen interface).
-- GptConfig is a packed flat int array (Rail high-arity SIGSEGV -> bundle, never pass loose).
-- Index -> field:
--   [0] n_layer   [1] d_model   [2] n_head    [3] head_dim  [4] d_ff
--   [5] block     [6] vocab     [7] fbits(24) [8] tokenizer [9] seed  [10] tie_head
-- Spine = GPT-2 family (LayerNorm+bias, GELU, learned pos, untied bias-free head),
-- the family of the 138M we own (rail-training/attested-base/pilot/gpt.py, "mid" preset).
-- tie_head: 0 = untied (DEFAULT — the owned 138M is trained untied; required to load/witness it).
--           1 = tie head to token embedding. RESERVED for FUTURE from-scratch small-scale runs
--           only; do NOT set for the owned model (it would describe a different, un-loadable net).

gc_nth xs i = if i <= 0 then head xs else gc_nth (tail xs) (i - 1)

gc_nlayer c  = gc_nth c 0
gc_dmodel c  = gc_nth c 1
gc_nhead c   = gc_nth c 2
gc_headdim c = gc_nth c 3
gc_dff c     = gc_nth c 4
gc_block c   = gc_nth c 5
gc_vocab c   = gc_nth c 6
gc_fbits c   = gc_nth c 7
gc_tok c     = gc_nth c 8
gc_seed c    = gc_nth c 9
gc_tie c     = gc_nth c 10

-- arity-safe builders (2 args). tokenizer: 0=char, 1=bpe. tie_head: 0=untied (owned model).
gpt_config_mid vocab seed  = [16, 768, 12, 64, 3072, 512, vocab, 24, 1, seed, 0]
gpt_config_tiny vocab seed = [4, 128, 4, 32, 512, 256, vocab, 24, 0, seed, 0]

-- exact trainable-parameter count for a given config (self-check: mid@vocab16384 ~= 139M).
gpt_nparams c =
  let d = gc_dmodel c in
  let ll = gc_nlayer c in
  let ff = gc_dff c in
  let v = gc_vocab c in
  let block = gc_block c in
  let emb = (v * d) + (block * d) in
  let per_ln = d * 2 in
  let per_attn = 4 * ((d * d) + d) in
  let per_mlp = ((ff * d) + ff) + ((d * ff) + d) in
  let per_layer = per_ln + per_attn + per_ln + per_mlp in
  let lnf = d * 2 in
  let hd = if gc_tie c == 0 then v * d else 0 in
  emb + (ll * per_layer) + lnf + hd

-- (self-check main moved to tools/gpt/gpt_config_test.rail so this module is
--  importable without a main clash — see rail-imports-no-dedup-trap.)
