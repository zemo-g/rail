-- Rail GPT — F=24 (Q39.24) fixed-point substrate (Phase 2, importable, no main).
--
-- These atoms are copied VERBATIM from the verified twin-kernel references
-- (attested_ln_real_demo.rail act-11, already certified GPU==CPU byte-for-byte)
-- so consolidating them here preserves the bit-exact guarantee rather than
-- re-deriving it. Representation: X = round(x * 2^24), S = 16777216.
-- mul_shr(a,b,24) = floor(a*b / 2^24) matching the GPU's 128-bit fixed multiply;
-- plain `/` truncates toward zero matching ARM sdiv == Metal `long /`.

-- Linear import chain (Rail does NOT dedup diamond imports): bx_fixed is the base,
-- and every gpt module imports its single predecessor only. bx_fixed gives the
-- transcendentals (bx4_gelu/exp/tanh); gfx_* names never collide with bx4_*.
import "tools/bitexact/bx_fixed.rail"
import "stdlib/gpt/gpt_config.rail"

gfx_ONE = 16777216            -- 2^24

-- fixed-point multiply, twin of the GPU mul_shr (128-bit, floor).
gfx_mul a b = mul_shr a b 24

-- ===== sqrt / rsqrt: 128-bit binary search with exact fractional tie-break =====
-- (the MODEL's sqrt — NOT the digit-by-digit isqrt; matches fx_layernorm24's
--  fxsqrt24/sqrt_le on GPU.)
gfx_sqrt_le r xq =
  let hr = mul_shr r r 24 in
  if hr < xq then true
  else if hr > xq then false
  else
    let c  = r - (r / 16777216) * 16777216 in
    let cc = c * c in
    (cc - (cc / 16777216) * 16777216) == 0

gfx_bsqrt lo hi xq =
  if (lo + 1) >= hi then lo
  else
    let mid = (lo + hi) / 2 in
    if gfx_sqrt_le mid xq then gfx_bsqrt mid hi xq
    else gfx_bsqrt lo mid xq

gfx_fxsqrt xq = if xq < 1 then 0 else gfx_bsqrt 0 ((16384 * 16384) * 4096) xq
gfx_fxrsqrt xq = let q = gfx_fxsqrt xq in if q == 0 then 0 else 281474976710656 / q

-- ===== matmul / idot atom (twin of fx_matmul24: int64 accumulate, then >>24) =====
-- mul_shr floors (verified), so acc>>24 == mul_shr acc 1 24 -- the SAME primitive
-- the GPU uses, guaranteeing bit-identical floor-shift (trunc `/` would diverge on
-- negatives). Products accumulate raw (F=48); caller keeps the sum inside gk bounds.
gfx_floorshift24 acc = mul_shr acc 1 24

gfx_dot_go A ao B bo k i acc =
  if i >= k then acc
  else gfx_dot_go A ao B bo k (i + 1) (acc + (arr_get A (ao + i)) * (arr_get B (bo + i)))
gfx_dot A ao B bo k = gfx_floorshift24 (gfx_dot_go A ao B bo k 0 0)

-- y[o] = floorshift24( sum_i x[i] * W[o*in_d + i] ) + bias[o].  W is stored [out,in]
-- row-major -- the RAW nn.Linear / safetensors layout the certified fx_matmul_wx
-- kernel indexes directly (no transpose). bias may be a zero array for bias-free.
gfx_mv_col W x in_d o out_d i acc =
  if i >= in_d then acc
  else gfx_mv_col W x in_d o out_d (i + 1) (acc + (arr_get x i) * (arr_get W (o * in_d + i)))
gfx_matvec W x bias y in_d out_d o =
  if o >= out_d then y
  else let _ = arr_set y o ((gfx_floorshift24 (gfx_mv_col W x in_d o out_d 0 0)) + (arr_get bias o)) in
       gfx_matvec W x bias y in_d out_d (o + 1)

-- offset-aware matvec: read x from xoff, write y at yoff. Lets each token in a
-- packed [seqL*d] sequence be projected in place. Same floor-shift semantics.
gfx_mv_col_off W x xoff in_d o out_d i acc =
  if i >= in_d then acc
  else gfx_mv_col_off W x xoff in_d o out_d (i + 1) (acc + (arr_get x (xoff + i)) * (arr_get W (o * in_d + i)))
gfx_matvec_off W x xoff bias y yoff in_d out_d o =
  if o >= out_d then y
  else let _ = arr_set y (yoff + o) ((gfx_floorshift24 (gfx_mv_col_off W x xoff in_d o out_d 0 0)) + (arr_get bias o)) in
       gfx_matvec_off W x xoff bias y yoff in_d out_d (o + 1)
