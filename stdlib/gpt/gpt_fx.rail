-- Rail GPT — F=24 (Q39.24) fixed-point substrate (Phase 2, importable, no main).
--
-- These atoms are copied VERBATIM from the verified twin-kernel references
-- (attested_ln_real_demo.rail act-11, already certified GPU==CPU byte-for-byte)
-- so consolidating them here preserves the bit-exact guarantee rather than
-- re-deriving it. Representation: X = round(x * 2^24), S = 16777216.
-- mul_shr(a,b,24) = floor(a*b / 2^24) matching the GPU's 128-bit fixed multiply;
-- plain `/` truncates toward zero matching ARM sdiv == Metal `long /`.

gfx_ONE = 16777216            -- 2^24

-- fixed-point multiply, twin of the GPU mul_shr (128-bit, floor).
gfx_mul a b = mul_shr a b 24

-- ===== sqrt / rsqrt: 128-bit binary search with exact fractional tie-break =====
-- (the MODEL's sqrt — NOT the digit-by-digit isqrt; matches fx_layernorm24's
--  fxsqrt24/sqrt_le on GPU.)
gfx_sqrt_le r xq =
  let hr = mul_shr r r 24 in
  if hr < xq then true
  else if hr > xq then false
  else
    let c  = r - (r / 16777216) * 16777216 in
    let cc = c * c in
    (cc - (cc / 16777216) * 16777216) == 0

gfx_bsqrt lo hi xq =
  if (lo + 1) >= hi then lo
  else
    let mid = (lo + hi) / 2 in
    if gfx_sqrt_le mid xq then gfx_bsqrt mid hi xq
    else gfx_bsqrt lo mid xq

gfx_fxsqrt xq = if xq < 1 then 0 else gfx_bsqrt 0 ((16384 * 16384) * 4096) xq
gfx_fxrsqrt xq = let q = gfx_fxsqrt xq in if q == 0 then 0 else 281474976710656 / q
