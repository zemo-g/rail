-- Rail GPT — LayerNorm twin (Phase 2, importable, no main).
--
-- VERBATIM the model's own gp_layernorm (attested_ln_real_demo.rail act-11,
-- certified GPU==CPU on the real block-0 LayerNorm). Pre-norm GPT-2 LayerNorm
-- WITH bias: y_i = ((x_i - mean) * rstd) * gamma_i + beta_i, population variance,
-- eps added INSIDE the rsqrt. F=24; mul_shr where the GPU uses mul_shr, plain `/`
-- (trunc) for mean/var where the GPU uses Metal `long /`.
--
-- X: input float_arr, row starts at `base`, length d. xn: output float_arr[d].
-- gamma,beta: float_arr[d]. eps: fixed-point epsilon (Q39.24).

import "stdlib/gpt/gpt_fx.rail"

gp_ln_sum X base d i acc =
  if i >= d then acc else gp_ln_sum X base d (i + 1) (acc + arr_get X (base + i))

gp_ln_var X base d mean i acc =
  if i >= d then acc
  else let dx = (arr_get X (base + i)) - mean in
       gp_ln_var X base d mean (i + 1) (acc + mul_shr dx dx 24)

gp_ln_apply X base xn gamma beta d mean inv i =
  if i >= d then xn
  else let dx = (arr_get X (base + i)) - mean in
       let _ = arr_set xn i ((mul_shr (mul_shr dx inv 24) (arr_get gamma i) 24) + (arr_get beta i)) in
       gp_ln_apply X base xn gamma beta d mean inv (i + 1)

gp_layernorm X base xn gamma beta d eps =
  let s = gp_ln_sum X base d 0 0 in
  let mean = s / d in
  let vs = gp_ln_var X base d mean 0 0 in
  let var = vs / d in
  let inv = gfx_fxrsqrt (var + eps) in
  gp_ln_apply X base xn gamma beta d mean inv 0
