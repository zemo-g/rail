-- Rail GPT — GPU matmul backend (importable). The bit-exact GPU counterpart of the
-- CPU gfx_matvec twin: fx_matmul24_wx (integer-exact idot, [out,in], batched over
-- seqL tokens, weight resident on Metal). Proven identical to gfx_matvec (0/6912
-- mismatches on a 768x768x9 projection) -> a drop-in that keeps the attestation
-- chain intact while running ~100x faster than CPU on the real 138M.
--
-- Because GPU output == CPU output bit-for-bit, the CPU twins stay the verifiable
-- reference and the GPU is the production path; both hash to the SAME ledger.
--
-- Usage: kid = gp_gpu_mm_kernel out_d in_d seqL   (compile once)
--        wid = gp_gpu_weight W out_d in_d          (upload once, resident)
--        gp_gpu_mm kid wid X Y out_d in_d seqL      (dispatch per step; only X moves)

import "stdlib/ijit.rail"

-- compile a batched [out,in] integer-exact matmul kernel for seqL tokens.
gp_gpu_mm_kernel out_d in_d seqL = ijit_compile (emit_msl_fx_matmul24_wx out_d in_d seqL)

-- upload a weight [out_d*in_d] (row-major [out,in]) to a resident GPU buffer.
gp_gpu_weight W out_d in_d = ibuf_upload W (out_d * in_d)

-- Y[seqL*out_d] = X[seqL*in_d] @ W^T  (idot, floor-shift) -- bit-exact to
-- (gfx_matvec_off W X (t*in_d) zbias Y (t*out_d) in_d out_d 0) over all t.
gp_gpu_mm kid wid X Y out_d in_d seqL = ijit_run_wx kid wid X Y (seqL * in_d) (seqL * out_d) (seqL * out_d)

-- refresh a resident weight after an optimizer step (for GPU training).
gp_gpu_weight_update wid W out_d in_d = ibuf_update wid W (out_d * in_d)
