-- stdlib/prng.rail — Seedable deterministic PRNG (xorshift, overflow-safe)
--
-- Why this exists: the awk / /dev/urandom shell pipeline is NON-deterministic
-- (same seed -> different sequence) and forks a subprocess per draw. Classic
-- LCG/PCG generators rely on a 64-bit multiply, which OVERFLOWS Rail's 63-bit
-- tagged ints and silently WRAPS at the wrong width, destroying the period.
--
-- This generator is built from SHIFTS + XOR only (shl / shr / bit_xor), with
-- the state masked to 48 bits after every step. 48 bits stays well clear of
-- the tag-bit overflow boundary, so the recurrence is exact and the sequence
-- is reproducible: same seed -> same stream, on any backend, forever.
--
-- Uses: shl, shr, bit_xor, bit_and (compiler builtins).
--
-- API:
--   rng_new seed        -> state                (seed an initial state)
--   rng_next state      -> (raw, newstate)      (advance; raw is a 48-bit int)
--   rng_int state n     -> (value, newstate)    (value in [0, n))
--   rng_float state     -> (f, newstate)        (f in [0.0, 1.0))

-- 48-bit mask: (1 << 48) - 1. Computed (not a literal) to avoid baking a
-- >=2^47 constant; shl on a small literal is safe.
prng_mask48 = (shl 1 48) - 1

-- 24-bit mask, used to extract a clean mantissa for rng_float.
prng_mask24 = (shl 1 24) - 1

-- Magnitude of a 24-bit unit, as a float, for the [0,1) scaling.
prng_unit24 = 16777216.0

-- Seed -> state. Never let the state be 0 (xorshift with 0 state is a fixed
-- point that only ever yields 0). A nonzero seed-mix guarantees liveness.
rng_new seed =
  let s = bit_and seed prng_mask48
  if s == 0 then 88172645 else s

-- One xorshift step on the 48-bit state. Shifts 21/35/4 give a full-period
-- orbit over the masked width; mask after each xor keeps it in 48 bits.
prng_step state =
  let a = bit_and (bit_xor state (shl state 21)) prng_mask48
  let b = bit_and (bit_xor a (shr a 35)) prng_mask48
  bit_and (bit_xor b (shl b 4)) prng_mask48

-- Advance the generator. Returns (raw_output, new_state). The raw output is
-- the post-step state itself (a 48-bit nonnegative int).
rng_next state =
  let ns = prng_step state
  (ns, ns)

-- Uniform-ish integer in [0, n). For n <= 0 we return 0 (no valid range).
-- Modulo of a 48-bit value by a small n has negligible bias for typical n.
rng_int state n =
  if n <= 0 then (0, prng_step state)
  else
    let (raw, ns) = rng_next state
    ((raw % n), ns)

-- Float in [0.0, 1.0). Uses the top 24 bits of the raw output as a mantissa
-- and divides by 2^24, so the result never reaches 1.0.
rng_float state =
  let (raw, ns) = rng_next state
  let bits24 = bit_and (shr raw 24) prng_mask24
  let f = (int_to_float bits24) /. prng_unit24
  (f, ns)
