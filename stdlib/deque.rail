-- stdlib/deque.rail — Pure Rail double-ended queue (deque)
-- Import: import "stdlib/deque.rail"
--
-- Amortized O(1) push/pop at both ends via the two-list technique.
-- A Deque holds two lists:
--   front : elements near the FRONT, in order (head = first element)
--   back  : elements near the BACK, REVERSED (head = last element)
-- The logical sequence is:  front ++ reverse(back).
-- When the side you pop from is empty, reverse the other side into it.
-- Each element is reversed at most twice over its lifetime, giving
-- amortized O(1) per operation.
--
-- pop_front / pop_back return a tuple (value, deque). On an empty deque
-- they return (0, emptyDeque) so callers should guard with deque_is_empty.

type Deque = | Deque front back

-- Construct an empty deque
deque_new _ = Deque [] []

-- True when the deque holds no elements
deque_is_empty dq = match dq
  | Deque f b ->
    if f == [] then
      (if b == [] then true else false)
    else false

-- Number of elements (O(n))
deque_size dq = match dq
  | Deque f b -> length f + length b

-- Push x onto the FRONT
push_front x dq = match dq
  | Deque f b -> Deque (cons x f) b

-- Push x onto the BACK
push_back x dq = match dq
  | Deque f b -> Deque f (cons x b)

-- Pop from the FRONT -> (value, newDeque)
-- If front is empty, reverse back into front first (rebalance).
pop_front dq = match dq
  | Deque f b ->
    if f == [] then
      (if b == [] then (0, Deque [] [])
       else deque_pop_front_rebalanced (reverse b))
    else (head f, Deque (tail f) b)

-- After rebalance, front = reverse(back) and back = [].
deque_pop_front_rebalanced f =
  (head f, Deque (tail f) [])

-- Pop from the BACK -> (value, newDeque)
-- If back is empty, reverse front into back first (rebalance).
pop_back dq = match dq
  | Deque f b ->
    if b == [] then
      (if f == [] then (0, Deque [] [])
       else deque_pop_back_rebalanced (reverse f))
    else (head b, Deque f (tail b))

-- After rebalance, back = reverse(front) and front = [].
deque_pop_back_rebalanced b =
  (head b, Deque [] (tail b))

-- Convert to an ordinary list in front-to-back order
deque_to_list dq = match dq
  | Deque f b -> append f (reverse b)
