-- stdlib/set.rail — String set with dedup, size, iteration & set algebra
--
-- A self-contained string set. hash.rail also ships a bare DJB2 bucketed
-- set (set_new/set_add/set_contains) but it has no dedup and no way to
-- enumerate, size, or combine sets — and its symbols collide with this
-- module's, so we inline our own DJB2 here rather than importing it.
--
-- A set is a tuple  (buckets, elems)  where:
--   buckets : arr_new bucketed DJB2 index for fast set_contains
--   elems   : list of the unique members, newest-first (for size / to_list)
--
-- All inserts are idempotent: set_add checks membership before touching
-- anything, so the bucket array and the element list never disagree.
--
-- API:
--   set_new       _            -> empty set
--   set_add       s key        -> set with key added (idempotent)
--   set_contains  s key        -> bool
--   set_remove    s key        -> set with key removed
--   set_size      s            -> int (number of unique members)
--   set_to_list   s            -> list of members
--   set_from_list xs           -> set built from a list (dedups)
--   set_union     a b          -> members in a OR b
--   set_intersect a b          -> members in a AND b
--   set_difference a b         -> members in a but NOT b

-- ============ DJB2 hashing (inlined; see stdlib/hash.rail) ============

set_buckets_n = 8192
set_hash_mask = 2147483647

set_djb2 s = set_djb2_acc (chars s) 5381

set_djb2_acc cs h =
  if cs == [] then h
  else set_djb2_acc (tail cs) (((h * 33) + char_to_int (head cs)) % set_hash_mask)

set_idx key = (set_djb2 key) % set_buckets_n

-- ============ construction / membership ============

set_new _ = (arr_new set_buckets_n [], [])

set_elems s = let (b, e) = s in e

-- Idempotent insert. Membership-checked so elems stays deduped.
set_add s key =
  let (b, e) = s
  if set_contains s key then s
  else
    let _ = arr_set b (set_idx key) (cons key (arr_get b (set_idx key)))
    (b, cons key e)

set_contains s key =
  let (b, e) = s
  set_member_in (arr_get b (set_idx key)) key

set_member_in bucket key =
  if bucket == [] then false
  else if head bucket == key then true
  else set_member_in (tail bucket) key

-- ============ removal ============

-- Rebuild from the surviving members so buckets and elems stay consistent.
set_remove s key =
  if set_contains s key then
    set_from_list (set_list_without (set_elems s) key)
  else s

set_list_without xs key =
  if xs == [] then []
  else if head xs == key then set_list_without (tail xs) key
  else cons (head xs) (set_list_without (tail xs) key)

-- ============ size / iteration ============

set_size s = length (set_elems s)

set_to_list s = set_elems s

-- ============ bulk build ============

-- Fold a list of strings into a fresh set (dedups along the way).
set_from_list xs = set_add_all (set_new 0) xs

set_add_all s xs =
  if xs == [] then s
  else set_add_all (set_add s (head xs)) (tail xs)

-- ============ set algebra ============

set_union a b = set_add_all a (set_elems b)

set_intersect a b = set_from_list (set_keep_if_in (set_elems a) b)

set_keep_if_in xs other =
  if xs == [] then []
  else if set_contains other (head xs)
    then cons (head xs) (set_keep_if_in (tail xs) other)
    else set_keep_if_in (tail xs) other

set_difference a b = set_from_list (set_drop_if_in (set_elems a) b)

set_drop_if_in xs other =
  if xs == [] then []
  else if set_contains other (head xs)
    then set_drop_if_in (tail xs) other
    else cons (head xs) (set_drop_if_in (tail xs) other)
