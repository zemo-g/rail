-- stdlib/date.rail — proleptic-Gregorian calendar / date math.
--
-- Pure integer civil-date arithmetic, no shelling out to `date`. The core
-- is Howard Hinnant's algorithm (http://howardhinnant.github.io/date_algorithms.html):
-- a bijection between (year, month, day) and "days since the Unix epoch"
-- (1970-01-01). It is valid for any proleptic-Gregorian date and round-trips
-- exactly. The same kernel powers stdlib/fit.rail's timestamp formatter; this
-- module promotes it to a standalone public API independent of the fit_ names.
--
-- Conventions:
--   * "days" are signed days since 1970-01-01 (0 = the epoch, negative before).
--   * months are 1..12, days are 1..31.
--   * day_of_week returns 0=Sunday .. 6=Saturday.
--   * unix seconds are seconds since 1970-01-01T00:00:00Z (UTC, no leap secs).
--
-- 63-bit overflow note: Rail ints are 63-bit tagged, so they wrap ~2x earlier
-- than i64. The largest intermediate here is days*86400 in unix_to_civil, which
-- for any realistic date (|days| < ~3.7e15) stays far under 2^61. days_from_civil
-- multiplies by at most 146097, also safe. No masking required for sane inputs.
--
-- Public API:
--   is_leap_year y                 -> bool
--   days_from_civil y m d          -> int   (days since 1970-01-01)
--   civil_from_days z              -> [y, m, d]  (3-element int array)
--   day_of_week y m d              -> int   (0=Sun .. 6=Sat)
--   date_pad2 n                    -> string (zero-padded to 2 digits)
--   date_format y m d              -> "YYYY-MM-DD"
--   unix_to_civil secs             -> [y, m, d, h, mi, s]  (6-element int array)
--   datetime_format secs           -> "YYYY-MM-DD HH:MM:SSZ"

-- ── Leap year ───────────────────────────────────────────────────────────
-- Gregorian rule: divisible by 4, except centuries, except multiples of 400.
-- No short-circuit in Rail, so the nested-if form keeps the modulos honest.
is_leap_year y =
  if y % 400 == 0 then 1 == 1
  else if y % 100 == 0 then 1 == 0
  else if y % 4 == 0 then 1 == 1
  else 1 == 0

-- ── days_from_civil (Hinnant) ───────────────────────────────────────────
-- (y, m, d) -> days since 1970-01-01. Inverse of civil_from_days.
-- y is the proleptic Gregorian year; the algorithm shifts so that the year
-- "starts" in March, which makes the leap day fall at the end of the cycle.
days_from_civil y m d =
  let y0 = if m <= 2 then y - 1 else y
  let era = if y0 >= 0 then y0 / 400 else (y0 - 399) / 400
  let yoe = y0 - era * 400
  let mp = if m > 2 then m - 3 else m + 9
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468

-- ── civil_from_days (Hinnant) ───────────────────────────────────────────
-- days since 1970-01-01 -> [y, m, d]. Inverse of days_from_civil.
civil_from_days z =
  let z2 = z + 719468
  let era = if z2 >= 0 then z2 / 146097 else (z2 - 146096) / 146097
  let doe = z2 - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y0 = yoe + era * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 then mp + 3 else mp - 9
  let y = if m <= 2 then y0 + 1 else y0
  let r = arr_new 3 0
  let _ = arr_set r 0 y
  let _ = arr_set r 1 m
  let _ = arr_set r 2 d
  r

-- ── Day of week ─────────────────────────────────────────────────────────
-- 1970-01-01 (day 0) was a Thursday. Sunday-based index: shift by +4 then
-- take mod 7. Rail's `%` can yield a negative result for negative operands,
-- so we add 7 and re-mod to land in 0..6 for pre-epoch dates too.
day_of_week y m d =
  let z = days_from_civil y m d
  let raw = (z + 4) % 7
  if raw < 0 then raw + 7 else raw

-- ── Formatting ──────────────────────────────────────────────────────────
date_pad2 n =
  if n < 10 then cat ["0", show n]
  else show n

date_format y m d =
  cat [show y, "-", date_pad2 m, "-", date_pad2 d]

-- ── Unix seconds → civil date-time ──────────────────────────────────────
-- Returns [y, m, d, h, mi, s]. Floor-divides so negative (pre-epoch) seconds
-- still produce a valid date with 0 <= h,mi,s in range. UTC, ignores leap secs.
unix_to_civil secs =
  let days = if secs >= 0 then secs / 86400 else (secs - 86399) / 86400
  let tod = secs - days * 86400
  let h = tod / 3600
  let mi = (tod - h * 3600) / 60
  let s = tod - h * 3600 - mi * 60
  let ymd = civil_from_days days
  let r = arr_new 6 0
  let _ = arr_set r 0 (arr_get ymd 0)
  let _ = arr_set r 1 (arr_get ymd 1)
  let _ = arr_set r 2 (arr_get ymd 2)
  let _ = arr_set r 3 h
  let _ = arr_set r 4 mi
  let _ = arr_set r 5 s
  r

datetime_format secs =
  let r = unix_to_civil secs
  cat [date_format (arr_get r 0) (arr_get r 1) (arr_get r 2),
       " ", date_pad2 (arr_get r 3), ":", date_pad2 (arr_get r 4),
       ":", date_pad2 (arr_get r 5), "Z"]
