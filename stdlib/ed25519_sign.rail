-- stdlib/ed25519_sign.rail — Ed25519 signing (RFC 8032 §5.1.6).
--
-- Verify-only callers can ignore this module. Sign mode is opt-in: import
-- after stdlib/ed25519.rail + stdlib/ed25519_scalar.rail.
--
-- Public API:
--   ed25519_sk_expand seed32         -> [a32, prefix32]   (length-2 array of arrays)
--   ed25519_pk_from_sk seed32        -> bytes32           (encoded public key)
--   ed25519_sign seed32 msg msg_len  -> bytes64           (R_enc || S)
--
-- Per RFC 8032 §5.1.5/§5.1.6:
--   h        = SHA-512(seed32)               (64 bytes)
--   a        = h[0..32], clamped             (clear bits 0,1,2 of byte 0;
--                                             clear bit 7 + set bit 6 of byte 31)
--   prefix   = h[32..64]
--   A_enc    = encode([a]B)                  (32 bytes; B = base point)
--   r        = sc_reduce(SHA-512(prefix || msg))
--   R_enc    = encode([r]B)
--   k        = sc_reduce(SHA-512(R_enc || A_enc || msg))
--   S        = sc_muladd(k, a, r)
--   sig      = R_enc || S                    (64 bytes total)
--
-- Buffer ownership: caller owns seed/msg. Returned arrays are freshly
-- allocated and may be retained or discarded by the caller.

ed25519_sk_expand seed =
  let h = sha512_bytes seed 32
  let a = arr_new 32 0
  let _ = sha_copy_bytes h a 0 0 32
  -- Clamp a per RFC 8032: clear low 3 bits of byte 0; clear bit 7 + set
  -- bit 6 of byte 31.
  let _ = arr_set a 0  (bit_and (arr_get a 0)  248)
  let _ = arr_set a 31 (bit_and (arr_get a 31) 127)
  let _ = arr_set a 31 (bit_or  (arr_get a 31) 64)
  let prefix = arr_new 32 0
  let _ = sha_copy_bytes h prefix 32 0 32
  let r = arr_new 2 0
  let _ = arr_set r 0 a
  let _ = arr_set r 1 prefix
  r

-- Encode [a]B for a 32-byte LE scalar a. Returns a fresh 32-byte array.
ed25519_scalar_mult_base a =
  let B_enc = ed_b_bytes 0
  let B = ed_decode B_enc
  let pt = ed_point_new 0
  let _ = ed_scalar_mul pt a 32 B
  let out = arr_new 32 0
  let _ = ed_encode out pt
  out

ed25519_pk_from_sk seed =
  let exp = ed25519_sk_expand seed
  let a = arr_get exp 0
  ed25519_scalar_mult_base a

ed25519_sign seed msg msg_len =
  let exp = ed25519_sk_expand seed
  let a = arr_get exp 0
  let prefix = arr_get exp 1
  let A_enc = ed25519_scalar_mult_base a
  -- r = sc_reduce(SHA-512(prefix || msg))
  let buf1_n = 32 + msg_len
  let buf1 = arr_new buf1_n 0
  let _ = sha_copy_bytes prefix buf1 0 0 32
  let _ = sha_copy_bytes msg buf1 0 32 msg_len
  let h1 = sha512_bytes buf1 buf1_n
  let r = sc_reduce h1
  -- R_enc = encode([r]B)
  let R_enc = ed25519_scalar_mult_base r
  -- k = sc_reduce(SHA-512(R_enc || A_enc || msg))
  let buf2_n = 64 + msg_len
  let buf2 = arr_new buf2_n 0
  let _ = sha_copy_bytes R_enc buf2 0 0 32
  let _ = sha_copy_bytes A_enc buf2 0 32 32
  let _ = sha_copy_bytes msg buf2 0 64 msg_len
  let h2 = sha512_bytes buf2 buf2_n
  let k = sc_reduce h2
  -- S = sc_muladd(k, a, r)
  let s = sc_muladd k a r
  -- sig = R_enc || S
  let sig = arr_new 64 0
  let _ = sha_copy_bytes R_enc sig 0 0 32
  let _ = sha_copy_bytes s sig 0 32 32
  sig
