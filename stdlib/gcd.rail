-- stdlib/gcd.rail — Garmin GCD firmware-container decoder.
-- Import: import "stdlib/gcd.rail"
--
-- Parses the GCD record structure (load/walk/print records, extract
-- firmware streams). Consumers: tools/garmin/gcd_dump.rail and
-- tools/garmin/disasm.rail.

import "stdlib/bytes.rail"
import "stdlib/fmt.rail"

gcd_parse_uint_acc cs acc =
  if length cs == 0 then acc
  else
    let d = char_to_int (head cs) - 48
    if d < 0 then acc
    else if d > 9 then acc
    else gcd_parse_uint_acc (tail cs) (acc * 10 + d)

gcd_parse_uint s = gcd_parse_uint_acc (chars s) 0

gcd_file_size path =
  let raw = shell (cat ["stat -f '%z' '", path, "' 2>/dev/null"])
  gcd_parse_uint raw

gcd_hex_digit c =
  if c >= 48 && c <= 57 then c - 48
  else if c >= 97 && c <= 102 then c - 87
  else if c >= 65 && c <= 70 then c - 55
  else 0 - 1

gcd_hex_decode_n cs arr i n =
  if i >= n then i
  else
    let hi = gcd_hex_digit (char_to_int (head cs))
    let lo = gcd_hex_digit (char_to_int (head (tail cs)))
    let _ = arr_set arr i (bit_or (shl hi 4) lo)
    gcd_hex_decode_n (tail (tail cs)) arr (i + 1) n

gcd_read_bin path =
  let n = gcd_file_size path
  if n <= 0 then arr_new 0 0
  else
    let cmd = cat ["xxd -p '", path, "' | tr -d '\n'"]
    let hex = shell cmd
    let cs = chars hex
    let arr = arr_new n 0
    let _ = gcd_hex_decode_n cs arr 0 n
    arr

gcd_le16 buf off =
  let b0 = arr_get buf off
  let b1 = arr_get buf (off + 1)
  bit_or b0 (shl b1 8)

gcd_le32 buf off = le32_read buf off

gcd_load path =
  let buf = gcd_read_bin path
  let n = arr_len buf
  let r = arr_new 4 0
  let _ = arr_set r 0 buf
  let _ = arr_set r 1 n
  if n < 8 then
    let _ = arr_set r 3 0
    r
  else
    let ok = (arr_get buf 0 == 71) && (arr_get buf 1 == 65) && (arr_get buf 2 == 82) && (arr_get buf 3 == 77) && (arr_get buf 4 == 73) && (arr_get buf 5 == 78)
    if ok then
      let ver = gcd_le16 buf 6
      let _ = arr_set r 2 ver
      let _ = arr_set r 3 1
      r
    else
      let _ = arr_set r 3 0
      r

gcd_buf g = arr_get g 0
gcd_total g = arr_get g 1
gcd_version g = arr_get g 2
gcd_valid g = arr_get g 3
-- -- Record name lookup --------------------------------------------------
-- Names per Oppmann's spec. Anything not enumerated is firmware data
-- (each ID identifies a stream type - see firmware-data table in the spec).

gcd_record_name id =
  if id == 1 then "CheckPoint"
  else if id == 2 then "Filler"
  else if id == 3 then "PartNumber"
  else if id == 5 then "Copyright"
  else if id == 6 then "FirmwareDescriptorType"
  else if id == 7 then "FirmwareDescriptor"
  else if id == 65535 then "End"
  else if id == 8 then "fw:boot.bin (region 0x0C)"
  else if id == 701 then "fw:fw_all.bin (region 0x0E)"
  else if id == 1281 then "fw:logo (Garmin Bitmap)"
  else if id == 1387 then "fw:dskimg_0533.img"
  else if id == 1397 then "fw:fw_0555.bin"
  else if id == 1414 then "fw:files.bin"
  else if id == 1471 then "fw:resources_057F.bin"
  else if id == 1502 then "fw:resources_059E.bin"
  else if id == 1530 then "fw:TrueType (XOR 0x76)"
  else if id == 2000 then "fw:embedded GCD (0x07D0)"
  else if id == 2001 then "fw:embedded GCD (0x07D1)"
  else if id == 2002 then "fw:embedded GCD (0x07D2)"
  else if id == 2003 then "fw:embedded GCD (0x07D3)"
  else if id == 2004 then "fw:embedded GCD (0x07D4)"
  else if id == 2005 then "fw:embedded GCD (0x07D5)"
  else cat ["fw:0x", gcd_hex4 id]

gcd_hex4 n =
  let h = "0123456789ABCDEF"
  let cs = chars h
  let d3 = bit_and (shr n 12) 15
  let d2 = bit_and (shr n 8) 15
  let d1 = bit_and (shr n 4) 15
  let d0 = bit_and n 15
  cat [gcd_idx cs d3, gcd_idx cs d2, gcd_idx cs d1, gcd_idx cs d0]

gcd_idx cs i =
  if i == 0 then "0" else if i == 1 then "1"
  else if i == 2 then "2" else if i == 3 then "3"
  else if i == 4 then "4" else if i == 5 then "5"
  else if i == 6 then "6" else if i == 7 then "7"
  else if i == 8 then "8" else if i == 9 then "9"
  else if i == 10 then "A" else if i == 11 then "B"
  else if i == 12 then "C" else if i == 13 then "D"
  else if i == 14 then "E" else "F"

-- -- ASCII view of a content slice --------------------------------------

gcd_ascii_acc buf off n i acc =
  if i >= n then acc
  else
    let b = arr_get buf (off + i)
    let c = if b >= 32 && b <= 126 then char_from_int b else "."
    gcd_ascii_acc buf off n (i + 1) (cat [acc, c])

gcd_ascii buf off n =
  let cap = if n > 32 then 32 else n
  gcd_ascii_acc buf off cap 0 ""

-- -- Walker -------------------------------------------------------------
-- Iterates record-by-record from offset 8 to end. End record (0xFFFF, len=0)
-- terminates. Returns the record count walked.

gcd_walk_loop g off i fw_total =
  let buf = gcd_buf g
  let n = gcd_total g
  if off + 4 > n then
    let _ = print (cat ["[", show i, "] truncated at off=", show off])
    i
  else
    let id = gcd_le16 buf off
    let rlen = gcd_le16 buf (off + 2)
    let body_off = off + 4
    let next_off = body_off + rlen
    let _ = gcd_print_record buf id rlen body_off i
    if id == 65535 then
      let _ = print (cat ["----- ", show (i + 1), " records, fw payload bytes seen = ",
                          show (fw_total + (if id >= 8 && id != 65535 then rlen else 0))])
      i + 1
    else
      let new_fw = if id >= 8 then fw_total + rlen else fw_total
      gcd_walk_loop g next_off (i + 1) new_fw

gcd_walk g = gcd_walk_loop g 8 0 0

-- One line per record; light interpretation for known types.
gcd_print_record buf id rlen body_off i =
  let prefix = cat ["[", lpad (show i) 3, "] @", lpad (show body_off) 7,
                    " id=0x", gcd_hex4 id, " len=", lpad (show rlen) 6,
                    "  ", rpad (gcd_record_name id) 28]
  let body = if id == 1 && rlen == 1 then
               cat ["chk=0x", gcd_hex2 (arr_get buf body_off)]
             else if id == 1 && rlen == 4 then
               cat ["chk32=0x", gcd_hex8 (gcd_le32 buf body_off)]
             else if id == 5 then cat ["\"", gcd_ascii buf body_off rlen, "\""]
             else if id == 3 then cat ["compressed-pn:", gcd_hex_n buf body_off rlen]
             else if id == 6 then gcd_descr_type_str buf body_off rlen
             else if id == 7 then cat ["descr-bytes:", gcd_hex_n buf body_off (if rlen > 16 then 16 else rlen)]
             else if rlen > 0 then
               cat ["head:", gcd_hex_n buf body_off (if rlen > 8 then 8 else rlen)]
             else ""
  print (cat [prefix, "  ", body])

gcd_hex2 n =
  let h = "0123456789ABCDEF"
  let cs = chars h
  cat [gcd_idx cs (bit_and (shr n 4) 15), gcd_idx cs (bit_and n 15)]

gcd_hex8 n =
  cat [gcd_hex4 (bit_and (shr n 16) 65535), gcd_hex4 (bit_and n 65535)]

gcd_hex_n_acc buf off n i acc =
  if i >= n then acc
  else gcd_hex_n_acc buf off n (i + 1) (cat [acc, gcd_hex2 (arr_get buf (off + i))])

gcd_hex_n buf off n =
  let cap = if n > 24 then 24 else n
  gcd_hex_n_acc buf off cap 0 ""

-- Decode a Firmware Descriptor Type record into "F<id>=<type>" pairs.
-- Type bytes: 0x00 byte, 0x10 ushort, 0x20 uint, 0x40 31-byte, 0x50 end.

gcd_descr_type_str_acc buf off n i acc =
  if i + 1 >= n then acc
  else
    let fid = arr_get buf (off + i)
    let ft = arr_get buf (off + i + 1)
    let t = if ft == 0 then "byte"
            else if ft == 16 then "ushort"
            else if ft == 32 then "uint"
            else if ft == 64 then "31-byte"
            else if ft == 80 then "END"
            else cat ["?", show ft]
    let part = cat ["F", show fid, "=", t, " "]
    gcd_descr_type_str_acc buf off n (i + 2) (cat [acc, part])

gcd_descr_type_str buf off n = gcd_descr_type_str_acc buf off n 0 ""

-- -- Stream extractor --------------------------------------------------
-- For each firmware-data record (id >= 8 and not 0xFFFF), append the body
-- bytes to a hex-formatted output file. Multiple records sharing an id
-- belong to the same stream; we concatenate them in encounter order.
--
-- Caller chooses an output prefix (e.g. "/tmp/gup3294_extracted/"). For
-- each distinct firmware id seen, we produce <prefix>stream_<hexid>.hex
-- - a hex-encoded text file that can be turned back into binary with
-- `xxd -r -p`.

gcd_extract_streams g out_prefix =
  let buf = gcd_buf g
  let n = gcd_total g
  -- Work in two passes: first pass counts unique ids and total bytes per id;
  -- we use a parallel arr-of-id + arr-of-len. Modest - there are <50
  -- firmware ids in any GCD seen in the wild.
  let ids = arr_new 64 0
  let lens = arr_new 64 0
  let count_arr = arr_new 1 0
  let _ = gcd_collect_loop g 8 ids lens count_arr
  let cnt = arr_get count_arr 0
  let _ = print (cat ["streams: ", show cnt])
  gcd_print_streams ids lens cnt 0

gcd_collect_loop g off ids lens count_arr =
  let buf = gcd_buf g
  let n = gcd_total g
  if off + 4 > n then 0
  else
    let id = gcd_le16 buf off
    let rlen = gcd_le16 buf (off + 2)
    let next_off = off + 4 + rlen
    if id == 65535 then 0
    else
      let _ = if id >= 8 then gcd_accum ids lens count_arr id rlen else 0
      gcd_collect_loop g next_off ids lens count_arr

gcd_accum ids lens count_arr id rlen =
  let cnt = arr_get count_arr 0
  let idx = gcd_find_id ids cnt id 0
  if idx < 0 then
    let _ = arr_set ids cnt id
    let _ = arr_set lens cnt rlen
    let _ = arr_set count_arr 0 (cnt + 1)
    0
  else
    let _ = arr_set lens idx (arr_get lens idx + rlen)
    0

gcd_find_id ids cnt id i =
  if i >= cnt then 0 - 1
  else if arr_get ids i == id then i
  else gcd_find_id ids cnt id (i + 1)

gcd_print_streams ids lens cnt i =
  if i >= cnt then 0
  else
    let _ = print (cat ["  stream id=0x", gcd_hex4 (arr_get ids i),
                        " ", rpad (gcd_record_name (arr_get ids i)) 32,
                        " total=", show (arr_get lens i), " bytes"])
    gcd_print_streams ids lens cnt (i + 1)
