-- stdlib/string.rail — String utilities for Rail native compiler
-- Import: import "stdlib/string.rail"

-- Check if string starts with prefix
starts_with prefix s =
  let plen = length prefix
  let slen = length s
  if plen > slen then false
  else starts_with_acc (chars prefix) (chars s)

starts_with_acc pcs scs =
  if length pcs == 0 then true
  else if head pcs == head scs then starts_with_acc (tail pcs) (tail scs)
  else false

-- Check if string contains a character. Self-contained (named recursion, no
-- dependency on list.rail's `any`) so importing string.rail alone links cleanly.
contains_char c s = contains_char_go c (chars s)
contains_char_go c cs =
  if length cs == 0 then false
  else if head cs == c then true
  else contains_char_go c (tail cs)

-- Repeat string n times
repeat_str s n =
  if n <= 0 then ""
  else append s (repeat_str s (n - 1))

-- Pad string to width with spaces
pad_right s width =
  let diff = width - length s
  if diff <= 0 then s
  else append s (repeat_str " " diff)

pad_left s width =
  let diff = width - length s
  if diff <= 0 then s
  else append (repeat_str " " diff) s

-- Concatenate list of strings (used everywhere, defined here so all programs get it)
cat parts = join "" parts

-- Join list with separator (alias for builtin join)
intercalate sep xs = join sep xs

-- Convert list of chars back to string
from_chars cs =
  if length cs == 0 then ""
  else append (head cs) (from_chars (tail cs))

-- Whitespace = space, tab (9), LF (10), CR (13)
is_whitespace c =
  if c == " " then true
  else if c == char_from_int 9 then true
  else if c == char_from_int 10 then true
  else if c == char_from_int 13 then true
  else false

-- Drop leading whitespace chars from a char list (shared by ltrim/rtrim)
drop_leading_ws cs =
  if length cs == 0 then cs
  else if is_whitespace (head cs) then drop_leading_ws (tail cs)
  else cs

-- Remove leading / trailing / both-sides whitespace. Inner whitespace preserved.
-- str_* prefix matches the stdlib convention (str_find/str_split/str_sub) and
-- avoids colliding with local `trim` helpers in tools/test and tools/fuzz.
str_ltrim s = from_chars (drop_leading_ws (chars s))
str_rtrim s = from_chars (reverse (drop_leading_ws (reverse (chars s))))
str_trim s = str_ltrim (str_rtrim s)
