-- stdlib/mmap.rail — Memory-mapped I/O via FFI
-- Import: import "stdlib/mmap.rail"
-- Uses mmap/munmap from libSystem

foreign mmap addr len prot flags fd offset -> ptr
foreign munmap addr len -> int

-- Protection flags
prot_none = 0
prot_read = 1
prot_write = 2
prot_exec = 4
prot_rw = 3

-- Map flags
map_shared = 1
map_private = 2
map_anon = 4096

-- Map anonymous memory (no file backing)
alloc_pages len =
  mmap 0 len prot_rw (map_private + map_anon) (0 - 1) 0

-- Unmap memory
free_pages addr len = munmap addr len

-- ===== file-backed mapping (the scalable weight-store foundation) =====
-- read_file_bytes loads a whole file into a malloc'd ANONYMOUS buffer: under memory pressure
-- macOS must compress/swap those dirty pages -> thrash, and the file must fit in RAM. A file-backed
-- mmap maps the file directly: pages are CLEAN, so cold pages drop + re-read from disk (no
-- compression), and a file LARGER THAN RAM is accessed on demand. The returned pointer is raw +
-- header-less -- byte_at/byte_set index it directly (addr = ptr + index), like read_file_bytes.
-- Thread it as a pointer arg; never store it in a Rail int array or do arithmetic on it.
foreign open path flags -> int
foreign lseek fd off whence -> int
foreign close fd -> int

-- mmap a file read-only; returns a file-backed byte pointer (0 on failure). O_RDONLY=0, SEEK_END=2.
-- fd is closed after mapping (the mapping stays valid). Get length via mmap_size or read_file_size.
mmap_open path =
  let fd = open path 0 in
  if fd < 0 then 0
  else
    let sz = lseek fd 0 2 in
    let p = mmap 0 sz prot_read map_private fd 0 in
    let _ = close fd in
    p

-- file size in bytes (-1 on failure)
mmap_size path =
  let fd = open path 0 in
  if fd < 0 then (0 - 1)
  else let sz = lseek fd 0 2 in let _ = close fd in sz

-- ===== pread slice I/O (the FAST scalable path) =====
-- mmap byte_at decode slows at large mapping sizes (TLB / page-walk pressure over a multi-GB map).
-- pread reads an explicit [offset, offset+n) SLICE of a file straight into a (small, malloc'd) buffer
-- in ONE libc call -- the buffer stays small + hot, decode runs at full malloc-byte_at speed, the OS
-- page cache keeps the file warm, and the model can exceed RAM (only the live slice is resident).
-- This is the per-layer weight-streaming primitive: pread each tensor's bytes, decode, reuse the buffer.
foreign pread fd buf count offset -> int

-- open a file read-only, returns fd (or <0). Caller MUST file_close it when done.
file_open path = open path 0
file_close fd = close fd
-- read n bytes of fd starting at byte `offset` into the pre-allocated buffer `buf`. Returns bytes read.
file_pread fd buf n offset = pread fd buf n offset
