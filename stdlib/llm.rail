import "stdlib/parallel.rail"

-- stdlib/llm.rail — Pure Rail LLM interface
-- Import: import "stdlib/llm.rail"
-- Calls OpenAI-compatible chat completions API via curl + jq + perl.
--
-- llm_call port system_prompt user_prompt -> response string
--   Single-call form. Writes to /tmp/rail_llm_req.json + /tmp/rail_llm_resp.txt
--   (shared path — DO NOT call concurrently; use parallel_llm_calls instead).
-- parallel_llm_calls port sys users max_conc -> list of response strings
--   N-way fan-out. Each worker gets its own <tmpdir>/req_<i>.json + resp path
--   so concurrent invocations don't race. Order-preserved; worker failures
--   return empty-string at that index.
--
-- Strips <think>...</think> tags, markdown code fences, and trailing explanations.
-- Requires: curl, jq, perl (all standard on macOS)

-- JSON escape helpers (backslash must be first)
llm_esc_bs s = join "\\\\" (split "\\" s)
llm_esc_q s = join "\\\"" (split "\"" s)
llm_esc_nl s = join "\\n" (split "\n" s)
llm_esc_cr s = join "\\r" (split "\r" s)
llm_esc_tab s = join "\\t" (split "\t" s)
llm_json_esc s = llm_esc_tab (llm_esc_cr (llm_esc_nl (llm_esc_q (llm_esc_bs s))))

-- Build the JSON request body
llm_mk_body sys_prompt user_prompt =
  let q = "\""
  let esc_sys = llm_json_esc sys_prompt
  let esc_usr = llm_json_esc user_prompt
  join "" ["{", q, "messages", q, ":[",
    "{", q, "role", q, ":", q, "system", q, ",", q, "content", q, ":", q, esc_sys, q, "},",
    "{", q, "role", q, ":", q, "user", q, ",", q, "content", q, ":", q, esc_usr, q, "}],",
    q, "max_tokens", q, ":4096,",
    q, "temperature", q, ":0.3,",
    q, "chat_template_kwargs", q, ":{", q, "enable_thinking", q, ":true}}"]

-- Main LLM call function
-- port: port number as string (e.g. "8080")
-- sys_prompt: system prompt string
-- user_prompt: user prompt string
-- Returns: response content string
llm_call port sys_prompt user_prompt =
  let body = llm_mk_body sys_prompt user_prompt
  let _ = write_file "/tmp/rail_llm_req.json" body
  let cmd = join "" [
    "curl -s http://localhost:", port, "/v1/chat/completions ",
    "-H 'Content-Type: application/json' ",
    "-d @/tmp/rail_llm_req.json 2>/dev/null | ",
    "jq -r '.choices[0].message.content // empty' 2>/dev/null > /tmp/rail_llm_resp.txt && ",
    "perl -0777 -pe '",
    "s/^\\s+//; s/\\s+$//; ",
    "s/<think>.*?<\\/think>\\s*//gs; ",
    "s/^```[^\\n]*\\n(.*?)\\n```.*$/$1/s; ",
    "s/\\n\\n\\*\\*.*//s; ",
    "s/\\n\\nExplanation.*//s; ",
    "s/\\n\\nNote:.*//s; ",
    "s/\\n\\nThis .*//s",
    "' /tmp/rail_llm_resp.txt"]
  shell cmd

-- ────────────────────────────────────────────────────────────────
-- Parallel LLM calls — fan out N chat completions over the same
-- `sys` prompt but distinct user prompts. Each worker writes its own
-- request JSON, curls to its own response file, and runs the same
-- `jq | perl` cleanup pipeline as llm_call.
--
-- Caller supplies max_conc; note that on macOS with /bin/bash 3.2 the
-- parallel_shell throttle (wait -n) is not enforced, so in practice
-- all N requests fire at once. That's the desired behavior for N ≤ a
-- few dozen against a local inference server — the server handles
-- request scheduling. For much larger N, stream in chunks.
-- ────────────────────────────────────────────────────────────────

pll_write_reqs tmpdir sys users idx =
  if length users == 0 then idx
  else
    let body = llm_mk_body sys (head users)
    let path = cat [tmpdir, "/req_", show idx, ".json"]
    let _ = write_file path body
    pll_write_reqs tmpdir sys (tail users) (idx + 1)

-- One worker's pipeline: curl → jq → perl cleanup. Reads request from
-- <tmpdir>/req_<idx>.json, writes raw content to <tmpdir>/resp_<idx>.txt,
-- then emits the cleaned content to stdout (which parallel_shell captures).
pll_par_cmd port tmpdir idx =
  cat ["curl -s http://localhost:", port, "/v1/chat/completions -H 'Content-Type: application/json' -d @", tmpdir, "/req_", show idx, ".json 2>/dev/null | jq -r '.choices[0].message.content // empty' 2>/dev/null > ", tmpdir, "/resp_", show idx, ".txt && perl -0777 -pe 's/^\\s+//; s/\\s+$//; s/<think>.*?<\\/think>\\s*//gs; s/^```[^\\n]*\\n(.*?)\\n```.*$/$1/s; s/\\n\\n\\*\\*.*//s; s/\\n\\nExplanation.*//s; s/\\n\\nNote:.*//s; s/\\n\\nThis .*//s' ", tmpdir, "/resp_", show idx, ".txt"]

pll_build_cmds tmpdir port n idx acc =
  if idx >= n then reverse acc
  else pll_build_cmds tmpdir port n (idx + 1) (cons (pll_par_cmd port tmpdir idx) acc)

-- Extract the stdout from each [exit_code, stdout] pair returned by
-- parallel_shell. Preserves ordering. Drops the exit code (callers who
-- need it can use parallel_shell directly; for LLM text we treat a
-- non-zero exit as "empty response" via the captured stdout state).
pll_extract_outs pairs acc =
  if length pairs == 0 then reverse acc
  else
    let pair = head pairs
    let out = if length pair >= 2 then head (tail pair) else ""
    pll_extract_outs (tail pairs) (cons out acc)

-- Per-worker timeout for LLM calls — large models under concurrent load
-- can legitimately take minutes. The default parallel_shell timeout of
-- 60s TERM-killed 12/16 workers at N=16 on a 27B-class local model
-- (verified 2026-04-20); 300s leaves headroom for slow reasoning models.
parallel_llm_timeout_s = 300

parallel_llm_calls port sys users max_conc =
  let n = length users
  if n == 0 then []
  else
    let tmpdir_raw = shell "mktemp -d /tmp/rail_par_llm.XXXXXX"
    let tmpdir = head (str_split "\n" tmpdir_raw)
    let _ = pll_write_reqs tmpdir sys users 0
    let cmds = pll_build_cmds tmpdir port n 0 []
    let pairs = parallel_shell_timeout cmds max_conc parallel_llm_timeout_s
    let outs = pll_extract_outs pairs []
    let _ = shell (cat ["rm -rf ", tmpdir])
    outs
