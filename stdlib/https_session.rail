-- stdlib/https_session.rail — HTTPS keep-alive sessions on TLS 1.3.
--
-- One TCP + TLS handshake, many HTTP requests. Saves ~5-8s per request
-- after the first — critical for multi-turn Anthropic agents and any
-- batched API client that would otherwise redo x25519 + chain walk per
-- call.
--
-- Session handle layout (Rail int-array, 12 slots):
--   [0]  fd           (int)
--   [1]  c_ap_key     (bytes; application traffic write key)
--   [2]  c_ap_iv      (bytes)
--   [3]  s_ap_key     (bytes; application traffic read key)
--   [4]  s_ap_iv      (bytes)
--   [5]  c_seq        (int; next application record to write)
--   [6]  s_seq        (int; next application record to read)
--   [7]  valid        (int; 1 = open, 0 = closed/errored)
--   [8]  err_msg      (string; empty when valid=1)
--   [9]  host         (string; for Host: header + future reconnects)
--   [10] pending      (bytes; CF record queued for first flush, empty thereafter)
--   [11] pending_n    (int; len of pending; 0 once CF has been flushed)
--
-- Public API:
--   https_session_open        host ip port        -> session
--   https_session_open_strict host ip port        -> session (chain-to-root)
--   https_session_get         session path        -> (status, body, session')
--   https_session_post        session path ct body hdrs -> (status, body, session')
--   https_session_close       session             -> int
--
-- Accessors:
--   hs_valid session, hs_fd session, hs_err session
--
-- Framing: parses Content-Length AND Transfer-Encoding: chunked. Falls
-- back to "read until EOF" when neither is present (in which case the
-- session is not reusable — the server just closed on us).
--
-- Design notes earned on the v3.3.0 track:
-- * Nagle is the enemy. We set TCP_NODELAY on the socket right after
--   connect so the kernel never coalesces our small CF packet with any
--   later write. Without this the server times out the bare CF.
-- * ClientFinished is pre-wrapped at session_open time but NOT sent.
--   The first session_get concatenates the CF record wire bytes with
--   the app-data record for the request and emits a SINGLE send() —
--   mirrors how v3.0.0 one-shot gets away with back-to-back sends.
-- * Record reader advances s_seq on EVERY record it consumes, including
--   NewSessionTicket records the server emits right after Finished.
--   Inner rtype 22 = skip fragment but still bump seq.

import "stdlib/https_strict.rail"

-- ── Internal helpers ──────────────────────────────────────────────────

hss_fail msg =
  let z = arr_new 0 0
  let r = arr_new 12 0
  let _ = arr_set r 0 (0 - 1)
  let _ = arr_set r 1 z
  let _ = arr_set r 2 z
  let _ = arr_set r 3 z
  let _ = arr_set r 4 z
  let _ = arr_set r 5 0
  let _ = arr_set r 6 0
  let _ = arr_set r 7 0
  let _ = arr_set r 8 msg
  let _ = arr_set r 9 ""
  let _ = arr_set r 10 z
  let _ = arr_set r 11 0
  r

-- Accessors
hs_valid s = arr_get s 7
hs_fd    s = arr_get s 0
hs_err   s = arr_get s 8
hs_host  s = arr_get s 9

-- ── Session open — common core ───────────────────────────────────────
-- strict=1 → walk chain to trust store before FSM; 0 → leaf-only (same
-- semantics as https_get vs https_get_strict on the one-shot path).

hss_open_core fd host store strict =
  let kp = hc_gen_keypair 0
  let priv = arr_get kp 0
  let ch_rec = tls13_client_hello (hc_read_random 32) (hc_read_random 32) (arr_get kp 1) host
  let ch_wire = arr_get ch_rec 0
  let ch_wire_len = arr_get ch_rec 1
  let _ = hc_send_bytes fd ch_wire ch_wire_len
  let ch_msg_len = ch_wire_len - 5
  let ch_msg = arr_new ch_msg_len 0
  let _ = sha_copy_bytes ch_wire ch_msg 5 0 ch_msg_len
  let xh = hc_exchange_hello fd ch_msg ch_msg_len priv
  if arr_get xh 5 == 0 then
    let _ = close fd
    hss_fail "ServerHello parse failed"
  else
    let sh_msg = arr_get xh 0
    let sh_msg_len = arr_get xh 1
    let s_hs_key = arr_get xh 2
    let s_hs_iv = arr_get xh 3
    let c_hs = arr_get xh 4
    let flight = hc_read_server_flight fd s_hs_key s_hs_iv
    let fb = arr_get flight 0
    let fl = arr_get flight 1
    if fl < 0 then
      let _ = close fd
      hss_fail "flight decrypt failed"
    else hss_open_after_flight fd host store strict priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl c_hs

-- Split to keep each function body under the nesting/complexity Rail's
-- parser likes. Chain gate is a separate if-else level above the FSM.
hss_open_after_flight fd host store strict priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl c_hs =
  let chain_ok =
    if strict == 0 then 1
    else hs_chain_ok store fb
  if chain_ok == 0 then
    let _ = close fd
    hss_fail "chain does not validate to trust store"
  else
    let fsm = tls13_client_handshake_offline priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl 1 host
    if arr_get fsm 4 == 0 then
      let _ = close fd
      hss_fail "handshake failed (cert sig or hostname)"
    else hss_build_handle fd host c_hs fsm

hss_build_handle fd host c_hs fsm =
  let c_ap = arr_get fsm 0
  let s_ap = arr_get fsm 1
  let cf_msg = arr_get fsm 2
  let cf_len = arr_get fsm 3
  let c_hs_key = tls13_derive_key c_hs
  let c_hs_iv = tls13_derive_iv c_hs
  let c_ap_key = tls13_derive_key c_ap
  let c_ap_iv = tls13_derive_iv c_ap
  let s_ap_key = tls13_derive_key s_ap
  let s_ap_iv = tls13_derive_iv s_ap
  -- Pre-wrap ClientFinished but do NOT send yet. First session_get will
  -- emit (cf_record || app_record) in a single send() call.
  let cf_rec = tls13_record_encrypt c_hs_key c_hs_iv 0 22 cf_msg cf_len
  let pending = arr_get cf_rec 0
  let pending_n = arr_get cf_rec 1
  let s = arr_new 12 0
  let _ = arr_set s 0 fd
  let _ = arr_set s 1 c_ap_key
  let _ = arr_set s 2 c_ap_iv
  let _ = arr_set s 3 s_ap_key
  let _ = arr_set s 4 s_ap_iv
  let _ = arr_set s 5 0
  let _ = arr_set s 6 0
  let _ = arr_set s 7 1
  let _ = arr_set s 8 ""
  let _ = arr_set s 9 host
  let _ = arr_set s 10 pending
  let _ = arr_set s 11 pending_n
  s

-- ── Public open constructors ──────────────────────────────────────────

https_session_open host ip port =
  let fd = hc_connect_tcp ip port
  if fd < 0 then hss_fail "connect failed"
  else
    let _ = set_tcp_nodelay fd
    let dummy = arr_new 0 0
    hss_open_core fd host dummy 0

https_session_open_strict host ip port =
  let store = pem_load_trust_store (hs_trust_store_path 0)
  if arr_get store 3 == 0 then hss_fail "trust store load failed"
  else
    let fd = hc_connect_tcp ip port
    if fd < 0 then hss_fail "connect failed"
    else
      let _ = set_tcp_nodelay fd
      hss_open_core fd host store 1

-- ── Request builders (Connection: keep-alive) ─────────────────────────

hss_crlf _ = join "" [char_from_int 13, char_from_int 10]

hss_build_get host path =
  let eol = hss_crlf 0
  join "" ["GET ", path, " HTTP/1.1", eol,
           "Host: ", host, eol,
           "Connection: keep-alive", eol,
           "User-Agent: rail-https-session/0.1", eol,
           eol]

hss_hdr_list_to_str hdrs =
  if length hdrs == 0 then ""
  else
    let h = head hdrs
    join "" [h, hss_crlf 0, hss_hdr_list_to_str (tail hdrs)]

hss_build_post host path ctype body hdrs =
  let eol = hss_crlf 0
  let extra = hss_hdr_list_to_str hdrs
  join "" ["POST ", path, " HTTP/1.1", eol,
           "Host: ", host, eol,
           "Connection: keep-alive", eol,
           "User-Agent: rail-https-session/0.1", eol,
           "Content-Type: ", ctype, eol,
           "Content-Length: ", show (length body), eol,
           extra,
           eol,
           body]

-- ── Send: pending (CF on first call) + app record in one send() ───────

hss_send_one fd pending pending_n wire wire_n =
  if pending_n == 0 then
    let _ = hc_send_bytes fd wire wire_n
    0
  else
    let total = pending_n + wire_n
    let buf = arr_new total 0
    let _ = sha_copy_bytes pending buf 0 0 pending_n
    let _ = sha_copy_bytes wire buf 0 pending_n wire_n
    let _ = hc_send_bytes fd buf total
    0

-- ── Response reader: accumulate app-data fragments until body complete ──
--
-- Returns [body_bytes, body_n, s_seq_final, ok]
-- * ok = 1 if we got a complete response per framing; 0 if connection
--   aborted / malformed / framing unknown (caller should close).

hss_recv fd s_key s_iv seq =
  hss_recv_loop fd s_key s_iv seq [] 0 (0 - 1) 0 (0 - 1)
  -- chunks, total, header_end (-1 until \r\n\r\n seen), framing (0=unknown, 1=CL, 2=chunked, 3=close), frame_arg (CL value, or -1)

-- frame_kind: 0 = header not parsed yet, 1 = content-length (frame_arg = CL),
--             2 = chunked (frame_arg unused), 3 = read-until-close
hss_recv_loop fd s_key s_iv seq chunks total header_end frame_kind frame_arg =
  -- Terminate early if framing already satisfied.
  if frame_kind == 1 then
    if total >= header_end + frame_arg then hss_recv_finalize chunks total seq 1
    else hss_recv_step fd s_key s_iv seq chunks total header_end frame_kind frame_arg
  else hss_recv_step fd s_key s_iv seq chunks total header_end frame_kind frame_arg

hss_recv_step fd s_key s_iv seq chunks total header_end frame_kind frame_arg =
  let rec_r = hc_read_record fd
  if arr_get rec_r 2 == 0 then hss_recv_finalize chunks total seq (if frame_kind == 3 then 1 else 0)
  else
    let wire = arr_get rec_r 0
    let wire_len = arr_get rec_r 1
    if arr_get wire 0 != 23 then hss_recv_loop fd s_key s_iv seq chunks total header_end frame_kind frame_arg
    else
      let dec = tls13_record_decrypt s_key s_iv seq wire wire_len
      if arr_get dec 3 == 0 then hss_recv_finalize chunks total (seq + 1) 0
      else
        let frag = arr_get dec 0
        let rtype = arr_get dec 1
        let flen = arr_get dec 2
        if rtype == 21 then hss_recv_finalize chunks total (seq + 1) (if frame_kind == 3 then 1 else 0)
        else if rtype == 23 then hss_recv_app fd s_key s_iv (seq + 1) chunks total header_end frame_kind frame_arg frag flen
        else hss_recv_loop fd s_key s_iv (seq + 1) chunks total header_end frame_kind frame_arg

-- Append fragment, then — if header end not yet known — try to locate
-- \r\n\r\n in the assembled buffer so far and parse framing.
hss_recv_app fd s_key s_iv seq chunks total header_end frame_kind frame_arg frag flen =
  let pair = arr_new 2 0
  let _ = arr_set pair 0 frag
  let _ = arr_set pair 1 flen
  let chunks2 = cons pair chunks
  let total2 = total + flen
  if header_end >= 0 then
    -- Header already parsed; for chunked we need the whole body assembled
    -- to scan terminator; for CL we just keep reading until length reached.
    if frame_kind == 2 then
      -- Chunked: materialise and scan for "0\r\n\r\n" terminator.
      let scan = hss_scan_chunked_done chunks2 total2 header_end
      if scan == 1 then hss_recv_finalize chunks2 total2 seq 1
      else hss_recv_loop fd s_key s_iv seq chunks2 total2 header_end frame_kind frame_arg
    else hss_recv_loop fd s_key s_iv seq chunks2 total2 header_end frame_kind frame_arg
  else
    let probe = hss_locate_header_end chunks2 total2
    if probe < 0 then hss_recv_loop fd s_key s_iv seq chunks2 total2 header_end frame_kind frame_arg
    else
      let fr = hss_parse_framing chunks2 total2 probe
      let kind = arr_get fr 0
      let arg = arr_get fr 1
      hss_recv_loop fd s_key s_iv seq chunks2 total2 probe kind arg

-- Materialise chunks-list (cons in reverse order) into one flat buffer.
hss_chunks_to_buf chunks total =
  if total <= 0 then arr_new 0 0
  else
    let buf = arr_new total 0
    let _ = hc_copy_chunks buf (reverse chunks) 0
    buf

-- Return index of "\r\n\r\n" start in the assembled buffer, or -1.
hss_locate_header_end chunks total =
  if total < 4 then 0 - 1
  else
    let buf = hss_chunks_to_buf chunks total
    hss_find_crlf2 buf total 0

hss_find_crlf2 buf n i =
  if i + 4 > n then 0 - 1
  else if arr_get buf i == 13 then
    if arr_get buf (i + 1) == 10 then
      if arr_get buf (i + 2) == 13 then
        if arr_get buf (i + 3) == 10 then i + 4
        else hss_find_crlf2 buf n (i + 1)
      else hss_find_crlf2 buf n (i + 1)
    else hss_find_crlf2 buf n (i + 1)
  else hss_find_crlf2 buf n (i + 1)

-- After \r\n\r\n seen at index `hend`, look at headers for Content-Length
-- or Transfer-Encoding: chunked. Case-insensitive match on field names.
-- Returns [kind, arg].
hss_parse_framing chunks total hend =
  let buf = hss_chunks_to_buf chunks total
  let hdrs_str = hc_bytes_to_str buf hend
  let cl = hss_find_cl hdrs_str
  if cl >= 0 then
    let r = arr_new 2 0
    let _ = arr_set r 0 1
    let _ = arr_set r 1 cl
    r
  else if hss_is_chunked hdrs_str == 1 then
    let r = arr_new 2 0
    let _ = arr_set r 0 2
    let _ = arr_set r 1 0
    r
  else
    let r = arr_new 2 0
    let _ = arr_set r 0 3
    let _ = arr_set r 1 0
    r

-- Case-insensitive "content-length:" lookup; return the numeric value or -1.
hss_find_cl hdrs =
  let low = hss_to_lower hdrs
  let k = str_find "content-length:" low
  if k < 0 then 0 - 1
  else
    let rest = str_sub hdrs (k + 15) (length hdrs - k - 15)
    hss_pi_skip_ws (chars rest) 0 0

hss_is_chunked hdrs =
  let low = hss_to_lower hdrs
  let k = str_find "transfer-encoding:" low
  if k < 0 then 0
  else
    let rest = str_sub low (k + 18) (length low - k - 18)
    if str_find "chunked" rest >= 0 then 1 else 0

hss_to_lower s = hss_tl (chars s) []
hss_tl cs acc =
  if length cs == 0 then join "" (reverse acc)
  else
    let c = head cs
    let ci = char_to_int c
    let low = if ci >= 65 then (if ci <= 90 then ci + 32 else ci) else ci
    hss_tl (tail cs) (cons (char_from_int low) acc)

-- Parse int after optional whitespace, stop at CR/LF/non-digit.
hss_pi_skip_ws cs seen_digit acc =
  if length cs == 0 then (if seen_digit == 1 then acc else 0 - 1)
  else
    let c = head cs
    let ci = char_to_int c
    if ci == 32 then hss_pi_skip_ws (tail cs) seen_digit acc
    else if ci == 9 then hss_pi_skip_ws (tail cs) seen_digit acc
    else if ci >= 48 then
      if ci <= 57 then hss_pi_skip_ws (tail cs) 1 (acc * 10 + (ci - 48))
      else (if seen_digit == 1 then acc else 0 - 1)
    else (if seen_digit == 1 then acc else 0 - 1)

-- Scan the assembled body for the chunked terminator "0\r\n\r\n" (with
-- optional trailers — we accept "0\r\n" followed by "\r\n" with anything
-- in between that doesn't itself contain "\r\n\r\n" … but most servers
-- emit the plain form, so we look for \r\n0\r\n\r\n and also the initial
-- case where the body starts with 0\r\n\r\n).
hss_scan_chunked_done chunks total hend =
  if total <= hend then 0
  else
    let buf = hss_chunks_to_buf chunks total
    hss_find_chunk_end buf total hend

hss_find_chunk_end buf n start =
  if start + 5 > n then 0
  else if arr_get buf start == 48 then
    if hss_is_crlf buf n (start + 1) == 1 then
      if hss_is_crlf buf n (start + 3) == 1 then 1
      else hss_find_chunk_end buf n (start + 1)
    else hss_find_chunk_end buf n (start + 1)
  else hss_find_chunk_end buf n (start + 1)

hss_is_crlf buf n i =
  if i + 2 > n then 0
  else if arr_get buf i == 13 then
    if arr_get buf (i + 1) == 10 then 1 else 0
  else 0

hss_recv_finalize chunks total seq ok =
  let buf = hss_chunks_to_buf chunks total
  let r = arr_new 4 0
  let _ = arr_set r 0 buf
  let _ = arr_set r 1 total
  let _ = arr_set r 2 seq
  let _ = arr_set r 3 ok
  r

-- ── Split raw response into (status, body_string) ─────────────────────

hss_split_status_body buf total =
  if total <= 0 then (0, "")
  else
    let hend = hss_find_crlf2 buf total 0
    if hend < 0 then (0, hc_bytes_to_str buf total)
    else
      let hdrs = hc_bytes_to_str buf hend
      let status = hc_parse_status hdrs
      let body_n = total - hend
      let body_buf = arr_new body_n 0
      let _ = sha_copy_bytes buf body_buf hend 0 body_n
      -- For chunked, materialise then de-chunk.
      let body = hc_bytes_to_str body_buf body_n
      (status, body)

-- ── Session update helpers ────────────────────────────────────────────

hss_clear_pending s =
  let z = arr_new 0 0
  let _ = arr_set s 10 z
  let _ = arr_set s 11 0
  s

hss_advance_seqs s new_c new_s =
  let _ = arr_set s 5 new_c
  let _ = arr_set s 6 new_s
  s

hss_invalidate s msg =
  let _ = arr_set s 7 0
  let _ = arr_set s 8 msg
  s

-- ── Public request functions ──────────────────────────────────────────

https_session_get s path =
  if arr_get s 7 == 0 then (0, "session invalid", s)
  else hss_issue s (hss_build_get (arr_get s 9) path)

https_session_post s path ctype body hdrs =
  if arr_get s 7 == 0 then (0, "session invalid", s)
  else hss_issue s (hss_build_post (arr_get s 9) path ctype body hdrs)

hss_issue s req_str =
  let fd = arr_get s 0
  let c_ap_key = arr_get s 1
  let c_ap_iv = arr_get s 2
  let s_ap_key = arr_get s 3
  let s_ap_iv = arr_get s 4
  let c_seq = arr_get s 5
  let s_seq = arr_get s 6
  let pending = arr_get s 10
  let pending_n = arr_get s 11
  let req_buf = string_to_bytes req_str
  let req_len = length req_str
  let app_rec = tls13_record_encrypt c_ap_key c_ap_iv c_seq 23 req_buf req_len
  let wire = arr_get app_rec 0
  let wire_n = arr_get app_rec 1
  let _ = hss_send_one fd pending pending_n wire wire_n
  let _ = hss_clear_pending s
  let _ = arr_set s 5 (c_seq + 1)
  let rr = hss_recv fd s_ap_key s_ap_iv s_seq
  let buf = arr_get rr 0
  let total = arr_get rr 1
  let new_s_seq = arr_get rr 2
  let ok = arr_get rr 3
  let _ = arr_set s 6 new_s_seq
  if ok == 0 then
    let _ = hss_invalidate s "response read failed"
    (0, "response read failed", s)
  else
    let sb = hss_split_status_body buf total
    (fst sb, snd sb, s)

fst p = let (a, b) = p in a
snd p = let (a, b) = p in b

-- ── Close ─────────────────────────────────────────────────────────────

https_session_close s =
  if arr_get s 7 == 0 then 0
  else
    let fd = arr_get s 0
    let _ = close fd
    let _ = hss_invalidate s "closed"
    0
