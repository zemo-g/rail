-- stdlib/robot_arm.rail
--
-- Minimal robot-arm command DSL. Pure Rail; integer coordinates in
-- a 0..30 cm cube workspace. Designed for two callers:
--   1. an LLM emitting a `script` definition (substrate flywheel target)
--   2. the sim verifier (tools/robot/arm_sim.rail) that interprets a
--      script and reports goal-reach.
--
-- Coordinate convention:
--   x: right       (0 = base center, +x = right of arm)
--   y: forward     (0 = base, +y = away from base)
--   z: up          (0 = table, +z = above table)
--   workspace: each axis in [0, 30] cm (integer)
--
-- A "script" is a list of Cmd. Order matters; execution is sequential.
--
-- This file is a LIBRARY (no main). Import + use; do not run.

type Grip = | GripOpen | GripClose

type Cmd =
  | MoveTo x y z   -- integer cartesian target in cm
  | SetGrip g      -- Grip
  | Wait ms        -- integer dwell in milliseconds
  | Home           -- pure navigation to (0,0,0); does NOT change grip

-- ---------------------------------------------------------------------
-- Constructors (sugar; the LLM can use either form but these read like
-- the spoken commands in our bench prompts).
-- ---------------------------------------------------------------------

move_to x y z = MoveTo x y z
grip_open  = SetGrip GripOpen
grip_close = SetGrip GripClose
wait_ms ms = Wait ms
home_cmd = Home

-- ---------------------------------------------------------------------
-- Serializers (Cmd / script -> printable string, for LLM-visible spec
-- examples and for debug output from the sim).
-- ---------------------------------------------------------------------

grip_str g = match g
  | GripOpen -> "open"
  | GripClose -> "close"

-- Already flat (no nested constructor patterns), but keep grip dispatch
-- via grip_str rather than `SetGrip GripOpen` literals.
cmd_str c = match c
  | MoveTo x y z -> cat ["move_to ", show x, " ", show y, " ", show z]
  | SetGrip g -> cat ["grip_", grip_str g]
  | Wait ms -> cat ["wait ", show ms, " ms"]
  | Home -> "home"

script_str cs =
  if length cs == 0 then "(empty script)"
  else join "\n" (map cmd_str cs)

-- ---------------------------------------------------------------------
-- Structural validators. These are pure-shape checks; semantic checks
-- (reachability, grip-while-empty) live in the sim.
-- ---------------------------------------------------------------------

-- workspace bounds: each axis in [0, 30]
in_bounds x y z =
  if x < 0 then false
  else if x > 30 then false
  else if y < 0 then false
  else if y > 30 then false
  else if z < 0 then false
  else if z > 30 then false
  else true

cmd_in_bounds c = match c
  | MoveTo x y z -> in_bounds x y z
  | SetGrip g -> true
  | Wait ms -> if ms < 0 then false else true
  | Home -> true

-- All cmds must be in-bounds for the script to be admissible.
-- Manual fold (rather than relying on stdlib/list.rail::all which is
-- not auto-imported into this file's link unit).
script_all_in_bounds cs =
  if length cs == 0 then true
  else if cmd_in_bounds (head cs) then script_all_in_bounds (tail cs)
  else false

script_well_formed cs =
  if length cs == 0 then false
  else script_all_in_bounds cs

-- ---------------------------------------------------------------------
-- Named points. The bench prompts refer to A, B, C, ...; the sim and
-- the LLM spec share these definitions so prompts and verifier agree.
-- ---------------------------------------------------------------------

-- Returns (x, y, z) for a named point as a three-element list [x, y, z].
-- Returns [] for unknown names.
point_named name =
  if name == "A" then [10, 0, 5]
  else if name == "B" then [10, 10, 5]
  else if name == "C" then [20, 10, 5]
  else if name == "D" then [20, 20, 5]
  else if name == "ORIGIN" then [0, 0, 0]
  else []

-- Convenience: emit move_to to a named point. Returns Home (a safe
-- no-op-shape value) when the name is unknown so the script remains
-- well-typed; the sim will surface unknown-name attempts via fault.
move_to_named name =
  let p = point_named name
  if length p == 0 then Home
  else MoveTo (head p) (head (tail p)) (head (tail (tail p)))
