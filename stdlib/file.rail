-- stdlib/file.rail — File I/O via FFI
-- Import: import "stdlib/file.rail"
-- Uses fopen/fread/fwrite/fclose from libSystem (already linked)

-- fopen returns a fd (small int from open(2) syscall in the runtime stub),
-- not a libc FILE*. Declared `-> int` so Rail tags it on return; `-> ptr`
-- would bypass tagging and trip the FFI call-site polymorphic untag for
-- odd fds (3, 5, 7, ...) — silently calling ftell/fclose on stdout/stderr.
foreign fopen path mode -> int
foreign fclose fp
foreign fread buf size count fp
foreign fwrite buf size count fp
foreign fseek fp offset whence
foreign ftell fp -> int

-- Open file for reading, returns file pointer (0 on failure)
open_read path = fopen path "r"

-- Open file for writing
open_write path = fopen path "w"

-- Open file for appending
open_append path = fopen path "a"

-- NOTE: do NOT define `close fp = fclose fp` here.  socket.rail
-- declares `foreign close fd -> int` (the libc `close(2)` for sockets
-- and other fds), and a bare `close` alias to fclose() at file.rail
-- scope clobbers the socket close in any program that imports both
-- modules -- which silently routes socket close through fclose() on
-- a raw fd, hanging the process.  Use `fclose fp` for FILE* handles
-- and `close fd` (from socket.rail) for socket fds.

-- Read entire file as string (uses read_file builtin)
slurp path = read_file path

-- Write string to file (uses write_file builtin)
spit path content = write_file path content

-- Append a single line (string + newline) to a file. Used by ledger
-- writers and harvest collectors. Goes through a temp file + shell cat
-- because Rail's builtins don't expose append-mode write directly.
-- Promoted from inline copies in self_train.rail / s0_pcfg/tick.rail /
-- s0_pcfg/harvest.rail (originally Empire transplant Session 1).
append_line file text =
  let _ = write_file "/tmp/rail_append_line.txt" (cat [text, "\n"])
  shell (cat ["cat /tmp/rail_append_line.txt >> ", file])

-- ── Byte-aware file readers ──────────────────────────────────────────
-- The `read_file` builtin returns a Rail string and is C-string-style
-- internally: any caller that walks the result via `chars` stops at
-- the first NUL byte.  These two helpers let crypto/release code
-- read a binary file (rail_native, .png, .wasm, etc.) into a flat
-- byte array without a NUL-truncation step in the middle.

-- Returns the size in bytes; -1 if the file can't be opened.
read_file_size path =
  let fp = fopen path "rb"
  if fp == 0 then 0 - 1
  else
    let _ = fseek fp 0 2  -- SEEK_END
    let n = ftell fp
    let _ = fclose fp
    n

-- Returns an int array of length file_size with the file's raw bytes,
-- one byte per element.  Empty array on missing file.  Walks the
-- malloc'd C buffer with byte_at -> arr_set so the binary contents
-- survive intact (no NUL truncation, no chars-of-string detour).
read_file_bytes path =
  let fp = fopen path "rb"
  if fp == 0 then arr_new 0 0
  else read_file_bytes_open fp path

read_file_bytes_open fp path =
  let _ = fseek fp 0 2
  let n = ftell fp
  let _ = fseek fp 0 0
  let buf = malloc n
  let _ = fread buf 1 n fp
  let _ = fclose fp
  let arr = arr_new n 0
  let _ = file_copy_bytes_to_arr buf arr 0 n
  let _ = free buf
  arr

file_copy_bytes_to_arr buf arr i n =
  if i >= n then 0
  else
    let _ = arr_set arr i (byte_at buf i)
    file_copy_bytes_to_arr buf arr (i + 1) n
