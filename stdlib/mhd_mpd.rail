-- stdlib/mhd_mpd.rail — MPD-thruster source-term pack
--
-- Operates on axisymmetric (r,z) MHD state defined by stdlib/mhd_axisym.rail.
-- Adds the three physics ingredients beyond ideal MHD that the retired
-- Metal solver embedded directly in its kernel; here they are factored
-- out so any integrator (Lax-Friedrichs in step 4, MUSCL in step 5)
-- can pull them in identically.
--
-- Source physics:
--   1. Cylindrical 1/r geometry source — the (1/r)*F_r terms from
--      decomposing the axisymmetric divergence operator.
--   2. Hoop-stress feedback — gas + magnetic total pressure / r added
--      to the radial momentum equation (centrifugal-like).
--   3. Self-field Lorentz J×B — currents derived from B_theta via
--      Maxwell-Ampere.  This is what produces the electromagnetic
--      thrust in a Magnetoplasmadynamic Drive.
--   4. Applied-field Lorentz J×B — coil-induced B_z and B_r couple to
--      the azimuthal current J_theta to produce additional Lorentz
--      force in r and z directions.
--   5. Spitzer Ohmic heating — eta * J^2 added to internal energy.
--
-- Coil geometry: each coil produces a Gaussian-in-z applied B_z field
-- with a soft radial falloff.  Multiple coils superpose linearly.
-- The applied B_r component is computed from solenoid divergence-free
-- continuity (∂B_z/∂z + (1/r)∂(r B_r)/∂r = 0).
--
-- Dependency: callers must import "stdlib/mhd_axisym.rail" before this
-- module — Rail does not dedupe imports, so we declare the dependency
-- in documentation rather than via `import`.

-- ═══════════════════════════════════════════════════════════
-- COIL GEOMETRY — Gaussian envelope in z, radial falloff
-- A coil is encoded as 3 floats: z_position (m), B_peak (T), z_width (m).
-- coils_packed: float array of length 3*N_coils.
-- ═══════════════════════════════════════════════════════════

-- Smooth (1 - x^2)^2 polynomial bump on |x| <= 1, zero outside.
-- Avoids the exp foreign call (which has had segfault interaction with
-- the GC under arena pressure) while staying C2-continuous and matching
-- a Gaussian envelope to within ~10% on the |x| <= 1.5 sigma region.
mpd_gaussian z z0 sigma =
  let dx = (z - z0) / sigma
  let dx2 = dx * dx
  if dx2 >= 1.0 then 0.0
  else
    let term = 1.0 - dx2
    term * term

mpd_radial_falloff r r_anode =
  -- Linear falloff: 1 at axis, 0.85 at anode.
  let t = if r_anode < 0.000000001 then 0.0 else r / r_anode
  let t_clamped = if t > 1.0 then 1.0 else t
  1.0 - 0.15 * t_clamped

-- Sum contributions of all coils at axial position z.
mpd_bz_at_z coils n_coils idx z acc =
  if idx >= n_coils then acc
  else
    let base = idx * 3
    let z0 = float_arr_get coils base
    let bp = float_arr_get coils (base + 1)
    let sig = float_arr_get coils (base + 2)
    let contrib = bp * mpd_gaussian z z0 sig
    mpd_bz_at_z coils n_coils (idx + 1) z (acc + contrib)

mpd_build_bz_field bz coils n_coils r_min r_max dr dz i =
  if i >= ma_nrnz then 0
  else
    let j = i / ma_nz
    let zi = i % ma_nz
    let r_j = r_min + (to_float j + 0.5) * dr
    let z_v = (to_float zi + 0.5) * dz
    let bz_axis = mpd_bz_at_z coils n_coils 0 z_v 0.0
    let radial = mpd_radial_falloff r_j r_max
    let _ = float_arr_set bz (j * ma_nz + zi) (bz_axis * radial)
    mpd_build_bz_field bz coils n_coils r_min r_max dr dz (i + 1)

-- B_r from solenoid continuity: B_r ≈ -(r/2) * dB_z/dz (paraxial).
mpd_build_br_field br bz dr dz i =
  if i >= ma_nrnz then 0
  else
    let j = i / ma_nz
    let zi = i % ma_nz
    let zip = if zi + 1 < ma_nz then zi + 1 else zi
    let zim = if zi > 0 then zi - 1 else zi
    let denom = if zip == zim then dz else (to_float (zip - zim)) * dz
    let denom_safe = if denom < 0.000000001 then dz else denom
    let dbz_dz = (float_arr_get bz (j * ma_nz + zip) - float_arr_get bz (j * ma_nz + zim)) / denom_safe
    let r_j = (to_float j + 0.5) * dr
    let _ = float_arr_set br (j * ma_nz + zi) (0.0 - 0.5 * r_j * dbz_dz)
    mpd_build_br_field br bz dr dz (i + 1)

-- Top-level builder: takes coil pack + geometry, fills bz and br.
mpd_build_applied bz br coils n_coils r_min r_max dr dz =
  let _ = mpd_build_bz_field bz coils n_coils r_min r_max dr dz 0
  mpd_build_br_field br bz dr dz 0

-- ═══════════════════════════════════════════════════════════
-- CURRENT DENSITY FROM B (Maxwell-Ampere, axisymmetric)
-- J_z = (1/mu0)(1/r) d(r*B_theta)/dr
-- J_r = -(1/mu0) dB_theta/dz
-- J_theta = (1/mu0)(dB_r/dz - dB_z/dr)  [from applied fields]
-- 1/mu0 = 795774.7154594768
-- ═══════════════════════════════════════════════════════════

mpd_jz_self s r_min dr j i =
  let r_j = r_min + (to_float j + 0.5) * dr
  let r_jp = r_j + dr
  let r_jm = r_j - dr
  let bt_jp = ma_get s ma_f_bt (j + 1) i
  let bt_jm = ma_get s ma_f_bt (j - 1) i
  let r_safe = if r_j < 0.000001 then 0.000001 else r_j
  795774.7154594768 * (r_jp * bt_jp - r_jm * bt_jm) / (2.0 * dr * r_safe)

mpd_jr_self s dz j i =
  let bt_ip = ma_get s ma_f_bt j (i + 1)
  let bt_im = ma_get s ma_f_bt j (i - 1)
  0.0 - 795774.7154594768 * (bt_ip - bt_im) / (2.0 * dz)

mpd_jt_app bz br dr dz j i =
  let jp = if j + 1 < ma_nr then j + 1 else j
  let jm = if j > 0 then j - 1 else j
  let ip = if i + 1 < ma_nz then i + 1 else i
  let im = if i > 0 then i - 1 else i
  let dbr_dz = (float_arr_get br (j * ma_nz + ip) - float_arr_get br (j * ma_nz + im)) / (2.0 * dz)
  let dbz_dr = (float_arr_get bz (jp * ma_nz + i) - float_arr_get bz (jm * ma_nz + i)) / (2.0 * dr)
  795774.7154594768 * (dbr_dz - dbz_dr)

-- ═══════════════════════════════════════════════════════════
-- 1/R GEOMETRY SOURCE + HOOP STRESS
-- For axisymmetric ∂(rF_r)/∂r decomposition the "extra" terms are:
--   d_rho/dt += -rho*v_r/r
--   d_mr/dt  += -m_r*v_r/r + p_t/r
--   d_mz/dt  += -m_z*v_r/r
--   d_E/dt   += -(E + p_t)*v_r/r
-- Axis limiter: clamp r >= 0.5*dr to avoid 1/0 at j=0 boundary cell.
-- ═══════════════════════════════════════════════════════════

mpd_apply_geometry s ns r_min dr dt j i =
  let r_j = r_min + (to_float j + 0.5) * dr
  let r_safe = if r_j < 0.5 * dr then 0.5 * dr else r_j
  let inv_r = 1.0 / r_safe
  let rho = ma_get s ma_f_rho j i
  let rho_safe = if rho < 0.00000001 then 0.00000001 else rho
  let mr = ma_get s ma_f_mr j i
  let mz = ma_get s ma_f_mz j i
  let bt = ma_get s ma_f_bt j i
  let e  = ma_get s ma_f_en j i
  let vr = mr / rho_safe
  let p = ma_pressure s j i
  let pm = 0.5 * bt * bt * 795774.7154594768
  let pt = p + pm
  let drho = 0.0 - dt * rho * vr * inv_r
  let dmr  = 0.0 - dt * mr * vr * inv_r + dt * pt * inv_r
  let dmz  = 0.0 - dt * mz * vr * inv_r
  let den_ = 0.0 - dt * (e + pt) * vr * inv_r
  let _ = ma_put ns ma_f_rho j i (ma_get ns ma_f_rho j i + drho)
  let _ = ma_put ns ma_f_mr  j i (ma_get ns ma_f_mr  j i + dmr)
  let _ = ma_put ns ma_f_mz  j i (ma_get ns ma_f_mz  j i + dmz)
  ma_put ns ma_f_en  j i (ma_get ns ma_f_en  j i + den_)

-- ═══════════════════════════════════════════════════════════
-- LORENTZ FORCE J × B (self-field pinch + applied-field thrust)
-- F_r = J_z * B_theta - J_theta * B_z_app
-- F_z = J_r * B_theta + J_theta * B_r_app
-- ═══════════════════════════════════════════════════════════

mpd_apply_lorentz s ns bz br r_min dr dz dt j i =
  let bt0 = ma_get s ma_f_bt j i
  let jz = mpd_jz_self s r_min dr j i
  let jr = mpd_jr_self s dz j i
  let jt = mpd_jt_app bz br dr dz j i
  let bz_app = float_arr_get bz (j * ma_nz + i)
  let br_app = float_arr_get br (j * ma_nz + i)
  let f_r = jz * bt0 - jt * bz_app
  let f_z = jr * bt0 + jt * br_app
  let _ = ma_put ns ma_f_mr j i (ma_get ns ma_f_mr j i + dt * f_r)
  ma_put ns ma_f_mz j i (ma_get ns ma_f_mz j i + dt * f_z)

-- ═══════════════════════════════════════════════════════════
-- SPITZER OHMIC HEATING — eta * J^2 added to E
-- eta_spitzer ~ 5e-5 * T_eV^(-3/2), with a low-T ceiling to avoid
-- runaway resistivity at cold wall cells.
-- T_eV from p, rho, m_ion: T_eV = p * m_ion / (rho * k_B) / 11600
-- k_B = 1.380649e-23, 1/k_B = 7.242972e22, /11600 = 6.244e18
-- Combined: T_eV = p * m_ion * 6.244e18 / rho
-- For argon m_ion ≈ 6.633e-26 kg → coefficient ≈ 4.142e-7 in p/rho.
-- We pass m_ion in directly.
-- ═══════════════════════════════════════════════════════════

-- Note on `0.0 +` boilerplate below: Rail's float-return inference
-- from helper functions (ma_pressure, ma_get) can lose its `__fret_`
-- marker across multi-arg multiplications, leaving the value typed as
-- int.  When that happens, `p * m_ion` runs the int * float path with
-- raw f64 bits reinterpreted as int, producing values 10^300 off.
-- The cure is to `let p = 0.0 + helper(...)` so the addition lands
-- the value in a d-register and re-runs the int/float dispatcher on
-- the next op.  Same workaround applied to other helper-call results
-- that participate in float arithmetic with parameter floats.
mpd_apply_ohmic s ns bz br r_min dr dz dt m_ion j i =
  let jz = mpd_jz_self s r_min dr j i
  let jr = mpd_jr_self s dz j i
  let jt = mpd_jt_app bz br dr dz j i
  let j2 = jz * jz + jr * jr + jt * jt
  let p = 0.0 + ma_pressure s j i
  let rho = 0.0 + ma_get s ma_f_rho j i
  let rho_safe = if rho < 0.00000001 then 0.00000001 else rho
  let t_raw = p * m_ion * 6.244e18 / rho_safe
  let t_eV = if t_raw < 0.5 then 0.5 else t_raw
  let t_root = sqrt t_eV
  let denom = t_eV * t_root
  let denom_safe = if denom < 0.1 then 0.1 else denom
  let eta = 5.0e-5 / denom_safe
  let dE = dt * eta * j2
  let e0 = 0.0 + ma_get s ma_f_en j i
  let cap = 0.5 * (if e0 > 0.0 then e0 else 1.0)
  let dE_safe = if dE > cap then cap else dE
  ma_put ns ma_f_en j i (ma_get ns ma_f_en j i + dE_safe)

-- ═══════════════════════════════════════════════════════════
-- TOP-LEVEL: apply all source terms over the interior of the grid.
-- Skips boundary cells (handled by ma_apply_bc).
-- params packed: [r_min, r_max, dr, dz, m_ion]
-- ═══════════════════════════════════════════════════════════

mpd_apply_cell s ns bz br params dt j i =
  let r_min = float_arr_get params 0
  let dr    = float_arr_get params 2
  let dz    = float_arr_get params 3
  let m_ion = float_arr_get params 4
  let _ = mpd_apply_geometry s ns r_min dr dt j i
  let _ = mpd_apply_lorentz s ns bz br r_min dr dz dt j i
  mpd_apply_ohmic s ns bz br r_min dr dz dt m_ion j i

mpd_apply_loop s ns bz br params dt i =
  if i >= ma_nrnz then 0
  else
    let j = i / ma_nz
    let z = i % ma_nz
    let _ = if ma_is_boundary j z == 0 then mpd_apply_cell s ns bz br params dt j z
            else 0
    mpd_apply_loop s ns bz br params dt (i + 1)

mpd_apply_sources s ns bz br params dt =
  mpd_apply_loop s ns bz br params dt 0

-- ═══════════════════════════════════════════════════════════
-- THRUST DIAGNOSTIC — integrate axial Lorentz force over the volume.
-- T = ∫ F_z * 2*pi*r dr dz
-- 2*pi = 6.283185307179586
-- ═══════════════════════════════════════════════════════════

mpd_thrust_cell s bz br r_min dr dz j i acc =
  let r_j = r_min + (to_float j + 0.5) * dr
  let bt0 = ma_get s ma_f_bt j i
  let jr = mpd_jr_self s dz j i
  let jt = mpd_jt_app bz br dr dz j i
  let br_app = float_arr_get br (j * ma_nz + i)
  let f_z = jr * bt0 + jt * br_app
  let dT = f_z * 6.283185307179586 * r_j * dr * dz
  float_arr_set acc 0 (float_arr_get acc 0 + dT)

mpd_thrust_loop s bz br r_min dr dz acc i =
  if i >= ma_nrnz then 0
  else
    let j = i / ma_nz
    let z = i % ma_nz
    let _ = if ma_is_boundary j z == 0 then mpd_thrust_cell s bz br r_min dr dz j z acc else 0
    mpd_thrust_loop s bz br r_min dr dz acc (i + 1)

mpd_thrust_integral s bz br params =
  let r_min = float_arr_get params 0
  let dr    = float_arr_get params 2
  let dz    = float_arr_get params 3
  let acc = float_arr_new 1 0.0
  let _ = mpd_thrust_loop s bz br r_min dr dz acc 0
  float_arr_get acc 0
