-- stdlib/cert_p521.rail — P-521 cert-chain dispatch.
--
-- Extracts P-521 pubkeys from X.509 SPKI and verifies ECDSA-with-SHA512
-- outer sigs against them. Mirrors cert_p384.rail; kept separate so
-- tls13_cert_verify.rail stays below compile.rail's size-hang
-- threshold.
--
-- Public API:
--   cv_extract_p521_pubkey cert cert_len -> [x, y, valid]
--   cv_chain_p521 tbs tbs_len sig sig_len upper upper_len -> 1/0
--
-- Caller must have stdlib/asn1.rail + stdlib/ecdsa_p521.rail +
-- stdlib/sha512.rail already loaded (typical via tls13_client.rail).

cv_extract_p521_pubkey cert cert_len =
  let fields = asn1_cert_fields cert cert_len
  if arr_get fields 12 == 0 then cvp521_fail 0
  else cvp521_check_alg cert fields

cvp521_check_alg cert fields =
  let pa_off = arr_get fields 6
  let pa_len = arr_get fields 7
  if asn1_oid_eq cert pa_off pa_len (asn1_oid_ec_pubkey 0) 7 == 0 then cvp521_fail 0
  else cvp521_check_curve cert fields

cvp521_check_curve cert fields =
  let params_off = arr_get fields 8
  let params_len = arr_get fields 9
  if params_len != 7 then cvp521_fail 0
  else if arr_get cert params_off != 6 then cvp521_fail 0
  else if arr_get cert (params_off + 1) != 5 then cvp521_fail 0
  else if asn1_oid_eq cert (params_off + 2) 5 (asn1_oid_p521_curve 0) 5 == 0 then cvp521_fail 0
  else cvp521_extract_xy cert fields

cvp521_extract_xy cert fields =
  let pk_off = arr_get fields 10
  let pk_len = arr_get fields 11
  -- P-521 uncompressed point: 0x04 || X(66) || Y(66) = 133 bytes.
  if pk_len != 133 then cvp521_fail 0
  else if arr_get cert pk_off != 4 then cvp521_fail 0
  else
    let x = arr_new 66 0
    let y = arr_new 66 0
    let _ = sha_copy_bytes cert x (pk_off + 1) 0 66
    let _ = sha_copy_bytes cert y (pk_off + 67) 0 66
    let r = arr_new 3 0
    let _ = arr_set r 0 x
    let _ = arr_set r 1 y
    let _ = arr_set r 2 1
    r

cvp521_fail _ =
  let z = arr_new 66 0
  let r = arr_new 3 0
  let _ = arr_set r 0 z
  let _ = arr_set r 1 z
  let _ = arr_set r 2 0
  r

-- Verify lower's signature (ECDSA-with-SHA512) using upper's P-521 pubkey.
cv_chain_p521 tbs tbs_len sig sig_len upper upper_len =
  let pk = cv_extract_p521_pubkey upper upper_len
  if arr_get pk 2 == 0 then 0
  else cvp521_verify tbs tbs_len sig sig_len pk

cvp521_verify tbs tbs_len sig sig_len pk =
  let px = arr_get pk 0
  let py = arr_get pk 1
  let parsed = asn1_parse_ecdsa_sig sig sig_len 0 sig_len
  if arr_get parsed 4 == 0 then 0
  else cvp521_run tbs tbs_len sig parsed px py

cvp521_run tbs tbs_len sig parsed px py =
  let r_off = arr_get parsed 0
  let r_len = arr_get parsed 1
  let s_off = arr_get parsed 2
  let s_len = arr_get parsed 3
  let rb = cvp521_pad66 sig r_off r_len
  let sb = cvp521_pad66 sig s_off s_len
  -- SHA-512 produces 64 bytes; left-pad two zero bytes to land in a
  -- 66-byte BE buffer suitable for bn_from_be with 33 limbs.
  let h64 = sha512_bytes tbs tbs_len
  let h66 = arr_new 66 0
  let _ = sha_copy_bytes h64 h66 0 2 64
  ecdsa_p521_verify px py h66 rb sb

cvp521_pad66 src off len =
  let out = arr_new 66 0
  let _ = sha_copy_bytes src out off (66 - len) len
  out
