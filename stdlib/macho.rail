-- stdlib/macho.rail — Mach-O (64-bit ARM64) binary writer in pure Rail.
--
-- v5 Phase 1. Emits a minimal but valid macOS ARM64 Mach-O executable
-- with:
--   __PAGEZERO  (4 GB zero-protection segment)
--   __TEXT      (RX segment containing the Mach header + load commands
--                + __text section with raw code bytes)
--   __LINKEDIT  (R segment holding symbol/string tables + code-sig blob)
--
-- 9 required load commands (no LC_DYLD_CHAINED_FIXUPS, no LC_LOAD_DYLIB):
--   LC_SEGMENT_64 __PAGEZERO
--   LC_SEGMENT_64 __TEXT   (with one __text section)
--   LC_SEGMENT_64 __LINKEDIT
--   LC_SYMTAB              (empty: nsyms=0, strsize=0 — Phase 1 minimal)
--   LC_DYSYMTAB            (all-zero)
--   LC_LOAD_DYLINKER       (/usr/lib/dyld)
--   LC_UUID                (16-byte zero UUID for now; Phase 2 hashes it)
--   LC_BUILD_VERSION       (platform=macOS)
--   LC_MAIN                (entry offset within __TEXT)
--
-- Phase 2 adds LC_CODE_SIGNATURE + the ad-hoc CodeDirectory blob.

import "jit/codebuf.rail"

-- ============================================================================
-- Mach-O constants (sources: <mach-o/loader.h>, <mach/machine.h>)
-- ============================================================================

-- 64-bit Mach-O magic, little-endian on disk.
mh_magic_64 = 4277009103     -- 0xFEEDFACF

-- CPU types
cpu_type_arm64 = 16777228     -- 0x0100000C = ARM64 | ABI64
cpu_subtype_arm64_all = 0

-- File types
mh_execute = 2

-- Header flags
mh_noundefs   = 1
mh_dyldlink   = 4
mh_twolevel   = 128
mh_pie        = 2097152       -- 0x00200000
-- Composite flag used by our exit-42 reference: 0x00200085
mh_flags_pie_exec = bit_or mh_pie (bit_or mh_noundefs (bit_or mh_dyldlink mh_twolevel))

-- Load command codes
lc_segment_64       = 25      -- 0x19
lc_symtab           = 2
lc_dysymtab         = 11
lc_load_dylinker    = 14      -- 0xE
lc_uuid             = 27      -- 0x1B
lc_main             = 2147483688  -- 0x80000028 (LC_MAIN | LC_REQ_DYLD)
lc_build_version    = 50      -- 0x32
lc_code_signature   = 29      -- 0x1D (Phase 2)

-- VM protection flags
vm_prot_none    = 0
vm_prot_read    = 1
vm_prot_write   = 2
vm_prot_execute = 4
vm_prot_rx      = 5            -- read | execute
vm_prot_r       = 1            -- read only

-- Section attribute flags for __text
s_attr_pure_instructions = 2147483648    -- 0x80000000
s_attr_some_instructions = 1024          -- 0x00000400
section_text_flags = bit_or s_attr_pure_instructions s_attr_some_instructions

-- Platform IDs for LC_BUILD_VERSION
platform_macos  = 1

-- Standard macOS layout
pagezero_vmsize = 4294967296   -- 4 GB
text_vmaddr     = 4294967296   -- 0x100000000 (just past pagezero)
page_size       = 16384        -- 16 KB (ARM64 page)

-- ============================================================================
-- Byte-emission primitives (reuse codebuf.rail's int-array byte buffer)
-- ============================================================================

-- Write one byte at off. Returns next offset.
mw_u8 buf off v =
  let _ = arr_set buf off (bit_and v 255)
  off + 1

-- little-endian u16 (used by nlist_64 n_desc)
mw_u16 buf off v =
  let _ = arr_set buf off (bit_and v 255)
  let _ = arr_set buf (off + 1) (bit_and (shr v 8) 255)
  off + 2

-- Write 4 bytes little-endian.
mw_u32 buf off v =
  let _ = arr_set buf off       (bit_and v 255)
  let _ = arr_set buf (off + 1) (bit_and (shr v 8) 255)
  let _ = arr_set buf (off + 2) (bit_and (shr v 16) 255)
  let _ = arr_set buf (off + 3) (bit_and (shr v 24) 255)
  off + 4

-- Write 8 bytes little-endian. Rail's int is tagged 63-bit, so values up to
-- ~9.2e18 fit; for our purposes (offsets, sizes, vmaddrs up to 0x1_0000_4000)
-- this is fine.
mw_u64 buf off v =
  let _ = arr_set buf off       (bit_and v 255)
  let _ = arr_set buf (off + 1) (bit_and (shr v 8) 255)
  let _ = arr_set buf (off + 2) (bit_and (shr v 16) 255)
  let _ = arr_set buf (off + 3) (bit_and (shr v 24) 255)
  let _ = arr_set buf (off + 4) (bit_and (shr v 32) 255)
  let _ = arr_set buf (off + 5) (bit_and (shr v 40) 255)
  let _ = arr_set buf (off + 6) (bit_and (shr v 48) 255)
  let _ = arr_set buf (off + 7) (bit_and (shr v 56) 255)
  off + 8

-- Write a fixed-length zero-padded string. Used for segname (16 bytes)
-- and sectname (16 bytes). String content is copied; remainder zero-fills.
mw_str_padded buf off str len =
  let n = length (chars str)
  let copied = mw_str_copy buf off (chars str) 0 (if n > len then len else n)
  mw_zeros buf copied (len - (if n > len then len else n))

mw_str_copy buf off cs i n =
  if i >= n then off + n
  else
    let _ = arr_set buf (off + i) (char_to_int (head cs))
    mw_str_copy buf off (tail cs) (i + 1) n

mw_zeros buf off n =
  if n <= 0 then off
  else
    let _ = arr_set buf off 0
    mw_zeros buf (off + 1) (n - 1)

-- Copy n bytes from src buffer @ src_off into dst buffer @ dst_off.
mw_copy_bytes dst dst_off src src_off n =
  if n <= 0 then dst_off
  else
    let _ = arr_set dst dst_off (arr_get src src_off)
    mw_copy_bytes dst (dst_off + 1) src (src_off + 1) (n - 1)

-- Write a NUL-terminated C string at off. Returns offset after the NUL.
mw_cstr buf off str =
  let cs = chars str
  let after = mw_cstr_copy buf off cs
  mw_u8 buf after 0

mw_cstr_copy buf off cs =
  if cs == [] then off
  else
    let _ = arr_set buf off (char_to_int (head cs))
    mw_cstr_copy buf (off + 1) (tail cs)

-- ============================================================================
-- Header (32 bytes)
-- ============================================================================

emit_mach_header buf off ncmds sizeofcmds flags =
  let off1 = mw_u32 buf off       mh_magic_64
  let off2 = mw_u32 buf off1      cpu_type_arm64
  let off3 = mw_u32 buf off2      cpu_subtype_arm64_all
  let off4 = mw_u32 buf off3      mh_execute
  let off5 = mw_u32 buf off4      ncmds
  let off6 = mw_u32 buf off5      sizeofcmds
  let off7 = mw_u32 buf off6      flags
  mw_u32 buf off7 0   -- reserved

-- ============================================================================
-- LC_SEGMENT_64 + Section_64 emitters
-- ============================================================================

-- Emit a no-section segment (used by __PAGEZERO and __LINKEDIT).
-- cmdsize = 72.
emit_segment_64_nosects buf off segname vmaddr vmsize fileoff filesize maxprot initprot =
  let o1 = mw_u32 buf off    lc_segment_64
  let o2 = mw_u32 buf o1     72                  -- cmdsize
  let o3 = mw_str_padded buf o2 segname 16
  let o4 = mw_u64 buf o3     vmaddr
  let o5 = mw_u64 buf o4     vmsize
  let o6 = mw_u64 buf o5     fileoff
  let o7 = mw_u64 buf o6     filesize
  let o8 = mw_u32 buf o7     maxprot
  let o9 = mw_u32 buf o8     initprot
  let o10 = mw_u32 buf o9    0                   -- nsects
  mw_u32 buf o10 0                               -- flags

-- Emit an LC_SEGMENT_64 with a single __text section. cmdsize = 72 + 80 = 152.
-- Used for __TEXT.
emit_segment_64_text buf off vmaddr vmsize fileoff filesize sect_addr sect_size sect_offset sect_align =
  let o1 = mw_u32 buf off    lc_segment_64
  let o2 = mw_u32 buf o1     152                 -- cmdsize (72 + 80)
  let o3 = mw_str_padded buf o2 "__TEXT" 16
  let o4 = mw_u64 buf o3     vmaddr
  let o5 = mw_u64 buf o4     vmsize
  let o6 = mw_u64 buf o5     fileoff
  let o7 = mw_u64 buf o6     filesize
  let o8 = mw_u32 buf o7     vm_prot_rx          -- maxprot
  let o9 = mw_u32 buf o8     vm_prot_rx          -- initprot
  let o10 = mw_u32 buf o9    1                   -- nsects
  let o11 = mw_u32 buf o10   0                   -- flags
  -- Section_64 for __text follows immediately
  let s1 = mw_str_padded buf o11 "__text" 16
  let s2 = mw_str_padded buf s1  "__TEXT" 16
  let s3 = mw_u64 buf s2 sect_addr
  let s4 = mw_u64 buf s3 sect_size
  let s5 = mw_u32 buf s4 sect_offset
  let s6 = mw_u32 buf s5 sect_align
  let s7 = mw_u32 buf s6 0                       -- reloff
  let s8 = mw_u32 buf s7 0                       -- nreloc
  let s9 = mw_u32 buf s8 section_text_flags
  let s10 = mw_u32 buf s9 0                      -- reserved1
  let s11 = mw_u32 buf s10 0                     -- reserved2
  mw_u32 buf s11 0                               -- reserved3

-- ============================================================================
-- LC_SYMTAB (24 bytes)
-- ============================================================================
emit_symtab buf off symoff nsyms stroff strsize =
  let o1 = mw_u32 buf off  lc_symtab
  let o2 = mw_u32 buf o1   24
  let o3 = mw_u32 buf o2   symoff
  let o4 = mw_u32 buf o3   nsyms
  let o5 = mw_u32 buf o4   stroff
  mw_u32 buf o5            strsize

-- ============================================================================
-- LC_DYSYMTAB (80 bytes — all zeros except cmd+size for a no-dylib binary)
-- ============================================================================
emit_dysymtab_empty buf off =
  let o1 = mw_u32 buf off  lc_dysymtab
  let o2 = mw_u32 buf o1   80
  emit_dysymtab_zeros buf o2 18    -- 18 remaining u32 fields, all zero

emit_dysymtab_zeros buf off n =
  if n <= 0 then off
  else
    let next = mw_u32 buf off 0
    emit_dysymtab_zeros buf next (n - 1)

-- ============================================================================
-- LC_LOAD_DYLINKER (32 bytes for "/usr/lib/dyld\0" + padding)
-- Header is 12 bytes; name starts at offset 12; total 32 bytes; remainder zero.
-- ============================================================================
emit_load_dylinker buf off =
  let o1 = mw_u32 buf off  lc_load_dylinker
  let o2 = mw_u32 buf o1   32                    -- cmdsize
  let o3 = mw_u32 buf o2   12                    -- name offset within cmd
  -- Name "/usr/lib/dyld" = 13 chars + NUL = 14 bytes; rest padded to 32
  let o4 = mw_cstr buf o3 "/usr/lib/dyld"
  mw_zeros buf o4 (off + 32 - o4)

-- ============================================================================
-- LC_UUID (24 bytes) — 16-byte UUID
-- Phase 1: emit a deterministic placeholder (all zeros except version nibble).
-- Phase 2 will hash the binary content into the UUID for traceability.
-- ============================================================================
emit_uuid buf off =
  let o1 = mw_u32 buf off  lc_uuid
  let o2 = mw_u32 buf o1   24
  -- 16 bytes of UUID; bits set to mark v4 (random) variant so it passes
  -- otool's UUID printer cleanly.
  let _ = arr_set buf o2 0
  let _ = arr_set buf (o2 + 1) 0
  let _ = arr_set buf (o2 + 2) 0
  let _ = arr_set buf (o2 + 3) 0
  let _ = arr_set buf (o2 + 4) 0
  let _ = arr_set buf (o2 + 5) 0
  let _ = arr_set buf (o2 + 6) 64           -- version 4 nibble (0x40)
  let _ = arr_set buf (o2 + 7) 0
  let _ = arr_set buf (o2 + 8) 128          -- variant (0x80)
  let _ = arr_set buf (o2 + 9) 0
  let _ = arr_set buf (o2 + 10) 0
  let _ = arr_set buf (o2 + 11) 0
  let _ = arr_set buf (o2 + 12) 0
  let _ = arr_set buf (o2 + 13) 0
  let _ = arr_set buf (o2 + 14) 0
  let _ = arr_set buf (o2 + 15) 0
  o2 + 16

-- ============================================================================
-- LC_BUILD_VERSION (32 bytes; one tool entry)
-- Version encoding: X.Y.Z → (X << 16) | (Y << 8) | Z
-- ============================================================================
pack_version major minor patch =
  bit_or (shl major 16) (bit_or (shl minor 8) patch)

emit_build_version buf off minos_packed sdk_packed =
  let o1 = mw_u32 buf off  lc_build_version
  let o2 = mw_u32 buf o1   32                    -- cmdsize
  let o3 = mw_u32 buf o2   platform_macos
  let o4 = mw_u32 buf o3   minos_packed
  let o5 = mw_u32 buf o4   sdk_packed
  let o6 = mw_u32 buf o5   1                     -- ntools
  -- One tool entry (8 bytes): tool=3 (LD), version=1
  let o7 = mw_u32 buf o6   3                     -- TOOL_LD
  mw_u32 buf o7            1                     -- tool version

-- ============================================================================
-- LC_MAIN (24 bytes)
-- ============================================================================
emit_main buf off entryoff stacksize =
  let o1 = mw_u32 buf off  lc_main
  let o2 = mw_u32 buf o1   24
  let o3 = mw_u64 buf o2   entryoff
  mw_u64 buf o3            stacksize

-- ============================================================================
-- LC_CODE_SIGNATURE (16 bytes) — points at the embedded SuperBlob in __LINKEDIT
-- ============================================================================
emit_code_signature_lc buf off dataoff datasize =
  let o1 = mw_u32 buf off  lc_code_signature
  let o2 = mw_u32 buf o1   16
  let o3 = mw_u32 buf o2   dataoff
  mw_u32 buf o3            datasize

-- ============================================================================
-- Byte buffer → hex string (for binary write via xxd -r -p).
--
-- Rail's write_file uses strlen to determine length, so a byte buffer
-- containing NULs (which all Mach-O headers do) gets truncated. We
-- instead hex-encode (every byte → two ASCII hex chars, no NULs ever)
-- and pipe through `xxd -r -p` to materialise the real binary.
-- ============================================================================

hex_digits = "0123456789abcdef"

hex_char_at i =
  head (drop_chars i (chars hex_digits))

drop_chars n cs =
  if n <= 0 then cs
  else if cs == [] then []
  else drop_chars (n - 1) (tail cs)

macho_byte_to_hex b =
  let hi = bit_and (shr b 4) 15
  let lo = bit_and b 15
  cat [char_from_int (char_to_int (hex_char_at hi)),
       char_from_int (char_to_int (hex_char_at lo))]

macho_buf_to_hex_chars buf i acc =
  if i < 0 then acc
  else macho_buf_to_hex_chars buf (i - 1) (cons (macho_byte_to_hex (arr_get buf i)) acc)

macho_buf_to_hex buf n =
  join "" (macho_buf_to_hex_chars buf (n - 1) [])

-- Write the byte buffer to disk via hex+xxd pipeline. The resulting
-- file is also chmod +x so it's ready to codesign + run.
-- Returns 0 on success, non-zero on shell failure.
macho_write_file path buf n =
  let hex = macho_buf_to_hex buf n
  let hex_path = cat [path, ".hex"]
  let _ = write_file hex_path hex
  let _ = shell (cat ["xxd -r -p ", hex_path, " > ", path, " && chmod +x ", path, " && rm -f ", hex_path])
  0
