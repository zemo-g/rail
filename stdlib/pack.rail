-- stdlib/pack.rail -- compact int32 packing: 4 bytes per value instead of Rail's 8-byte tagged int.
--
-- A Rail int array (arr_new) stores every element as an 8-byte tagged integer. For fixed-point
-- model weights (F=24: a weight |w|<128 fits in a signed 32-bit value, since 128*2^24 = 2^31) that
-- is 2x wasteful -- a 0.6B-param model is 4.8 GB as 8-byte ints but only 2.4 GB packed. Halving the
-- footprint lets a bigger model stay cached (fast) before you must stream it. Backed by a malloc'd
-- byte buffer; indexed with byte_at/byte_set. Little-endian, signed two's-complement int32.
--
-- EXACTNESS: pack_get(pack_set(b,i,v)) == v for any v in [-2^31, 2^31-1]. Verified round-trip
-- including negatives and 2^26-magnitude weights. Do NOT pack values outside int32 range (e.g.
-- massive activations ~2^38) -- those stay in 8-byte int arrays. Weights are small; activations are not.

foreign malloc size -> ptr
foreign free ptr -> int

-- allocate a packed buffer for n int32 values (4n bytes). Returns a raw pointer (thread it, do not
-- store in an int array). malloc'd memory persists until pack_release (not GC-tracked, so it stays
-- alive across GC -- which is what we want for a weight cache).
pack_alloc n = malloc (n * 4)
pack_release buf = free buf

-- read the int32 at logical index i (sign-extended to a Rail int)
pack_get buf i =
  let b = i * 4 in
  let v = (byte_at buf b) + (byte_at buf (b + 1)) * 256 + (byte_at buf (b + 2)) * 65536 + (byte_at buf (b + 3)) * 16777216 in
  if v >= 2147483648 then v - 4294967296 else v

-- write the int32 value v at logical index i (two's-complement little-endian)
pack_set buf i v =
  let b = i * 4 in
  let u = if v < 0 then v + 4294967296 else v in
  let _ = byte_set buf b (u - (u / 256) * 256) in
  let _ = byte_set buf (b + 1) ((u / 256) - (u / 65536) * 256) in
  let _ = byte_set buf (b + 2) ((u / 65536) - (u / 16777216) * 256) in
  let _ = byte_set buf (b + 3) (u / 16777216) in
  0
