-- stdlib/mhd_axisym.rail — Axisymmetric (r,z) MHD core for MPD thrusters
--
-- Pure-Rail reference implementation that mirrors mhd_axisym.metal so the
-- Metal kernel (step 5) can be written against a tested algorithm. The
-- Rail version runs at modest grid sizes (32x64 default) for fast smoke
-- testing; the production Metal kernel uses 256x512.
--
-- 5 conserved fields per cell: rho, rho*v_r, rho*v_z, E, B_theta.
-- Applied fields B_z and B_r live in separate arrays — they come from
-- the coil geometry and do not evolve.
--
-- This module provides:
--   - state layout, indexing, primitive recovery
--   - ideal axisym fluxes (no source terms)
--   - Lax-Friedrichs interior step
--   - boundary conditions (axis symmetry, wall, inlet, outlet)
--
-- Source terms (Lorentz, Ohmic, 1/r geometry) live in stdlib/mhd_mpd.rail.

-- ═══════════════════════════════════════════════════════════
-- GRID / STATE CONSTANTS
-- 32 x 64 reference grid (Metal kernel uses 256 x 512).
-- ═══════════════════════════════════════════════════════════

ma_nr         = 32
ma_nz         = 64
ma_nrnz       = 2048
ma_nfields    = 5
ma_state_size = 10240

-- Hoisted boundary-arithmetic constants.
-- Working around a Rail compiler bug where `(ma_nz - 2)` and similar
-- inline `(named_int - small_int)` expressions, when passed as a
-- positional function argument alongside another integer parameter
-- whose value is 0, produce wrong index computation in the callee.
-- Pattern verified 2026-04-28: `ma_get s f j (ma_nz - 2)` fails for
-- j=0 (returns 0 instead of the cell value), but `ma_get s f j 62`
-- and `ma_get s f j ma_nzm2` both work.  Investigation deferred to
-- a separate compiler-level session; meanwhile, hoist all such
-- expressions to named module-level constants.
ma_nrm1 = 31
ma_nrm2 = 30
ma_nzm1 = 63
ma_nzm2 = 62

ma_f_rho = 0
ma_f_mr  = 1
ma_f_mz  = 2
ma_f_en  = 3
ma_f_bt  = 4

-- mu0 = 4*pi*1e-7
-- 1/mu0 = 795774.7154594768

-- ═══════════════════════════════════════════════════════════
-- INDEXING — j = radial, i = axial (matches Metal layout)
-- ═══════════════════════════════════════════════════════════

ma_idx f j i = f * ma_nrnz + j * ma_nz + i
ma_get s f j i = float_arr_get s (ma_idx f j i)
ma_put s f j i v = float_arr_set s (ma_idx f j i) v

-- ═══════════════════════════════════════════════════════════
-- PRIMITIVE RECOVERY (gas pressure with floor)
-- gamma - 1 = 0.6666666666666667
-- ═══════════════════════════════════════════════════════════

ma_pressure s j i =
  let rho = ma_get s ma_f_rho j i
  let rho_safe = if rho < 0.00000001 then 0.00000001 else rho
  let mr = ma_get s ma_f_mr j i
  let mz = ma_get s ma_f_mz j i
  let bt = ma_get s ma_f_bt j i
  let e  = ma_get s ma_f_en j i
  let ke = 0.5 * (mr * mr + mz * mz) / rho_safe
  let me = 0.5 * bt * bt * 795774.7154594768
  let p_raw = 0.6666666666666667 * (e - ke - me)
  if p_raw < 0.000001 then 0.000001 else p_raw

-- ═══════════════════════════════════════════════════════════
-- IDEAL AXISYM FLUXES (radial and axial)
-- F_r = [m_r, m_r*v_r + p_t, m_r*v_z, (E+p_t)*v_r, v_r*B_t]
-- F_z = [m_z, m_z*v_r,        m_z*v_z + p_t, (E+p_t)*v_z, -v_z*B_t]
-- ═══════════════════════════════════════════════════════════

ma_flux_r s j i fa =
  let rho = ma_get s ma_f_rho j i
  let rho_safe = if rho < 0.00000001 then 0.00000001 else rho
  let mr = ma_get s ma_f_mr j i
  let mz = ma_get s ma_f_mz j i
  let bt = ma_get s ma_f_bt j i
  let e  = ma_get s ma_f_en j i
  let vr = mr / rho_safe
  let p = ma_pressure s j i
  let pm = 0.5 * bt * bt * 795774.7154594768
  let pt = p + pm
  let _ = float_arr_set fa 0 mr
  let _ = float_arr_set fa 1 (mr * vr + pt)
  let _ = float_arr_set fa 2 (mr * mz / rho_safe)
  let _ = float_arr_set fa 3 ((e + pt) * vr)
  float_arr_set fa 4 (vr * bt)

ma_flux_z s j i fa =
  let rho = ma_get s ma_f_rho j i
  let rho_safe = if rho < 0.00000001 then 0.00000001 else rho
  let mr = ma_get s ma_f_mr j i
  let mz = ma_get s ma_f_mz j i
  let bt = ma_get s ma_f_bt j i
  let e  = ma_get s ma_f_en j i
  let vz = mz / rho_safe
  let p = ma_pressure s j i
  let pm = 0.5 * bt * bt * 795774.7154594768
  let pt = p + pm
  let _ = float_arr_set fa 0 mz
  let _ = float_arr_set fa 1 (mz * mr / rho_safe)
  let _ = float_arr_set fa 2 (mz * vz + pt)
  let _ = float_arr_set fa 3 ((e + pt) * vz)
  float_arr_set fa 4 (0.0 - vz * bt)

-- ═══════════════════════════════════════════════════════════
-- WAVE SPEED (used for adaptive dt)
-- ═══════════════════════════════════════════════════════════

ma_cell_speed s j i =
  let rho = ma_get s ma_f_rho j i
  let rho_safe = if rho < 0.00000001 then 0.00000001 else rho
  let mr = ma_get s ma_f_mr j i
  let mz = ma_get s ma_f_mz j i
  let bt = ma_get s ma_f_bt j i
  let p = ma_pressure s j i
  let vr = mr / rho_safe
  let vz = mz / rho_safe
  let a2 = 1.6666666666666667 * p / rho_safe
  let va2 = bt * bt * 795774.7154594768 / rho_safe
  let cf = sqrt (a2 + va2)
  sqrt (vr * vr + vz * vz) + cf

ma_speed_check s i acc =
  let s_ = ma_cell_speed s (i / ma_nz) (i % ma_nz)
  let cur = float_arr_get acc 0
  if s_ > cur then float_arr_set acc 0 s_ else 0

ma_speed_loop s i acc =
  if i >= ma_nrnz then 0
  else
    let _ = ma_speed_check s i acc
    ma_speed_loop s (i + 1) acc

ma_max_speed s =
  let acc = float_arr_new 1 0.0
  let _ = ma_speed_loop s 0 acc
  float_arr_get acc 0

-- ═══════════════════════════════════════════════════════════
-- BOUNDARY-CELL DETECTION + WRITES
-- Inlet (i=0): fixed inflow with prescribed rho, vz, p, B_theta from
-- enclosed-current law.  Outlet (i=NZ-1): zero-gradient extrapolation.
-- Axis (j=0): symmetry — mirror cell, flip m_r.
-- Wall (j=NR-1): no-penetration — mirror cell, flip m_r.
-- ═══════════════════════════════════════════════════════════

ma_is_boundary j i =
  if j == 0 then 1
  else if j >= ma_nrm1 then 1
  else if i == 0 then 1
  else if i >= ma_nzm1 then 1
  else 0

-- ctx packed (10 floats): [
--   0: dt/(2*dr)    (LF coefficient r)
--   1: dt/(2*dz)    (LF coefficient z)
--   2: rho_in
--   3: vz_in
--   4: p_in
--   5: I_arc
--   6: r_min
--   7: r_max
--   8: dr
--   9: dz
-- ]
-- Bundling inlet + coeffs into one ctx array drops ma_step_loop's arity
-- from 9 to 8 — Rail's TCO is reliable up through 8 args (verified
-- against mk_lxf_loop in stdlib/mhd_kernel.rail) but 9 args produces
-- a silent loop-arity bug (only the j=0 row gets written).

ma_inlet_b_theta j ctx =
  let r_min = float_arr_get ctx 6
  let r_max = float_arr_get ctx 7
  let dr    = float_arr_get ctx 8
  let r_j = r_min + (to_float j + 0.5) * dr
  let i_arc = float_arr_get ctx 5
  let num = r_j * r_j - r_min * r_min
  let den = r_j * (r_max * r_max - r_min * r_min)
  let denom_safe = if den < 0.000000000001 then 0.000000000001 else den
  -- B_theta = mu0 * I * (r^2 - r_min^2) / (2*pi * r * (r_max^2 - r_min^2))
  -- mu0 / (2*pi) = 2.0e-7
  0.0000002 * i_arc * num / denom_safe

ma_apply_bc s ns ctx j i =
  if j == 0 then
    -- axis symmetry: mirror j=1
    let _ = ma_put ns ma_f_rho j i (ma_get s ma_f_rho 1 i)
    let _ = ma_put ns ma_f_mr  j i (0.0 - ma_get s ma_f_mr 1 i)
    let _ = ma_put ns ma_f_mz  j i (ma_get s ma_f_mz 1 i)
    let _ = ma_put ns ma_f_en  j i (ma_get s ma_f_en 1 i)
    ma_put ns ma_f_bt  j i (ma_get s ma_f_bt 1 i)
  else if j >= ma_nrm1 then
    -- wall: mirror j=NR-2
    let _ = ma_put ns ma_f_rho j i (ma_get s ma_f_rho ma_nrm2 i)
    let _ = ma_put ns ma_f_mr  j i (0.0 - ma_get s ma_f_mr ma_nrm2 i)
    let _ = ma_put ns ma_f_mz  j i (ma_get s ma_f_mz ma_nrm2 i)
    let _ = ma_put ns ma_f_en  j i (ma_get s ma_f_en ma_nrm2 i)
    ma_put ns ma_f_bt  j i (ma_get s ma_f_bt ma_nrm2 i)
  else if i == 0 then
    -- inlet: fixed inflow
    let rho_in = float_arr_get ctx 2
    let vz_in  = float_arr_get ctx 3
    let p_in   = float_arr_get ctx 4
    let bt_in  = ma_inlet_b_theta j ctx
    let ke = 0.5 * rho_in * vz_in * vz_in
    let me = 0.5 * bt_in * bt_in * 795774.7154594768
    let _ = ma_put ns ma_f_rho j i rho_in
    let _ = ma_put ns ma_f_mr  j i 0.0
    let _ = ma_put ns ma_f_mz  j i (rho_in * vz_in)
    let _ = ma_put ns ma_f_en  j i (p_in / 0.6666666666666667 + ke + me)
    ma_put ns ma_f_bt  j i bt_in
  else
    -- outlet: zero-gradient from i=NZ-2
    let _ = ma_put ns ma_f_rho j i (ma_get s ma_f_rho j ma_nzm2)
    let _ = ma_put ns ma_f_mr  j i (ma_get s ma_f_mr  j ma_nzm2)
    let _ = ma_put ns ma_f_mz  j i (ma_get s ma_f_mz  j ma_nzm2)
    let _ = ma_put ns ma_f_en  j i (ma_get s ma_f_en  j ma_nzm2)
    ma_put ns ma_f_bt  j i (ma_get s ma_f_bt  j ma_nzm2)

-- ═══════════════════════════════════════════════════════════
-- LAX-FRIEDRICHS INTERIOR STEP (no source terms — those live in mhd_mpd)
-- ═══════════════════════════════════════════════════════════

ma_lxf_apply s ns ctx frp frm fzp fzm j i f =
  if f >= 5 then 0
  else
    let avg = (ma_get s f (j + 1) i + ma_get s f (j - 1) i + ma_get s f j (i + 1) + ma_get s f j (i - 1)) / 4.0
    let dfr = float_arr_get frp f - float_arr_get frm f
    let dfz = float_arr_get fzp f - float_arr_get fzm f
    let cr = float_arr_get ctx 0
    let cz = float_arr_get ctx 1
    let val = avg - cr * dfr - cz * dfz
    let _ = float_arr_set ns (ma_idx f j i) val
    ma_lxf_apply s ns ctx frp frm fzp fzm j i (f + 1)

ma_lxf_cell s ns ctx frp frm fzp fzm j i =
  let _ = ma_flux_r s (j + 1) i frp
  let _ = ma_flux_r s (j - 1) i frm
  let _ = ma_flux_z s j (i + 1) fzp
  let _ = ma_flux_z s j (i - 1) fzm
  ma_lxf_apply s ns ctx frp frm fzp fzm j i 0

-- Per-cell dispatch.  ctx carries inlet + coeffs; this keeps the outer
-- loop's recursive call at exactly 8 args (Rail's TCO sweet spot).
ma_step_one s ns ctx frp frm fzp fzm i =
  let j = i / ma_nz
  let z = i % ma_nz
  if ma_is_boundary j z == 1 then ma_apply_bc s ns ctx j z
  else ma_lxf_cell s ns ctx frp frm fzp fzm j z

ma_step_loop s ns ctx frp frm fzp fzm i =
  if i >= ma_nrnz then 0
  else
    let _ = ma_step_one s ns ctx frp frm fzp fzm i
    ma_step_loop s ns ctx frp frm fzp fzm (i + 1)

-- ma_lxf_step now takes the ctx array directly (caller builds it once,
-- reuses across many steps).  See ma_make_ctx below for the helper.
ma_lxf_step s ctx dt =
  let dr = float_arr_get ctx 8
  let dz = float_arr_get ctx 9
  let _ = float_arr_set ctx 0 (dt / (2.0 * dr))
  let _ = float_arr_set ctx 1 (dt / (2.0 * dz))
  let ns = float_arr_new ma_state_size 0.0
  let frp = float_arr_new 5 0.0
  let frm = float_arr_new 5 0.0
  let fzp = float_arr_new 5 0.0
  let fzm = float_arr_new 5 0.0
  let _ = ma_step_loop s ns ctx frp frm fzp fzm 0
  ns

-- Construct ctx from operating-point parameters.  dt-derived coeffs
-- are filled later by ma_lxf_step.
ma_make_ctx rho_in vz_in p_in i_arc r_min r_max dr dz =
  let ctx = float_arr_new 10 0.0
  let _ = float_arr_set ctx 0 0.0
  let _ = float_arr_set ctx 1 0.0
  let _ = float_arr_set ctx 2 rho_in
  let _ = float_arr_set ctx 3 vz_in
  let _ = float_arr_set ctx 4 p_in
  let _ = float_arr_set ctx 5 i_arc
  let _ = float_arr_set ctx 6 r_min
  let _ = float_arr_set ctx 7 r_max
  let _ = float_arr_set ctx 8 dr
  let _ = float_arr_set ctx 9 dz
  ctx

-- ═══════════════════════════════════════════════════════════
-- INITIAL STATE — uniform inlet conditions everywhere
-- ═══════════════════════════════════════════════════════════

ma_init_cell s ctx i =
  let j = i / ma_nz
  let z = i % ma_nz
  let rho_in = float_arr_get ctx 2
  let vz_in  = float_arr_get ctx 3
  let p_in   = float_arr_get ctx 4
  let bt_in  = ma_inlet_b_theta j ctx
  let ke = 0.5 * rho_in * vz_in * vz_in
  let me = 0.5 * bt_in * bt_in * 795774.7154594768
  let _ = ma_put s ma_f_rho j z rho_in
  let _ = ma_put s ma_f_mr  j z 0.0
  let _ = ma_put s ma_f_mz  j z (rho_in * vz_in)
  let _ = ma_put s ma_f_en  j z (p_in / 0.6666666666666667 + ke + me)
  ma_put s ma_f_bt  j z bt_in

ma_init_loop s ctx i =
  if i >= ma_nrnz then 0
  else
    let _ = ma_init_cell s ctx i
    ma_init_loop s ctx (i + 1)

ma_init_state ctx =
  let s = float_arr_new ma_state_size 0.0
  let _ = ma_init_loop s ctx 0
  s

-- ═══════════════════════════════════════════════════════════
-- DIAGNOSTICS — total mass, total energy, max |B_theta|
-- (volume integrals; geometry weighting deferred to caller)
-- ═══════════════════════════════════════════════════════════

ma_sum_field s f i acc =
  if i >= ma_nrnz then 0
  else
    let _ = float_arr_set acc 0 (float_arr_get acc 0 + float_arr_get s (f * ma_nrnz + i))
    ma_sum_field s f (i + 1) acc

ma_total_mass s =
  let acc = float_arr_new 1 0.0
  let _ = ma_sum_field s ma_f_rho 0 acc
  float_arr_get acc 0

ma_total_energy s =
  let acc = float_arr_new 1 0.0
  let _ = ma_sum_field s ma_f_en 0 acc
  float_arr_get acc 0

ma_max_bt_check s i acc =
  let bt = float_arr_get s (ma_f_bt * ma_nrnz + i)
  let abt = if bt < 0.0 then 0.0 - bt else bt
  let cur = float_arr_get acc 0
  if abt > cur then float_arr_set acc 0 abt else 0

ma_max_bt_loop s i acc =
  if i >= ma_nrnz then 0
  else
    let _ = ma_max_bt_check s i acc
    ma_max_bt_loop s (i + 1) acc

ma_max_b_theta s =
  let acc = float_arr_new 1 0.0
  let _ = ma_max_bt_loop s 0 acc
  float_arr_get acc 0
