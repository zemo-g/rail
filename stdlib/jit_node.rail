-- stdlib/jit_node.rail — JIT op-DAG types + tape primitives.
--
-- Split out of stdlib/jit_tape.rail (Phase 2.7, 2026-05-15) so that
-- consumers needing only the DAG structure (jit_match, jit_emit) can
-- depend on this file without pulling in stdlib/transformer.rail.
-- stdlib/jit_tape.rail still owns the traced_* execution wrappers that
-- need transformer for rmsnorm_save / tensor_matmul.

-- ───────────────────────────────────────────────────────────────────────
-- TYPES
-- ───────────────────────────────────────────────────────────────────────

-- A JIT op-DAG node.
--   tag      : string identifying the op  ("rmsnorm" / "matmul" / "leaf" / ...)
--   shape    : output shape as int list   ([512, 64] etc.)
--   dtype    : "f64" | "bf16" | "f16"     — feeds per-tile precision plan
--   parents  : list of int tape indices   (-1 = leaf, never a JIT input)
type JitNode = | JitNode tag shape dtype parents

-- TracedTensor wraps the actual Tensor with its tape index.  Phase 3
-- will defer execution; today we trace AND execute.
type TracedTensor = | Traced value tape_idx

-- ───────────────────────────────────────────────────────────────────────
-- TAPE MANAGEMENT
-- ───────────────────────────────────────────────────────────────────────

jit_tape_new _ = []

jit_tape_push tape node =
  let idx = length tape
  let new_tape = append tape (cons node [])
  cons new_tape (cons idx [])

jit_tape_get tape i = jit_tape_get_acc tape i 0

jit_tape_get_acc tape i cur =
  if cur > i then JitNode "missing" [] "f64" []
  else if cur == i then head tape
  else jit_tape_get_acc (tail tape) i (cur + 1)

-- ───────────────────────────────────────────────────────────────────────
-- UTILITIES
-- ───────────────────────────────────────────────────────────────────────

-- Same as stdlib/tensor.rail's list_nth.  Named jit_nth so consumers of
-- jit_node can avoid importing tensor.rail (which would re-introduce a
-- duplicate-symbol path through transformer for callers like
-- lm_v3_chunked_jit_long that import transformer directly).
jit_nth n xs =
  if n == 0 then head xs
  else jit_nth (n - 1) (tail xs)

-- ───────────────────────────────────────────────────────────────────────
-- ACCESSORS
-- ───────────────────────────────────────────────────────────────────────

traced_value t = match t | Traced v _ -> v
traced_idx   t = match t | Traced _ i -> i

node_tag     n = match n | JitNode t _ _ _ -> t
node_shape   n = match n | JitNode _ s _ _ -> s
node_dtype   n = match n | JitNode _ _ d _ -> d
node_parents n = match n | JitNode _ _ _ p -> p

-- ───────────────────────────────────────────────────────────────────────
-- DEBUG dump
-- ───────────────────────────────────────────────────────────────────────

jit_tape_dump_loop tape n i =
  if i >= n then 0
  else
    let node = jit_tape_get tape i
    let tag = node_tag node
    let shape = node_shape node
    let dtype = node_dtype node
    let parents = node_parents node
    let _ = print (cat ["  [", show i, "] ", tag,
                        "  shape=", show shape,
                        "  dtype=", dtype,
                        "  parents=", show parents])
    jit_tape_dump_loop tape n (i + 1)

jit_tape_dump tape =
  let n = length tape
  let _ = print (cat ["=== jit tape (", show n, " nodes) ==="])
  jit_tape_dump_loop tape n 0
