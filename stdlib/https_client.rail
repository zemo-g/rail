-- stdlib/https_client.rail — pure-Rail HTTPS client (TLS 1.3 over TCP).
-- Layer 7: composes tls13_client.rail + tls13_record.rail + socket.rail.

import "stdlib/socket.rail"
import "stdlib/tls13_client.rail"
import "stdlib/tls13_record.rail"
import "stdlib/dns.rail"

-- libc stdio FFI for the streaming-to-file path.  Declared inline (not
-- via stdlib/file.rail) because file.rail wraps fclose as `close fp`,
-- which would collide with socket.rail's `foreign close fd -> int`.
foreign fopen path mode -> ptr
foreign fwrite buf size count fp
foreign fclose fp

-- ── Random bytes via /dev/urandom ───────────────────────────────────
-- Pipe urandom → od → tr to hex on stdout, capture via shell(), parse
-- with hex_to_bytes. Bytes stay in process memory end-to-end.

hc_read_random n =
  let cmd = join "" ["dd if=/dev/urandom bs=1 count=", show n, " 2>/dev/null | od -An -v -tx1 | tr -d ' \\n'"]
  let hex = shell cmd
  -- Guard against PATH issues / missing tools producing a short or empty
  -- hex string: if we silently fell back to zero-length output, the
  -- handshake would proceed with all-zero client random / nonces. Abort
  -- via `error` so the caller's try/handler can surface this rather
  -- than silently shipping a zero key.
  if length hex != 2 * n then error "hc_read_random: short read from /dev/urandom (PATH or tool missing?)"
  else hex_to_bytes hex

-- ── C-buffer ⇄ Rail int-array byte copies ─────────────────────────

hc_arr_to_cbuf arr p n =
  hc_a2c_at arr p 0 n

hc_a2c_at arr p i n =
  if i >= n then 0
  else
    let _ = byte_set p i (arr_get arr i)
    hc_a2c_at arr p (i + 1) n

hc_cbuf_to_arr p arr n =
  hc_c2a_at p arr 0 n

hc_c2a_at p arr i n =
  if i >= n then 0
  else
    let _ = arr_set arr i (byte_at p i)
    hc_c2a_at p arr (i + 1) n

-- ── TCP byte I/O ────────────────────────────────────────────────────

hc_send_bytes fd arr n =
  let p = malloc n
  let _ = hc_arr_to_cbuf arr p n
  let r = send fd p n 0
  let _ = free p
  r

hc_recv_into fd p off want =
  if off >= want then off
  else
    let got = recv fd p want 0
    if got <= 0 then off
    else off + got

hc_recv_exact fd n =
  let p = malloc n
  let got = hc_recv_exact_loop fd p 0 n
  let arr = arr_new got 0
  let _ = hc_cbuf_to_arr p arr got
  let _ = free p
  let r = arr_new 2 0
  let _ = arr_set r 0 arr
  let _ = arr_set r 1 got
  r

hc_recv_exact_loop fd p off want =
  if off >= want then off
  else
    let scratch = malloc (want - off)
    let got = recv fd scratch (want - off) 0
    if got <= 0 then
      let _ = free scratch
      off
    else
      let _ = hc_scratch_copy scratch p 0 off got
      let _ = free scratch
      hc_recv_exact_loop fd p (off + got) want

hc_scratch_copy src dst src_off dst_off n =
  if n <= 0 then 0
  else
    let _ = byte_set dst dst_off (byte_at src src_off)
    hc_scratch_copy src dst (src_off + 1) (dst_off + 1) (n - 1)

-- ── TLS record reader ───────────────────────────────────────────────
-- Returns [record_bytes, record_len, valid].

hc_read_record fd =
  let hr = hc_recv_exact fd 5
  let hb = arr_get hr 0
  let hn = arr_get hr 1
  if hn != 5 then hc_rec_fail 0
  else
    let flen = arr_get hb 3 * 256 + arr_get hb 4
    if flen <= 0 then hc_rec_fail 0
    else if flen > 16640 then hc_rec_fail 0
    else
      let br = hc_recv_exact fd flen
      let bb = arr_get br 0
      let bn = arr_get br 1
      if bn != flen then hc_rec_fail 0
      else
        let total = 5 + flen
        let rec = arr_new total 0
        let _ = sha_copy_bytes hb rec 0 0 5
        let _ = sha_copy_bytes bb rec 0 5 flen
        let r = arr_new 3 0
        let _ = arr_set r 0 rec
        let _ = arr_set r 1 total
        let _ = arr_set r 2 1
        r

hc_rec_fail _ =
  let z = arr_new 0 0
  let r = arr_new 3 0
  let _ = arr_set r 0 z
  let _ = arr_set r 1 0
  let _ = arr_set r 2 0
  r

-- ── TCP connect convenience ────────────────────────────────────────

hc_connect_tcp ip port =
  let fd = tcp_socket 0
  if fd < 0 then 0 - 1
  else
    let sa = make_sockaddr_in port ip
    let r = connect fd sa sockaddr_in_size
    let _ = free sa
    if r == 0 then fd
    else
      let _ = close fd
      0 - 1

-- ── Ephemeral x25519 keypair ────────────────────────────────────────

hc_x25519_base _ =
  let p = arr_new 32 0
  let _ = arr_set p 0 9
  p

hc_gen_keypair _ =
  let priv = hc_read_random 32
  let pub = x25519 priv (hc_x25519_base 0)
  let kp = arr_new 2 0
  let _ = arr_set kp 0 priv
  let _ = arr_set kp 1 pub
  kp

-- ── Server flight reader: decrypt app-data records until Finished ───

hc_scan_finished buf n off =
  if off + 4 > n then 0
  else
    let t = arr_get buf off
    let body_hi = arr_get buf (off + 1)
    let body_mid = arr_get buf (off + 2)
    let body_lo = arr_get buf (off + 3)
    let body_len = body_hi * 65536 + body_mid * 256 + body_lo
    let next = off + 4 + body_len
    if next > n then 0
    else if t == 20 then
      if next == n then 1 else 0
    else hc_scan_finished buf n next

hc_flight_append acc acc_len frag frag_len =
  let new_len = acc_len + frag_len
  let new_acc = arr_new new_len 0
  let _ = sha_copy_bytes acc new_acc 0 0 acc_len
  let _ = sha_copy_bytes frag new_acc 0 acc_len frag_len
  let r = arr_new 2 0
  let _ = arr_set r 0 new_acc
  let _ = arr_set r 1 new_len
  r

hc_read_server_flight fd key iv =
  hc_rsf_loop fd key iv 0 (arr_new 0 0) 0

hc_rsf_loop fd key iv seq acc acc_len =
  let rec_r = hc_read_record fd
  if arr_get rec_r 2 == 0 then hc_rsf_err 0
  else
    let wire = arr_get rec_r 0
    let wire_len = arr_get rec_r 1
    let ctype = arr_get wire 0
    if ctype != 23 then hc_rsf_loop fd key iv seq acc acc_len
    else
      let dec = tls13_record_decrypt key iv seq wire wire_len
      if arr_get dec 3 == 0 then hc_rsf_err 0
      else
        let frag = arr_get dec 0
        let rtype = arr_get dec 1
        let flen = arr_get dec 2
        if rtype != 22 then hc_rsf_err 0
        else
          let app = hc_flight_append acc acc_len frag flen
          let new_acc = arr_get app 0
          let new_len = arr_get app 1
          let done = hc_scan_finished new_acc new_len 0
          if done == 1 then
            let r = arr_new 2 0
            let _ = arr_set r 0 new_acc
            let _ = arr_set r 1 new_len
            r
          else hc_rsf_loop fd key iv (seq + 1) new_acc new_len

hc_rsf_err _ =
  let z = arr_new 0 0
  let r = arr_new 2 0
  let _ = arr_set r 0 z
  let _ = arr_set r 1 (0 - 1)
  r

-- ── ServerHello parse + handshake traffic derivation ───────────────

-- Read first record (ServerHello), extract server key share, derive
-- server handshake traffic key/iv. Returns [sh_wire, sh_msg_len, s_hs_key, s_hs_iv, hs_hash, ch_msg_len_for_trans, ch_msg, valid].

hc_exchange_hello fd ch_msg ch_msg_len priv =
  let sh_rec = hc_read_record fd
  if arr_get sh_rec 2 == 0 then hc_xh_fail 0
  else
    let sh_wire = arr_get sh_rec 0
    let sh_wire_len = arr_get sh_rec 1
    if arr_get sh_wire 0 != 22 then hc_xh_fail 0
    else
      let sh_msg_len = sh_wire_len - 5
      let sh_msg = arr_new sh_msg_len 0
      let _ = sha_copy_bytes sh_wire sh_msg 5 0 sh_msg_len
      let parsed = tls13_parse_server_hello sh_msg sh_msg_len
      if arr_get parsed 3 == 0 then hc_xh_fail 0
      else
        let server_share = arr_get parsed 2
        let shared = x25519 priv server_share
        let t_len = ch_msg_len + sh_msg_len
        let t_buf = arr_new t_len 0
        let _ = sha_copy_bytes ch_msg t_buf 0 0 ch_msg_len
        let _ = sha_copy_bytes sh_msg t_buf 0 ch_msg_len sh_msg_len
        let hs_hash = sha256_bytes t_buf t_len
        -- Derive ONLY handshake traffic secrets using a dummy sf_hash; the
        -- FSM will re-derive app secrets with the real sf_hash later.
        let sched = tls13_derive_schedule shared 32 hs_hash hs_hash
        let c_hs = arr_get sched 1
        let s_hs = arr_get sched 2
        let s_key = tls13_derive_key s_hs
        let s_iv = tls13_derive_iv s_hs
        let r = arr_new 6 0
        let _ = arr_set r 0 sh_msg
        let _ = arr_set r 1 sh_msg_len
        let _ = arr_set r 2 s_key
        let _ = arr_set r 3 s_iv
        let _ = arr_set r 4 c_hs
        let _ = arr_set r 5 1
        r

hc_xh_fail _ =
  let z = arr_new 0 0
  let r = arr_new 6 0
  let _ = arr_set r 0 z
  let _ = arr_set r 1 0
  let _ = arr_set r 2 z
  let _ = arr_set r 3 z
  let _ = arr_set r 4 z
  let _ = arr_set r 5 0
  r

-- ── Request build + response reader ─────────────────────────────────

hc_crlf _ = join "" [char_from_int 13, char_from_int 10]

hc_build_req host path =
  let eol = hc_crlf 0
  let s = join "" ["GET ", path, " HTTP/1.1", eol,
                   "Host: ", host, eol,
                   "Connection: close", eol,
                   "User-Agent: rail-https/0.1", eol,
                   eol]
  let n = length s
  let arr = string_to_bytes s
  let r = arr_new 2 0
  let _ = arr_set r 0 arr
  let _ = arr_set r 1 n
  r

-- Convert `n` bytes of `arr` to a string in O(n) using a list-build +
-- single join. The old `hc_bytes_to_str_loop` was O(n²) because it
-- re-joined the growing accumulator on every char; each recv_response
-- iteration paid that cost over the running body, which capped
-- practical response bodies at ~64 KB before walltime exploded.

hc_buf_to_chars buf i acc =
  if i < 0 then acc
  else hc_buf_to_chars buf (i - 1) (cons (char_from_int (arr_get buf i)) acc)

hc_bytes_to_str buf n = join "" (hc_buf_to_chars buf (n - 1) [])

-- hc_bytes_to_str_loop retained as an O(n²) shim for any external
-- caller that depends on the old signature.
hc_bytes_to_str_loop arr off n acc =
  if n <= 0 then acc
  else hc_bytes_to_str_loop arr (off + 1) (n - 1) (join "" [acc, char_from_int (arr_get arr off)])

-- Stream-accumulating response reader. Fragments are kept as raw
-- byte-array chunks (each paired with its length) in a cons list; on
-- terminate we allocate one buffer of the exact total size and copy
-- each chunk in place, then convert bytes→string once. Overall work
-- is O(body_len) instead of the old O(body_len²).
hc_recv_response fd key iv seq acc =
  hc_recv_loop fd key iv seq [] 0

hc_recv_loop fd key iv seq chunks total =
  let rec_r = hc_read_record fd
  if arr_get rec_r 2 == 0 then hc_recv_finalize chunks total
  else
    let wire = arr_get rec_r 0
    let wire_len = arr_get rec_r 1
    if arr_get wire 0 != 23 then hc_recv_loop fd key iv seq chunks total
    else
      let dec = tls13_record_decrypt key iv seq wire wire_len
      if arr_get dec 3 == 0 then hc_recv_finalize chunks total
      else
        let frag = arr_get dec 0
        let rtype = arr_get dec 1
        let flen = arr_get dec 2
        if rtype == 21 then hc_recv_finalize chunks total
        else if rtype == 23 then
          let pair = arr_new 2 0
          let _ = arr_set pair 0 frag
          let _ = arr_set pair 1 flen
          hc_recv_loop fd key iv (seq + 1) (cons pair chunks) (total + flen)
        else hc_recv_loop fd key iv (seq + 1) chunks total

hc_recv_finalize chunks total =
  if total <= 0 then ""
  else
    let buf = arr_new total 0
    let _ = hc_copy_chunks buf (reverse chunks) 0
    hc_bytes_to_str buf total

hc_copy_chunks buf chunks write_pos =
  if length chunks == 0 then 0
  else
    let pair = head chunks
    let frag = arr_get pair 0
    let flen = arr_get pair 1
    let _ = sha_copy_bytes frag buf 0 write_pos flen
    hc_copy_chunks buf (tail chunks) (write_pos + flen)

hc_parse_status raw =
  if length raw < 13 then 0
  else
    let sp1 = str_find " " raw
    if sp1 < 0 then 0
    else
      let after1 = str_sub raw (sp1 + 1) (length raw - sp1 - 1)
      let sp2 = str_find " " after1
      if sp2 < 0 then 0
      else hc_parse_int (str_sub after1 0 sp2)

hc_parse_int s = hc_pi (chars s) 0

hc_pi cs acc =
  if length cs == 0 then acc
  else
    let c = head cs
    let d = char_to_int c - 48
    if d < 0 then acc
    else if d > 9 then acc
    else hc_pi (tail cs) (acc * 10 + d)

-- ── Leaf-only (unsafe) drivers ─────────────────────────────────────
-- These run TLS 1.3 and verify the leaf's CertificateVerify signature
-- against its own pubkey, but they DO NOT walk the certificate chain
-- to a trust-store root. Any valid leaf cert with the right SAN
-- passes — including a self-signed cert presented by a local MITM.
--
-- The chain-walking drivers live in stdlib/https_strict.rail and are
-- exported as `https_get` / `https_post` / `https_get_url` /
-- `https_post_url` — that is the default every new caller should use.
--
-- The `_unsafe_noverify` variants below remain for (a) unit tests
-- that exercise the FSM without trust-store setup, and (b) captured-
-- fixture replay where chain-rooted trust isn't relevant. Production
-- code MUST NOT call these.

https_get_unsafe_noverify host ip port path =
  let fd = hc_connect_tcp ip port
  if fd < 0 then hc_err "connect failed"
  else https_get_on_fd fd host path

https_get_on_fd fd host path =
  let kp = hc_gen_keypair 0
  let priv = arr_get kp 0
  let pub = arr_get kp 1
  let random = hc_read_random 32
  let sid = hc_read_random 32
  let ch_rec = tls13_client_hello random sid pub host
  let ch_wire = arr_get ch_rec 0
  let ch_wire_len = arr_get ch_rec 1
  let _ = hc_send_bytes fd ch_wire ch_wire_len
  let ch_msg_len = ch_wire_len - 5
  let ch_msg = arr_new ch_msg_len 0
  let _ = sha_copy_bytes ch_wire ch_msg 5 0 ch_msg_len
  let xh = hc_exchange_hello fd ch_msg ch_msg_len priv
  if arr_get xh 5 == 0 then
    let _ = close fd
    hc_err "ServerHello parse failed"
  else https_get_post_hello fd host path priv ch_msg ch_msg_len xh

https_get_post_hello fd host path priv ch_msg ch_msg_len xh =
  let sh_msg = arr_get xh 0
  let sh_msg_len = arr_get xh 1
  let s_hs_key = arr_get xh 2
  let s_hs_iv = arr_get xh 3
  let c_hs = arr_get xh 4
  let flight = hc_read_server_flight fd s_hs_key s_hs_iv
  let fb = arr_get flight 0
  let fl = arr_get flight 1
  if fl < 0 then
    let _ = close fd
    hc_err "flight decrypt failed"
  else https_get_app_phase fd host path priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl c_hs

https_get_app_phase fd host path priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl c_hs =
  let fsm = tls13_client_handshake_offline priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl 1 host
  if arr_get fsm 4 == 0 then
    let _ = close fd
    hc_err "handshake failed (cert sig or hostname)"
  else
    let c_ap = arr_get fsm 0
    let s_ap = arr_get fsm 1
    let cf_msg = arr_get fsm 2
    let cf_len = arr_get fsm 3
    let c_hs_key = tls13_derive_key c_hs
    let c_hs_iv = tls13_derive_iv c_hs
    let c_ap_key = tls13_derive_key c_ap
    let c_ap_iv = tls13_derive_iv c_ap
    let s_ap_key = tls13_derive_key s_ap
    let s_ap_iv = tls13_derive_iv s_ap
    let cf_rec = tls13_record_encrypt c_hs_key c_hs_iv 0 22 cf_msg cf_len
    let _ = hc_send_bytes fd (arr_get cf_rec 0) (arr_get cf_rec 1)
    let req = hc_build_req host path
    let req_buf = arr_get req 0
    let req_len = arr_get req 1
    let app_rec = tls13_record_encrypt c_ap_key c_ap_iv 0 23 req_buf req_len
    let _ = hc_send_bytes fd (arr_get app_rec 0) (arr_get app_rec 1)
    let body = hc_recv_response fd s_ap_key s_ap_iv 0 ""
    let _ = close fd
    let status = hc_parse_status body
    (status, body)

hc_err msg = (0, msg)

-- ── URL convenience: https_get_url_unsafe_noverify ─────────────────
-- Accepts "https://host[:port][/path]". Resolves host via dns.rail's
-- A-record query, defaults port to 443 and path to "/", then runs
-- https_get_unsafe_noverify with the resolved IP. SAME THREAT MODEL
-- WARNING AS https_get_unsafe_noverify — leaf-only, not chain-rooted.

https_get_url_unsafe_noverify url =
  let parts = https_parse_url url
  if arr_get parts 4 == 0 then (0, "bad URL")
  else https_get_url_dispatch parts

https_get_url_dispatch parts =
  let host = arr_get parts 0
  let port = arr_get parts 1
  let path = arr_get parts 2
  let ip = dns_resolve_a host
  if length ip == 0 then (0, join "" ["DNS resolve failed for ", host])
  else https_get_unsafe_noverify host ip port path

-- Parse "https://host[:port][/path]" → [host, port, path, "", valid].
-- Only supports https scheme; http or anything else returns valid=0.
https_parse_url url =
  if length url < 9 then https_url_fail 0
  else if str_sub url 0 8 != "https://" then https_url_fail 0
  else
    let rest = str_sub url 8 (length url - 8)
    let slash = str_find "/" rest
    let host_port = if slash < 0 then rest else str_sub rest 0 slash
    let path = if slash < 0 then "/" else str_sub rest slash (length rest - slash)
    let colon = str_find ":" host_port
    let host = if colon < 0 then host_port else str_sub host_port 0 colon
    let port =
      if colon < 0 then 443
      else hc_parse_int (str_sub host_port (colon + 1) (length host_port - colon - 1))
    let r = arr_new 5 0
    let _ = arr_set r 0 host
    let _ = arr_set r 1 port
    let _ = arr_set r 2 path
    let _ = arr_set r 3 ""
    let _ = arr_set r 4 1
    r

https_url_fail _ =
  let r = arr_new 5 0
  let _ = arr_set r 0 ""
  let _ = arr_set r 1 0
  let _ = arr_set r 2 ""
  let _ = arr_set r 3 ""
  let _ = arr_set r 4 0
  r

-- ── POST support ────────────────────────────────────────────────────
-- Same FSM as https_get, different request builder. Body is a Rail
-- string; headers are a list of "Name: Value" strings.

hc_build_post host path ctype body hdrs =
  let eol = hc_crlf 0
  let cl = join "" ["Content-Length: ", show (length body), eol]
  let ct = if length ctype == 0 then "" else join "" ["Content-Type: ", ctype, eol]
  let extra = if length hdrs == 0 then "" else join "" [join eol hdrs, eol]
  let s = join "" ["POST ", path, " HTTP/1.1", eol,
                   "Host: ", host, eol,
                   ct, cl, extra,
                   "Connection: close", eol,
                   "User-Agent: rail-https/0.1", eol,
                   eol,
                   body]
  let n = length s
  let arr = string_to_bytes s
  let r = arr_new 2 0
  let _ = arr_set r 0 arr
  let _ = arr_set r 1 n
  r

-- Top-level POST. Leaf-signature-only — same threat model as
-- `https_get_unsafe_noverify`. Prefer `https_post` from
-- stdlib/https_strict.rail for chain-to-root trust walking.
https_post_unsafe_noverify host ip port path ctype body hdrs =
  let fd = hc_connect_tcp ip port
  if fd < 0 then (0, "connect failed")
  else https_post_on_fd fd host path ctype body hdrs

https_post_on_fd fd host path ctype body hdrs =
  let kp = hc_gen_keypair 0
  let priv = arr_get kp 0
  let pub = arr_get kp 1
  let random = hc_read_random 32
  let sid = hc_read_random 32
  let ch_rec = tls13_client_hello random sid pub host
  let ch_wire = arr_get ch_rec 0
  let ch_wire_len = arr_get ch_rec 1
  let _ = hc_send_bytes fd ch_wire ch_wire_len
  let ch_msg_len = ch_wire_len - 5
  let ch_msg = arr_new ch_msg_len 0
  let _ = sha_copy_bytes ch_wire ch_msg 5 0 ch_msg_len
  let xh = hc_exchange_hello fd ch_msg ch_msg_len priv
  if arr_get xh 5 == 0 then
    let _ = close fd
    hc_err "ServerHello parse failed"
  else https_post_post_hello fd host path ctype body hdrs priv ch_msg ch_msg_len xh

https_post_post_hello fd host path ctype body hdrs priv ch_msg ch_msg_len xh =
  let sh_msg = arr_get xh 0
  let sh_msg_len = arr_get xh 1
  let s_hs_key = arr_get xh 2
  let s_hs_iv = arr_get xh 3
  let c_hs = arr_get xh 4
  let flight = hc_read_server_flight fd s_hs_key s_hs_iv
  let fb = arr_get flight 0
  let fl = arr_get flight 1
  if fl < 0 then
    let _ = close fd
    hc_err "flight decrypt failed"
  else https_post_app_phase fd host path ctype body hdrs priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl c_hs

https_post_app_phase fd host path ctype body hdrs priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl c_hs =
  let fsm = tls13_client_handshake_offline priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl 1 host
  if arr_get fsm 4 == 0 then
    let _ = close fd
    hc_err "handshake failed"
  else
    let c_ap = arr_get fsm 0
    let s_ap = arr_get fsm 1
    let cf_msg = arr_get fsm 2
    let cf_len = arr_get fsm 3
    let c_hs_key = tls13_derive_key c_hs
    let c_hs_iv = tls13_derive_iv c_hs
    let c_ap_key = tls13_derive_key c_ap
    let c_ap_iv = tls13_derive_iv c_ap
    let s_ap_key = tls13_derive_key s_ap
    let s_ap_iv = tls13_derive_iv s_ap
    let cf_rec = tls13_record_encrypt c_hs_key c_hs_iv 0 22 cf_msg cf_len
    let _ = hc_send_bytes fd (arr_get cf_rec 0) (arr_get cf_rec 1)
    let req = hc_build_post host path ctype body hdrs
    let req_buf = arr_get req 0
    let req_len = arr_get req 1
    let app_rec = tls13_record_encrypt c_ap_key c_ap_iv 0 23 req_buf req_len
    let _ = hc_send_bytes fd (arr_get app_rec 0) (arr_get app_rec 1)
    let body_resp = hc_recv_response fd s_ap_key s_ap_iv 0 ""
    let _ = close fd
    let status = hc_parse_status body_resp
    (status, body_resp)

-- ── PUT support ─────────────────────────────────────────────────────
-- Same FSM as POST, different verb. Required by Cloudflare KV's
-- replace-by-key endpoint used by tools/attest/publish.rail.

hc_build_put host path ctype body hdrs =
  let eol = hc_crlf 0
  let cl = join "" ["Content-Length: ", show (length body), eol]
  let ct = if length ctype == 0 then "" else join "" ["Content-Type: ", ctype, eol]
  let extra = if length hdrs == 0 then "" else join "" [join eol hdrs, eol]
  let s = join "" ["PUT ", path, " HTTP/1.1", eol,
                   "Host: ", host, eol,
                   ct, cl, extra,
                   "Connection: close", eol,
                   "User-Agent: rail-https/0.1", eol,
                   eol,
                   body]
  let n = length s
  let arr = string_to_bytes s
  let r = arr_new 2 0
  let _ = arr_set r 0 arr
  let _ = arr_set r 1 n
  r

https_put_app_phase fd host path ctype body hdrs priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl c_hs =
  let fsm = tls13_client_handshake_offline priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl 1 host
  if arr_get fsm 4 == 0 then
    let _ = close fd
    hc_err "handshake failed"
  else
    let c_ap = arr_get fsm 0
    let s_ap = arr_get fsm 1
    let cf_msg = arr_get fsm 2
    let cf_len = arr_get fsm 3
    let c_hs_key = tls13_derive_key c_hs
    let c_hs_iv = tls13_derive_iv c_hs
    let c_ap_key = tls13_derive_key c_ap
    let c_ap_iv = tls13_derive_iv c_ap
    let s_ap_key = tls13_derive_key s_ap
    let s_ap_iv = tls13_derive_iv s_ap
    let cf_rec = tls13_record_encrypt c_hs_key c_hs_iv 0 22 cf_msg cf_len
    let _ = hc_send_bytes fd (arr_get cf_rec 0) (arr_get cf_rec 1)
    let req = hc_build_put host path ctype body hdrs
    let req_buf = arr_get req 0
    let req_len = arr_get req 1
    let app_rec = tls13_record_encrypt c_ap_key c_ap_iv 0 23 req_buf req_len
    let _ = hc_send_bytes fd (arr_get app_rec 0) (arr_get app_rec 1)
    let body_resp = hc_recv_response fd s_ap_key s_ap_iv 0 ""
    let _ = close fd
    let status = hc_parse_status body_resp
    (status, body_resp)

-- URL-form POST: https_post_url_unsafe_noverify url content_type body extra_hdrs.
-- Same threat model as https_post_unsafe_noverify — leaf-only.
https_post_url_unsafe_noverify url ctype body hdrs =
  let parts = https_parse_url url
  if arr_get parts 4 == 0 then (0, "bad URL")
  else https_post_url_dispatch parts ctype body hdrs

https_post_url_dispatch parts ctype body hdrs =
  let host = arr_get parts 0
  let port = arr_get parts 1
  let path = arr_get parts 2
  let ip = dns_resolve_a host
  if length ip == 0 then (0, join "" ["DNS resolve failed for ", host])
  else https_post_unsafe_noverify host ip port path ctype body hdrs

-- ─────────────────────────────────────────────────────────────────────
-- ── Streaming download to file  (Path A — no in-memory body) ────────
-- ─────────────────────────────────────────────────────────────────────
--
-- `https_get_to_file_unsafe_noverify host ip port path out_path` performs
-- a TLS 1.3 handshake (leaf-only verification — same threat model as the
-- other `_unsafe_noverify` drivers above) and streams the response body
-- straight to `out_path` via fwrite, hashing the bytes through the
-- streaming sha256 API as they pass through.  No Rail string is built
-- for the body — memory stays bounded by the TLS record size (~16 KB)
-- regardless of the file's size.
--
-- Returns a 4-element Rail array:
--   [status, bytes_written, sha256_hex_string, valid]
-- (Rail's tuples are awkward across modules, so an array is friendlier
--  for the pursue/sync.rail caller.)
--
-- Convenience URL form: `https_get_url_to_file_unsafe_noverify url out`.
--
-- HTTP semantics handled:
--   * Status code parsed from the first response line
--   * `Connection: close` framing (default)
--   * `Transfer-Encoding: chunked` decoded chunk-by-chunk on the way
--     to disk
--   * 200/206 are written; non-2xx status still streams the body so the
--     caller can inspect it (e.g. an error page) — but the typical
--     pursue use case checks status before keeping the file.

hc_stream_fail _ =
  let r = arr_new 4 0
  let _ = arr_set r 0 0
  let _ = arr_set r 1 0
  let _ = arr_set r 2 ""
  let _ = arr_set r 3 0
  r

-- Copy n bytes of Rail int-array `arr` starting at `arr_off` into the
-- C-buffer `p` starting at offset 0.  Used for fwrite calls in the
-- streaming body emitter.
hc_arr_off_to_cbuf arr arr_off p n =
  hc_aoc_loop arr arr_off p 0 n

hc_aoc_loop arr arr_off p p_off n =
  if n <= 0 then 0
  else
    let _ = byte_set p p_off (arr_get arr arr_off)
    hc_aoc_loop arr (arr_off + 1) p (p_off + 1) (n - 1)

-- Scan `buf[start..n)` for the byte sequence 13 10 13 10 (\r\n\r\n).
-- Returns the index of the first byte AFTER the sequence, or -1.
hc_scan_blank_line buf start n =
  if start + 4 > n then 0 - 1
  else
    let b0 = arr_get buf start
    if b0 != 13 then hc_scan_blank_line buf (start + 1) n
    else
      let b1 = arr_get buf (start + 1)
      let b2 = arr_get buf (start + 2)
      let b3 = arr_get buf (start + 3)
      if b1 == 10 then
        if b2 == 13 then
          if b3 == 10 then start + 4
          else hc_scan_blank_line buf (start + 1) n
        else hc_scan_blank_line buf (start + 1) n
      else hc_scan_blank_line buf (start + 1) n

-- Convert N bytes of a Rail int-array (only used on small header
-- buffers, capped at 64 KB) into a Rail string for header parsing.
hc_arr_to_str arr n = join "" (hc_buf_to_chars arr (n - 1) [])

-- Parse a hex-digit-only string into an integer.  Tolerant: stops at
-- the first non-hex char.  Used for chunked-transfer chunk-length lines.
hc_parse_hex_str s = hc_phs_loop (chars s) 0

hc_phs_loop cs acc =
  if length cs == 0 then acc
  else
    let c = head cs
    let n = char_to_int c
    if n >= 48 then
      if n <= 57 then hc_phs_loop (tail cs) (acc * 16 + (n - 48))
      else if n >= 97 then
        if n <= 102 then hc_phs_loop (tail cs) (acc * 16 + (n - 87))
        else acc
      else if n >= 65 then
        if n <= 70 then hc_phs_loop (tail cs) (acc * 16 + (n - 55))
        else acc
      else acc
    else acc

-- Detect Transfer-Encoding: chunked in a header string (case-insensitive
-- on the value).
hc_is_chunked_resp raw =
  let i = str_find "Transfer-Encoding: chunked" raw
  if i >= 0 then 1
  else
    let j = str_find "transfer-encoding: chunked" raw
    if j >= 0 then 1 else 0

-- ── Header phase: read TLS records until we have the full HTTP header.
-- Returns a 5-element array on success:
--   [header_str, next_seq, body_initial_arr, body_initial_len, valid]
-- On failure: valid=0.
hc_read_response_headers fd key iv =
  let buf = arr_new 65536 0
  hc_rrh_loop fd key iv 0 buf 0

hc_rrh_loop fd key iv seq buf buf_len =
  if buf_len > 65000 then hc_rrh_fail 0
  else
    let rec_r = hc_read_record fd
    if arr_get rec_r 2 == 0 then hc_rrh_fail 0
    else
      let wire = arr_get rec_r 0
      let wire_len = arr_get rec_r 1
      if arr_get wire 0 != 23 then hc_rrh_loop fd key iv seq buf buf_len
      else
        let dec = tls13_record_decrypt key iv seq wire wire_len
        if arr_get dec 3 == 0 then hc_rrh_fail 0
        else
          let frag = arr_get dec 0
          let rtype = arr_get dec 1
          let flen = arr_get dec 2
          if rtype == 21 then hc_rrh_fail 0
          else if rtype != 23 then hc_rrh_loop fd key iv (seq + 1) buf buf_len
          else
            let new_len = buf_len + flen
            if new_len > 65536 then hc_rrh_fail 0
            else
              let _ = sha_copy_bytes frag buf 0 buf_len flen
              let scan_from = if buf_len < 3 then 0 else buf_len - 3
              let body_off = hc_scan_blank_line buf scan_from new_len
              if body_off < 0 then hc_rrh_loop fd key iv (seq + 1) buf new_len
              else
                let header_str = hc_arr_to_str buf body_off
                let body_init_len = new_len - body_off
                let body_init_arr = arr_new body_init_len 0
                let _ = sha_copy_bytes buf body_init_arr body_off 0 body_init_len
                let r = arr_new 5 0
                let _ = arr_set r 0 header_str
                let _ = arr_set r 1 (seq + 1)
                let _ = arr_set r 2 body_init_arr
                let _ = arr_set r 3 body_init_len
                let _ = arr_set r 4 1
                r

hc_rrh_fail _ =
  let z = arr_new 0 0
  let r = arr_new 5 0
  let _ = arr_set r 0 ""
  let _ = arr_set r 1 0
  let _ = arr_set r 2 z
  let _ = arr_set r 3 0
  let _ = arr_set r 4 0
  r

-- ── Body phase: emit bytes through the chunked decoder if needed,
-- otherwise straight to disk + hash.
--
-- body_state layout (Rail array, mutated in place):
--   [0] chunked       0 = raw, 1 = chunked
--   [1] chunk_state   0 = READ_LEN, 1 = READ_BODY, 2 = READ_TRAILER, 3 = DONE
--   [2] chunk_remain  bytes left in current data chunk
--   [3] len_acc       string accumulator for hex chunk-length digits
--   [4] bytes_written total body bytes written to file
--   [5] trailer_stage 0 = expect \r, 1 = expect \n
--   [6] sha_st        streaming sha256 state
--   [7] fp            FILE* (raw int)
--   [8] cbuf          C buffer for fwrite (sized to TLS record max)
--   [9] cbuf_size     allocated cbuf size

hc_body_state_init sha_st fp cbuf cbuf_size chunked =
  let st = arr_new 10 0
  let _ = arr_set st 0 chunked
  let _ = arr_set st 1 0
  let _ = arr_set st 2 0
  let _ = arr_set st 3 ""
  let _ = arr_set st 4 0
  let _ = arr_set st 5 0
  let _ = arr_set st 6 sha_st
  let _ = arr_set st 7 fp
  let _ = arr_set st 8 cbuf
  let _ = arr_set st 9 cbuf_size
  st

-- Bulk-write `n` bytes from `frag[off..off+n)` to disk + sha update.
hc_emit_raw_bulk frag off n body_state =
  if n <= 0 then 0
  else
    let cbuf = arr_get body_state 8
    let fp = arr_get body_state 7
    let sha_st = arr_get body_state 6
    let _ = hc_arr_off_to_cbuf frag off cbuf n
    let _ = fwrite cbuf 1 n fp
    let _ = sha256_update_arr sha_st frag off n
    let bw = arr_get body_state 4
    let _ = arr_set body_state 4 (bw + n)
    0

-- Top-level chunk emitter — dispatches on chunked flag.
hc_emit_body frag off n body_state =
  if n <= 0 then 0
  else
    let chunked = arr_get body_state 0
    if chunked == 0 then
      let _ = hc_emit_raw_bulk frag off n body_state
      0
    else hc_emit_chunked_dispatch frag off n body_state

hc_emit_chunked_dispatch frag off n body_state =
  if n <= 0 then 0
  else
    let cs = arr_get body_state 1
    if cs == 3 then 0
    else if cs == 0 then hc_chunk_read_len frag off n body_state
    else if cs == 1 then hc_chunk_read_body frag off n body_state
    else hc_chunk_read_trailer frag off n body_state

hc_chunk_read_len frag off n body_state =
  if n <= 0 then 0
  else
    let b = arr_get frag off
    if b == 13 then
      hc_chunk_read_len frag (off + 1) (n - 1) body_state
    else if b == 10 then
      let acc = arr_get body_state 3
      let semi = str_find ";" acc
      let clean = if semi < 0 then acc else str_sub acc 0 semi
      let chunk_len = hc_parse_hex_str clean
      let _ = arr_set body_state 3 ""
      let _ = arr_set body_state 2 chunk_len
      if chunk_len == 0 then
        let _ = arr_set body_state 1 3
        0
      else
        let _ = arr_set body_state 1 1
        hc_emit_chunked_dispatch frag (off + 1) (n - 1) body_state
    else
      let acc = arr_get body_state 3
      let new_acc = join "" [acc, char_from_int b]
      let _ = arr_set body_state 3 new_acc
      hc_chunk_read_len frag (off + 1) (n - 1) body_state

hc_chunk_read_body frag off n body_state =
  let remaining = arr_get body_state 2
  let take = if remaining < n then remaining else n
  let _ = hc_emit_raw_bulk frag off take body_state
  let new_remaining = remaining - take
  let _ = arr_set body_state 2 new_remaining
  if new_remaining == 0 then
    let _ = arr_set body_state 1 2
    let _ = arr_set body_state 5 0
    hc_emit_chunked_dispatch frag (off + take) (n - take) body_state
  else 0

hc_chunk_read_trailer frag off n body_state =
  if n <= 0 then 0
  else
    let stage = arr_get body_state 5
    let b = arr_get frag off
    if stage == 0 then
      if b == 13 then
        let _ = arr_set body_state 5 1
        hc_chunk_read_trailer frag (off + 1) (n - 1) body_state
      else if b == 10 then
        let _ = arr_set body_state 1 0
        hc_emit_chunked_dispatch frag (off + 1) (n - 1) body_state
      else hc_chunk_read_trailer frag (off + 1) (n - 1) body_state
    else
      if b == 10 then
        let _ = arr_set body_state 5 0
        let _ = arr_set body_state 1 0
        hc_emit_chunked_dispatch frag (off + 1) (n - 1) body_state
      else hc_chunk_read_trailer frag (off + 1) (n - 1) body_state

-- Body recv loop: reads TLS records, decrypts, feeds into emitter.
hc_stream_body_loop fd key iv seq body_state =
  let cs_done = arr_get body_state 1
  if cs_done == 3 then 0
  else
    let mk = arena_mark 0
    let rec_r = hc_read_record fd
    if arr_get rec_r 2 == 0 then
      let _ = arena_reset mk
      0
    else
      let wire = arr_get rec_r 0
      let wire_len = arr_get rec_r 1
      if arr_get wire 0 != 23 then
        let _ = arena_reset mk
        hc_stream_body_loop fd key iv seq body_state
      else
        let dec = tls13_record_decrypt key iv seq wire wire_len
        if arr_get dec 3 == 0 then
          let _ = arena_reset mk
          0
        else
          let frag = arr_get dec 0
          let rtype = arr_get dec 1
          let flen = arr_get dec 2
          if rtype == 21 then
            let _ = arena_reset mk
            0
          else if rtype != 23 then
            let _ = arena_reset mk
            hc_stream_body_loop fd key iv (seq + 1) body_state
          else
            let _ = hc_emit_body frag 0 flen body_state
            let _ = arena_reset mk
            hc_stream_body_loop fd key iv (seq + 1) body_state

-- ── Top-level streaming GET ─────────────────────────────────────────

https_get_to_file_unsafe_noverify host ip port path out_path =
  let fd = hc_connect_tcp ip port
  if fd < 0 then hc_stream_fail 0
  else hc_stream_on_fd fd host path out_path

hc_stream_on_fd fd host path out_path =
  let kp = hc_gen_keypair 0
  let priv = arr_get kp 0
  let pub = arr_get kp 1
  let random = hc_read_random 32
  let sid = hc_read_random 32
  let ch_rec = tls13_client_hello random sid pub host
  let ch_wire = arr_get ch_rec 0
  let ch_wire_len = arr_get ch_rec 1
  let _ = hc_send_bytes fd ch_wire ch_wire_len
  let ch_msg_len = ch_wire_len - 5
  let ch_msg = arr_new ch_msg_len 0
  let _ = sha_copy_bytes ch_wire ch_msg 5 0 ch_msg_len
  let xh = hc_exchange_hello fd ch_msg ch_msg_len priv
  if arr_get xh 5 == 0 then
    let _ = close fd
    hc_stream_fail 0
  else hc_stream_post_hello fd host path priv ch_msg ch_msg_len xh out_path

hc_stream_post_hello fd host path priv ch_msg ch_msg_len xh out_path =
  let sh_msg = arr_get xh 0
  let sh_msg_len = arr_get xh 1
  let s_hs_key = arr_get xh 2
  let s_hs_iv = arr_get xh 3
  let c_hs = arr_get xh 4
  let flight = hc_read_server_flight fd s_hs_key s_hs_iv
  let fb = arr_get flight 0
  let fl = arr_get flight 1
  if fl < 0 then
    let _ = close fd
    hc_stream_fail 0
  else hc_stream_app_phase fd host path priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl c_hs out_path

hc_stream_app_phase fd host path priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl c_hs out_path =
  let fsm = tls13_client_handshake_offline priv ch_msg ch_msg_len sh_msg sh_msg_len fb fl 1 host
  if arr_get fsm 4 == 0 then
    let _ = close fd
    hc_stream_fail 0
  else
    let c_ap = arr_get fsm 0
    let s_ap = arr_get fsm 1
    let cf_msg = arr_get fsm 2
    let cf_len = arr_get fsm 3
    let c_hs_key = tls13_derive_key c_hs
    let c_hs_iv = tls13_derive_iv c_hs
    let c_ap_key = tls13_derive_key c_ap
    let c_ap_iv = tls13_derive_iv c_ap
    let s_ap_key = tls13_derive_key s_ap
    let s_ap_iv = tls13_derive_iv s_ap
    let cf_rec = tls13_record_encrypt c_hs_key c_hs_iv 0 22 cf_msg cf_len
    let _ = hc_send_bytes fd (arr_get cf_rec 0) (arr_get cf_rec 1)
    let req = hc_build_req host path
    let req_buf = arr_get req 0
    let req_len = arr_get req 1
    let app_rec = tls13_record_encrypt c_ap_key c_ap_iv 0 23 req_buf req_len
    let _ = hc_send_bytes fd (arr_get app_rec 0) (arr_get app_rec 1)
    hc_stream_recv fd s_ap_key s_ap_iv out_path

hc_stream_recv fd key iv out_path =
  let hdr = hc_read_response_headers fd key iv
  if arr_get hdr 4 == 0 then
    let _ = close fd
    hc_stream_fail 0
  else
    let header_str = arr_get hdr 0
    let next_seq = arr_get hdr 1
    let body_init = arr_get hdr 2
    let body_init_len = arr_get hdr 3
    let status = hc_parse_status header_str
    let chunked = hc_is_chunked_resp header_str
    let fp = fopen out_path "w"
    if fp == 0 then
      let _ = close fd
      hc_stream_fail 0
    else
      let cbuf_size = 16640
      let cbuf = malloc cbuf_size
      let sha_st = sha256_init 0
      let body_state = hc_body_state_init sha_st fp cbuf cbuf_size chunked
      let _ = hc_emit_body body_init 0 body_init_len body_state
      let _ = hc_stream_body_loop fd key iv next_seq body_state
      let _ = close fd
      let _ = fclose fp
      let _ = free cbuf
      let bw = arr_get body_state 4
      let digest_hex = sha256_finalize_hex sha_st
      let r = arr_new 4 0
      let _ = arr_set r 0 status
      let _ = arr_set r 1 bw
      let _ = arr_set r 2 digest_hex
      let _ = arr_set r 3 1
      r

-- URL convenience wrapper.
https_get_url_to_file_unsafe_noverify url out_path =
  let parts = https_parse_url url
  if arr_get parts 4 == 0 then hc_stream_fail 0
  else
    let host = arr_get parts 0
    let port = arr_get parts 1
    let path = arr_get parts 2
    let ip = dns_resolve_a host
    if length ip == 0 then hc_stream_fail 0
    else https_get_to_file_unsafe_noverify host ip port path out_path
