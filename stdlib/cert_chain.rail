-- stdlib/cert_chain.rail — Layer 9c full cert chain walker.
--
-- Verifies every adjacent edge in a TLS 1.3 cert_list (leaf →
-- intermediates), terminating at the first cert whose SPKI hash
-- matches a trusted root in the store — or falling back to an
-- issuer-name match against the store. The SPKI check is what makes
-- cross-signed roots (GTS R4 presented with GlobalSign as its issuer
-- while a self-signed GTS R4 is what the OS trusts) work without
-- chasing issuer names past the actual trust anchor.
--
-- Caller must have stdlib/tls13_client.rail + stdlib/pem.rail loaded.
-- (tls13_client transitively brings in asn1 + ecdsa_p256 + rsa_pss +
-- tls13_cert_verify, which is where cv_verify_cert_by lives.)
--
-- Public API:
--   cc_walk_chain store certs lens count -> 1/0

cc_walk_chain store certs lens count =
  if count <= 0 then 0
  else cc_walk_at store certs lens count 0

cc_walk_at store certs lens count i =
  if i >= count then 0
  else
    let cur = arr_get certs i
    let cur_len = arr_get lens i
    -- Step 1: SPKI-keyed termination. Hash the current cert's SPKI
    -- and check it against the store's pre-computed root hashes.
    -- A match means this cert *is* a trusted root (regardless of
    -- what its own issuer field claims), so every edge we've
    -- already verified below us chains up to trust.
    let spki = asn1_find_spki cur cur_len
    if arr_get spki 2 == 1 then cc_check_spki store certs lens count i cur cur_len spki
    else cc_check_issuer store certs lens count i cur cur_len

cc_check_spki store certs lens count i cur cur_len spki =
  let spki_off = arr_get spki 0
  let spki_len = arr_get spki 1
  let buf = arr_new spki_len 0
  let _ = sha_copy_bytes cur buf spki_off 0 spki_len
  let h = sha256_bytes buf spki_len
  if ts_has_spki_hash store h == 1 then 1
  else cc_check_issuer store certs lens count i cur cur_len

-- Step 2: issuer-name match against the trust store. If this cert's
-- Issuer equals a store root's Subject, verify this cert against
-- that root — covers the common case where the server's chain does
-- not include the root itself (e.g. slack.com's 2-cert chain
-- terminates at ISRG Root X1 in the store).
cc_check_issuer store certs lens count i cur cur_len =
  let iss = asn1_find_issuer cur cur_len
  if arr_get iss 2 == 0 then 0
  else
    let iss_off = arr_get iss 0
    let iss_len = arr_get iss 1
    let ridx = ts_find_by_subject store cur iss_off iss_len
    if ridx >= 0 then cc_verify_against_root store cur cur_len ridx
    else cc_try_inter store certs lens count i cur cur_len

cc_verify_against_root store cur cur_len ridx =
  let store_certs = arr_get store 0
  let store_lens = arr_get store 1
  let root = arr_get store_certs ridx
  let root_len = arr_get store_lens ridx
  cv_verify_cert_by cur cur_len root root_len

-- Step 3: neither SPKI match nor issuer match — try the next cert in
-- the server-supplied chain.
cc_try_inter store certs lens count i cur cur_len =
  if i + 1 >= count then 0
  else
    let upper = arr_get certs (i + 1)
    let upper_len = arr_get lens (i + 1)
    if cv_verify_cert_by cur cur_len upper upper_len == 0 then 0
    else cc_walk_at store certs lens count (i + 1)
