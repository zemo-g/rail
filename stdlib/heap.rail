-- stdlib/heap.rail -- array-backed binary MIN-heap of ints.
--
-- A heap is a single mutable int array (arr_new). Slot 0 holds the current
-- size; the elements live in slots 1..capacity, so the standard 1-indexed
-- child/parent arithmetic applies:
--   parent(i) = i / 2 , left(i) = 2*i , right(i) = 2*i + 1
-- The smallest element is always at slot 1.
--
-- The heap mutates in place; heap_push / heap_pop return the same handle so
-- they read fluently (and can be chained), but the underlying array is shared.
--
-- Public API:
--   heap_new cap            -> empty heap with room for `cap` ints
--   heap_size h             -> current element count
--   heap_peek h             -> minimum element (0 if empty)
--   heap_push h v           -> insert v, returns h
--   heap_pop h              -> remove+return the min (0 if empty); h shrinks
--   heapify_from_list xs    -> build a heap containing every int in xs
--
-- Sift loops change only the index argument (a single-arg loop), computing the
-- parent/child indices in let-bindings, so they sidestep the self-loop
-- divide/multiply miscompile that bites tail loops where two args change.
--
-- NOTE: helper names are NOT underscore-prefixed. Leading-underscore names are
-- treated as module-private by `import` and dropped from the splice, which
-- would leave the public functions calling undefined symbols at link time.

-- ---- internal helpers ------------------------------------------------------

-- swap slots i and j of the backing array.
heap_swap a i j =
  let ti = arr_get a i
  let tj = arr_get a j
  let _ = arr_set a i tj
  let _ = arr_set a j ti
  0

-- sift-up: bubble the value at slot i toward the root while it is smaller than
-- its parent. Single-arg loop on i; parent index is a let-binding.
heap_sift_up a i =
  if i <= 1 then 0
  else
    let p = i / 2
    if (arr_get a i) >= (arr_get a p) then 0
    else
      let _ = heap_swap a i p
      heap_sift_up a p

-- pick the smaller of node i and its two children (returns the index to swap
-- with, or i itself when i is already <= both children / has no children).
heap_smaller_child a n i =
  let l = i + i
  let r = l + 1
  let sm1 = if l <= n then (if (arr_get a l) < (arr_get a i) then l else i) else i
  if r <= n then (if (arr_get a r) < (arr_get a sm1) then r else sm1) else sm1

-- sift-down: push the value at slot i toward the leaves while a child is
-- smaller. Single-arg loop on i; child indices live inside heap_smaller_child.
heap_sift_down a n i =
  let m = heap_smaller_child a n i
  if m == i then 0
  else
    let _ = heap_swap a i m
    heap_sift_down a n m

-- ---- public API ------------------------------------------------------------

-- heap_new cap : empty min-heap with capacity for `cap` ints. Slot 0 = size.
heap_new cap = arr_new (cap + 1) 0

-- heap_size h : number of elements currently in the heap.
heap_size h = arr_get h 0

-- heap_peek h : the minimum element, or 0 when the heap is empty.
heap_peek h =
  if (arr_get h 0) == 0 then 0
  else arr_get h 1

-- heap_push h v : insert v and restore the heap property. Returns h.
heap_push h v =
  let n = (arr_get h 0) + 1
  let _ = arr_set h n v
  let _ = arr_set h 0 n
  let _ = heap_sift_up h n
  h

-- heap_pop h : remove and return the minimum. Returns 0 if empty. The last
-- element is moved to the root and sifted down to restore the invariant.
heap_pop h =
  let n = arr_get h 0
  if n == 0 then 0
  else
    let top = arr_get h 1
    let last = arr_get h n
    let _ = arr_set h 1 last
    let _ = arr_set h 0 (n - 1)
    let _ = if (n - 1) > 0 then heap_sift_down h (n - 1) 1 else 0
    top

-- heapify_from_list xs : build a heap holding every int in xs (insert each).
heapify_go h xs =
  if xs == [] then h
  else
    let _ = heap_push h (head xs)
    heapify_go h (tail xs)

heapify_from_list xs = heapify_go (heap_new (length xs)) xs
