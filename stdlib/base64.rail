-- stdlib/base64.rail — Pure Rail Base64 encode/decode
-- Import: import "stdlib/base64.rail"

-- Base64 alphabet
b64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

-- Get character at index from b64 alphabet
b64_char_at idx = head (drop_str idx (chars b64_chars))

drop_str n cs =
  if n <= 0 then cs
  else if length cs == 0 then []
  else drop_str (n - 1) (tail cs)

-- Find index of char in b64 alphabet (returns -1 if not found)
b64_index c = b64_index_acc c (chars b64_chars) 0

b64_index_acc c cs idx =
  if length cs == 0 then 0 - 1
  else if head cs == c then idx
  else b64_index_acc c (tail cs) (idx + 1)

-- Encode a string to base64
-- Works on byte values (ASCII only)
base64_encode str =
  let bytes = map char_code (chars str)
  b64_enc bytes ""

-- Encode bytes (list of ints) to base64 string
b64_enc bytes acc =
  if length bytes == 0 then acc
  else if length bytes == 1 then
    let b0 = head bytes
    let c0 = b64_char_at (b0 / 4)
    let c1 = b64_char_at ((b0 % 4) * 16)
    cat [acc, c0, c1, "=="]
  else if length bytes == 2 then
    let b0 = head bytes
    let b1 = head (tail bytes)
    let c0 = b64_char_at (b0 / 4)
    let c1 = b64_char_at (((b0 % 4) * 16) + (b1 / 16))
    let c2 = b64_char_at ((b1 % 16) * 4)
    cat [acc, c0, c1, c2, "="]
  else
    let b0 = head bytes
    let b1 = head (tail bytes)
    let b2 = head (tail (tail bytes))
    let c0 = b64_char_at (b0 / 4)
    let c1 = b64_char_at (((b0 % 4) * 16) + (b1 / 16))
    let c2 = b64_char_at (((b1 % 16) * 4) + (b2 / 64))
    let c3 = b64_char_at (b2 % 64)
    b64_enc (tail (tail (tail bytes))) (cat [acc, c0, c1, c2, c3])

-- Decode base64 string back to string
base64_decode str =
  let cs = filter (\c -> c != "=" && c != "\n" && c != "\r") (chars str)
  let indices = map b64_index cs
  b64_dec indices ""

b64_dec indices acc =
  if length indices < 2 then acc
  else if length indices == 2 then
    let i0 = head indices
    let i1 = head (tail indices)
    let b0 = (i0 * 4) + (i1 / 16)
    append acc (from_char_code b0)
  else if length indices == 3 then
    let i0 = head indices
    let i1 = head (tail indices)
    let i2 = head (tail (tail indices))
    let b0 = (i0 * 4) + (i1 / 16)
    let b1 = ((i1 % 16) * 16) + (i2 / 4)
    cat [acc, from_char_code b0, from_char_code b1]
  else
    let i0 = head indices
    let i1 = head (tail indices)
    let i2 = head (tail (tail indices))
    let i3 = head (tail (tail (tail indices)))
    let b0 = (i0 * 4) + (i1 / 16)
    let b1 = ((i1 % 16) * 16) + (i2 / 4)
    let b2 = ((i2 % 4) * 64) + i3
    b64_dec (tail (tail (tail (tail indices)))) (cat [acc, from_char_code b0, from_char_code b1, from_char_code b2])

-- char_code / from_char_code: use the runtime primitives directly.
-- The previous version shelled out via `printf '%d'` per character,
-- which made any base64 op O(N) forks (a 64-byte sig = 64 forks).
char_code c = char_to_int c
from_char_code n = char_from_int n

-- ── Byte-array decode (fast path for crypto callers) ──────────────────
-- Returns an int array (length = decoded byte count) instead of a
-- string.  Use when you need the raw bytes -- e.g. an Ed25519 sig --
-- and don't want to round-trip through string_to_bytes.

b64_idx_of_byte c =
  let n = char_to_int c
  if n >= 65 then if n <= 90 then n - 65 else b64_idx_of_byte_lo n
  else b64_idx_of_byte_lo n

b64_idx_of_byte_lo n =
  if n >= 97 then if n <= 122 then n - 71 else b64_idx_of_byte_dig n
  else b64_idx_of_byte_dig n

b64_idx_of_byte_dig n =
  if n >= 48 then if n <= 57 then n + 4 else b64_idx_of_byte_sym n
  else b64_idx_of_byte_sym n

b64_idx_of_byte_sym n =
  if n == 43 then 62           -- '+'
  else if n == 47 then 63      -- '/'
  else 0 - 1

b64_filter_bytes cs acc =
  if length cs == 0 then reverse acc
  else
    let c = head cs
    if b64_idx_of_byte c >= 0 then b64_filter_bytes (tail cs) (cons c acc)
    else b64_filter_bytes (tail cs) acc

b64_decoded_byte_len n =
  let full = n / 4
  let rem = n - (full * 4)
  if rem == 3 then full * 3 + 2
  else if rem == 2 then full * 3 + 1
  else full * 3

b64_dec_full_bytes cs out off =
  let c0 = head cs
  let c1 = head (tail cs)
  let c2 = head (tail (tail cs))
  let c3 = head (tail (tail (tail cs)))
  let i0 = b64_idx_of_byte c0
  let i1 = b64_idx_of_byte c1
  let i2 = b64_idx_of_byte c2
  let i3 = b64_idx_of_byte c3
  let _ = arr_set out off       (bit_or (bit_and (i0 * 4) 255) (bit_and (i1 / 16) 3))
  let _ = arr_set out (off + 1) (bit_or (bit_and (i1 * 16) 255) (bit_and (i2 / 4) 15))
  let _ = arr_set out (off + 2) (bit_or (bit_and (i2 * 64) 255) (bit_and i3 63))
  b64_dec_loop_bytes (drop_str 4 cs) out (off + 3)

b64_dec_tail3_bytes cs out off =
  let c0 = head cs
  let c1 = head (tail cs)
  let c2 = head (tail (tail cs))
  let i0 = b64_idx_of_byte c0
  let i1 = b64_idx_of_byte c1
  let i2 = b64_idx_of_byte c2
  let _ = arr_set out off       (bit_or (bit_and (i0 * 4) 255) (bit_and (i1 / 16) 3))
  let _ = arr_set out (off + 1) (bit_or (bit_and (i1 * 16) 255) (bit_and (i2 / 4) 15))
  off + 2

b64_dec_tail2_bytes cs out off =
  let c0 = head cs
  let c1 = head (tail cs)
  let i0 = b64_idx_of_byte c0
  let i1 = b64_idx_of_byte c1
  let _ = arr_set out off (bit_or (bit_and (i0 * 4) 255) (bit_and (i1 / 16) 3))
  off + 1

b64_dec_loop_bytes cs out off =
  if length cs == 0 then off
  else if length cs >= 4 then b64_dec_full_bytes cs out off
  else if length cs == 3 then b64_dec_tail3_bytes cs out off
  else if length cs == 2 then b64_dec_tail2_bytes cs out off
  else off

base64_decode_bytes s =
  let raw = b64_filter_bytes (chars s) []
  let n = length raw
  let out = arr_new (b64_decoded_byte_len n) 0
  let _ = b64_dec_loop_bytes raw out 0
  out
