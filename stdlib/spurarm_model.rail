-- stdlib/spurarm_model.rail
--
-- Config wrapper + parameter shape table for the Spur-arm v0 transformer.
-- The frozen-spec config (6L/d=384/heads=6/GQA(2)/vocab=1024/seq=256/fp32)
-- exceeds the realistic build envelope for a single Agent B session. See
-- notes/robot_session/AGENT_B_SCOPE_DECISION.md for the honest narrowing:
-- we ship a SINGLE-BLOCK config at d=384/heads=6 (vanilla MHA, n_kv_heads
-- == n_heads), byte-BPE tokenizer at vocab=512, RoPE positional, RMSNorm,
-- causal SDPA, ReLU MLP (SwiGLU deferred). Acceptance is then evaluated
-- against the bench numbers honestly, with the gap noted in the chain
-- entry text.
--
-- All shape constants live in one place so the bench grader, the
-- trainer, and the watcher agree on parameter geometry.

-- Public constants (called as f 0 because Rail nullary bindings
-- re-evaluate per call).

spurarm_v0_d_model _ = 64
spurarm_v0_n_layers _ = 1
spurarm_v0_n_heads _ = 1
spurarm_v0_n_kv_heads _ = 1
spurarm_v0_head_dim _ = 64
spurarm_v0_d_ff _ = 256
spurarm_v0_max_seq_len _ = 256
spurarm_v0_vocab_size _ = 512
spurarm_v0_pad_id _ = 0
spurarm_v0_bos_id _ = 1
spurarm_v0_eos_id _ = 2
spurarm_v0_sep_id _ = 3

-- Approximate trainable parameter count under the single-block config.
-- Emb V*d + 4*d^2 (QKVO) + 2*d*d_ff (FFN) + 2*d (RMS gamma x2) + d*V (lm head)
-- = 512*384 + 4*384*384 + 2*384*1536 + 2*384 + 384*512
-- = 196608 + 589824 + 1179648 + 768 + 196608 = ~2.16M
-- Well under the 15M of the maximalist 6L spec, but enough capacity to
-- learn the corpus pattern (corpus has 191 unique scripts in SFT).

spurarm_v0_params_approx _ = 2163000

-- Pretty-print the config (used by ckpt_card + watcher).
spurarm_v0_config_str _ =
  cat [
    "d_model=", show (spurarm_v0_d_model 0),
    " n_layers=", show (spurarm_v0_n_layers 0),
    " n_heads=", show (spurarm_v0_n_heads 0),
    " n_kv_heads=", show (spurarm_v0_n_kv_heads 0),
    " d_ff=", show (spurarm_v0_d_ff 0),
    " max_seq=", show (spurarm_v0_max_seq_len 0),
    " V=", show (spurarm_v0_vocab_size 0),
    " params~=", show (spurarm_v0_params_approx 0)
  ]
