-- stdlib/ijit.rail — in-process integer-exact JIT dispatch (Phase 0,
-- 2026-07-04).  The engine that turns the per-op text-file twin proofs
-- (tools/metal/ikernel_harness.m + attested_*_demo.rail) into a real
-- attested training loop: emit MSL -> compile once -> dispatch in-process
-- (ms, not a subprocess+Metal-init+text-I/O per op).
--
-- Bit-exactness is unchanged from the harness: the GPU runs the SAME F=24
-- shaped kernels (stdlib/jit_emit.rail), reads int64 buffers, and the
-- dylib untags/re-tags Rail arr_new elements so results land directly in
-- a Rail integer array.  GPU==CPU twins still agree bit-for-bit; the only
-- thing that changed is that dispatch no longer shells out.
--
-- Use:
--   import "stdlib/ijit.rail"
--   let kid = ijit_compile (emit_msl_fx_matmul24_shaped rows k)
--   let o   = arr_new nout 0
--   let _   = ijit_run kid a b o sizeA sizeB nout nthreads
--   -- o now holds the GPU result, tagged, ready for arr_get / chaining.

import "stdlib/jit_emit.rail"

-- Integer-kernel compile.  Mirrors ikernel_harness (options:nil) so 64-bit
-- `long` device buffers compile; reads /tmp/rail_ijit_kernel.metal.
foreign tgl_ijit_compile dummy -> int

-- Integer dispatch.  a/b/o are arr_new integer arrays; sizeA/sizeB are the
-- element counts to upload from a/b; sizeO the outputs to read back into o;
-- nthreads the 1D grid size (one thread per output-group).  Returns 1 ok.
foreign tgl_ijit_dispatch kid a b o sizeA sizeB sizeO nthreads -> int

-- Compile MSL source -> pipeline id.  Writes the int JIT tmp file the
-- dylib reads, then JIT-compiles.
ijit_compile msl =
  let _ = write_file "/tmp/rail_ijit_kernel.metal" msl
  tgl_ijit_compile 0

-- Dispatch a shaped kernel.  Thin pass-through; kept so callers read as
-- ijit_run (mirrors jit_run_*), and so a future arg-packing change stays
-- local to this module.
ijit_run kid a b o sizeA sizeB sizeO nthreads =
  tgl_ijit_dispatch kid a b o sizeA sizeB sizeO nthreads

-- Persistent GPU buffers (act 23).  Upload a Rail integer array ONCE to a
-- resident GPU buffer (returns a handle); dispatch a *_wx kernel with that
-- weight bound at buffer(0) and only X uploaded per call.  Kills the
-- per-dispatch weight re-pack/re-upload.
foreign tgl_ibuf_upload arr n -> int
foreign tgl_ibuf_update wid arr n -> int
foreign tgl_ijit_dispatch_wx kid wid x o sizeX sizeO nthreads -> int
ibuf_upload arr n = tgl_ibuf_upload arr n
-- overwrite a resident weight buffer IN PLACE (training loop: no leak). returns 0 ok.
ibuf_update wid arr n = tgl_ibuf_update wid arr n
ijit_run_wx kid wid x o sizeX sizeO nthreads =
  tgl_ijit_dispatch_wx kid wid x o sizeX sizeO nthreads

-- RESIDENT ACTIVATIONS (2026-07-08): keep activations as untagged int64 in GPU
-- buffers so a chain of kernels runs GPU-side with ZERO CPU untag/retag/readback.
-- abuf_alloc = zeroed resident buffer; abuf_upload (= ibuf_update) writes a Rail
-- array in; abuf_download reads one out (retag). dispatch_wxrr/_rr = all-resident.
foreign tgl_abuf_alloc n -> int
foreign tgl_abuf_download h arr n -> int
foreign tgl_ijit_dispatch_wxrr kid wid xh oh nthreads -> int
foreign tgl_ijit_dispatch_rr kid ih oh nthreads -> int
abuf_alloc n = tgl_abuf_alloc n
abuf_upload h arr n = tgl_ibuf_update h arr n     -- write Rail array -> resident buf (untag)
abuf_download h arr n = tgl_abuf_download h arr n  -- resident buf -> Rail array (retag)
-- W@0 (resident weight), X@1 (resident activation IN), O@2 (resident activation OUT)
ijit_run_wxrr kid wid xh oh nthreads = tgl_ijit_dispatch_wxrr kid wid xh oh nthreads
-- IN@0=@1 (resident), OUT@2 (resident) -- for gelu/elemul-style A A O kernels
ijit_run_rr kid ih oh nthreads = tgl_ijit_dispatch_rr kid ih oh nthreads
