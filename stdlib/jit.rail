-- stdlib/jit.rail — JIT dispatch entry points for the fused Metal
-- kernels.  Phase 2.7: MSL source lives in stdlib/jit_emit.rail and is
-- emitted from FuseMatch records produced by stdlib/jit_match.rail.
-- This module is now a thin shim that drives the JIT compile + dispatch
-- pipeline; it does not own the MSL string.
--
-- Use:
--   import "stdlib/jit.rail"
--   let kid = jit_compile_rmsnorm_qkv 0
--   let _ = jit_run_rmsnorm_qkv kid x g wq wk wv qkv_packed seq d
--
-- Future (Phase 2.9): callers will hand in a FuseMatch directly and
-- the compile/dispatch path will look up the right kernel.  For now the
-- two pattern-specific entry points remain so existing consumers
-- (lm_v3_chunked_jit_long, jit_block_integration_smoke) don't churn.

import "stdlib/jit_emit.rail"

-- Compile the fused rmsnorm+QKV kernel.  Source is emitted by jit_emit.
jit_compile_rmsnorm_qkv _ =
  let _ = write_file "/tmp/rail_jit_kernel.metal" (emit_msl_rmsnorm_qkv 0)
  tgl_jit_compile_from_tmp_file 0

-- Dispatch.  Packs SEQ+D into one int (Rail FFI's 8-arg cap).
jit_run_rmsnorm_qkv kid x_arr g_arr wq_arr wk_arr wv_arr qkv_packed seq d =
  let seq_d = (seq * 65536) + d
  tgl_jit_dispatch_rmsnorm_qkv kid x_arr g_arr wq_arr wk_arr wv_arr qkv_packed seq_d

-- Compile the fused silu+hadamard kernel.  Source is emitted by jit_emit.
jit_compile_silu_hadamard _ =
  let _ = write_file "/tmp/rail_jit_kernel.metal" (emit_msl_silu_hadamard 0)
  tgl_jit_compile_from_tmp_file 0

-- Dispatch.  `out_sig` is a packed buffer of 2*N doubles: h_act in
-- [0, N), sigmoid(gate) in [N, 2N).
jit_run_silu_hadamard kid g_arr u_arr out_sig n =
  tgl_jit_dispatch_silu_hadamard kid g_arr u_arr out_sig n

-- ───────────────────────────────────────────────────────────────────────
-- Phase 2.9 v1.5 — shape-specialized compile entry points.  Take concrete
-- dimensions, emit shape-baked MSL via jit_emit.rail's *_shaped emitters,
-- JIT-compile.  Returns a kid specialized to those dims; Metal can fully
-- unroll the D-loops.  Dispatch wrappers (jit_run_*) stay shape-agnostic.
-- ───────────────────────────────────────────────────────────────────────
jit_compile_rmsnorm_qkv_shaped seq d =
  let _ = write_file "/tmp/rail_jit_kernel.metal" (emit_msl_rmsnorm_qkv_shaped seq d)
  tgl_jit_compile_from_tmp_file 0

jit_compile_silu_hadamard_shaped n =
  let _ = write_file "/tmp/rail_jit_kernel.metal" (emit_msl_silu_hadamard_shaped n)
  tgl_jit_compile_from_tmp_file 0
