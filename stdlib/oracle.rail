-- stdlib/oracle.rail — Compile-oracle evaluation for Rail-on-Rail.
--
-- The motivating question for self-hosting LMs: as the model trains,
-- does its greedy output become more compilable? This module exposes
-- that signal as a first-class metric by shelling out to rail_native
-- and parsing the error count.
--
-- Usage:
--   import "stdlib/oracle.rail"
--   let errs = oracle_errors "let x = 1\nmain = x\n"
--   -- errs = 0 on valid Rail, N on N errors, -1 if rail_native not
--   -- available.
--
-- Zero-error outputs can optionally be further validated by running
-- them and checking the exit code via oracle_compile_and_run.

import "stdlib/file.rail"
import "stdlib/parallel.rail"

-- Runs the rail_native compiler on `code`, returns the combined
-- stdout+stderr. The compiler prints one "file:line:col: error: msg"
-- per parse/type/link error plus a trailing "N error(s) found" line
-- on failure, or "as: OK" + "ld: OK" on success.
--
-- oracle_compile_at takes an explicit input path, which callers MUST
-- use when invoking the oracle concurrently — the shared default path
-- races under parallel load (harvest_filter, oracle_compile_batch, etc.).
-- Stream 2's bench_railnative.rail also dodges by supplying its own path
-- + flock + size-gated retry.
oracle_compile_at code path =
  let _ = write_file path code
  shell (cat ["cd ~/projects/rail-https && ./rail_native ", path, " 2>&1"])

oracle_compile code = oracle_compile_at code "/tmp/rail_oracle_in.rail"

-- Counts lines containing "error:" in the compiler output.  Returns
-- 0 for clean compilation.  The N-errors-found summary line itself
-- contains "error" but not "error:", so it doesn't double-count.
count_error_lines lines acc =
  if length lines == 0 then acc
  else
    let h = head lines
    let inc = if str_contains "error:" h then 1 else 0
    count_error_lines (tail lines) (acc + inc)

oracle_errors code =
  let out = oracle_compile code
  let lines = str_split "\n" out
  count_error_lines lines 0

-- True iff `code` compiled + linked cleanly — the "self-hosting passed"
-- signal.  Useful as a per-sample boolean for pass-rate metrics.
oracle_ok code =
  let out = oracle_compile code
  str_contains "ld: OK" out

-- Full pass: compile AND run, capture the program's exit behavior.
-- Returns the captured stdout of the generated program (or the compile
-- error output if compile failed).
oracle_compile_and_run_at code path =
  let _ = write_file path code
  shell (cat ["cd ~/projects/rail-https && ./rail_native run ", path, " 2>&1"])

oracle_compile_and_run code = oracle_compile_and_run_at code "/tmp/rail_oracle_in.rail"

-- ────────────────────────────────────────────────────────────────
-- Richer oracle metric: compile-OK × non-triviality
--
-- `oracle_errors` alone is not a good training signal because a
-- whitespace-only output parses as a valid empty program (0 errors).
-- An untrained model whose argmax collapses to a single token per
-- position scores perfectly. Training initially moves the metric
-- the "wrong" way as the model diversifies.
--
-- oracle_quality folds three signals into one int:
--   1. compile_ok   — binary, 0 if compile fails
--   2. non-whitespace — count of chars that aren't space/tab/newline
--   3. diversity    — count of distinct characters
-- score = compile_ok * non_whitespace * diversity
--
-- A model emitting one token gets 0 (diversity=1 → 0 after multiplication
-- yields length, but the min-threshold gate rejects it). A valid program
-- with real tokens and structure gets a large positive value. Rising
-- score during training means the model is producing more substantive
-- Rail that the compiler still accepts.
-- ────────────────────────────────────────────────────────────────

is_ws c = if c == " " then true
          else if c == "\n" then true
          else if c == "\t" then true
          else false

count_nw_loop cs acc =
  if length cs == 0 then acc
  else
    let h = head cs
    let inc = if is_ws h then 0 else 1
    count_nw_loop (tail cs) (acc + inc)

count_non_whitespace code = count_nw_loop (chars code) 0

-- Build a set (as list) of distinct chars, return length.
dedupe_contains xs target =
  if length xs == 0 then false
  else if head xs == target then true
  else dedupe_contains (tail xs) target

dedupe_loop cs acc =
  if length cs == 0 then length acc
  else
    let h = head cs
    if dedupe_contains acc h then dedupe_loop (tail cs) acc
    else dedupe_loop (tail cs) (cons h acc)

count_unique_chars code = dedupe_loop (chars code) []

-- Composite score. Rewards structured substantive output AND compile
-- success. Degenerate inputs (short or low-diversity) score 0.
-- Compiling output scores 10× the baseline-substance score.
-- Non-compiling substantive output scores proportional to substance,
-- penalized by error count — so a tiny Rail-shaped output with 1 error
-- scores better than the same length with 5 errors, giving training
-- a gradient even before the model reaches clean compile.
--
-- Single oracle_compile call shared between error-count parse and
-- compile-OK check — keeps the shell-out cost to one per scoring.
oracle_stats_impl code =
  let out = oracle_compile code
  let lines = str_split "\n" out
  let errs = count_error_lines lines 0
  let ok_flag = if str_contains "ld: OK" out then 1 else 0
  cons errs (cons ok_flag [])

-- Min non-whitespace for the 10× compile-pass bonus to apply. Below this
-- threshold the output is considered trivial even if the compiler
-- accepts it — prevents an all-whitespace-with-30-stray-chars baseline
-- from outscoring substantive-but-imperfect trained output.
-- Raised 64 → 128 (2026-04-20) after shorter trivia like
--   `main = let _ = print (show 5) in 0`
-- was inheriting the bonus despite being a one-liner.
oracle_min_nw_for_bonus = 128

-- Min distinct characters. A program with fewer than this many unique
-- chars is either a repeated token or a single primitive — not a
-- training signal. Bumped 4 → 8 (2026-04-20) because `main = 0\n`
-- (7 unique chars) was squeaking past the old floor.
oracle_min_unique_chars = 8

-- Min top-level declarations for the compile-bonus to apply at all.
-- Counts lines starting with an identifier alpha + " =" (the Rail
-- top-level decl shape). Enforces ≥1 helper beyond `main = …`, so
-- single-line `main = <expr>` trivia no longer gets a compile bonus.
oracle_min_decls_for_bonus = 2

-- Heuristic "is this character an identifier start" (Rail idents are
-- lowercase + underscore at top level). Rail's `char_to_int` does NOT
-- return ASCII, so we enumerate (same idiom as stdlib/bpe.rail).
is_ident_alpha c =
  if c == "a" then true else if c == "b" then true else if c == "c" then true
  else if c == "d" then true else if c == "e" then true else if c == "f" then true
  else if c == "g" then true else if c == "h" then true else if c == "i" then true
  else if c == "j" then true else if c == "k" then true else if c == "l" then true
  else if c == "m" then true else if c == "n" then true else if c == "o" then true
  else if c == "p" then true else if c == "q" then true else if c == "r" then true
  else if c == "s" then true else if c == "t" then true else if c == "u" then true
  else if c == "v" then true else if c == "w" then true else if c == "x" then true
  else if c == "y" then true else if c == "z" then true else if c == "_" then true
  else false

-- A top-level decl line: starts with an ident alpha (no leading space),
-- contains " =" somewhere. `match` arms (`| Ctor -> …`), comments
-- (`-- …`), continuations, and body-let lines (which are indented)
-- are excluded by the no-leading-whitespace + no-`-`-start rules.
-- Using " =" (without trailing space) so `main =\n` — where the body
-- starts on the next line — still counts as a decl.
is_decl_line line =
  if length (chars line) == 0 then false
  else
    let first = head (chars line)
    if is_ident_alpha first then str_contains " =" line else false

count_decl_lines_loop lines acc =
  if length lines == 0 then acc
  else
    let line = head lines
    let inc = if is_decl_line line then 1 else 0
    count_decl_lines_loop (tail lines) (acc + inc)

count_top_level_decls code =
  count_decl_lines_loop (str_split "\n" code) 0

oracle_quality code =
  let nw = count_non_whitespace code
  let uq = count_unique_chars code
  if nw < 16 then 0
  else if uq < oracle_min_unique_chars then 0
  else
    let stats = oracle_stats_impl code
    let errs = head stats
    let ok_flag = head (tail stats)
    let decls = count_top_level_decls code
    let base = nw * uq
    if ok_flag == 1 then
      -- Compile + link passed. Gate the bonus on top-level-decl count:
      -- a lone `main = <expr>` is the degenerate-model attractor we're
      -- penalising. Require at least one helper definition beyond main.
      if decls < oracle_min_decls_for_bonus then 0
      else if nw >= oracle_min_nw_for_bonus then base * 10
      else base
    else
      -- Parse succeeded (errs=0) but link failed (ok_flag=0) means the
      -- output is effectively empty - all comments / dashes, nothing
      -- callable. Don't reward it. Only give partial credit when there
      -- are genuine parse errors (model produced real token structure).
      (if errs == 0 then 0 else base / (1 + errs))

-- ────────────────────────────────────────────────────────────────
-- oracle_compile_batch  (Stream 3 addition, 2026-04-20)
--
-- Fans compile-oracle calls across OS processes via parallel_shell.
-- Input:  codes (list of Rail source strings), max_conc (int)
-- Output: list of [errs, ok_flag, quality] triples, same order as codes.
--
-- Scoring MIRRORS oracle_quality above (decls gate + thresholds).
-- If oracle_quality tightens further, update ob_score_one in
-- lockstep (search "MIRRORS oracle_quality").
--
-- Concurrent-safe via --out-prefix (compile.rail 4399445).
-- Each worker gets its own <tmpdir>/ob_out_<idx> prefix so there's no
-- race on the /tmp/rail_out.{s,o} intermediates. Pre-4399445 this was
-- serialised by a POSIX flock which capped speedup at 1.03× Mini
-- at max_conc=10 (training/rail_native/ORACLE_PARALLEL_BENCH.md).
-- ────────────────────────────────────────────────────────────────

ob_write_codes tmpdir codes idx =
  if length codes == 0 then idx
  else
    let path = cat [tmpdir, "/ob_in_", show idx, ".rail"]
    let _ = write_file path (head codes)
    ob_write_codes tmpdir (tail codes) (idx + 1)

-- Per-worker --out-prefix eliminates the /tmp/rail_out race; no lock needed.
ob_make_cmd tmpdir idx =
  cat ["cd ~/projects/rail-https && ./rail_native --out-prefix ", tmpdir, "/ob_out_", show idx, " ", tmpdir, "/ob_in_", show idx, ".rail 2>&1"]

ob_build_cmds tmpdir n idx acc =
  if idx >= n then reverse acc
  else ob_build_cmds tmpdir n (idx + 1) (cons (ob_make_cmd tmpdir idx) acc)

-- MIRRORS oracle_quality.  Given captured compile output, replay the
-- scoring formula so we don't re-shell once per candidate. Keep in
-- sync with oracle_quality's body (thresholds + decls gate).
ob_score_one code out =
  let nw = count_non_whitespace code
  let uq = count_unique_chars code
  let lines = str_split "\n" out
  let errs = count_error_lines lines 0
  let ok_flag = if str_contains "ld: OK" out then 1 else 0
  if nw < 16 then cons errs (cons ok_flag (cons 0 []))
  else if uq < oracle_min_unique_chars then cons errs (cons ok_flag (cons 0 []))
  else
    let decls = count_top_level_decls code
    let base = nw * uq
    let q = if ok_flag == 1 then
              (if decls < oracle_min_decls_for_bonus then 0
               else if nw >= oracle_min_nw_for_bonus then base * 10
               else base)
            else (if errs == 0 then 0 else base / (1 + errs))
    cons errs (cons ok_flag (cons q []))

ob_score_loop codes pairs acc =
  if length codes == 0 then reverse acc
  else if length pairs == 0 then reverse acc
  else
    let code = head codes
    let pair = head pairs
    let out = head (tail pair)
    ob_score_loop (tail codes) (tail pairs) (cons (ob_score_one code out) acc)

oracle_compile_batch codes max_conc =
  let n = length codes
  if n == 0 then []
  else
    let tmpdir_raw = shell "mktemp -d /tmp/rail_oracle_batch.XXXXXX"
    let tmpdir = par_rstrip_nl tmpdir_raw
    let _ = ob_write_codes tmpdir codes 0
    let cmds = ob_build_cmds tmpdir n 0 []
    let pairs = parallel_shell cmds max_conc
    let triples = ob_score_loop codes pairs []
    let _ = shell (cat ["rm -rf ", tmpdir])
    triples
