-- stdlib/oracle.rail — Compile-oracle evaluation for Rail-on-Rail.
--
-- The motivating question for self-hosting LMs: as the model trains,
-- does its greedy output become more compilable? This module exposes
-- that signal as a first-class metric by shelling out to rail_native
-- and parsing the error count.
--
-- Usage:
--   import "stdlib/oracle.rail"
--   let errs = oracle_errors "let x = 1\nmain = x\n"
--   -- errs = 0 on valid Rail, N on N errors, -1 if rail_native not
--   -- available.
--
-- Zero-error outputs can optionally be further validated by running
-- them and checking the exit code via oracle_compile_and_run.

import "stdlib/file.rail"

-- Runs the rail_native compiler on `code`, returns the combined
-- stdout+stderr. The compiler prints one "file:line:col: error: msg"
-- per parse/type/link error plus a trailing "N error(s) found" line
-- on failure, or "as: OK" + "ld: OK" on success.
oracle_compile code =
  let _ = write_file "/tmp/rail_oracle_in.rail" code
  shell "cd ~/projects/rail && ./rail_native /tmp/rail_oracle_in.rail 2>&1"

-- Counts lines containing "error:" in the compiler output.  Returns
-- 0 for clean compilation.  The N-errors-found summary line itself
-- contains "error" but not "error:", so it doesn't double-count.
count_error_lines lines acc =
  if length lines == 0 then acc
  else
    let h = head lines
    let inc = if str_contains "error:" h then 1 else 0
    count_error_lines (tail lines) (acc + inc)

oracle_errors code =
  let out = oracle_compile code
  let lines = str_split "\n" out
  count_error_lines lines 0

-- True iff `code` compiled + linked cleanly — the "self-hosting passed"
-- signal.  Useful as a per-sample boolean for pass-rate metrics.
oracle_ok code =
  let out = oracle_compile code
  str_contains "ld: OK" out

-- Full pass: compile AND run, capture the program's exit behavior.
-- Returns the captured stdout of the generated program (or the compile
-- error output if compile failed).
oracle_compile_and_run code =
  let _ = write_file "/tmp/rail_oracle_in.rail" code
  shell "cd ~/projects/rail && ./rail_native run /tmp/rail_oracle_in.rail 2>&1"
