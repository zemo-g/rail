-- stdlib/bpe.rail — Byte-pair encoding tokenizer for Rail LM training.
-- Import: import "stdlib/bpe.rail"
--
-- BPE learns sub-word merge rules from a corpus, compressing long
-- character sequences into fewer tokens. The char-level tokenizer
-- (stdlib/tokenizer.rail) caps training seq-length at corpus char count;
-- BPE at target_vocab=4096 compresses ~3x on Rail source, unlocking
-- chunked training on the ~800K+ stdlib corpus (cat stdlib/*.rail).
--
-- Usage:
--   import "stdlib/bpe.rail"
--   let bpe = bpe_train corpus 512
--   let ids = bpe_encode bpe corpus
--   let back = bpe_decode bpe ids           -- == corpus
--   let _ = bpe_save "/tmp/tok" bpe          -- → /tmp/tok.vocab + .merges
--   let bpe2 = bpe_load "/tmp/tok"
--
-- Layout:
--   BPE merges vocab size
--     merges : [(a, b, new_id)]  — ordered learned merges
--     vocab  : [string]          — byte-sequence per token id (base chars
--                                  first, merged tokens appended in order)
--     size   : int               — len vocab
--
-- The base vocab is the set of distinct characters in the training corpus
-- (first-appearance order, same discipline as stdlib/tokenizer.rail).
-- Merged tokens start at id = base_size. Encoding applies merges greedy
-- left-to-right in learn order; decoding concatenates vocab[i] byte-seqs.

import "stdlib/map.rail"

type BPE = | BPE merges vocab size

-- ========== Pair key packing ==========
-- Pack (a, b) into a single int so map_get / map_put can hash pairs.
-- Multiplier must exceed any plausible token id. 2^20 = 1_048_576 is
-- comfortable for vocabularies up to ~1M.

bpe_pair_key a b = a * 1048576 + b
bpe_key_a k = k / 1048576
bpe_key_b k = k - (k / 1048576) * 1048576

-- Local nth / drop so bpe.rail doesn't require stdlib/list.rail.
bpe_nth n xs =
  if n == 0 then head xs
  else bpe_nth (n - 1) (tail xs)

bpe_drop n xs =
  if n <= 0 then xs
  else if xs == [] then []
  else bpe_drop (n - 1) (tail xs)

-- ========== Base vocab (distinct chars in first-appearance order) ==========

bpe_contains_char cs c =
  if cs == [] then false
  else if head cs == c then true
  else bpe_contains_char (tail cs) c

bpe_collect_unique input acc =
  if input == [] then reverse acc
  else
    let c = head input
    if bpe_contains_char acc c then bpe_collect_unique (tail input) acc
    else bpe_collect_unique (tail input) (cons c acc)

-- Linear-scan char → id in the base-vocab prefix. Merged tokens have
-- length ≥ 2 so they never false-match a 1-char query.
bpe_char_id_loop cs c i =
  if cs == [] then (0 - 1)
  else if head cs == c then i
  else bpe_char_id_loop (tail cs) c (i + 1)

-- Length-threaded inner loop — avoids O(N) `length cs` per step (#3).
bpe_init_encode_loop_n cs n vocab_list acc =
  if n == 0 then reverse acc
  else
    let id = bpe_char_id_loop vocab_list (head cs) 0
    bpe_init_encode_loop_n (tail cs) (n - 1) vocab_list (cons id acc)

bpe_init_encode_loop cs vocab_list acc =
  bpe_init_encode_loop_n cs (length cs) vocab_list acc

-- Array-emitter version — produces a mutable int array of char ids.
-- Used by the training hot path to avoid O(target × N) cons allocations.
bpe_init_encode_arr_loop cs n vocab_list arr i =
  if n == 0 then arr
  else
    let id = bpe_char_id_loop vocab_list (head cs) 0
    let _ = arr_set arr i id
    bpe_init_encode_arr_loop (tail cs) (n - 1) vocab_list arr (i + 1)

bpe_init_encode_arr cs vocab_list =
  let n = length cs
  let arr = arr_new n 0
  bpe_init_encode_arr_loop cs n vocab_list arr 0

-- ========== Pair counting (int→int map) ==========

-- Array-based pair counting — zero cons allocations per step. For training
-- on large corpora (#3, memory half): the earlier cons-list scan allocated
-- a fresh tail cell per step, saturating the arena at ~50K tokens.
bpe_count_pairs_arr_loop arr n i m =
  if i >= n - 1 then m
  else
    let a = arr_get arr i
    let b = arr_get arr (i + 1)
    let k = bpe_pair_key a b
    let c = map_get m k
    bpe_count_pairs_arr_loop arr n (i + 1) (map_put m k (c + 1))

bpe_count_pairs_arr arr n m =
  bpe_count_pairs_arr_loop arr n 0 m

-- Walk map keys, track (best_key, best_count). Tie-break: keep smaller
-- key so the tokenizer is deterministic for a given corpus.
bpe_find_best_key_loop keys m best_k best_c =
  if keys == [] then (best_k, best_c)
  else
    let k = head keys
    let c = map_get m k
    if c > best_c then bpe_find_best_key_loop (tail keys) m k c
    else bpe_find_best_key_loop (tail keys) m best_k best_c

-- ========== Merge application ==========
-- Replace every adjacent (a, b) pair with new_id, left-to-right.
-- After a replacement we advance past BOTH consumed tokens, so "aaa"
-- with merge (a,a)→X tokenizes as [X, a] (not [X, X]).

-- Length-threaded inner loop — avoids O(N) `length tokens` per step (#3).
-- When a merge fires we consume two tokens, so n decreases by 2; otherwise 1.
bpe_apply_merge_n tokens n a b nid acc =
  if n == 0 then reverse acc
  else if n == 1 then reverse (cons (head tokens) acc)
  else
    let t0 = head tokens
    let t1 = head (tail tokens)
    if t0 == a then
      if t1 == b then
        bpe_apply_merge_n (tail (tail tokens)) (n - 2) a b nid (cons nid acc)
      else bpe_apply_merge_n (tail tokens) (n - 1) a b nid (cons t0 acc)
    else bpe_apply_merge_n (tail tokens) (n - 1) a b nid (cons t0 acc)

bpe_apply_merge tokens a b nid acc =
  bpe_apply_merge_n tokens (length tokens) a b nid acc

-- In-place array merge. Writes to position w <= read position i, so no
-- forward corruption. Returns new active length. Zero cons allocations.
bpe_apply_merge_arr_loop arr n i w a b nid =
  if i >= n then w
  else if i == n - 1 then
    let t = arr_get arr i
    let _ = arr_set arr w t
    w + 1
  else
    let t0 = arr_get arr i
    let t1 = arr_get arr (i + 1)
    if t0 == a then
      if t1 == b then
        let _ = arr_set arr w nid
        bpe_apply_merge_arr_loop arr n (i + 2) (w + 1) a b nid
      else
        let _ = arr_set arr w t0
        bpe_apply_merge_arr_loop arr n (i + 1) (w + 1) a b nid
    else
      let _ = arr_set arr w t0
      bpe_apply_merge_arr_loop arr n (i + 1) (w + 1) a b nid

bpe_apply_merge_arr arr n a b nid =
  bpe_apply_merge_arr_loop arr n 0 0 a b nid

-- ========== Training loop ==========
-- Invariants:
--   size == length vocab
--   merges is ordered by learn time (oldest first)
--
-- Stops when:
--   - target hit
--   - best pair frequency drops below 2 (no compression gain)
--   - no pairs left (fully consumed)

-- Find best pair. Uses a BST pair-count map as scratch; wraps the whole
-- scratch in arena_mark/reset so the transient map + keys list don't
-- accumulate across training iterations (Rail's GC doesn't reliably
-- reclaim hundreds of BSTs built in tight loops — empirically verified).
bpe_best_pair_arr arr n =
  let mk = arena_mark 0
  let counts = bpe_count_pairs_arr arr n (map_new 0)
  let keys = map_keys counts
  if keys == [] then
    let _ = arena_reset mk
    (0, 0)
  else
    let best = bpe_find_best_key_loop keys counts 0 0
    let (bk, bc) = best
    let _ = arena_reset mk
    (bk, bc)

-- LEGACY (pre-v2.4): preserved for regression comparison against the
-- fast path below. O(K²) per iter because map_keys does `append (map_keys
-- l) (cons k (map_keys r))`, and `append vocab [...]` / `append merges
-- [...]` are O(V)+O(M) every iter. Observable on 50 KB × target=512:
-- 11.7 s on the sample profile, dominated by `.Lapp_list`.
bpe_train_loop_arr_old arr n merges vocab size target =
  if size >= target then BPE merges vocab size
  else
    let best = bpe_best_pair_arr arr n
    let (best_k, best_c) = best
    if best_c < 2 then BPE merges vocab size
    else
      let a = bpe_key_a best_k
      let b = bpe_key_b best_k
      let nid = size
      let new_token = append (bpe_nth a vocab) (bpe_nth b vocab)
      let new_vocab = append vocab [new_token]
      let new_merges = append merges [(a, b, nid)]
      let new_n = bpe_apply_merge_arr arr n a b nid
      bpe_train_loop_arr_old arr new_n new_merges new_vocab (size + 1) target

-- ========== Fast path (v2.4) ==========
-- Three wins over the legacy loop:
--   (a) Direct BST tree-walk to find the max-count pair — no `map_keys`
--       list materialization (that was O(K²) via append) and no per-key
--       `map_get` pass. Single in-order traversal, O(K).
--   (b) Deferred vocab: during training we keep ONLY arr + (a,b,nid)
--       merge triples. Vocab strings are built once at the end from
--       base_vocab + merges. Removes the per-iter `append vocab [...]`
--       O(V) list append AND the `bpe_nth a vocab` / `bpe_nth b vocab`
--       O(V) lookup that was computing `new_token` every iter.
--   (c) Merges accumulated in reverse with `cons`, reversed once at the
--       end. O(1) per iter instead of O(M) append.
-- The pair-count rebuild itself is still per-iter O(n log K) — genuine
-- incremental updates are queued for a follow-up if the headline
-- metric slips (target V=4096 / 540 KB / <5 min).

-- In-order tree walk that returns (best_key, best_count). Because we
-- walk left-root-right, lower keys are visited first, so the strict
-- `v > best_c` check preserves the legacy tie-break ("prefer smaller
-- key on equal count").
bpe_map_best_pair m best_k best_c = match m
  | MapEmpty -> (best_k, best_c)
  | MapNode k v l r ->
    let lbest = bpe_map_best_pair l best_k best_c
    let (lk, lc) = lbest
    if v > lc then bpe_map_best_pair r k v
    else bpe_map_best_pair r lk lc

bpe_best_pair_tree arr n =
  let mk = arena_mark 0
  let counts = bpe_count_pairs_arr arr n (map_new 0)
  let best = bpe_map_best_pair counts 0 0
  let (bk, bc) = best
  let _ = arena_reset mk
  (bk, bc)

-- Deferred-vocab loop: accumulates (a,b,nid) triples in reverse and
-- returns (merges_forward, final_size) once done.
bpe_train_loop_deferred arr n merges_rev size target =
  if size >= target then (reverse merges_rev, size)
  else
    let best = bpe_best_pair_tree arr n
    let (best_k, best_c) = best
    if best_c < 2 then (reverse merges_rev, size)
    else
      let a = bpe_key_a best_k
      let b = bpe_key_b best_k
      let nid = size
      let new_n = bpe_apply_merge_arr arr n a b nid
      bpe_train_loop_deferred arr new_n (cons (a, b, nid) merges_rev) (size + 1) target

-- ========== Incremental pair-count update (v2.4) ==========
-- Classic BPE speedup: instead of rebuilding the whole pair_count map
-- each iteration (O(n log K) per step × target steps = O(n·target·log K)),
-- we keep the map persistent and apply a delta at each merge.
--
-- Process match positions in runs: a "run" is a maximal sequence of
-- consecutive non-overlapping matches at positions i, i+2, i+4, ...,
-- i+2*(k-1) for a merge rule (a,b)→nid. Collapsing a run of length k
-- turns 2k tokens (a,b,a,b,...,a,b) into k copies of nid.
--
-- Deltas per run with outer neighbors L_raw, R_raw (both may be -1 for
-- "end of array"):
--   (a, b)       -= k
--   (b, a)       -= (k - 1)      -- crossing pairs inside the run
--   (nid, nid)   += (k - 1)      -- new inside-run pairs
--   (L_raw, a)   -= 1    if L_raw >= 0
--   (L_raw, nid) += 1    if L_raw >= 0
--   (b, R_raw)   -= 1    if R_raw >= 0
--   (nid, R_raw) += 1    if R_raw >= 0
-- map_get returns 0 for missing keys, so decrementing a non-present
-- pair yields a -1 stale entry — harmless for the max-finder (counts
-- ≤ 0 can't beat a positive count).

-- Adjust one pair's count by delta.
bpe_bump counts key delta =
  let c = map_get counts key
  map_put counts key (c + delta)

-- Apply the run's delta to counts. Called when we close a run.
bpe_delta_close counts a b nid L R k =
  if k <= 0 then counts
  else
    let ab = bpe_pair_key a b
    let ba = bpe_pair_key b a
    let nn = bpe_pair_key nid nid
    let c1 = bpe_bump counts ab (0 - k)
    let c2 = if k > 1 then bpe_bump c1 ba (0 - (k - 1)) else c1
    let c3 = if k > 1 then bpe_bump c2 nn (k - 1) else c2
    let c4 = if L >= 0 then
               let c4a = bpe_bump c3 (bpe_pair_key L a) (0 - 1)
               bpe_bump c4a (bpe_pair_key L nid) 1
             else c3
    let c5 = if R >= 0 then
               let c5a = bpe_bump c4 (bpe_pair_key b R) (0 - 1)
               bpe_bump c5a (bpe_pair_key nid R) 1
             else c4
    c5

-- Detect a match at position i. Guarded: no short-circuit in `&&`, so
-- nested ifs do the bounds-safe check.
bpe_is_match arr n a b i =
  if i + 1 < n then
    if arr_get arr i == a then
      if arr_get arr (i + 1) == b then true
      else false
    else false
  else false

-- Scan the array and fold run deltas into counts. Returns the updated
-- counts map. Does NOT mutate arr — the actual merge rewrite happens
-- in bpe_apply_merge_arr afterwards on the (still-current) arr.
bpe_delta_scan arr n a b nid counts i run_k L =
  if i >= n then bpe_delta_close counts a b nid L (0 - 1) run_k
  else if bpe_is_match arr n a b i then
    if run_k == 0 then
      -- Opening a run. L_raw = arr[i-1] if i > 0 else -1.
      let newL = if i == 0 then (0 - 1) else arr_get arr (i - 1)
      bpe_delta_scan arr n a b nid counts (i + 2) 1 newL
    else
      bpe_delta_scan arr n a b nid counts (i + 2) (run_k + 1) L
  else
    if run_k > 0 then
      -- Close the run using arr[i] as R_raw (it's not a match, so it stays).
      let c2 = bpe_delta_close counts a b nid L (arr_get arr i) run_k
      bpe_delta_scan arr n a b nid c2 (i + 1) 0 (0 - 1)
    else
      bpe_delta_scan arr n a b nid counts (i + 1) 0 (0 - 1)

-- Tree-walk max over a persistent counts map. Same semantics as
-- bpe_map_best_pair; no arena wrap because the caller holds `counts`
-- across iterations and we don't want to free it.
bpe_best_pair_persistent counts =
  let best = bpe_map_best_pair counts 0 0
  let (bk, bc) = best
  (bk, bc)

-- Incremental training loop: persistent counts, delta-updated per merge.
bpe_train_loop_inc arr n counts merges_rev size target =
  if size >= target then (reverse merges_rev, size)
  else
    let best = bpe_best_pair_persistent counts
    let (best_k, best_c) = best
    if best_c < 2 then (reverse merges_rev, size)
    else
      let a = bpe_key_a best_k
      let b = bpe_key_b best_k
      let nid = size
      let counts2 = bpe_delta_scan arr n a b nid counts 0 0 (0 - 1)
      let new_n = bpe_apply_merge_arr arr n a b nid
      bpe_train_loop_inc arr new_n counts2 (cons (a, b, nid) merges_rev) (size + 1) target

-- Build the final vocab list once training is done. Layout:
--   vocab[0..base_size-1] = base_vocab (1-char strings)
--   vocab[base_size..size-1] = vocab[a] ++ vocab[b] for each (a,b,nid)
-- Mutable string array is O(1)-index and lets us build forward without
-- an O(V²) append chain. Converted to a cons list at the very end to
-- match the existing BPE ADT.
bpe_fill_base_arr arr base i =
  if base == [] then 0
  else
    let _ = arr_set arr i (head base)
    bpe_fill_base_arr arr (tail base) (i + 1)

bpe_fill_merged_arr arr merges =
  if merges == [] then 0
  else
    let m = head merges
    let (a, b, nid) = m
    let sa = arr_get arr a
    let sb = arr_get arr b
    let _ = arr_set arr nid (append sa sb)
    bpe_fill_merged_arr arr (tail merges)

bpe_arr_to_list_rev arr i acc =
  if i < 0 then acc
  else bpe_arr_to_list_rev arr (i - 1) (cons (arr_get arr i) acc)

bpe_build_vocab base_vocab merges final_size =
  let varr = arr_new final_size ""
  let _ = bpe_fill_base_arr varr base_vocab 0
  let _ = bpe_fill_merged_arr varr merges
  bpe_arr_to_list_rev varr (final_size - 1) []

bpe_train text target =
  let all_chars = chars text
  let uniq = bpe_collect_unique all_chars []
  let base_size = length uniq
  if target <= base_size then BPE [] uniq base_size
  else
    let arr = bpe_init_encode_arr all_chars uniq
    let n = arr_len arr
    let trained = bpe_train_loop_deferred arr n [] base_size target
    let (merges, final_size) = trained
    let vocab = bpe_build_vocab uniq merges final_size
    BPE merges vocab final_size

-- Incremental-counts entry point (WIP, NOT wired into bpe_train).
--
-- Semantically correct: the determinism test and 10 KB smoke both show
-- it produces byte-identical (merges, vocab, size) to the legacy path.
-- Performance, however, degrades badly above ~50 KB / target=512 — the
-- persistent Map + per-bump map_put allocations fill the 512 MB arena
-- fast enough that GC dominates. On the 540 KB × target=1024 run it had
-- not finished after 30 minutes, vs 6.5 minutes for the non-incremental
-- deferred path in the same configuration.
--
-- The real fix is an open-addressed mutable hash table of ints (two
-- parallel float_arrs for keys + counts) so each bump is O(1) with zero
-- allocation. That's the next session's first job — queued along with
-- an explicit max-heap so best_pair is O(log K) instead of O(K). Until
-- then, the deferred-vocab + tree-walk-max path ships as bpe_train,
-- worth ~1.7–3× over the legacy loop and correct at every corpus size
-- we've tried.
bpe_train_inc_wip text target =
  let all_chars = chars text
  let uniq = bpe_collect_unique all_chars []
  let base_size = length uniq
  if target <= base_size then BPE [] uniq base_size
  else
    let arr = bpe_init_encode_arr all_chars uniq
    let n = arr_len arr
    let counts0 = bpe_count_pairs_arr arr n (map_new 0)
    let trained = bpe_train_loop_inc arr n counts0 [] base_size target
    let (merges, final_size) = trained
    let vocab = bpe_build_vocab uniq merges final_size
    BPE merges vocab final_size

-- Legacy entry point for regression tests — lets callers verify the fast
-- path produces identical (merges, vocab, size) to the old loop.
bpe_train_legacy text target =
  let all_chars = chars text
  let uniq = bpe_collect_unique all_chars []
  let base_size = length uniq
  if target <= base_size then BPE [] uniq base_size
  else
    let arr = bpe_init_encode_arr all_chars uniq
    let n = arr_len arr
    bpe_train_loop_arr_old arr n [] uniq base_size target

-- ========== Encode / decode ==========

bpe_apply_all_merges tokens merges =
  if merges == [] then tokens
  else
    let m = head merges
    let (a, b, nid) = m
    bpe_apply_all_merges (bpe_apply_merge tokens a b nid []) (tail merges)

bpe_encode bpe text = match bpe
  | BPE merges vocab size ->
    let init_tokens = bpe_init_encode_loop (chars text) vocab []
    bpe_apply_all_merges init_tokens merges

bpe_decode_loop ids vocab acc =
  if ids == [] then reverse acc
  else bpe_decode_loop (tail ids) vocab (cons (bpe_nth (head ids) vocab) acc)

bpe_decode bpe ids = match bpe
  | BPE merges vocab size -> join "" (bpe_decode_loop ids vocab [])

bpe_vocab_size bpe = match bpe
  | BPE _ _ s -> s

-- ========== Persistence ==========
-- File format:
--   <path>.vocab   one token per line, escaped: "\\" → "\\\\", "\n" → "\\n",
--                  "\t" → "\\t". Unescape on load is the literal inverse.
--   <path>.merges  one "a b c" triple per line (decimal ints).
--
-- Vocab is ordered by id: line i (0-indexed) is token i. Merges preserve
-- learn order. Round-trip preserves the exact BPE struct.

bpe_escape_chars cs acc =
  if cs == [] then reverse acc
  else
    let c = head cs
    if c == "\\" then bpe_escape_chars (tail cs) (cons "\\\\" acc)
    else if c == "\n" then bpe_escape_chars (tail cs) (cons "\\n" acc)
    else if c == "\t" then bpe_escape_chars (tail cs) (cons "\\t" acc)
    else bpe_escape_chars (tail cs) (cons c acc)

bpe_escape s = join "" (bpe_escape_chars (chars s) [])

bpe_unescape_chars cs acc =
  if cs == [] then reverse acc
  else
    let c = head cs
    if c == "\\" then
      let rest = tail cs
      if rest == [] then reverse (cons c acc)
      else
        let n = head rest
        if n == "n" then bpe_unescape_chars (tail rest) (cons "\n" acc)
        else if n == "t" then bpe_unescape_chars (tail rest) (cons "\t" acc)
        else if n == "\\" then bpe_unescape_chars (tail rest) (cons "\\" acc)
        else bpe_unescape_chars rest (cons c acc)
    else bpe_unescape_chars (tail cs) (cons c acc)

bpe_unescape s = join "" (bpe_unescape_chars (chars s) [])

bpe_escape_line v = append (bpe_escape v) "\n"

bpe_merge_to_line m =
  let (a, b, nid) = m
  join "" [show a, " ", show b, " ", show nid, "\n"]

bpe_save path bpe = match bpe
  | BPE merges vocab size ->
    let vocab_body = join "" (map bpe_escape_line vocab)
    let merges_body = join "" (map bpe_merge_to_line merges)
    let _ = write_file (append path ".vocab") vocab_body
    let _ = write_file (append path ".merges") merges_body
    0

-- Pure-Rail string→int (self-contained so bpe.rail doesn't pull socket.rail).
-- NOTE: Rail's `char_to_int` doesn't return the ASCII code byte — per
-- tools/train/hyperagent.rail, the convention in this repo is to
-- decode digits via direct string comparison.
bpe_digit_val c =
  if c == "0" then 0
  else if c == "1" then 1
  else if c == "2" then 2
  else if c == "3" then 3
  else if c == "4" then 4
  else if c == "5" then 5
  else if c == "6" then 6
  else if c == "7" then 7
  else if c == "8" then 8
  else if c == "9" then 9
  else (0 - 1)

bpe_parse_int_acc cs acc =
  if cs == [] then acc
  else
    let d = bpe_digit_val (head cs)
    if d < 0 then acc
    else bpe_parse_int_acc (tail cs) (acc * 10 + d)

bpe_parse_int s = bpe_parse_int_acc (chars s) 0

bpe_nonempty s = length s > 0

-- Parse "a b c" → (a, b, c) tuple.
bpe_parse_merge_line line =
  let parts = split " " line
  let a = bpe_parse_int (head parts)
  let b = bpe_parse_int (head (tail parts))
  let c = bpe_parse_int (head (tail (tail parts)))
  (a, b, c)

bpe_load path =
  let vocab_body = read_file (append path ".vocab")
  let merges_body = read_file (append path ".merges")
  let vocab_lines = split "\n" vocab_body
  let merges_lines = split "\n" merges_body
  let vocab_ne = filter bpe_nonempty vocab_lines
  let merges_ne = filter bpe_nonempty merges_lines
  let vocab = map bpe_unescape vocab_ne
  let merges = map bpe_parse_merge_line merges_ne
  BPE merges vocab (length vocab)
