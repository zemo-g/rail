-- stdlib/url.rail — Pure Rail URL parsing
-- Import: import "stdlib/url.rail"

-- Parse URL into (scheme, host, port, path, query)
-- Handles: http://host:port/path?query
parse_url url =
  let cs = chars url
  let (scheme, rest1) = parse_scheme cs
  let (host, rest2) = parse_host rest1
  let (port, rest3) = parse_port rest2
  let (path, rest4) = parse_path rest3
  let query = parse_query rest4
  (scheme, from_chars host, port, from_chars path, from_chars query)

parse_scheme cs =
  if length cs == 0 then ("", cs)
  else
    let (before, after) = split_at_char ":" cs
    if length after >= 3 then
      if head after == ":" then
        let r = tail after
        if length r >= 2 then
          if head r == "/" then
            let r2 = tail r
            if head r2 == "/" then (from_chars before, tail r2)
            else ("", cs)
          else ("", cs)
        else ("", cs)
      else ("", cs)
    else ("", cs)

parse_host cs =
  split_at_any cs [":", "/", "?"]

parse_port cs =
  if length cs == 0 then (0, cs)
  else if head cs == ":" then
    let (digits, rest) = split_at_any (tail cs) ["/", "?"]
    (url_parse_int_chars digits 0, rest)
  else (0, cs)

-- Pure-Rail digit-list -> int.  The builtin `to_int` is float-only and
-- silently returns 0 for plain integer strings; that broke port parsing
-- for any explicit ":<port>" URL.
url_parse_int_chars cs acc =
  if length cs == 0 then acc
  else
    let c = head cs
    let d = char_to_int c - 48
    if d < 0 then acc
    else if d > 9 then acc
    else url_parse_int_chars (tail cs) (acc * 10 + d)

parse_path cs =
  if length cs == 0 then ([], cs)
  else if head cs == "/" then
    let (p, rest) = split_at_char "?" cs
    (p, rest)
  else ([], cs)

parse_query cs =
  if length cs == 0 then []
  else if head cs == "?" then tail cs
  else []

-- Split char list at first occurrence of char
split_at_char c cs = split_at_char_acc c cs []

split_at_char_acc c cs acc =
  if length cs == 0 then (reverse acc, [])
  else if head cs == c then (reverse acc, cs)
  else split_at_char_acc c (tail cs) (cons (head cs) acc)

-- Split at any of the given chars
split_at_any cs stops = split_at_any_acc cs stops []

split_at_any_acc cs stops acc =
  if length cs == 0 then (reverse acc, [])
  else if has_char (head cs) stops then (reverse acc, cs)
  else split_at_any_acc (tail cs) stops (cons (head cs) acc)

has_char c lst =
  if length lst == 0 then false
  else if head lst == c then true
  else has_char c (tail lst)

-- Convert list of chars to string
from_chars cs =
  if length cs == 0 then ""
  else append (head cs) (from_chars (tail cs))

-- ---------------------------------------------------------------------------
-- Percent-encoding (RFC 3986)
-- ---------------------------------------------------------------------------

-- Map a nibble (0..15) to its uppercase hex character.
url_hex_digit n =
  if n < 10 then char_from_int (48 + n)        -- '0'..'9'
  else char_from_int (55 + n)                  -- 'A'..'F'  (65 == 'A' == 55+10)

-- Map a hex character ('0'-'9','a'-'f','A'-'F') to its value, or -1.
url_hex_val c =
  let b = char_to_int c
  if b >= 48 then
    if b <= 57 then b - 48                      -- '0'..'9'
    else if b >= 97 then
      if b <= 102 then b - 87                   -- 'a'..'f'
      else 0 - 1
    else if b >= 65 then
      if b <= 70 then b - 55                    -- 'A'..'F'
      else 0 - 1
    else 0 - 1
  else 0 - 1

-- An unreserved byte may appear literally; everything else is %-encoded.
-- Unreserved set = ALPHA / DIGIT / "-" / "_" / "." / "~"
url_is_unreserved b =
  if b >= 48 then
    if b <= 57 then true                        -- 0-9
    else if b >= 65 then
      if b <= 90 then true                      -- A-Z
      else if b >= 97 then
        if b <= 122 then true                   -- a-z
        else b == 126                           -- ~
      else b == 95                              -- _
    else false
  else if b == 45 then true                     -- -
  else b == 46                                  -- .

-- Encode a single byte: literal if unreserved, else "%HH".
url_enc_byte b =
  if url_is_unreserved b then char_from_int b
  else cat ["%", url_hex_digit (b / 16), url_hex_digit (b % 16)]

-- pct_encode: percent-encode every reserved/unsafe byte of a string.
pct_encode s = pct_encode_acc (chars s) ""

pct_encode_acc cs acc =
  if cs == [] then acc
  else pct_encode_acc (tail cs) (cat [acc, url_enc_byte (char_to_int (head cs))])

-- pct_decode: reverse of pct_encode.  "%HH" -> byte, "+" -> space.
-- A malformed trailing "%" (no two hex digits) is passed through literally.
pct_decode s = pct_decode_acc (chars s) ""

pct_decode_acc cs acc =
  if cs == [] then acc
  else
    let c = head cs
    if c == "+" then pct_decode_acc (tail cs) (cat [acc, " "])
    else if c == "%" then
      let r = tail cs
      if length r >= 2 then
        let hi = url_hex_val (head r)
        let lo = url_hex_val (head (tail r))
        if hi < 0 then pct_decode_acc (tail cs) (cat [acc, c])
        else if lo < 0 then pct_decode_acc (tail cs) (cat [acc, c])
        else pct_decode_acc (tail (tail r)) (cat [acc, char_from_int (hi * 16 + lo)])
      else pct_decode_acc (tail cs) (cat [acc, c])
    else pct_decode_acc (tail cs) (cat [acc, c])

-- ---------------------------------------------------------------------------
-- Query-string parsing
-- ---------------------------------------------------------------------------

-- parse_query_str: "x=1&y=hello%20world" -> [(x,1),(y,hello world)]
-- Each key and value is percent-decoded.  Empty pairs are skipped.
-- (parse_url's helper `parse_query` strips the leading "?"; this works on the
--  raw query body, so callers can compose: parse_query_str (parse_url ...)._5)
parse_query_str q =
  if q == "" then []
  else parse_pairs (str_split "&" q)

parse_pairs parts =
  if parts == [] then []
  else
    let p = head parts
    if p == "" then parse_pairs (tail parts)
    else cons (parse_pair p) (parse_pairs (tail parts))

parse_pair p =
  let cs = chars p
  let (k, rest) = split_at_char "=" cs
  let v = if rest == [] then [] else tail rest
  (pct_decode (from_chars k), pct_decode (from_chars v))
