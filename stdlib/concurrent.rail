-- stdlib/concurrent.rail — v0 concurrency primitive: bounded blocking
-- channels + thread spawn, backed by pthread_mutex + pthread_cond.
--
-- Architecture:
--   Rail talks to a small C bridge dylib (tools/runtime/libconcurrent.dylib)
--   built from tools/runtime/concurrent.c. The bridge owns the pthread state
--   (mutex, condvar, ring buffer) and exposes a tag-safe handle ABI: every
--   public function takes/returns small int handles, never raw pointers,
--   so Rail's int tagging dance through the FFI boundary is transparent.
--
-- Build the bridge once:
--   bash tools/runtime/build_concurrent.sh
--
-- The compiler auto-links libconcurrent.dylib when present (see the
-- `has_concurrent_lib` branch in tools/compile.rail::build).
--
-- v0 carries only int64 values through channels. Strings, floats, ADTs, and
-- closures are deferred to v1 — see the "Deferred" section in the session
-- handoff.
--
-- Quick usage:
--   import "stdlib/concurrent.rail"
--   main =
--     let ch  = rc_chan_make 4              -- bounded channel, capacity 4
--     let _p  = rc_spawn_producer ch 10     -- producer sends 1..10, closes
--     let c   = rc_spawn_consumer ch        -- consumer recvs+sums until close
--     let sum = rc_join c                    -- block until consumer done
--     let _ = print (cat ["sum=", show sum])
--     0
--
-- Naming: the rc_ prefix avoids the keyword collision with Rail's existing
-- single-thread fiber primitives (spawn / chan_send / chan_recv / mutex_* in
-- the compiler), which are unbounded list-based and non-blocking.

-- ── Foreign declarations ─────────────────────────────────────────────────────

-- rcon_chan_make capacity -> int handle (1..256), 0 on failure.
foreign rcon_chan_make capacity -> int

-- rcon_chan_send ch value -> 1 on success, 0 if channel was closed.
-- Blocks while the channel is full and not closed.
foreign rcon_chan_send ch value -> int

-- rcon_chan_recv ch -> int64 value. Blocks while empty and not closed.
-- Returns INT64_MIN (-9223372036854775808) sentinel when closed+empty.
-- NOTE: Rail's tagged-int representation can't carry INT64_MIN losslessly;
-- callers should coordinate via close + a pre-arranged value protocol
-- rather than relying on the sentinel for now.
foreign rcon_chan_recv ch -> int

-- rcon_chan_close ch -> 1 on success, 0 on invalid handle.
-- Wakes all blocked senders/recvers.
foreign rcon_chan_close ch -> int

-- rcon_chan_count ch -> current buffered count (informational only).
foreign rcon_chan_count ch -> int

-- rcon_join task_id -> int64 result (sum for demo consumer; 0 for producer).
-- Blocks until the spawned thread exits, then releases the task slot.
foreign rcon_join task_id -> int

-- Demo helpers — used by tools/runtime/test_concurrent.rail. They exist
-- because Rail does not yet expose a pure-Rail function pointer that can be
-- handed to pthread_create. Once the JIT thunks land for cross-ABI Rail
-- callbacks, these are superseded by a generic rc_spawn taking a Rail fn.
foreign rcon_spawn_producer ch n -> int
foreign rcon_spawn_consumer ch -> int


-- ── High-level Rail wrappers ────────────────────────────────────────────────

-- Create a bounded blocking channel with `capacity` slots.
rc_chan_make capacity = rcon_chan_make capacity

-- Send a value; blocks if the channel is full. Returns 1 ok / 0 closed.
rc_chan_send ch value = rcon_chan_send ch value

-- Receive a value; blocks if the channel is empty.
rc_chan_recv ch = rcon_chan_recv ch

-- Close a channel; wakes all blocked threads.
rc_chan_close ch = rcon_chan_close ch

-- Current buffered count.
rc_chan_count ch = rcon_chan_count ch

-- Spawn a demo producer that sends 1..n then closes the channel. Returns
-- a task handle for rc_join.
rc_spawn_producer ch n = rcon_spawn_producer ch n

-- Spawn a demo consumer that drains the channel, summing recvd values.
-- The sum is returned by rc_join.
rc_spawn_consumer ch = rcon_spawn_consumer ch

-- Join a task handle; blocks until the thread exits. Returns the int64
-- result the worker stored on exit.
rc_join task_id = rcon_join task_id
