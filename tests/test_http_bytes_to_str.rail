-- Test: http_client.rail bytes_to_str — correctness vs a simple reference, plus
-- a 20k-byte build (exercises the O(n) path; the old O(n^2) version would crawl).
-- Convention: prints "PASS" as the last line and exits 0 iff all cases hold.
import "stdlib/http_client.rail"

-- simple, obviously-correct reference (small n only)
ref buf off n acc =
  if n <= 0 then acc
  else ref buf (off + 1) (n - 1) (join "" [acc, char_from_int (byte_at buf off)])

-- byte i = (i mod 255) + 1  -> 1..255, never NUL (keeps length exact)
fill buf i n =
  if i >= n then 0
  else let _ = byte_set buf i ((i - ((i / 255) * 255)) + 1) in fill buf (i + 1) n

report name ok = if ok then 0 else let _ = print (join "" ["FAIL: ", name]) in 1
eq buf off n acc = bytes_to_str buf off n acc == ref buf off n acc

main =
  let sz = 40 in
  let buf = arr_new sz 0 in
  let _ = fill buf 0 sz in
  let f1 = report "full buffer"     (eq buf 0 sz "") in
  let f2 = report "with acc prefix" (eq buf 0 sz "P:") in
  let f3 = report "offset slice"    (eq buf 7 20 "") in
  let f4 = report "offset + acc"    (eq buf 13 15 "x") in
  let f5 = report "n=0 keeps acc"   (eq buf 5 0 "keep") in
  let big = arr_new 20000 0 in
  let _ = fill big 0 20000 in
  let f6 = report "20k exact length" (length (bytes_to_str big 0 20000 "") == 20000) in
  let fails = f1 + f2 + f3 + f4 + f5 + f6 in
  if fails == 0 then let _ = print "PASS" in 0
  else let _ = print (join "" ["FAILURES: ", show fails]) in 1
