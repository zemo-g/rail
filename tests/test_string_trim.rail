-- Test: stdlib/string.rail str_trim / str_ltrim / str_rtrim.
-- Convention: prints "PASS" as the last line and exits 0 iff all cases hold.
-- Imports string.rail ALONE — also guards that the module stays self-contained.
import "stdlib/string.rail"

ws_tab = char_from_int 9
ws_nl  = char_from_int 10
ws_cr  = char_from_int 13

report name ok = if ok then 0 else let _ = print (join "" ["FAIL: ", name]) in 1

main =
  let f1 = report "trim both sides"     (str_trim "  hi  " == "hi") in
  let f2 = report "trim mixed ws"       (str_trim (join "" [ws_tab, "hi", ws_nl]) == "hi") in
  let f3 = report "trim empty"          (str_trim "" == "") in
  let f4 = report "trim all-whitespace" (str_trim "   " == "") in
  let f5 = report "trim no-op"          (str_trim "x" == "x") in
  let f6 = report "trim keeps inner ws" (str_trim "a b" == "a b") in
  let f7 = report "trim crlf wrapped"   (str_trim (join "" [ws_cr, ws_nl, " hi ", ws_cr, ws_nl]) == "hi") in
  let f8 = report "ltrim leading only"  (str_ltrim "  x  " == "x  ") in
  let f9 = report "rtrim trailing only" (str_rtrim "  x  " == "  x") in
  let fails = f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 in
  if fails == 0 then let _ = print "PASS" in 0
  else let _ = print (join "" ["FAILURES: ", show fails]) in 1
