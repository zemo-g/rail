-- tools/robot/mirror_wave.rail
--
-- Greet the user. Lift the gripper up and forward (toward them) and
-- oscillate left-right symmetrically around DSL x=0 -- the patched
-- coord_map (e8eed26) puts DSL +x on the user's right, so the wave
-- now looks like a wave from the user's vantage rather than a
-- one-sided sweep.
--
-- Run:
--   ./rail_native run tools/robot/mirror_wave.rail
--
-- DSL frame (cm): x right, y forward (toward user), z up.

import "tools/robot/arm_real.rail"

-- Symmetric arc at "shoulder height" (17 cm up, 16 cm forward), with
-- the lateral sweep at +-12 cm. sqrt(12^2 + 16^2) = 20 cm radial,
-- well inside the 29 cm reach circle. z=17 cm < 18.7 cm ceiling.
wave_script = [
  Home,
  MoveTo  0 16 17,
  MoveTo 12 16 17,
  MoveTo (0 - 12) 16 17,
  MoveTo 12 16 17,
  MoveTo (0 - 12) 16 17,
  MoveTo 12 16 17,
  MoveTo  0 16 17,
  Home
]

default_path = "/dev/cu.usbserial-110"

main =
  let path = default_path
  let _ = print (cat ["[mirror_wave] opening ", path])
  let fd = arm_open path
  if fd < 0 then
    let _ = print (cat ["[mirror_wave] open failed fd=", show fd])
    1
  else
    let _ = print "[mirror_wave] greeting -- centered, symmetric, three swings each side"
    let _ = print_cmds wave_script
    let st = arm_run_script fd wave_script 0 0 0
    let _ = print_sim st
    let _ = arm_close fd
    let _ = print "[mirror_wave] hi"
    0
