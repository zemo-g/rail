-- tools/robot/arm_sim_smoke.rail
-- Smoke harness for tools/robot/arm_sim.rail. The sim itself is a
-- library (no main) so the grader can import it without symbol
-- collisions on `_main`. Run this file instead of arm_sim.rail when
-- you want to exercise the six fixture scenarios.

import "tools/robot/arm_sim.rail"

main =
  let s1 = run_sim [Home]
  let _ = print "s1 home:"
  let _ = print_sim s1

  let s2 = run_sim [MoveTo 10 0 5, MoveTo 10 10 5]
  let _ = print "s2 move A then B:"
  let _ = print_sim s2

  let s3 = run_sim_with_world [MoveTo 10 0 5, SetGrip GripClose, MoveTo 10 10 5, SetGrip GripOpen] 10 0 5
  let _ = print "s3 pick ball at A, place at B:"
  let _ = print_sim s3
  let _ = print (cat ["s3 goal_reached(10,10,5,open,empty,ball_at_B): ",
                       show (goal_reached s3 10 10 5 0 0)])

  let s4 = run_sim [MoveTo 99 99 99]
  let _ = print "s4 out-of-bounds:"
  let _ = print_sim s4

  let s5 = run_sim_with_world [MoveTo 10 0 5, SetGrip GripClose, SetGrip GripClose] 10 0 5
  let _ = print "s5 double-close fault:"
  let _ = print_sim s5

  let s6 = run_sim_with_world [SetGrip GripClose] 10 0 5
  let _ = print "s6 close but effector not at ball:"
  let _ = print_sim s6
  0
