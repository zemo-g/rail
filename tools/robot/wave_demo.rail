-- tools/robot/wave_demo.rail
--
-- End-to-end Rail demo of the REPL-mode MaxArm driver. Opens the
-- serial port, runs a wave script through arm_run_script (which is
-- exactly what talk_arm.sh wires to the substrate), prints the final
-- state, closes (sending teaching_mode on the way out).
--
-- Run:
--   ./rail_native run tools/robot/wave_demo.rail [/dev/cu.usbserial-110]

import "tools/robot/arm_real.rail"

-- DSL coordinates: each axis in cm, 0..30. The arm's reach envelope is
-- 290mm radius x 187mm up. Sweep at z=15 cm (150 mm up, well below
-- the 187 mm ceiling) between (8, 15, 15) and (22, 15, 15) -- both
-- ~16 cm forward from base, well inside reach radius.

wave_script = [
  Home,
  MoveTo 8  15 15,
  MoveTo 22 15 15,
  MoveTo 8  15 15,
  MoveTo 22 15 15,
  MoveTo 8  15 15,
  MoveTo 22 15 15,
  Home
]

default_path = "/dev/cu.usbserial-110"

main =
  let path = default_path
  let _ = print (cat ["[wave_demo] opening ", path])
  let fd = arm_open path
  if fd < 0 then
    let _ = print (cat ["[wave_demo] open failed fd=", show fd])
    1
  else
    let _ = print (cat ["[wave_demo] connected fd=", show fd, "; running wave script"])
    let _ = print_cmds wave_script
    let st = arm_run_script fd wave_script 0 0 0
    let _ = print_sim st
    let _ = arm_close fd
    let _ = print "[wave_demo] done -- servos relaxed"
    0
