-- tools/robot/calibrate.rail
--
-- One-time interactive calibration for the MaxArm. The user moves
-- the arm to each named DSL point physically (by hand, with motors
-- disengaged or via SET_XYZ tweaks) and asks us to record where the
-- firmware thinks the end-effector is right now. The difference
-- between the expected mm and the read-back mm is the per-axis
-- offset persisted to ~/.robot/maxarm_calib.txt.
--
-- File format (~/.robot/maxarm_calib.txt):
--   cx=<int>      -- x offset (mm)
--   cy=<int>      -- y offset (mm)
--   cz=<int>      -- z offset (mm)
--   recorded_at=<unix_epoch>
--   note=...      -- free-form
--
-- Workflow:
--   bash tools/robot/calibrate.sh
--
-- The .sh wrapper sets up stdin/stdout for interactive prompts and
-- spawns this binary once per named point. The Rail program itself
-- is invoked with arguments:
--   --device <path>  the serial device path
--   --point A|B|C|D|ORIGIN  which DSL point to calibrate
--   --record         write the offset to disk
--   --read           just print current read-back XYZ and exit
--
-- For v0 we keep this simple: read XYZ, compute offset against the
-- expected DSL coord, print one line.

import "tools/robot/arm_real.rail"

calib_file = "~/.robot/maxarm_calib.txt"

-- Named-point DSL coords; mirrors stdlib/robot_arm.rail::point_named
-- but we duplicate here because Rail's match-on-string isn't a
-- pattern.
expected_for name =
  if name == "A" then [10, 0, 5]
  else if name == "B" then [10, 10, 5]
  else if name == "C" then [20, 10, 5]
  else if name == "D" then [20, 20, 5]
  else if name == "ORIGIN" then [0, 0, 0]
  else []

find_opt av flag =
  if length av == 0 then ""
  else if (head av) == flag then
    if length (tail av) == 0 then ""
    else head (tail av)
  else find_opt (tail av) flag

find_flag av flag =
  if length av == 0 then false
  else if (head av) == flag then true
  else find_flag (tail av) flag

read_and_print path =
  let fd = arm_open path
  if fd < 0 then
    let _ = print "[calibrate] open failed"
    1
  else
    let r = read_arm_xyz fd
    let ok = head r
    if ok == 0 then
      let _ = arm_close fd
      let _ = print "[calibrate] no response from arm"
      1
    else
      let x = head (tail r)
      let y = head (tail (tail r))
      let z = head (tail (tail (tail r)))
      let _ = print (cat ["READ_XYZ ", show x, " ", show y, " ", show z])
      let _ = arm_close fd
      0

calibrate_point path name do_record =
  let exp = expected_for name
  if length exp == 0 then
    let _ = print (cat ["[calibrate] unknown point name '", name, "'"])
    1
  else
    let exp_x_mm = (head exp) * 10
    let exp_y_mm = (head (tail exp)) * 10
    let exp_z_mm = (head (tail (tail exp))) * 10
    let fd = arm_open path
    if fd < 0 then
      let _ = print "[calibrate] open failed"
      1
    else
      let r = read_arm_xyz fd
      let ok = head r
      let _ = arm_close fd
      if ok == 0 then
        let _ = print "[calibrate] no response from arm"
        1
      else
        let mx = head (tail r)
        let my = head (tail (tail r))
        let mz = head (tail (tail (tail r)))
        let cx = exp_x_mm - mx
        let cy = exp_y_mm - my
        let cz = exp_z_mm - mz
        let _ = print (cat [
          "CALIB_OFFSET point=", name,
          " expected_mm=(", show exp_x_mm, ",", show exp_y_mm, ",", show exp_z_mm, ")",
          " actual_mm=(", show mx, ",", show my, ",", show mz, ")",
          " offset_mm=(", show cx, ",", show cy, ",", show cz, ")"
        ])
        if do_record then
          let _ = shell "mkdir -p ~/.robot"
          let content = cat [
            "cx=", show cx, "\n",
            "cy=", show cy, "\n",
            "cz=", show cz, "\n",
            "anchor_point=", name, "\n"
          ]
          let _ = write_file "/tmp/maxarm_calib.txt" content
          let _ = shell "cp /tmp/maxarm_calib.txt ~/.robot/maxarm_calib.txt"
          let _ = print (cat ["[calibrate] saved offsets to ", calib_file])
          0
        else 0

main =
  let av = args
  let path = find_opt av "--device"
  let name = find_opt av "--point"
  let do_record = find_flag av "--record"
  let do_read = find_flag av "--read"
  if length path == 0 then
    let _ = print "usage: ./rail_native run tools/robot/calibrate.rail --device <path> [--read | --point <A|B|C|D|ORIGIN> [--record]]"
    1
  else if do_read then read_and_print path
  else if length name == 0 then
    let _ = print "[calibrate] need --point <name> or --read"
    1
  else calibrate_point path name do_record
