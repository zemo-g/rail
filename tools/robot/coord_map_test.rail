-- tools/robot/coord_map_test.rail
--
-- Test harness for the IK round-trip unit tests defined in
-- tools/robot/coord_map.rail. Twelve test cases:
--   1-5: named-point round-trips
--   6-8: edge of reach
--   9-10: with non-zero calibration offsets
--   11-12: out-of-reach (must report fault=1)
--
-- Run:
--   ./rail_native run tools/robot/coord_map_test.rail
--
-- Output target: 12/12 PASS, last line "PASS". Exit 0 on PASS,
-- nonzero on FAIL.

import "tools/robot/coord_map.rail"

main = run_all_tests 0
