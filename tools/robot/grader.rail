-- tools/robot/grader.rail
--
-- 4-stage grader for the robot-arm flywheel. Given a bench id and a
-- candidate completion file (Rail code defining `script :: [Cmd]`),
-- wraps the candidate in a template, compiles, runs, and grades.
--
-- Designed to be NEW grader code, not a wrapper around the
-- known-broken tools/train/grade_stage.rail (see memory entry
-- a1_grader_bug_2026-05-08). Discipline carried over:
--   - Clear /tmp/rail_out before every compile (stale-binary defense).
--   - rail_native exit code is honest (post-2026-05-02 fix), so we
--     trust its exit status as the compile-stage signal.
--   - Sim writes a single SIM_RESULT line in a fixed format; the
--     grader parses that line, never the previous binary's stdout.
--
-- Usage:
--   ./rail_native run tools/robot/grader.rail <bench_id> <completion_file>
--
-- Output (single line, pipe-separated):
--   GRADE id=<id> stage=<0..4> goal_reach=<0|1> fault=<int> sim_line=<...>

import "stdlib/list.rail"
import "stdlib/args.rail"

bench_file = "tools/robot/bench_v0.txt"
candidate_path = "/tmp/robot_candidate.rail"
out_bin = "/tmp/rail_out"
sim_out = "/tmp/robot_sim_out.txt"

-- ---------------------------------------------------------------------
-- Bench row lookup.
-- ---------------------------------------------------------------------

is_comment_or_blank ln =
  if length ln == 0 then true
  else if (head (chars ln)) == "#" then true
  else false

find_row_in_lines id lines =
  if length lines == 0 then []
  else
    let ln = head lines
    if is_comment_or_blank ln then find_row_in_lines id (tail lines)
    else
      let parts = str_split "|" ln
      if length parts < 13 then find_row_in_lines id (tail lines)
      else if (head parts) == id then parts
      else find_row_in_lines id (tail lines)

load_bench_row id =
  let body = read_file bench_file
  let lines = split (char_from_int 10) body
  find_row_in_lines id lines

-- ---------------------------------------------------------------------
-- Decimal int parser (do not use to_int — it's float->int only and
-- silently returns 0 on strings per memory entry rail_emit_gotchas).
-- ---------------------------------------------------------------------

digit_val ch =
  if ch == "0" then 0
  else if ch == "1" then 1
  else if ch == "2" then 2
  else if ch == "3" then 3
  else if ch == "4" then 4
  else if ch == "5" then 5
  else if ch == "6" then 6
  else if ch == "7" then 7
  else if ch == "8" then 8
  else if ch == "9" then 9
  else 0 - 1

parse_int_chars cs neg acc =
  if length cs == 0 then (if neg then 0 - acc else acc)
  else
    let c = head cs
    if c == "-" then parse_int_chars (tail cs) true acc
    else
      let dv = digit_val c
      if dv < 0 then (if neg then 0 - acc else acc)
      else parse_int_chars (tail cs) neg (acc * 10 + dv)

pi s = parse_int_chars (chars s) false 0

-- ---------------------------------------------------------------------
-- Strip optional markdown code fences from LLM output.
-- ---------------------------------------------------------------------

strip_fences s =
  let open_i = str_find "```" s
  if open_i < 0 then s
  else
    let after_open = str_sub s (open_i + 3) (length s - open_i - 3)
    let nl_i = str_find (char_from_int 10) after_open
    let body_start = if nl_i < 0 then 0 else nl_i + 1
    let body = str_sub after_open body_start (length after_open - body_start)
    let close_i = str_find "```" body
    if close_i < 0 then body
    else str_sub body 0 close_i

-- ---------------------------------------------------------------------
-- Wrap LLM candidate in a runnable program.
-- ---------------------------------------------------------------------

-- Rail's parser tokenises `f -1` as `f - 1` (subtraction) rather than
-- `f (-1)`. Wrap negative literals in parens.
int_arg n =
  if n < 0 then cat ["(0 - ", show (0 - n), ")"]
  else show n

build_program candidate obx oby obz =
  -- arm_sim.rail transitively imports stdlib/robot_arm.rail, so the
  -- candidate can use both DSL constructors AND sim entry points.
  -- Importing both directly would duplicate-define every robot_arm
  -- function.
  join "" [
    "import \"tools/robot/arm_sim.rail\"\n",
    "\n",
    "-- BEGIN LLM CANDIDATE --\n",
    candidate,
    "\n-- END LLM CANDIDATE --\n",
    "\n",
    "main = print_sim (run_sim_with_world script ", int_arg obx, " ", int_arg oby, " ", int_arg obz, ")\n"
  ]

-- ---------------------------------------------------------------------
-- Parse SIM_RESULT line fields.
-- ---------------------------------------------------------------------

field_int line key =
  let marker = join "" [key, "="]
  let i = str_find marker line
  if i < 0 then 0
  else
    let after = str_sub line (i + length marker) (length line - i - length marker)
    let sp = str_find " " after
    let valstr = if sp < 0 then after else str_sub after 0 sp
    pi valstr

pick_sim_line lines =
  if length lines == 0 then ""
  else
    let ln = head lines
    let i = str_find "SIM_RESULT" ln
    if i >= 0 then ln
    else pick_sim_line (tail lines)

extract_sim_line text =
  let lines = split (char_from_int 10) text
  pick_sim_line lines

-- ---------------------------------------------------------------------
-- Main.
-- ---------------------------------------------------------------------

main =
  let argv = args
  let parsed = parse_args argv
  let (_flags, _opts, pos) = parsed
  if length pos < 2 then
    let _ = print "usage: grader.rail <bench_id> <completion_file>"
    1
  else
    let bench_id = head pos
    let comp_path = head (tail pos)

    let row = load_bench_row bench_id
    if length row == 0 then
      let _ = print (cat ["GRADE id=", bench_id, " stage=0 goal_reach=0 fault=-1 sim_line=bench_id_not_found"])
      1
    else
      let obx = pi (head (tail (tail row)))
      let oby = pi (head (tail (tail (tail row))))
      let obz = pi (head (tail (tail (tail (tail row)))))
      let gex = pi (head (tail (tail (tail (tail (tail row))))))
      let gey = pi (head (tail (tail (tail (tail (tail (tail row)))))))
      let gez = pi (head (tail (tail (tail (tail (tail (tail (tail row))))))))
      let ggrip = pi (head (tail (tail (tail (tail (tail (tail (tail (tail row)))))))))
      let gheld = pi (head (tail (tail (tail (tail (tail (tail (tail (tail (tail row))))))))))
      let gbx = pi (head (tail (tail (tail (tail (tail (tail (tail (tail (tail (tail row)))))))))))
      let gby = pi (head (tail (tail (tail (tail (tail (tail (tail (tail (tail (tail (tail row))))))))))))
      let gbz = pi (head (tail (tail (tail (tail (tail (tail (tail (tail (tail (tail (tail (tail row)))))))))))))

      let raw = read_file comp_path
      let candidate = strip_fences raw
      let prog = build_program candidate obx oby obz
      let _ = write_file candidate_path prog

      -- Clear stale outputs BEFORE compile (a1_grader_bug discipline).
      let _ = shell "rm -f /tmp/rail_out /tmp/robot_sim_out.txt /tmp/robot_compile_log.txt"

      let _ = shell (cat ["./rail_native ", candidate_path, " >/tmp/robot_compile_log.txt 2>&1"])

      let rail_out_check = shell "test -x /tmp/rail_out && echo OK || echo MISS"
      let stage1_ok = if (str_find "OK" rail_out_check) >= 0 then 1 else 0

      if stage1_ok == 0 then
        let _ = print (cat ["GRADE id=", bench_id, " stage=0 goal_reach=0 fault=-2 sim_line=compile_failed"])
        0
      else
        let _ = shell (cat ["/tmp/rail_out >", sim_out, " 2>&1"])
        let run_out = read_file sim_out
        let sim_line = extract_sim_line run_out

        if length sim_line == 0 then
          let _ = print (cat ["GRADE id=", bench_id, " stage=1 goal_reach=0 fault=-3 sim_line=no_sim_result"])
          0
        else
          let fault = field_int sim_line "fault"
          let actual_ex = field_int sim_line "ex"
          let actual_ey = field_int sim_line "ey"
          let actual_ez = field_int sim_line "ez"
          let actual_grip = field_int sim_line "grip"
          let actual_held = field_int sim_line "held"
          let actual_obx = field_int sim_line "obx"
          let actual_oby = field_int sim_line "oby"
          let actual_obz = field_int sim_line "obz"
          let actual_present = field_int sim_line "present"

          let stage3_ok = if fault == 0 then 1 else 0
          let pos_ok = if actual_ex == gex then if actual_ey == gey then if actual_ez == gez then 1 else 0 else 0 else 0
          let grip_ok = if actual_grip == ggrip then 1 else 0
          let held_ok = if actual_held == gheld then 1 else 0
          -- Ball-position check: only applies when an object exists at start.
          -- Required to land at (gbx,gby,gbz) AND still be present in world.
          -- Closes the "fallback contamination" hole where a no-op script
          -- passed prompts whose expected arm-state matched home but the
          -- ball was supposed to move. See [[bench_v0_fallback_contamination]].
          let ball_ok = if obx < 0 then 1
                        else if actual_present == 0 then 0
                        else if actual_obx == gbx then if actual_oby == gby then if actual_obz == gbz then 1 else 0 else 0 else 0

          let stage4_ok = if stage3_ok == 1 then if pos_ok == 1 then if grip_ok == 1 then if held_ok == 1 then if ball_ok == 1 then 1 else 0 else 0 else 0 else 0 else 0

          let stage = if stage4_ok == 1 then 4 else if stage3_ok == 1 then 3 else 2
          let goal_reach = stage4_ok

          let _ = print (cat ["GRADE id=", bench_id, " stage=", show stage, " goal_reach=", show goal_reach, " fault=", show fault, " sim_line=", sim_line])
          0
