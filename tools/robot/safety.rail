-- tools/robot/safety.rail
--
-- Safety primitives for the physical-arm driver: workspace clip,
-- velocity cap, e-stop, vacuum auto-off. Pure Rail, no FFI of its
-- own; callers thread state via simple int values.
--
-- Per memory entry feedback_verify_removals: before removing any
-- safety check, write the falsifying smoke test FIRST. See
-- tools/robot/arm_real_smoke.rail for the safety-check coverage.

-- NOTE: depends on identifiers exported by
-- tools/robot/coord_map.rail (reach_radius_mm, reach_up_mm,
-- reach_down_mm, reach_slop_mm, abs_i). The importing file MUST
-- import coord_map.rail BEFORE this file. Rail does not dedup
-- imports, so importing it here would produce duplicate-symbol
-- link errors when arm_real.rail imports both.

-- ---------------------------------------------------------------------
-- Workspace clip.
--
-- Given an arm-frame (mm) coordinate, return (clipped_x, clipped_y,
-- clipped_z, was_clipped). If the point is inside the reachable
-- envelope, return it unchanged with was_clipped=0. Otherwise,
-- bring it back to the boundary (Z first, then horizontal radius).
-- ---------------------------------------------------------------------

-- abs_i is already provided by stdlib/robot_arm.rail (via importer)
sgn_i n = if n > 0 then 1 else if n < 0 then 0 - 1 else 0

-- Clip Z to [reach_down_mm, reach_up_mm]. Returns clipped Z.
clip_z z =
  if z > reach_up_mm then reach_up_mm
  else if z < reach_down_mm then reach_down_mm
  else z

-- Clip the (x, y) projection so that x^2 + y^2 <= r_eff^2.
-- If already inside, return unchanged. Otherwise scale down by the
-- ratio r_eff / r_actual. We do the scaling in integer arithmetic
-- using the squared comparison, then a single integer divide.
--
-- Approximation: we use Newton iteration on integers to approximate
-- sqrt without a foreign call. For our use (>= 5 mm away from origin
-- in practical workspaces), 3 Newton iterations from an initial
-- estimate of (|x| + |y|) is well within +/- 1 mm.

isqrt_loop x guess iters =
  if iters == 0 then guess
  else if guess == 0 then 0
  else
    let new_guess = (guess + x / guess) / 2
    isqrt_loop x new_guess (iters - 1)

isqrt x =
  if x <= 0 then 0
  else
    let g0 = if x < 4 then 1 else x / 2
    isqrt_loop x g0 8

-- Returns [cx, cy] -- the clipped horizontal pair.
clip_horiz x y =
  let r_eff = reach_radius_mm - reach_slop_mm
  let r2 = x * x + y * y
  if r2 <= r_eff * r_eff then [x, y]
  else
    let r_actual = isqrt r2
    -- Scale: (x * r_eff / r_actual, y * r_eff / r_actual)
    if r_actual <= 0 then [0, 0]
    else [x * r_eff / r_actual, y * r_eff / r_actual]

-- Returns [clipped_x, clipped_y, clipped_z, was_clipped]
clip_to_workspace_mm x y z =
  let z2 = clip_z z
  let h = clip_horiz x y
  let cx = head h
  let cy = head (tail h)
  let was_clipped = if cx == x then (if cy == y then (if z2 == z then 0 else 1) else 1) else 1
  [cx, cy, z2, was_clipped]

-- ---------------------------------------------------------------------
-- Velocity cap.
--
-- Move duration must be at least min_move_ms. For move distance >
-- max_quick_mm, additionally scale duration up so the effective speed
-- never exceeds max_speed_mm_per_ms (currently 0.5 mm/ms = 500 mm/s,
-- which is well under the arm's max servo speed of ~600 mm/s).
-- ---------------------------------------------------------------------

min_move_ms = 500
max_quick_mm = 100         -- moves >= 100 mm get extra duration
max_speed_mm_per_s = 500
-- Integer-only "max speed per ms":  we ensure duration_ms >= dist_mm * 1000 / max_speed_mm_per_s
-- == duration_ms >= dist_mm * 2  (for 500 mm/s).

-- Given a requested duration_ms and a distance_mm, return the
-- safety-capped duration_ms.
cap_duration_ms requested_ms distance_mm =
  let speed_floor = distance_mm * 1000 / max_speed_mm_per_s
  let need = if speed_floor > min_move_ms then speed_floor else min_move_ms
  if requested_ms < need then need else requested_ms

-- Compute distance between two arm-frame mm coords (Manhattan, since
-- the velocity cap is conservative -- exact L2 distance is not needed).
manhattan_mm x1 y1 z1 x2 y2 z2 =
  let dx = abs_i (x2 - x1)
  let dy = abs_i (y2 - y1)
  let dz = abs_i (z2 - z1)
  dx + dy + dz

-- ---------------------------------------------------------------------
-- E-stop state machine.
--
-- A simple integer-tracked fault counter. After `estop_fault_threshold`
-- consecutive faults, the driver should halt and refuse further
-- commands until a `/resume` operation clears it.
-- ---------------------------------------------------------------------

estop_fault_threshold = 2

-- Update fault counter. If incoming fault is 0, reset to 0. Otherwise
-- increment.
estop_update prev_count this_fault =
  if this_fault == 0 then 0
  else prev_count + 1

estop_tripped count = if count >= estop_fault_threshold then 1 else 0

-- ---------------------------------------------------------------------
-- Vacuum auto-off.
--
-- If the grip has been closed for more than vacuum_auto_off_s seconds
-- AND held=0 (vacuum on with nothing held), the suction is leaking;
-- auto-release to save the motor.
-- ---------------------------------------------------------------------

vacuum_auto_off_s = 30

-- Given (grip_closed_at_s, now_s, held), returns 1 if we should
-- auto-release. grip_closed_at_s = 0 sentinel for "not currently
-- closed".
should_auto_release grip_closed_at_s now_s held =
  if grip_closed_at_s == 0 then 0
  else if held == 1 then 0
  else if (now_s - grip_closed_at_s) >= vacuum_auto_off_s then 1
  else 0
