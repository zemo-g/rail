-- tok_prompt_check.rail — verify tok2.rail reproduces the HF ground-truth ids
-- for the Path-B parity prompt "The capital of France is".
-- HF ground truth (transformers 5.5.0, SmolLM2-135M base, add_special_tokens):
--   encode("The capital of France is") == [504, 3575, 282, 4649, 314]  (no BOS)
--
-- Build: cd /Users/ledaticempire/projects/rail-https && \
--        ./rail_native tools/railml/pathb/tok_prompt_check.rail
-- Run:   RAIL_ARENA_MB=4096 /tmp/rail_out
import "tools/railml/pathb/tok2_lib.rail"

tpc_show ids =
  if ids == [] then ""
  else cat [show (head ids), " ", tpc_show (tail ids)]

main =
  let path = "/Users/ledaticempire/projects/rail-https/tools/railml/pathb/smollm2_tokenizer.json" in
  let blen = t2_file_len path in
  let tok = t2_load2 path blen 60000 in
  let prompt = "The capital of France is" in
  let ids = t2_encode tok prompt in
  let _ = print (cat ["prompt   : ", prompt]) in
  let _ = print (cat ["rail ids : [", tpc_show ids, "]"]) in
  let _ = print "HF  ids  : [504 3575 282 4649 314 ]" in
  let exp = [504, 3575, 282, 4649, 314] in
  let ok = t2_ids_eq ids exp in
  let _ = print (cat ["match    : ", if ok == 1 then "PASS" else "FAIL"]) in
  -- also confirm detok round-trips to the original surface text
  let back = t2_detokenize tok ids in
  let _ = print (cat ["detok    : '", back, "'"]) in
  if ok == 1 then 0 else 1
