-- probe: can read_file_bytes hold the whole 269MB SmolLM2 blob?
import "stdlib/file.rail"
pq_blob _ = "/Users/ledaticempire/.cache/huggingface/hub/models--HuggingFaceTB--SmolLM2-135M/blobs/80521b40281d6ce74e35c9282c22539e75aa0ac8578892b2a59955ef78d55da1"
main =
  let path = pq_blob 0 in
  let sz = read_file_size path in
  let _ = print (cat ["filesize=", show sz]) in
  let buf = read_file_bytes path in
  -- probe known bytes. base = 8 + 30528 = 30536. embed elem 0 is BF16 of row0,col0.
  -- header byte 0 should be 0x40 = 64 (low byte of 30528 = 0x7740 -> 0x40=64, 0x77=119)
  let b0 = byte_at buf 0 in
  let b1 = byte_at buf 1 in
  -- probe a byte near the END of the file to prove the whole buffer is live
  let lastoff = sz - 1 in
  let blast = byte_at buf lastoff in
  -- probe a byte deep in (model.norm.weight starts at base+269028864)
  let deepoff = 30536 + 269028864 in
  let bdeep = byte_at buf deepoff in
  let bdeep1 = byte_at buf (deepoff + 1) in
  let _ = print (cat ["hdr b0=", show b0, " b1=", show b1, " (expect 64,119)"]) in
  let _ = print (cat ["last byte off=", show lastoff, " val=", show blast]) in
  let _ = print (cat ["model.norm first BF16 bytes off=", show deepoff, " lo=", show bdeep, " hi=", show bdeep1]) in
  0
