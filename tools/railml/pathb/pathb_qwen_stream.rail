-- pathb_qwen_stream.rail -- STREAMING Qwen3-0.6B generation (the scale proof of the foundation).
--
-- pathb_qwen.rail cached all 28 layers (~4.8 GB anon) and thrashed for 30+ min under macOS memory
-- compression. This streams instead: mmap the blob (file-backed) + decode each layer transiently
-- (arena_mark/reset) so only ONE layer (~150 MB) is resident. Anon working set ~= embedding (1.24 GB)
-- + 1 layer + activations -- well under the pressure threshold -> NO thrash, and it scales past RAM.
--
-- Build: ./rail_native tools/railml/pathb/pathb_qwen_stream.rail
-- Run:   RAIL_ARENA_MB=4096 /tmp/rail_out
--
-- RESULT (2026-06-19): the MEMORY goal is met -- RSS holds ~1.7 GB (embedding + 1 streamed layer),
-- NO thrash (vs pathb_qwen.rail's 6 GB anon -> 30-min compression thrash), free RAM throughout. The
-- foundation bounds memory at one layer regardless of depth. BUT a 2nd-order cost surfaced: mmap
-- byte_at DECODE slows sharply at the 1.5 GB mapping size (TLB / page-table-walk pressure -- a 1.5 GB
-- map with 16 KB pages overruns the TLB; SmolLM2's 269 MB map stays in reach, which is why
-- pathb_stream is fast). So a full g[0] here is correct but slow. CORRECTNESS of the Qwen port (QK-
-- norm + non-square head_dim) is independently established by qwen_verify.rail (HF-matched to ~0.1%
-- across 3 layers); this file shares that exact code path + the bit-exact pathb_stream structure.
-- SPEED fix is orthogonal to the memory foundation: decode a per-layer SLICE into a malloc'd buffer
-- (fast byte_at) instead of decoding straight off the big mmap, or huge-page the map, or compact-
-- int32-cache when the model fits. Target g[0] = 12095 (' Paris', HF greedy parity).

import "tools/railml/pathb/pathb_lib.rail"
import "stdlib/mmap.rail"
import "stdlib/env.rail"

qs_d _ = 1024
qs_nh _ = 16
qs_nkv _ = 8
qs_hd _ = 128
qs_inter _ = 3072
qs_vocab _ = 151936
qs_nlayers _ = 28
qs_eps _ = 17
qs_lnb _ = 231785805
qs_maxgen _ = 1

qs_blob _ = let e = getenv "QWEN3_BLOB" in if e == "" then cat [getenv "HOME", "/.cache/huggingface/hub/models--Qwen--Qwen3-0.6B/snapshots/c1899de289a04d12100db370d81485cdf75e47ca/model.safetensors"] else e

-- single-token KV-cache helpers
qs_qkv xrow xn Wq Wk Wv Q K V d qdim kvdim gamma eps acc =
  let rms = pf_rms xrow 0 d eps in
  let _ = pf_normapply xrow 0 xn gamma d rms 0 in
  let _ = pf_proj Wq xn 0 d Q 0 qdim acc 0 in
  let _ = pf_proj Wk xn 0 d K 0 kvdim acc 0 in
  let _ = pf_proj Wv xn 0 d V 0 kvdim acc 0 in
  0
qs_rope_one src out nheads hd pos lnb h =
  if h >= nheads then out else let b = h * hd in let _ = pf_rope src b out b hd pos lnb 0 in qs_rope_one src out nheads hd pos lnb (h + 1)
qs_store src cache cbase kvdim i =
  if i >= kvdim then 0 else let _ = arr_set cache (cbase + i) (arr_get src i) in qs_store src cache cbase kvdim (i + 1)
qs_scores Qr qhb Kcache kbaseL kvdim hd scaleq npos S acc j =
  if j >= npos then 0
  else
    let _ = arr_set acc 0 0 in
    let _ = arr_set acc 1 0 in
    let _ = pf_adot Qr qhb Kcache (kbaseL + j * kvdim) hd acc 0 in
    let raw = pf_rescale (arr_get acc 0) (arr_get acc 1) in
    let _ = arr_set S j ((raw * scaleq) / 16777216) in
    qs_scores Qr qhb Kcache kbaseL kvdim hd scaleq npos S acc (j + 1)
qs_ctx P Vcache vbaseL kvdim attn ab hd npos col acc =
  if col >= hd then 0
  else
    let _ = arr_set acc 0 0 in
    let _ = arr_set acc 1 0 in
    let _ = pf_pvdot P 0 Vcache (vbaseL + col) kvdim npos acc 0 in
    let _ = arr_set attn (ab + col) (pf_rescale (arr_get acc 0) (arr_get acc 1)) in
    qs_ctx P Vcache vbaseL kvdim attn ab hd npos (col + 1)
qs_head Qr Kcache Vcache layerbase attn S E P kvdim hd scaleq group npos h acc =
  let kv = h / group in
  let qhb = h * hd in
  let hb = layerbase + kv * hd in
  let _ = qs_scores Qr qhb Kcache hb kvdim hd scaleq npos S acc 0 in
  let _ = pf_softmax_i S E P 0 npos in
  qs_ctx P Vcache hb kvdim attn (h * hd) hd npos 0 acc
qs_heads Qr Kcache Vcache layerbase attn S E P kvdim hd scaleq nh group npos h acc =
  if h >= nh then attn
  else let _ = qs_head Qr Kcache Vcache layerbase attn S E P kvdim hd scaleq group npos h acc in
       qs_heads Qr Kcache Vcache layerbase attn S E P kvdim hd scaleq nh group npos (h + 1) acc

-- QK-norm (Qwen3): in-place per-head RMSNorm over head_dim
qs_qn_apply vec base gamma hd rinv i =
  if i >= hd then 0
  else let _ = arr_set vec (base + i) (mul_shr (mul_shr (arr_get vec (base + i)) rinv 24) (arr_get gamma i) 24) in
       qs_qn_apply vec base gamma hd rinv (i + 1)
qs_qk_norm vec nheads hd gamma eps h =
  if h >= nheads then 0
  else let base = h * hd in let rms = pf_rms vec base hd eps in let _ = qs_qn_apply vec base gamma hd (281474976710656 / rms) 0 in qs_qk_norm vec nheads hd gamma eps (h + 1)

-- STREAMING Qwen layer: decode 11 weights from the mmap'd blob on the fly, transient
qs_layer buf hdrhi base xrow li d nh nkv hd inter qdim kvdim group eps lnb scaleq Kcache Vcache pos maxseq acc =
  let g_in   = ld_tensor buf hdrhi base (ld_lname li "input_layernorm.weight") d in
  let Wq     = ld_tensor buf hdrhi base (ld_lname li "self_attn.q_proj.weight") (qdim * d) in
  let Wk     = ld_tensor buf hdrhi base (ld_lname li "self_attn.k_proj.weight") (kvdim * d) in
  let Wv     = ld_tensor buf hdrhi base (ld_lname li "self_attn.v_proj.weight") (kvdim * d) in
  let Wo     = ld_tensor buf hdrhi base (ld_lname li "self_attn.o_proj.weight") (d * qdim) in
  let g_post = ld_tensor buf hdrhi base (ld_lname li "post_attention_layernorm.weight") d in
  let Wg     = ld_tensor buf hdrhi base (ld_lname li "mlp.gate_proj.weight") (inter * d) in
  let Wu     = ld_tensor buf hdrhi base (ld_lname li "mlp.up_proj.weight") (inter * d) in
  let Wd     = ld_tensor buf hdrhi base (ld_lname li "mlp.down_proj.weight") (d * inter) in
  let qnorm  = ld_tensor buf hdrhi base (ld_lname li "self_attn.q_norm.weight") hd in
  let knorm  = ld_tensor buf hdrhi base (ld_lname li "self_attn.k_norm.weight") hd in
  let xn = arr_new d 0 in
  let Q = arr_new qdim 0 in
  let K = arr_new kvdim 0 in
  let V = arr_new kvdim 0 in
  let _ = qs_qkv xrow xn Wq Wk Wv Q K V d qdim kvdim g_in eps acc in
  let _ = qs_qk_norm Q nh hd qnorm eps 0 in
  let _ = qs_qk_norm K nkv hd knorm eps 0 in
  let Qr = qs_rope_one Q (arr_new qdim 0) nh hd pos lnb 0 in
  let Kr = qs_rope_one K (arr_new kvdim 0) nkv hd pos lnb 0 in
  let layerbase = li * maxseq * kvdim in
  let _ = qs_store Kr Kcache (layerbase + pos * kvdim) kvdim 0 in
  let _ = qs_store V  Vcache (layerbase + pos * kvdim) kvdim 0 in
  let npos = pos + 1 in
  let attn = arr_new qdim 0 in
  let S = arr_new maxseq 0 in
  let E = arr_new maxseq 0 in
  let P = arr_new maxseq 0 in
  let _ = qs_heads Qr Kcache Vcache layerbase attn S E P kvdim hd scaleq nh group npos 0 acc in
  let Y = arr_new d 0 in
  let _ = pf_proj Wo attn 0 qdim Y 0 d acc 0 in
  let _ = pf_addrow xrow Y d 0 0 in
  let hn = arr_new d 0 in
  let rms2 = pf_rms Y 0 d eps in
  let _ = pf_normapply Y 0 hn g_post d rms2 0 in
  let gate = arr_new inter 0 in
  let up = arr_new inter 0 in
  let gg = arr_new inter 0 in
  let _ = pf_proj Wg hn 0 d gate 0 inter acc 0 in
  let _ = pf_proj Wu hn 0 d up 0 inter acc 0 in
  let _ = pf_silu_mul gate up gg inter 0 in
  let M = arr_new d 0 in
  let _ = pf_proj Wd gg 0 inter M 0 d acc 0 in
  let _ = pf_addrow M Y d 0 0 in
  Y

qs_layers buf hdrhi base xrow li nlayers d nh nkv hd inter qdim kvdim group eps lnb scaleq Kcache Vcache pos maxseq acc =
  if li >= nlayers then xrow
  else
    let m = arena_mark 0 in
    let Y = qs_layer buf hdrhi base xrow li d nh nkv hd inter qdim kvdim group eps lnb scaleq Kcache Vcache pos maxseq acc in
    let _ = pf_copy Y xrow d 0 in
    let _ = arena_reset m in
    qs_layers buf hdrhi base xrow (li + 1) nlayers d nh nkv hd inter qdim kvdim group eps lnb scaleq Kcache Vcache pos maxseq acc

qs_step buf hdrhi base Emb gnorm tokid Kcache Vcache pos maxseq d nh nkv hd inter qdim kvdim group eps lnb scaleq vocab nlayers acc =
  let xrow = arr_new d 0 in
  let _ = pf_embed_row Emb tokid xrow 0 d 0 in
  let _ = qs_layers buf hdrhi base xrow 0 nlayers d nh nkv hd inter qdim kvdim group eps lnb scaleq Kcache Vcache pos maxseq acc in
  let rms = pf_rms xrow 0 d eps in
  let xnf = arr_new d 0 in
  let _ = pf_normapply xrow 0 xnf gnorm d rms 0 in
  let logits = arr_new vocab 0 in
  let _ = pf_lmhead xnf Emb vocab d logits acc 0 in
  logits

qs_loop buf hdrhi base Emb gnorm ids L gbuf maxgen pos Kcache Vcache maxseq d nh nkv hd inter qdim kvdim group eps lnb scaleq vocab nlayers acc =
  if pos >= (L + maxgen - 1) then 0
  else
    let tok = if pos < L then (arr_get ids pos) else (arr_get gbuf (pos - L)) in
    let m = arena_mark 0 in
    let logits = qs_step buf hdrhi base Emb gnorm tok Kcache Vcache pos maxseq d nh nkv hd inter qdim kvdim group eps lnb scaleq vocab nlayers acc in
    let pred = pf_argmax logits vocab 1 0 (arr_get logits 0) in
    let _ = if pos >= (L - 1) then arr_set gbuf (pos - (L - 1)) pred else 0 in
    let _ = print (cat ["  ", (if pos < L then "prefill" else "gen"), " pos=", show pos, " -> next=", show pred]) in
    let _ = arena_reset m in
    qs_loop buf hdrhi base Emb gnorm ids L gbuf maxgen (pos + 1) Kcache Vcache maxseq d nh nkv hd inter qdim kvdim group eps lnb scaleq vocab nlayers acc

main =
  let blob = qs_blob 0 in
  let bsz = mmap_size blob in
  if bsz < 100000000 then
    let _ = print (cat ["pathb_qwen_stream: FATAL -- blob missing (", show bsz, "): ", blob]) in 1
  else
  let d = qs_d 0 in
  let nh = qs_nh 0 in
  let nkv = qs_nkv 0 in
  let hd = qs_hd 0 in
  let inter = qs_inter 0 in
  let nlayers = qs_nlayers 0 in
  let vocab = qs_vocab 0 in
  let eps = qs_eps 0 in
  let lnb = qs_lnb 0 in
  let maxgen = qs_maxgen 0 in
  let qdim = nh * hd in
  let kvdim = nkv * hd in
  let group = nh / nkv in
  let scaleq = bx4_fxrsqrt (hd * 16777216) in
  let acc = arr_new 2 0 in
  let buf = mmap_open blob in
  let hlen = pq_le_len buf 0 in
  let base = 8 + hlen in
  let hdrhi = base in
  let L = 5 in
  let ids = arr_new L 0 in
  let _ = arr_set ids 0 785 in
  let _ = arr_set ids 1 6722 in
  let _ = arr_set ids 2 315 in
  let _ = arr_set ids 3 9625 in
  let _ = arr_set ids 4 374 in
  let _ = print (cat ["pathb_qwen_stream: Qwen3-0.6B MMAP+per-layer streaming  L=", show L, " maxgen=", show maxgen]) in
  let Emb = ld_tensor buf hdrhi base "model.embed_tokens.weight" (vocab * d) in
  let gnorm = ld_tensor buf hdrhi base "model.norm.weight" d in
  let maxseq = L + maxgen in
  let Kcache = arr_new (nlayers * maxseq * kvdim) 0 in
  let Vcache = arr_new (nlayers * maxseq * kvdim) 0 in
  let gbuf = arr_new (maxgen + 1) 0 in
  let _ = qs_loop buf hdrhi base Emb gnorm ids L gbuf maxgen 0 Kcache Vcache maxseq d nh nkv hd inter qdim kvdim group eps lnb scaleq vocab nlayers acc in
  let _ = print (cat ["  g[0]=", show (arr_get gbuf 0), "  (HF greedy parity = 12095 ' Paris')"]) in
  let _ = print (cat ["  D2.2-stream parity (g[0]==12095): ", if (arr_get gbuf 0) == 12095 then "PASS" else "FAIL"]) in
  0
