-- pathb_generate.rail -- KV-CACHED autoregressive generation on the Path-B substrate.
--
-- Path-B's attested forward (pathb_forward_full.rail) recomputes O(seq^2) full attention for
-- a single next-token prediction. This generator adds a KV cache: every position is processed
-- as a SINGLE-TOKEN decode that attends over a persistent per-layer K/V cache. Because the
-- model is causal, a single-token decode at the LAST prompt position is bit-identical to the
-- full forward's last row -> its logits MUST reproduce the attested sha (d8a9f0c7...). That is
-- the exact correctness gate. The same decode path then extends past the prompt = generation.
--
-- Shares ALL block math with the attested forward via pathb_lib.rail (one source of truth).
--
-- Build: cd ~/projects/rail-https && ./rail_native tools/railml/pathb/pathb_generate.rail
-- Run:   RAIL_ARENA_MB=8192 /tmp/rail_out     (binary directly; ./rail_native run SIGBUSes on the load)
--
-- Verifies: (1) logits at pos L-1 reproduce logits_full.txt sha d8a9f0c7 (prefill == attested forward);
--           (2) first generated token == 260 (' the', HF greedy parity). Multi-token greedy continues.

import "tools/railml/pathb/pathb_lib.rail"
import "stdlib/env.rail"

-- ===== config (SmolLM2-135M, identical to pathb_forward_full) =====
pg_d _      = 576
pg_nh _     = 9
pg_nkv _    = 3
pg_hd _     = 64
pg_inter _  = 1536
pg_vocab _  = 49152
pg_nlayers _ = 30
pg_eps _    = 168
pg_lnb _    = 193154837
pg_maxgen _ = 12

-- HF safetensors blob: $SMOLLM2_BLOB if set, else $HOME/.cache/huggingface/... (standard HF hub cache).
pg_blob _ = let e = getenv "SMOLLM2_BLOB" in if e == "" then cat [getenv "HOME", "/.cache/huggingface/hub/models--HuggingFaceTB--SmolLM2-135M/blobs/80521b40281d6ce74e35c9282c22539e75aa0ac8578892b2a59955ef78d55da1"] else e

-- ===== single-token QKV projection: hidden row -> Q[qdim], K[kvdim], V[kvdim] =====
pg_qkv xrow xn Wq Wk Wv Q K V d qdim kvdim gamma eps acc =
  let rms = pf_rms xrow 0 d eps in
  let _ = pf_normapply xrow 0 xn gamma d rms 0 in
  let _ = pf_proj Wq xn 0 d Q 0 qdim acc 0 in
  let _ = pf_proj Wk xn 0 d K 0 kvdim acc 0 in
  let _ = pf_proj Wv xn 0 d V 0 kvdim acc 0 in
  0

-- ===== RoPE one token's multi-head vector by ABSOLUTE position pos (reuses pf_rope per head) =====
pg_rope_one src out nheads hd pos lnb h =
  if h >= nheads then out
  else let b = h * hd in
       let _ = pf_rope src b out b hd pos lnb 0 in
       pg_rope_one src out nheads hd pos lnb (h + 1)

-- ===== copy a single token's kvdim vector into the persistent cache at a flat base =====
pg_store src cache cbase kvdim i =
  if i >= kvdim then 0
  else let _ = arr_set cache (cbase + i) (arr_get src i) in pg_store src cache cbase kvdim (i + 1)

-- ===== single-query attention over cache positions 0..npos-1 =====
-- Cache flat layout: element (layer li, position j, dim e) at li*maxseq*kvdim + j*kvdim + e.
-- For query head h: kv = h/group; head base into cache for position 0 = layerbase + kv*hd.
pg_scores Qr qhb Kcache kbaseL kvdim hd scaleq npos S acc j =
  if j >= npos then 0
  else
    -- idot: 128-bit-exact Q.K (overflow-safe for massive activations; bit-exact vs pf_adot otherwise)
    let raw = idot Qr qhb Kcache (kbaseL + j * kvdim) hd in
    let _ = arr_set S j ((raw * scaleq) / 16777216) in
    pg_scores Qr qhb Kcache kbaseL kvdim hd scaleq npos S acc (j + 1)
pg_ctx P Vcache vbaseL kvdim attn ab hd npos col acc =
  if col >= hd then 0
  else
    let _ = arr_set acc 0 0 in
    let _ = arr_set acc 1 0 in
    let _ = pf_pvdot P 0 Vcache (vbaseL + col) kvdim npos acc 0 in
    let _ = arr_set attn (ab + col) (pf_rescale (arr_get acc 0) (arr_get acc 1)) in
    pg_ctx P Vcache vbaseL kvdim attn ab hd npos (col + 1)
pg_head Qr Kcache Vcache layerbase attn S E P kvdim hd scaleq group npos h acc =
  let kv = h / group in
  let qhb = h * hd in
  let hb = layerbase + kv * hd in
  let _ = pg_scores Qr qhb Kcache hb kvdim hd scaleq npos S acc 0 in
  let _ = pf_softmax_i S E P 0 npos in
  pg_ctx P Vcache hb kvdim attn (h * hd) hd npos 0 acc
pg_heads Qr Kcache Vcache layerbase attn S E P kvdim hd scaleq nh group npos h acc =
  if h >= nh then attn
  else let _ = pg_head Qr Kcache Vcache layerbase attn S E P kvdim hd scaleq group npos h acc in
       pg_heads Qr Kcache Vcache layerbase attn S E P kvdim hd scaleq nh group npos (h + 1) acc

-- ===== one transformer layer over a single token at position pos, using/updating the cache =====
-- Weights come from the pre-decoded directory LW (9 standalone arrays per layer at li*9+k) so they
-- are decoded ONCE (pg_loadall) instead of reloaded from the blob every step. Each LW entry is a full
-- array starting at 0 -- identical shape to ld_tensor's return -- so the block math is unchanged.
pg_layer LW xrow li d nh nkv hd inter qdim kvdim group eps lnb scaleq Kcache Vcache pos maxseq acc =
  let g_in   = arr_get LW (li * 9 + 0) in
  let Wq     = arr_get LW (li * 9 + 1) in
  let Wk     = arr_get LW (li * 9 + 2) in
  let Wv     = arr_get LW (li * 9 + 3) in
  let Wo     = arr_get LW (li * 9 + 4) in
  let g_post = arr_get LW (li * 9 + 5) in
  let Wg     = arr_get LW (li * 9 + 6) in
  let Wu     = arr_get LW (li * 9 + 7) in
  let Wd     = arr_get LW (li * 9 + 8) in
  -- QKV for the single token
  let xn = arr_new d 0 in
  let Q = arr_new qdim 0 in
  let K = arr_new kvdim 0 in
  let V = arr_new kvdim 0 in
  let _ = pg_qkv xrow xn Wq Wk Wv Q K V d qdim kvdim g_in eps acc in
  -- RoPE by absolute position, then append K,V to the per-layer cache slot `pos`
  let Qr = pg_rope_one Q (arr_new qdim 0) nh hd pos lnb 0 in
  let Kr = pg_rope_one K (arr_new kvdim 0) nkv hd pos lnb 0 in
  let layerbase = li * maxseq * kvdim in
  let _ = pg_store Kr Kcache (layerbase + pos * kvdim) kvdim 0 in
  let _ = pg_store V  Vcache (layerbase + pos * kvdim) kvdim 0 in
  -- attention over cache 0..pos
  let npos = pos + 1 in
  let attn = arr_new qdim 0 in
  let S = arr_new maxseq 0 in
  let E = arr_new maxseq 0 in
  let P = arr_new maxseq 0 in
  let _ = pg_heads Qr Kcache Vcache layerbase attn S E P kvdim hd scaleq nh group npos 0 acc in
  -- o_proj + residual (Y = Wo*attn + xrow)
  let Y = arr_new d 0 in
  let _ = pf_proj Wo attn 0 qdim Y 0 d acc 0 in
  let _ = pf_addrow xrow Y d 0 0 in
  -- MLP (post-norm gamma g_post) + residual
  let hn = arr_new d 0 in
  let rms2 = pf_rms Y 0 d eps in
  let _ = pf_normapply Y 0 hn g_post d rms2 0 in
  let gate = arr_new inter 0 in
  let up = arr_new inter 0 in
  let gg = arr_new inter 0 in
  let _ = pf_proj Wg hn 0 d gate 0 inter acc 0 in
  let _ = pf_proj Wu hn 0 d up 0 inter acc 0 in
  let _ = pf_silu_mul gate up gg inter 0 in
  let M = arr_new d 0 in
  let _ = pf_proj Wd gg 0 inter M 0 d acc 0 in
  let _ = pf_addrow M Y d 0 0 in
  Y

-- loop all layers for ONE token; xrow is the persistent per-token hidden (survives per-layer resets).
pg_layers LW xrow li nlayers d nh nkv hd inter qdim kvdim group eps lnb scaleq Kcache Vcache pos maxseq acc =
  if li >= nlayers then xrow
  else
    let m = arena_mark 0 in
    let Y = pg_layer LW xrow li d nh nkv hd inter qdim kvdim group eps lnb scaleq Kcache Vcache pos maxseq acc in
    let _ = pf_copy Y xrow d 0 in
    let _ = arena_reset m in
    pg_layers LW xrow (li + 1) nlayers d nh nkv hd inter qdim kvdim group eps lnb scaleq Kcache Vcache pos maxseq acc

-- one full step: embed token -> all layers (cache updated at slot pos) -> final norm + tied LM head.
pg_step LW Emb gnorm tokid Kcache Vcache pos maxseq d nh nkv hd inter qdim kvdim group eps lnb scaleq vocab nlayers acc =
  let xrow = arr_new d 0 in
  let _ = pf_embed_row Emb tokid xrow 0 d 0 in
  let _ = pg_layers LW xrow 0 nlayers d nh nkv hd inter qdim kvdim group eps lnb scaleq Kcache Vcache pos maxseq acc in
  let rms = pf_rms xrow 0 d eps in
  let xnf = arr_new d 0 in
  let _ = pf_normapply xrow 0 xnf gnorm d rms 0 in
  let logits = arr_new vocab 0 in
  let _ = pf_lmhead xnf Emb vocab d logits acc 0 in
  logits

-- write logits at pos L-1 in the EXACT format of pathb_forward_full's logits_full.txt (to sha-match d8a9f0c7)
pg_dump_verify logits vocab nlayers L am =
  let path = "tools/railml/pathb/logits_gen_verify.txt" in
  let _ = write_file path (cat ["PATHB-FORWARD-FULL-LOGITS v1 model=SmolLM2-135M layers=", show nlayers, " vocab=", show vocab, " F=24 scale=16777216 L=", show L, " argmax=", show am, "\n"]) in
  pf_dump_file path logits vocab 4096 0

-- generation loop. ids = prompt (length L); gbuf collects generated tokens.
pg_loop LW Emb gnorm ids L gbuf maxgen pos Kcache Vcache maxseq d nh nkv hd inter qdim kvdim group eps lnb scaleq vocab nlayers acc =
  if pos >= (L + maxgen - 1) then 0
  else
    let tok = if pos < L then (arr_get ids pos) else (arr_get gbuf (pos - L)) in
    let m = arena_mark 0 in
    let logits = pg_step LW Emb gnorm tok Kcache Vcache pos maxseq d nh nkv hd inter qdim kvdim group eps lnb scaleq vocab nlayers acc in
    let pred = pf_argmax logits vocab 1 0 (arr_get logits 0) in
    let _ = if pos == (L - 1) then (let _ = pg_dump_verify logits vocab nlayers L pred in print (cat ["  [verify] dumped pos=", show (L - 1), " logits (expect sha d8a9f0c7...)"])) else 0 in
    let _ = if pos >= (L - 1) then arr_set gbuf (pos - (L - 1)) pred else 0 in
    let _ = if pos >= (L - 1) then print (cat ["  gen[", show (pos - (L - 1)), "]  predicts token at pos ", show (pos + 1), " = ", show pred]) else (print (cat ["  prefill pos=", show pos, " tok=", show tok])) in
    let _ = arena_reset m in
    pg_loop LW Emb gnorm ids L gbuf maxgen (pos + 1) Kcache Vcache maxseq d nh nkv hd inter qdim kvdim group eps lnb scaleq vocab nlayers acc

pg_print_gen gbuf n i = if i >= n then 0 else let _ = print (cat ["    g[", show i, "] = ", show (arr_get gbuf i)]) in pg_print_gen gbuf n (i + 1)

-- pre-decode ALL layer weights ONCE into the directory LW (9 standalone arrays per layer at li*9+k).
-- This is the weight-cache: ~135M BF16 elements decoded one time, then reused for every decode step
-- (vs reloading the 269 MB blob per step). Persistent (allocated before the generation loop's marks).
pg_loadall buf hdrhi base LW li nlayers d qdim kvdim inter =
  if li >= nlayers then 0
  else
    let _ = arr_set LW (li * 9 + 0) (ld_tensor buf hdrhi base (ld_lname li "input_layernorm.weight") d) in
    let _ = arr_set LW (li * 9 + 1) (ld_tensor buf hdrhi base (ld_lname li "self_attn.q_proj.weight") (qdim * d)) in
    let _ = arr_set LW (li * 9 + 2) (ld_tensor buf hdrhi base (ld_lname li "self_attn.k_proj.weight") (kvdim * d)) in
    let _ = arr_set LW (li * 9 + 3) (ld_tensor buf hdrhi base (ld_lname li "self_attn.v_proj.weight") (kvdim * d)) in
    let _ = arr_set LW (li * 9 + 4) (ld_tensor buf hdrhi base (ld_lname li "self_attn.o_proj.weight") (d * qdim)) in
    let _ = arr_set LW (li * 9 + 5) (ld_tensor buf hdrhi base (ld_lname li "post_attention_layernorm.weight") d) in
    let _ = arr_set LW (li * 9 + 6) (ld_tensor buf hdrhi base (ld_lname li "mlp.gate_proj.weight") (inter * d)) in
    let _ = arr_set LW (li * 9 + 7) (ld_tensor buf hdrhi base (ld_lname li "mlp.up_proj.weight") (inter * d)) in
    let _ = arr_set LW (li * 9 + 8) (ld_tensor buf hdrhi base (ld_lname li "mlp.down_proj.weight") (d * inter)) in
    pg_loadall buf hdrhi base LW (li + 1) nlayers d qdim kvdim inter

main =
  let blob = pg_blob 0 in
  let bsz = read_file_size blob in
  if bsz < 10000000 then
    let _ = print (cat ["pathb_generate: FATAL -- blob missing or too small (", show bsz, " bytes): ", blob]) in
    let _ = print "  Set $SMOLLM2_BLOB to the SmolLM2-135M model.safetensors blob, or place it under" in
    let _ = print "  $HOME/.cache/huggingface/hub/models--HuggingFaceTB--SmolLM2-135M/blobs/." in
    1
  else
  let d = pg_d 0 in
  let nh = pg_nh 0 in
  let nkv = pg_nkv 0 in
  let hd = pg_hd 0 in
  let inter = pg_inter 0 in
  let nlayers = pg_nlayers 0 in
  let vocab = pg_vocab 0 in
  let eps = pg_eps 0 in
  let lnb = pg_lnb 0 in
  let maxgen = pg_maxgen 0 in
  let qdim = nh * hd in
  let kvdim = nkv * hd in
  let group = nh / nkv in
  let scaleq = bx4_fxrsqrt (hd * 16777216) in
  let acc = arr_new 2 0 in
  let buf = read_file_bytes blob in
  let hlen = pq_le_len buf 0 in
  let base = 8 + hlen in
  let hdrhi = base in
  -- prompt ids
  let idspath = "tools/railml/pathb/prompt_ids.txt" in
  let ibuf = read_file_bytes idspath in
  let ihi = read_file_size idspath in
  let L = ids_count ibuf 0 ihi 0 in
  let ids = arr_new L 0 in
  let _ = ids_fill ibuf 0 ihi ids 0 in
  let _ = print (cat ["pathb_generate: SmolLM2-135M KV-cached generation  L=", show L, " maxgen=", show maxgen]) in
  -- embedding (full) + final norm, decoded once
  let _ = print "  decoding full embedding (49152 x 576)..." in
  let Emb = ld_tensor buf hdrhi base "model.embed_tokens.weight" (vocab * d) in
  let gnorm = ld_tensor buf hdrhi base "model.norm.weight" d in
  let _ = print "  embedding decoded; pre-loading all layers' weights (once)..." in
  let LW = arr_new (nlayers * 9) 0 in
  let _ = pg_loadall buf hdrhi base LW 0 nlayers d qdim kvdim inter in
  let _ = print "  weights cached; generating..." in
  -- KV cache: per-layer, maxseq positions, kvdim each
  let maxseq = L + maxgen in
  let Kcache = arr_new (nlayers * maxseq * kvdim) 0 in
  let Vcache = arr_new (nlayers * maxseq * kvdim) 0 in
  let gbuf = arr_new (maxgen + 1) 0 in
  let _ = pg_loop LW Emb gnorm ids L gbuf maxgen 0 Kcache Vcache maxseq d nh nkv hd inter qdim kvdim group eps lnb scaleq vocab nlayers acc in
  let _ = print (cat ["  generated ", show maxgen, " tokens:"]) in
  let _ = pg_print_gen gbuf maxgen 0 in
  let h = shell "shasum -a 256 tools/railml/pathb/logits_gen_verify.txt" in
  let _ = print (cat ["  [verify] pos L-1 logits sha256: ", h]) in
  let _ = print "  EXPECT: d8a9f0c7a58609e5a14fcc57f46a92b03d0de3418fa099edaff18c2347fef2cd  (== attested forward) AND g[0]=260" in
  0
