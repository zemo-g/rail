-- tools/orch/jit_lex_check.rail
--
-- JIT-target source for the cheap pre-compile gate used by bench rerank.
--
-- IMPORTANT: This file is NOT meant to run via `./rail_native run`. Its
-- str_at/str_len/read_file usage targets the JIT IR opcode set, not the
-- standalone Rail builtins (those names don't exist as top-level Rail).
-- The driver in jit/test_lex_check_lower.rail loads this file as a string,
-- calls jit/lower.rail::lower_source, then JIT-executes it per sample.
--
-- Constraints from jit/lower.rail v1:
--   - Each top-level fn must be ONE LINE (newlines only between decls)
--   - Only 2 cross-call vreg preservation slots, so functions with internal
--     user-fn calls must have ≤2 args that survive the call. Workaround:
--     inline byte-class check + split walk into two self-recursive passes.
--
-- Contract: reads /tmp/jit_lex_input.txt; returns 1 if contents are
-- plausibly Rail (ASCII-clean and contain at least one `=`), 0 otherwise.

ascii_ok s i n = if i >= n then 1 else let b = str_at s i in if b == 9 || b == 10 || b == 13 || (b > 31 && b < 127) then ascii_ok s (i + 1) n else 0
has_eq s i n = if i >= n then 0 else if str_at s i == 61 then 1 else has_eq s (i + 1) n
main = let s = read_file "/tmp/jit_lex_input.txt" in let n = str_len s in if n < 5 then 0 else if ascii_ok s 0 n == 0 then 0 else has_eq s 0 n
