[Unit]
Description=Entropy witness CF publisher — PUTs signed latest.json to ledatic.org
After=network-online.target witness.service
Wants=network-online.target
Requires=witness.service

[Service]
Type=simple
User=<user>
WorkingDirectory=<HOME>
ExecStart=~/.ledatic/witness/witness_push.sh
Restart=always
RestartSec=15
StandardOutput=append:~/.ledatic/witness/witness_push.log
StandardError=append:~/.ledatic/witness/witness_push.err

[Install]
WantedBy=multi-user.target
