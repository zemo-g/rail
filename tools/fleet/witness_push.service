[Unit]
Description=Entropy witness CF publisher — PUTs signed latest.json to ledatic.org
After=network-online.target witness.service
Wants=network-online.target
Requires=witness.service

[Service]
Type=simple
User=zemog
WorkingDirectory=/home/zemog
ExecStart=/home/zemog/.ledatic/witness/witness_push.sh
Restart=always
RestartSec=15
StandardOutput=append:/home/zemog/.ledatic/witness/witness_push.log
StandardError=append:/home/zemog/.ledatic/witness/witness_push.err

[Install]
WantedBy=multi-user.target
