[Unit]
Description=Entropy beacon witness — signs ledatic.org/entropy pulses with Ed25519
Documentation=https://github.com/zemo-g/rail/blob/master/tools/fleet/witness.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zemog
WorkingDirectory=/home/zemog
ExecStart=/home/zemog/.ledatic/witness/witness.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/zemog/.ledatic/witness/witness.log
StandardError=append:/home/zemog/.ledatic/witness/witness.err

[Install]
WantedBy=multi-user.target
