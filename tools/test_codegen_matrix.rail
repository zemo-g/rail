-- tools/test_codegen_matrix.rail
--
-- Adversarial codegen-path test matrix. Enumerates (lhs_kind, op, rhs_kind)
-- combinations that exercise the binary-op dispatcher (cg O-handler line ~1440
-- in tools/compile.rail) AND the comparison fast-path (line ~1476).
--
-- Each cell exercises a specific operand-kind × operator combination on the
-- ARM64 backend. Failures here mean codegen for that combination is wrong.
--
-- Bug shapes this test would have caught (both fixed 2026-05-14):
--   1. Large top-level int literal in arithmetic ("mov x0, #2000001" -> asm reject)
--   2. Top-level value const in subtraction inside another function ("period - dt" -> -dt)
--
-- Run: ./rail_native run tools/test_codegen_matrix.rail
-- Expected output: "MATRIX OK: <N>/<N> passed"

-- ═══════════════════════════════════════════════════════════
-- Top-level constants (the operand kind that triggered Bug 2)
-- ═══════════════════════════════════════════════════════════
gs = 42              -- small global, fits 16-bit
gl = 1000000         -- large global, needs movz+movk

-- Top-level arithmetic with large literal (the operand shape that triggered Bug 1)
g_arith_div = 1000000 / 1
g_arith_sub = 1000000 - 1
g_arith_mul = 1 * 1000000

-- ═══════════════════════════════════════════════════════════
-- Helpers — accumulate pass/fail in a mutable array
-- ═══════════════════════════════════════════════════════════
chk counts name actual expected =
  if actual == expected then
    let p = arr_get counts 0
    let _ = arr_set counts 0 (p + 1)
    0
  else
    let _ = print (cat [name, " FAIL: got ", show actual, " expected ", show expected])
    let f = arr_get counts 1
    let _ = arr_set counts 1 (f + 1)
    0

-- ═══════════════════════════════════════════════════════════
-- Cells: (global, op, param) — Bug 2 territory
-- Each function takes one parameter `p` (register-resident local).
-- ═══════════════════════════════════════════════════════════
gs_add_p p = gs + p
gs_sub_p p = gs - p
gs_mul_p p = gs * p
gs_div_p p = gs / p
gl_add_p p = gl + p
gl_sub_p p = gl - p
gl_mul_p p = gl * p
gl_div_p p = gl / p

-- ═══════════════════════════════════════════════════════════
-- Cells: (param, op, global) — symmetric of above
-- ═══════════════════════════════════════════════════════════
p_add_gs p = p + gs
p_sub_gs p = p - gs
p_mul_gs p = p * gs
p_div_gs p = p / gs
p_add_gl p = p + gl
p_sub_gl p = p - gl
p_div_gl p = p / gl

-- ═══════════════════════════════════════════════════════════
-- Cells: large int literal × param (Bug 1 territory in body context)
-- ═══════════════════════════════════════════════════════════
p_sub_il p = p - 1000000
il_sub_p p = 1000000 - p
p_add_il p = p + 1000000
il_add_p p = 1000000 + p

-- ═══════════════════════════════════════════════════════════
-- Cells: comparisons in `if` (line 1476 dispatcher path)
-- These exercise the fast-path with global-V operands.
-- ═══════════════════════════════════════════════════════════
gs_lt_p p = if gs < p then 1 else 0
gs_gt_p p = if gs > p then 1 else 0
gl_lt_p p = if gl < p then 1 else 0
gl_gt_p p = if gl > p then 1 else 0
gl_eq_p p = if gl == p then 1 else 0
gl_ne_p p = if gl != p then 1 else 0
gl_le_p p = if gl <= p then 1 else 0
gl_ge_p p = if gl >= p then 1 else 0
p_lt_gl p = if p < gl then 1 else 0
p_gt_gl p = if p > gl then 1 else 0

-- ═══════════════════════════════════════════════════════════
-- Cells: stack-resident local in arithmetic with globals
-- Forces a let-binding so the operand is a stack-V, not register-V.
-- ═══════════════════════════════════════════════════════════
gs_sub_local x =
  let a = x + 1
  let b = x + 2
  let c = x + 3
  let d = x + 4
  let e = x + 5
  let f = x + 6
  let g = x + 7
  let h = x + 8
  gs - h

gl_sub_local x =
  let a = x + 1
  let b = x + 2
  let c = x + 3
  let d = x + 4
  let e = x + 5
  let f = x + 6
  let g = x + 7
  let h = x + 8
  gl - h

main =
  let counts = arr_new 2 0
  let _ = chk counts "g_arith_div"        g_arith_div         1000000
  let _ = chk counts "g_arith_sub"        g_arith_sub          999999
  let _ = chk counts "g_arith_mul"        g_arith_mul         1000000
  let _ = chk counts "gs_add_p(10)"       (gs_add_p 10)            52
  let _ = chk counts "gs_sub_p(10)"       (gs_sub_p 10)            32
  let _ = chk counts "gs_mul_p(3)"        (gs_mul_p 3)            126
  let _ = chk counts "gs_div_p(6)"        (gs_div_p 6)              7
  let _ = chk counts "gl_add_p(5)"        (gl_add_p 5)        1000005
  let _ = chk counts "gl_sub_p(5)"        (gl_sub_p 5)         999995
  let _ = chk counts "gl_mul_p(2)"        (gl_mul_p 2)        2000000
  let _ = chk counts "gl_div_p(4)"        (gl_div_p 4)         250000
  let _ = chk counts "p_add_gs(100)"      (p_add_gs 100)          142
  let _ = chk counts "p_sub_gs(100)"      (p_sub_gs 100)           58
  let _ = chk counts "p_mul_gs(2)"        (p_mul_gs 2)             84
  let _ = chk counts "p_div_gs(84)"       (p_div_gs 84)             2
  let _ = chk counts "p_add_gl(50)"       (p_add_gl 50)       1000050
  let _ = chk counts "p_sub_gl(2000000)"  (p_sub_gl 2000000)  1000000
  let _ = chk counts "p_div_gl(3000000)"  (p_div_gl 3000000)        3
  let _ = chk counts "p_sub_il(2000000)"  (p_sub_il 2000000)  1000000
  let _ = chk counts "il_sub_p(42)"       (il_sub_p 42)        999958
  let _ = chk counts "p_add_il(5)"        (p_add_il 5)        1000005
  let _ = chk counts "il_add_p(5)"        (il_add_p 5)        1000005
  let _ = chk counts "gs_lt_p(100)"       (gs_lt_p 100)             1
  let _ = chk counts "gs_lt_p(1)"         (gs_lt_p 1)               0
  let _ = chk counts "gs_gt_p(1)"         (gs_gt_p 1)               1
  let _ = chk counts "gl_lt_p(2000000)"   (gl_lt_p 2000000)         1
  let _ = chk counts "gl_lt_p(1)"         (gl_lt_p 1)               0
  let _ = chk counts "gl_gt_p(1)"         (gl_gt_p 1)               1
  let _ = chk counts "gl_eq_p(1000000)"   (gl_eq_p 1000000)         1
  let _ = chk counts "gl_eq_p(42)"        (gl_eq_p 42)              0
  let _ = chk counts "gl_ne_p(42)"        (gl_ne_p 42)              1
  let _ = chk counts "gl_le_p(1000000)"   (gl_le_p 1000000)         1
  let _ = chk counts "gl_ge_p(1000000)"   (gl_ge_p 1000000)         1
  let _ = chk counts "p_lt_gl(42)"        (p_lt_gl 42)              1
  let _ = chk counts "p_gt_gl(2000000)"   (p_gt_gl 2000000)         1
  let _ = chk counts "gs_sub_local(10)"   (gs_sub_local 10)        24
  let _ = chk counts "gl_sub_local(10)"   (gl_sub_local 10)    999982
  let p = arr_get counts 0
  let f = arr_get counts 1
  let total = p + f
  let _ = print (cat ["MATRIX ", if f == 0 then "OK" else "FAIL", ": ", show p, "/", show total, " passed"])
  if f == 0 then 0 else 1
