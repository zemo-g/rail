-- tools/diagnose/dump_pattern_smoke.rail
--
-- Bisection harness for the forward_dump_gpu OOM (141 GB virtual on 64 GB
-- Studio per memory forward_dump_gpu_leak.md).
--
-- Hypothesis under test: the floats_to_text_loop + join + write_file pattern
-- in dump_tensor leaks unbounded across repeated calls. This script runs ONLY
-- that pattern — no forward pass, no model load, no Metal — on a 100K-float
-- array, eight times.
--
-- Expected if hypothesis TRUE: peak RSS climbs unboundedly with dump count.
-- Expected if hypothesis FALSE: peak RSS stays under ~50 MB regardless of
-- dump count; the leak is somewhere else (matmul intermediates, GC vs
-- forward-pass interaction, etc.).
--
-- Run with `time -l` to get peak footprint:
--   /usr/bin/time -l ./rail_native run tools/diagnose/dump_pattern_smoke.rail

floats_to_text_loop arr i n acc =
  if i >= n then reverse acc
  else
    let v = float_arr_get arr i
    floats_to_text_loop arr (i + 1) n (cons (show_float v) acc)

dump_arr name arr n =
  let path = cat ["/tmp/dump_", name, ".txt"]
  let lines = floats_to_text_loop arr 0 n []
  let body = join "\n" lines
  let _ = write_file path body
  let _ = print (cat ["DUMP ", path, " n=", show n, " body_chars=", show (length (chars body))])
  0

cat parts = join "" parts

dump_n_times arr n_floats k_dumps i =
  if i >= k_dumps then 0
  else
    let label = cat ["test", show i]
    let _ = dump_arr label arr n_floats
    dump_n_times arr n_floats k_dumps (i + 1)

main =
  let n = 100000
  let arr = float_arr_new n 0.0
  let _ = print (cat ["pre-dump: allocated float_arr of size ", show n])
  let _ = dump_n_times arr n 8 0
  let _ = print "ALL DONE"
  0
