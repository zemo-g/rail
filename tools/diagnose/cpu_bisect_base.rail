-- cpu_bisect_base.rail — minimal harness for matmul_cpu heisenbug bisect.
--
-- Reproduces bisect_v6's known-correct configuration: load smoke_v54_repro
-- ckpt, build vocab from matched back_quarter corpus, build one-hot x for
-- prompt "main = ", compute x @ w_e via matmul_cpu, dump x_embed[0].
--
-- Expected: x_embed[0] = 0.020599365234375 = w_e[8,0] (id0=8 for "main = "
-- under V=93 back_quarter vocab). See cpu_substrate_bisect_progress
-- 2026-05-10 memory entry.
--
-- This file BY ITSELF must produce 0.020599 to be a valid baseline. Once
-- baseline is verified, fork to cpu_bisect_v{N}.rail and add file-level
-- function definitions one classification at a time until the value flips.
-- The first classification that flips it is the heisenbug trigger.

import "stdlib/transformer.rail"
import "stdlib/optim.rail"
import "stdlib/tokenizer.rail"
import "stdlib/checkpoint.rail"

cat parts = join "" parts

matmul_cpu a b = match a
  | Tensor a_data a_shape a_strides -> match b
    | Tensor b_data b_shape b_strides ->
      let m_dim = head a_shape
      let k_dim = head (tail a_shape)
      let n_dim = head (tail b_shape)
      let c = tensor_zeros (cons m_dim (cons n_dim []))
      let acc = float_arr_new 1 0.0
      match c
        | Tensor c_data c_shape c_strides ->
          let _ = matmul_i a_data b_data c_data acc m_dim n_dim k_dim 0
          c

fill_one_hot_loop xd ids V pos =
  if length ids == 0 then 0
  else
    let id = head ids
    let _ = float_arr_set xd (pos * V + id) 1.0
    fill_one_hot_loop xd (tail ids) V (pos + 1)

main =
  let prefix = "runs/smoke_v54_repro/checkpoints/smoke_v54_repro_best"
  let corpus_path = "training/corpora/spur_compile_back_quarter.txt"
  let prompt = "main = "

  let text = read_file corpus_path
  let vocab = build_vocab text
  let V = vocab_size vocab

  let weights = load_model prefix
  let w_e = list_nth 0 weights

  let raw_ids = encode vocab prompt
  let n_ids = length raw_ids

  let x_data = float_arr_new (n_ids * V) 0.0
  let _ = fill_one_hot_loop x_data raw_ids V 0

  let x_shape = cons n_ids (cons V [])
  let x = Tensor x_data x_shape (compute_strides x_shape)

  let x_embed = matmul_cpu x w_e
  match x_embed
    | Tensor d _ _ ->
      let v0 = float_arr_get d 0
      let _ = print (cat ["V=", show V])
      let _ = print (cat ["n_ids=", show n_ids])
      let _ = print (cat ["id0=", show (head raw_ids)])
      let _ = print (cat ["x_embed[0]=", show_float v0])
      0
