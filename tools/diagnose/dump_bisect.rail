-- tools/diagnose/dump_bisect.rail
--
-- Per-step bisection of the dump-pattern leak (per dump_pattern_smoke
-- result: 8×100K-float dumps = 53.5 GB peak RSS).
--
-- Each main variant exercises ONE step of the dump pipeline at scale and
-- prints peak RSS lookup to stderr is left to /usr/bin/time -l. Toggle the
-- variant by setting STAGE in the env before running.
--
-- STAGE=show_only         : just show_float each value, drop result
-- STAGE=show_cons         : show_float + cons (build list), don't reverse
-- STAGE=show_cons_rev     : add reverse
-- STAGE=show_cons_rev_join: add join (full pipeline minus write_file)
-- STAGE=full              : full pipeline including write_file

show_only_loop arr i n =
  if i >= n then 0
  else
    let v = float_arr_get arr i
    let _ = show_float v
    show_only_loop arr (i + 1) n

show_cons_loop arr i n acc =
  if i >= n then acc
  else
    let v = float_arr_get arr i
    show_cons_loop arr (i + 1) n (cons (show_float v) acc)

show_cons_rev_loop arr i n =
  let acc = show_cons_loop arr 0 n []
  reverse acc

show_cons_rev_join_loop arr n =
  let lines = show_cons_rev_loop arr 0 n
  join "\n" lines

cat parts = join "" parts

run_iters stage arr n iters i =
  if i >= iters then 0
  else
    let _ = if stage == "show_only" then
              let _ = show_only_loop arr 0 n
              0
            else if stage == "show_cons" then
              let acc = show_cons_loop arr 0 n []
              let _ = length acc
              0
            else if stage == "show_cons_rev" then
              let lst = show_cons_rev_loop arr 0 n
              let _ = length lst
              0
            else if stage == "show_cons_rev_join" then
              let body = show_cons_rev_join_loop arr n
              let _ = length (chars body)
              0
            else
              -- "full"
              let body = show_cons_rev_join_loop arr n
              let _ = write_file (cat ["/tmp/bisect_", show i, ".txt"]) body
              0
    let _ = print (cat ["iter=", show i, " stage=", stage])
    run_iters stage arr n iters (i + 1)

argv_get_loop xs key =
  if length xs == 0 then ""
  else if head xs == key then
    if length (tail xs) > 0 then head (tail xs) else ""
  else argv_get_loop (tail xs) key

argv_get argv key default_val =
  let v = argv_get_loop argv key
  if length (chars v) == 0 then default_val else v

main =
  let stage = argv_get args "--stage" "show_only"
  let n = 100000
  let iters = 8
  let arr = float_arr_new n 0.0
  let _ = print (cat ["bisect stage=", stage, " n=", show n, " iters=", show iters])
  let _ = run_iters stage arr n iters 0
  let _ = print "DONE"
  0
