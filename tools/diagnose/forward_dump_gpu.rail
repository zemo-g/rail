-- tools/diagnose/forward_dump_gpu.rail
--
-- Cloned from tools/train/lm_infer_v3_mixed.rail with `dump_tensor` hooks at
-- strategic points so we can paired-diff against forward_dump_cpu.rail's
-- output and localise where CPU vs GPU divergence first crosses the noise
-- floor.
--
-- Dumped tensors (one .txt file per layer, one float per line):
--   x_embed              after matmul_mixed x w_e_h
--   block0_x_attn        after attention residual (x + attn_out)
--   block0_x_out         after FFN residual (x_attn + h_out)
--   block1_x_attn        after attention residual in block 1
--   block1_x_out         after block 1 output
--   x_final              after final RMSNorm
--   logits               after final unembedding (pre-softmax)
--
-- Output dir: /tmp/forward_dump_gpu/
--
-- Usage:
--   ./rail_native run tools/diagnose/forward_dump_gpu.rail \
--       --prefix training/rail_native/checkpoints/spur_v54_BQ2_s77_best \
--       --prompt "main = " --max 4 --k 1 --seed 42

import "stdlib/transformer.rail"
import "stdlib/optim.rail"
import "stdlib/tokenizer.rail"
import "stdlib/checkpoint.rail"

corpus_path = "training/rail_corpus_stdlib.txt"
default_prefix = "training/rail_native/checkpoints/d256_half_step3000"
default_prompt = "main = "
default_max_gen_str = "4"
seq_len = 1024
dump_dir = "/tmp/forward_dump_gpu"

unwrap t = match t | Tensor d _ _ -> d

cat parts = join "" parts

-- ── Dump helper ────────────────────────────────────────────────────
-- Write a Tensor's f64 data as one-float-per-line text. Names land at
-- $dump_dir/<name>.txt so the bash diff tool can pair across substrates.
floats_to_text_loop arr i n acc =
  if i >= n then reverse acc
  else
    let v = float_arr_get arr i
    floats_to_text_loop arr (i + 1) n (cons (show_float v) acc)

dump_tensor name t = match t
  | Tensor d shape _ ->
    let n = list_product shape
    let path = cat [dump_dir, "/", name, ".txt"]
    let lines = floats_to_text_loop d 0 n []
    let body = join "\n" lines
    let _ = write_file path body
    let _ = print (cat ["DUMP ", path, " n=", show n])
    0

-- ── Block forward — Rail-native mixed precision (clone of original). ─
-- Added: block_idx arg + 2 dumps per block (x_attn, x_out).
infer_block_fwd x w_block seq d block_idx =
  let w_q = list_nth 0 w_block
  let w_k = list_nth 1 w_block
  let w_v = list_nth 2 w_block
  let w_o = list_nth 3 w_block
  let w_gate = list_nth 4 w_block
  let w_up = list_nth 5 w_block
  let w_down = list_nth 6 w_block
  let g1 = list_nth 7 w_block
  let g2 = list_nth 8 w_block

  let g1_f = tensor_of_half g1
  let pack1 = rmsnorm_save x g1_f
  let ln1 = head pack1
  let _ = dump_tensor (cat ["block", show block_idx, "_ln1"]) ln1

  let q = matmul_mixed ln1 w_q
  let k = matmul_mixed ln1 w_k
  let v = matmul_mixed ln1 w_v
  let _ = rope_apply q
  let _ = rope_apply k

  let kt = tensor_transpose k
  let scores = matmul q kt
  let scale = 1.0 / sqrt (int_to_float d)
  let scaled = tensor_scale scores scale
  let sd = unwrap scaled
  let _ = apply_causal_mask_loop sd seq 0 0
  let attn = tensor_softmax scaled
  let attn_val = matmul attn v
  let attn_out = matmul_mixed attn_val w_o
  let _ = dump_tensor (cat ["block", show block_idx, "_attn_out"]) attn_out
  let x_attn = tensor_add x attn_out
  let _ = dump_tensor (cat ["block", show block_idx, "_x_attn"]) x_attn

  let g2_f = tensor_of_half g2
  let pack2 = rmsnorm_save x_attn g2_f
  let ln2 = head pack2
  let _ = dump_tensor (cat ["block", show block_idx, "_ln2"]) ln2

  let h_gate = matmul_mixed ln2 w_gate
  let h_up = matmul_mixed ln2 w_up
  let silu_pack = silu_forward h_gate
  let h_gate_silu = head silu_pack
  let h_act = tensor_mul h_gate_silu h_up
  let h_out = matmul_mixed h_act w_down
  let _ = dump_tensor (cat ["block", show block_idx, "_h_out"]) h_out
  let x_out = tensor_add x_attn h_out
  let _ = dump_tensor (cat ["block", show block_idx, "_x_out"]) x_out
  x_out

unpack_one_block halfs base =
  let w0 = list_nth base halfs
  let w1 = list_nth (base + 1) halfs
  let w2 = list_nth (base + 2) halfs
  let w3 = list_nth (base + 3) halfs
  let w4 = list_nth (base + 4) halfs
  let w5 = list_nth (base + 5) halfs
  let w6 = list_nth (base + 6) halfs
  let w7 = list_nth (base + 7) halfs
  let w8 = list_nth (base + 8) halfs
  cons w0 (cons w1 (cons w2 (cons w3 (cons w4 (cons w5 (cons w6 (cons w7 (cons w8 []))))))))

unpack_blocks_loop halfs idx count acc =
  if count <= 0 then reverse acc
  else
    let b = unpack_one_block halfs idx
    unpack_blocks_loop halfs (idx + 9) (count - 1) (cons b acc)

unpack_blocks halfs start n_blocks =
  unpack_blocks_loop halfs start n_blocks []

infer_blocks_loop x blocks_h seq d i n =
  if i >= n then x
  else
    let b_weights_h = list_nth i blocks_h
    let next_x = infer_block_fwd x b_weights_h seq d i
    infer_blocks_loop next_x blocks_h seq d (i + 1) n

infer_forward x w_e_h blocks_h gf_h seq V d =
  let x_embed = matmul_mixed x w_e_h
  let _ = dump_tensor "x_embed" x_embed
  let n_blocks = length blocks_h
  let x_last = infer_blocks_loop x_embed blocks_h seq d 0 n_blocks
  let gf_f = tensor_of_half gf_h
  let packf = rmsnorm_save x_last gf_f
  let x_final = head packf
  let _ = dump_tensor "x_final" x_final
  let we_t_h = transpose_half w_e_h
  let logits = matmul_mixed x_final we_t_h
  let _ = dump_tensor "logits" logits
  tensor_softmax logits

argmax_row_loop pd V base best_id best_val v =
  if v >= V then best_id
  else
    let cur = float_arr_get pd (base + v)
    if cur > best_val then argmax_row_loop pd V base v cur (v + 1)
    else argmax_row_loop pd V base best_id best_val (v + 1)

argmax_row probs row V_arg = match probs
  | Tensor pd shape _ ->
    let V = list_nth 1 shape
    let base = row * V
    let v0 = float_arr_get pd base
    argmax_row_loop pd V base 0 v0 1

zero_range arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 0.0
    zero_range arr n (i + 1)

fill_prompt_loop xd ids_list V pos =
  if length ids_list == 0 then pos
  else
    let id = head ids_list
    let _ = float_arr_set xd (pos * V + id) 1.0
    fill_prompt_loop xd (tail ids_list) V (pos + 1)

-- One forward only — we want to compare ONE step's tensors, not autoregress.
-- max_gen=1 is enforced via the gen-loop that runs exactly one iteration.
single_step x blocks_h w_e_h gf_h seq V d cur_pos =
  let probs = infer_forward x w_e_h blocks_h gf_h seq V d
  let pred_row = cur_pos - 1
  let next_id = argmax_row probs pred_row V
  let _ = print (cat ["next_id=", show next_id])
  next_id

ids_to_string_loop ids vocab acc =
  if length ids == 0 then acc
  else ids_to_string_loop (tail ids) vocab (cat [acc, id_char vocab (head ids)])

ids_to_string ids vocab = ids_to_string_loop ids vocab ""

argv_get_loop xs key =
  if length xs == 0 then ""
  else if head xs == key then
    if length (tail xs) > 0 then head (tail xs) else ""
  else argv_get_loop (tail xs) key

argv_get argv key default_val =
  let v = argv_get_loop argv key
  if length (chars v) == 0 then default_val else v

sanitize_loop ids acc =
  if length ids == 0 then reverse acc
  else
    let id = head ids
    let fixed = if id < 0 then 0 else id
    sanitize_loop (tail ids) (cons fixed acc)

sanitize_ids ids = sanitize_loop ids []

main =
  let prefix = argv_get args "--prefix" default_prefix
  let prompt = argv_get args "--prompt" default_prompt

  let _ = shell (cat ["mkdir -p ", dump_dir])
  let _ = shell (cat ["rm -f ", dump_dir, "/*.txt"])

  let text = read_file corpus_path
  let vocab = build_vocab text
  let V = vocab_size vocab

  let have_ckpt = ckpt_exists prefix
  if not have_ckpt then
    let _ = print (cat ["ERROR: no committed checkpoint at ", prefix])
    1
  else
    let halfs = load_half_model prefix
    let n_weights = length halfs
    let n_blocks = (n_weights - 2) / 9
    if n_weights < 11 then
      let _ = print (cat ["ERROR: need at least 11 weights; got ", show n_weights])
      1
    else if n_weights != 2 + 9 * n_blocks then
      let _ = print (cat ["ERROR: n_weights ", show n_weights, " is not 2 + 9*N"])
      1
    else
      let w_e_h = list_nth 0 halfs
      let gf_h = list_nth 1 halfs
      let blocks_h = unpack_blocks halfs 2 n_blocks

      let raw_ids = encode vocab prompt
      let prompt_ids = sanitize_ids raw_ids
      let prompt_len = length prompt_ids
      if prompt_len == 0 then
        let _ = print "ERROR: prompt encoded to 0 tokens"
        1
      else
        let x_data = float_arr_new (seq_len * V) 0.0
        let x = Tensor x_data (cons seq_len (cons V [])) (compute_strides (cons seq_len (cons V [])))
        let _ = fill_prompt_loop x_data prompt_ids V 0
        let next_id = single_step x blocks_h w_e_h gf_h seq_len V 256 prompt_len
        let _ = print (cat ["dump complete in ", dump_dir])
        0
