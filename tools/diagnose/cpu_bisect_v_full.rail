-- cpu_bisect_v_full.rail — heisenbug reproducer for the matmul_cpu
-- substrate divergence. Compared to cpu_bisect_base.rail (correct), this
-- file adds the full forward_dump_cpu.rail file-level infrastructure
-- AND main's validation chain (have_ckpt / weight count / vocab match /
-- prompt_len validation). With the let-line below toggled to a
-- conditional-bearing call (`length []`, or `if 1==0 then 0 else 0`,
-- or any user fn that emits a conditional), x_embed[0] flips to a
-- ~10^-315 garbage value. Toggling to a non-conditional call
-- (`1 + 2`, `plain_helper 1`) heals it back to 0.020599.
--
-- Run: ./rail_native run tools/diagnose/cpu_bisect_v_full.rail
--      -- --prefix runs/smoke_v54_repro/checkpoints/smoke_v54_repro_best
--         --corpus training/corpora/spur_compile_back_quarter.txt
--         --prompt "main = " --max 1 --k 1
--
-- Expected (correct): BISECT x_embed[0]=0.020599365234375
-- Trigger fingerprint: BISECT x_embed[0]=~10^-315 (varies per build)
--
-- Bisect findings (2026-05-10):
--   • The trigger is CUMULATIVE: same conditional in cpu_bisect_base.rail
--     does NOT break it (base lacks the validation chain + load_model
--     allocation footprint).
--   • Asymmetric branch sizes are NOT load-bearing: `if X then 0 else <body>`
--     and `if X then <body> else 0` differ in trigger behavior in some
--     positions but both can fire at this nesting depth.
--   • A conditional inside a helper fn called from main triggers it too —
--     the bug isn't bound to main-local emit.
--   • A non-conditional helper of identical shape does NOT trigger.
--   • Plain arithmetic (`1 + 2`) does NOT trigger.
--
-- See cpu_substrate_bisect_progress_2026-05-10.md (this entry will be
-- superseded by a fresh entry once the asm-level diff is in.)

import "stdlib/transformer.rail"
import "stdlib/optim.rail"
import "stdlib/tokenizer.rail"
import "stdlib/checkpoint.rail"

cat parts = join "" parts

default_corpus_path = "training/rail_corpus_stdlib.txt"
default_prefix = "training/rail_native/checkpoints/d256_half_step3000"
default_prompt = "main = "
default_max_gen_str = "128"
seq_len = 1024
dump_dir = "/tmp/forward_dump_cpu"

floats_to_text_loop arr i n acc =
  if i >= n then reverse acc
  else
    let v = float_arr_get arr i
    floats_to_text_loop arr (i + 1) n (cons (show_float v) acc)

dump_tensor name t = match t
  | Tensor d shape _ ->
    let n = list_product shape
    let path = cat [dump_dir, "/", name, ".txt"]
    let lines = floats_to_text_loop d 0 n []
    let body = join "\n" lines
    let _ = write_file path body
    let _ = print (cat ["DUMP ", path, " n=", show n])
    0

unwrap t = match t | Tensor d _ _ -> d

m_hadamard_loop ad bd cd n i =
  if i >= n then 0
  else
    let a = float_arr_get ad i
    let b = float_arr_get bd i
    let _ = float_arr_set cd i (a * b)
    m_hadamard_loop ad bd cd n (i + 1)

m_hadamard a b = match a
  | Tensor ad a_shape _ -> match b
    | Tensor bd _ _ ->
      let n = list_product a_shape
      let cd = float_arr_new n 0.0
      let _ = m_hadamard_loop ad bd cd n 0
      Tensor cd a_shape (compute_strides a_shape)

matmul_cpu a b = match a
  | Tensor a_data a_shape a_strides -> match b
    | Tensor b_data b_shape b_strides ->
      let m_dim = head a_shape
      let k_dim = head (tail a_shape)
      let n_dim = head (tail b_shape)
      let c = tensor_zeros (cons m_dim (cons n_dim []))
      let acc = float_arr_new 1 0.0
      match c
        | Tensor c_data c_shape c_strides ->
          let _ = matmul_i a_data b_data c_data acc m_dim n_dim k_dim 0
          c

fill_one_hot_loop xd ids V pos =
  if length ids == 0 then 0
  else
    let id = head ids
    let _ = float_arr_set xd (pos * V + id) 1.0
    fill_one_hot_loop xd (tail ids) V (pos + 1)

-- ───── forward/dump infrastructure (verbatim from forward_dump_cpu.rail)
infer_block_fwd x w_block seq d block_idx =
  let w_q = list_nth 0 w_block
  let w_k = list_nth 1 w_block
  let w_v = list_nth 2 w_block
  let w_o = list_nth 3 w_block
  let w_gate = list_nth 4 w_block
  let w_up = list_nth 5 w_block
  let w_down = list_nth 6 w_block
  let g1 = list_nth 7 w_block
  let g2 = list_nth 8 w_block

  let pack1 = rmsnorm_save x g1
  let ln1 = head pack1
  let _ = dump_tensor (cat ["block", show block_idx, "_ln1"]) ln1

  let q = matmul_cpu ln1 w_q
  let k = matmul_cpu ln1 w_k
  let v = matmul_cpu ln1 w_v
  let _ = rope_apply q
  let _ = rope_apply k

  let kt = tensor_transpose k
  let scores = matmul_cpu q kt
  let scale = 1.0 / sqrt (int_to_float d)
  let scaled = tensor_scale scores scale
  let sd = unwrap scaled
  let _ = apply_causal_mask_loop sd seq 0 0
  let attn = tensor_softmax scaled
  let attn_val = matmul_cpu attn v
  let attn_out = matmul_cpu attn_val w_o
  let _ = dump_tensor (cat ["block", show block_idx, "_attn_out"]) attn_out
  let x_attn = tensor_add x attn_out
  let _ = dump_tensor (cat ["block", show block_idx, "_x_attn"]) x_attn

  let pack2 = rmsnorm_save x_attn g2
  let ln2 = head pack2
  let _ = dump_tensor (cat ["block", show block_idx, "_ln2"]) ln2

  let h_gate = matmul_cpu ln2 w_gate
  let h_up = matmul_cpu ln2 w_up
  let silu_pack = silu_forward h_gate
  let h_gate_silu = head silu_pack
  let h_act = m_hadamard h_gate_silu h_up
  let h_out = matmul_cpu h_act w_down
  let _ = dump_tensor (cat ["block", show block_idx, "_h_out"]) h_out
  let x_out = tensor_add x_attn h_out
  let _ = dump_tensor (cat ["block", show block_idx, "_x_out"]) x_out
  x_out

unpack_one_block weights base =
  let w0 = list_nth base weights
  let w1 = list_nth (base + 1) weights
  let w2 = list_nth (base + 2) weights
  let w3 = list_nth (base + 3) weights
  let w4 = list_nth (base + 4) weights
  let w5 = list_nth (base + 5) weights
  let w6 = list_nth (base + 6) weights
  let w7 = list_nth (base + 7) weights
  let w8 = list_nth (base + 8) weights
  cons w0 (cons w1 (cons w2 (cons w3 (cons w4 (cons w5 (cons w6 (cons w7 (cons w8 []))))))))

unpack_blocks_loop weights idx count acc =
  if count <= 0 then reverse acc
  else
    let b = unpack_one_block weights idx
    unpack_blocks_loop weights (idx + 9) (count - 1) (cons b acc)

unpack_blocks weights start n_blocks =
  unpack_blocks_loop weights start n_blocks []

infer_blocks_loop x blocks seq d i n =
  if i >= n then x
  else
    let b_weights = list_nth i blocks
    let next_x = infer_block_fwd x b_weights seq d i
    infer_blocks_loop next_x blocks seq d (i + 1) n

infer_forward x w_e blocks gf seq V d =
  let x_embed = matmul_cpu x w_e
  let _ = dump_tensor "x_embed" x_embed

  let n_blocks = length blocks
  let x_last = infer_blocks_loop x_embed blocks seq d 0 n_blocks

  let packf = rmsnorm_save x_last gf
  let x_final = head packf
  let _ = dump_tensor "x_final" x_final

  let logits = matmul_cpu x_final w_e
  tensor_softmax logits

-- ───── BEGIN suspect file-level definitions (verbatim from forward_dump_cpu.rail)
-- ── Argmax across the V-wide row `row` of probs.
argmax_row_loop pd V base best_id best_val v =
  if v >= V then best_id
  else
    let cur = float_arr_get pd (base + v)
    if cur > best_val then argmax_row_loop pd V base v cur (v + 1)
    else argmax_row_loop pd V base best_id best_val (v + 1)

argmax_row probs row V_arg = match probs
  | Tensor pd shape _ ->
    let V = list_nth 1 shape
    let base = row * V
    let v0 = float_arr_get pd base
    argmax_row_loop pd V base 0 v0 1

-- ── Top-k weighted-multinomial sampling.
copy_row_loop src dst V base i =
  if i >= V then 0
  else
    let _ = float_arr_set dst i (float_arr_get src (base + i))
    copy_row_loop src dst V base (i + 1)

amax_avail_loop buf V best_id best_val i =
  if i >= V then best_id
  else
    let cur = float_arr_get buf i
    if cur > best_val then amax_avail_loop buf V i cur (i + 1)
    else amax_avail_loop buf V best_id best_val (i + 1)

topk_fill_loop buf V k i ids ws =
  if i >= k then 0
  else
    let v0 = float_arr_get buf 0
    let top_id = amax_avail_loop buf V 0 v0 1
    let top_val = float_arr_get buf top_id
    let _ = float_arr_set ids i (int_to_float top_id)
    let _ = float_arr_set ws i top_val
    let _ = float_arr_set buf top_id (0.0 - 1.0)
    topk_fill_loop buf V k (i + 1) ids ws

sum_ws_loop ws k i acc =
  if i >= k then acc
  else sum_ws_loop ws k (i + 1) (acc + float_arr_get ws i)

rng_next buf slot =
  let s = float_to_int (float_arr_get buf slot)
  let new_s = (s * 1664525 + 1013904223) % 2147483648
  let _ = float_arr_set buf slot (int_to_float new_s)
  new_s

sample_walk_loop ids ws k i u acc =
  if i >= k - 1 then float_to_int (float_arr_get ids (k - 1))
  else
    let w = float_arr_get ws i
    let new_acc = acc + w
    if u < new_acc then float_to_int (float_arr_get ids i)
    else sample_walk_loop ids ws k (i + 1) u new_acc

topk_sample probs row V_arg samp = match probs
  | Tensor pd shape _ ->
    let V = list_nth 1 shape
    let base = row * V
    let k = float_to_int (float_arr_get samp 0)
    let buf = float_arr_new V 0.0
    let _ = copy_row_loop pd buf V base 0
    let no_ws_rem = float_to_int (float_arr_get samp 2)
    let sp_id = float_to_int (float_arr_get samp 3)
    let nl_id = float_to_int (float_arr_get samp 4)
    let _ = if no_ws_rem > 0 then
              let _ = if sp_id >= 0 then float_arr_set buf sp_id (0.0 - 1.0) else 0
              let _ = if nl_id >= 0 then float_arr_set buf nl_id (0.0 - 1.0) else 0
              0
            else 0
    let ids = float_arr_new k 0.0
    let ws = float_arr_new k 0.0
    let _ = topk_fill_loop buf V k 0 ids ws
    let sum = sum_ws_loop ws k 0 0.0
    let r = rng_next samp 1
    let u = (int_to_float (r % 1000000)) / 1000000.0 * sum
    let _ = if no_ws_rem > 0 then float_arr_set samp 2 (int_to_float (no_ws_rem - 1)) else 0
    sample_walk_loop ids ws k 0 u 0.0

zero_range arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 0.0
    zero_range arr n (i + 1)

fill_prompt_loop xd ids_list V pos =
  if length ids_list == 0 then pos
  else
    let id = head ids_list
    let _ = float_arr_set xd (pos * V + id) 1.0
    fill_prompt_loop xd (tail ids_list) V (pos + 1)

ids_to_string_loop ids vocab acc =
  if length ids == 0 then acc
  else ids_to_string_loop (tail ids) vocab (cat [acc, id_char vocab (head ids)])

ids_to_string ids vocab = ids_to_string_loop ids vocab ""

argv_get_loop xs key =
  if length xs == 0 then ""
  else if head xs == key then
    if length (tail xs) > 0 then head (tail xs) else ""
  else argv_get_loop (tail xs) key

argv_get argv key default_val =
  let v = argv_get_loop argv key
  if length (chars v) == 0 then default_val else v

sanitize_loop ids acc =
  if length ids == 0 then reverse acc
  else
    let id = head ids
    let fixed = if id < 0 then 0 else id
    sanitize_loop (tail ids) (cons fixed acc)

sanitize_ids ids = sanitize_loop ids []

cond_helper x = if x == 0 then 0 else 0
plain_helper x = x + 0

gen_loop xd_full blocks w_e gf V d acc cur_pos end_pos samp =
  if cur_pos >= end_pos then reverse acc
  else
    let active = cur_pos
    let active_shape = cons active (cons V [])
    let x_active = Tensor xd_full active_shape (compute_strides active_shape)
    let probs = infer_forward x_active w_e blocks gf active V d
    let pred_row = active - 1
    let k = float_to_int (float_arr_get samp 0)
    let next_id = if k <= 1 then argmax_row probs pred_row V
                  else topk_sample probs pred_row V samp
    let _ = float_arr_set xd_full (cur_pos * V + next_id) 1.0
    gen_loop xd_full blocks w_e gf V d (cons next_id acc) (cur_pos + 1) end_pos samp
-- ───── END suspect file-level definitions

-- gen_loop is intentionally OMITTED here because it references
-- infer_forward which lives in stdlib (and was already implicitly
-- defined). Adding it later as a separate bisect step.

main =
  let prefix = argv_get args "--prefix" "runs/smoke_v54_repro/checkpoints/smoke_v54_repro_best"
  let prompt = argv_get args "--prompt" default_prompt
  let corpus_path = argv_get args "--corpus" "training/corpora/spur_compile_back_quarter.txt"
  let max_str = argv_get args "--max" default_max_gen_str
  let k_str = argv_get args "--k" "1"
  let _tau_str = argv_get args "--temp" "1.0"
  let seed_str = argv_get args "--seed" "42"
  let no_ws_str = argv_get args "--no-ws-first" "0"

  let max_gen = parse_int max_str

  let text = read_file corpus_path
  let vocab = build_vocab text
  let V = vocab_size vocab

  let have_ckpt = ckpt_exists prefix
  if not have_ckpt then
    let _ = print (cat ["ERROR: no committed checkpoint at ", prefix])
    0
  else
    let weights = load_model prefix
    let n_weights = length weights
    let n_blocks = (n_weights - 2) / 9
    if n_weights < 11 then
      let _ = print (cat ["ERROR: need at least 11 weights; got ", show n_weights])
      0
    else if check_vocab_matches V (list_nth 0 weights) == 0 then 1
    else if n_weights != 2 + 9 * n_blocks then
      let _ = print (cat ["ERROR: n_weights ", show n_weights, " is not 2 + 9*N"])
      0
    else
      let w_e = list_nth 0 weights
      let gf = list_nth 1 weights
      let blocks = unpack_blocks weights 2 n_blocks

      let raw_ids = encode vocab prompt
      let prompt_ids = sanitize_ids raw_ids
      let prompt_len = length prompt_ids
      -- TRIGGER LINE — toggle to switch between broken/correct:
      --   `let _ = length []`         → BROKEN (length contains conditional)
      --   `let _ = cond_helper 1`     → BROKEN (helper has if/else)
      --   `let _ = if 1==0 then 0 else 0` → BROKEN
      --   `let _ = 1 + 2`              → CORRECT
      --   `let _ = plain_helper 1`    → CORRECT
      --   (omit line entirely)         → CORRECT (0.020599)
      -- TRIGGER LINE — historical reproducer for the rail nullary-LHS
      -- codegen bug, FIXED 2026-05-10 in compile.rail emit_x1 caller
      -- (commit 02a6a1d). Pre-fix, this line being `let _ = if 1==0
      -- then 0 else 0` flipped subsequent `seq_len * V` to mis-compile
      -- as `<x0> * V = 0 * V = 0` → x_data sized 0 → fill_prompt_loop
      -- OOBs → matmul_cpu reads garbage. Post-fix, all variants below
      -- produce 0.020599365234375 (correct).
      --
      -- This line is the regression test: if compile.rail's emit_x1
      -- caller is ever broken again, the harness will produce ~10^-315
      -- garbage instead of 0.020599. Keep it.
      let _ = if 1 == 0 then 0 else 0
      let x_data = float_arr_new (seq_len * V) 0.0
      let _ = fill_prompt_loop x_data prompt_ids V 0

      let end_pos = prompt_len + max_gen

      let x_shape = cons prompt_len (cons V [])
      let x = Tensor x_data x_shape (compute_strides x_shape)
      let x_embed = matmul_cpu x w_e
      match x_embed
        | Tensor d _ _ ->
          let _ = print (cat ["BISECT x_embed[0]=", show_float (float_arr_get d 0)])
          0
