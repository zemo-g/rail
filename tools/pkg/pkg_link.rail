-- tools/pkg/pkg_link.rail — Action: read <pkg>/rail.toml, resolve each
-- dependency, and materialize <pkg>/vendor/<name> entries pointing at the
-- resolved package roots. Symlink first; fall back to recursive copy if
-- symlinks fail (e.g., on FS without symlink support).
--
-- Usage (run from repo root):
--   ./rail_native run tools/pkg/pkg_link.rail <pkg-dir>
--   ./rail_native run tools/pkg/pkg_link.rail              -- defaults to "."
--
-- After linking, code under <pkg> can:
--   import "vendor/<dep_name>/<file>.rail"

import "tools/pkg/pkg_lib.rail"

-- ln -snf is idempotent: replaces existing symlink without recursing.
link_one base nm resolved =
  let dest = cat [base, "/vendor/", nm]
  let cmd_ln = cat ["ln -snf '", resolved, "' '", dest, "' 2>/dev/null && echo OK || echo FAIL"]
  let r1 = chomp (shell cmd_ln)
  if r1 == "OK" then
    let _ = print (cat ["  linked   vendor/", nm, " -> ", resolved])
    0
  else
    -- Symlink failed: nuke any existing target and recursively copy.
    let cmd_cp = cat ["rm -rf '", dest, "' && cp -R '", resolved, "' '", dest, "' 2>/dev/null && echo OK || echo FAIL"]
    let r2 = chomp (shell cmd_cp)
    if r2 == "OK" then
      let _ = print (cat ["  copied   vendor/", nm, " <- ", resolved])
      0
    else
      let _ = print (cat ["  FAILED   vendor/", nm])
      1

link_all base triples =
  if length triples == 0 then 0
  else
    let t = head triples
    let nm = head t
    let src = head (tail t)
    let resolved = head (tail (tail t))
    if length resolved == 0 then
      let _ = print (cat ["  MISSING  ", nm, " <- ", src])
      let _ = link_all base (tail triples)
      1
    else
      let _ = link_one base nm resolved
      link_all base (tail triples)

count_missing_link triples =
  if length triples == 0 then 0
  else
    let t = head triples
    let resolved = head (tail (tail t))
    let here = if length resolved == 0 then 1 else 0
    here + count_missing_link (tail triples)

run_with_manifest toml base =
  let _ = shell (cat ["mkdir -p '", base, "/vendor'"])
  let pkg = parse_pkg_name toml
  let _ = if length pkg > 0 then print (cat ["# linking deps for ", pkg, " (", base, ")"]) else 0
  let deps = parse_deps toml
  if length deps == 0 then
    let _ = print "# no [dependencies]; nothing to link"
    0
  else
    let resolved = resolve_deps deps base
    let _ = link_all base resolved
    let missing = count_missing_link resolved
    if missing > 0 then
      let _ = print (cat ["# ", show missing, " unresolved dep(s)"])
      2
    else
      let _ = print "# done"
      0

main =
  let dir = pkg_dir_from_args 0
  let base = abs_dir dir
  if length base == 0 then
    let _ = print (cat ["pkg_link: directory not found: ", dir])
    1
  else
    let toml = read_manifest_at base
    if length toml == 0 then
      let _ = print (cat ["pkg_link: no rail.toml in ", base])
      1
    else run_with_manifest toml base
