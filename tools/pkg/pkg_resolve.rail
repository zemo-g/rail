-- tools/pkg/pkg_resolve.rail — Diagnostic: read <pkg>/rail.toml and print
-- each dependency with its absolute resolved path. Exit non-zero if any
-- dep cannot be resolved on disk.
--
-- Usage (run from repo root):
--   ./rail_native run tools/pkg/pkg_resolve.rail <pkg-dir>
--   ./rail_native run tools/pkg/pkg_resolve.rail            -- defaults to "."
--
-- Output is one line per dep:
--   <name>\t<absolute_resolved_path>
-- or, for failures:
--   MISSING <name>\t<unresolved_source>

import "tools/pkg/pkg_lib.rail"

print_resolved triple =
  let nm = head triple
  let src = head (tail triple)
  let resolved = head (tail (tail triple))
  if length resolved == 0 then
    let _ = print (cat ["MISSING ", nm, "\t", src])
    1
  else
    let _ = print (cat [nm, "\t", resolved])
    0

count_missing triples =
  if length triples == 0 then 0
  else
    let t = head triples
    let resolved = head (tail (tail t))
    let here = if length resolved == 0 then 1 else 0
    here + count_missing (tail triples)

print_all triples =
  if length triples == 0 then 0
  else
    let _ = print_resolved (head triples)
    print_all (tail triples)

run_with_manifest toml base =
  let pkg = parse_pkg_name toml
  let _ = if length pkg > 0 then print (cat ["# package: ", pkg, " (", base, ")"]) else 0
  let deps = parse_deps toml
  if length deps == 0 then
    let _ = print "# no [dependencies]"
    0
  else
    let resolved = resolve_deps deps base
    let _ = print_all resolved
    let missing = count_missing resolved
    if missing > 0 then
      let _ = print (cat ["# ", show missing, " unresolved dep(s)"])
      2
    else 0

main =
  let dir = pkg_dir_from_args 0
  let base = abs_dir dir
  if length base == 0 then
    let _ = print (cat ["pkg_resolve: directory not found: ", dir])
    1
  else
    let toml = read_manifest_at base
    if length toml == 0 then
      let _ = print (cat ["pkg_resolve: no rail.toml in ", base])
      1
    else run_with_manifest toml base
