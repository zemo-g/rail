-- tools/attest/publish.rail — Rail-native attestation publisher
--
-- Drop-in replacement for tools/attest/publish.sh, written entirely
-- in Rail.  Pushes attestation artifacts to ledatic.org via HTTPS PUT
-- (leaf-only TLS; auth is via X-Beacon-Token header).  Zero curl,
-- zero shell HTTP -- just Rail.
--
-- Usage:
--   ./rail_native run tools/attest/publish.rail <kind>/<ident>
--
-- Example:
--   ./rail_native run tools/attest/publish.rail releases/v3.8.0
--
-- Requires:
--   ~/.ledatic/entropy/beacon_token  -- the publish worker auth token
--   <kind>/<ident>/                  -- directory under repo root
--
-- Allowed kinds: releases | builds | selfhost.  Same allowlist the
-- worker enforces server-side.
--
-- Verified live 2026-05-01:
--   ./rail_native run tools/attest/publish.rail builds/da74797
--   -> ok  https://ledatic.org/builds/da74797/result.json status=200
--   -> ok  https://ledatic.org/builds/da74797/result.json.attestation.json status=200
--   -> builds/da74797: 2 ok, 0 fail
--
-- Currently skips the raw `rail_native` binary in releases/ because
-- `read_file` is C-string-style and truncates at the first NUL byte;
-- pushing a binary that way would silently corrupt the published
-- artifact.  publish.sh remains the path for raw rail_native until
-- a byte-aware `read_file_bytes` builtin lands.  All JSON
-- attestations + the (text) `compile.rail` source are pushed
-- correctly here.

import "stdlib/https_strict.rail"
-- https_strict transitively imports https_client (which gives us
-- https_put_unsafe_noverify) and dns (dns_resolve_a).
import "stdlib/file.rail"
import "stdlib/env.rail"
import "stdlib/dirent.rail"

site_base _ = "https://ledatic.org"

-- ── Helpers ──────────────────────────────────────────────────────────

usage _ =
  let _ = print "usage: publish.rail <kind>/<ident>"
  let _ = print "       e.g. publish.rail releases/v3.8.0"
  2

valid_kind k =
  if k == "releases" then 1
  else if k == "builds" then 1
  else if k == "selfhost" then 1
  else 0

-- Strip whitespace + trailing newline from a string (token files
-- often end with "\n").
trim_line s =
  let cs = chars s
  trim_line_acc cs ""

trim_line_acc cs acc =
  if length cs == 0 then acc
  else
    let c = head cs
    if c == "\n" then acc
    else if c == "\r" then acc
    else trim_line_acc (tail cs) (cat [acc, c])

-- Pick a Content-Type based on filename suffix.
ctype_of_path path =
  if str_ends_with path ".json" then "application/json"
  else "application/octet-stream"

str_ends_with s suffix =
  let ls = length (chars s)
  let lf = length (chars suffix)
  if lf > ls then 0
  else (str_sub s (ls - lf) lf) == suffix

-- Decide whether a file in a publish dir should be PUT.  JSON +
-- compile.rail (text source) always go.  rail_native (binary) is
-- skipped: read_file is C-string-style and truncates at the first
-- NUL byte; pushing it that way would silently corrupt the published
-- artifact.  Needs a byte-aware read_file_bytes builtin.
should_publish kind name =
  if str_ends_with name ".json" then 1
  else if kind == "releases" then
    if name == "compile.rail" then 1
    else 0
  else 0

-- ── Main publish loop ────────────────────────────────────────────────

put_one kind ident name token ip =
  let local = cat [kind, "/", ident, "/", name]
  let url = cat [site_base 0, "/", kind, "/", ident, "/", name]
  let path = cat ["/", kind, "/", ident, "/", name]
  let body = read_file local
  let ctype = ctype_of_path name
  let hdr = cat ["X-Beacon-Token: ", token]
  -- Leaf-only: auth comes from X-Beacon-Token, not TLS identity, and
  -- the strict chain-walk takes ~90 s per request on Cloudflare's
  -- chain (P-384 scalar-mult bottleneck) -- too slow for a multi-
  -- file push.
  --
  -- We've already resolved the IP once at the start of publish_dir
  -- and reuse it across all PUTs to avoid the DNS-UDP intermittent
  -- hang on Tailscale MagicDNS for back-to-back queries.
  let result = https_put_unsafe_noverify "ledatic.org" ip 443 path ctype body [hdr]
  let (status, _resp) = result
  let mark = if status == 200 then "ok " else "FAIL"
  let _ = print (cat [mark, " ", url, " status=", show status])
  if status == 200 then 0 else 1

-- Each iteration runs inside its own arena scope; without this, the
-- transient lists each PUT generates (chars-of-body, b64-filter
-- output, recv-loop chunk pairs) accumulate and a 3rd+ PUT spends
-- minutes walking a giant cons chain (`.Llen_loop`).  arena_reset
-- frees the per-PUT scratch and keeps each iteration O(1) in steady
-- state.
publish_loop kind ident files token ip ok_n fail_n =
  if length files == 0 then (ok_n, fail_n)
  else
    let name = head files
    if length (chars name) == 0 then publish_loop kind ident (tail files) token ip ok_n fail_n
    else if should_publish kind name == 0 then publish_loop kind ident (tail files) token ip ok_n fail_n
    else
      let mk = arena_mark 0
      let rc = put_one kind ident name token ip
      let _ = arena_reset mk
      let on1 = if rc == 0 then ok_n + 1 else ok_n
      let fn1 = if rc == 0 then fail_n else fail_n + 1
      publish_loop kind ident (tail files) token ip on1 fn1

publish_dir kind ident =
  let token_path = cat [getenv "HOME", "/.ledatic/entropy/beacon_token"]
  let token = trim_line (read_file token_path)
  if length (chars token) == 0 then
    let _ = print (cat ["missing beacon token: ", token_path])
    3
  else
    let local_dir = cat [kind, "/", ident]
    let files = list_dir local_dir
    if length files == 0 then
      let _ = print (cat ["empty or missing dir: ", local_dir])
      4
    else publish_dir_resolved kind ident files token

publish_dir_resolved kind ident files token =
  -- Resolve ledatic.org once and reuse the IP for every PUT.  Each
  -- fresh dns_resolve_a opens a new UDP socket and sometimes hits
  -- Tailscale-MagicDNS lossy state on back-to-back queries; pinning
  -- to the first successful resolution sidesteps that.
  let ip = dns_resolve_a "ledatic.org"
  if length ip == 0 then
    let _ = print "DNS resolve failed for ledatic.org"
    8
  else
    let counts = publish_loop kind ident files token ip 0 0
    let (ok_n, fail_n) = counts
    let _ = print (cat [kind, "/", ident, ": ", show ok_n, " ok, ", show fail_n, " fail"])
    if fail_n == 0 then 0 else 5

-- Split "<kind>/<ident>" into its two parts.
split_target s =
  let parts = str_split "/" s
  if length parts < 2 then ("", "")
  else (head parts, head (tail parts))

main =
  let user_args = tail args
  if length user_args < 1 then usage 0
  else
    let target = head user_args
    let split = split_target target
    let (kind, ident) = split
    if valid_kind kind == 0 then
      let _ = print (cat ["bad kind: ", kind, " (allowed: releases | builds | selfhost)"])
      6
    else if length (chars ident) == 0 then
      let _ = print "missing <ident> after <kind>/"
      7
    else publish_dir kind ident
