-- tools/attest/release_index.rail — emit releases/<tag>/index.json
--
-- Replaces the python heredoc that attest_release.sh used to inline.
-- Reads each artifact's attestation.json (already produced by
-- attest.rail) and assembles the release manifest.
--
-- Usage:
--   ./rail_native run tools/attest/release_index.rail \
--     <tag> <commit> <short> \
--     <bin_path> <bin_att_path> \
--     <src_path> <src_att_path>
--
-- Writes index.json to stdout (caller redirects to releases/<tag>/index.json).

import "stdlib/json.rail"
import "stdlib/file.rail"

-- Pull artifact.sha256 + beacon.pulse_id out of an attestation file.
read_attest path =
  let body = read_file path
  let p = parse_json body
  let artifact = json_get p "artifact"
  let beacon = json_get p "beacon"
  let sha = json_str (json_get artifact "sha256")
  let pid = json_int (json_get beacon "pulse_id")
  (sha, pid)

-- Build one artifact entry. Note pulse_id is emitted bare (no quotes) so
-- it parses back as a JSON number.
artifact_entry path sha pid att_basename =
  cat [
    "    {\n",
    "      \"path\": \"", path, "\",\n",
    "      \"sha256\": \"", sha, "\",\n",
    "      \"pulse_id\": ", show pid, ",\n",
    "      \"attestation\": \"", att_basename, "\"\n",
    "    }"
  ]

-- Strip directory prefix from a path.
basename path =
  let parts = str_split "/" path
  if length parts == 0 then path
  else last_part parts

last_part xs =
  if length xs == 1 then head xs
  else last_part (tail xs)

main =
  let user_args = tail args
  if length user_args < 7 then
    let _ = print "usage: release_index.rail <tag> <commit> <short> <bin_path> <bin_att> <src_path> <src_att>"
    2
  else
    let tag = head user_args
    let r1 = tail user_args
    let commit = head r1
    let r2 = tail r1
    let short = head r2
    let r3 = tail r2
    let bin_path = head r3
    let r4 = tail r3
    let bin_att = head r4
    let r5 = tail r4
    let src_path = head r5
    let src_att = head (tail r5)

    let bin_info = read_attest bin_att
    let (bin_sha, bin_pid) = bin_info
    let src_info = read_attest src_att
    let (src_sha, src_pid) = src_info

    let bin_entry = artifact_entry bin_path bin_sha bin_pid (basename bin_att)
    let src_entry = artifact_entry src_path src_sha src_pid (basename src_att)

    let body = cat [
      "{\n",
      "  \"kind\": \"ledatic.release\",\n",
      "  \"version\": 1,\n",
      "  \"tag\": \"", tag, "\",\n",
      "  \"git\": {\n",
      "    \"commit\": \"", commit, "\",\n",
      "    \"short\": \"", short, "\"\n",
      "  },\n",
      "  \"artifacts\": [\n",
      bin_entry, ",\n",
      src_entry, "\n",
      "  ]\n",
      "}"
    ]
    let _ = print body
    0
