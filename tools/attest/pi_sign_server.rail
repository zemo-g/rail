-- tools/attest/pi_sign_server.rail — Rail-native Pi-side signer.
--
-- Replaces tools/attest/pi_sign_server.py (~110 LOC Python). Same wire
-- protocol: GET /health + POST /sign with X-Sign-Token header. Shells
-- out to sign_attestation.sh exactly like the Python version did so
-- key material and Ed25519 signature shape are byte-identical.
--
-- Why: Path B from the v3.8.0 handoff. Closes the last shell-out left
-- on the attestation hot path on the Pi. Now possible because the
-- Linux ARM64 backend gained working sockets, file I/O, shell, print,
-- and float printing (master ba34d1a).
--
-- Build: ./rail_native linux tools/attest/pi_sign_server.rail
-- Deploy: scp /tmp/rail_linux fleet0:~/.ledatic/witness/pi_sign_server
--         + swap systemd ExecStart from python3 pi_sign_server.py to
--           the binary directly
--
-- Endpoints (unchanged from Python version):
--   GET /health   -> {"ok": true, "name": "<hostname>"}
--   POST /sign    -> raw JSON from sign_attestation.sh on success
-- Headers: X-Sign-Token: <token from ~/.ledatic/witness/sign_token>
-- Body for /sign: {"digest": "...", "pulse_id": N, "value_hex": "..."}

import "stdlib/socket.rail"

cat parts = join "" parts
trim s = head (split "\n" s)
q = "\""

-- ── HTTP request parsing (lifted from fleet_agent_v3.rail pattern) ──

parse_request_line line =
  let parts = split " " line
  if length parts >= 3 then
    (head parts, head (tail parts), head (tail (tail parts)))
  else ("", "", "")

parse_headers lines =
  if length lines == 0 then []
  else
    let line = head lines
    if length line <= 1 then []
    else
      let parts = split ": " line
      if length parts >= 2 then
        let name = head parts
        let value = join ": " (tail parts)
        cons (name, value) (parse_headers (tail lines))
      else parse_headers (tail lines)

get_header headers name =
  if length headers == 0 then ""
  else
    let (k, v) = head headers
    if k == name then v
    else get_header (tail headers) name

find_body lines =
  if length lines == 0 then ""
  else if length (head lines) <= 1 then join "\n" (tail lines)
  else find_body (tail lines)

parse_request raw =
  let lines = split "\n" raw
  if length lines == 0 then ("", "", [], "")
  else
    let (method, path, _v) = parse_request_line (head lines)
    let hdrs = parse_headers (tail lines)
    let body = find_body (tail lines)
    (method, path, hdrs, body)

-- ── Response builders ──────────────────────────────────────────────

-- HTTP standard requires CRLF line endings. attest.rail's client looks
-- for CRLFCRLF specifically when stripping headers, so bare LF would
-- silently lose the body on that path. (Caught testing 2026-05-02.)
http_crlf _ = cat [char_from_int 13, char_from_int 10]

mk_resp code text body =
  let crlf = http_crlf 0
  cat ["HTTP/1.1 ", show code, " ", text, crlf,
       "Content-Type: application/json", crlf,
       "Connection: close", crlf, crlf, body]

resp_ok body  = mk_resp 200 "OK"          body
resp_400 msg  = mk_resp 400 "Bad Request" (cat ["{", q, "error", q, ": ", q, msg, q, "}"])
resp_401      = mk_resp 401 "Unauthorized" (cat ["{", q, "error", q, ": ", q, "bad or missing X-Sign-Token", q, "}"])
resp_404      = mk_resp 404 "Not Found"   (cat ["{", q, "error", q, ": ", q, "not found", q, "}"])
resp_500 msg  = mk_resp 500 "Internal"    (cat ["{", q, "error", q, ": ", q, msg, q, "}"])

-- ── Token helpers ─────────────────────────────────────────────────

-- Rail's shell() doesn't inherit env vars from the parent (~ doesn't
-- expand when launched from launchd/systemd without HOME), so use the
-- absolute path that matches where deploy puts it.
load_token _ = trim (shell "cat /home/zemog/.ledatic/witness/sign_token 2>/dev/null")

clean s =
  let _ = write_file "/tmp/_pi_sign_clean.txt" s
  trim (shell "sed 's/^[[:space:]]*//' /tmp/_pi_sign_clean.txt | tr -d '\\015'")

check_auth headers token =
  if length token == 0 then false
  else
    let raw = get_header headers "X-Sign-Token"
    let provided = clean raw
    provided == token

-- ── Hex / int validation ──────────────────────────────────────────

is_hex_char c =
  let n = char_to_int c
  if n >= 48 && n <= 57 then true       -- 0-9
  else if n >= 97 && n <= 102 then true -- a-f
  else if n >= 65 && n <= 70 then true  -- A-F
  else false

is_hex_str cs =
  if cs == [] then true
  else if is_hex_char (head cs) then is_hex_str (tail cs)
  else false

is_dec_str cs =
  if cs == [] then true
  else
    let n = char_to_int (head cs)
    if n >= 48 && n <= 57 then is_dec_str (tail cs)
    else false

-- ── Field extraction from JSON body ──
-- Looking for {"digest": "...", "pulse_id": N, "value_hex": "..."}.
-- Naive but adequate: split on the field name, then split on quotes.

json_string_field body field =
  let key = cat [q, field, q]
  let parts = str_split key body
  if length parts < 2 then ""
  else
    let after = head (tail parts)
    let after_colon = str_sub after (str_find ":" after + 1) (length (chars after) - str_find ":" after - 1)
    let qp = split q after_colon
    if length qp < 2 then "" else head (tail qp)

json_int_field body field =
  let key = cat [q, field, q]
  let parts = str_split key body
  if length parts < 2 then ""
  else
    let after = head (tail parts)
    let colon_idx = str_find ":" after
    if colon_idx < 0 then ""
    else extract_int_after after (colon_idx + 1)

-- Walk forward from pos, skip whitespace, then capture digits until
-- non-digit. Plain ints only (no leading + / -).
extract_int_after s pos =
  let n = length (chars s)
  if pos >= n then ""
  else
    let c = char_to_int (str_sub s pos 1)
    if c == 32 || c == 9 then extract_int_after s (pos + 1)
    else if c >= 48 && c <= 57 then capture_digits s pos pos n
    else ""

capture_digits s start pos n =
  if pos >= n then str_sub s start (pos - start)
  else
    let c = char_to_int (str_sub s pos 1)
    if c >= 48 && c <= 57 then capture_digits s start (pos + 1) n
    else str_sub s start (pos - start)

-- ── Handlers ─────────────────────────────────────────────────────

handle_health _ =
  let host = trim (shell "hostname")
  resp_ok (cat ["{", q, "ok", q, ": true, ", q, "name", q, ": ", q, host, q, "}"])

-- escape JSON string content
json_esc s = join "\\\"" (split "\"" s)

handle_sign body =
  let digest = json_string_field body "digest"
  let pulse_id = json_int_field body "pulse_id"
  let value_hex = json_string_field body "value_hex"
  if length digest == 0 || length pulse_id == 0 || length value_hex == 0 then
    resp_400 "bad json: need digest, pulse_id, value_hex"
  else if not (is_hex_str (chars digest)) || not (is_hex_str (chars value_hex)) then
    resp_400 "digest/value_hex must be hex"
  else if not (is_dec_str (chars pulse_id)) then
    resp_400 "pulse_id must be int"
  else handle_sign_validated digest pulse_id value_hex

handle_sign_validated digest pulse_id value_hex =
  -- Inputs already validated as hex/decimal so no shell-meta sneak.
  let cmd = cat ["/home/zemog/.ledatic/witness/sign_attestation.sh ",
                 digest, " ", pulse_id, " ", value_hex]
  let out = shell cmd
  if length out == 0 then resp_500 "signer returned nothing"
  else resp_ok (trim_trailing_nl out)

trim_trailing_nl s =
  let n = length (chars s)
  if n == 0 then s
  else
    let last = str_sub s (n - 1) 1
    if last == "\n" then trim_trailing_nl (str_sub s 0 (n - 1))
    else s

route method path hdrs body token =
  if method == "GET" && path == "/health" then handle_health 0
  else if method == "POST" && path == "/sign" then
    if check_auth hdrs token then handle_sign body
    else resp_401
  else resp_404

-- ── Accept loop ──────────────────────────────────────────────────

serve_loop listen_fd token =
  let cfd = accept_tcp listen_fd
  if cfd < 0 then serve_loop listen_fd token
  else
    let mark = arena_mark 0
    let req = recv_http_request cfd
    let (method, path, hdrs, body) = parse_request req
    let _ = print (cat ["  ", method, " ", path])
    let resp = route method path hdrs body token
    let _ = send_all_tcp cfd resp
    let _ = close cfd
    let _ = arena_reset mark
    serve_loop listen_fd token

get_port _ =
  let s = trim (shell "cat /home/zemog/.ledatic/witness/sign_port 2>/dev/null")
  if length s == 0 then 9102 else parse_int s

main =
  let port = get_port 0
  let token = load_token 0
  let _ = print "Rail-native Pi signer (Path B)"
  let _ = print (cat ["  port:  ", show port])
  let _ = print (cat ["  token: ", if length token > 0 then "loaded" else "MISSING — refusing all requests"])
  let _ = print "  routes: GET /health   POST /sign"
  let lfd = bind_tcp "0.0.0.0" port
  if lfd < 0 then
    let _ = print "  FATAL: bind_tcp failed"
    1
  else
    let _ = print (cat ["  listening on 0.0.0.0:", show port])
    serve_loop lfd token
