[Unit]
Description=Attestation HTTP signer — POST /sign on the witness node
Documentation=https://github.com/zemo-g/rail/blob/master/tools/attest/pi_sign_server.py
After=network-online.target witness.service
Wants=network-online.target

[Service]
Type=simple
# Replace <your-user> with the account that owns ~/.ledatic/witness on
# this host (paths below must be absolute — systemd does not expand ~).
User=<your-user>
WorkingDirectory=~
ExecStart=/usr/bin/python3 /home/<your-user>/.ledatic/witness/pi_sign_server.py
Restart=always
RestartSec=15
StandardOutput=append:/home/<your-user>/.ledatic/witness/attest_sign.log
StandardError=append:/home/<your-user>/.ledatic/witness/attest_sign.err

[Install]
WantedBy=multi-user.target
