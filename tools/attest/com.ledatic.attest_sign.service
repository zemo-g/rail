[Unit]
Description=Attestation HTTP signer — POST /sign over Tailscale
Documentation=https://github.com/zemo-g/rail/blob/master/tools/attest/pi_sign_server.py
After=network-online.target witness.service
Wants=network-online.target

[Service]
Type=simple
User=zemog
WorkingDirectory=/home/zemog
ExecStart=/usr/bin/python3 /home/zemog/.ledatic/witness/pi_sign_server.py
Restart=always
RestartSec=15
StandardOutput=append:/home/zemog/.ledatic/witness/attest_sign.log
StandardError=append:/home/zemog/.ledatic/witness/attest_sign.err

[Install]
WantedBy=multi-user.target
