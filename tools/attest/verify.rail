-- tools/attest/verify.rail — Rail-native attestation verifier
--
-- Drop-in replacement for tools/attest/verify.sh, written entirely in
-- Rail.  Closes the meta-loop: a Rail release can now be verified by
-- a Rail program.  No openssl, no python, no shell -- just Rail.
--
-- Usage:
--   ./rail_native run tools/attest/verify.rail <input> <attestation> [pubkey.pem]
--
-- Handles both text artifacts (JSON manifests, frame metadata,
-- compile.rail) and binary releases (rail_native).  Binary input
-- goes through the `read_file_bytes` builtin (added 2026-05-01),
-- which reads the file directly into a Rail int array via
-- fopen+fread without the NUL-truncation step that limited
-- `read_file`.

import "stdlib/sha256.rail"
-- transitively imports stdlib/bytes.rail (string_to_bytes / hex_to_bytes
-- / bytes_to_hex / be32_write / arr_slice / sha_*).
import "stdlib/x25519.rail"
import "stdlib/sha512.rail"
import "stdlib/ed25519.rail"
import "stdlib/base64.rail"
import "stdlib/json.rail"
import "stdlib/env.rail"
import "stdlib/file.rail"
import "stdlib/stat.rail"

-- ── PEM armor strip + extract Ed25519 raw pubkey ─────────────────────
-- Ed25519 SubjectPublicKeyInfo DER = 12-byte prefix + 32 bytes raw key.
-- We take the trailing 32 bytes of the decoded body.

pem_strip_step lines acc =
  let line = head lines
  let rest = tail lines
  let next_acc = cat [acc, line]
  if str_contains "-----" line then pem_strip_headers rest acc
  else pem_strip_headers rest next_acc

pem_strip_headers lines acc =
  if length lines == 0 then acc
  else pem_strip_step lines acc

pem_der pem_text =
  let lines = str_split "\n" pem_text
  base64_decode_bytes (pem_strip_headers lines "")

pem_extract_pubkey pem_text =
  let der = pem_der pem_text
  let n = arr_len der
  arr_slice der (n - 32) 32

-- 1 when the file holds a PEM body of at least the 32-byte Ed25519 key.
pubkey_ok pub_path =
  if readable pub_path == 0 then 0
  else if arr_len (pem_der (read_file pub_path)) < 32 then 0
  else 1

foreign malloc size -> ptr

-- The path as a fresh NUL-terminated C buffer. A runtime string (argv) reaches
-- a foreign char* as its heap-object pointer, not its bytes, so access(2) on
-- an argv path tests a garbage name and says "missing" (literals pass
-- cleanly, which hides it; stdlib/sqlite.rail's sq_strdup is the same fix).
c_path s = c_path_into s (malloc ((length (chars s)) + 1)) 0 (length (chars s))
c_path_into s buf i n =
  if i >= n then (let _ = byte_set buf i 0 in buf)
  else let _ = byte_set buf i (char_to_int (str_sub s i 1)) in c_path_into s buf (i + 1) n

-- 1 when access(2) says the path can be read (R_OK), else 0.
readable path =
  let c = c_path path
  let rc = access c 4
  let _ = free c
  if rc == 0 then 1 else 0

-- A field of a parsed JSON value, or ["null"] when the value is not an
-- object: json_get walks an object's pairs and segfaults on anything else.
obj_get v key =
  if head v == "obj" then json_get v key else ["null"]

-- ── Reconstruct the canonical message the witness signed ─────────────
build_message digest pulse_id value_hex witnessed_at =
  cat ["attest|v1|", digest, "|", show pulse_id, "|", value_hex, "|", show witnessed_at]

-- ── Verifier stages ──────────────────────────────────────────────────
verify_sig pub_path want_digest pulse_id value_hex witnessed_at sig_b64 pk_fp name =
  let pem_text = read_file pub_path
  let pub_bytes = pem_extract_pubkey pem_text
  let msg = build_message want_digest pulse_id value_hex witnessed_at
  let msg_bytes = string_to_bytes msg
  let msg_len = string_length_bytes msg
  let sig_bytes = base64_decode_bytes sig_b64
  let ok = ed25519_verify pub_bytes msg_bytes msg_len sig_bytes
  if ok == 1 then
    let _ = print (cat ["ok  artifact=", name, "  pulse_id=", show pulse_id, "  pk_fp=", pk_fp])
    0
  else
    let _ = print "BAD signature"
    6

-- Pull the artifact's display name from either schema (artifact.name
-- or frame.url).
pick_artifact_name att =
  let artifact = json_get att "artifact"
  let frame = json_get att "frame"
  let n_art = if (head artifact) == "obj" then json_str (json_get artifact "name") else ""
  let n_frame = if (head frame) == "obj" then json_str (json_get frame "url") else ""
  if length (chars n_art) > 0 then n_art else n_frame

-- sha256_hex of a file's raw bytes.  Reads through read_file_bytes_open
-- (stdlib/file.rail), which returns a real int array.  NOTE: the bare
-- `read_file_bytes` builtin returns a string-like buffer whose arr_len
-- reads its first bytes as the length (e.g. 0x6161 for "aa") -- using it
-- with arr_len/sha_copy_bytes overruns and segfaults on any file with
-- bytes >=128.  Open the file explicitly to get the array form.
sha256_hex_file path =
  let fp = fopen path "rb"
  let bytes = if fp == 0 then arr_new 0 0 else read_file_bytes_open fp path
  let n = arr_len bytes
  let h = sha256_h_init 0
  let k_tbl = sha256_k_table 0
  let state = arr_new 8 0
  let end = sha_process_from bytes n h state k_tbl 0
  let _ = sha_final_block bytes n h state k_tbl end
  let out = arr_new 32 0
  let _ = be32_write out 0 (arr_get h 0)
  let _ = be32_write out 4 (arr_get h 1)
  let _ = be32_write out 8 (arr_get h 2)
  let _ = be32_write out 12 (arr_get h 3)
  let _ = be32_write out 16 (arr_get h 4)
  let _ = be32_write out 20 (arr_get h 5)
  let _ = be32_write out 24 (arr_get h 6)
  let _ = be32_write out 28 (arr_get h 7)
  bytes_to_hex out 32

-- Refuse before reading anything that is not there, with verify.sh's exits
-- (3 no file, 4 no key, 5 no witness digest). Until 2026-10-05 a missing,
-- empty or malformed attestation segfaulted here (exit 139), a missing input
-- read as "digest mismatch" and a missing pubkey as "BAD signature".
-- Existence is access(2) (is_readable), not fopen: the runtime's _fopen
-- returns the errno of a failed open (2 for a missing file) where callers
-- expect 0, so read_file_size and read_file read stderr instead.
verify_one input_path att_path pub_path =
  if readable input_path == 0 then
    let _ = print (cat ["BAD no input: ", input_path])
    3
  else if readable att_path == 0 then
    let _ = print (cat ["BAD no attestation: ", att_path])
    3
  else if read_file_size att_path < 1 then
    let _ = print (cat ["BAD no attestation: ", att_path])
    3
  else if pubkey_ok pub_path == 0 then
    let _ = print (cat ["BAD no Ed25519 key in pubkey: ", pub_path])
    4
  else verify_att input_path (parse_json (read_file att_path)) pub_path

verify_att input_path att pub_path =
  let witness = obj_get att "witness"
  let want_digest = json_str (obj_get witness "digest_sha256")
  if length (chars want_digest) == 0 then
    let _ = print "BAD no witness.digest_sha256 in attestation"
    5
  else
    let pulse_id = json_int (obj_get witness "pulse_id")
    let value_hex = json_str (obj_get witness "value_hex")
    let witnessed_at = json_int (obj_get witness "witnessed_at")
    let sig_b64 = json_str (obj_get witness "sig")
    let pk_fp = json_str (obj_get witness "pk_fp")
    let name = pick_artifact_name att
    let have_digest = sha256_hex_file input_path
    if have_digest != want_digest then
      let _ = print (cat ["BAD digest mismatch: file=", have_digest, " att=", want_digest])
      5
    else verify_sig pub_path want_digest pulse_id value_hex witnessed_at sig_b64 pk_fp name

default_pub_path _ = cat [getenv "HOME", "/.ledatic/witness/fleet0.pub.pem"]

nth_user_arg user_args n =
  let rest = drop_n n user_args
  head rest

drop_n n xs =
  if n == 0 then xs
  else if length xs == 0 then xs
  else drop_n (n - 1) (tail xs)

resolve_pub_path user_args argc =
  if argc < 3 then default_pub_path 0
  else nth_user_arg user_args 2

main =
  -- args[0] is the program path; user args start at args[1].
  let user_args = tail args
  let argc = length user_args
  if argc < 2 then
    let _ = print "usage: verify.rail <input> <attestation> [pubkey.pem]"
    2
  else
    let input_path = head user_args
    let att_path = head (tail user_args)
    let pub_path = resolve_pub_path user_args argc
    verify_one input_path att_path pub_path
