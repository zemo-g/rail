-- tools/attest/verify.rail — Rail-native attestation verifier
--
-- Drop-in replacement for tools/attest/verify.sh, written entirely in
-- Rail.  Closes the meta-loop: a Rail release can now be verified by
-- a Rail program.  No openssl, no python, no shell -- just Rail.
--
-- Usage:
--   ./rail_native run tools/attest/verify.rail <input> <attestation> [pubkey.pem]
--
-- Current scope: TEXT artifacts (compile.rail attestations, release
-- manifests, frame metadata, fleet status snapshots).  Binary releases
-- (`rail_native`) need a byte-aware file reader: the `read_file`
-- builtin is C-string-style and truncates at the first NUL.  See the
-- thesis-audit memory for the runtime punch list.

import "stdlib/sha256.rail"
-- transitively imports stdlib/bytes.rail (string_to_bytes / hex_to_bytes
-- / bytes_to_hex / be32_write / arr_slice / sha_*).
import "stdlib/x25519.rail"
import "stdlib/sha512.rail"
import "stdlib/ed25519.rail"
import "stdlib/base64.rail"
import "stdlib/json.rail"
import "stdlib/env.rail"

-- ── PEM armor strip + extract Ed25519 raw pubkey ─────────────────────
-- Ed25519 SubjectPublicKeyInfo DER = 12-byte prefix + 32 bytes raw key.
-- We take the trailing 32 bytes of the decoded body.

pem_strip_step lines acc =
  let line = head lines
  let rest = tail lines
  let next_acc = cat [acc, line]
  if str_contains "-----" line then pem_strip_headers rest acc
  else pem_strip_headers rest next_acc

pem_strip_headers lines acc =
  if length lines == 0 then acc
  else pem_strip_step lines acc

pem_extract_pubkey pem_text =
  let lines = str_split "\n" pem_text
  let body = pem_strip_headers lines ""
  let der = base64_decode_bytes body
  let n = arr_len der
  arr_slice der (n - 32) 32

-- ── Reconstruct the canonical message the witness signed ─────────────
build_message digest pulse_id value_hex witnessed_at =
  cat ["attest|v1|", digest, "|", show pulse_id, "|", value_hex, "|", show witnessed_at]

-- ── Verifier stages ──────────────────────────────────────────────────
verify_sig pub_path want_digest pulse_id value_hex witnessed_at sig_b64 pk_fp name =
  let pem_text = read_file pub_path
  let pub_bytes = pem_extract_pubkey pem_text
  let msg = build_message want_digest pulse_id value_hex witnessed_at
  let msg_bytes = string_to_bytes msg
  let msg_len = string_length_bytes msg
  let sig_bytes = base64_decode_bytes sig_b64
  let ok = ed25519_verify pub_bytes msg_bytes msg_len sig_bytes
  if ok == 1 then
    let _ = print (cat ["ok  artifact=", name, "  pulse_id=", show pulse_id, "  pk_fp=", pk_fp])
    0
  else
    let _ = print "BAD signature"
    6

-- Pull the artifact's display name from either schema (artifact.name
-- or frame.url).
pick_artifact_name att =
  let artifact = json_get att "artifact"
  let frame = json_get att "frame"
  let n_art = if (head artifact) == "obj" then json_str (json_get artifact "name") else ""
  let n_frame = if (head frame) == "obj" then json_str (json_get frame "url") else ""
  if length (chars n_art) > 0 then n_art else n_frame

verify_one input_path att_path pub_path =
  let att_text = read_file att_path
  let att = parse_json att_text
  let witness = json_get att "witness"
  let want_digest = json_str (json_get witness "digest_sha256")
  let pulse_id = json_int (json_get witness "pulse_id")
  let value_hex = json_str (json_get witness "value_hex")
  let witnessed_at = json_int (json_get witness "witnessed_at")
  let sig_b64 = json_str (json_get witness "sig")
  let pk_fp = json_str (json_get witness "pk_fp")
  let name = pick_artifact_name att
  let body = read_file input_path
  let have_digest = sha256_hex body
  if have_digest != want_digest then
    let _ = print (cat ["BAD digest mismatch: file=", have_digest, " att=", want_digest])
    5
  else verify_sig pub_path want_digest pulse_id value_hex witnessed_at sig_b64 pk_fp name

default_pub_path _ = cat [getenv "HOME", "/.ledatic/witness/fleet0.pub.pem"]

nth_user_arg user_args n =
  let rest = drop_n n user_args
  head rest

drop_n n xs =
  if n == 0 then xs
  else if length xs == 0 then xs
  else drop_n (n - 1) (tail xs)

resolve_pub_path user_args argc =
  if argc < 3 then default_pub_path 0
  else nth_user_arg user_args 2

main =
  -- args[0] is the program path; user args start at args[1].
  let user_args = tail args
  let argc = length user_args
  if argc < 2 then
    let _ = print "usage: verify.rail <input> <attestation> [pubkey.pem]"
    2
  else
    let input_path = head user_args
    let att_path = head (tail user_args)
    let pub_path = resolve_pub_path user_args argc
    verify_one input_path att_path pub_path
