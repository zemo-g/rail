-- test_researcher.rail — minimal smoke for researcher.rail primitives.
-- Verifies the file parses + links; does NOT actually compile Metal or
-- run a bench (both would shell out; we're just checking Rail-side).
--
-- Usage: ./rail_native run tools/labrat/test_researcher.rail

import "tools/labrat/researcher.rail"

main =
  let _ = print "=== researcher.rail smoke ==="
  -- Snapshot/restore round-trip on a throwaway file.
  let _ = write_file "/tmp/lb_test_src.txt" "hello labrat\n"
  let _ = snapshot_file "/tmp/lb_test_src.txt" "/tmp/lb_test_src.snap"
  let _ = write_file "/tmp/lb_test_src.txt" "MUTATED\n"
  let _ = restore_file "/tmp/lb_test_src.snap" "/tmp/lb_test_src.txt"
  let back = read_file "/tmp/lb_test_src.txt"
  let _ = print (cat ["  snapshot/restore: ", if back == "hello labrat\n" then "OK" else "FAIL"])

  -- apply_patch: trivial string replacement.
  let _ = apply_patch "/tmp/lb_test_src.txt" "labrat" "labrat_v2"
  let patched = read_file "/tmp/lb_test_src.txt"
  let _ = print (cat ["  apply_patch: ", if patched == "hello labrat_v2\n" then "OK" else "FAIL"])

  -- run_bench parse tolerance — synthetic output.
  let _ = write_file "/tmp/lb_fake_bench.sh" "#!/bin/sh\necho 'Device: Apple M1 Ultra'\necho 'N=1024  f32=1266 GFLOPS  f16=2149 GFLOPS  speedup=1.70x'\n"
  let _ = shell "chmod +x /tmp/lb_fake_bench.sh"
  let spd = run_bench "/tmp/lb_fake_bench.sh"
  let _ = print (cat ["  run_bench (synth speedup=1.70x): got ", show_float spd])

  -- Do NOT exercise compile_metal here — it would invoke xcrun and we
  -- want the smoke to stay hermetic. Just confirm the symbol exists.
  let _ = print "  compile_metal: [linked, not invoked in smoke]"
  let _ = print "=== done ==="
  0
