-- researcher.rail — sandboxed toolbox for the labrat agent.
-- Phase 5.0 scaffold (2026-04-20 PM). Compile + bench primitives wired.
--
-- Exports:
--   snapshot_file path snap_path
--   restore_file snap_path path
--   apply_patch path find_text replace_text  -- naive string replace for v0
--   compile_metal source_path out_path       -- 1 = OK, 0 = FAIL
--   run_bench bench_bin                      -- returns speedup float (0.0 on parse fail)

-- ──────────────────────────────────────────────────────────────────────────────
-- SNAPSHOT / RESTORE — mirrors nnzap's snapshot protocol
-- ──────────────────────────────────────────────────────────────────────────────

snapshot_file path snap_path =
  let _ = shell (cat ["cp ", path, " ", snap_path])
  1

restore_file snap_path path =
  let _ = shell (cat ["cp ", snap_path, " ", path])
  1

-- ──────────────────────────────────────────────────────────────────────────────
-- APPLY PATCH — v0: naive find+replace. v1: proper diff application.
-- ──────────────────────────────────────────────────────────────────────────────

apply_patch path find_text replace_text =
  let content = read_file path
  let new_content = str_replace find_text replace_text content
  let _ = write_file path new_content
  1

-- ──────────────────────────────────────────────────────────────────────────────
-- COMPILE — xcrun metal → .air, then metallib → .metallib.
--
-- We let the shell chain both tools and stamp OK / FAIL sentinels on stdout.
-- Rail's `shell` returns combined stdout, so we inspect the trailing token.
-- Intermediate .air lives alongside out_path with a fixed suffix so two
-- concurrent compiles of *different* out_paths don't collide (same out_path
-- is the caller's problem — this is a per-variant tool).
-- ──────────────────────────────────────────────────────────────────────────────

compile_metal source_path out_path =
  let air_path = cat [out_path, ".air"]
  let cmd = cat [
    "xcrun -sdk macosx metal -c ", source_path, " -o ", air_path,
    " 2>&1 && xcrun -sdk macosx metallib ", air_path, " -o ", out_path,
    " 2>&1 && echo __LABRAT_OK__ || echo __LABRAT_FAIL__"]
  let out = shell cmd
  let ok = str_contains "__LABRAT_OK__" out
  let _ = if ok
    then print (cat ["researcher: compile_metal OK  ", source_path, " -> ", out_path])
    else print (cat ["researcher: compile_metal FAIL  ", source_path, "\n", out])
  if ok then 1 else 0

-- ──────────────────────────────────────────────────────────────────────────────
-- BENCH — run bench binary, parse "N=1024" row, return speedup as float.
--
-- Tolerant to two output shapes:
--   (a) key=value: "... speedup=1.70x ..."          ← aspirational / grep-friendly
--   (b) column:    "  1024  ...   1.70x"            ← fp16_probe.m's current printf
-- Returns 0.0 on parse failure so callers can gate on `>= threshold`.
-- ──────────────────────────────────────────────────────────────────────────────

-- Return first line from `lines` that matches our N=1024 criterion, else "".
rb_pick_line lines =
  if length lines == 0 then ""
  else
    let h = head lines
    let has_eq = str_contains "N=1024" h
    let first_tok = head (filter (\s -> length (chars s) > 0) (str_split " " h))
    let has_col = if first_tok == "1024" then true else false
    if has_eq then h
    else if has_col then h
    else rb_pick_line (tail lines)

-- Given a line, try to pull the speedup number. Strategy:
--   1. If "speedup=" appears, take the substring after it up to the first 'x'.
--   2. Else take the last whitespace-separated token; strip trailing 'x'.
rb_extract_speedup line =
  let sp_idx = str_find "speedup=" line
  if sp_idx >= 0 then
    let after = str_sub line (sp_idx + 8) (length line - sp_idx - 8)
    let x_idx = str_find "x" after
    let num_str = if x_idx < 0 then after else str_sub after 0 x_idx
    parse_float num_str
  else
    let toks = filter (\s -> length (chars s) > 0) (str_split " " line)
    if length toks == 0 then 0.0 - 1.0
    else
      let last_tok = head (reverse toks)
      let n = length last_tok
      let trimmed = if n > 0 && str_sub last_tok (n - 1) 1 == "x"
        then str_sub last_tok 0 (n - 1)
        else last_tok
      parse_float trimmed

run_bench bench_bin =
  let out = shell (cat [bench_bin, " 2>&1"])
  let lines = str_split "\n" out
  let line = rb_pick_line lines
  if length (chars line) == 0 then
    let _ = print (cat ["researcher: run_bench FAIL — no N=1024 row from ", bench_bin])
    0.0
  else
    let spd = rb_extract_speedup line
    let _ = print (cat ["researcher: run_bench ", bench_bin, "  speedup=", show spd])
    if spd < 0.0 then 0.0 else spd
