-- test_loop.rail — passes via a small recursive sum.
sum_to n =
  if n <= 0 then 0
  else n + sum_to (n - 1)

main =
  let total = sum_to 100
  -- Gauss: 100*101/2 = 5050
  if total == 5050 then
    let _ = print "PASS"
    0
  else
    let _ = print (cat ["FAIL: sum_to 100 = ", show total])
    1
