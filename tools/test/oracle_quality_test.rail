-- oracle_quality scoring test. Verifies the degenerate-beats-trained
-- trap gets resolved: degenerate inputs now score 0, real Rail scores >0.
import "stdlib/oracle.rail"

main =
  let _ = print "=== oracle_quality_test ==="

  -- Case 1: empty string → compile fails (no main), score 0.
  let empty_q = oracle_quality ""
  let _ = print (cat ["empty string            quality = ", show empty_q, "  (expect 0)"])

  -- Case 2: whitespace only → compiles as empty program, but 0
  -- non-whitespace → fails threshold, score 0.
  let ws = "                                                                \n\n\n"
  let ws_q = oracle_quality ws
  let _ = print (cat ["whitespace only (66ch)  quality = ", show ws_q, "  (expect 0)"])

  -- Case 3: single token repeated → low diversity → fails threshold.
  let rep = "ttttttttttttttttttttttttttttttttttttttttttttttttt"
  let rep_q = oracle_quality rep
  let _ = print (cat ["single-char spam (49ch) quality = ", show rep_q, "  (expect 0)"])

  -- Case 4: compile failure (syntax garbage) with some substance.
  -- New metric rewards partial progress, so expect SMALL positive.
  -- Still must be << valid-Rail score.
  let garbage = "??? this is not rail !!!\nlet x = = ;;\n"
  let garbage_q = oracle_quality garbage
  let _ = print (cat ["garbage (non-compiling) quality = ", show garbage_q, "  (expect small >0)"])

  -- Case 5: real Rail program with a helper decl — should score >>0.
  -- Updated 2026-04-20: must have ≥ oracle_min_decls_for_bonus top-level
  -- decls to qualify for the compile bonus. Old single-`main=` body
  -- version now (correctly) scores 0 under the tightened rule.
  let good = "fact n = if n <= 1 then 1 else n * fact (n - 1)\nmain =\n  let _ = print (show (fact 5))\n  0\n"
  let good_q = oracle_quality good
  let _ = print (cat ["valid Rail (~90 chars)  quality = ", show good_q, "  (expect >0)"])

  -- Case 6: larger valid Rail — should score even higher.
  let bigger = "add a b = a + b\nmul a b = a * b\nsquare x = mul x x\nmain =\n  let r = square (add 3 4)\n  print (show r)\n"
  let bigger_q = oracle_quality bigger
  let _ = print (cat ["valid Rail (~130 chars) quality = ", show bigger_q, "  (expect >good_q)"])

  -- Case 7 (2026-04-20): tightened-threshold regression. A one-liner
  -- that compiles cleanly but has only `main = …` scores 0 — no helper
  -- decls means no compile bonus. This is exactly the `main = 0\n`-class
  -- degenerate-attractor the threshold bump is meant to kill.
  let trivia = "main = let _ = print (show 5) in 0\n"
  let trivia_q = oracle_quality trivia
  let _ = print (cat ["trivial 1-decl compile  quality = ", show trivia_q, "  (expect 0)"])

  -- Report baseline pass/fail
  let ok1 = empty_q == 0
  let ok2 = ws_q == 0
  let ok3 = rep_q == 0
  -- Garbage: small positive, must be dominated by valid Rail.
  let ok4a = garbage_q > 0
  let ok4b = garbage_q < good_q
  let ok4 = if ok4a then ok4b else false
  let ok5 = good_q > 0
  let ok6 = bigger_q > good_q
  let ok7 = trivia_q == 0
  let _ = print ""
  let _ = print (cat ["empty==0:          ", if ok1 then "PASS" else "FAIL"])
  let _ = print (cat ["whitespace==0:     ", if ok2 then "PASS" else "FAIL"])
  let _ = print (cat ["single-char==0:    ", if ok3 then "PASS" else "FAIL"])
  let _ = print (cat ["garbage: 0<x<good: ", if ok4 then "PASS" else "FAIL"])
  let _ = print (cat ["valid > 0:         ", if ok5 then "PASS" else "FAIL"])
  let _ = print (cat ["bigger > valid:    ", if ok6 then "PASS" else "FAIL"])
  let _ = print (cat ["1-decl trivia == 0:", if ok7 then "PASS" else "FAIL"])
  0
