-- tools/test/concurrent_select_test.rail
--
-- Falsification suite for the v1 `select` primitive in stdlib/concurrent.rail.
-- Cases (each prints PASS/FAIL; final stdout last-line is "PASS" iff all OK):
--
--   1. Two channels, value pre-pushed to chan A only → select returns
--      idx=0 (A's slot) and the value sent to A. Falsified by returning
--      idx=1 or B's value.
--
--   2. Two channels, neither has a value, but a producer thread pushes to
--      chan B 50ms later → select blocks then returns idx=1, B's value.
--      Falsified by returning before producer fires (idx=-1 or wrong).
--
--   3. Three channels, all pre-loaded → select must return ONE of them.
--      Repeat 12 times; each chan should win at least once across the
--      iterations to confirm fairness/non-determinism. Falsified if any
--      chan never wins (would prove starvation) — relaxed: at least 2 of
--      the 3 chans must win across 12 rounds (busy-poll fairness in v1
--      may not be perfectly uniform; documented).
--
--   4. select_with_default: 2 channels, neither ready → returns sentinel
--      idx=-1 immediately (no block).
--
-- Build before running:
--   bash tools/runtime/build_concurrent.sh
--
-- Expected exit: 0
-- Expected last-line: PASS

import "stdlib/concurrent.rail"

cat parts = join "" parts

ok label cond =
  if cond then
    let _ = print (cat ["  ok  ", label])
    1
  else
    let _ = print (cat ["  FAIL  ", label])
    0

-- ---------- Case 1: ready value on chan A ----------
case_one_ready u =
  let a = rc_chan_make 4
  let b = rc_chan_make 4
  let _ = chan_send_v a 111
  let (idx, v) = select [a, b]
  let _ = rc_chan_close a
  let _ = rc_chan_close b
  let p1 = ok "case1.a idx=0" (idx == 0)
  let p2 = ok "case1.b value=111" (v == 111)
  p1 * p2

-- ---------- Case 2: select blocks until producer fires on B ----------
-- Spawn a producer that sleeps and then pushes to chan B. Verify select
-- waited and returned idx=1 with the producer's value.
case_blocks u =
  let a = rc_chan_make 4
  let b = rc_chan_make 4
  -- Spawn a producer that sleeps then sends to b. We use the helper
  -- rc_spawn_producer which sends 1..n then closes; we send n=1 to push
  -- a single value=1. Sleep enforced by a Rail-side spin (the simplest
  -- portable thing we can rely on without a foreign sleep call).
  let pt = rc_spawn_producer b 1   -- pushes int64 value 1 to b in worker
  -- rc_spawn_producer uses the v0 raw-int channel path, so we use
  -- select_int (no unbox) to read the wire value directly.
  let (idx, v) = select_int [a, b]
  let _ = rc_join pt
  let _ = rc_chan_close a
  let _ = rc_chan_close b
  let p1 = ok "case2.a idx=1" (idx == 1)
  let p2 = ok "case2.b value=1" (v == 1)
  p1 * p2

-- ---------- Case 3: 3 channels all-ready, fairness ----------
case_fairness u =
  let n = 12
  let counts = arr_new 3 0
  let _ = fairness_loop n counts
  let c0 = arr_get counts 0
  let c1 = arr_get counts 1
  let c2 = arr_get counts 2
  let _  = print (cat ["  fairness counts: a=", show c0, " b=", show c1, " c=", show c2])
  let total_ok = (c0 + c1 + c2) == n
  let two_of_three = pos_count c0 c1 c2 >= 2
  let p1 = ok "case3.a total selections == 12" total_ok
  let p2 = ok "case3.b at least 2 of 3 chans won" two_of_three
  p1 * p2

pos_count a b c =
  let pa = if a > 0 then 1 else 0
  let pb = if b > 0 then 1 else 0
  let pc = if c > 0 then 1 else 0
  pa + pb + pc

fairness_loop n counts =
  if n <= 0 then 0
  else
    let a = rc_chan_make 4
    let b = rc_chan_make 4
    let c = rc_chan_make 4
    let _ = chan_send_v a 1
    let _ = chan_send_v b 2
    let _ = chan_send_v c 3
    let (idx, _v) = select [a, b, c]
    let prev = arr_get counts idx
    let _ = arr_set counts idx (prev + 1)
    let _ = rc_chan_close a
    let _ = rc_chan_close b
    let _ = rc_chan_close c
    fairness_loop (n - 1) counts

-- ---------- Case 4: select_with_default returns immediately ----------
case_default u =
  let a = rc_chan_make 4
  let b = rc_chan_make 4
  let (idx, v) = select_with_default [a, b] (0 - 999)
  let _ = rc_chan_close a
  let _ = rc_chan_close b
  let p1 = ok "case4.a idx=-1 sentinel" (idx == (0 - 1))
  let p2 = ok "case4.b value=default(-999)" (v == (0 - 999))
  p1 * p2

main =
  let _ = print "concurrent_select_test v1"
  let p1 = case_one_ready 0
  let p2 = case_blocks 0
  let p3 = case_fairness 0
  let p4 = case_default 0
  let total = p1 * p2 * p3 * p4
  if total == 1 then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
