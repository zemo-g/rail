-- Falsification test for _rail_mul (tagged-int LHS, boxed-float RHS).
-- Same bug class as add_int_float_ordering: the fast-path tested only LHS for
-- the tag bit, taking the int multiply for (int, heap-float) pairs.
--
-- Expected: 7.5 (3 * 2.5)
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 3
  let _ = arr_set a 1 2.5
  let v = (arr_get a 0) * (arr_get a 1)
  -- show-via-string bridges the ARM64 native-float / x86 heap-box gap (see sub_int_float_ordering).
  if show v == "7.5" then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
