-- Falsification test for _rail_gt (tagged-int LHS, boxed-float RHS).
-- Same bug class as add_int_float_ordering.
--
-- Expected: true (10 > 5.5)
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 10
  let _ = arr_set a 1 5.5
  let v = (arr_get a 0) > (arr_get a 1)
  if v then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
