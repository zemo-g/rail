-- Falsification test for _rail_sub (tagged-int LHS, boxed-float RHS).
-- Routes both operands through arr_get so the compiler cannot statically
-- infer their types and must emit a runtime _rail_sub call.
--
-- Pre-fix x86: the fast-path `test rdi,1 / jz .Lsub_float` only checked LHS.
-- For (tagged-int LHS, heap-float RHS), it took the int fast-path:
--   sar rdi,1 / sar rsi,1 / sub rdi,rsi / lea rax,[rdi*2+1]
-- which subtracts a (heap-pointer/2) from (int/2) and tags the garbage.
-- After the fix, an inserted `test rsi,1 / jz .Lsub_mixed_if` branch routes
-- (tagged-int, boxed-float) through the mirror of .Lsub_float.
--
-- Expected: 4.5 (10 - 5.5)
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 10
  let _ = arr_set a 1 5.5
  let v = (arr_get a 0) - (arr_get a 1)
  if v == 4.5 then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
