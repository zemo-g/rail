-- fp16_matmul_smoke.rail — numerical equivalence check for the fp16 matmul
-- path. 128×128 × 128×128 with a fixed-seed filling; compare tgl_matmul_f16
-- against tgl_matmul_f64; assert max-abs diff < 1e-2 (half has ~3 decimal
-- digits of precision).
--
-- Usage: ./rail_native run tools/test/fp16_matmul_smoke.rail
-- Exits non-zero on tolerance failure; prints "ok fp16" on success.

foreign tgl_init dummy -> int
foreign tgl_matmul_f64 a b c m k n -> int
foreign tgl_matmul_f16 a b c m k n -> int

-- Deterministic fill: tent-shaped values in [-0.5, 0.5] so matmul outputs
-- stay in half's normal range (~1e-4 … 6.5e4).
fill_seeded arr n seed i =
  if i >= n then 0
  else
    let x   = (i + seed) % 100
    let v   = int_to_float x / 100.0 - 0.5
    let _   = float_arr_set arr i v
    fill_seeded arr n seed (i + 1)

abs_f x = if x > 0.0 then x else 0.0 - x

-- Max abs diff over two arrays of equal length.
max_diff_loop a b n i best =
  if i >= n then best
  else
    let d = abs_f (float_arr_get a i - float_arr_get b i)
    let b2 = if d > best then d else best
    max_diff_loop a b n (i + 1) b2

main =
  let _  = tgl_init 0
  let m  = 128
  let k  = 128
  let n  = 128
  let na = m * k
  let nb = k * n
  let nc = m * n

  let a  = float_arr_new na 0.0
  let _  = fill_seeded a na 0 0
  let b  = float_arr_new nb 0.0
  let _  = fill_seeded b nb 37 0

  let c64 = float_arr_new nc 0.0
  let _   = tgl_matmul_f64 a b c64 m k n

  let c16 = float_arr_new nc 0.0
  let _   = tgl_matmul_f16 a b c16 m k n

  let md = max_diff_loop c64 c16 nc 0 0.0
  -- Float >= codegen quirk (rail_quirks.md, 2026-04-20): route via int.
  -- Tolerance 1e-2 → scale by 1e4, integer cutoff 100.
  let md_scaled = float_to_int (md * 10000.0)
  let _ = print (show_float md)
  if md_scaled >= 100 then
    let _ = print "FAIL fp16: max_diff too large"
    1
  else
    let _ = print "ok fp16"
    0
