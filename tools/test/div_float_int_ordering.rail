-- Falsification test for _rail_div (raw-f64 LHS, tagged-int RHS).
-- Mirror of div_int_float_ordering.rail with operand order reversed.
-- Pre-fix ARM64: SIGSEGV via .Ldiv_float dereferencing raw-f64 LHS bits.
--
-- Expected: 2.75 (5.5 / 2)
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 5.5
  let _ = arr_set a 1 2
  let v = (arr_get a 0) / (arr_get a 1)
  if show v == "2.75" then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
