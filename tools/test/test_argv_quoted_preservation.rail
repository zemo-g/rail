-- argv_quoted_preservation.rail — falsification test for Bug B.
--
-- Pre-fix: `./rail_native run myprog.rail "hello world" --flag` called
-- `join_args a 3`, which used `join " " lst` and re-flattened "hello world"
-- into the literal string `hello world`. compile_and_run then built
-- `shell (cat [prefix, " ", extra, " 2>&1"])`, which the shell tokenised
-- back into TWO arguments. The child saw argv[1] == "hello" and
-- argv[2] == "world", losing the quoting.
--
-- Workaround was "don't use rail_native run; build and exec directly".
--
-- Fix: introduce `shell_quote_arg`, `shell_quote_join`, and
-- `join_args_quoted`. The `run` dispatch now wraps each argv element in
-- POSIX-safe single quotes so spaces, tabs, globs, $-expansions, and
-- embedded single-quotes all survive the shell round-trip.
--
-- Falsification: write a tiny Rail program that prints `head (tail args)`,
-- the first user-supplied argv. Invoke it via `./rail_native run` with a
-- quoted argument that contains an internal space. Assert the printed
-- result is the whole quoted string, not just the first space-delimited
-- token.

-- Find the line starting with "TAG:" in a multi-line shell capture and
-- return everything after the prefix (one line only).
extract_tag_in lines =
  if length lines == 0 then "MISSING_TAG"
  else
    let line = head lines
    if str_starts_with "TAG:" line then str_after "TAG:" line
    else extract_tag_in (tail lines)

extract_tag s = extract_tag_in (split "\n" s)

-- str_starts_with / str_after may not be in scope by default; provide
-- pure-Rail fallbacks that don't depend on stdlib imports.
str_starts_with p s =
  let pl = length p
  if length s < pl then false
  else str_sub s 0 pl == p

str_after p s =
  let pl = length p
  str_sub s pl (length s - pl)

main =
  -- Child program: prints argv[1] verbatim. `./rail_native run file.rail
  -- <user_args>` compiles file.rail and execs the resulting binary with
  -- <user_args>. The child's args = [<binary_path>, <user_args>...], so
  -- args[1] is the user's first argv (what we want to round-trip).
  -- Print a leading TAG so we can isolate the child's stdout from the
  -- compiler's "Compiling..." / "as: OK" / "ld: OK" preface that the
  -- `rail_native run` driver intermixes.
  let child = cat ["main =\n",
                   "  let n = length args\n",
                   "  if n >= 2 then\n",
                   "    let _ = print (cat [\"TAG:\", head (tail args)])\n",
                   "    0\n",
                   "  else\n",
                   "    let _ = print \"TAG:NOARGS\"\n",
                   "    0\n"]
  let _ = write_file "/tmp/rail_argv_quoted_child.rail" child

  -- The crucial input: one argv element with embedded spaces. A correct
  -- forwarder gives the child "hello world" as ONE string; the broken
  -- forwarder splits on the space and the child sees "hello".
  let out_raw = shell "./rail_native run /tmp/rail_argv_quoted_child.rail 'hello world' 2>&1"
  let out = extract_tag out_raw

  let want = "hello world"
  let ok_space = out == want

  -- Sanity: also test that a no-arg invocation does not accidentally
  -- pass when the binary swallows the argv entirely.
  let out2_raw = shell "./rail_native run /tmp/rail_argv_quoted_child.rail 2>&1"
  let out2 = extract_tag out2_raw
  -- "NOARGS" is the tag content emitted by the child when length args < 2.
  -- When the user passes no extra argv, the child should hit that branch.
  let ok_noargs = out2 == "NOARGS"
  -- Also accept the case where /tmp/rail_out is invoked with itself as
  -- argv[0] but no user argv -- still NOARGS.

  -- Bonus: argv with a literal single-quote inside. Tests the
  -- `'\''` escape sequence used by shell_quote_arg.
  let out3_raw = shell "./rail_native run /tmp/rail_argv_quoted_child.rail \"can't stop\" 2>&1"
  let out3 = extract_tag out3_raw
  let ok_apos = out3 == "can't stop"

  let _ = if ok_space then 0 else
    let _ = print (cat ["FAIL space: expected [", want, "] got [", out, "]"])
    0
  let _ = if ok_noargs then 0 else
    let _ = print (cat ["FAIL noargs: expected [NOARGS] got [", out2, "]"])
    0
  let _ = if ok_apos then 0 else
    let _ = print (cat ["FAIL apostrophe: expected [can't stop] got [", out3, "]"])
    0

  if ok_space then
    if ok_noargs then
      if ok_apos then
        let _ = print "PASS"
        0
      else 1
    else 1
  else 1
