-- Falsification test for _rail_add (tagged-int LHS, boxed-float RHS).
-- Routes both operands through arr_get so the compiler cannot statically
-- infer their types and must emit a runtime _rail_add call.
--
-- Pre-fix x86: the fast-path `test rdi,1 / jz .Ladd_heap` only checked LHS,
-- then did `add rdi, rsi / lea rax, [rdi-1]` — adding a heap pointer to a
-- tagged int produced UB. After the fix, an inserted `test rsi,1 / jz
-- .Ladd_mixed_if` branch routes (tagged-int, boxed-float) through the
-- mirror of .Ladd_mixed_fi.
--
-- Expected output: 7
--   2.0 + 5.5 = 7.5 → to_int = 7
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 2
  let _ = arr_set a 1 5.5
  let v = (arr_get a 0) + (arr_get a 1)
  let _ = print (show (to_int v))
  0
