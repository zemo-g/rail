-- repl_jit_micro_bench.rail — measure JIT lower+emit+run latency in pure Rail.
--
-- The REPL's per-line cost = JIT-or-shell eval cost. This driver runs the
-- JIT pipeline on N small expressions back-to-back and prints the wall time
-- via gettimeofday surrogate (we use shell `date +%s%N` via shell()).
--
-- The point is to isolate the JIT cost from REPL-startup cost (which the
-- batch-mode REPL also pays once per invocation but is constant ~300 ms).

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"
import "jit/lower.rail"

-- ============================================================================
-- 3 canned JIT-friendly programs.
-- ============================================================================

prog_add _ = "main = let _ = print (show (3 + 4)) in 0\n"
prog_let _ = "main = let x = 7 in let _ = print (show (x * x)) in 0\n"
prog_fact _ = "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = let _ = print (show (fact 6)) in 0\n"
prog_fib _ = "fib n = if n < 2 then n else fib (n - 1) + fib (n - 2)\nmain = let _ = print (show (fib 10)) in 0\n"
prog_str _ = "main = print \"hello\"\n"

-- Run one full JIT cycle: lower + emit + mmap+exec + free. Returns nothing
-- interesting; we only care about side effects on the wall clock.
jit_once src =
  let r = lower_source src in
  let fns = head (tail r) in
  let pool = head (tail (tail r)) in
  let heap = heap_alloc 0 in
  let res = emit_program fns pool heap in
  let buf = emitted_buf res in
  let nbytes = emitted_size res in
  let page = make_executable buf nbytes in
  let _ = call_jit_direct page heap in
  let _ = free_jit page in
  let _ = heap_free heap in
  0

jit_n src n =
  if n <= 0 then 0
  else
    let _ = jit_once src in
    jit_n src (n - 1)

-- Time `iters` JIT iterations on `src` via shell date +%s%N. Prints
-- "  label: N iters in X ms (Y ms/iter)".
time_jit label src iters =
  -- record start nanos
  let _ = shell "date +%s%N > /tmp/repl_jit_bench_t0" in
  let _ = jit_n src iters in
  let _ = shell "date +%s%N > /tmp/repl_jit_bench_t1" in
  let t0_str = read_file "/tmp/repl_jit_bench_t0" in
  let t1_str = read_file "/tmp/repl_jit_bench_t1" in
  let _ = print (cat ["  [", label, "] iters=", show iters, " t0=", strip_nl t0_str, " t1=", strip_nl t1_str]) in
  -- Compute via shell since rail-side big-int math may not have a fast modulo
  let _ = write_file "/tmp/repl_jit_bench_cmd.sh"
    (cat ["dur=$(($(cat /tmp/repl_jit_bench_t1) - $(cat /tmp/repl_jit_bench_t0))); ",
          "ms=$((dur / 1000000)); ",
          "per=$(python3 -c \"print(round($dur/1e6/", show iters, ", 2))\"); ",
          "echo \"  ", label, ": ", show iters, " iters = $ms ms total, $per ms/iter\""]) in
  let _ = shell "bash /tmp/repl_jit_bench_cmd.sh" in
  0

strip_nl s =
  let n = length (chars s) in
  if n == 0 then s
  else if str_sub s (n - 1) 1 == "\n" then str_sub s 0 (n - 1)
  else s

main =
  let _ = print "=== JIT pipeline microbench (rail-native /tmp/date +%s%N) ===" in
  let _ = time_jit "add"    (prog_add 0) 20 in
  let _ = time_jit "let"    (prog_let 0) 20 in
  let _ = time_jit "fact6"  (prog_fact 0) 20 in
  let _ = time_jit "fib10"  (prog_fib 0) 20 in
  let _ = time_jit "str_hi" (prog_str 0) 20 in
  let _ = print "  --- single-iter (warm) ---" in
  let _ = time_jit "add_1"   (prog_add 0)  1 in
  let _ = time_jit "fact6_1" (prog_fact 0) 1 in
  0
