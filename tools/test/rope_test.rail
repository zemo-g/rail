-- RoPE unit test. Verify:
--   1. At position 0, the rotation is identity (angle=0 → cos=1,sin=0).
--   2. rope_apply then rope_apply_inverse returns to original.
--   3. Rotation preserves L2 norm of each row.
import "stdlib/transformer.rail"

fill_ramp arr n =
  fill_ramp_loop arr n 0
fill_ramp_loop arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i (0.1 * int_to_float (i + 1))
    fill_ramp_loop arr n (i + 1)

my_abs x = if x < 0.0 then 0.0 - x else x

row_sumsq arr base d j acc =
  if j >= d then acc
  else
    let v = float_arr_get arr (base + j)
    row_sumsq arr base d (j + 1) (acc + v * v)

row_diff_max arr1 arr2 n i maxd =
  if i >= n then maxd
  else
    let d = my_abs ((float_arr_get arr1 i) - (float_arr_get arr2 i))
    let nm = if d > maxd then d else maxd
    row_diff_max arr1 arr2 n (i + 1) nm

main =
  let seq = 4
  let d = 8
  let n = seq * d

  -- Fill with 0.1, 0.2, ..., 3.2
  let x0 = float_arr_new n 0.0
  let _ = fill_ramp x0 n

  -- Make a copy for later identity check
  let x1 = float_arr_new n 0.0
  let _ = fill_ramp x1 n

  -- Compute L2 norm of each row (pre-rotation)
  let pre_norm_0 = row_sumsq x1 0 d 0 0.0
  let pre_norm_3 = row_sumsq x1 (3 * d) d 0 0.0

  let _ = print "=== RoPE apply (forward rotation) ==="
  let x_t = Tensor x0 (cons seq (cons d [])) (compute_strides (cons seq (cons d [])))
  let _ = rope_apply x_t

  -- Row 0 should be unchanged (position 0 → angle 0 → identity).
  let row0_diff = row_diff_max x0 x1 d 0 0.0
  let _ = print (cat ["row 0 max|diff| = ", show_float row0_diff, " (should be 0)"])

  -- Post-rotation L2 norms — rotation is orthogonal, norms preserved.
  let post_norm_0 = row_sumsq x0 0 d 0 0.0
  let post_norm_3 = row_sumsq x0 (3 * d) d 0 0.0
  let _ = print (cat ["row 0 |x|² pre=", show_float pre_norm_0, "  post=", show_float post_norm_0])
  let _ = print (cat ["row 3 |x|² pre=", show_float pre_norm_3, "  post=", show_float post_norm_3])

  -- Apply inverse, compare to original
  let _ = rope_apply_inverse x_t
  let round_trip_diff = row_diff_max x0 x1 n 0 0.0
  let _ = print (cat ["round-trip max|diff| = ", show_float round_trip_diff, " (should be ≈0)"])

  let _ = print "--- end rope_test ---"
  0
