-- gpu_fused_ops_smoke.rail — verify new GPU kernels match CPU equivalents.
-- Run: from ~/projects/rail/ — ./rail_native run tools/test/gpu_fused_ops_smoke.rail
import "stdlib/transformer.rail"

-- Fill a float_arr with deterministic small values in [-1, 1).
fill_seq arr n i =
  if i >= n then 0
  else
    let v = (int_to_float (i % 13)) * 0.1 - 0.6
    let _ = float_arr_set arr i v
    fill_seq arr n (i + 1)

-- Compare two float_arrs element-wise, return max |a-b|.
max_diff_loop a b n i acc =
  if i >= n then acc
  else
    let av = float_arr_get a i
    let bv = float_arr_get b i
    let d  = av - bv
    let ad = if d < 0.0 then 0.0 - d else d
    let na = if ad > acc then ad else acc
    max_diff_loop a b n (i + 1) na

max_diff a b n = max_diff_loop a b n 0 0.0

print_test name max_d threshold =
  let pass = max_d < threshold
  let tag  = if pass then "PASS" else "FAIL"
  let _ = print (cat [tag, " ", name, "  max_diff=", show_float max_d, "  (threshold=", show_float threshold, ")"])
  if pass then 1 else 0

main =
  let _ = print "=== gpu_fused_ops_smoke ==="
  let dim = 64
  let n_rows = 8

  -- ─── RMSNorm: GPU vs CPU ───────────────────────────────────────────────
  let total = n_rows * dim
  let x_data = float_arr_new total 0.0
  let _ = fill_seq x_data total 0
  let g_data = float_arr_new dim 1.0
  let _ = fill_seq g_data dim 7
  let cpu_y = float_arr_new total 0.0
  let cpu_rstd = float_arr_new n_rows 0.0
  let _ = rms_rows_save x_data cpu_y g_data cpu_rstd dim 0.00001 n_rows 0
  let gpu_y = float_arr_new total 0.0
  let gpu_rstd = float_arr_new n_rows 0.0
  let _ = tgl_rmsnorm_save_f64 x_data gpu_y g_data gpu_rstd dim n_rows
  let dy = max_diff cpu_y gpu_y total
  let dr = max_diff cpu_rstd gpu_rstd n_rows
  let _ = print_test "rmsnorm y    " dy 0.0001
  let _ = print_test "rmsnorm rstd " dr 0.0001

  -- ─── RoPE: GPU vs CPU ──────────────────────────────────────────────────
  let seq = 8
  let rope_total = seq * dim
  let cpu_rope = float_arr_new rope_total 0.0
  let _ = fill_seq cpu_rope rope_total 0
  let gpu_rope = float_arr_new rope_total 0.0
  let _ = fill_seq gpu_rope rope_total 0
  let _ = rope_positions cpu_rope seq dim 0 1.0
  let _ = tgl_rope_apply_f64 gpu_rope seq dim 1.0
  let drope = max_diff cpu_rope gpu_rope rope_total
  let _ = print_test "rope         " drope 0.001

  -- ─── SiLU: GPU vs CPU ──────────────────────────────────────────────────
  let n = 128
  let sx = float_arr_new n 0.0
  let _ = fill_seq sx n 0
  let cpu_sy = float_arr_new n 0.0
  let cpu_sig = float_arr_new n 0.0
  let _ = silu_fwd_loop sx cpu_sy cpu_sig n 0
  let gpu_sy = float_arr_new n 0.0
  let gpu_sig = float_arr_new n 0.0
  let _ = tgl_silu_fwd_f64 sx gpu_sy gpu_sig n
  let dsy = max_diff cpu_sy gpu_sy n
  let dss = max_diff cpu_sig gpu_sig n
  let _ = print_test "silu y       " dsy 0.0001
  let _ = print_test "silu sigmoid " dss 0.0001

  let _ = print "=== done ==="
  0
