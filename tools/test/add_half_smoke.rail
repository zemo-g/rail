-- add_half_smoke.rail — HalfTensor element-wise add correctness.
--
-- Build small + 1024-row f64 Tensors, add them via the f64 reference
-- (cast-path) and via add_half (zero-cast). Cast the half result back
-- to f64 and report max-abs-diff.
--
-- Acceptance: < 1e-3 at 128x128, < 1e-2 at 1024x1024.
--
-- Run:
--   ./rail_native tools/test/add_half_smoke.rail
--   DYLD_LIBRARY_PATH=$HOME/projects/rail/tools/metal /tmp/rail_out

import "stdlib/tensor.rail"

foreign tgl_init dummy -> int

fill_seeded arr n seed i =
  if i >= n then 0
  else
    let x = (i + seed) % 100
    let v = int_to_float x / 100.0 - 0.5
    let _ = float_arr_set arr i v
    fill_seeded arr n seed (i + 1)

max_diff_loop a b n i best =
  if i >= n then best
  else
    let raw = float_arr_get a i - float_arr_get b i
    let d = if raw > 0.0 then raw else 0.0 - raw
    let b2 = if d > best then d else best
    max_diff_loop a b n (i + 1) b2

unwrap_t t = match t | Tensor d _ _ -> d

make_tensor rows cols seed =
  let arr = float_arr_new (rows * cols) 0.0
  let _ = fill_seeded arr (rows * cols) seed 0
  Tensor arr (cons rows (cons cols [])) (compute_strides (cons rows (cons cols [])))

-- f64 reference add (skip fancy kernels; pure loop stays independent of
-- any GPU f64 dispatcher state).
ref_add_loop a b c n i =
  if i >= n then 0
  else
    let _ = float_arr_set c i (float_arr_get a i + float_arr_get b i)
    ref_add_loop a b c n (i + 1)

check_shape label rows cols =
  let A = make_tensor rows cols 0
  let B = make_tensor rows cols 37
  let n = rows * cols

  let Cref = float_arr_new n 0.0
  let _ = ref_add_loop (unwrap_t A) (unwrap_t B) Cref n 0

  let Ah = half_of_tensor A
  let Bh = half_of_tensor B
  let Ch = add_half Ah Bh
  let Cf = tensor_of_half Ch

  let md = max_diff_loop Cref (unwrap_t Cf) n 0 0.0
  let md_scaled = float_to_int (md * 100000.0)
  let _ = print (cat [label, " max_abs_diff=", show_float md, "  scaled_1e5=", show md_scaled])
  md_scaled

main =
  let _ = tgl_init 0

  let md_small = check_shape "add_half 128x128" 128 128
  let md_large = check_shape "add_half 1024x1024" 1024 1024

  -- 1e-3 at 128², 1e-2 at 1024² (scaled by 1e5: thresholds 100 and 1000).
  let fail_small = md_small >= 100
  let fail_large = md_large >= 1000

  if fail_small then
    let _ = print "FAIL add_half at 128x128"
    1
  else if fail_large then
    let _ = print "FAIL add_half at 1024x1024"
    1
  else
    let _ = print "ok add_half"
    0
