-- jit_emit_smoke.rail — Phase 2.5 smoke.
--
-- Builds a DAG containing both fusion patterns, walks for matches,
-- emits MSL for each, and prints basic shape/sanity info.
-- Byte-identity with the hand-written jit.rail strings is the next
-- phase (2.6).

import "stdlib/jit_emit.rail"

push tape node =
  let r = jit_tape_push tape node
  cons (head r) (cons (head (tail r)) [])

push_tape p = head p
push_idx p = head (tail p)

starts_with s pre =
  let n = length (chars pre)
  if length (chars s) < n then 0
  else if str_sub s 0 n == pre then 1
  else 0

main =
  let _ = print "=== Phase 2.5 — MSL emitter smoke ==="

  -- Tape: leaf x, leaf g, rmsnorm, leaf wq/wk/wv, matmul x 3, leaf h_gate,
  -- silu, leaf h_up, hadamard.
  let t = jit_tape_new 0
  let r0 = push t  (JitNode "leaf"     (cons 16 (cons 64 [])) "f32" [])
  let t0 = push_tape r0
  let i_x = push_idx r0
  let r1 = push t0 (JitNode "leaf"     (cons 64 []) "f32" [])
  let t1 = push_tape r1
  let i_g = push_idx r1
  let r2 = push t1 (JitNode "rmsnorm"  (cons 16 (cons 64 [])) "f32" (cons i_x (cons i_g [])))
  let t2 = push_tape r2
  let i_rms = push_idx r2
  let r3 = push t2 (JitNode "leaf"     (cons 64 (cons 64 [])) "f32" [])
  let t3 = push_tape r3
  let i_wq = push_idx r3
  let r4 = push t3 (JitNode "leaf"     (cons 64 (cons 64 [])) "f32" [])
  let t4 = push_tape r4
  let i_wk = push_idx r4
  let r5 = push t4 (JitNode "leaf"     (cons 64 (cons 64 [])) "f32" [])
  let t5 = push_tape r5
  let i_wv = push_idx r5
  let r6 = push t5 (JitNode "matmul"   (cons 16 (cons 64 [])) "f32" (cons i_rms (cons i_wq [])))
  let t6 = push_tape r6
  let r7 = push t6 (JitNode "matmul"   (cons 16 (cons 64 [])) "f32" (cons i_rms (cons i_wk [])))
  let t7 = push_tape r7
  let r8 = push t7 (JitNode "matmul"   (cons 16 (cons 64 [])) "f32" (cons i_rms (cons i_wv [])))
  let t8 = push_tape r8
  let r9 = push t8 (JitNode "leaf"     (cons 16 (cons 192 [])) "f32" [])
  let t9 = push_tape r9
  let i_hg = push_idx r9
  let rA = push t9 (JitNode "silu"     (cons 16 (cons 192 [])) "f32" (cons i_hg []))
  let tA = push_tape rA
  let i_silu = push_idx rA
  let rB = push tA (JitNode "leaf"     (cons 16 (cons 192 [])) "f32" [])
  let tB = push_tape rB
  let rC = push tB (JitNode "hadamard" (cons 16 (cons 192 [])) "f32" (cons i_silu (cons (push_idx rB) [])))
  let tC = push_tape rC

  let matches = walk_tape tC
  let _ = print (cat ["[walk] ", show (length matches), " match(es) found"])

  -- Emit each match's MSL and report length + first-line sanity check.
  let m0 = jit_nth 0 matches
  let m1 = jit_nth 1 matches
  let s0 = emit_msl_for_match tC m0
  let s1 = emit_msl_for_match tC m1

  let len0 = length (chars s0)
  let len1 = length (chars s1)
  let _ = print (cat ["[emit] ", match_kind m0, ": ", show len0, " chars"])
  let _ = print (cat ["[emit] ", match_kind m1, ": ", show len1, " chars"])

  -- Sanity: both should start with the MSL include.
  let pre = "#include <metal_stdlib>\n"
  let ok0 = starts_with s0 pre
  let ok1 = starts_with s1 pre
  let _ = print (cat ["[assert] match[0] starts with MSL include: ", if ok0 == 1 then "OK" else "FAIL"])
  let _ = print (cat ["[assert] match[1] starts with MSL include: ", if ok1 == 1 then "OK" else "FAIL"])

  -- Sanity: lengths must be non-trivial.
  let ok_len0 = if len0 > 800 then 1 else 0
  let ok_len1 = if len1 > 200 then 1 else 0
  let _ = print (cat ["[assert] match[0] length > 800: ", if ok_len0 == 1 then "OK" else "FAIL"])
  let _ = print (cat ["[assert] match[1] length > 200: ", if ok_len1 == 1 then "OK" else "FAIL"])

  let total = ok0 + ok1 + ok_len0 + ok_len1
  let _ = if total == 4 then print "\n=== PHASE 2.5 — GREEN: emit_msl_for_match produces MSL for both patterns ==="
          else print (cat ["\n=== FAIL — ", show total, "/4 assertions passed ==="])
  0
