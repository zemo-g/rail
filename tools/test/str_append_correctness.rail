-- Correctness smoke for _rail_str_append after the strcpy+strcat →
-- strlen+memcpy rewrite. Covers empty/empty, empty LHS, empty RHS,
-- both non-empty, and a triple-append (catches NUL-placement off-by-one).
--
-- IMPORTANT: byte-by-byte equality only. A polymorphic helper that
-- compares both strings via `==` AND ints via `==` triggers a Rail
-- first-sighting type-inference quirk: the compiler emits int-compare
-- for both, so heap-string equality silently collapses to raw pointer
-- compare. Use `byte_eq` (digit-walk) for strings and plain `==` only
-- for ints, never the same helper for both.
foreign strlen s -> int
byte_eq_loop a b i n =
  if i >= n then 1
  else if byte_at a i == byte_at b i then byte_eq_loop a b (i + 1) n
  else 0
byte_eq a b =
  let la = strlen a
  let lb = strlen b
  if la == lb then byte_eq_loop a b 0 la else 0
check_s name got want =
  if byte_eq got want == 1 then 0
  else
    let _ = print (cat ["FAIL ", name, ": got_len=", show (strlen got), " want_len=", show (strlen want)])
    1
check_i name got want =
  if got == want then 0
  else
    let _ = print (cat ["FAIL ", name, ": got=", show got, " want=", show want])
    1
main =
  let r1 = check_s "ee"        (append "" "")                   ""
  let r2 = check_s "ea"        (append "" "abc")                "abc"
  let r3 = check_s "ae"        (append "abc" "")                "abc"
  let r4 = check_s "ab"        (append "abc" "def")             "abcdef"
  let r5 = check_i "len_ee"    (length (append "" ""))                  0
  let r6 = check_i "len_long"  (length (append "abcdefghij" "klmnop"))  16
  let r7 = check_s "trip"      (append (append "ab" "cd") "ef") "abcdef"
  let total = r1 + r2 + r3 + r4 + r5 + r6 + r7
  if total == 0 then
    let _ = print "PASS"
    0
  else
    let _ = print (cat ["FAIL total=", show total])
    1
