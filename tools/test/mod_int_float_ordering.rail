-- Falsification test for _rail_mod (tagged-int LHS, boxed-float RHS).
-- Same bug class as add_int_float_ordering: the fast-path tested only LHS for
-- the tag bit, and the int-only fallback (sar; sar; idiv) corrupts when RHS
-- is a heap pointer.
--
-- Post-fix, `int % float` does float fmod via libm (mirror branch in
-- _rail_mod boxes both as doubles, calls fmod, returns boxed result).
--
-- Expected: 1.5 (10 fmod 4.25 = 1.5)
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 10
  let _ = arr_set a 1 4.25
  let v = (arr_get a 0) % (arr_get a 1)
  if v == 1.5 then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
