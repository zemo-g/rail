-- SiLU forward + backward unit test.
--   silu(0) = 0, silu(1) ≈ 0.731, silu(-∞) ≈ 0.
--   silu'(0) = 0.5, silu'(1) ≈ 0.927.
import "stdlib/transformer.rail"

my_abs x = if x < 0.0 then 0.0 - x else x

main =
  let n = 4
  let xd = float_arr_new n 0.0
  let _ = float_arr_set xd 0 0.0
  let _ = float_arr_set xd 1 1.0
  let _ = float_arr_set xd 2 (0.0 - 2.0)
  let _ = float_arr_set xd 3 3.0
  let x = Tensor xd (cons n []) (cons 1 [])

  let pack = silu_forward x
  let y = head pack
  let sig = head (tail pack)

  match y | Tensor yd _ _ ->
    let _ = print (cat ["silu(0)    = ", show_float (float_arr_get yd 0), "  exp: 0"])
    let _ = print (cat ["silu(1)    = ", show_float (float_arr_get yd 1), "  exp: 0.7311"])
    let _ = print (cat ["silu(-2)   = ", show_float (float_arr_get yd 2), "  exp: -0.2384"])
    let _ = print (cat ["silu(3)    = ", show_float (float_arr_get yd 3), "  exp: 2.8577"])

    -- backward with dy = [1, 1, 1, 1]
    let dyd = float_arr_new n 0.0
    let _ = float_arr_set dyd 0 1.0
    let _ = float_arr_set dyd 1 1.0
    let _ = float_arr_set dyd 2 1.0
    let _ = float_arr_set dyd 3 1.0
    let dy = Tensor dyd (cons n []) (cons 1 [])
    let dx = silu_backward x dy sig
    match dx | Tensor dxd _ _ ->
      let _ = print (cat ["silu'(0)   = ", show_float (float_arr_get dxd 0), "  exp: 0.5"])
      let _ = print (cat ["silu'(1)   = ", show_float (float_arr_get dxd 1), "  exp: 0.9277"])
      let _ = print (cat ["silu'(-2)  = ", show_float (float_arr_get dxd 2), "  exp: -0.0908"])
      let _ = print (cat ["silu'(3)   = ", show_float (float_arr_get dxd 3), "  exp: 1.0881"])

      let d0 = my_abs ((float_arr_get yd 0) - 0.0)
      let d1 = my_abs ((float_arr_get yd 1) - 0.7310585786300049)
      let d2 = my_abs ((float_arr_get dxd 0) - 0.5)
      let _ = print (cat ["forward max err ~= ", show_float (if d0 > d1 then d0 else d1)])
      let _ = print (cat ["backward @0 err = ", show_float d2])
      0
