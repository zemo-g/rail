-- Falsification test for _rail_le (raw-f64 LHS, tagged-int RHS).
-- Mirror of le_int_float_ordering.rail with operand order reversed.
-- Pre-fix ARM64: SIGSEGV via .Lle_float dereferencing raw-f64 LHS bits.
--
-- Expected: true (2.5 <= 5)
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 2.5
  let _ = arr_set a 1 5
  let v = (arr_get a 0) <= (arr_get a 1)
  if v then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
