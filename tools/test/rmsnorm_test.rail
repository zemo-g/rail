-- RMSNorm unit test. Flat match chain to dodge Rail's deep-match parser quirk.
import "stdlib/transformer.rail"

fill_seq_loop arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i (int_to_float (i + 1) * 0.1)
    fill_seq_loop arr n (i + 1)

ones_local arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 1.0
    ones_local arr n (i + 1)

unwrap_data t = match t | Tensor d _ _ -> d

my_abs_f x = if x < 0.0 then 0.0 - x else x

main =
  let _ = print "=== RMSNorm forward ==="
  let d = 4
  let xd = float_arr_new d 0.0
  let _ = fill_seq_loop xd d 0
  let x = Tensor xd (cons 1 (cons d [])) (compute_strides (cons 1 (cons d [])))
  let gd = float_arr_new d 0.0
  let _ = ones_local gd d 0
  let g = Tensor gd (cons d []) (cons 1 [])

  let pack = rmsnorm_save x g
  let y = head pack
  let rstd = head (tail pack)
  let yd = unwrap_data y

  let _ = print (cat ["rstd[0] = ", show_float (float_arr_get rstd 0)])
  let _ = print (cat ["y[0] = ", show_float (float_arr_get yd 0)])
  let _ = print (cat ["y[1] = ", show_float (float_arr_get yd 1)])
  let _ = print (cat ["y[2] = ", show_float (float_arr_get yd 2)])
  let _ = print (cat ["y[3] = ", show_float (float_arr_get yd 3)])

  let _ = print "=== RMSNorm backward orthogonality check ==="
  let dyd = float_arr_new d 0.0
  let _ = ones_local dyd d 0
  let dy = Tensor dyd (cons 1 (cons d [])) (compute_strides (cons 1 (cons d [])))
  let dx = rmsnorm_backward_dx x g rstd dy
  let dxd = unwrap_data dx

  let _ = print (cat ["dx[0] = ", show_float (float_arr_get dxd 0)])
  let _ = print (cat ["dx[1] = ", show_float (float_arr_get dxd 1)])
  let _ = print (cat ["dx[2] = ", show_float (float_arr_get dxd 2)])
  let _ = print (cat ["dx[3] = ", show_float (float_arr_get dxd 3)])

  let p0 = (float_arr_get dxd 0) * (float_arr_get xd 0)
  let p1 = (float_arr_get dxd 1) * (float_arr_get xd 1)
  let p2 = (float_arr_get dxd 2) * (float_arr_get xd 2)
  let p3 = (float_arr_get dxd 3) * (float_arr_get xd 3)
  let dot = p0 + p1 + p2 + p3
  let _ = print (cat ["sum dx_i * x_i = ", show_float dot, "  (should be ~0)"])
  -- Tolerance accounts for eps=1e-5 contribution to non-scale-invariance.
  -- Pure RMSNorm (eps=0) would give exactly zero.
  let passed = my_abs_f dot < 0.001
  let _ = if passed then print "PASS: backward orthogonal to x" else print "FAIL: orthogonality"
  if passed then 0 else 1
