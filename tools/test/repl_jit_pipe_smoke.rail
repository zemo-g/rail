-- repl_jit_pipe_smoke.rail — confirms the JIT pipeline can be driven
-- end-to-end via try_jit_grade on simple source. Run as a sanity check
-- BEFORE the bigger repl_jit smoke test.

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"
import "jit/lower.rail"
import "jit/grade.rail"

run_one label src expected =
  let r = try_jit_grade src
  if (head r) == "err" then
    let _ = print (cat ["[", label, "] ERR: ", head (tail r)])
    1
  else
    let got = head (tail r)
    if got == expected then
      let _ = print (cat ["[", label, "] OK got=", show got])
      0
    else
      let _ = print (cat ["[", label, "] FAIL got=", show got, " expected=", show expected])
      1

main =
  let c1 = run_one "arith"      "main = 3 + 4"                                              7
  let c2 = run_one "fact5"      "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = fact 5"  120
  let c3 = run_one "let"        "main = let x = 5 in x * x"                                 25
  let c4 = run_one "fib10"      "fib n = if n < 2 then n else fib (n-1) + fib (n-2)\nmain = fib 10"  55
  let c5 = run_one "addk"       "f x = x + 5\nmain = f 3"                                   8
  if c1 + c2 + c3 + c4 + c5 == 0 then
    let _ = print "PIPELINE PASS"
    0
  else
    let _ = print "PIPELINE FAIL"
    1
