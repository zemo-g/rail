-- Falsification test for _rail_add (raw-f64 LHS, tagged-int RHS).
-- Mirror of add_int_float_ordering.rail with operand order reversed.
-- Routes both operands through arr_get so the compiler cannot statically
-- infer types and must emit a runtime _rail_add call.
--
-- Pre-fix ARM64: `tst x1, #1; b.eq .Ladd_heap` routed (float-LHS) to the
-- heap path, which then did `ldr x2, [x1]` and dereferenced raw-f64 bits
-- as a heap pointer -> SIGSEGV. After the fix, an inserted
-- `tst x0, #1; b.ne .Ladd_mixed_fi` branch at the top of .Ladd_heap routes
-- (raw-f64, tagged-int) through the mirror of .Ladd_mixed_if.
--
-- Expected output: 7
--   5.5 + 2.0 = 7.5 -> to_int = 7
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 5.5
  let _ = arr_set a 1 2
  let v = (arr_get a 0) + (arr_get a 1)
  if show v == "7.5" then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
