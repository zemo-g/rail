-- jit_tape_smoke.rail — Phase 1.0 smoke test for the op-DAG tracer.
-- Builds the rmsnorm → 3-way QKV matmul DAG (the first fusion target per
-- the plan), executes it eagerly through the tracer, dumps the resulting
-- JitNode list.  No codegen yet — that lands in Phase 1.1.
--
-- Run from ~/projects/rail/:
--   ./rail_native run tools/test/jit_tape_smoke.rail
--
-- Expected output: 6 nodes —
--   [0] leaf x        shape=[seq, d]
--   [1] leaf g1       shape=[d]
--   [2] leaf w_q      shape=[d, d]
--   [3] leaf w_k      shape=[d, d]
--   [4] leaf w_v      shape=[d, d]
--   [5] rmsnorm       shape=[seq, d]   parents=[0,1]
--   [6] matmul (Q)    shape=[seq, d]   parents=[5,2]
--   [7] matmul (K)    shape=[seq, d]   parents=[5,3]
--   [8] matmul (V)    shape=[seq, d]   parents=[5,4]
import "stdlib/jit_tape.rail"

ones_loop arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 1.0
    ones_loop arr n (i + 1)

main =
  let _ = print "=== Phase 1.0 — op-DAG tracer smoke ==="
  let seq = 8
  let d = 4

  -- Allocate and wrap leaf tensors.
  let x_d = float_arr_new (seq * d) 0.0
  let _ = ones_loop x_d (seq * d) 0
  let x = Tensor x_d (cons seq (cons d [])) (compute_strides (cons seq (cons d [])))

  let g_d = float_arr_new d 1.0
  let _ = ones_loop g_d d 0
  let g = Tensor g_d (cons d []) (cons 1 [])

  let wq_d = float_arr_new (d * d) 0.0
  let _ = ones_loop wq_d (d * d) 0
  let wq = Tensor wq_d (cons d (cons d [])) (compute_strides (cons d (cons d [])))

  let wk_d = float_arr_new (d * d) 0.0
  let _ = ones_loop wk_d (d * d) 0
  let wk = Tensor wk_d (cons d (cons d [])) (compute_strides (cons d (cons d [])))

  let wv_d = float_arr_new (d * d) 0.0
  let _ = ones_loop wv_d (d * d) 0
  let wv = Tensor wv_d (cons d (cons d [])) (compute_strides (cons d (cons d [])))

  -- Begin tracing.
  let tape0 = jit_tape_new 0

  let r1 = jit_leaf tape0 x "f64"
  let tape1 = head r1
  let xT = head (tail r1)

  let r2 = jit_leaf tape1 g "f64"
  let tape2 = head r2
  let gT = head (tail r2)

  let r3 = jit_leaf tape2 wq "f64"
  let tape3 = head r3
  let wqT = head (tail r3)

  let r4 = jit_leaf tape3 wk "f64"
  let tape4 = head r4
  let wkT = head (tail r4)

  let r5 = jit_leaf tape4 wv "f64"
  let tape5 = head r5
  let wvT = head (tail r5)

  -- Body: rmsnorm → 3 matmuls sharing the rmsnorm output.
  let r6 = traced_rmsnorm tape5 xT gT "f64"
  let tape6 = head r6
  let lnT = head (tail r6)

  let r7 = traced_matmul tape6 lnT wqT "f64"
  let tape7 = head r7

  let r8 = traced_matmul tape7 lnT wkT "f64"
  let tape8 = head r8

  let r9 = traced_matmul tape8 lnT wvT "f64"
  let tapeF = head r9

  -- Verify DAG structure.
  let _ = jit_tape_dump tapeF

  let n = length tapeF
  let _ = print (cat ["\nexpected n=9 (5 leaves + 1 rmsnorm + 3 matmul)  got n=", show n])
  let _ = if n == 9 then print "PHASE 1.0 SCAFFOLD — GREEN" else print "FAIL"
  0
