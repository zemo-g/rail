-- transpose_half_smoke.rail — HalfTensor transpose correctness.
--
-- Transpose is pure shape permutation on packed halfs (no arithmetic),
-- so its only numeric error is the f64→f16→f64 cast rounding that
-- frames the comparison (~2^-12 ≈ 2.4e-4 on values in [-0.5, 0.5]).
-- Acceptance: < 1e-3 at 128², < 1e-2 at 1024² (S2 Mini brief).

import "stdlib/tensor.rail"

foreign tgl_init dummy -> int

fill_seeded arr n seed i =
  if i >= n then 0
  else
    let x = (i + seed) % 100
    let v = int_to_float x / 100.0 - 0.5
    let _ = float_arr_set arr i v
    fill_seeded arr n seed (i + 1)

max_diff_loop a b n i best =
  if i >= n then best
  else
    let raw = float_arr_get a i - float_arr_get b i
    let d = if raw > 0.0 then raw else 0.0 - raw
    let b2 = if d > best then d else best
    max_diff_loop a b n (i + 1) b2

unwrap_t t = match t | Tensor d _ _ -> d

make_tensor rows cols seed =
  let arr = float_arr_new (rows * cols) 0.0
  let _ = fill_seeded arr (rows * cols) seed 0
  Tensor arr (cons rows (cons cols [])) (compute_strides (cons rows (cons cols [])))

ref_transpose_loop a b m n i =
  if i >= m * n then 0
  else
    let row = i / n
    let col = i - row * n
    let _ = float_arr_set b (col * m + row) (float_arr_get a i)
    ref_transpose_loop a b m n (i + 1)

check_shape label rows cols =
  let A = make_tensor rows cols 13
  let n = rows * cols

  let Bref = float_arr_new n 0.0
  let _ = ref_transpose_loop (unwrap_t A) Bref rows cols 0

  -- cast A → half, transpose on GPU, cast back
  let Ah = half_of_tensor A
  let Bh = transpose_half Ah
  let Bf = tensor_of_half Bh

  let md = max_diff_loop Bref (unwrap_t Bf) n 0 0.0
  let md_scaled = float_to_int (md * 100000.0)
  let _ = print (cat [label, " max_abs_diff=", show_float md, "  scaled_1e5=", show md_scaled])
  md_scaled

main =
  let _ = tgl_init 0

  let md_small = check_shape "transpose_half 128x128"    128  128
  let md_large = check_shape "transpose_half 1024x1024" 1024 1024

  -- Cast-framed: 1e-3 at 128² (scaled 100) / 1e-2 at 1024² (scaled 1000).
  let fail_small = md_small >= 100
  let fail_large = md_large >= 1000

  if fail_small then
    let _ = print "FAIL transpose_half at 128x128"
    1
  else if fail_large then
    let _ = print "FAIL transpose_half at 1024x1024"
    1
  else
    let _ = print "ok transpose_half"
    0
