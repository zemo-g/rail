-- jit_emit_fuzz.rail — Phase 2.10 fuzz harness for the shape-specialized
-- emitter (jit_emit.rail: emit_msl_for_match_shaped).
--
-- Generates many (seq, d, d_ff) combinations, builds the corresponding
-- DAG via build_dag, walks for matches, emits MSL for each match, and
-- verifies:
--   1. emit returns a non-empty string starting with the MSL include.
--   2. The baked-in shape constants match what build_dag fed in.
--   3. No buffer-constant &SEQ / &D / &N references leak through.
-- Phase 2.10's full numerical-agreement fuzz (1000 cases JIT-compiled +
-- dispatched + compared against per-op reference) is deferred — Metal
-- pipeline compilation is too expensive to do 1000× in one session.
-- The shape-string fuzz catches codegen bugs that the smoke tests miss
-- and validates the v1.5 shape-extraction path.

import "stdlib/jit_emit.rail"

push tape node =
  let r = jit_tape_push tape node
  cons (head r) (cons (head (tail r)) [])

push_tape p = head p
push_idx p = head (tail p)

build_dag seq d d_ff =
  let t = jit_tape_new 0
  let r0 = push t  (JitNode "leaf"    (cons seq (cons d []))    "f32" [])
  let t0 = push_tape r0
  let i_x = push_idx r0
  let r1 = push t0 (JitNode "leaf"    (cons d [])               "f32" [])
  let t1 = push_tape r1
  let i_g = push_idx r1
  let r2 = push t1 (JitNode "rmsnorm" (cons seq (cons d []))    "f32" (cons i_x (cons i_g [])))
  let t2 = push_tape r2
  let i_rms = push_idx r2
  let r3 = push t2 (JitNode "leaf"    (cons d (cons d []))      "f32" [])
  let t3 = push_tape r3
  let i_wq = push_idx r3
  let r4 = push t3 (JitNode "leaf"    (cons d (cons d []))      "f32" [])
  let t4 = push_tape r4
  let i_wk = push_idx r4
  let r5 = push t4 (JitNode "leaf"    (cons d (cons d []))      "f32" [])
  let t5 = push_tape r5
  let i_wv = push_idx r5
  let r6 = push t5 (JitNode "matmul"  (cons seq (cons d []))    "f32" (cons i_rms (cons i_wq [])))
  let t6 = push_tape r6
  let r7 = push t6 (JitNode "matmul"  (cons seq (cons d []))    "f32" (cons i_rms (cons i_wk [])))
  let t7 = push_tape r7
  let r8 = push t7 (JitNode "matmul"  (cons seq (cons d []))    "f32" (cons i_rms (cons i_wv [])))
  let t8 = push_tape r8
  let r9 = push t8 (JitNode "leaf"    (cons seq (cons d_ff [])) "f32" [])
  let t9 = push_tape r9
  let i_hg = push_idx r9
  let rA = push t9 (JitNode "silu"    (cons seq (cons d_ff [])) "f32" (cons i_hg []))
  let tA = push_tape rA
  let i_silu = push_idx rA
  let rB = push tA (JitNode "leaf"    (cons seq (cons d_ff [])) "f32" [])
  let tB = push_tape rB
  let rC = push tB (JitNode "hadamard" (cons seq (cons d_ff [])) "f32" (cons i_silu (cons (push_idx rB) [])))
  let tC = push_tape rC
  tC

-- LCG-style deterministic pseudo-random: state in float_arr[1].
rng_new seed =
  let a = float_arr_new 1 0.0
  let _ = float_arr_set a 0 (int_to_float seed)
  a

rng_next state =
  let s = float_to_int (float_arr_get state 0)
  let new_s = (s * 1664525 + 1013904223) % 2147483648
  let _ = float_arr_set state 0 (int_to_float new_s)
  new_s

-- Pick a SEQ from {4, 8, 16, 32, 64, 128, 256, 512}.
pick_seq r =
  let opts = cons 4 (cons 8 (cons 16 (cons 32 (cons 64 (cons 128 (cons 256 (cons 512 [])))))))
  jit_nth (r % 8) opts

-- Pick a D from {16, 32, 64, 128, 192, 256}.  (Constraint: <= 256 for
-- threadgroup memory in the rmsnorm kernel.)
pick_d r =
  let opts = cons 16 (cons 32 (cons 64 (cons 128 (cons 192 (cons 256 [])))))
  jit_nth (r % 6) opts

-- d_ff = 3 * d (canonical SwiGLU ratio).
pick_dff d = 3 * d

-- Concat "constant uint D = <n>" for assertion search.
expect_d d   = cat ["constant uint D = ",   show d,   ";"]
expect_seq s = cat ["constant uint SEQ = ", show s,   ";"]
expect_n n   = cat ["constant uint N = ",   show n,   ";"]

check_one rng case_n =
  let r1 = rng_next rng
  let r2 = rng_next rng
  let seq = pick_seq r1
  let d = pick_d r2
  let d_ff = pick_dff d
  let n = seq * d_ff
  let tape = build_dag seq d d_ff
  let matches = walk_tape tape
  let mc = length matches
  let ok_match_count = if mc == 2 then 1 else 0

  let m0 = jit_nth 0 matches
  let m1 = jit_nth 1 matches
  let s_rms  = emit_msl_for_match_shaped tape m0
  let s_silu = emit_msl_for_match_shaped tape m1

  let ok_rms_seq = if str_contains (expect_seq seq) s_rms  then 1 else 0
  let ok_rms_d   = if str_contains (expect_d d)     s_rms  then 1 else 0
  let ok_silu_n  = if str_contains (expect_n n)     s_silu then 1 else 0
  let ok_no_buf  = if str_contains "&SEQ" s_rms then 0 else 1

  let pass = ok_match_count + ok_rms_seq + ok_rms_d + ok_silu_n + ok_no_buf
  let _ = if pass == 5 then 0
          else print (cat ["  case ", show case_n, " FAIL seq=", show seq, " d=", show d, " d_ff=", show d_ff,
                           "  mc=", show ok_match_count, " seq?=", show ok_rms_seq, " d?=", show ok_rms_d,
                           " n?=", show ok_silu_n, " no_buf=", show ok_no_buf])
  pass

fuzz_loop rng i n_cases passes =
  if i >= n_cases then passes
  else
    let got = check_one rng (i + 1)
    fuzz_loop rng (i + 1) n_cases (passes + got)

main =
  let _ = print "=== Phase 2.10 fuzz — shape-specialized emitter ==="
  let n_cases = 200
  let expect_per_case = 5
  let expect_total = n_cases * expect_per_case
  let rng = rng_new 12345

  let passes = fuzz_loop rng 0 n_cases 0

  let _ = print (cat ["[fuzz] ", show n_cases, " random shapes; ", show passes, "/", show expect_total, " assertions passed"])
  let ok = if passes == expect_total then 1 else 0
  let _ = if ok == 1 then print "\n=== PHASE 2.10 — GREEN: shape-emitter survives 200-case fuzz ==="
          else print "\n=== FAIL — emitter regressed on at least one shape ==="
  0
