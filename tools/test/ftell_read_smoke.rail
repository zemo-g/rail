-- Regression test for the 2026-05-14 ftell FFI codegen bug.
-- Compiles attest.rail's read_file_bytes flow on a known fixture and
-- asserts ftell returns the actual file size + read_file_bytes returns
-- a correctly-sized buffer with the right first bytes.

import "stdlib/file.rail"
import "stdlib/socket.rail"

main =
  let path = "rail_native"
  let bytes = read_file_bytes path
  let n = arr_len bytes
  let _ = print (cat ["read_file_bytes n=", show n])
  -- v5.0.0 rail_native is 1084896 bytes. Any value < 100000 is the old
  -- ftell bug (returned ~9-29 bytes regardless of file).
  if n < 100000 then
    let _ = print "FAIL: ftell returned too-small size (codegen bug regressed)"
    1
  else
    -- Mach-O magic for arm64 little-endian: CF FA ED FE
    let b0 = arr_get bytes 0
    let b1 = arr_get bytes 1
    let b2 = arr_get bytes 2
    let b3 = arr_get bytes 3
    let _ = print (cat ["b0=", show b0, " b1=", show b1, " b2=", show b2, " b3=", show b3])
    if b0 == 207 && b1 == 250 && b2 == 237 && b3 == 254 then
      let _ = print "PASS: ftell + read_file_bytes correct"
      0
    else
      let _ = print "FAIL: bytes don't match Mach-O magic CF FA ED FE"
      1
