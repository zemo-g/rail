-- Micro-bench: chained string-append accumulator.
-- Catches O(n^2) regressions in _rail_str_append. Each iteration appends
-- a 16-byte chunk to the running accumulator. With N=20000 and an O(n)
-- helper the bench finishes in <0.5 s; an O(n^2) helper (e.g. strcpy +
-- strcat, where strcat re-scans the destination on every call) is several
-- times slower and grows quadratically as N is raised.
acc_loop i n s =
  if i >= n then s
  else acc_loop (i + 1) n (append s "abcdefghijklmnop")
main =
  let final = acc_loop 0 10000 ""
  let _ = print (length final)
  0
