-- Falsification test for _rail_lt (tagged-int LHS, boxed-float RHS).
-- Comparison version of add_int_float_ordering. Pre-fix x86: the fast path
-- did `cmp rcx, rax / setl al` regardless of operand types, treating the
-- heap pointer as if it were a tagged int (signed compare on raw bytes).
--
-- Expected: true (2 < 5.5)
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 2
  let _ = arr_set a 1 5.5
  let v = (arr_get a 0) < (arr_get a 1)
  if v then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
