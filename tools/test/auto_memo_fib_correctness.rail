-- Falsification test for the auto-memoization correctness bug.
--
-- Pre-fix (rail_native@7fa3a3f): `./rail_native run` of this program
-- printed `fib 10 = 293886` instead of 55 due to the compile.rail
-- auto-memo path silently corrupting single-arg pure-int recursive
-- functions.
--
-- This test compiles cleanly and prints `PASS` only when fib 10/12/15
-- all match the canonical Fibonacci values. Three different arguments
-- catch a memo-keyed-on-stale-value bug (one arg could match by
-- coincidence; three won't).
--
-- See notes/AUTOMEMO_FIB_HANDOFF.md for the root cause + fix decision.

fib n = if n < 2 then n else fib (n - 1) + fib (n - 2)

check label got expected =
  if got == expected then 0
  else
    let _ = print (cat [label, " FAIL: got=", show got, " expected=", show expected])
    1

main =
  let a = fib 10
  let b = fib 12
  let c = fib 15
  let f1 = check "fib(10)" a 55
  let f2 = check "fib(12)" b 144
  let f3 = check "fib(15)" c 610
  let fails = f1 + f2 + f3
  let _ = if fails == 0 then print "PASS" else print "FAIL"
  fails
