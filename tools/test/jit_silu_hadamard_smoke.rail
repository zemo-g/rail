-- jit_silu_hadamard_smoke.rail — Phase 1.4 verification + bench.
-- Compares (silu_forward → m_hadamard) chain vs the fused JIT kernel.
import "stdlib/jit.rail"

fill_seq arr n i =
  if i >= n then 0
  else
    let v = (int_to_float (i % 13)) * 0.1 - 0.6
    let _ = float_arr_set arr i v
    fill_seq arr n (i + 1)

max_diff_loop a b n i acc =
  if i >= n then acc
  else
    let d = (float_arr_get a i) - (float_arr_get b i)
    let ad = if d < 0.0 then 0.0 - d else d
    let na = if ad > acc then ad else acc
    max_diff_loop a b n (i + 1) na

max_diff a b n = max_diff_loop a b n 0 0.0

cpu_silu_loop g sig n i =
  if i >= n then 0
  else
    let gv = float_arr_get g i
    let s = 1.0 / (1.0 + exp (0.0 - gv))
    let _ = float_arr_set sig i (s * gv)
    cpu_silu_loop g sig n (i + 1)

cpu_hadamard_loop a b out n i =
  if i >= n then 0
  else
    let _ = float_arr_set out i ((float_arr_get a i) * (float_arr_get b i))
    cpu_hadamard_loop a b out n (i + 1)

time_ms = shell "perl -MTime::HiRes -e 'printf \"%.0f\", Time::HiRes::time()*1000'"

unfused_loop g u silu_out hadamard_out n iters i =
  if i >= iters then 0
  else
    let _ = cpu_silu_loop g silu_out n 0
    let _ = cpu_hadamard_loop silu_out u hadamard_out n 0
    unfused_loop g u silu_out hadamard_out n iters (i + 1)

fused_loop kid g u out n iters i =
  if i >= iters then 0
  else
    let _ = jit_run_silu_hadamard kid g u out n
    fused_loop kid g u out n iters (i + 1)

main =
  let _ = print "=== Phase 1.4 — fused silu+hadamard smoke + bench ==="
  let n = 512 * 192
  let g = float_arr_new n 0.0
  let _ = fill_seq g n 0
  let u = float_arr_new n 0.0
  let _ = fill_seq u n 11
  let cpu_silu = float_arr_new n 0.0
  let cpu_out = float_arr_new n 0.0
  let _ = cpu_silu_loop g cpu_silu n 0
  let _ = cpu_hadamard_loop cpu_silu u cpu_out n 0

  let _ = print "[1] JIT compile"
  let kid = jit_compile_silu_hadamard 0
  let _ = print (cat ["    kid=", show kid])

  let jit_out = float_arr_new n 0.0
  let _ = jit_run_silu_hadamard kid g u jit_out n
  let dmax = max_diff cpu_out jit_out n
  let _ = print (cat ["[2] max diff = ", show_float dmax])

  let iters = 100
  let _ = print (cat ["\n=== bench (n=", show n, ", iters=", show iters, ") ==="])
  let t0u = time_ms
  let _ = unfused_loop g u cpu_silu cpu_out n iters 0
  let t1u = time_ms
  let _ = print (cat ["unfused (CPU silu + CPU hadamard): ", t0u, " -> ", t1u])
  let t0f = time_ms
  let _ = fused_loop kid g u jit_out n iters 0
  let t1f = time_ms
  let _ = print (cat ["fused (1 JIT'd dispatch):          ", t0f, " -> ", t1f])

  let pass = if dmax < 0.0001 then 1 else 0
  let _ = if pass == 1 then print "\n=== PHASE 1.4 — GREEN ===" else print "\n=== FAIL ==="
  0
