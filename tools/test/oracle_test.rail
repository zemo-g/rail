-- Verify oracle against known-good and known-bad Rail snippets.
import "stdlib/oracle.rail"

main =
  let _ = print "=== oracle_test ==="

  -- Known-good: trivial but valid program.
  let good = "main = 0\n"
  let good_errs = oracle_errors good
  let good_ok = oracle_ok good
  let _ = print (cat ["good: errs=", show good_errs, "  ok=", if good_ok then "true" else "false"])

  -- Known-bad: syntax garbage.
  let bad = "??? this is not rail !!!\nlet x = = ;;\n"
  let bad_errs = oracle_errors bad
  let bad_ok = oracle_ok bad
  let _ = print (cat ["bad:  errs=", show bad_errs, "  ok=", if bad_ok then "true" else "false"])

  -- Actual model output from lm_v3_rail_corpus (the greedy sample):
  let model_out = "__at att/ott_t_t tt .t..  amllet t ttt t tlott  ot_ttt/    tr t ttot _tot  amlt t t    l_aaltatet    ltet arr  _aaa_at_ret      ltt     l tar_arr_net     tt  lot   llltoat ate_a t    ttt   _amltar t    l tr_net    otllaaababe le b/ b/  t t      let  _ft   tt_t tftott      et  / m   at      mbb/   f    let       oat_ate_n t     0    et      toat arr_att    t e\n"
  let model_errs = oracle_errors model_out
  let model_ok = oracle_ok model_out
  let _ = print (cat ["v3-rail greedy: errs=", show model_errs, "  ok=", if model_ok then "true" else "false"])

  let pass_count = 0
  let pc1 = if good_ok then pass_count + 1 else pass_count
  let pc2 = if bad_errs > 0 then pc1 + 1 else pc1
  let pc3 = if model_errs > 0 then pc2 + 1 else pc2
  let _ = print (cat ["\npass ", show pc3, "/3"])
  if pc3 == 3 then 0 else 1
