-- Reproducer: nested match with multi-constructor ADTs reports spurious
-- "non-exhaustive match" errors, even when all arms are present.
--
-- Symptom: the parser attaches all `|`-arms to the innermost match,
-- leaving the outer match with only one arm. The exhaustiveness checker
-- then correctly reports missing arms.
--
-- Minimal trigger: 2-level nest, multi-ctor ADTs, one arm on a line with
-- the outer `->`, remaining arms on dedented lines.
--
-- Documented in CLAUDE.md as "Deeply-nested match chains" but the 5+-level
-- / "expected decl" description is inaccurate — 2 levels + multi-ctor is
-- sufficient, and the error message is "non-exhaustive match".
--
-- Known workarounds (both compile cleanly):
--   (a) Extract inner match into a helper function.
--   (b) Use single-constructor ADTs (e.g. tensor destructuring in
--       tools/train/three_class_mlp.rail:train_step).

type A = | A1 x | A2
type B = | B1 x | B2

nest2 a b = match a
  | A1 x -> match b
    | B1 y -> x + y
    | B2 -> 0
  | A2 -> 0

main =
  let r = nest2 (A1 1) (B1 2)
  let _ = print (show r)
  0
