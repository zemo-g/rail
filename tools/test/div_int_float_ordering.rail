-- Falsification test for _rail_div (tagged-int LHS, boxed-float RHS).
-- Same bug class as add_int_float_ordering.
--
-- Expected: 4.0 (10 / 2.5)
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 10
  let _ = arr_set a 1 2.5
  let v = (arr_get a 0) / (arr_get a 1)
  if v == 4.0 then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
