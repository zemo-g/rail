-- Falsification test for _rail_div (tagged-int LHS, boxed-float RHS).
-- Same bug class as add_int_float_ordering.
--
-- Expected: 4.0 (10 / 2.5)
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 10
  let _ = arr_set a 1 2.5
  let v = (arr_get a 0) / (arr_get a 1)
  -- show-via-string bridges the ARM64 native-float / x86 heap-box gap (see sub_int_float_ordering).
  -- Pre-fix: int fast-path on raw-f64 bits → tagged int 0; show "0". Post-fix: 4 (or "4.0", but %g strips trailing .0).
  if show v == "4" then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
