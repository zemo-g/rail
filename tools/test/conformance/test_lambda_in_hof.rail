-- Conformance: lambdas (single-arg, value-capturing) work in filter/map.
-- The historically-warned "filter inline-lambda segfault" does not occur.
main =
  let lo = 2
  let f1 = length (filter (\x -> x > 2) [1, 2, 3, 4, 5])    -- 3
  let f2 = length (filter (\x -> x > lo) [1, 2, 3, 4, 5])   -- 3 (captures lo)
  let m1 = head (map (\x -> x + 100) [1, 2, 3])             -- 101
  let ok = if f1 == 3 then (if f2 == 3 then (if m1 == 101 then 1 else 0) else 0) else 0
  let _ = if ok == 1 then print "PASS" else print "FAIL"
  0
