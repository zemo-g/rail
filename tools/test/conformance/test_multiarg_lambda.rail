-- Conformance: multi-argument lambdas `\a b -> e` parse and curry correctly.
-- Locks the parser change that desugars \a b c -> e into nested \a -> \b -> \c -> e.
main =
  let add3 = \a b c -> a + b + c
  let s = fold (\acc x -> acc + x) 0 [1, 2, 3, 4, 5]   -- 15 (2-arg lambda in fold)
  let t = add3 10 20 30                                  -- 60 (3-arg lambda, curried)
  let ok = if s == 15 then (if t == 60 then 1 else 0) else 0
  let _ = if ok == 1 then print "PASS" else print "FAIL"
  0
