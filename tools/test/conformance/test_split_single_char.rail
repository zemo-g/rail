-- Conformance: `split` takes a SINGLE-character delimiter. If the delimiter
-- string has more than one char, only the FIRST is used (it is NOT a set, and
-- NOT a substring). Use str_split for multi-char delimiters.
main =
  let a = length (split "," "a,b,c")     -- 3  (single-char delimiter)
  let b = length (split " " "x y z")     -- 3
  let c = length (split "ab" "xaybz")    -- 2  (splits on 'a' only -> [x, ybz])
  let ok = if a == 3 then (if b == 3 then (if c == 2 then 1 else 0) else 0) else 0
  let _ = if ok == 1 then print "PASS" else print "FAIL"
  0
