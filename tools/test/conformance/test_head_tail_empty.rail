-- Conformance: runtime safety — head [] returns 0, tail [] returns [] (no segfault).
main =
  let h = head []              -- 0
  let t = length (tail [])     -- 0  (tail [] == [])
  let ok = if h == 0 then (if t == 0 then 1 else 0) else 0
  let _ = if ok == 1 then print "PASS" else print "FAIL"
  0
