-- softmax_half_smoke.rail — HalfTensor row-softmax correctness.
--
-- Validates the log-sum-exp reformulation on fp16 inputs:
--   1. small shape (128x128), values in [-2, 2]
--   2. large shape (1024 rows × 1024 cols), values in [-2, 2]
--   3. overflow-hostile shape: values scaled up by 20 (raw logits up to
--      ~10); a naïve exp(x) without max-subtract would overflow fp16
--      (exp(10) ≈ 22026, still under 65504, but any larger and we lose
--      — this is the log-sum-exp guard we want to prove).
--
-- Acceptance (absolute diff vs f64 reference):
--   < 1e-3 at 128², < 1e-2 at 1024² (S2 Mini brief).
-- Output range check: no row's max exceeds 1.0 by > 1e-3, no NaN.

import "stdlib/tensor.rail"

foreign tgl_init dummy -> int

fill_seeded arr n seed scale i =
  if i >= n then 0
  else
    let x = (i + seed) % 100
    let v = (int_to_float x / 100.0 - 0.5) * scale
    let _ = float_arr_set arr i v
    fill_seeded arr n seed scale (i + 1)

max_diff_loop a b n i best =
  if i >= n then best
  else
    let raw = float_arr_get a i - float_arr_get b i
    let d = if raw > 0.0 then raw else 0.0 - raw
    let b2 = if d > best then d else best
    max_diff_loop a b n (i + 1) b2

max_abs_loop a n i best =
  if i >= n then best
  else
    let v = float_arr_get a i
    let d = if v > 0.0 then v else 0.0 - v
    let b2 = if d > best then d else best
    max_abs_loop a n (i + 1) b2

unwrap_t t = match t | Tensor d _ _ -> d

make_tensor rows cols seed scale =
  let arr = float_arr_new (rows * cols) 0.0
  let _ = fill_seeded arr (rows * cols) seed scale 0
  Tensor arr (cons rows (cons cols [])) (compute_strides (cons rows (cons cols [])))

-- f64 reference softmax (row-wise, log-sum-exp form — matches GPU
-- kernel mathematically). Splits into 3 loops per row to keep each
-- helper short and tail-recursive.
row_max_loop a row_off cols j best =
  if j >= cols then best
  else
    let v = float_arr_get a (row_off + j)
    let b2 = if v > best then v else best
    row_max_loop a row_off cols (j + 1) b2

row_sum_exp_loop a row_off cols mx j acc =
  if j >= cols then acc
  else
    let v = float_arr_get a (row_off + j)
    let e = exp (v - mx)
    row_sum_exp_loop a row_off cols mx (j + 1) (acc + e)

row_normalize_loop a c row_off cols mx inv j =
  if j >= cols then 0
  else
    let v = float_arr_get a (row_off + j)
    let e = exp (v - mx)
    let _ = float_arr_set c (row_off + j) (e * inv)
    row_normalize_loop a c row_off cols mx inv (j + 1)

ref_softmax_row_loop a c cols rows row =
  if row >= rows then 0
  else
    let row_off = row * cols
    let v0 = float_arr_get a row_off
    let mx = row_max_loop a row_off cols 1 v0
    let s = row_sum_exp_loop a row_off cols mx 0 0.0
    let inv = 1.0 / s
    let _ = row_normalize_loop a c row_off cols mx inv 0
    ref_softmax_row_loop a c cols rows (row + 1)

-- Extra structural checks on a softmax output.
row_sum_loop a row_off cols j acc =
  if j >= cols then acc
  else row_sum_loop a row_off cols (j + 1) (acc + float_arr_get a (row_off + j))

nan_loop a n i =
  if i >= n then 0
  else
    let v = float_arr_get a i
    -- NaN is the only value where v == v is false
    if v == v then nan_loop a n (i + 1)
    else 1

check_shape label rows cols scale =
  let A = make_tensor rows cols 23 scale
  let n = rows * cols

  let Cref = float_arr_new n 0.0
  let _ = ref_softmax_row_loop (unwrap_t A) Cref cols rows 0

  let Ah = half_of_tensor A
  let Ch = softmax_half Ah
  let Cf = tensor_of_half Ch
  let Cfd = unwrap_t Cf

  let md = max_diff_loop Cref Cfd n 0 0.0
  let md_scaled = float_to_int (md * 100000.0)

  let mx = max_abs_loop Cfd n 0 0.0
  let nan_hit = nan_loop Cfd n 0

  -- First-row sum check (should be ~1.0)
  let s0 = row_sum_loop Cfd 0 cols 0 0.0
  let s0_err = if s0 > 1.0 then s0 - 1.0 else 1.0 - s0
  let s0_err_scaled = float_to_int (s0_err * 100000.0)

  let _ = print (cat [label, " max_abs_diff=", show_float md,
                      "  scaled_1e5=", show md_scaled,
                      "  range_max=", show_float mx,
                      "  row0_sum_err_1e5=", show s0_err_scaled,
                      "  nan_hit=", show nan_hit])
  md_scaled

main =
  let _ = tgl_init 0

  -- 1e-3 at 128² (scaled 100), 1e-2 at 1024² (scaled 1000).
  let md_small = check_shape "softmax_half 128x128    s=4"    128  128  4.0
  let md_large = check_shape "softmax_half 1024x1024 s=4"    1024 1024 4.0
  let md_hot   = check_shape "softmax_half 1024x1024 s=20"   1024 1024 20.0

  let fail_small = md_small >= 100
  let fail_large = md_large >= 1000
  let fail_hot   = md_hot   >= 1000

  if fail_small then
    let _ = print "FAIL softmax_half at 128x128"
    1
  else if fail_large then
    let _ = print "FAIL softmax_half at 1024x1024"
    1
  else if fail_hot then
    let _ = print "FAIL softmax_half at 1024x1024 high-scale (log-sum-exp guard)"
    1
  else
    let _ = print "ok softmax_half"
    0
