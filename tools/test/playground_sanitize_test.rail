-- tools/test/playground_sanitize_test.rail — Falsification suite for
-- tools/playground/sanitize.rail. Written FIRST (verify-removals
-- discipline). Each case asserts a verdict; PASS line at end iff all
-- assertions hold. Conventions: exit 0 + last-line "PASS" per the
-- foundations test runner.
--
-- A sanitizer that lets a banned construct through is a security hole;
-- one that rejects a benign program is a usability bug. False positives
-- are loosened later, false negatives are NOT — so the test heavily
-- weights the reject-side.
--
-- Run: ./rail_native run tools/test/playground_sanitize_test.rail

import "tools/playground/sanitize.rail"

-- A sanitize result is ["Ok", src] for accept, ["Err", reason] for reject.
is_ok r = head r == "Ok"
is_err r = head r == "Err"
err_reason r = head (tail r)

-- count of failed assertions
check_reject name src =
  let r = sanitize_source src
  if is_err r then
    let _ = print (cat ["  reject  ", name, "  (", err_reason r, ")"])
    0
  else
    let _ = print (cat ["FAIL ", name, ": expected REJECT but got Ok"])
    1

check_accept name src =
  let r = sanitize_source src
  if is_ok r then
    let _ = print (cat ["  accept  ", name])
    0
  else
    let _ = print (cat ["FAIL ", name, ": expected ACCEPT but got Err: ", err_reason r])
    1

main =
  let _ = print "=== playground_sanitize_test ==="

  -- ---- REJECT cases (security floor) ----
  -- Each banned token in identifier position must be rejected.
  let r1 = check_reject "shell-call"        "main = let _ = shell \"ls /\" in 0\n"
  let r2 = check_reject "write_file"        "main = let _ = write_file \"/tmp/x\" \"y\" in 0\n"
  let r3 = check_reject "read_file"         "main = let s = read_file \"/etc/passwd\"\n  0\n"
  let r4 = check_reject "read_line"         "main = let s = read_line 0\n  0\n"
  let r5 = check_reject "foreign-keyword"   "foreign strlen s -> int\nmain = strlen \"hi\"\n"
  let r6 = check_reject "import-traversal"  "import \"../../../etc/passwd\"\nmain = 0\n"
  let r7 = check_reject "import-anything"   "import \"stdlib/list.rail\"\nmain = 0\n"
  let r8 = check_reject "rail-runtime-call" "main = _rail_alloc 64\n"
  let r9 = check_reject "spawn"             "main = let _ = spawn (\\_ -> 0)\n  0\n"
  let r10 = check_reject "arena-mark"       "main = let m = arena_mark 0\n  0\n"

  -- Size cap (>32 KB rejected).
  let big = pad_str "main = 0\n-- " 33000
  let r11 = check_reject "oversize-32kb" big

  -- Non-printable byte (bell, 0x07). NUL would terminate the C string
  -- the lexer reads, so use a different non-printable to exercise the
  -- byte-range check directly.
  let with_bell = cat ["main = 0\n-- ", char_from_int 7, "\n"]
  let r12 = check_reject "non-printable-byte" with_bell

  -- ---- ACCEPT cases (the 3 spec examples) ----
  let ex1 = "main = let _ = print \"hi\"\n  let _ = print (show (3 + 4))\n  0\n"
  let a1 = check_accept "spec-echo-arith" ex1

  let ex2 = "fact n = if n <= 1 then 1 else n * fact (n - 1)\nmain = let _ = print (show (fact 10))\n  0\n"
  let a2 = check_accept "spec-fact" ex2

  let ex3 = "type Option = | Some x | None\nmain = match (Some 42)\n  | Some x -> x\n  | None -> 0\n"
  let a3 = check_accept "spec-adt-match" ex3

  -- A few extra benign cases to keep us honest about false-positive surface.
  let a4 = check_accept "trivial"        "main = 42\n"
  let a5 = check_accept "show-list"      "main = let _ = print (show [1,2,3])\n  0\n"
  let a6 = check_accept "comment-shell"  "-- shell foo bar\nmain = 0\n"
  let a7 = check_accept "string-shell"   "main = let s = \"shell is fine in a string\"\n  let _ = print s\n  0\n"

  let total = r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + r11 + r12 + a1 + a2 + a3 + a4 + a5 + a6 + a7
  if total == 0 then
    let _ = print "PASS"
    0
  else
    let _ = print (cat ["FAIL total=", show total])
    1

-- Build a string of length >= n by repeated doubling (avoids deep recursion).
pad_str seed n =
  if length seed >= n then seed
  else pad_str (cat [seed, seed]) n
