-- Unit test for rmsnorm_backward_gamma.
-- Closed form: dγ[j] = Σ_r dy[r,j] * x[r,j] * rstd[r]
import "stdlib/transformer.rail"

my_abs x = if x < 0.0 then 0.0 - x else x

main =
  let _ = print "=== rmsnorm_backward_gamma test ==="
  -- 2 rows × 4 dims.
  let d = 4
  let n_rows = 2
  let n = n_rows * d
  let xd = float_arr_new n 0.0
  let _ = float_arr_set xd 0 0.1
  let _ = float_arr_set xd 1 0.2
  let _ = float_arr_set xd 2 0.3
  let _ = float_arr_set xd 3 0.4
  let _ = float_arr_set xd 4 0.5
  let _ = float_arr_set xd 5 0.6
  let _ = float_arr_set xd 6 0.7
  let _ = float_arr_set xd 7 0.8
  let x = Tensor xd (cons n_rows (cons d [])) (compute_strides (cons n_rows (cons d [])))

  -- Need rstd_arr. Run rmsnorm_save to get it (ignore y).
  let g_init_d = float_arr_new d 1.0
  let _ = float_arr_set g_init_d 0 1.0
  let _ = float_arr_set g_init_d 1 1.0
  let _ = float_arr_set g_init_d 2 1.0
  let _ = float_arr_set g_init_d 3 1.0
  let g_init = Tensor g_init_d (cons d []) (cons 1 [])
  let pack = rmsnorm_save x g_init
  let rstd = head (tail pack)
  let _ = print (cat ["rstd[0]=", show_float (float_arr_get rstd 0)])
  let _ = print (cat ["rstd[1]=", show_float (float_arr_get rstd 1)])

  -- dy = all ones
  let dyd = float_arr_new n 0.0
  let _ = float_arr_set dyd 0 1.0
  let _ = float_arr_set dyd 1 1.0
  let _ = float_arr_set dyd 2 1.0
  let _ = float_arr_set dyd 3 1.0
  let _ = float_arr_set dyd 4 1.0
  let _ = float_arr_set dyd 5 1.0
  let _ = float_arr_set dyd 6 1.0
  let _ = float_arr_set dyd 7 1.0
  let dy = Tensor dyd (cons n_rows (cons d [])) (compute_strides (cons n_rows (cons d [])))

  let dg = rmsnorm_backward_gamma x rstd dy
  match dg | Tensor dgd _ _ ->
    let _ = print (cat ["dg[0]=", show_float (float_arr_get dgd 0)])
    let _ = print (cat ["dg[1]=", show_float (float_arr_get dgd 1)])
    let _ = print (cat ["dg[2]=", show_float (float_arr_get dgd 2)])
    let _ = print (cat ["dg[3]=", show_float (float_arr_get dgd 3)])
    -- Expected: dg[j] = x[0,j]*rstd[0] + x[1,j]*rstd[1]
    -- rstd[0] = 1/sqrt(mean([.01,.04,.09,.16])+eps) = 1/sqrt(0.075) ≈ 3.651
    -- rstd[1] = 1/sqrt(mean([.25,.36,.49,.64])+eps) = 1/sqrt(0.435) ≈ 1.516
    -- dg[0] ≈ 0.1*3.651 + 0.5*1.516 = 0.365 + 0.758 = 1.123
    -- dg[3] ≈ 0.4*3.651 + 0.8*1.516 = 1.460 + 1.213 = 2.673
    let _ = print "expected: dg[0]≈1.123, dg[3]≈2.673"
    let d0_err = my_abs ((float_arr_get dgd 0) - 1.1234)
    let d3_err = my_abs ((float_arr_get dgd 3) - 2.6738)
    if d0_err < 0.01 then
      if d3_err < 0.01 then
        let _ = print "PASS"
        0
      else let _ = print (cat ["FAIL dg[3] err=", show_float d3_err]) in 1
    else let _ = print (cat ["FAIL dg[0] err=", show_float d0_err]) in 1
