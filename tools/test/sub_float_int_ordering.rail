-- Falsification test for _rail_sub (raw-f64 LHS, tagged-int RHS).
-- Mirror of sub_int_float_ordering.rail with operand order reversed.
--
-- Pre-fix ARM64: `tst x1, #1; b.eq .Lsub_float` branched on raw-f64 LHS
-- (low bit 0). .Lsub_float then did `ldr d0, [x1, #8]` dereferencing
-- raw-f64 bits as a heap pointer -> SIGSEGV. After the fix, an inserted
-- `tst x0, #1; b.ne .Lsub_mixed_fi` branch at the top of .Lsub_float
-- routes (raw-f64, tagged-int) through the mirror of .Lsub_mixed_if.
--
-- Verification via `show v == "3.5"` rather than `v == 3.5`. See
-- sub_int_float_ordering.rail header for the heap-box vs raw-f64
-- asymmetry rationale.
--
-- Expected: 3.5 (5.5 - 2)
main =
  let a = arr_new 2 0
  let _ = arr_set a 0 5.5
  let _ = arr_set a 1 2
  let v = (arr_get a 0) - (arr_get a 1)
  if show v == "3.5" then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
