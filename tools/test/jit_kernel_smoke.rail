-- jit_kernel_smoke.rail — Phase 0 of trace+JIT plan (2026-05-14).
-- Prove the end-to-end loop: Rail emits MSL source → C JIT-compiles via
-- newLibraryWithSource → Rail dispatches → output matches the precomputed
-- reference. If green, Phase 0 is done.
--
-- Run from ~/projects/rail/:
--   ./rail_native tools/test/jit_kernel_smoke.rail
--   DYLD_LIBRARY_PATH=tools/metal /tmp/rail_out
import "stdlib/tensor.rail"

-- MSL source — a custom SiLU.  Identical math to the pre-built silu_fwd,
-- so we can reuse the same expected values.
msl_src =
  cat ["#include <metal_stdlib>\n",
       "using namespace metal;\n",
       "kernel void custom_silu(\n",
       "    device const float *X [[buffer(0)]],\n",
       "    device float       *Y [[buffer(1)]],\n",
       "    constant uint      &N [[buffer(2)]],\n",
       "    uint gid [[thread_position_in_grid]])\n",
       "{\n",
       "    if (gid >= N) return;\n",
       "    float x = X[gid];\n",
       "    Y[gid] = x / (1.0f + exp(-x));\n",
       "}\n"]

main =
  let _ = print "=== Phase 0 — JIT kernel smoke ==="

  let _ = write_file "/tmp/rail_jit_kernel.metal" msl_src
  let _ = print "[1] wrote MSL to /tmp/rail_jit_kernel.metal"

  let kid = tgl_jit_compile_from_tmp_file 0
  let _ = print (cat ["[2] JIT compile returned kid=", show kid])

  let n = 64
  let x = float_arr_new n 0.0
  let _ = float_arr_set x 0 1.0
  let _ = float_arr_set x 1 2.0
  let _ = float_arr_set x 2 0.0
  let _ = float_arr_set x 3 (0.0 - 1.0)
  let y = float_arr_new n 0.0
  let rc = tgl_jit_dispatch_1in1out kid x y n
  let _ = print (cat ["[3] dispatch rc=", show rc])

  -- Expected: silu(x) = x / (1 + exp(-x))
  --   x=1   -> 0.7311
  --   x=2   -> 1.7616
  --   x=0   -> 0.0
  --   x=-1  -> -0.2689
  let y0 = float_arr_get y 0
  let y1 = float_arr_get y 1
  let y2 = float_arr_get y 2
  let y3 = float_arr_get y 3
  let _ = print (cat ["[4] y[0]=", show_float y0, "  expected ~0.7311"])
  let _ = print (cat ["[5] y[1]=", show_float y1, "  expected ~1.7616"])
  let _ = print (cat ["[6] y[2]=", show_float y2, "  expected 0.0"])
  let _ = print (cat ["[7] y[3]=", show_float y3, "  expected ~-0.2689"])

  let d0 = if y0 > 0.73 then if y0 < 0.74 then 1 else 0 else 0
  let d1 = if y1 > 1.75 then if y1 < 1.77 then 1 else 0 else 0
  let d2 = if y2 > (0.0 - 0.001) then if y2 < 0.001 then 1 else 0 else 0
  let d3 = if y3 > (0.0 - 0.28) then if y3 < (0.0 - 0.26) then 1 else 0 else 0
  let total = d0 + d1 + d2 + d3
  let _ = print (cat ["\n=== PHASE 0 RESULT: ", show total, "/4 expected values matched ==="])
  let _ = if total == 4 then print "GREEN — Path 3 foundation viable" else print "BLOCKED — needs diagnosis"
  0
