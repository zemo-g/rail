-- ld_error_propagation.rail — falsification test for Bug A.
--
-- Pre-fix: `tools/compile.rail` ran `trim` on the `ld` linker result, but
-- `trim s = head (split "\n" s)` is FIRST-LINE-ONLY. When `ld` reported an
-- undefined symbol like:
--
--     Undefined symbols for architecture arm64:
--       "_zz_falsification_missing_symbol", referenced from:
--           _main in rail_build_XXXX.o
--     ld: symbol(s) not found for architecture arm64
--
-- the user only saw the first line (`Undefined symbols...`). Both the
-- symbol name AND the canonical "ld: symbol(s) not found" sentinel were
-- silently truncated, forcing the user to re-run `ld` manually to figure
-- out which symbol was missing.
--
-- Fix: a new `strip_trailing_ws` helper preserves interior newlines and
-- strips only trailing whitespace; both as_result and ld_result now flow
-- the full multi-line error to stdout.
--
-- Falsification: compile a Rail program declaring a fake `foreign` symbol
-- that the linker cannot resolve. Capture compiler stdout. Assert that
-- BOTH the symbol name AND the "symbol(s) not found" sentinel appear --
-- i.e. content from beyond the first line of `ld`'s output survived.

main =
  let src = "foreign zz_falsification_missing_symbol x -> int\nmain = zz_falsification_missing_symbol 0\n"
  let _ = write_file "/tmp/rail_ld_propagation_src.rail" src
  -- Compile (link will fail). 2>&1 captures both stdout and stderr.
  let out = shell "./rail_native /tmp/rail_ld_propagation_src.rail 2>&1"
  let _ = write_file "/tmp/rail_ld_propagation_out.txt" out

  -- Symbol name must reach the user. Pre-fix: truncated.
  let has_symbol = str_contains "_zz_falsification_missing_symbol" out
  -- "symbol(s) not found" is `ld`'s trailing sentinel line. Pre-fix: gone.
  let has_sentinel = str_contains "symbol(s) not found" out

  let _ = if has_symbol then 0 else
    let _ = print "FAIL: symbol name not in compiler output"
    let _ = print "  expected: _zz_falsification_missing_symbol"
    let _ = print (cat ["  got: ", out])
    0
  let _ = if has_sentinel then 0 else
    let _ = print "FAIL: 'symbol(s) not found' sentinel not in output"
    let _ = print (cat ["  got: ", out])
    0

  if has_symbol then
    if has_sentinel then
      let _ = print "PASS"
      0
    else 1
  else 1
