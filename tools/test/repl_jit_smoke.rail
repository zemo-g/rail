-- repl_jit_smoke.rail — falsification harness for tools/repl_jit.rail.
--
-- Drives the REPL in batch mode by writing a session script to a temp file,
-- pointing /tmp/rail_repl_jit_input.txt at it, then running the REPL and
-- checking that each `expect:` marker appears in order in stdout.
--
-- Run: ./rail_native run tools/test/repl_jit_smoke.rail
--
-- Expected outcome: 8 assertions pass (PASS on last line, exit 0).

-- ============================================================================
-- Test transcript: each REPL line is `>>> <input>` and each expected output
-- line is `=== <substring>`. The substring is searched in the actual REPL
-- response (the immediate next non-empty line after the prompt echo).
-- ============================================================================

transcript _ =
  cat [
    ">>> 3 + 4\n=== [jit]   7\n",
    ">>> let x = 7 in x * x\n=== [jit]   49\n",
    ">>> fact n = if n < 2 then 1 else n * fact (n - 1)\n=== (defined)\n",
    ">>> fact 6\n=== [jit]   720\n",
    ">>> fib n = if n < 2 then n else fib (n - 1) + fib (n - 2)\n=== (defined)\n",
    ">>> fib 8\n=== [jit]   21\n",
    ">>> double x = x * 2\n=== (defined)\n",
    ">>> double (double 9)\n=== [jit]   36\n",
    -- Fallback cases: ADT match and a stdlib-heavy expression both need
    -- the full compiler.
    ">>> type Pair = | P a b\n=== (defined)\n",
    ">>> match (P 3 4) | P a b -> a + b\n=== [shell] 7\n",
    -- Syntax error: should be reported, not crash.
    ">>> 1 +\n=== error\n"
  ]

-- ============================================================================
-- Drive: write input file, invoke REPL, read its output, scan for markers.
-- ============================================================================

input_path = "/tmp/rail_repl_jit_smoke_input.txt"
output_path = "/tmp/rail_repl_jit_smoke_output.txt"
sentinel_path = "/tmp/rail_repl_jit_input.txt"

main =
  let t = transcript 0 in
  let lines = str_split "\n" t in
  let inputs = collect_inputs lines [] in
  let expects = collect_expects lines [] in
  let _ = write_file input_path (join "\n" inputs) in
  let _ = write_file sentinel_path input_path in
  -- 50ms sleep to stagger against parallel agents per CLAUDE.md tmp-race note.
  let _ = shell "sleep 0.05" in
  let _ = shell (cat ["./rail_native run tools/repl_jit.rail > ", output_path, " 2>&1"]) in
  -- Clean up the sentinel so a subsequent interactive REPL run doesn't
  -- accidentally re-trigger batch mode.
  let _ = shell (cat ["rm -f ", sentinel_path]) in
  let actual = read_file output_path in
  let passed = check_all expects actual 0 0 in
  let total = length expects in
  let _ = print (cat ["Smoke: ", show passed, "/", show total, " markers found"]) in
  if passed == total then
    let _ = print "PASS" in 0
  else
    let _ = print (cat ["FAIL — see ", output_path]) in 1

collect_inputs lines acc =
  if length lines == 0 then reverse acc
  else
    let l = head lines in
    if (length (chars l)) >= 4 then
      if (str_sub l 0 4) == ">>> " then
        collect_inputs (tail lines) (cons (str_sub l 4 ((length (chars l)) - 4)) acc)
      else collect_inputs (tail lines) acc
    else collect_inputs (tail lines) acc

collect_expects lines acc =
  if length lines == 0 then reverse acc
  else
    let l = head lines in
    if (length (chars l)) >= 4 then
      if (str_sub l 0 4) == "=== " then
        collect_expects (tail lines) (cons (str_sub l 4 ((length (chars l)) - 4)) acc)
      else collect_expects (tail lines) acc
    else collect_expects (tail lines) acc

check_all expects actual passed idx =
  if length expects == 0 then passed
  else
    let e = head expects in
    let found = str_contains e actual in
    let _ = print (cat ["  [", show idx, "] ", if found then "OK    " else "MISS  ", e]) in
    let next = if found then passed + 1 else passed in
    check_all (tail expects) actual next (idx + 1)
