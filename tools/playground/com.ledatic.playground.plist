<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.ledatic.playground.plist
  --------------------------------------------------------------------
  Mini-side launchd agent for the public Rail playground compile
  service. Wraps tools/http_server.py driving a pre-built
  compile_server binary (Session A artifact).

  Hardening (mirrors H8 fleet_agent_v3 commit 1de6cff):
    - Bound to Mini's Tailscale IPv4 (100.79.50.108) only via
      RAIL_PG_BIND_IP env var which http_server.py reads OR via
      pf rule (preferred; this plist documents the env handoff).
      The driver itself binds 0.0.0.0 today; until a follow-up
      lands a bind-IP env, an upstream pf/ipfw rule on Mini blocks
      anything off the Tailscale interface.
    - Tailscale-only access means the cf tunnel ingress is the
      ONLY public reach path (mirrors the dda_portal pattern).

  Install (run on Mini, AUTHORIZED at deploy time):
    cp /Users/ledaticempire/projects/rail/tools/playground/com.ledatic.playground.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.ledatic.playground.plist
    launchctl start com.ledatic.playground

  Verify:
    launchctl list | grep com.ledatic.playground
    lsof -nP -iTCP -sTCP:LISTEN | grep 8090
    curl -sI http://100.79.50.108:8090/api/playground/compile -X OPTIONS

  Logs:
    tail -f ~/Library/Logs/ledatic-playground.log
    tail -f ~/Library/Logs/ledatic-playground.err

  Pre-flight assumed by the deploy script:
    - /Users/ledaticempire/projects/rail/rail_native exists + is executable
    - tools/playground/compile_server.rail has been pre-built and the
      output binary is at /Users/ledaticempire/projects/rail/tools/playground/compile_server
      (the script's RailCmd compiles + copies before launchctl load)
    - /tmp is writable (compile_server uses /tmp/rail_http_req.txt and
      /tmp/rail_out.wasm — single-process so the contention-free
      assumption from compile_server.rail's comments holds)

  Port 8090 chosen to align with cf tunnel's existing ingress slot
  (compile.ledatic.org -> Mini :8090 per fleet.md). The Worker
  reaches us via the Tailscale URL (PLAYGROUND_BACKEND secret).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ledatic.playground</string>

  <!--
    Driver: python3 tools/http_server.py <port> <handler>
    handler: pre-built compile_server binary that reads
             /tmp/rail_http_req.txt and writes /tmp/rail_http_resp.txt
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/ledaticempire/projects/rail/tools/http_server.py</string>
    <string>8090</string>
    <string>/Users/ledaticempire/projects/rail/tools/playground/compile_server</string>
  </array>

  <!--
    cwd MUST be the rail repo root because compile_server.rail shells out
    to `./rail_native wasm <src>` (relative path).
  -->
  <key>WorkingDirectory</key>
  <string>/Users/ledaticempire/projects/rail</string>

  <key>RunAtLoad</key>
  <true/>

  <!--
    Auto-restart on crash. Throttle to 10 s so a tight crash loop doesn't
    burn CPU and so we get visible "service flapping" in the log.
  -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!--
    EnvironmentVariables: keep arena small (this is a single-source-per-req
    workload, not a training run) and set PATH so `as` + `ld` + `base64`
    are findable when launched outside an interactive shell.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
    <key>RAIL_ARENA_MB</key>
    <string>512</string>
    <key>HOME</key>
    <string>/Users/ledaticempire</string>
  </dict>

  <!--
    Logs. Using ~/Library/Logs by convention; the post-install verify
    step tails these.
  -->
  <key>StandardOutPath</key>
  <string>/Users/ledaticempire/Library/Logs/ledatic-playground.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ledaticempire/Library/Logs/ledatic-playground.err</string>

  <!--
    SoftResourceLimits: belt-and-suspenders for the per-request 5 s
    subprocess.run timeout already in http_server.py. NumberOfProcesses
    cap blocks runaway fork bombs from a sanitize-bypass.
  -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>2048</integer>
    <key>NumberOfProcesses</key>
    <integer>256</integer>
  </dict>

  <!--
    ProcessType=Interactive — wake-from-sleep responsiveness matters more
    than batch throughput here (the Worker has an 8 s hard deadline).
  -->
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
