-- rail-gpt — the unified Rail GPT CLI (Phase 5). One binary, six verbs:
--   rail-gpt infer            run the owned 138M forward (bf16 weights) -> argmax
--   rail-gpt train            attested training loop (routes to the trainer)
--   rail-gpt eval             compile%/correct% oracle (bx11)
--   rail-gpt witness          re-run forward over a ledger (correspondence)
--   rail-gpt verify --ledger F   check a ledger's hash chain (tamper-evidence)
--   rail-gpt export           write weights to safetensors
-- Dispatcher pattern (sidesteps the Rail transitive-import limit): verify is
-- inline; the heavy verbs exec their compiled tools.
import "stdlib/env.rail"

gnth xs i = if i <= 0 then head xs else gnth (tail xs) (i - 1)
flen s = length (chars s)
repo = cat [getenv "HOME", "/projects/rail-gpt-unify"]
verb = if (length args) >= 2 then gnth args 1 else "help"
fval key i n = if i >= n then "" else if (gnth args i) == key then (if (i + 1) < n then gnth args (i + 1) else "") else fval key (i + 1) n

-- extract the 64-hex value of a  "key": "<hex>"  field from a jsonl line
xfield line key = let pat = cat ["\"", key, "\": \""] in let i = str_find pat line in if i < 0 then "" else str_sub line (i + (flen pat)) 64
-- walk records: each prev_hash must equal the previous record_hash
vchain lines exp i n badat =
  if i >= n then badat
  else let line = gnth lines i in
       if (flen line) < 20 then vchain lines exp (i + 1) n badat
       else let pr = xfield line "prev_hash" in let rh = xfield line "record_hash" in
            let nb = if pr == exp then badat else (if badat < 0 then i else badat) in
            vchain lines rh (i + 1) n nb

do_verify =
  let f = fval "--ledger" 0 (length args) in
  if f == "" then print "rail-gpt verify: --ledger <file> required"
  else let txt = read_file f in let lines = split "\n" txt in let n = length lines in
       let g = xfield (gnth lines 0) "prev_hash" in
       let bad = vchain lines g 0 n (0 - 1) in
       if bad < 0 then print (cat ["rail-gpt verify: CHAIN OK -- ", show n, " records hash-linked genesis->tip, tamper-evident"])
       else print (cat ["rail-gpt verify: CHAIN BROKEN at record ", show bad, " (prev_hash != previous record_hash)"])

-- exec a shell command, capture its output to a file, print it (Rail shell()
-- doesn't reliably surface nested stdout; read_file does).
run_show cmd = let _ = shell (cat [cmd, " > /tmp/rg_out.txt 2>&1"]) in print (read_file "/tmp/rg_out.txt")

do_infer =
  let _ = print "rail-gpt infer: owned 138M forward, bf16 weights, canonical prompt ..." in
  run_show (cat ["cd ", repo, " && ./rail_native --out-prefix /tmp/rg_infer tools/gpt/gp_138m_bf16.rail >/dev/null 2>&1 && RAIL_ARENA_MB=8000 /tmp/rg_infer 2>/dev/null | grep -iE 'argmax|PRESERVE'"])

do_eval =
  let _ = print "rail-gpt eval: compile%/correct% oracle (rail_native = judge) ..." in
  run_show (cat ["cd ", repo, " && ./rail_native run tools/bitexact/bx11_compile_eval.rail 2>/dev/null | tail -4"])

do_train =
  let _ = print "rail-gpt train: attested full-weight training (tiny proof; CE->0) ..." in
  let _ = run_show (cat ["cd ", repo, " && ./rail_native --out-prefix /tmp/rg_train tools/gpt/gpt_tiny_train_all.rail >/dev/null 2>&1 && /tmp/rg_train 2>/dev/null | tail -2"]) in
  print "  (real-scale 138M attested loop: tools/metal/attested_train_minibatch.rail, RAIL_ARENA_MB=10500)"

do_witness =
  let _ = print "rail-gpt witness: re-run the forward over a ledger and assert recorded losses reproduce." in
  print "  wired via the mode-B engine (tools/metal/attested_witness.rail); correspondence gate. [pending unified-stack port]"

do_export =
  let _ = print "rail-gpt export: write weights to .safetensors." in
  print "  scaffold: tools/metal/safetensors_write_demo.rail (single-tensor writer; full multi-tensor is the extension)."

usage =
  let _ = print "rail-gpt -- unified Rail GPT CLI (self-hosted, zero-dep, attested)" in
  let _ = print "usage: rail-gpt <verb> [flags]" in
  let _ = print "  infer                      owned 138M forward (bf16 weights) -> argmax 5836" in
  let _ = print "  train                      attested training loop (CE -> 0)" in
  let _ = print "  eval                       compile%/correct% oracle (bx11)" in
  let _ = print "  witness                    re-run forward over a ledger (correspondence)" in
  let _ = print "  verify --ledger <file>     check a ledger's hash chain (tamper-evidence)" in
  let _ = print "  export                     write weights to safetensors" in
  print "  help                       this message"

main =
  if verb == "verify" then do_verify
  else if verb == "infer" then do_infer
  else if verb == "eval" then do_eval
  else if verb == "train" then do_train
  else if verb == "witness" then do_witness
  else if verb == "export" then do_export
  else usage
