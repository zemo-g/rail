-- x402_pay.rail — CLIENT: sign an x402 "exact" payment authorization (Ed25519).
-- Prints the X-PAYMENT header value: <payer_pubkey_hex>.<nonce>.<sig_hex>
import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"
pay_msg nonce = cat ["x402|exact|base|10000|0x0129b9e66C449b4c7027F07A7b8811BBf6fb3301|/data|", nonce]
main =
  let nonce = if (length args) >= 2 then head (tail args) else "nonce-7f3a1c" in
  let seed = sha256 "demo.payer.key.v1" in
  let pk = ed25519_pk_from_sk seed in
  let sig = ed25519_sign seed (sha256 (pay_msg nonce)) 32 in
  print (cat [bytes_to_hex pk 32, ".", nonce, ".", bytes_to_hex sig 64])
