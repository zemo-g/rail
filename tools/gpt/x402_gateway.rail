-- x402_gateway.rail — pure-Rail x402 payment gateway over an ATTESTED resource.
-- The Ledatic angle: x402 proves payment; the response ALSO carries sha256 + an
-- Ed25519 signature so the buyer can VERIFY the data is the genuine attested
-- artifact. "pay-per-crawl" (Cloudflare) + "check-me" (Ledatic) = pay-per-attested.
--
-- Runs as the handler binary behind stdlib/http_server.rail: reads the raw request
-- from /tmp/rail_http_req.txt, prints the HTTP response to stdout.
import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"

crlf = cat [char_from_int 13, char_from_int 10]

-- the gated resource (an attested dataset slice)
resource = "{\"dataset\":\"ledatic-attested-lakes\",\"pulse\":2641877,\"records\":[{\"k\":\"ais.mmsi.316001234\",\"v\":\"port-call-verified\"},{\"k\":\"rf.decode.pass\",\"v\":true}]}"

-- x402 payment requirements returned with the 402
offer = "{\"x402Version\":1,\"accepts\":[{\"scheme\":\"exact\",\"network\":\"base\",\"maxAmountRequired\":\"10000\",\"asset\":\"USDC\",\"payTo\":\"0x0129b9e66C449b4c7027F07A7b8811BBf6fb3301\",\"resource\":\"/data\",\"description\":\"Ledatic attested dataset -- response is Ed25519-signed, buyer-verifiable\"}]}"

build_resp status stext ct extra body =
  cat ["HTTP/1.1 ", show status, " ", stext, crlf,
       "Content-Type: ", ct, crlf,
       "Content-Length: ", show (length (chars body)), crlf,
       extra,
       "Connection: close", crlf, crlf, body]

-- first token after the method on the request line (the path)
req_path req = let lines = str_split (cat [char_from_int 10]) req in if length lines == 0 then "/" else let parts = str_split " " (head lines) in if length parts < 2 then "/" else head (tail parts)
-- x402 clients retry with an "X-PAYMENT:" header carrying the payment payload
has_payment req = str_contains "X-PAYMENT" req

-- attestation headers: hash of the body + Ed25519 signature over that hash
attest_headers =
  let h = sha256 resource in
  let hexh = bytes_to_hex h 32 in
  let seed = sha256 "ledatic.x402.gateway.dev.key.v1" in
  let sig = bytes_to_hex (ed25519_sign seed h 32) 64 in
  cat ["X-Content-SHA256: ", hexh, crlf,
       "X-Attestation-Alg: ed25519", crlf,
       "X-Attestation-Sig: ", sig, crlf,
       "X-Payment-Response: settled", crlf]

main =
  let req = read_file "/tmp/rail_http_req.txt" in
  let path = req_path req in
  let out = if (str_contains "/data" path) then
              (if has_payment req then build_resp 200 "OK" "application/json" attest_headers resource
               else build_resp 402 "Payment Required" "application/json" "" offer)
            else build_resp 404 "Not Found" "text/plain" "" "no such resource -- try GET /data" in
  print out
