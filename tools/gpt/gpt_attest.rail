-- Rail GPT — Phase 4 (start): ATTESTED training ledger.
-- Wraps a real training loop (fx-AdamW on CE grad) in a sha256 hash-chain. Each
-- step's record binds the ACTUAL EVOLVING weights (weights_sha of the current
-- params, NOT the init w0 -- the fix for the audit's w0-binding gap) + the loss +
-- the batch. Demonstrates: (A) run-twice correspondence (a witness re-running the
-- identical training reproduces the chain head bit-for-bit -> tamper-evident +
-- correspondence), (B) per-step weights_sha evolves (binds the moving weights),
-- (C) tamper detection (a flipped recorded loss changes the record hash).

import "stdlib/gpt/gpt_loss.rail"
import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"

gp_ser_v a n i acc = if i >= n then acc else gp_ser_v a n (i + 1) (cat [acc, show (arr_get a i), ","])
gp_wsha lg m v n = sha256_hex (cat [gp_ser_v lg n 0 "", "|", gp_ser_v m n 0 "", "|", gp_ser_v v n 0 ""])
gp_canon batchsha loss prev step wsha = cat ["{\"batch_sha256\":\"", batchsha, "\",\"loss_f24\":", show loss, ",\"prev_hash\":\"", prev, "\",\"step\":", show step, ",\"weights_sha256\":\"", wsha, "\"}"]
gp_rec prev batchsha loss step wsha = sha256_hex (cat [prev, gp_canon batchsha loss prev step wsha])

setup_logits lg = let _ = arr_set lg 0 16777216 in let _ = arr_set lg 1 33554432 in let _ = arr_set lg 2 0 in let _ = arr_set lg 3 16777216 in let _ = arr_set lg 4 8388608 in lg

-- attested training loop. State bundled into `st`=[lg,m,v,ex,p,dl] to keep the
-- self-recursive arity low (a 13-arg self-loop with threaded strings SIGSEGVs --
-- Rail self-loop TCO trap). Returns the chain head; records wsha per step.
gp_atrain st hp batchsha wshas prev p1 p2 step =
  let maxstep = arr_get hp 6 in
  if step > maxstep then prev
  else
    let lg = arr_get st 0 in let m = arr_get st 1 in let v = arr_get st 2 in let ex = arr_get st 3 in let p = arr_get st 4 in let dl = arr_get st 5 in
    let n = arr_get hp 0 in let target = arr_get hp 1 in let lr = arr_get hp 2 in let b1 = arr_get hp 3 in let b2 = arr_get hp 4 in let eps = arr_get hp 5 in
    let _ = gp_softmax lg ex p n in
    let _ = gp_ce_grad p dl n target 0 in
    let np1 = gp_bc_next p1 b1 in let np2 = gp_bc_next p2 b2 in
    let _ = gp_adam_vec lg m v dl n b1 b2 lr eps (16777216 - np1) (16777216 - np2) 0 0 in
    let wsha = gp_wsha lg m v n in
    let rec = gp_rec prev batchsha (arr_get p target) step wsha in
    let _ = arr_set wshas step wsha in
    gp_atrain st hp batchsha wshas rec np1 np2 (step + 1)

run_attested wshas =
  let n = 5 in
  let hp = arr_new 7 0 in
  let _ = arr_set hp 0 n in let _ = arr_set hp 1 2 in let _ = arr_set hp 2 1677721 in
  let _ = arr_set hp 3 gp_adam_beta_default1 in let _ = arr_set hp 4 gp_adam_beta_default2 in
  let _ = arr_set hp 5 gp_adam_eps_default in let _ = arr_set hp 6 20 in
  let st = arr_new 6 0 in
  let _ = arr_set st 0 (setup_logits (arr_new n 0)) in let _ = arr_set st 1 (arr_new n 0) in let _ = arr_set st 2 (arr_new n 0) in
  let _ = arr_set st 3 (arr_new n 0) in let _ = arr_set st 4 (arr_new n 0) in let _ = arr_set st 5 (arr_new n 0) in
  let batchsha = sha256_hex "1,3,2" in
  let genesis = sha256_hex "railgpt.attest.genesis.v1" in
  gp_atrain st hp batchsha wshas genesis 16777216 16777216 1

main =
  let _ = print "Phase 4: attested training ledger (sha256 hash-chain over fx-AdamW steps)" in
  let wshasA = arr_new 21 0 in let headA = run_attested wshasA in
  let wshasB = arr_new 21 0 in let headB = run_attested wshasB in
  let _ = print (cat ["  run A chain head = ", headA]) in
  let _ = print (cat ["  run B chain head = ", headB]) in
  -- (A) correspondence: independent re-run reproduces the chain head bit-for-bit
  let cA = if headA == headB then 1 else 0 in
  let _ = print (cat ["(A) run-twice head identical (correspondence/tamper-evident): ", if cA == 1 then "PASS" else "FAIL"]) in
  -- (B) weights_sha evolves step-to-step (binds the MOVING weights, not w0)
  let cB = if (arr_get wshasA 1) == (arr_get wshasA 20) then 0 else 1 in
  let _ = print (cat ["(B) weights_sha evolves (step1 != step20): ", if cB == 1 then "PASS" else "FAIL"]) in
  -- (C) tamper: recompute a record with a flipped loss -> different hash
  let honest = gp_rec "deadbeef" "b0" 12345678 7 "wsha0" in
  let tamper = gp_rec "deadbeef" "b0" 99999999 7 "wsha0" in
  let cC = if honest == tamper then 0 else 1 in
  let _ = print (cat ["(C) tamper (flip loss) -> hash differs: ", if cC == 1 then "PASS" else "FAIL"]) in
  -- (D) Ed25519-sign the chain head (LOCAL/DEV key), verify, reject a forged head.
  let seed = sha256 "railgpt.attest.dev.key.v1" in
  let pk = ed25519_pk_from_sk seed in
  let hm = sha256 headA in
  let sig = ed25519_sign seed hm 32 in
  let vok = ed25519_verify pk hm 32 sig in
  let forged = ed25519_verify pk (sha256 "forged-head") 32 sig in
  let cD = if vok == 1 then (if forged == 0 then 1 else 0) else 0 in
  let _ = print (cat ["(D) Ed25519 sign head + verify=", show vok, ", forged rejected=", show forged, " -> ", if cD == 1 then "PASS" else "FAIL"]) in
  let allok = cA * cB * cC * cD in
  print (if allok == 1 then "gpt_attest: Phase 4 attested ledger OK (evolving-weight binding, correspondence, tamper-evident, Ed25519-signed)" else "gpt_attest: FAILED")
