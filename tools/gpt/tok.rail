-- Pure-Rail tokenizer for the prodtok16k (16384) byte-level BPE -- replaces the
-- Python tok.py so the whole rail-gpt path is self-hosted.
--   tok.rail encode "<text>"   -> space-separated ids  (bytes -> cid -> apply merges in learn order)
--   tok.rail decode <id...>    -> text                 (recursive id->bytes expansion)
-- Loads base bytes from ~/.ledatic/railml-trial/tok_uniq.cache (173 bytes, id i = uniq[i])
-- and merges from ~/.ledatic/attested-corpus/build/tokenizer/prodtok16k.merges (a b c; c = 173+i).
import "stdlib/env.rail"

pint_go cs acc = if (length cs) == 0 then acc else let c = char_to_int (head cs) in if c < 48 then acc else if c > 57 then acc else pint_go (tail cs) (acc * 10 + (c - 48))
pint s = pint_go (chars s) 0

-- ===== load base bytes (uniq) -> uniq array (id->byte) + cid (256, byte->id or -1) =====
load_uniq_arr cs uniq cid i = if (length cs) == 0 then i else let b = char_to_int (head cs) in let _ = arr_set uniq i b in let _ = arr_set cid b i in load_uniq_arr (tail cs) uniq cid (i + 1)

-- ===== load merges -> ma[i], mb[i] (a,b of merge producing id 173+i) =====
load_merges lines ma mb i = if lines == [] then i else let ln = head lines in if (length (chars ln)) < 3 then load_merges (tail lines) ma mb i else let ps = split " " ln in let _ = arr_set ma i (pint (head ps)) in let _ = arr_set mb i (pint (head (tail ps))) in load_merges (tail lines) ma mb (i + 1)

-- ===== encode: text bytes -> base ids -> apply merges 0..M-1 in order =====
enc_init cs cid seq i = if (length cs) == 0 then i else let b = char_to_int (head cs) in let _ = arr_set seq i (arr_get cid b) in enc_init (tail cs) cid seq (i + 1)
-- apply one merge (a,b -> nid) over seq[0..n-1], writing to `out`, return new length
apply1 seq n a b nid out oi i = if i >= n then oi else if (i + 1 < n) then (if (arr_get seq i) == a then (if (arr_get seq (i + 1)) == b then (let _ = arr_set out oi nid in apply1 seq n a b nid out (oi + 1) (i + 2)) else (let _ = arr_set out oi (arr_get seq i) in apply1 seq n a b nid out (oi + 1) (i + 1))) else (let _ = arr_set out oi (arr_get seq i) in apply1 seq n a b nid out (oi + 1) (i + 1))) else (let _ = arr_set out oi (arr_get seq i) in apply1 seq n a b nid out (oi + 1) (i + 1))
cpn src dst n i = if i >= n then 0 else let _ = arr_set dst i (arr_get src i) in cpn src dst n (i + 1)
-- apply merges mi..M-1; seq/tmp swap via copy-back
enc_merges seq tmp n ma mb M mi = if mi >= M then n else let nn = apply1 seq n (arr_get ma mi) (arr_get mb mi) (173 + mi) tmp 0 0 in let _ = cpn tmp seq nn 0 in enc_merges seq tmp nn ma mb M (mi + 1)
ids_str seq n i acc = if i >= n then acc else ids_str seq n (i + 1) (cat [acc, show (arr_get seq i), " "])

-- ===== decode: expand id -> bytes (recursive), append to a growing string =====
dec_one uniq ma mb id = if id < 173 then (char_from_int (arr_get uniq id)) else cat [dec_one uniq ma mb (arr_get ma (id - 173)), dec_one uniq ma mb (arr_get mb (id - 173))]
dec_all uniq ma mb toks acc = if toks == [] then acc else let t = head toks in if (length (chars t)) == 0 then dec_all uniq ma mb (tail toks) acc else dec_all uniq ma mb (tail toks) (cat [acc, dec_one uniq ma mb (pint t)])

main =
  let home = getenv "HOME" in
  let ucache = read_file (cat [home, "/.ledatic/railml-trial/tok_uniq.cache"]) in
  let uniq = arr_new 256 0 in let cid = arr_new 256 (0 - 1) in
  let nb = load_uniq_arr (chars ucache) uniq cid 0 in
  let mtxt = read_file (cat [home, "/.ledatic/attested-corpus/build/tokenizer/prodtok16k.merges"]) in
  let mlines = split "\n" mtxt in
  let M = 16211 in let ma = arr_new M 0 in let mb = arr_new M 0 in
  let _ = load_merges mlines ma mb 0 in
  let verb = if (length args) >= 2 then head (tail args) else "help" in
  if verb == "encode" then
    let text = if (length args) >= 3 then head (tail (tail args)) else "" in
    let cs = chars text in let n0 = length cs in
    let seq = arr_new (n0 + 8) 0 in let tmp = arr_new (n0 + 8) 0 in
    let p = enc_init cs cid seq 0 in
    let n = enc_merges seq tmp p ma mb M 0 in
    print (ids_str seq n 0 "")
  else if verb == "decode" then
    let toks = split " " (join " " (tail (tail args))) in
    print (dec_all uniq ma mb toks "")
  else print "usage: tok.rail encode \"<text>\" | tok.rail decode <id...>"
