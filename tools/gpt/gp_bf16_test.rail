-- bf16 codec self-check: exact on powers of two, within bf16 precision elsewhere, deterministic.
import "stdlib/gpt/gp_bf16.rail"

gt_abs x = if x < 0 then 0 - x else x
eqf a b = if a == b then 1 else 0
close V = let rt = gp_f24_bf16_roundtrip V in if ((gt_abs (rt - V)) * 64) <= ((gt_abs V) + 64) then 1 else 0

main =
  let ONE = 16777216 in
  let e1 = eqf (gp_f24_bf16_roundtrip ONE) ONE in
  let e2 = eqf (gp_f24_bf16_roundtrip (ONE / 2)) (ONE / 2) in
  let e3 = eqf (gp_f24_bf16_roundtrip (2 * ONE)) (2 * ONE) in
  let e4 = eqf (gp_f24_bf16_roundtrip (0 - (2 * ONE))) (0 - (2 * ONE)) in
  let exact = e1 * e2 * e3 * e4 in
  let _ = print (join "" ["(1) exact on powers of 2 (1.0,0.5,2.0,-2.0): ", if exact == 1 then "PASS" else "FAIL"]) in
  let prec = (close 1677722) * (close 5592405) * (close (0 - 1677722)) * (close 100000000) in
  let _ = print (join "" ["(2) within bf16 precision: rt(0.1=1677722)=", show (gp_f24_bf16_roundtrip 1677722), " -> ", if prec == 1 then "PASS" else "FAIL"]) in
  let det = eqf (gp_f24_to_bf16 12345678) (gp_f24_to_bf16 12345678) in
  let _ = print (join "" ["(3) deterministic encode -> ", if det == 1 then "PASS" else "FAIL"]) in
  let store = if (gp_f24_to_bf16 1677722) < 65536 then 1 else 0 in
  let _ = print (join "" ["(4) bf16 pattern 16-bit (2 bytes vs 8): ", show (gp_f24_to_bf16 1677722), " < 65536 -> ", if store == 1 then "PASS" else "FAIL"]) in
  let allok = exact * prec * det * store in
  print (if allok == 1 then "gp_bf16_test: bf16 codec OK (exact pow2, precise, deterministic, 2-byte)" else "gp_bf16_test: FAILED")
