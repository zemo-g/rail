-- x402_deliver.rail — x402 delivery for the REAL ledatic.org datasets. On verified
-- payment, mints an Ed25519-signed download GRANT (machine analog of thanks.html's
-- signed download_url). Agent redeems download_url, verifies file vs download_sha256
-- and content vs content_sha256 (both published in data/catalog.json).
import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"
crlf = cat [char_from_int 13, char_from_int 10]
payto = "0x0129b9e66C449b4c7027F07A7b8811BBf6fb3301"

-- real products (from data/catalog.json): slug -> price(USDC micro), download_sha, content_sha, pulse
prod_price slug = if slug == "rail-verified-pairs-v2" then "199000000" else if slug == "attested-text-corpus-v2" then "499000000" else ""
prod_dlsha slug = if slug == "rail-verified-pairs-v2" then "cebed0a4072df5116812b024e7818aeb3eaa1a5334b7882c3c8e59dd7a967fff" else ""
prod_ctsha slug = if slug == "rail-verified-pairs-v2" then "1a6941afad3ad6259af6a0a48f0554108ba0b3197e8e05e53e487833a6cd046c" else if slug == "attested-text-corpus-v2" then "92e9af57335910a57e5f50d33564aa07542d6406cb0cde010f0e3c139f2e9e63" else ""
prod_pulse slug = if slug == "rail-verified-pairs-v2" then "2641877" else if slug == "attested-text-corpus-v2" then "2516402" else "0"

build_resp status stext ct extra body = cat ["HTTP/1.1 ", show status, " ", stext, crlf, "Content-Type: ", ct, crlf, "Content-Length: ", show (length (chars body)), crlf, extra, "Connection: close", crlf, crlf, body]
req_path req = let lines = str_split (cat [char_from_int 10]) req in if length lines == 0 then "/" else let parts = str_split " " (head lines) in if length parts < 2 then "/" else head (tail parts)
hval req key = let i = str_find key req in if i < 0 then "" else let rest = str_sub req (i + (length (chars key))) 400 in let nl = str_find (char_from_int 13) rest in if nl < 0 then rest else str_sub rest 0 nl
pay_msg path amount nonce = cat ["x402|exact|base|", amount, "|", payto, "|", path, "|", nonce]
verify_payment req path amount =
  let xp = hval req "X-PAYMENT: " in
  if (length (chars xp)) < 20 then 0
  else let parts = str_split "." xp in
       if (length parts) < 3 then 0
       else if ed25519_verify (hex_to_bytes (head parts)) (sha256 (pay_msg path amount (head (tail parts)))) 32 (hex_to_bytes (head (tail (tail parts)))) then 1 else 0

gwseed = sha256 "ledatic.x402.gateway.dev.key.v1"
trimnl s = let i = str_find (char_from_int 10) s in if i < 0 then s else str_sub s 0 i
sh_read cmd = let _ = shell (cat [cmd, " > /tmp/x402_sh 2>/dev/null"]) in trimnl (read_file "/tmp/x402_sh")
-- HARDENED grant (v2): single-use + expiring. Preimage binds slug|ttl|iat|jti; the
-- Ed25519 sig over it authorizes /dl. The /dl route checks now-iat<ttl and that jti
-- has not been redeemed (KV single-use). iat+jti travel in the download_url.
grant_body slug iat jti =
  let tok = bytes_to_hex (ed25519_sign gwseed (sha256 (cat ["grant|", slug, "|900|", iat, "|", jti])) 32) 64 in
  cat ["{\"product\":\"", slug, "\",\"scheme\":\"x402-grant-v2\",\"download_url\":\"https://ledatic.org/dl/", slug, "?grant=", tok, "&iat=", iat, "&jti=", jti,
       "\",\"ttl_s\":900,\"iat\":", iat, ",\"jti\":\"", jti, "\",\"download_sha256\":\"", prod_dlsha slug, "\",\"content_sha256\":\"", prod_ctsha slug, "\",\"witness_pulse\":", prod_pulse slug, "}"]
offer path amount slug = cat ["{\"x402Version\":1,\"accepts\":[{\"scheme\":\"exact\",\"network\":\"base\",\"maxAmountRequired\":\"", amount, "\",\"asset\":\"USDC\",\"payTo\":\"", payto, "\",\"resource\":\"", path, "\",\"description\":\"Ledatic attested dataset ", slug, " -- pay to receive a signed, verifiable download grant\"}]}"]

main =
  let req = read_file "/tmp/rail_http_req.txt" in
  let path = req_path req in
  if str_contains "/x402/" path then
    (let slug = str_sub path 6 60 in
     let amount = prod_price slug in
     if (length (chars amount)) == 0 then print (build_resp 404 "Not Found" "application/json" "" "{\"error\":\"unknown product; GET /data/catalog.json\"}")
     else if (verify_payment req path amount) == 1 then
       (let iat = sh_read "/bin/date +%s" in
        let jti = sh_read "/usr/bin/openssl rand -hex 12" in
        let body = grant_body slug iat jti in
        let attsig = ed25519_sign gwseed (sha256 body) 32 in
        let hdrs = cat ["X-Content-SHA256: ", prod_dlsha slug, crlf, "X-Attestation-Alg: ed25519", crlf, "X-Attestation-Sig: ", bytes_to_hex attsig 64, crlf] in
        print (build_resp 200 "OK" "application/json" hdrs body))
     else print (build_resp 402 "Payment Required" "application/json" "" (offer path amount slug)))
  else print (build_resp 200 "OK" "application/json" "" "{\"catalog\":\"https://ledatic.org/data/catalog.json\"}")
