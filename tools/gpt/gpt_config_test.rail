-- Rail GPT — config schema self-check (moved out of the module so gpt_config
-- is importable without a main clash).
import "stdlib/gpt/gpt_config.rail"

main =
  let c = gpt_config_mid 16384 42 in
  let _ = print "Rail GPT canonical config (mid preset — the model we own):" in
  let _ = print (join "" ["  n_layer=", show (gc_nlayer c), " d_model=", show (gc_dmodel c), " n_head=", show (gc_nhead c), " head_dim=", show (gc_headdim c)]) in
  let _ = print (join "" ["  d_ff=", show (gc_dff c), " block=", show (gc_block c), " vocab=", show (gc_vocab c), " fbits=", show (gc_fbits c), " tok=", show (gc_tok c), " tie_head=", show (gc_tie c)]) in
  let _ = print (join "" ["  params untied (owned model, vocab=16384) = ", show (gpt_nparams c)]) in
  let ctied = [16, 768, 12, 64, 3072, 512, 16384, 24, 1, 42, 1] in
  let _ = print (join "" ["  params if tied (future runs only)         = ", show (gpt_nparams ctied), "  (saves ", show ((gpt_nparams c) - (gpt_nparams ctied)), ")"]) in
  print "gpt_config.rail: Phase 0 schema OK"
