-- Rail GPT — end-to-end CPU forward test (Phase 2 capstone gate).
-- Tiny config (L=2, d=8, nh=2, hd=4, dff=16, vocab=5, seqL=3). W/ws/rt are ARRAYS
-- of handles (arr_get O(1)). Runs gp_forward twice: D0 + non-degenerate + in-range.

import "stdlib/gpt/gpt_forward.rail"

mkc_go a n v i = if i >= n then a else let _ = arr_set a i v in mkc_go a n v (i + 1)
mkc n v = mkc_go (arr_new n 0) n v 0
mkp_go a n seed i = if i >= n then a else let _ = arr_set a i (((((i * 37) + seed) % 11) - 5) * 65536) in mkp_go a n seed (i + 1)
mkp n seed = mkp_go (arr_new n 0) n seed 0

-- fill 16 per-layer slots into weight array W at base bb (attn biases = zero, matching real model)
mk_setlayer W bb d dff seed =
  let _ = arr_set W (bb + 0) (mkc d 16777216) in let _ = arr_set W (bb + 1) (mkc d 0) in
  let _ = arr_set W (bb + 2) (mkp (d * d) (seed + 1)) in let _ = arr_set W (bb + 3) (mkc d 0) in
  let _ = arr_set W (bb + 4) (mkp (d * d) (seed + 2)) in let _ = arr_set W (bb + 5) (mkc d 0) in
  let _ = arr_set W (bb + 6) (mkp (d * d) (seed + 3)) in let _ = arr_set W (bb + 7) (mkc d 0) in
  let _ = arr_set W (bb + 8) (mkp (d * d) (seed + 4)) in let _ = arr_set W (bb + 9) (mkc d 0) in
  let _ = arr_set W (bb + 10) (mkc d 16777216) in let _ = arr_set W (bb + 11) (mkc d 0) in
  let _ = arr_set W (bb + 12) (mkp (d * dff) (seed + 5)) in let _ = arr_set W (bb + 13) (mkc dff 0) in
  let _ = arr_set W (bb + 14) (mkp (dff * d) (seed + 6)) in let _ = arr_set W (bb + 15) (mkc d 0) in
  W

mk_weights cfg =
  let d = gc_dmodel cfg in let dff = gc_dff cfg in let vocab = gc_vocab cfg in let block = gc_block cfg in
  let hb = 2 + (gc_nlayer cfg) * 16 in
  let W = arr_new (hb + 3) 0 in
  let _ = arr_set W 0 (mkp (vocab * d) 100) in let _ = arr_set W 1 (mkp (block * d) 200) in
  let _ = mk_setlayer W 2 d dff 300 in
  let _ = mk_setlayer W 18 d dff 400 in
  let _ = arr_set W hb (mkc d 16777216) in let _ = arr_set W (hb + 1) (mkc d 0) in let _ = arr_set W (hb + 2) (mkp (vocab * d) 500) in
  W

mk_ws cfg seqL =
  let d = gc_dmodel cfg in let dff = gc_dff cfg in let vocab = gc_vocab cfg in
  let ws = arr_new 11 0 in
  let _ = arr_set ws 0 (arr_new d 0) in let _ = arr_set ws 1 (arr_new (seqL * d) 0) in
  let _ = arr_set ws 2 (arr_new (seqL * d) 0) in let _ = arr_set ws 3 (arr_new (seqL * d) 0) in
  let _ = arr_set ws 4 (arr_new (seqL * d) 0) in let _ = arr_set ws 5 (arr_new seqL 0) in
  let _ = arr_set ws 6 (arr_new seqL 0) in let _ = arr_set ws 7 (arr_new dff 0) in
  let _ = arr_set ws 8 (arr_new d 0) in let _ = arr_set ws 9 (arr_new d 0) in let _ = arr_set ws 10 (arr_new vocab 0) in
  ws

mk_rt seqL scaleq eps = let rt = arr_new 3 0 in let _ = arr_set rt 0 seqL in let _ = arr_set rt 1 scaleq in let _ = arr_set rt 2 eps in rt

gt_sum a n i acc = if i >= n then acc else gt_sum a n (i + 1) (acc + arr_get a i)
gt_any_nz a n i = if i >= n then 0 else if (arr_get a i) == 0 then gt_any_nz a n (i + 1) else 1
gt_abs x = if x < 0 then 0 - x else x
gt_bound a n bnd i = if i >= n then 1 else if (gt_abs (arr_get a i)) < bnd then gt_bound a n bnd (i + 1) else 0
gt_show a n i accl = if i >= n then join " " (reverse accl) else gt_show a n (i + 1) (cons (show (arr_get a i)) accl)

main =
  let cfg = [2, 8, 2, 4, 16, 8, 5, 24, 0, 1, 0] in
  let seqL = 3 in let vocab = 5 in let d = 8 in
  let rt = mk_rt seqL 8388608 168 in
  let W = mk_weights cfg in
  let ids = arr_new seqL 0 in
  let _ = arr_set ids 0 1 in let _ = arr_set ids 1 3 in let _ = arr_set ids 2 2 in
  let X1 = arr_new (seqL * d) 0 in let lg1 = arr_new (seqL * vocab) 0 in
  let _ = gp_forward W cfg rt (mk_ws cfg seqL) X1 ids lg1 in
  let X2 = arr_new (seqL * d) 0 in let lg2 = arr_new (seqL * vocab) 0 in
  let _ = gp_forward W cfg rt (mk_ws cfg seqL) X2 ids lg2 in
  let n = seqL * vocab in
  let k1 = gt_sum lg1 n 0 0 in let k2 = gt_sum lg2 n 0 0 in
  let d0 = if k1 == k2 then 1 else 0 in
  let nz = gt_any_nz lg1 n 0 in
  let bnd = gt_bound lg1 n 1125899906842624 0 in
  let _ = print (join "" ["forward logits: ", gt_show lg1 n 0 []]) in
  let _ = print (join "" ["(A) D0 run-twice identical: ", show k1, " == ", show k2, " -> ", if d0 == 1 then "PASS" else "FAIL"]) in
  let _ = print (join "" ["(B) non-degenerate:  ", if nz == 1 then "PASS" else "FAIL"]) in
  let _ = print (join "" ["(C) in-range:        ", if bnd == 1 then "PASS" else "FAIL"]) in
  let allok = d0 * nz * bnd in
  print (if allok == 1 then "gpt_forward_test: Phase 2 CPU forward OK (embed+2 blocks+lnf+head, D0)" else "gpt_forward_test: FAILED")
