-- Rail GPT — end-to-end CPU forward test (Phase 2 capstone gate).
-- Tiny config (L=2, d=8, nh=2, hd=4, dff=16, vocab=5, seqL=3). Runs gp_forward
-- twice: D0 determinism (logits bit-identical) + non-degenerate + in-range.

import "stdlib/gpt/gpt_forward.rail"

mkc_go a n v i = if i >= n then a else let _ = arr_set a i v in mkc_go a n v (i + 1)
mkc n v = mkc_go (arr_new n 0) n v 0
mkp_go a n seed i = if i >= n then a else let _ = arr_set a i (((((i * 37) + seed) % 11) - 5) * 65536) in mkp_go a n seed (i + 1)
mkp n seed = mkp_go (arr_new n 0) n seed 0
appl a b = if a == [] then b else cons (head a) (appl (tail a) b)

mk_layer d dff seed = [mkc d 16777216, mkc d 0, mkp (d * d) (seed + 1), mkc d 0, mkp (d * d) (seed + 2), mkc d 0, mkp (d * d) (seed + 3), mkc d 0, mkp (d * d) (seed + 4), mkc d 0, mkc d 16777216, mkc d 0, mkp (d * dff) (seed + 5), mkc dff 0, mkp (dff * d) (seed + 6), mkc d 0]

mk_weights cfg =
  let d = gc_dmodel cfg in let dff = gc_dff cfg in let vocab = gc_vocab cfg in let block = gc_block cfg in
  let emb = [mkp (vocab * d) 100, mkp (block * d) 200] in
  let l0 = mk_layer d dff 300 in
  let l1 = mk_layer d dff 400 in
  let tl = [mkc d 16777216, mkc d 0, mkp (vocab * d) 500] in
  appl emb (appl l0 (appl l1 tl))

mk_ws cfg seqL =
  let d = gc_dmodel cfg in let dff = gc_dff cfg in let vocab = gc_vocab cfg in
  [arr_new d 0, arr_new (seqL * d) 0, arr_new (seqL * d) 0, arr_new (seqL * d) 0, arr_new (seqL * d) 0, arr_new seqL 0, arr_new seqL 0, arr_new dff 0, arr_new d 0, arr_new d 0, arr_new vocab 0]

gt_sum a n i acc = if i >= n then acc else gt_sum a n (i + 1) (acc + arr_get a i)
gt_any_nz a n i = if i >= n then 0 else if (arr_get a i) == 0 then gt_any_nz a n (i + 1) else 1
gt_abs x = if x < 0 then 0 - x else x
gt_bound a n bnd i = if i >= n then 1 else if (gt_abs (arr_get a i)) < bnd then gt_bound a n bnd (i + 1) else 0
gt_show a n i accl = if i >= n then join " " (reverse accl) else gt_show a n (i + 1) (cons (show (arr_get a i)) accl)

main =
  let cfg = [2, 8, 2, 4, 16, 8, 5, 24, 0, 1, 0] in
  let seqL = 3 in
  let rt = [seqL, 8388608, 168] in
  let vocab = 5 in let d = 8 in
  let W = mk_weights cfg in
  let ids = arr_new seqL 0 in
  let _ = arr_set ids 0 1 in let _ = arr_set ids 1 3 in let _ = arr_set ids 2 2 in
  let X1 = arr_new (seqL * d) 0 in let lg1 = arr_new (seqL * vocab) 0 in
  let _ = gp_forward W cfg rt (mk_ws cfg seqL) X1 ids lg1 in
  let X2 = arr_new (seqL * d) 0 in let lg2 = arr_new (seqL * vocab) 0 in
  let _ = gp_forward W cfg rt (mk_ws cfg seqL) X2 ids lg2 in
  let n = seqL * vocab in
  let k1 = gt_sum lg1 n 0 0 in let k2 = gt_sum lg2 n 0 0 in
  let d0 = if k1 == k2 then 1 else 0 in
  let nz = gt_any_nz lg1 n 0 in
  let bnd = gt_bound lg1 n 1125899906842624 0 in
  let _ = print (join "" ["forward logits (3 tok x 5 vocab, F=24): ", gt_show lg1 n 0 []]) in
  let _ = print (join "" ["(A) D0 run-twice logits identical: ", show k1, " == ", show k2, " -> ", if d0 == 1 then "PASS" else "FAIL"]) in
  let _ = print (join "" ["(B) non-degenerate (some nonzero):  ", if nz == 1 then "PASS" else "FAIL"]) in
  let _ = print (join "" ["(C) in-range (|logit| < 2^50):      ", if bnd == 1 then "PASS" else "FAIL"]) in
  let allok = d0 * nz * bnd in
  print (if allok == 1 then "gpt_forward_test: Phase 2 CPU forward OK (embed+2 blocks+lnf+head, D0)" else "gpt_forward_test: FAILED")
