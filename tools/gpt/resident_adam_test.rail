-- resident_adam_test.rail (2026-07-08): prove the resident Adam kernel is
-- BYTE-IDENTICAL to the current staged adam_w on the same W/m/v/dW. Gate before
-- rewiring the trainer's 96 adam calls to the resident path.
import "stdlib/ijit.rail"

cpseg src so dst dofs n i = if i >= n then 0 else let _ = arr_set dst (dofs + i) (arr_get src (so + i)) in cpseg src so dst dofs n (i + 1)
fill a n i = if i >= n then 0 else let _ = arr_set a i (((i * 1103515245 + 12345) - ((i * 1103515245 + 12345) / 40009) * 40009) - 20000) in fill a n (i + 1)
firstdiff a b n i = if i >= n then (0 - 1) else (if (arr_get a i) == (arr_get b i) then firstdiff a b n (i + 1) else i)

-- staged adam_w, verbatim from the trainer (kAdam = emit_msl_fx_adam_step)
adam_w_staged W dW m v n kAdam c1 c2 =
  let P = arr_new (3 * n + 2) 0 in
  let _ = cpseg W 0 P 0 n 0 in
  let _ = cpseg m 0 P n n 0 in
  let _ = cpseg v 0 P (2 * n) n 0 in
  let _ = arr_set P (3 * n) c1 in let _ = arr_set P (3 * n + 1) c2 in
  let O = arr_new (3 * n) 0 in
  let _ = ijit_run kAdam P dW O (3 * n + 2) n (3 * n) n in
  let _ = cpseg O 0 W 0 n 0 in let _ = cpseg O n m 0 n 0 in let _ = cpseg O (2 * n) v 0 n 0 in 0

main =
  let n = 3072 * 768 in                       -- inter*d, the biggest weight (2.4M)
  let b1 = 15099494 in let b2 = 16760439 in let eps = 16777 in let lr = 1677 in
  let c1 = 3355443 in let c2 = 1677721 in     -- arbitrary bias-corrections
  let W0 = arr_new n 0 in let _ = fill W0 n 0 in
  let M0 = arr_new n 0 in let _ = fill M0 n 7 in
  let V0 = arr_new n 0 in let _ = fill V0 n 13 in
  let dW = arr_new n 0 in let _ = fill dW n 3 in
  -- STAGED (mutates copies)
  let Ws = arr_new n 0 in let _ = cpseg W0 0 Ws 0 n 0 in
  let Ms = arr_new n 0 in let _ = cpseg M0 0 Ms 0 n 0 in
  let Vs = arr_new n 0 in let _ = cpseg V0 0 Vs 0 n 0 in
  let kAdam = ijit_compile (emit_msl_fx_adam_step n b1 b2 eps lr) in
  let _ = adam_w_staged Ws dW Ms Vs n kAdam c1 c2 in
  -- RESIDENT
  let kAdamR = ijit_compile (emit_msl_fx_adam_step_r n b1 b2 eps lr) in
  let wh = ibuf_upload W0 n in
  let mh = abuf_alloc n in let _ = abuf_upload mh M0 n in
  let vh = abuf_alloc n in let _ = abuf_upload vh V0 n in
  let gh = abuf_alloc n in let _ = abuf_upload gh dW n in
  let C = arr_new 2 0 in let _ = arr_set C 0 c1 in let _ = arr_set C 1 c2 in
  let ch = abuf_alloc 2 in let _ = abuf_upload ch C 2 in
  let _ = ijit_run_adam_r kAdamR wh gh mh vh ch n in
  let Wr = arr_new n 0 in let _ = abuf_download wh Wr n in
  let Mr = arr_new n 0 in let _ = abuf_download mh Mr n in
  let Vr = arr_new n 0 in let _ = abuf_download vh Vr n in
  -- compare
  let dwv = firstdiff Ws Wr n 0 in
  let dmv = firstdiff Ms Mr n 0 in
  let dvv = firstdiff Vs Vr n 0 in
  let _ = if dwv < 0 then print "W: BYTE-EXACT" else print (cat ["W MISMATCH @", show dwv, " staged=", show (arr_get Ws dwv), " res=", show (arr_get Wr dwv)]) in
  let _ = if dmv < 0 then print "M: BYTE-EXACT" else print (cat ["M MISMATCH @", show dmv]) in
  let _ = if dvv < 0 then print "V: BYTE-EXACT" else print (cat ["V MISMATCH @", show dvv]) in
  let _ = if (dwv < 0) then (if (dmv < 0) then (if (dvv < 0) then print "RESIDENT ADAM == STAGED ADAM (all of W,M,V)" else 0) else 0) else 0 in
  0
