-- Rail GPT — Phase 3a: optimizer + CE-loss training-loop validation.
-- Optimize a logit vector directly with fx-AdamW on the CE gradient (dl = p - onehot).
-- p[target] must climb toward ONE (loss descends), and the run must be D0-deterministic.

import "stdlib/gpt/gpt_loss.rail"

gp_train_loop lg m v ex p dl hp p1 p2 step =
  let n = arr_get hp 0 in let target = arr_get hp 1 in let maxstep = arr_get hp 6 in
  if step > maxstep then 0
  else
    let lr = arr_get hp 2 in let b1 = arr_get hp 3 in let b2 = arr_get hp 4 in let eps = arr_get hp 5 in
    let _ = gp_softmax lg ex p n in
    let _ = gp_ce_grad p dl n target 0 in
    let np1 = gp_bc_next p1 b1 in let np2 = gp_bc_next p2 b2 in
    let c1 = 16777216 - np1 in let c2 = 16777216 - np2 in
    let _ = gp_adam_vec lg m v dl n b1 b2 lr eps c1 c2 0 0 in
    let pt = arr_get p target in
    let _ = if (step - (step / 5) * 5) == 0 then print (join "" ["  step ", show step, ": p[target]=", show pt, " (/", show 16777216, ")"]) else 0 in
    gp_train_loop lg m v ex p dl hp p1 p2 (step + 1)

setup_logits lg =
  let _ = arr_set lg 0 16777216 in let _ = arr_set lg 1 33554432 in let _ = arr_set lg 2 0 in
  let _ = arr_set lg 3 16777216 in let _ = arr_set lg 4 8388608 in lg

run_train maxstep =
  let ONE = 16777216 in let n = 5 in let target = 2 in
  let lg = setup_logits (arr_new n 0) in
  let m = arr_new n 0 in let v = arr_new n 0 in
  let ex = arr_new n 0 in let p = arr_new n 0 in let dl = arr_new n 0 in
  let hp = arr_new 7 0 in
  let _ = arr_set hp 0 n in let _ = arr_set hp 1 target in let _ = arr_set hp 2 1677721 in
  let _ = arr_set hp 3 gp_adam_beta_default1 in let _ = arr_set hp 4 gp_adam_beta_default2 in
  let _ = arr_set hp 5 gp_adam_eps_default in let _ = arr_set hp 6 maxstep in
  let _ = gp_softmax lg ex p n in
  let p0 = arr_get p target in
  let _ = gp_train_loop lg m v ex p dl hp 16777216 16777216 1 in
  let _ = gp_softmax lg ex p n in
  let pf = arr_get p target in
  let _ = print (join "" ["  initial p[target]=", show p0, "  final p[target]=", show pf]) in
  pf

main =
  let _ = print "Phase 3a: fx-AdamW + CE gradient descent on logits (target=2)" in
  let f1 = run_train 30 in
  let _ = print "--- second run (D0 determinism) ---" in
  let f2 = run_train 30 in
  let descends = if f1 > 12000000 then 1 else 0 in     -- final p[target] > ~0.72
  let d0 = if f1 == f2 then 1 else 0 in
  let _ = print (join "" ["(A) loss descends (p[target] -> ~1): final=", show f1, " > 0.72*ONE -> ", if descends == 1 then "PASS" else "FAIL"]) in
  let _ = print (join "" ["(B) D0 run-twice identical: ", show f1, " == ", show f2, " -> ", if d0 == 1 then "PASS" else "FAIL"]) in
  let allok = descends * d0 in
  print (if allok == 1 then "gpt_train_test: Phase 3a optimizer+loss OK (fx-AdamW descends, D0)" else "gpt_train_test: FAILED")
