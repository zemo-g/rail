-- Rail GPT — CPU twin self-checks (Phase 2). Verifies the fx substrate and the
-- LayerNorm twin without GPU. GPU==CPU byte-equality is a later hardware step;
-- here we prove the CPU twin is exact (known sqrt/rsqrt), structurally correct
-- (constant input -> beta), and deterministic (D0 run-twice identical).

import "stdlib/gpt/gpt_attn.rail"

gt_set4 a v0 v1 v2 v3 =
  let _ = arr_set a 0 v0 in let _ = arr_set a 1 v1 in
  let _ = arr_set a 2 v2 in let _ = arr_set a 3 v3 in a

gt_sum a d i acc = if i >= d then acc else gt_sum a d (i + 1) (acc + arr_get a i)

gt_all_eq a d v i = if i >= d then 1 else if (arr_get a i) == v then gt_all_eq a d v (i + 1) else 0

gt_abs x = if x < 0 then 0 - x else x

gt_fill a n seed i = if i >= n then a else let _ = arr_set a i ((((i * 131) + seed) - (((i * 131) + seed) / 17) * 17 - 8) * 1048576) in gt_fill a n seed (i + 1)
gt_eqrange a b d i = if i >= d then 1 else if (arr_get a i) == (arr_get b i) then gt_eqrange a b d (i + 1) else 0

main =
  let ONE = 16777216 in
  -- (1) exact sqrt / rsqrt: sqrt(4)=2, rsqrt(4)=0.5
  let sq = gfx_fxsqrt (4 * ONE) in
  let rs = gfx_fxrsqrt (4 * ONE) in
  let c1 = if sq == (2 * ONE) then (if rs == (ONE / 2) then 1 else 0) else 0 in
  let _ = print (join "" ["(1) sqrt(4)=", show sq, " rsqrt(4)=", show rs, "  -> ", if c1 == 1 then "PASS" else "FAIL"]) in

  -- (2) constant input -> output == beta elementwise (dx = 0)
  let d = 4 in
  let xc = gt_set4 (arr_new d 0) (5 * ONE) (5 * ONE) (5 * ONE) (5 * ONE) in
  let g1 = gt_set4 (arr_new d 0) ONE ONE ONE ONE in
  let bb = gt_set4 (arr_new d 0) 11744051 11744051 11744051 11744051 in   -- beta = 0.7
  let xn2 = arr_new d 0 in
  let _ = gp_layernorm xc 0 xn2 g1 bb d 168 in
  let c2 = gt_all_eq xn2 d 11744051 0 in
  let _ = print (join "" ["(2) constant-in -> out==beta: ", if c2 == 1 then "PASS" else "FAIL"]) in

  -- (3) D0 determinism: LayerNorm of [1,2,3,4] twice, checksums identical
  let xv = gt_set4 (arr_new d 0) ONE (2 * ONE) (3 * ONE) (4 * ONE) in
  let g0 = gt_set4 (arr_new d 0) ONE ONE ONE ONE in
  let b0 = arr_new d 0 in
  let o1 = arr_new d 0 in let _ = gp_layernorm xv 0 o1 g0 b0 d 168 in
  let o2 = arr_new d 0 in let _ = gp_layernorm xv 0 o2 g0 b0 d 168 in
  let k1 = gt_sum o1 d 0 0 in
  let k2 = gt_sum o2 d 0 0 in
  let c3 = if k1 == k2 then 1 else 0 in
  let _ = print (join "" ["(3) D0 run-twice checksum: ", show k1, " == ", show k2, "  -> ", if c3 == 1 then "PASS" else "FAIL"]) in

  -- (4) idot: dot([2,1],[1,1]) = 3.0
  let av = gt_set4 (arr_new 2 0) (2 * ONE) ONE 0 0 in
  let bv = gt_set4 (arr_new 2 0) ONE ONE 0 0 in
  let dv = gfx_dot av 0 bv 0 2 in
  let c4 = if dv == (3 * ONE) then 1 else 0 in
  let _ = print (join "" ["(4) idot([2,1].[1,1]) = ", show dv, "  -> ", if c4 == 1 then "PASS" else "FAIL"]) in

  -- (5) floor-shift on negative (must FLOOR, not truncate): floor(-1.5) = -2
  let fs = gfx_floorshift24 (0 - 25165824) in
  let c5 = if fs == (0 - 2) then 1 else 0 in
  let _ = print (join "" ["(5) floorshift24(-1.5) = ", show fs, "  (floor=-2, trunc=-1) -> ", if c5 == 1 then "PASS" else "FAIL"]) in

  -- (6) NON-symmetric matvec, [out,in] layout: W=[[1,2],[3,4]] (row-major o*in+i),
  --     x=[10,20] -> y=[1*10+2*20, 3*10+4*20]=[50,110]. Locks the raw-nn.Linear convention.
  let W = gt_set4 (arr_new 4 0) ONE (2 * ONE) (3 * ONE) (4 * ONE) in
  let xx = gt_set4 (arr_new 2 0) (10 * ONE) (20 * ONE) 0 0 in
  let bz = arr_new 2 0 in
  let yy = arr_new 2 0 in
  let _ = gfx_matvec W xx bz yy 2 2 0 in
  let c6 = if (arr_get yy 0) == (50 * ONE) then (if (arr_get yy 1) == (110 * ONE) then 1 else 0) else 0 in
  let _ = print (join "" ["(6) matvec([[1,2],[3,4]],[10,20]) = [", show (arr_get yy 0), ",", show (arr_get yy 1), "] (want [50,110]*S) -> ", if c6 == 1 then "PASS" else "FAIL"]) in

  -- (7) GELU: gelu(0)=0 exact; gelu(2.0) in (1.9, 2.0) band
  let ge0 = bx4_gelu 0 in
  let ge2 = bx4_gelu (2 * ONE) in
  let c7 = if ge0 == 0 then (if ge2 > (32044646) then (if ge2 < (2 * ONE) then 1 else 0) else 0) else 0 in
  let _ = print (join "" ["(7) gelu(0)=", show ge0, " gelu(2.0)=", show ge2, " (~1.954) -> ", if c7 == 1 then "PASS" else "FAIL"]) in

  -- (8) MLP: zero input + zero bias -> zero output (gelu(0)=0); and D0 determinism
  let dff = 4 in
  let W1 = arr_new (d * dff) 0 in let W2 = arr_new (dff * d) 0 in
  let b1 = arr_new dff 0 in let b2 = arr_new d 0 in
  let x0 = arr_new d 0 in
  let tmp = arr_new dff 0 in
  let m1 = arr_new d 0 in let _ = gp_mlp x0 W1 b1 W2 b2 d dff tmp m1 in
  let m2 = arr_new d 0 in let _ = gp_mlp x0 W1 b1 W2 b2 d dff tmp m2 in
  let mz = if (gt_sum m1 d 0 0) == 0 then 1 else 0 in
  let md0 = if (gt_sum m1 d 0 0) == (gt_sum m2 d 0 0) then 1 else 0 in
  let c8 = if mz == 1 then md0 else 0 in
  let _ = print (join "" ["(8) MLP(0,bias0)=0 & D0: ", if c8 == 1 then "PASS" else "FAIL"]) in

  -- (9) causal MHA core: token-0 context == V token-0 EXACTLY (only key 0 unmasked
  --     -> softmax exactly 1.0); plus D0 run-twice determinism.
  let sq = 3 in let nh2 = 2 in let hd2 = 4 in let qd = 8 in     -- qd = nh2*hd2
  let scq = 8388608 in                                          -- 1/sqrt(4)=0.5 in F=24
  let n = sq * qd in
  let qa = gt_fill (arr_new n 0) n 11 0 in
  let ka = gt_fill (arr_new n 0) n 23 0 in
  let va = gt_fill (arr_new n 0) n 37 0 in
  let scb = arr_new sq 0 in let exb = arr_new sq 0 in
  let at1 = arr_new n 0 in let _ = gp_attn_core qa ka va scb exb at1 nh2 qd hd2 sq scq 0 in
  let at2 = arr_new n 0 in let _ = gp_attn_core qa ka va scb exb at2 nh2 qd hd2 sq scq 0 in
  let causal = gt_eqrange at1 va qd 0 in
  let ad0 = if (gt_sum at1 n 0 0) == (gt_sum at2 n 0 0) then 1 else 0 in
  let c9 = if causal == 1 then ad0 else 0 in
  let _ = print (join "" ["(9) MHA token-0 ctx==V[0] (causal) & D0: ", if c9 == 1 then "PASS" else "FAIL"]) in

  -- (info) normalized row (beta=0,gamma=1) sums ~ 0
  let _ = print (join "" ["(i) normalized-row sum (beta=0) = ", show k1, " (near 0 expected)"]) in

  let allok = c1 * c2 * c3 * c4 * c5 * c6 * c7 * c8 * c9 in
  print (if allok == 1 then "gpt_twins_test: Phase 2 CPU twins OK (substrate+LN+matmul+gelu+MLP+MHA)" else "gpt_twins_test: FAILED")
