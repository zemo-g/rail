-- Rail GPT — SELF-CONTAINED bf16-weight 138M forward. All twins in this compilation
-- unit (Rail cannot reference transitive symbols); leaf imports only (no diamonds).
-- Weight matrices stored bf16 (4x smaller), decoded on the fly to exact F=24.
import "stdlib/gpt/gpt_config.rail"
import "tools/bitexact/bx_fixed.rail"
import "stdlib/gpt/gp_bf16.rail"
import "stdlib/file.rail"
import "stdlib/env.rail"
foreign pread fd buf count offset -> int

gfx_floorshift24 acc = mul_shr acc 1 24
gfx_sqrt_le r xq =
  let hr = mul_shr r r 24 in
  if hr < xq then true
  else if hr > xq then false
  else
    let c  = r - (r / 16777216) * 16777216 in
    let cc = c * c in
    (cc - (cc / 16777216) * 16777216) == 0
gfx_bsqrt lo hi xq =
  if (lo + 1) >= hi then lo
  else
    let mid = (lo + hi) / 2 in
    if gfx_sqrt_le mid xq then gfx_bsqrt mid hi xq
    else gfx_bsqrt lo mid xq
gfx_fxsqrt xq = if xq < 1 then 0 else gfx_bsqrt 0 ((16384 * 16384) * 4096) xq
gfx_fxrsqrt xq = let q = gfx_fxsqrt xq in if q == 0 then 0 else 281474976710656 / q

-- ===== matmul / idot atom (twin of fx_matmul24: int64 accumulate, then >>24) =====
-- mul_shr floors (verified), so acc>>24 == mul_shr acc 1 24 -- the SAME primitive
-- the GPU uses, guaranteeing bit-identical floor-shift (trunc `/` would diverge on
-- negatives). Products accumulate raw (F=48); caller keeps the sum inside gk bounds.
gfx_mv_col_bf16 W x in_d o out_d i acc =
  if i >= in_d then acc
  else gfx_mv_col_bf16 W x in_d o out_d (i + 1) (acc + (arr_get x i) * (gp_bf16_to_f24 (arr_get W (o * in_d + i))))
gfx_matvec_bf16 W x bias y in_d out_d o =
  if o >= out_d then y
  else let _ = arr_set y o ((gfx_floorshift24 (gfx_mv_col_bf16 W x in_d o out_d 0 0)) + (arr_get bias o)) in
       gfx_matvec_bf16 W x bias y in_d out_d (o + 1)
gfx_mv_col_off_bf16 W x xoff in_d o out_d i acc =
  if i >= in_d then acc
  else gfx_mv_col_off_bf16 W x xoff in_d o out_d (i + 1) (acc + (arr_get x (xoff + i)) * (gp_bf16_to_f24 (arr_get W (o * in_d + i))))
gfx_matvec_off_bf16 W x xoff bias y yoff in_d out_d o =
  if o >= out_d then y
  else let _ = arr_set y (yoff + o) ((gfx_floorshift24 (gfx_mv_col_off_bf16 W x xoff in_d o out_d 0 0)) + (arr_get bias o)) in
       gfx_matvec_off_bf16 W x xoff bias y yoff in_d out_d (o + 1)
-- encode an F=24 weight array (src) into a bf16 array (dst).
gfx_bf16_encode_arr src dst n i = if i >= n then dst else let _ = arr_set dst i (gp_f24_to_bf16 (arr_get src i)) in gfx_bf16_encode_arr src dst n (i + 1)

gp_ln_sum X base d i acc =
  if i >= d then acc else gp_ln_sum X base d (i + 1) (acc + arr_get X (base + i))
gp_ln_var X base d mean i acc =
  if i >= d then acc
  else let dx = (arr_get X (base + i)) - mean in
       gp_ln_var X base d mean (i + 1) (acc + mul_shr dx dx 24)
gp_ln_apply X base xn gamma beta d mean inv i =
  if i >= d then xn
  else let dx = (arr_get X (base + i)) - mean in
       let _ = arr_set xn i ((mul_shr (mul_shr dx inv 24) (arr_get gamma i) 24) + (arr_get beta i)) in
       gp_ln_apply X base xn gamma beta d mean inv (i + 1)
gp_layernorm X base xn gamma beta d eps =
  let s = gp_ln_sum X base d 0 0 in
  let mean = s / d in
  let vs = gp_ln_var X base d mean 0 0 in
  let var = vs / d in
  let inv = gfx_fxrsqrt (var + eps) in
  gp_ln_apply X base xn gamma beta d mean inv 0

ga_raw q k qi kj hd c acc =
  if c >= hd then acc
  else ga_raw q k qi kj hd (c + 1) (acc + ((arr_get q (qi + c)) * (arr_get k (kj + c))))
ga_scores q k sc i h qdim hd seqL scaleq j =
  if j >= seqL then 0
  else
    let scv = if j > i then (0 - 16777216000)
              else let raw = mul_shr (ga_raw q k (i * qdim + h * hd) (j * qdim + h * hd) hd 0 0) 1 24 in (raw * scaleq) / 16777216 in
    let _ = arr_set sc j scv in
    ga_scores q k sc i h qdim hd seqL scaleq (j + 1)
ga_rowmax sc seqL j m =
  if j >= seqL then m else ga_rowmax sc seqL (j + 1) (let v = arr_get sc j in if v > m then v else m)
ga_exprow sc ex seqL m j sum =
  if j >= seqL then sum
  else let e = bx4_exp_neg (m - (arr_get sc j)) in let _ = arr_set ex j e in ga_exprow sc ex seqL m (j + 1) (sum + e)
ga_pvdot ex v vb qdim seqL sum j acc =
  if j >= seqL then acc
  else let p = ((arr_get ex j) * 16777216) / sum in
       ga_pvdot ex v vb qdim seqL sum (j + 1) (acc + (p * (arr_get v (vb + j * qdim))))
ga_ctx ex v attn i h qdim hd seqL sum c =
  if c >= hd then 0
  else
    let acc = ga_pvdot ex v (h * hd + c) qdim seqL sum 0 0 in
    let _ = arr_set attn (i * qdim + h * hd + c) (mul_shr acc 1 24) in
    ga_ctx ex v attn i h qdim hd seqL sum (c + 1)
ga_head q k v sc ex attn i h qdim hd seqL scaleq =
  let _ = ga_scores q k sc i h qdim hd seqL scaleq 0 in
  let m = ga_rowmax sc seqL 1 (arr_get sc 0) in
  let sum = ga_exprow sc ex seqL m 0 0 in
  ga_ctx ex v attn i h qdim hd seqL sum 0
ga_heads q k v sc ex attn i nh qdim hd seqL scaleq h =
  if h >= nh then 0
  else let _ = ga_head q k v sc ex attn i h qdim hd seqL scaleq in ga_heads q k v sc ex attn i nh qdim hd seqL scaleq (h + 1)

-- full causal MHA context over the sequence. q,k,v,attn : [seqL*qdim]. sc,ex : [seqL].
gp_attn_core q k v sc ex attn nh qdim hd seqL scaleq i =
  if i >= seqL then attn
  else let _ = ga_heads q k v sc ex attn i nh qdim hd seqL scaleq 0 in gp_attn_core q k v sc ex attn nh qdim hd seqL scaleq (i + 1)

gp_gelu_vec x y d i =
  if i >= d then y
  else let _ = arr_set y i (bx4_gelu (arr_get x i)) in gp_gelu_vec x y d (i + 1)

-- x[d] -> out[d]. tmp is scratch[d_ff]. up-proj, GELU in place, down-proj.

gp_addinto X base src d c =
  if c >= d then 0
  else let _ = arr_set X (base + c) ((arr_get X (base + c)) + (arr_get src c)) in gp_addinto X base src d (c + 1)

-- ===== embeddings: X[i] = tok[id_i] + pos[i] =====

gp_rt_seq rt = arr_get rt 0
gp_rt_scale rt = arr_get rt 1
gp_rt_eps rt = arr_get rt 2


gp_embed_row_b tokw posw X xb tb pb d c =
  if c >= d then 0
  else let _ = arr_set X (xb + c) ((gp_bf16_to_f24 (arr_get tokw (tb + c))) + (gp_bf16_to_f24 (arr_get posw (pb + c)))) in gp_embed_row_b tokw posw X xb tb pb d (c + 1)
gp_embed_b W cfg X ids seqL i =
  if i >= seqL then X
  else let d = gc_dmodel cfg in
       let _ = gp_embed_row_b (arr_get W 0) (arr_get W 1) X (i * d) ((arr_get ids i) * d) (i * d) d 0 in
       gp_embed_b W cfg X ids seqL (i + 1)
gp_qkv_b W bb cfg rt ws X i =
  if i >= (gp_rt_seq rt) then 0
  else let d = gc_dmodel cfg in
    let lnbuf = arr_get ws 0 in
    let _ = gp_layernorm X (i * d) lnbuf (arr_get W (bb + 0)) (arr_get W (bb + 1)) d (gp_rt_eps rt) in
    let _ = gfx_matvec_off_bf16 (arr_get W (bb + 2)) lnbuf 0 (arr_get W (bb + 3)) (arr_get ws 1) (i * d) d d 0 in
    let _ = gfx_matvec_off_bf16 (arr_get W (bb + 4)) lnbuf 0 (arr_get W (bb + 5)) (arr_get ws 2) (i * d) d d 0 in
    let _ = gfx_matvec_off_bf16 (arr_get W (bb + 6)) lnbuf 0 (arr_get W (bb + 7)) (arr_get ws 3) (i * d) d d 0 in
    gp_qkv_b W bb cfg rt ws X (i + 1)
gp_oproj_b W bb cfg rt ws X i =
  if i >= (gp_rt_seq rt) then 0
  else let d = gc_dmodel cfg in
    let _ = gfx_matvec_off_bf16 (arr_get W (bb + 8)) (arr_get ws 4) (i * d) (arr_get W (bb + 9)) (arr_get ws 8) 0 d d 0 in
    let _ = gp_addinto X (i * d) (arr_get ws 8) d 0 in
    gp_oproj_b W bb cfg rt ws X (i + 1)
gp_ffn_b W bb cfg rt ws X i =
  if i >= (gp_rt_seq rt) then 0
  else let d = gc_dmodel cfg in let dff = gc_dff cfg in
    let lnbuf = arr_get ws 0 in
    let _ = gp_layernorm X (i * d) lnbuf (arr_get W (bb + 10)) (arr_get W (bb + 11)) d (gp_rt_eps rt) in
    let _ = gfx_matvec_bf16 (arr_get W (bb + 12)) lnbuf (arr_get W (bb + 13)) (arr_get ws 7) d dff 0 in
    let _ = gp_gelu_vec (arr_get ws 7) (arr_get ws 7) dff 0 in
    let _ = gfx_matvec_bf16 (arr_get W (bb + 14)) (arr_get ws 7) (arr_get W (bb + 15)) (arr_get ws 9) dff d 0 in
    let _ = gp_addinto X (i * d) (arr_get ws 9) d 0 in
    gp_ffn_b W bb cfg rt ws X (i + 1)
gp_block_b W bb cfg rt ws X =
  let _ = gp_qkv_b W bb cfg rt ws X 0 in
  let d = gc_dmodel cfg in
  let _ = gp_attn_core (arr_get ws 1) (arr_get ws 2) (arr_get ws 3) (arr_get ws 5) (arr_get ws 6) (arr_get ws 4) (gc_nhead cfg) d (gc_headdim cfg) (gp_rt_seq rt) (gp_rt_scale rt) 0 in
  let _ = gp_oproj_b W bb cfg rt ws X 0 in
  gp_ffn_b W bb cfg rt ws X 0
gp_layers_b W cfg rt ws X l =
  if l >= (gc_nlayer cfg) then X
  else let _ = gp_block_b W (2 + l * 16) cfg rt ws X in gp_layers_b W cfg rt ws X (l + 1)
gp_final_b W cfg rt ws X logits i =
  if i >= (gp_rt_seq rt) then logits
  else let d = gc_dmodel cfg in let vocab = gc_vocab cfg in
    let hbase = 2 + (gc_nlayer cfg) * 16 in
    let lnbuf = arr_get ws 0 in
    let _ = gp_layernorm X (i * d) lnbuf (arr_get W (hbase + 0)) (arr_get W (hbase + 1)) d (gp_rt_eps rt) in
    let _ = gfx_matvec_off_bf16 (arr_get W (hbase + 2)) lnbuf 0 (arr_get ws 10) logits (i * vocab) d vocab 0 in
    gp_final_b W cfg rt ws X logits (i + 1)
gp_forward_bf16 W cfg rt ws X ids logits =
  let _ = gp_embed_b W cfg X ids (gp_rt_seq rt) 0 in
  let _ = gp_layers_b W cfg rt ws X 0 in
  gp_final_b W cfg rt ws X logits 0

pq_pow2_go acc k = if k != 0 then pq_pow2_go (acc + acc) (k - 1) else acc
pq_pow2 k = if k >= 1 then pq_pow2_go 1 k else 1
pq_f32_fixed b0 b1 b2 b3 = let bits = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216 in let sign = bits / 2147483648 in let rest = bits - sign * 2147483648 in let exp = rest / 8388608 in let mant = rest - exp * 8388608 in if exp == 0 then 0 else let mag = 8388608 + mant in let sh = exp - 126 in let xabs = if sh >= 0 then mag * (pq_pow2 sh) else (let dd = pq_pow2 (0 - sh) in (mag + dd / 2) / dd) in if sign == 1 then 0 - xabs else xabs
pq_match buf pos pcs = if pcs == [] then 1 else if byte_at buf pos == char_to_int (head pcs) then pq_match buf (pos + 1) (tail pcs) else 0
pq_find buf pos hi pcs = if pos >= hi then 0 - 1 else if pq_match buf pos pcs == 1 then pos else pq_find buf (pos + 1) hi pcs
pq_find_after buf pos hi pcs = let p = pq_find buf pos hi pcs in if p < 0 then 0 - 1 else p + length pcs
pq_int buf pos acc = let c = byte_at buf pos in if c < 48 then acc else if c > 57 then acc else pq_int buf (pos + 1) (acc * 10 + (c - 48))
pq_le_len buf off = byte_at buf off + byte_at buf (off + 1) * 256 + byte_at buf (off + 2) * 65536 + byte_at buf (off + 3) * 16777216 + byte_at buf (off + 4) * 4294967296 + byte_at buf (off + 5) * 1099511627776
pq_offset hdr hi name = let np = pq_find hdr 0 hi (chars (cat ["\"", name, "\":"])) in let dp = pq_find_after hdr np hi (chars "\"data_offsets\":[") in pq_int hdr dp 0
gp_dec_f32 cbuf out obase count i = if i >= count then 0 else let ba = 4 * i in let _ = arr_set out (obase + i) (pq_f32_fixed (byte_at cbuf ba) (byte_at cbuf (ba + 1)) (byte_at cbuf (ba + 2)) (byte_at cbuf (ba + 3))) in gp_dec_f32 cbuf out obase count (i + 1)
ld_f32 fd hdrbuf base name count = let start = pq_offset hdrbuf base name in let cbuf = malloc (count * 4) in let nr = pread fd cbuf (count * 4) (base + start) in let out = arr_new count 0 in let _ = gp_dec_f32 cbuf out 0 count 0 in let _ = free cbuf in out
bname li suffix = cat ["blocks.", show li, ".", suffix]
bfw_enc s n = gfx_bf16_encode_arr s (arr_new n 0) n 0
gp_load_layers W fd hdr base li nlayers d qdim inter =
  if li >= nlayers then 0
  else let bb = 2 + li * 16 in
    let _ = arr_set W (bb + 0) (ld_f32 fd hdr base (bname li "ln1.weight") d) in
    let _ = arr_set W (bb + 1) (ld_f32 fd hdr base (bname li "ln1.bias") d) in
    let _ = arr_set W (bb + 2) (bfw_enc (ld_f32 fd hdr base (bname li "attn.query_proj.weight") (qdim * d)) (qdim * d)) in
    let _ = arr_set W (bb + 3) (arr_new d 0) in
    let _ = arr_set W (bb + 4) (bfw_enc (ld_f32 fd hdr base (bname li "attn.key_proj.weight") (qdim * d)) (qdim * d)) in
    let _ = arr_set W (bb + 5) (arr_new d 0) in
    let _ = arr_set W (bb + 6) (bfw_enc (ld_f32 fd hdr base (bname li "attn.value_proj.weight") (qdim * d)) (qdim * d)) in
    let _ = arr_set W (bb + 7) (arr_new d 0) in
    let _ = arr_set W (bb + 8) (bfw_enc (ld_f32 fd hdr base (bname li "attn.out_proj.weight") (d * qdim)) (d * qdim)) in
    let _ = arr_set W (bb + 9) (arr_new d 0) in
    let _ = arr_set W (bb + 10) (ld_f32 fd hdr base (bname li "ln2.weight") d) in
    let _ = arr_set W (bb + 11) (ld_f32 fd hdr base (bname li "ln2.bias") d) in
    let _ = arr_set W (bb + 12) (bfw_enc (ld_f32 fd hdr base (bname li "mlp.layers.0.weight") (inter * d)) (inter * d)) in
    let _ = arr_set W (bb + 13) (ld_f32 fd hdr base (bname li "mlp.layers.0.bias") inter) in
    let _ = arr_set W (bb + 14) (bfw_enc (ld_f32 fd hdr base (bname li "mlp.layers.2.weight") (d * inter)) (d * inter)) in
    let _ = arr_set W (bb + 15) (ld_f32 fd hdr base (bname li "mlp.layers.2.bias") d) in
    gp_load_layers W fd hdr base (li + 1) nlayers d qdim inter
mk_ws d inter vocab seqL =
  let ws = arr_new 11 0 in
  let _ = arr_set ws 0 (arr_new d 0) in let _ = arr_set ws 1 (arr_new (seqL * d) 0) in
  let _ = arr_set ws 2 (arr_new (seqL * d) 0) in let _ = arr_set ws 3 (arr_new (seqL * d) 0) in
  let _ = arr_set ws 4 (arr_new (seqL * d) 0) in let _ = arr_set ws 5 (arr_new seqL 0) in
  let _ = arr_set ws 6 (arr_new seqL 0) in let _ = arr_set ws 7 (arr_new inter 0) in
  let _ = arr_set ws 8 (arr_new d 0) in let _ = arr_set ws 9 (arr_new d 0) in let _ = arr_set ws 10 (arr_new vocab 0) in ws
argmax_go lg base n i best bi = if i >= n then bi else let v = arr_get lg (base + i) in if v > best then argmax_go lg base n (i + 1) v i else argmax_go lg base n (i + 1) best bi
main =
  let d = 768 in let inter = 3072 in let L = 9 in let vocab = 16384 in let nlayers = 16 in let qdim = 768 in
  let cfg = [16, 768, 12, 64, 3072, 512, 16384, 24, 1, 0, 0] in
  let blob = cat [getenv "HOME", "/.ledatic/railml-trial/canonical_bestpass.safetensors"] in
  if (read_file_size blob) < 10000000 then let _ = print "FATAL: blob missing" in 1
  else
  let fd = fopen blob "rb" in
  let hb8 = malloc 8 in let _ = pread fd hb8 8 0 in let hlen = pq_le_len hb8 0 in let _ = free hb8 in
  let base = 8 + hlen in let hdr = malloc base in let _ = pread fd hdr base 0 in
  let _ = print "loading + bf16-encoding weight matrices ..." in
  let hbase = 2 + nlayers * 16 in
  let W = arr_new (hbase + 3) 0 in
  let _ = arr_set W 0 (bfw_enc (ld_f32 fd hdr base "tok.weight" (vocab * d)) (vocab * d)) in
  let _ = arr_set W 1 (bfw_enc (ld_f32 fd hdr base "pos.weight" (L * d)) (L * d)) in
  let _ = gp_load_layers W fd hdr base 0 nlayers d qdim inter in
  let _ = arr_set W hbase (ld_f32 fd hdr base "lnf.weight" d) in
  let _ = arr_set W (hbase + 1) (ld_f32 fd hdr base "lnf.bias" d) in
  let _ = arr_set W (hbase + 2) (bfw_enc (ld_f32 fd hdr base "head.weight" (vocab * d)) (vocab * d)) in
  let _ = print "running bf16-weight forward ..." in
  let ids = arr_new L 0 in
  let _ = arr_set ids 0 328 in let _ = arr_set ids 1 2432 in let _ = arr_set ids 2 554 in let _ = arr_set ids 3 183 in
  let _ = arr_set ids 4 12154 in let _ = arr_set ids 5 533 in let _ = arr_set ids 6 197 in let _ = arr_set ids 7 27 in let _ = arr_set ids 8 661 in
  let rt = arr_new 3 0 in let _ = arr_set rt 0 L in let _ = arr_set rt 1 2097152 in let _ = arr_set rt 2 168 in
  let ws = mk_ws d inter vocab L in
  let X = arr_new (L * d) 0 in let logits = arr_new (L * vocab) 0 in
  let _ = gp_forward_bf16 W cfg rt ws X ids logits in
  let bl = (L - 1) * vocab in
  let am = argmax_go logits bl vocab 1 (arr_get logits bl) 0 in
  let _ = print (cat ["bf16-weight 138M argmax = ", show am, "  (F=24/MLX gold = 5836)"]) in
  print (if am == 5836 then "gp_138m_bf16: bf16 WEIGHTS PRESERVE PREDICTION -- argmax 5836 (4x smaller weights, attestable)" else cat ["gp_138m_bf16: argmax = ", show am, " (bf16 drift; deterministic/attestable)"])
