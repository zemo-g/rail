-- Rail GPT — bf16 WEIGHT matmul validation at real scale (768x768).
-- (A) bf16-weight matmul == matmul on the decoded weights, BIT-EXACT (on-the-fly
--     decode is deterministic/attestable). (B) close to full-precision F=24 within
--     bf16 precision. (C) weights stored as 16-bit (2 bytes vs 8) -> 4x smaller.

import "stdlib/gpt/gpt_backward.rail"

mkp_go a n seed i = if i >= n then a else let _ = arr_set a i (((((i * 37) + seed) % 13) - 6) * 65536) in mkp_go a n seed (i + 1)
mkp n seed = mkp_go (arr_new n 0) n seed 0
dec_arr src dst n i = if i >= n then dst else let _ = arr_set dst i (gp_bf16_to_f24 (arr_get src i)) in dec_arr src dst n (i + 1)
gt_abs x = if x < 0 then 0 - x else x
cmp a b n i mism = if i >= n then mism else cmp a b n (i + 1) (if (arr_get a i) == (arr_get b i) then mism else mism + 1)
-- |a-b| within ~1% of |a| (bf16 ~0.4%, tolerance generous for accumulated matmul)
close_all a b n i bad = if i >= n then bad else close_all a b n (i + 1) (if ((gt_abs ((arr_get a i) - (arr_get b i))) * 64) <= ((gt_abs (arr_get a i)) + 65536) then bad else bad + 1)

main =
  let rows = 768 in let k = 768 in
  let Wf = mkp (rows * k) 7 in
  let x = mkp k 99 in
  let zb = arr_new rows 0 in
  let yf = arr_new rows 0 in let _ = gfx_matvec Wf x zb yf k rows 0 in
  let Wb = gfx_bf16_encode_arr Wf (arr_new (rows * k) 0) (rows * k) 0 in
  let Wd = dec_arr Wb (arr_new (rows * k) 0) (rows * k) 0 in
  let yd = arr_new rows 0 in let _ = gfx_matvec Wd x zb yd k rows 0 in
  let yb = arr_new rows 0 in let _ = gfx_matvec_bf16 Wb x zb yb k rows 0 in
  let yb2 = arr_new rows 0 in let _ = gfx_matvec_bf16 Wb x zb yb2 k rows 0 in
  let cA = if (cmp yb yd rows 0 0) == 0 then 1 else 0 in
  let cB = if (close_all yb yf rows 0 0) == 0 then 1 else 0 in
  let cC = if (arr_get Wb 0) < 65536 then (if (arr_get Wb (rows * k - 1)) < 65536 then 1 else 0) else 0 in
  let cD = if (cmp yb yb2 rows 0 0) == 0 then 1 else 0 in
  let _ = print (join "" ["(A) bf16-wt matmul == decoded-F24 matmul (bit-exact): mism=", show (cmp yb yd rows 0 0), " -> ", if cA == 1 then "PASS" else "FAIL"]) in
  let _ = print (join "" ["(B) close to full-precision F=24 (within bf16): bad=", show (close_all yb yf rows 0 0), "/", show rows, " -> ", if cB == 1 then "PASS" else "FAIL"]) in
  let _ = print (join "" ["(C) weights 16-bit (2 bytes vs 8): W[0]=", show (arr_get Wb 0), " -> ", if cC == 1 then "PASS" else "FAIL"]) in
  let _ = print (join "" ["(D) deterministic (run-twice identical): ", if cD == 1 then "PASS" else "FAIL"]) in
  let allok = cA * cB * cC * cD in
  print (if allok == 1 then "gp_bf16w_test: bf16 WEIGHT matmul OK (bit-exact to decoded, precise, 2-byte, deterministic)" else "gp_bf16w_test: FAILED")
