-- x402_verify.rail — BUYER: verify the x402-delivered data is the genuine attested
-- artifact. Reads body/hash/sig from files, checks sha256 + Ed25519 against the
-- PINNED gateway pubkey. Prints VALID / INVALID.
import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"
gw_seed = sha256 "ledatic.x402.gateway.dev.key.v1"
main =
  let body = read_file "/tmp/x402_body.txt" in
  let claimed = read_file "/tmp/x402_hash.txt" in
  let sighex = read_file "/tmp/x402_sig.txt" in
  let computed = bytes_to_hex (sha256 body) 32 in
  let pk = ed25519_pk_from_sk gw_seed in
  let sigok = ed25519_verify pk (sha256 body) 32 (hex_to_bytes sighex) in
  if computed == claimed then (if sigok then print "VALID -- sha256 matches AND Ed25519 attestation verifies (genuine attested data)" else print "INVALID -- hash ok but signature FAILS") else print "INVALID -- sha256 mismatch (data tampered)"
