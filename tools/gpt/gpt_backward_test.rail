-- Rail GPT — Phase 3b: backward op twins, exact known-value checks (no numerical noise).
import "stdlib/gpt/gpt_backward.rail"

gt_set4 a v0 v1 v2 v3 = let _ = arr_set a 0 v0 in let _ = arr_set a 1 v1 in let _ = arr_set a 2 v2 in let _ = arr_set a 3 v3 in a

main =
  let ONE = 16777216 in
  -- (1) dx = W^T . dy.  W=[[1,2],[3,4]] [out2,in2], dy=[10,20]
  --     dx[0]=1*10+3*20=70 ; dx[1]=2*10+4*20=100
  let W = gt_set4 (arr_new 4 0) ONE (2 * ONE) (3 * ONE) (4 * ONE) in
  let dy = arr_new 2 0 in let _ = arr_set dy 0 (10 * ONE) in let _ = arr_set dy 1 (20 * ONE) in
  let dx = arr_new 2 0 in let _ = gp_mbwd_dx W dy dx 2 2 0 in
  let c1 = if (arr_get dx 0) == (70 * ONE) then (if (arr_get dx 1) == (100 * ONE) then 1 else 0) else 0 in
  let _ = print (join "" ["(1) dx=W^T.dy = [", show (arr_get dx 0), ",", show (arr_get dx 1), "] (want [70,100]*S) -> ", if c1 == 1 then "PASS" else "FAIL"]) in

  -- (2) dW = dy (x) x.  dy=[10,20], x=[3,5] -> dW=[[30,50],[60,100]]
  let x = arr_new 2 0 in let _ = arr_set x 0 (3 * ONE) in let _ = arr_set x 1 (5 * ONE) in
  let dW = arr_new 4 0 in let _ = gp_wgrad dy x dW 2 2 0 0 in
  let c2 = if (arr_get dW 0) == (30 * ONE) then (if (arr_get dW 1) == (50 * ONE) then (if (arr_get dW 2) == (60 * ONE) then (if (arr_get dW 3) == (100 * ONE) then 1 else 0) else 0) else 0) else 0 in
  let _ = print (join "" ["(2) dW=dy(x)x = [", show (arr_get dW 0), ",", show (arr_get dW 1), ",", show (arr_get dW 2), ",", show (arr_get dW 3), "] (want [30,50,60,100]*S) -> ", if c2 == 1 then "PASS" else "FAIL"]) in

  -- (3) GELU backward at x=0: gelu'(0)=0.5, dy=2.0 -> dx=1.0
  let dyg = arr_new 1 0 in let _ = arr_set dyg 0 (2 * ONE) in
  let xg = arr_new 1 0 in let _ = arr_set xg 0 0 in
  let dxg = arr_new 1 0 in let _ = gp_gelu_bwd dyg xg dxg 1 0 in
  let c3 = if (arr_get dxg 0) == ONE then 1 else 0 in
  let _ = print (join "" ["(3) gelu_bwd(dy=2,x=0)=dy*gelu'(0)=2*0.5 = ", show (arr_get dxg 0), " (want 1.0*S) -> ", if c3 == 1 then "PASS" else "FAIL"]) in

  -- (4) wgrad_acc adds (run twice -> doubles)
  let dW2 = arr_new 4 0 in let _ = gp_wgrad_acc dy x dW2 2 2 0 0 in let _ = gp_wgrad_acc dy x dW2 2 2 0 0 in
  let c4 = if (arr_get dW2 0) == (60 * ONE) then 1 else 0 in
  let _ = print (join "" ["(4) wgrad_acc x2 = ", show (arr_get dW2 0), " (want 60*S) -> ", if c4 == 1 then "PASS" else "FAIL"]) in

  -- (5) attention backward, seqL=1 identity: single token attends to itself (softmax=1)
  --     -> dV=dO exactly, dQ=dK=0. nh=1, hd=4, qdim=4.
  let qd = 4 in
  let q = gt_set4 (arr_new qd 0) ONE (2 * ONE) 0 0 in
  let k = gt_set4 (arr_new qd 0) ONE 0 0 0 in
  let vv = gt_set4 (arr_new qd 0) (5 * ONE) (6 * ONE) 0 0 in
  let dO = gt_set4 (arr_new qd 0) ONE (2 * ONE) (3 * ONE) (4 * ONE) in
  let sc = arr_new 1 0 in let ex = arr_new 1 0 in let pp = arr_new 1 0 in let dp = arr_new 1 0 in let draw = arr_new 1 0 in
  let dQ = arr_new qd 0 in let dK = arr_new qd 0 in let dV = arr_new qd 0 in
  let _ = gp_attn_bwd q k vv dO sc ex pp dp draw dQ dK dV 1 qd 4 1 8388608 in
  let dvok = if (arr_get dV 0) == ONE then (if (arr_get dV 1) == (2 * ONE) then (if (arr_get dV 3) == (4 * ONE) then 1 else 0) else 0) else 0 in
  let dqz = if (arr_get dQ 0) == 0 then (if (arr_get dK 1) == 0 then 1 else 0) else 0 in
  let c5 = if dvok == 1 then dqz else 0 in
  let _ = print (join "" ["(5) attn_bwd seqL=1: dV[0..1]=[", show (arr_get dV 0), ",", show (arr_get dV 1), "] (want dO) dQ=dK=0 -> ", if c5 == 1 then "PASS" else "FAIL"]) in

  let allok = c1 * c2 * c3 * c4 * c5 in
  print (if allok == 1 then "gpt_backward_test: Phase 3b backward ops OK (mbwd/wgrad/gelu/attn_bwd, exact)" else "gpt_backward_test: FAILED")
