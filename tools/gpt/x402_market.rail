-- x402_market.rail — "Amazon for agents": a machine-readable catalog of ATTESTED
-- products, each x402-gated. Agent flow: GET /catalog -> pick -> pay -> verify.
import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"
crlf = cat [char_from_int 13, char_from_int 10]
payto = "0x0129b9e66C449b4c7027F07A7b8811BBf6fb3301"

-- product catalog (agents crawl this to discover what's for sale)
catalog = cat ["{\"marketplace\":\"ledatic-agent-exchange\",\"version\":1,\"payTo\":\"", payto, "\",\"products\":[",
  "{\"id\":\"lakes\",\"title\":\"Great Lakes port-call intelligence\",\"price\":\"0.01 USDC\",\"endpoint\":\"/data/lakes\",\"attested\":true,\"alg\":\"ed25519\"},",
  "{\"id\":\"rf\",\"title\":\"Off-air RF/AIS decode feed\",\"price\":\"0.02 USDC\",\"endpoint\":\"/data/rf\",\"attested\":true,\"alg\":\"ed25519\"},",
  "{\"id\":\"gpt\",\"title\":\"Rail-GPT attested inference (1 completion)\",\"price\":\"0.05 USDC\",\"endpoint\":\"/data/gpt\",\"attested\":true,\"alg\":\"ed25519\"}]}"]

prod_resource id =
  if id == "lakes" then "{\"product\":\"lakes\",\"pulse\":2641877,\"records\":[{\"mmsi\":\"316001234\",\"port\":\"Thunder Bay\",\"eta\":\"2026-07-08T04:00Z\",\"status\":\"verified\"}]}"
  else if id == "rf" then "{\"product\":\"rf\",\"pulse\":2641877,\"decodes\":[{\"band\":\"161.975MHz\",\"type\":\"AIS-B\",\"crc\":\"pass\"}]}"
  else if id == "gpt" then "{\"product\":\"gpt\",\"prompt\":\"sum of 90 and 5\",\"completion\":\"main = let _ = print (show (90 + 5))\",\"oracle\":\"rail_native exit 0 -> 95\"}"
  else ""
prod_price id = if id == "rf" then "20000" else if id == "gpt" then "50000" else "10000"

build_resp status stext ct extra body = cat ["HTTP/1.1 ", show status, " ", stext, crlf, "Content-Type: ", ct, crlf, "Content-Length: ", show (length (chars body)), crlf, extra, "Connection: close", crlf, crlf, body]
req_path req = let lines = str_split (cat [char_from_int 10]) req in if length lines == 0 then "/" else let parts = str_split " " (head lines) in if length parts < 2 then "/" else head (tail parts)
hval req key = let i = str_find key req in if i < 0 then "" else let rest = str_sub req (i + (length (chars key))) 400 in let nl = str_find (char_from_int 13) rest in if nl < 0 then rest else str_sub rest 0 nl
-- payment terms bind the EXACT product path + its price
pay_msg path amount nonce = cat ["x402|exact|base|", amount, "|", payto, "|", path, "|", nonce]
verify_payment req path amount =
  let xp = hval req "X-PAYMENT: " in
  if (length (chars xp)) < 20 then 0
  else let parts = str_split "." xp in
       if (length parts) < 3 then 0
       else if ed25519_verify (hex_to_bytes (head parts)) (sha256 (pay_msg path amount (head (tail parts)))) 32 (hex_to_bytes (head (tail (tail parts)))) then 1 else 0
attest_headers res =
  let h = sha256 res in let sig = ed25519_sign (sha256 "ledatic.x402.gateway.dev.key.v1") h 32 in
  cat ["X-Content-SHA256: ", bytes_to_hex h 32, crlf, "X-Attestation-Alg: ed25519", crlf, "X-Attestation-Sig: ", bytes_to_hex sig 64, crlf]
offer path amount = cat ["{\"x402Version\":1,\"accepts\":[{\"scheme\":\"exact\",\"network\":\"base\",\"maxAmountRequired\":\"", amount, "\",\"asset\":\"USDC\",\"payTo\":\"", payto, "\",\"resource\":\"", path, "\",\"description\":\"Ledatic attested product -- Ed25519-signed, buyer-verifiable\"}]}"]

main =
  let req = read_file "/tmp/rail_http_req.txt" in
  let path = req_path req in
  if path == "/catalog" then print (build_resp 200 "OK" "application/json" "" catalog)
  else if str_contains "/data/" path then
    (let id = str_sub path 6 20 in
     let res = prod_resource id in
     if (length (chars res)) == 0 then print (build_resp 404 "Not Found" "text/plain" "" "unknown product")
     else if (verify_payment req path (prod_price id)) == 1 then print (build_resp 200 "OK" "application/json" (attest_headers res) res)
     else print (build_resp 402 "Payment Required" "application/json" "" (offer path (prod_price id))))
  else print (build_resp 200 "OK" "application/json" "" "{\"see\":\"/catalog\"}")
