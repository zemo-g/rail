-- Rail GPT — GPU wiring: prove the GPU fx_matmul24_wx kernel == CPU gfx_matvec
-- bit-for-bit on a real-size projection (rows=768, k=768, L=9). If identical, the
-- GPU kernel is a drop-in for the CPU twin -- same result, same attestation chain,
-- ~100x faster. Compile to binary, run (Metal). Needs libtensor_gpu dylib.

import "stdlib/gpt/gpt_backward.rail"
import "stdlib/gpt/gp_gpu.rail"

mkp_go a n seed i = if i >= n then a else let _ = arr_set a i (((((i * 37) + seed) % 13) - 6) * 65536) in mkp_go a n seed (i + 1)
mkp n seed = mkp_go (arr_new n 0) n seed 0

cpu_mm W X zbias Ycpu rows k L t =
  if t >= L then 0
  else let _ = gfx_matvec_off W X (t * k) zbias Ycpu (t * rows) k rows 0 in cpu_mm W X zbias Ycpu rows k L (t + 1)

cmp a b n i mism = if i >= n then mism else cmp a b n (i + 1) (if (arr_get a i) == (arr_get b i) then mism else mism + 1)

main =
  let rows = 768 in let k = 768 in let L = 9 in
  let W = mkp (rows * k) 7 in
  let X = mkp (L * k) 99 in
  let zbias = arr_new rows 0 in
  -- CPU (my verified twin, per token)
  let Ycpu = arr_new (L * rows) 0 in
  let _ = cpu_mm W X zbias Ycpu rows k L 0 in
  let _ = print (join "" ["CPU done. Ycpu[0]=", show (arr_get Ycpu 0), " Ycpu[last]=", show (arr_get Ycpu (L * rows - 1))]) in
  -- GPU (unified gp_gpu backend: kernel compiled once, weight resident)
  let kid = gp_gpu_mm_kernel rows k L in
  let wid = gp_gpu_weight W rows k in
  let Ygpu = arr_new (L * rows) 0 in
  let _ = gp_gpu_mm kid wid X Ygpu rows k L in
  let _ = print (join "" ["GPU done. Ygpu[0]=", show (arr_get Ygpu 0), " Ygpu[last]=", show (arr_get Ygpu (L * rows - 1))]) in
  let mism = cmp Ycpu Ygpu (L * rows) 0 0 in
  let _ = print (join "" ["mismatches over ", show (L * rows), " elements = ", show mism]) in
  print (if mism == 0 then "gpt_gpu_matmul_test: GPU fx_matmul == CPU gfx_matvec BIT-EXACT (drop-in, attestation-safe)" else "gpt_gpu_matmul_test: MISMATCH")
