-- tools/dnra/impl/arbiter.rail — DNRA v0 deterministic arbiter.
--
-- v0 classification rule (per spec/ARBITER.spec.md):
--   non_empty_outputs := [o for o in extract_outputs(line) if o != ""]
--   distinct_outputs  := unique(non_empty_outputs)
--   if   len(non_empty_outputs) < 2: "noise"
--   elif len(distinct_outputs)  >= 2: "productive"
--   else: "noise"
--
-- Curator convention enforced by sets/synthetic_disagreements.jsonl:
--   empty rail_claim  iff  empty rail_claim_output.
--   No escaped quotes inside output values (simplifies extraction).
--
-- Run: ./rail_native run tools/dnra/impl/arbiter.rail
--   Reads: tools/dnra/sets/synthetic_disagreements.jsonl
--   Prints: per-example predicted vs ground_truth, then summary.

import "stdlib/file.rail"

-- ─── List utilities ──────────────────────────────────────────────

-- Strip empty strings from a list of strings. Named predicate, no lambda
-- (filter with lambda can segfault per rail compiler quirk notes).
filter_nonempty xs =
  if xs == [] then []
  else
    let x = head xs
    if length (chars x) == 0 then filter_nonempty (tail xs)
    else cons x (filter_nonempty (tail xs))

contains_str xs needle =
  if xs == [] then false
  else if head xs == needle then true
  else contains_str (tail xs) needle

unique_strs xs = unique_strs_loop xs []

unique_strs_loop xs acc =
  if xs == [] then reverse acc
  else
    let x = head xs
    if contains_str acc x then unique_strs_loop (tail xs) acc
    else unique_strs_loop (tail xs) (cons x acc)

-- ─── Field extraction (marker-split; no escape awareness in v0) ─

-- Extract the value of `<marker>...<terminator>` for the FIRST occurrence
-- of marker in line. "" if not found. Skips past marker, reads up to next
-- terminator char.
extract_one marker terminator line =
  let i = str_find marker line
  if i < 0 then ""
  else
    let start = i + length (chars marker)
    let rest = str_sub line start (length (chars line) - start)
    let j = str_find terminator rest
    if j < 0 then ""
    else str_sub rest 0 j

-- Extract ALL values matching `<marker>...<terminator>` across the line.
-- Walks left-to-right, accumulating each value before advancing past it.
extract_all marker terminator line =
  extract_all_loop marker terminator line []

extract_all_loop marker terminator line acc =
  let i = str_find marker line
  if i < 0 then reverse acc
  else
    let start = i + length (chars marker)
    let rest = str_sub line start (length (chars line) - start)
    let j = str_find terminator rest
    if j < 0 then reverse acc
    else
      let val = str_sub rest 0 j
      let consumed = j + length (chars terminator)
      let continuation = str_sub rest consumed (length (chars rest) - consumed)
      extract_all_loop marker terminator continuation (cons val acc)

-- ─── Classification ──────────────────────────────────────────────

extract_outputs line =
  extract_all "\"rail_claim_output\":\"" "\"" line

extract_ground_truth line =
  extract_one "\"ground_truth\":\"" "\"" line

extract_id line =
  extract_one "\"id\":\"" "\"" line

classify line =
  let outs = extract_outputs line
  let non_empty = filter_nonempty outs
  let distinct = unique_strs non_empty
  if length non_empty < 2 then "noise"
  else if length distinct >= 2 then "productive"
  else "noise"

-- ─── Scoring loop ────────────────────────────────────────────────

score_lines lines correct total =
  if lines == [] then (correct, total)
  else
    let line = head lines
    let id = extract_id line
    let pred = classify line
    let gt = extract_ground_truth line
    let mark = if pred == gt then "✓" else "✗"
    let _ = print (cat ["  ", mark, " ", id, "  predicted=", pred, "  ground_truth=", gt])
    let inc = if pred == gt then 1 else 0
    score_lines (tail lines) (correct + inc) (total + 1)

-- ─── Main ────────────────────────────────────────────────────────

set_path _ = "tools/dnra/sets/synthetic_disagreements.jsonl"

main =
  let content = read_file (set_path 0)
  let lines_raw = str_split "\n" content
  let lines = filter_nonempty lines_raw
  let n = length lines
  let _ = print (cat ["arbiter v0 — running on ", show n, " examples"])
  let _ = print ""
  let result = score_lines lines 0 0
  let (correct, total) = result
  let _ = print ""
  let _ = print (cat ["==== ", show correct, "/", show total, " correct ===="])
  let acc_pct = (correct * 100) / total
  let _ = print (cat ["accuracy: ", show acc_pct, "%"])
  if correct >= 16 then
    let _ = print "PASS (>= 16/20 gate)"
    0
  else
    let _ = print "FAIL (< 16/20 gate)"
    1
