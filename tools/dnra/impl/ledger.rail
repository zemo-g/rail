-- tools/dnra/impl/ledger.rail — DNRA append-only hash-chained JSONL ledger.
--
-- v0.2 scope:
--   - All of v0.1 (types, canonical JSON envelope, sha256 chaining, JSONL append).
--   - Ed25519 signing per entry. Signer fingerprint included in pre-hash material.
--   - ledger_verify_head re-derives pubkey from key_path and verifies sig.
--   - Auto-generates 32-byte seed at ~/.ledatic/dnra/signing_key if missing.
--
-- Deferred:
--   - v0.3: full ledger_verify_chain walking every entry.
--   - v0.4: mkdir LOCK.d advisory locking + atomic append.
--
-- Envelope on disk (alphabetical key sort):
--   { "body":<canonical-json>, "id":"<sha256-hex>", "parents":[...],
--     "sig":"<128-hex>", "signer":"<16-hex>" }
--
-- Hash convention (v0.2): id = sha256_hex over the canonical pre-hash material
--   {"body":<canonical>,"parents":<json>,"signer":"<fingerprint>"}
-- Signature: ed25519_sign(seed, id_utf8, 64) — sig is over the 64-char id string.
-- Signer:    16 hex chars = first 8 bytes of sha256(pubkey_32). Pubkey derived
--            from the seed on the fly; we keep only the seed on disk.

import "stdlib/hmac.rail"
import "stdlib/sha512.rail"
import "stdlib/file.rail"
import "stdlib/env.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"

-- ─── SHA-256 over an arbitrary string (in-memory) ────────────────
-- v0.2 switches to string_to_bytes + sha256_bytes (no temp file).

sha256_hex_of_string s =
  let bytes = string_to_bytes s
  let n = arr_len bytes
  let h = sha256_bytes bytes n
  bytes_to_hex h 32

-- ─── String helpers ──────────────────────────────────────────────

trim_trailing s =
  join "" (reverse (drop_ws (reverse (chars s))))

drop_ws cs =
  if cs == [] then cs
  else
    let c = head cs
    if c == "\n" then drop_ws (tail cs)
    else if c == "\r" then drop_ws (tail cs)
    else if c == " " then drop_ws (tail cs)
    else if c == "\t" then drop_ws (tail cs)
    else cs

-- Extract a 64-hex `id` value from a JSONL envelope line. "" on not found.
extract_id_from_line line =
  let idx = str_find "\"id\":\"" line
  if idx < 0 then ""
  else str_sub line (idx + 6) 64

-- Extract a 128-hex `sig` value. "" on not found.
extract_sig_from_line line =
  let idx = str_find "\"sig\":\"" line
  if idx < 0 then ""
  else str_sub line (idx + 7) 128

-- Extract a 16-hex `signer` value. "" on not found.
extract_signer_from_line line =
  let idx = str_find "\"signer\":\"" line
  if idx < 0 then ""
  else str_sub line (idx + 10) 16

-- Extract substring between (after `marker_a`) and (before `marker_b`).
slice_after s marker_a marker_b =
  let i = str_find marker_a s
  if i < 0 then ""
  else
    let start = i + length (chars marker_a)
    let rest = str_sub s start (length (chars s) - start)
    let j = str_find marker_b rest
    if j < 0 then rest
    else str_sub rest 0 j

-- ─── Key management ──────────────────────────────────────────────

-- Auto-generate a 32-byte seed if the key file doesn't exist.
-- Returns 0 always. Idempotent — does nothing if file already exists.
ensure_signing_key path =
  let probe = trim_trailing (shell (cat ["test -f '", path, "' && echo Y || echo N"]))
  if probe == "Y" then 0
  else
    let _ = shell (cat ["mkdir -p \"$(dirname '", path, "')\""])
    let _ = shell (cat ["head -c 32 /dev/urandom > '", path, "' && chmod 600 '", path, "'"])
    0

-- Read the 32-byte seed from disk. Caller must ensure_signing_key first.
load_signing_seed path =
  read_file_bytes path

-- Derive the signer fingerprint from a pubkey:
--   first 8 bytes (16 hex chars) of sha256(pubkey_32).
signer_fingerprint pubkey =
  let digest = sha256_bytes pubkey 32
  let trim = arr_new 8 0
  let _ = sha_copy_bytes digest trim 0 0 8
  bytes_to_hex trim 8

-- ─── Advisory locking (v0.4) ──────────────────────────────────────
-- POSIX `mkdir` is atomic — succeeds only if the dir does not exist.
-- We use `<log_path>.lock.d` as a mutex. Acquisition retries up to
-- `retries_left` times with 50 ms sleeps in between. Release is rmdir.
-- Lock files are advisory only; misbehaving processes can still write
-- to the chain without acquiring the lock.

ledger_lock_dir log_path = cat [log_path, ".lock.d"]

acquire_lock lock_dir retries_left =
  let result = trim_trailing (shell (cat ["mkdir '", lock_dir, "' 2>/dev/null && echo OK || echo BUSY"]))
  if result == "OK" then 1
  else if retries_left <= 0 then 0
  else
    let _ = shell "sleep 0.05"
    acquire_lock lock_dir (retries_left - 1)

release_lock lock_dir =
  let _ = shell (cat ["rmdir '", lock_dir, "' 2>/dev/null"])
  0

-- ─── Chain I/O ────────────────────────────────────────────────────

ledger_init chain_dir log_name =
  let _ = shell (cat ["mkdir -p '", chain_dir, "'"])
  let path = cat [chain_dir, "/", log_name]
  let _ = shell (cat ["touch '", path, "'"])
  path

ledger_head_id log_path =
  let last = trim_trailing (shell (cat ["tail -1 '", log_path, "' 2>/dev/null"]))
  if length (chars last) == 0 then ""
  else extract_id_from_line last

parents_json_of head =
  if length (chars head) == 0 then "[]"
  else cat ["[\"", head, "\"]"]

-- Pre-hash material — alphabetical key order so canonicalization is stable.
prehash_material parents_json canonical_body signer_fp =
  cat ["{\"body\":", canonical_body,
       ",\"parents\":", parents_json,
       ",\"signer\":\"", signer_fp, "\"}"]

-- On-disk envelope line (alphabetical key order).
envelope_line id parents_json canonical_body sig_hex signer_fp =
  cat [
    "{\"body\":", canonical_body,
    ",\"id\":\"", id, "\"",
    ",\"parents\":", parents_json,
    ",\"sig\":\"", sig_hex, "\"",
    ",\"signer\":\"", signer_fp, "\"",
    "}"
  ]

-- Append a new entry to the chain. Computes id over (body, parents, signer),
-- signs the id with the Ed25519 seed at key_path, writes the envelope.
-- Returns the 64-hex id on success, or "" if the advisory lock could not
-- be acquired within ~1s (20 × 50ms retries).
--
-- v0.4 holds <log_path>.lock.d for the entire compute+write critical section
-- so concurrent writers observe a consistent head and don't interleave their
-- envelope lines. The single envelope write (`cat tmp >> log`) is small
-- enough to be atomic at the OS level on macOS/Linux (<PIPE_BUF, <4096B).
ledger_append log_path key_path canonical_body =
  let lock = ledger_lock_dir log_path
  let got = acquire_lock lock 20
  if got == 0 then ""
  else
    let _ = ensure_signing_key key_path
    let seed = load_signing_seed key_path
    let pubkey = ed25519_pk_from_sk seed
    let fp = signer_fingerprint pubkey
    let head = ledger_head_id log_path
    let pj = parents_json_of head
    let mat = prehash_material pj canonical_body fp
    let id = sha256_hex_of_string mat
    let id_bytes = string_to_bytes id
    let sig = ed25519_sign seed id_bytes 64
    let sig_hex = bytes_to_hex sig 64
    let line = envelope_line id pj canonical_body sig_hex fp
    let tmp = "/tmp/dnra_append_line"
    let _ = write_file tmp (cat [line, "\n"])
    let _ = shell (cat ["cat '", tmp, "' >> '", log_path, "'"])
    let _ = release_lock lock
    id

-- ─── Verify ───────────────────────────────────────────────────────

-- Small inline parse_int (no socket.rail import needed).
parse_int_acc cs acc =
  if cs == [] then acc
  else
    let c = head cs
    let d = char_to_int c - 48
    if d < 0 then acc
    else if d > 9 then acc
    else parse_int_acc (tail cs) (acc * 10 + d)

parse_int_local s = parse_int_acc (chars s) 0

-- Verify the head entry: re-hash material, check id, verify sig against
-- the pubkey derived from key_path. Returns 1 on PASS, 0 on FAIL.
ledger_verify_head log_path key_path =
  let last = trim_trailing (shell (cat ["tail -1 '", log_path, "' 2>/dev/null"]))
  if length (chars last) == 0 then 1
  else verify_one_line last key_path

-- v0.3: full chain walk. Verifies every entry's body hash, signature,
-- and parent linkage. Returns 1 if every entry passes, 0 on first failure.
ledger_verify_chain log_path key_path =
  -- `wc -l` pads its count with leading spaces on macOS — parse_int_local
  -- stops at the space and returns 0. awk 'END{print NR}' prints just NR.
  let n_str = trim_trailing (shell (cat ["awk 'END{print NR}' '", log_path, "' 2>/dev/null"]))
  let n = parse_int_local n_str
  if n == 0 then 1
  else verify_chain_loop log_path key_path 1 n ""

verify_chain_loop log_path key_path i n prior_id =
  if i > n then 1
  else
    let line = trim_trailing (shell (cat ["sed -n '", show i, "p' '", log_path, "'"]))
    let ok = verify_one_with_prior line key_path prior_id
    if ok == 0 then 0
    else
      let cur_id = extract_id_from_line line
      verify_chain_loop log_path key_path (i + 1) n cur_id

verify_one_with_prior line key_path prior_id =
  let pj_v = slice_after line "\"parents\":" ",\"sig\":"
  let expected_pj = parents_json_of prior_id
  if pj_v != expected_pj then 0
  else verify_one_line line key_path

verify_one_line line key_path =
  let stored_id = extract_id_from_line line
  let stored_sig = extract_sig_from_line line
  let stored_fp = extract_signer_from_line line
  if length (chars stored_id) != 64 then 0
  else if length (chars stored_sig) != 128 then 0
  else if length (chars stored_fp) != 16 then 0
  else
    let body_v = slice_after line "\"body\":" ",\"id\":"
    let pj_v   = slice_after line "\"parents\":" ",\"sig\":"
    if length (chars body_v) == 0 then 0
    else if length (chars pj_v) == 0 then 0
    else
      let mat = prehash_material pj_v body_v stored_fp
      let recomputed = sha256_hex_of_string mat
      if recomputed != stored_id then 0
      else verify_sig_of stored_id stored_sig key_path stored_fp

verify_sig_of id sig_hex key_path expected_fp =
  let seed = load_signing_seed key_path
  let pubkey = ed25519_pk_from_sk seed
  let actual_fp = signer_fingerprint pubkey
  if actual_fp != expected_fp then 0
  else
    let id_bytes = string_to_bytes id
    let sig_bytes = hex_to_bytes sig_hex
    ed25519_verify pubkey id_bytes 64 sig_bytes

-- ─── Default chain paths ─────────────────────────────────────────

dnra_chain_dir _ = cat [getenv "HOME", "/.ledatic/dnra/chain"]
delib_log_path _ = cat [dnra_chain_dir 0, "/deliberations.jsonl"]
outcome_log_path _ = cat [dnra_chain_dir 0, "/outcomes.jsonl"]
default_signing_key_path _ = cat [getenv "HOME", "/.ledatic/dnra/signing_key"]

-- (library only — no main. See ledger_demo.rail for the smoke runner.)
