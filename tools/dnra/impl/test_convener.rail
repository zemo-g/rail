-- tools/dnra/impl/test_convener.rail — DNRA v0 Convener acceptance harness.
--
-- Runs the convener routing rule against tools/dnra/sets/synthetic_triage.jsonl,
-- compares each output to the curator-recorded `intended` routing, applies the
-- four gate metrics from spec/CONVENER.v0.spec.md.
--
-- Gate thresholds scale with set size:
--   - path:  >= 85% of total (production spec: 34/40)
--   - panel: >= 80% of total (production spec: 32/40)
--   - invariants: 0 empty panels, 0 unknown reasons, 0 fast+multi-panel cases
--
-- v0.a spike (10 cases): thresholds resolve to 9 path / 8 panel.
-- Convention: exit 0 + last line "PASS" on success.

-- file.rail is pulled in transitively via convener.rail; importing both
-- directly produces duplicate-symbol link errors (per HANDOFF gotcha #1).
import "tools/dnra/impl/convener.rail"

extract_intended_path line =
  let i = str_find "\"intended\":" line
  if i < 0 then ""
  else
    let start = i + length (chars "\"intended\":")
    let rest = str_sub line start (length (chars line) - start)
    extract_one "\"path\":\"" "\"" rest

extract_id line =
  extract_one "\"id\":\"" "\"" line

score_lines lines path_ok panel_ok empty_count bad_reason fast_multi total =
  if lines == [] then (path_ok, panel_ok, empty_count, bad_reason, fast_multi, total)
  else
    let line = head lines
    let id = extract_id line
    let res = triage_for_line line
    let (path, reason, panel) = res
    let intended_path = extract_intended_path line
    let intended_panel = parse_panel_list "\"intended\":" line
    let path_match = if path == intended_path then 1 else 0
    let panel_match = if list_eq_set panel intended_panel then 1 else 0
    let is_empty = if length panel == 0 then 1 else 0
    let is_fast_multi =
      if path == "fast" then
        if length panel == 1 then 0 else 1
      else 0
    let bad = if is_known_reason reason then 0 else 1
    let mp = if path_match == 1 then "ok " else "X  "
    let mp2 = if panel_match == 1 then "ok " else "X  "
    let panel_str = join "," panel
    let intended_str = join "," intended_panel
    let _ = print (cat ["  ", id, "  path[", mp, "] panel[", mp2, "]  got=", path, "/[", panel_str, "]  want=", intended_path, "/[", intended_str, "]  reason=", reason])
    score_lines (tail lines)
      (path_ok + path_match)
      (panel_ok + panel_match)
      (empty_count + is_empty)
      (bad_reason + bad)
      (fast_multi + is_fast_multi)
      (total + 1)

scaled_threshold n pct = (n * pct + 99) / 100

main =
  let content = read_file "tools/dnra/sets/synthetic_triage.jsonl"
  let lines_raw = str_split "\n" content
  let lines = filter_nonempty lines_raw
  let n = length lines
  let _ = print (cat ["convener v0 acceptance — running on ", show n, " examples"])
  let _ = print ""
  let result = score_lines lines 0 0 0 0 0 0
  let (path_ok, panel_ok, empty_count, bad_reason, fast_multi, total) = result
  let _ = print ""
  let pt = scaled_threshold total 85
  let pnt = scaled_threshold total 80
  let _ = print (cat ["==== path: ", show path_ok, "/", show total, " (gate >= ", show pt, ")   panel: ", show panel_ok, "/", show total, " (gate >= ", show pnt, ") ===="])
  let _ = print (cat ["invariants: empty_panels=", show empty_count, "  bad_reason=", show bad_reason, "  fast_with_multi=", show fast_multi])
  let inv_ok =
    if empty_count == 0 then
      if bad_reason == 0 then
        if fast_multi == 0 then true
        else false
      else false
    else false
  if inv_ok then
    if path_ok >= pt then
      if panel_ok >= pnt then
        let _ = print "PASS"
        0
      else
        let _ = print (cat ["FAIL (panel gate ", show panel_ok, "/", show total, " < ", show pnt, ")"])
        1
    else
      let _ = print (cat ["FAIL (path gate ", show path_ok, "/", show total, " < ", show pt, ")"])
      1
  else
    let _ = print "FAIL (invariants)"
    1
