-- tools/dnra/impl/test_ledger.rail — acceptance tests for ledger.rail v0.2
--
-- Tests applicable to v0.2 (5 of 6 from LEDGER.spec.md):
--   #1 Genesis — first append has parents == []
--   #2 Linear chain — N-th append has parents[0] == (N-1)-th id
--   #3 Hash determinism — same (parents, body, signer) inputs produce same id
--   #4 Tamper detection (body) — flipping a byte in stored body makes verify fail
--   #5 Tamper detection (sig) — flipping a byte in stored sig makes verify fail
--
-- Deferred:
--   #6 Crash safety — needs v0.4 atomic append + lock
--   #7 Full chain walk — needs v0.3 ledger_verify_chain
--
-- Convention: exit 0 + last line "PASS" on success (matches rail_test runner).

import "tools/dnra/impl/ledger.rail"

test_chain_dir _ = "/tmp/dnra_test_chain"
test_log _ = cat [test_chain_dir 0, "/deliberations.jsonl"]
test_key _ = "/tmp/dnra_test_signing_key"

-- Clear the test chain dir (and key) before each run.
reset_test_chain _ =
  let _ = shell (cat ["rm -rf '", test_chain_dir 0, "'"])
  let _ = shell (cat ["mkdir -p '", test_chain_dir 0, "'"])
  let _ = shell (cat ["touch '", test_log 0, "'"])
  0

-- Reset only the chain, NOT the signing key. Used by T3 to verify that
-- two appends with the same body produce the same id when the key is stable.
reset_chain_only _ =
  let _ = shell (cat ["rm -rf '", test_chain_dir 0, "'"])
  let _ = shell (cat ["mkdir -p '", test_chain_dir 0, "'"])
  let _ = shell (cat ["touch '", test_log 0, "'"])
  0

-- Fully reset — chain AND key. Used at the start of T1 to ensure clean slate.
hard_reset _ =
  let _ = shell (cat ["rm -rf '", test_chain_dir 0, "'"])
  let _ = shell (cat ["rm -f '", test_key 0, "'"])
  let _ = shell (cat ["mkdir -p '", test_chain_dir 0, "'"])
  let _ = shell (cat ["touch '", test_log 0, "'"])
  0

fail_with label msg =
  let _ = print (cat ["FAIL ", label, ": ", msg])
  0

ok_with label =
  let _ = print (cat ["ok   ", label])
  1

-- ── Test #1 — Genesis ──────────────────────────────────────────

test_1_genesis _ =
  let _ = hard_reset 0
  let _ = ledger_init (test_chain_dir 0) "deliberations.jsonl"
  let body = "{\"k\":\"genesis-body\"}"
  let id = ledger_append (test_log 0) (test_key 0) body
  let line = trim_trailing (shell (cat ["tail -1 '", test_log 0, "' 2>/dev/null"]))
  let has_empty_parents = str_contains "\"parents\":[]" line
  if length (chars id) != 64 then fail_with "T1-genesis" "id not 64 hex"
  else if has_empty_parents == false then fail_with "T1-genesis" "parents not empty"
  else ok_with "T1-genesis"

-- ── Test #2 — Linear chain ────────────────────────────────────

test_2_linear _ =
  let _ = reset_test_chain 0
  let _ = ledger_init (test_chain_dir 0) "deliberations.jsonl"
  let id1 = ledger_append (test_log 0) (test_key 0) "{\"k\":\"a\"}"
  let id2 = ledger_append (test_log 0) (test_key 0) "{\"k\":\"b\"}"
  let id3 = ledger_append (test_log 0) (test_key 0) "{\"k\":\"c\"}"
  let head_after_3 = ledger_head_id (test_log 0)
  let line2 = trim_trailing (shell (cat ["sed -n '2p' '", test_log 0, "'"]))
  let expected_parents = cat ["\"parents\":[\"", id1, "\"]"]
  let line2_links = str_contains expected_parents line2
  if head_after_3 != id3 then fail_with "T2-linear" "head != id3"
  else if line2_links == false then fail_with "T2-linear" "line[2].parents[0] != id1"
  else ok_with "T2-linear"

-- ── Test #3 — Hash determinism ────────────────────────────────
-- Same (body, parents, signer) → same id. We reset only the chain,
-- not the key, so signer fingerprint is stable between appends.

test_3_determinism _ =
  let _ = reset_chain_only 0
  let _ = ledger_init (test_chain_dir 0) "deliberations.jsonl"
  let id_a = ledger_append (test_log 0) (test_key 0) "{\"k\":\"same-body\"}"
  let _ = reset_chain_only 0
  let _ = ledger_init (test_chain_dir 0) "deliberations.jsonl"
  let id_b = ledger_append (test_log 0) (test_key 0) "{\"k\":\"same-body\"}"
  if id_a != id_b then fail_with "T3-determinism" (cat ["ids differ: ", id_a, " vs ", id_b])
  else ok_with "T3-determinism"

-- ── Test #4 — Tamper detection (body) ─────────────────────────

test_4_tamper_body _ =
  let _ = reset_test_chain 0
  let _ = ledger_init (test_chain_dir 0) "deliberations.jsonl"
  let _ = ledger_append (test_log 0) (test_key 0) "{\"k\":\"honest\"}"
  let v_before = ledger_verify_head (test_log 0) (test_key 0)
  let _ = shell (cat ["sed -i '' 's/honest/TAMPER/' '", test_log 0, "'"])
  let v_after = ledger_verify_head (test_log 0) (test_key 0)
  if v_before != 1 then fail_with "T4-tamper-body" "pre-tamper verify did not return 1"
  else if v_after != 0 then fail_with "T4-tamper-body" (cat ["post-tamper verify returned ", show v_after, ", expected 0"])
  else ok_with "T4-tamper-body"

-- ── Test #5 — Tamper detection (sig) ──────────────────────────
-- Flip the first hex digit of the signature. id and body untouched, so
-- the body-hash check still passes; only the Ed25519 verify catches it.

tamper_script_body _ =
  "import re,sys\np=open(sys.argv[1]).read()\nm=re.search(r'\"sig\":\"([0-9a-f])', p)\nif m:\n  ch=m.group(1)\n  flip=format((int(ch,16)+1)%16,'x')\n  p2=p[:m.start(1)]+flip+p[m.start(1)+1:]\n  open(sys.argv[1],'w').write(p2)\n"

test_5_tamper_sig _ =
  let _ = reset_test_chain 0
  let _ = ledger_init (test_chain_dir 0) "deliberations.jsonl"
  let _ = ledger_append (test_log 0) (test_key 0) "{\"k\":\"honest\"}"
  let v_before = ledger_verify_head (test_log 0) (test_key 0)
  let _ = write_file "/tmp/dnra_tamper_sig.py" (tamper_script_body 0)
  let _ = shell (cat ["python3 /tmp/dnra_tamper_sig.py '", test_log 0, "'"])
  let v_after = ledger_verify_head (test_log 0) (test_key 0)
  if v_before != 1 then fail_with "T5-tamper-sig" "pre-tamper verify did not return 1"
  else if v_after != 0 then fail_with "T5-tamper-sig" (cat ["post-tamper verify returned ", show v_after, ", expected 0"])
  else ok_with "T5-tamper-sig"

-- ── Test #6 — Full chain walk (verify_chain) ──────────────────
-- Build a 3-entry chain. ledger_verify_chain returns 1 on clean chain.
-- Tamper entry 2's body. ledger_verify_chain returns 0 (mid-chain break),
-- but ledger_verify_head still returns 1 (head untampered, head body+id consistent).

test_6_verify_chain _ =
  let _ = reset_test_chain 0
  let _ = ledger_init (test_chain_dir 0) "deliberations.jsonl"
  let _id1 = ledger_append (test_log 0) (test_key 0) "{\"k\":\"a\"}"
  let _id2 = ledger_append (test_log 0) (test_key 0) "{\"k\":\"b\"}"
  let _id3 = ledger_append (test_log 0) (test_key 0) "{\"k\":\"c\"}"
  let v_clean = ledger_verify_chain (test_log 0) (test_key 0)
  -- Tamper the middle entry's body: replace "b" with "X" (same length).
  let _ = shell (cat ["sed -i '' 's/\"k\":\"b\"/\"k\":\"X\"/' '", test_log 0, "'"])
  let v_chain_after = ledger_verify_chain (test_log 0) (test_key 0)
  let v_head_after = ledger_verify_head (test_log 0) (test_key 0)
  if v_clean != 1 then fail_with "T6-verify-chain" (cat ["clean chain returned ", show v_clean])
  else if v_chain_after != 0 then fail_with "T6-verify-chain" (cat ["tampered chain returned ", show v_chain_after, ", expected 0"])
  else if v_head_after != 1 then fail_with "T6-verify-chain" (cat ["head verify returned ", show v_head_after, ", expected 1 (head untouched)"])
  else ok_with "T6-verify-chain"

-- ── Test #7 — Advisory lock + release ─────────────────────────
-- Pre-create the lock dir to simulate another writer holding it.
-- ledger_append should retry, time out, and return "" (empty id).
-- Then release the lock and a fresh append should succeed.

test_7_lock _ =
  let _ = reset_test_chain 0
  let _ = ledger_init (test_chain_dir 0) "deliberations.jsonl"
  let lock_dir = ledger_lock_dir (test_log 0)
  let _ = shell (cat ["mkdir -p '", lock_dir, "'"])
  let id_blocked = ledger_append (test_log 0) (test_key 0) "{\"k\":\"blocked\"}"
  let _ = shell (cat ["rmdir '", lock_dir, "' 2>/dev/null"])
  let id_ok = ledger_append (test_log 0) (test_key 0) "{\"k\":\"unblocked\"}"
  if length (chars id_blocked) != 0 then fail_with "T7-lock" (cat ["blocked append returned non-empty id: ", id_blocked])
  else if length (chars id_ok) != 64 then fail_with "T7-lock" (cat ["unblocked append returned bad id (len=", show (length (chars id_ok)), ")"])
  else ok_with "T7-lock"

-- ── Runner ────────────────────────────────────────────────────

main =
  let r1 = test_1_genesis 0
  let r2 = test_2_linear 0
  let r3 = test_3_determinism 0
  let r4 = test_4_tamper_body 0
  let r5 = test_5_tamper_sig 0
  let r6 = test_6_verify_chain 0
  let r7 = test_7_lock 0
  let total = r1 + r2 + r3 + r4 + r5 + r6 + r7
  let _ = print (cat ["", "==== ", show total, "/7 passed ===="])
  if total == 7 then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
