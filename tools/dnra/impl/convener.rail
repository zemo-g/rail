-- tools/dnra/impl/convener.rail - DNRA v0 deterministic Convener (library).
--
-- v0 routing rule per spec/CONVENER.v0.spec.md:
--   R0 trivial                    -> fast / D-only
--   R1 rail_code + compiler oracle -> deliberate / D+A  (+E on runtime-symptom keyword)
--   R2 rail_code (no compiler)     -> deliberate / D   (+E on measurement verb)
--                                                       (+A on numeric / scale marker)
--                                    if panel ends up D-only and complexity=='hard',
--                                    hedge by adding A.
--   R3 reasoning                   -> deliberate / D+E+A   (drop A on documented-fact framing)
--   R4 open_ended                  -> deliberate / full panel
--   R5 fallback (unknown category) -> deliberate / full panel
--
-- v0 deliberately ignores: prose semantics, ledger-tail history, per-mode
-- accuracy lookups. Substring matching is case-insensitive ASCII (lower_str);
-- no regex engine, no word boundaries -- substrings are the cheap v0 proxy.
--
-- Curator discipline for sets/synthetic_triage.jsonl:
--   - No '"' character inside question.text (marker-split is escape-unaware).
--   - selected_panel uses canonical order: deductive, empirical, adversarial.

import "stdlib/file.rail"

-- ─── List utilities ──────────────────────────────────────────────

filter_nonempty xs =
  if xs == [] then []
  else
    let x = head xs
    if length (chars x) == 0 then filter_nonempty (tail xs)
    else cons x (filter_nonempty (tail xs))

contains_str xs needle =
  if xs == [] then false
  else if head xs == needle then true
  else contains_str (tail xs) needle

append_list a b =
  if a == [] then b
  else cons (head a) (append_list (tail a) b)

list_subset a b =
  if a == [] then true
  else if contains_str b (head a) then list_subset (tail a) b
  else false

list_eq_set a b =
  if length a == length b then list_subset a b
  else false

-- ─── Case helpers (ASCII only) ───────────────────────────────────

lower_char c =
  let code = char_to_int c
  if code >= 65 then
    if code <= 90 then char_from_int (code + 32)
    else c
  else c

lower_str_loop s i n acc =
  if i >= n then acc
  else
    let c = str_sub s i 1
    lower_str_loop s (i + 1) n (cat [acc, lower_char c])

lower_str s = lower_str_loop s 0 (length (chars s)) ""

any_in_text hay needles =
  if needles == [] then false
  else if str_find (head needles) hay >= 0 then true
  else any_in_text hay (tail needles)

-- ─── Field extraction (marker-split, no escape awareness) ────────

extract_one marker terminator line =
  let i = str_find marker line
  if i < 0 then ""
  else
    let start = i + length (chars marker)
    let rest = str_sub line start (length (chars line) - start)
    let j = str_find terminator rest
    if j < 0 then ""
    else str_sub rest 0 j

extract_in_scope scope marker terminator line =
  let i = str_find scope line
  if i < 0 then ""
  else
    let start = i + length (chars scope)
    let rest = str_sub line start (length (chars line) - start)
    extract_one marker terminator rest

parse_string_list_loop pieces acc =
  if pieces == [] then reverse acc
  else
    let p = head pieces
    let v = extract_one "\"" "\"" p
    if length (chars v) == 0 then parse_string_list_loop (tail pieces) acc
    else parse_string_list_loop (tail pieces) (cons v acc)

-- Parse the `"selected_panel":[...]` list scoped to e.g. `"intended":`.
-- Returns [] if scope or list not found.
parse_panel_list scope line =
  let raw = extract_in_scope scope "\"selected_panel\":[" "]" line
  if length (chars raw) == 0 then []
  else parse_string_list_loop (str_split "," raw) []

-- ─── Trigger word lists (lowercase substrings, no word boundaries) ──

r1_e_words _ = ["segfault","crash","hang","leak","slow","error","panic","loop"]
r2_e_words _ = ["observe","measure","run","test","trace","benchmark","profile"]
r2_a_words _ = ["overflow","underflow","fp","float","precision","scale","edge","race","concurrent","large","huge","max","min","nan","inf","wrap","truncate"]
r3_drop_a_words _ = ["definition","standard","spec","documented","by definition","formally"]

-- ─── Canonical panel order (deductive, empirical, adversarial) ──

canonicalize_panel panel =
  let p1 = if contains_str panel "deductive" then ["deductive"] else []
  let p2 = if contains_str panel "empirical" then append_list p1 ["empirical"] else p1
  let p3 = if contains_str panel "adversarial" then append_list p2 ["adversarial"] else p2
  p3

-- ─── Triage decision (the rule v0) ───────────────────────────────

decide_triage category complexity oracle_kind text_lower =
  if complexity == "trivial" then
    ("fast", "R0_trivial", ["deductive"])
  else
    if category == "rail_code" then
      if oracle_kind == "compiler" then
        let base = ["deductive","adversarial"]
        let needs_e = any_in_text text_lower (r1_e_words 0)
        let panel = if needs_e then append_list base ["empirical"] else base
        ("deliberate", "R1_rail_compiler_oracle", canonicalize_panel panel)
      else
        let needs_e = any_in_text text_lower (r2_e_words 0)
        let needs_a = any_in_text text_lower (r2_a_words 0)
        let p0 = ["deductive"]
        let p1 = if needs_e then append_list p0 ["empirical"] else p0
        let p2 = if needs_a then append_list p1 ["adversarial"] else p1
        let final =
          if length p2 == 1 then
            if complexity == "hard" then append_list p2 ["adversarial"]
            else p2
          else p2
        ("deliberate", "R2_rail_invariant_or_specialist", canonicalize_panel final)
    else
      if category == "reasoning" then
        let drop_a = any_in_text text_lower (r3_drop_a_words 0)
        if drop_a then
          ("deliberate", "R3_reasoning", ["deductive","empirical"])
        else
          ("deliberate", "R3_reasoning", ["deductive","empirical","adversarial"])
      else
        if category == "open_ended" then
          ("deliberate", "R4_open_ended", ["deductive","empirical","adversarial"])
        else
          ("deliberate", "R5_fallback", ["deductive","empirical","adversarial"])

-- Top-level entry: parse a JSONL record, return (path, reason, panel).
triage_for_line line =
  let category = extract_one "\"category\":\"" "\"" line
  let complexity = extract_one "\"complexity_hint\":\"" "\"" line
  let oracle_kind = extract_one "\"oracle_kind\":\"" "\"" line
  let text = extract_one "\"text\":\"" "\"" line
  let text_lower = lower_str text
  decide_triage category complexity oracle_kind text_lower

-- Closed reason set (auditability invariant).
is_known_reason r =
  if r == "R0_trivial" then true
  else if r == "R1_rail_compiler_oracle" then true
  else if r == "R2_rail_invariant_or_specialist" then true
  else if r == "R3_reasoning" then true
  else if r == "R4_open_ended" then true
  else if r == "R5_fallback" then true
  else false
