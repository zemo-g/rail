-- tools/dnra/impl/ledger_demo.rail — smoke runner for ledger.rail v0.2.
--
-- Run: ./rail_native run tools/dnra/impl/ledger_demo.rail
-- Appends to ~/.ledatic/dnra/chain/deliberations.jsonl using the
-- runtime signing key at ~/.ledatic/dnra/signing_key (auto-generated
-- on first run, kept across runs). Use test_ledger.rail for isolated tests.

import "tools/dnra/impl/ledger.rail"

main =
  let log = ledger_init (dnra_chain_dir 0) "deliberations.jsonl"
  let key = default_signing_key_path 0
  let _ = print (cat ["chain log: ", log])
  let _ = print (cat ["signing key: ", key])
  let body1 = "{\"kind\":\"ledatic.dnra.deliberation\",\"version\":1,\"question\":\"smoke-test-1\"}"
  let id1 = ledger_append log key body1
  let _ = print (cat ["append #1 id=", id1])
  let body2 = "{\"kind\":\"ledatic.dnra.deliberation\",\"version\":1,\"question\":\"smoke-test-2\"}"
  let id2 = ledger_append log key body2
  let _ = print (cat ["append #2 id=", id2])
  let head = ledger_head_id log
  let _ = print (cat ["head id=  ", head])
  let v = ledger_verify_head log key
  let _ = print (cat ["verify_head=", show v])
  if head == id2 then
    if v == 1 then
      let _ = print "PASS"
      0
    else
      let _ = print "FAIL: verify_head returned 0"
      1
  else
    let _ = print "FAIL: head != id2"
    1
