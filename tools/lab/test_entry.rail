-- tools/lab/test_entry.rail — Acceptance tests for entry.rail.
--
-- Run: ./rail_native run tools/lab/test_entry.rail
--
-- Exit 0 + last-line `PASS` iff every test passes. The test runner
-- convention from tools/test/rail_test.rail is exit-code-honest and
-- looks for `PASS` on the final line.

import "tools/lab/entry.rail"

-- ── Test harness ──────────────────────────────────────────────────────
--
-- Rail quirk: the compiler stores the first 3 params untagged in
-- x19/x20/x21 — string `==` between two computed strings becomes a raw
-- pointer compare and reports false even for equal contents. We pad
-- every assertion helper with leading zero args so the actual operands
-- land at slot 4+. The pad keeps the body identical to what you'd
-- naively write.

str_eq _d1 _d2 _d3 a b = if a == b then 1 else 0
int_eq _d1 _d2 _d3 a b = if a == b then 1 else 0

assert_true label cond = if cond then 1 else
  let _ = print (cat ["FAIL: ", label])
  0

assert_eq_int label a b = if int_eq 0 0 0 a b == 1 then 1 else
  let _ = print (cat ["FAIL: ", label, " expected=", show b, " got=", show a])
  0

assert_eq_str label a b = if str_eq 0 0 0 a b == 1 then 1 else
  let _ = print (cat ["FAIL: ", label])
  let _ = print (cat ["       expected=", b])
  let _ = print (cat ["       got     =", a])
  0

assert_err label expected_code val =
  if is_error val == false then
    let _ = print (cat ["FAIL: ", label, " expected error ", expected_code, " got non-error"])
    0
  else
    let msg = err_msg val
    let n = length (chars expected_code)
    let prefix = str_sub msg 0 n
    if str_eq 0 0 0 prefix expected_code == 1 then 1
    else
      let _ = print (cat ["FAIL: ", label, " expected ", expected_code, " got ", msg])
      0

assert_ok label val =
  if is_error val then
    let _ = print (cat ["FAIL: ", label, " unexpected error: ", err_msg val])
    0
  else 1

-- Hex bookkeeping
PUB_HEX = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
SIG_HEX = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
PUB2_HEX = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511b"
HASH_64_AA = "aa11111111111111111111111111111111111111111111111111111111111111"
HASH_64_BB = "bb22222222222222222222222222222222222222222222222222222222222222"

-- Build a valid base entry with a populated result. Used by many tests.
mkbase _ =
  let e = entry_new "build feature" "h" "if X then falsified" ["acc", "loss"] "echo hi" "2026-05-15T12:00:00Z"
  entry_set_result e Pass [("loss", "0.1"), ("acc", "0.9")]

-- ── T-KILL: empty kill_target at entry_new ────────────────────────────

t_kill _ =
  let r = entry_new "g" "" "" ["c"] "cmd" "2026-05-15T00:00:00Z"
  assert_err "T-KILL: empty kill_target at entry_new" "E-MISSING-KILL" r

-- ── T-CTR: empty counters at entry_new ────────────────────────────────

t_ctr _ =
  let r = entry_new "g" "" "kill" [] "cmd" "2026-05-15T00:00:00Z"
  assert_err "T-CTR: empty counters at entry_new" "E-EMPTY-COUNTERS" r

-- ── T-CTR-NM: bad counter name ────────────────────────────────────────

t_ctr_nm _ =
  let r = entry_new "g" "" "kill" ["1bad"] "cmd" "2026-05-15T00:00:00Z"
  assert_err "T-CTR-NM: counter starting with digit" "E-BAD-COUNTER-NAME" r

-- ── T-ASCII: non-ASCII byte in goal ───────────────────────────────────

t_ascii _ =
  let r = entry_new "gé" "" "kill" ["c"] "cmd" "2026-05-15T00:00:00Z"
  assert_err "T-ASCII: goal contains 0xC3 0xA9" "E-NON-ASCII" r

-- ── T-TIME: bad time formats ──────────────────────────────────────────

t_time _ =
  let r1 = entry_new "g" "" "k" ["c"] "cmd" "2026-05-15"
  let p1 = assert_err "T-TIME (date only)" "E-BAD-TIME" r1
  let r2 = entry_new "g" "" "k" ["c"] "cmd" "2026-05-15T00:00:00.500Z"
  let p2 = assert_err "T-TIME (fractional seconds)" "E-BAD-TIME" r2
  p1 * p2

-- ── T-SIGN-K: entry_sign refuses entry with empty kill ───────────────
-- entry_new already refuses empty kill. To prove the sign-time guard,
-- build a valid entry then mutate via direct constructor with empty kill.

t_sign_k _ =
  -- Hand-craft an Entry with empty kill_target (bypass entry_new).
  let r0 = Result Inconclusive []
  let bad_entry = Entry "" [] "g" "" "" ["c"] "cmd" r0 "" "" "2026-05-15T00:00:00Z" "" ""
  let r = entry_sign bad_entry PUB_HEX SIG_HEX
  assert_err "T-SIGN-K: entry_sign with empty kill_target" "E-MISSING-KILL" r

-- Same falsification anchor for empty counters at sign time:
t_sign_ctr _ =
  let r0 = Result Inconclusive []
  let bad_entry = Entry "" [] "g" "" "k" [] "cmd" r0 "" "" "2026-05-15T00:00:00Z" "" ""
  let r = entry_sign bad_entry PUB_HEX SIG_HEX
  assert_err "T-SIGN-CTR: entry_sign with empty counters" "E-EMPTY-COUNTERS" r

-- ── T-HASH-1: counters in different order hash identically ────────────

t_hash_1 _ =
  let e1 = entry_new "g" "" "k" ["acc", "loss"] "cmd" "2026-05-15T00:00:00Z"
  let e2 = entry_new "g" "" "k" ["loss", "acc"] "cmd" "2026-05-15T00:00:00Z"
  let h1 = entry_content_hash e1
  let h2 = entry_content_hash e2
  assert_eq_str "T-HASH-1: counter order does not affect hash" h2 h1

-- ── T-HASH-2: numbers in different order hash identically ─────────────

t_hash_2 _ =
  let base = entry_new "g" "" "k" ["acc", "loss"] "cmd" "2026-05-15T00:00:00Z"
  let e1 = entry_set_result base Pass [("acc", "0.9"), ("loss", "0.1")]
  let e2 = entry_set_result base Pass [("loss", "0.1"), ("acc", "0.9")]
  let h1 = entry_content_hash e1
  let h2 = entry_content_hash e2
  assert_eq_str "T-HASH-2: number order does not affect hash" h2 h1

-- ── T-HASH-3: parent order DOES affect hash ───────────────────────────

t_hash_3 _ =
  let base = entry_new "g" "" "k" ["c"] "cmd" "2026-05-15T00:00:00Z"
  let e1 = entry_set_parents base [HASH_64_AA, HASH_64_BB]
  let e2 = entry_set_parents base [HASH_64_BB, HASH_64_AA]
  let h1 = entry_content_hash e1
  let h2 = entry_content_hash e2
  assert_true "T-HASH-3: parent order affects hash" (h1 != h2)

-- ── T-HASH-4: "0.1" vs "0.10" hash differently ────────────────────────

t_hash_4 _ =
  let base = entry_new "g" "" "k" ["loss"] "cmd" "2026-05-15T00:00:00Z"
  let e1 = entry_set_result base Pass [("loss", "0.1")]
  let e2 = entry_set_result base Pass [("loss", "0.10")]
  let h1 = entry_content_hash e1
  let h2 = entry_content_hash e2
  assert_true "T-HASH-4: number string formatting is significant" (h1 != h2)

-- ── T-HASH-5: signer is bound into the digest ─────────────────────────

t_hash_5 _ =
  let base = mkbase 0
  let s1 = entry_sign base PUB_HEX SIG_HEX
  let s2 = entry_sign base PUB2_HEX SIG_HEX
  if is_error s1 then
    let _ = print (cat ["FAIL: T-HASH-5 sign1 errored: ", err_msg s1])
    0
  else if is_error s2 then
    let _ = print (cat ["FAIL: T-HASH-5 sign2 errored: ", err_msg s2])
    0
  else assert_true "T-HASH-5: signer change shifts id" (entry_id s1 != entry_id s2)

-- ── T-CANONICAL (alias of T-HASH-1 + T-HASH-2 + optional re-order) ────

t_canonical _ =
  let e1 = entry_new "g" "h" "k" ["acc", "loss"] "cmd" "2026-05-15T00:00:00Z"
  let e2 = entry_new "g" "h" "k" ["loss", "acc"] "cmd" "2026-05-15T00:00:00Z"
  let e1b = entry_set_result e1 Pass [("loss", "0.1"), ("acc", "0.9")]
  let e2b = entry_set_result e2 Pass [("acc", "0.9"), ("loss", "0.1")]
  let h1 = entry_content_hash e1b
  let h2 = entry_content_hash e2b
  assert_eq_str "T-CANONICAL: equal entries hash identically" h2 h1

-- ── Real-signature fixture ────────────────────────────────────────────
-- The body below was canonicalized by entry.rail, then signed by
-- openssl Ed25519 (private key generated once; not committed).
-- Pubkey + signature below verify against THIS exact canonical body.
-- The fixture also exercises the spec §4.6 contract: caller-supplied
-- signature, no Rail signing primitive needed.

FIX_GOAL = "fixture goal"
FIX_HYP = ""
FIX_KILL = "kill criterion"
FIX_COUNTERS = ["loss"]
FIX_CMD = "echo hi"
FIX_TIME = "2026-05-15T12:00:00Z"
FIX_PUB = "a57489552c3aaaf659f6134c59ecc76a50547d9151815f612c165f0191eef500"
FIX_SIG = "1f95075c6301ac6ec6e682158c00a43f882ad57cff9b0aae118bfc03ce534789dcb36ab4675a33e209c9f3256baca6bf1d3d0a73a455d8ef13a48430d2f1030d"

build_fixture _ =
  let base = entry_new FIX_GOAL FIX_HYP FIX_KILL FIX_COUNTERS FIX_CMD FIX_TIME
  let withr = entry_set_result base Pass [("loss", "0.1")]
  entry_sign withr FIX_PUB FIX_SIG

-- ── T-VERIFY-POS: signature verifies end-to-end against canonical body
t_verify_pos _ =
  let signed = build_fixture 0
  if is_error signed then
    let _ = print (cat ["FAIL: T-VERIFY-POS sign: ", err_msg signed])
    0
  else
    let v = entry_verify signed
    if is_error v then
      let _ = print (cat ["FAIL: T-VERIFY-POS expected 1, got error: ", err_msg v])
      0
    else assert_eq_int "T-VERIFY-POS: real signature verifies" v 1

-- ── T-ROUNDTRIP: serialize -> deserialize -> verify ───────────────────
-- Real-signature fixture flows through JSON and still verifies.

t_roundtrip _ =
  let signed = build_fixture 0
  if is_error signed then
    let _ = print (cat ["FAIL: T-ROUNDTRIP sign errored: ", err_msg signed])
    0
  else
    let js = entry_serialize signed []
    let (e2, ws) = entry_deserialize js
    if is_error e2 then
      let _ = print (cat ["FAIL: T-ROUNDTRIP deserialize: ", err_msg e2])
      0
    else
      let p1 = assert_eq_str "T-ROUNDTRIP: id preserved" (entry_id e2) (entry_id signed)
      let p2 = assert_eq_str "T-ROUNDTRIP: goal preserved" (entry_goal e2) (entry_goal signed)
      let p3 = assert_eq_str "T-ROUNDTRIP: kill preserved" (entry_kill_target e2) (entry_kill_target signed)
      let p4 = assert_eq_str "T-ROUNDTRIP: signer preserved" (entry_signer e2) (entry_signer signed)
      let p5 = assert_eq_str "T-ROUNDTRIP: sig preserved" (entry_sig e2) (entry_sig signed)
      let p6 = assert_eq_int "T-ROUNDTRIP: parent count" (length (entry_parents e2)) (length (entry_parents signed))
      let p7 = assert_eq_int "T-ROUNDTRIP: counter count" (length (entry_counters e2)) (length (entry_counters signed))
      let p8 = assert_eq_int "T-ROUNDTRIP: witnesses empty" (length ws) 0
      let v = entry_verify e2
      let p9 = if is_error v then
        let _ = print (cat ["FAIL: T-ROUNDTRIP verify after deserialize errored: ", err_msg v])
        0
      else assert_eq_int "T-ROUNDTRIP: post-deserialize verify=1" v 1
      p1 * p2 * p3 * p4 * p5 * p6 * p7 * p8 * p9

-- ── T-TAMP-B: tamper canonical-body field, verify returns 0 ───────────
-- Uses the real-signature fixture (signed by openssl Ed25519). Each
-- tamper test takes a verified entry (verify==1), mutates one byte,
-- and asserts verify==0 (not error — the entry stays well-formed).

craft_signed_entry _ = build_fixture 0

t_tamp_b _ =
  let signed = craft_signed_entry 0
  -- Mutate goal field; do not touch id/sig. recomputed hash will diverge.
  match signed
    | Entry id parents _g hyp kill cs cmd r pul wts created sig signer ->
        let tampered = Entry id parents "TAMPERED" hyp kill cs cmd r pul wts created sig signer
        let v = entry_verify tampered
        if is_error v then
          let _ = print (cat ["FAIL: T-TAMP-B expected 0, got error: ", err_msg v])
          0
        else assert_eq_int "T-TAMP-B: tampered body returns 0" v 0

-- ── T-TAMP-S: bit-flip in signature ───────────────────────────────────

t_tamp_s _ =
  -- Flip one nibble in the signature hex; structure stays valid (still
  -- 128 hex chars), but ed25519_verify returns 0.
  let signed = craft_signed_entry 0
  match signed
    | Entry id parents g hyp kill cs cmd r pul wts created sig signer ->
        -- Replace first hex char.
        let first = str_sub sig 0 1
        let rest = str_sub sig 1 127
        let flipped_first = if first == "e" then "f" else "e"
        let new_sig = cat [flipped_first, rest]
        let tampered = Entry id parents g hyp kill cs cmd r pul wts created new_sig signer
        let v = entry_verify tampered
        if is_error v then
          let _ = print (cat ["FAIL: T-TAMP-S expected 0, got error: ", err_msg v])
          0
        else assert_eq_int "T-TAMP-S: tampered sig returns 0" v 0

-- ── T-TAMP-P: tamper signer pubkey ────────────────────────────────────

t_tamp_p _ =
  let signed = craft_signed_entry 0
  match signed
    | Entry id parents g hyp kill cs cmd r pul wts created sig _signer ->
        let tampered = Entry id parents g hyp kill cs cmd r pul wts created sig PUB2_HEX
        let v = entry_verify tampered
        if is_error v then
          let _ = print (cat ["FAIL: T-TAMP-P expected 0, got error: ", err_msg v])
          0
        else assert_eq_int "T-TAMP-P: tampered signer returns 0" v 0

-- ── T-WIT: attach witness, verify shape; tampered witness fails ──────

t_wit _ =
  let signed = craft_signed_entry 0
  let id_before = entry_id signed
  let ws = entry_attach_witness signed [] PUB_HEX SIG_HEX "2026-05-15T13:00:00Z"
  if is_error ws then
    let _ = print (cat ["FAIL: T-WIT attach errored: ", err_msg ws])
    0
  else
    let id_after = entry_id signed
    let p1 = assert_eq_str "T-WIT: id unchanged after attach" id_after id_before
    let p2 = assert_eq_int "T-WIT: witness count == 1" (length ws) 1
    p1 * p2

-- ── T-DSER: wrong kind / version / missing field ──────────────────────

t_dser_kind _ =
  let j = "{\"kind\":\"foo\",\"version\":1,\"id\":\"\",\"parents\":[],\"goal\":\"\",\"hypothesis\":\"\",\"kill_target\":\"\",\"counters\":[],\"cmd\":\"\",\"result\":{\"verdict\":\"INCONCLUSIVE\",\"numbers\":[]},\"pulse_id\":\"\",\"weights_hash\":\"\",\"created_at\":\"\",\"signer\":\"\",\"sig\":\"\",\"witnesses\":[]}"
  let r = entry_deserialize j
  assert_err "T-DSER kind" "E-BAD-KIND" r

t_dser_ver _ =
  let j = "{\"kind\":\"ledatic.lab.entry\",\"version\":2,\"id\":\"\",\"parents\":[],\"goal\":\"\",\"hypothesis\":\"\",\"kill_target\":\"\",\"counters\":[],\"cmd\":\"\",\"result\":{\"verdict\":\"INCONCLUSIVE\",\"numbers\":[]},\"pulse_id\":\"\",\"weights_hash\":\"\",\"created_at\":\"\",\"signer\":\"\",\"sig\":\"\",\"witnesses\":[]}"
  let r = entry_deserialize j
  assert_err "T-DSER ver" "E-BAD-KIND" r

t_dser_missing _ =
  -- omit "kill_target"
  let j = "{\"kind\":\"ledatic.lab.entry\",\"version\":1,\"id\":\"\",\"parents\":[],\"goal\":\"g\",\"hypothesis\":\"\",\"counters\":[\"c\"],\"cmd\":\"x\",\"result\":{\"verdict\":\"INCONCLUSIVE\",\"numbers\":[]},\"pulse_id\":\"\",\"weights_hash\":\"\",\"created_at\":\"2026-05-15T00:00:00Z\",\"signer\":\"\",\"sig\":\"\",\"witnesses\":[]}"
  let r = entry_deserialize j
  assert_err "T-DSER missing" "E-MISSING-FIELD" r

-- ── Run all tests ─────────────────────────────────────────────────────

main =
  let r1 = t_kill 0
  let r2 = t_ctr 0
  let r3 = t_ctr_nm 0
  let r4 = t_ascii 0
  let r5 = t_time 0
  let r6 = t_sign_k 0
  let r7 = t_sign_ctr 0
  let r8 = t_hash_1 0
  let r9 = t_hash_2 0
  let r10 = t_hash_3 0
  let r11 = t_hash_4 0
  let r12 = t_hash_5 0
  let r13 = t_canonical 0
  let r14 = t_verify_pos 0
  let r15 = t_roundtrip 0
  let r16 = t_tamp_b 0
  let r17 = t_tamp_s 0
  let r18 = t_tamp_p 0
  let r19 = t_wit 0
  let r20 = t_dser_kind 0
  let r21 = t_dser_ver 0
  let r22 = t_dser_missing 0
  let total = r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + r11 + r12 + r13 + r14 + r15 + r16 + r17 + r18 + r19 + r20 + r21 + r22
  let _ = print (cat ["Tests passed: ", show total, " / 22"])
  if total == 22 then
    let _ = print "PASS"
    0
  else
    let _ = print "FAIL"
    1
