-- measure_new_harness_floor.rail — calibrate the new gettimeofday-based
-- timer's own floor when used the way the JIT v2 harness will use it:
-- two time_us_now calls bracketing a small batch of work, divided by batch
-- size.
--
-- Two measurements:
--   (a) BIG batch (inner=50000 empty iters): same shape as JIT harness will
--       use; sample is in us/iter. The batch is long enough that even at
--       sub-microsecond per-call timer, the delta is non-zero. The floor we
--       care about for sub-50us optimizations is the JITTER of this number
--       across 200 samples.
--   (b) NAKED back-to-back time_us_now calls with NO work between them. This
--       is the absolute lower bound for two-sample bracketing.

import "stdlib/time_us.rail"

empty_loop n =
  if n <= 0 then 0
  else empty_loop (n - 1)

-- Variant A: batch of 50000 empty iters, return us per iter.
batch_a inner =
  let t0 = time_us_now 0
  let _ = empty_loop inner
  let t1 = time_us_now 0
  (t1 - t0)  -- total us; caller normalizes

-- Variant B: back-to-back time_us_now, no work.
back_to_back _ =
  let t0 = time_us_now 0
  let t1 = time_us_now 0
  t1 - t0

run_a k inner first =
  if k <= 0 then 0
  else
    let total_us = batch_a inner
    let sep = if first == 1 then "" else ","
    let _ = appA (cat [sep, show total_us])
    run_a (k - 1) inner 0

run_b k first =
  if k <= 0 then 0
  else
    let d = back_to_back 0
    let sep = if first == 1 then "" else ","
    let _ = appB (cat [sep, show d])
    run_b (k - 1) 0

appA s =
  let _ = shell (cat ["printf '%s' '", s, "' >> /tmp/rail_floor_new_A"])
  0

appB s =
  let _ = shell (cat ["printf '%s' '", s, "' >> /tmp/rail_floor_new_B"])
  0

main =
  let _ = shell "rm -f /tmp/rail_floor_new_A /tmp/rail_floor_new_B"
  let _ = shell "touch /tmp/rail_floor_new_A /tmp/rail_floor_new_B"

  -- Warm.
  let _ = empty_loop 1000

  -- Variant A: 200 batches of 50000 empty iters.
  let _ = run_a 200 50000 1

  -- Variant B: 200 back-to-back samples.
  let _ = run_b 200 1

  let _ = shell "echo '' >> /tmp/rail_floor_new_A"
  let _ = shell "echo '' >> /tmp/rail_floor_new_B"
  let _ = print "DONE"
  0
