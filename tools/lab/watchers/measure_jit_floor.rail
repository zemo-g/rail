-- measure_jit_floor.rail — diagnostic harness for v2 baseline.
--
-- Strips the JIT call entirely and times an empty inner loop. Gives the
-- measurement-floor cost (Rail self-loop + date +%s%N shell-out
-- granularity divided over batch size).
--
-- If this floor is comparable to direct_us_p50, then the trampoline-vs-
-- direct delta IS the dispatch-overhead delta, and floor is not eating
-- the comparison.

parse_int_acc cs acc =
  if length cs == 0 then acc
  else
    let d = char_to_int (head cs) - 48
    if d < 0 then acc
    else if d > 9 then acc
    else parse_int_acc (tail cs) (acc * 10 + d)

now_ns _ =
  let s = shell "date +%s%N | tr -d '\\n'"
  parse_int_acc (chars s) 0

empty_loop n =
  if n <= 0 then 0
  else empty_loop (n - 1)

batch_per_call_ns inner =
  let t0 = now_ns 0
  let _ = empty_loop inner
  let t1 = now_ns 0
  (t1 - t0) / inner

run_batches k inner first =
  if k <= 0 then 0
  else
    let ns = batch_per_call_ns inner
    let sep = if first == 1 then "" else ","
    let _ = print_no_newline (cat [sep, show ns])
    run_batches (k - 1) inner 0

print_no_newline s =
  let _ = shell (cat ["printf '%s' '", s, "' >> /tmp/rail_floor_samples"])
  0

main =
  let _ = shell "rm -f /tmp/rail_floor_samples"
  let _ = shell "touch /tmp/rail_floor_samples"
  let _ = empty_loop 50
  let _ = run_batches 200 50 1
  let _ = shell "echo '' >> /tmp/rail_floor_samples"
  let _ = print "DONE"
  0
