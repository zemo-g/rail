-- measure_harness_floors.rail — calibration harness for timing-floor audit.
--
-- Purpose:
--   Quantify the per-sample floor of BOTH timing harnesses on identical empty
--   work, before changing any production measurement code. This is the
--   verification-before-removal step from memory/feedback_verify_removals.md:
--   we must prove the old harness floor is non-negligible AND prove the new
--   harness is sub-10us BEFORE the new harness is wired into the JIT v2
--   re-measurement.
--
-- Two timing paths under test:
--   1. OLD: `shell "date +%s%N"` round-trip (the harness behind
--      measure_jit_floor.rail). Expected: ~120us floor on Apple Silicon.
--   2. NEW: foreign `gettimeofday(&tv, NULL)` writing into a 16-byte buffer,
--      reading tv_sec (offset 0, 8 bytes) and tv_usec (offset 8, 4 bytes)
--      via byte_at, returning us = tv_sec*1_000_000 + tv_usec.
--      Expected: <1us per call (commpage-backed on macOS).
--
-- Same outer shape as measure_jit_floor.rail: 200 batches x 50 empty inner
-- iters each. The per-batch quotient is per-empty-iter ns/iter, which is what
-- the JIT measurement code subtracts off via the same shape.
--
-- Emits two CSV sample files:
--   /tmp/rail_floor_old_samples
--   /tmp/rail_floor_new_samples

import "stdlib/time_us.rail"

-- === OLD harness: shell-out to date +%s%N ===========================
parse_int_acc cs acc =
  if length cs == 0 then acc
  else
    let d = char_to_int (head cs) - 48
    if d < 0 then acc
    else if d > 9 then acc
    else parse_int_acc (tail cs) (acc * 10 + d)

now_ns_old _ =
  let s = shell "date +%s%N | tr -d '\\n'"
  parse_int_acc (chars s) 0

-- === Empty inner loop (identical structure both harnesses time) =====
empty_loop n =
  if n <= 0 then 0
  else empty_loop (n - 1)

-- === OLD per-batch: us per empty inner-iter via shell date ==========
batch_per_call_us_old inner =
  let t0 = now_ns_old 0
  let _ = empty_loop inner
  let t1 = now_ns_old 0
  -- ns/iter -> us/iter (ns/1000)
  (t1 - t0) / (inner * 1000)

-- === NEW per-batch: us per empty inner-iter via gettimeofday ========
-- time_us_now (from stdlib/time_us.rail) returns microseconds directly.
batch_per_call_us_new inner =
  let t0 = time_us_now 0
  let _ = empty_loop inner
  let t1 = time_us_now 0
  (t1 - t0) / inner

-- === Outer: write CSV to sample file =================================
run_batches_old k inner first =
  if k <= 0 then 0
  else
    let us = batch_per_call_us_old inner
    let sep = if first == 1 then "" else ","
    let _ = append_old (cat [sep, show us])
    run_batches_old (k - 1) inner 0

run_batches_new k inner first =
  if k <= 0 then 0
  else
    let us = batch_per_call_us_new inner
    let sep = if first == 1 then "" else ","
    let _ = append_new (cat [sep, show us])
    run_batches_new (k - 1) inner 0

append_old s =
  let _ = shell (cat ["printf '%s' '", s, "' >> /tmp/rail_floor_old_samples"])
  0

append_new s =
  let _ = shell (cat ["printf '%s' '", s, "' >> /tmp/rail_floor_new_samples"])
  0

main =
  let _ = shell "rm -f /tmp/rail_floor_old_samples /tmp/rail_floor_new_samples"
  let _ = shell "touch /tmp/rail_floor_old_samples /tmp/rail_floor_new_samples"

  -- Warm-up.
  let _ = empty_loop 50

  -- Sanity print: confirm time_us_now actually monotonically advances.
  let a = time_us_now 0
  let _ = empty_loop 1000
  let b = time_us_now 0
  let _ = print (cat ["time_us_now sanity: a=", show a, " b=", show b, " delta_us=", show (b - a)])

  -- 200 batches x 50 inner iters each, for both harnesses.
  let _ = run_batches_old 200 50 1
  let _ = run_batches_new 200 50 1

  let _ = shell "echo '' >> /tmp/rail_floor_old_samples"
  let _ = shell "echo '' >> /tmp/rail_floor_new_samples"
  let _ = print "DONE"
  0
