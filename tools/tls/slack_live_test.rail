import "stdlib/slack_client.rail"

main =
  let _ = print "slack_post_text — live DM to the configured ops channel:"
  let chan = trim (shell "cat $HOME/.fleet/slack_channel 2>/dev/null || echo ''")
  let r = slack_post_text chan "v3.0.0 smoke: pure-Rail TLS direct to slack.com, no socat." "$HOME/.fleet/slack_token"
  let ok = let (a, _) = r in a
  let resp = let (_, b) = r in b
  let _ = print (join "" ["  ok   = ", show ok])
  let _ = print (join "" ["  resp (first 300) = ", if length resp > 300 then str_sub resp 0 300 else resp])
  if ok then
    let _ = print "PASS — Slack accepted pure-Rail HTTPS POST"
    0
  else 1
