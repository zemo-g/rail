-- RFC 8032 TEST 1 known-answer vector for Ed25519.
--   pub = d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a
--   msg = (empty)
--   sig = e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b
-- Two negative controls flip one byte in R and one byte in S to
-- confirm bad signatures are actually rejected.
import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"

ed_tweak_byte b i =
  let n = arr_len b
  let c = arr_new n 0
  let _ = sha_copy_bytes b c 0 0 n
  let _ = arr_set c i (bit_and (arr_get c i + 1) 255)
  c

main =
  let pub = hex_to_bytes "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
  let sig = hex_to_bytes "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
  let msg = arr_new 0 0
  let _ = print "Ed25519 RFC 8032 TEST 1:"
  let ok = ed25519_verify pub msg 0 sig
  let _ = print (join "" ["  valid    = ", show ok])
  let sig_bad_r = ed_tweak_byte sig 0
  let ok_r = ed25519_verify pub msg 0 sig_bad_r
  let _ = print (join "" ["  bad_R    = ", show ok_r])
  let sig_bad_s = ed_tweak_byte sig 32
  let ok_s = ed25519_verify pub msg 0 sig_bad_s
  let _ = print (join "" ["  bad_S    = ", show ok_s])
  if ok == 1 then
    if ok_r == 0 then
      if ok_s == 0 then
        let _ = print "PASS"
        0
      else
        let _ = print "FAIL: bad-S accepted"
        3
    else
      let _ = print "FAIL: bad-R accepted"
      2
  else
    let _ = print "FAIL: good signature rejected"
    1
