-- cc_spki_probe — confirm the SPKI trust-store termination path by
-- hashing each root's cached SPKI and re-looking it up via
-- ts_has_spki_hash. Catches regressions where the pre-compute step
-- or the byte-equal lookup diverges.
import "stdlib/https_strict.rail"

main =
  let store = pem_load_trust_store "/etc/ssl/cert.pem"
  if arr_get store 3 == 0 then let _ = print "FAIL: trust store load failed" in 1
  else
    let n = arr_get store 2
    let hashes = arr_get store 6
    let _ = print (join "" ["trust store n=", show n])
    let ok = cc_all_hashes_match store hashes n 0
    if ok == n then
      let _ = print (join "" ["PASS: all ", show n, " root SPKI hashes self-match"])
      0
    else
      let _ = print (join "" ["FAIL: only ", show ok, "/", show n, " root SPKI hashes self-match"])
      1

cc_all_hashes_match store hashes n i =
  if i >= n then 0
  else
    let h = arr_get hashes i
    let hit = ts_has_spki_hash store h
    let rest = cc_all_hashes_match store hashes n (i + 1)
    if hit == 1 then rest + 1 else rest
