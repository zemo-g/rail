-- Regression test for cv_dns_match wildcard vs exact-equality bug.
--
-- BUG (pre-fix, security-audit-2026-05-12, Fixer-A flag):
--   cv_dns_match short-circuited to cv_bytes_ieq when v_len == host_len,
--   so a SAN like "*.co.uk" (7 bytes) could never match host "x.co.uk"
--   (7 bytes) — the wildcard branch was unreachable in that case.
--
-- Test matrix (cert SAN vs hostname):
--   1. "*.example.com" (13)        vs "foo.example.com" (15)  -> 1 (wildcard, different len)
--   2. "*.co.uk"        (7)         vs "x.co.uk"        (7)    -> 1 (wildcard, EQUAL len — the bug case)
--   3. "*.example.com" (13)        vs "example.com"    (11)   -> 0 (no label to wildcard)
--   4. "example.com"   (11)        vs "example.com"    (11)   -> 1 (exact match, no wildcard)
--
-- Pre-fix: case 2 returns 0 (FAIL). Post-fix: all four cases match expected.

import "stdlib/tls13_client.rail"

case_run label cert_str host_str expected =
  let cert = string_to_bytes cert_str
  let host = string_to_bytes host_str
  let v_len = string_length_bytes cert_str
  let host_len = string_length_bytes host_str
  let got = cv_dns_match cert 0 v_len host host_len
  let _ = print (join "" [
    "  ", label, ": cert=\"", cert_str, "\" host=\"", host_str,
    "\" got=", show got, " expected=", show expected,
    (if got == expected then " OK" else " MISMATCH")])
  if got == expected then 0 else 1

main =
  let _ = print "cv_dns_match — wildcard vs exact-equality regression:"
  let f1 = case_run "case1 wildcard-diff-len" "*.example.com" "foo.example.com" 1
  let f2 = case_run "case2 wildcard-EQ-len  " "*.co.uk"       "x.co.uk"          1
  let f3 = case_run "case3 no-label         " "*.example.com" "example.com"      0
  let f4 = case_run "case4 exact-no-wild    " "example.com"   "example.com"      1
  let fails = f1 + f2 + f3 + f4
  if fails == 0 then
    let _ = print "PASS"
    0
  else
    let _ = print (join "" ["FAIL - ", show fails, " case(s) wrong"])
    1
