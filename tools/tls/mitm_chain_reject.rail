-- MITM regression — feed a self-signed leaf cert (CN=api.anthropic.com,
-- issuer=CN=api.anthropic.com, no root in the trust store) through
-- cc_walk_chain and confirm the walk rejects it with 0. If this
-- probe starts returning 1, the chain walker has regressed and is
-- accepting untrusted leaves.
import "stdlib/https_strict.rail"

-- DER bytes of a self-signed ECDSA-P256 cert for api.anthropic.com
-- generated offline. Nothing in /etc/ssl/cert.pem signs or matches
-- it, so cc_walk_chain must fail.
mitm_hex _ = ""

main =
  let cert = hex_to_bytes (mitm_hex 0)
  let cert_len = arr_len cert
  let _ = print (join "" ["self-signed cert bytes=", show cert_len])
  let store = pem_load_trust_store "/etc/ssl/cert.pem"
  if arr_get store 3 == 0 then let _ = print "FAIL: trust store load failed" in 1
  else
    let certs = arr_new 1 0
    let lens = arr_new 1 0
    let _ = arr_set certs 0 cert
    let _ = arr_set lens 0 cert_len
    let ok = cc_walk_chain store certs lens 1
    let _ = print (join "" ["cc_walk_chain returned ", show ok])
    if ok == 0 then
      let _ = print "PASS: self-signed leaf rejected"
      0
    else
      let _ = print "FAIL: self-signed leaf ACCEPTED (MITM regression)"
      1
