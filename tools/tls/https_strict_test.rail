-- https_strict_test — full pure-Rail HTTPS with chain walk to the
-- macOS system trust store. If this passes, strict-by-default
-- authenticated TLS is live.

import "stdlib/https_strict.rail"

main =
  let url = "https://www.amazon.com/"
  let _ = print (join "" ["GET (strict) ", url])
  let r = https_get_url_strict url
  let s = let (a, _) = r in a
  let body = let (_, b) = r in b
  let _ = print (join "" ["  status = ", show s])
  let _ = print (join "" ["  body (first 120) = ", if length body > 120 then str_sub body 0 120 else body])
  if s >= 100 then
    let _ = print "PASS — full chain to root validated"
    0
  else
    let _ = print "FAIL"
    1
