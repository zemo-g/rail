-- tools/tls/https_session_test.rail — live smoke for keep-alive sessions.
--
-- Opens one TLS 1.3 session against amazon.com (same endpoint the strict
-- path is validated against in v3.2.0), issues THREE GET requests on the
-- same socket, and reports the status code + fd of each. Passes if:
--   • session open succeeds (chain walk to DigiCert root)
--   • all 3 GETs return a status code
--   • fd is identical across all 3 requests (proves socket reuse)

import "stdlib/https_session.rail"

main =
  let host = "www.amazon.com"
  let port = 443
  let ip = dns_resolve_a host
  if length ip == 0 then
    let _ = print (join "" ["DNS resolve failed for ", host])
    1
  else
    let _ = print (join "" ["Resolved ", host, " → ", ip])
    let sess = https_session_open_strict host ip port
    if hs_valid sess == 0 then
      let _ = print (join "" ["Session open failed: ", hs_err sess])
      2
    else
      let fd0 = hs_fd sess
      let _ = print (join "" ["Session open: OK (chain validated, CF pre-wrapped, fd=", show fd0, ")"])
      let r1 = https_session_get sess "/"
      let (s1, b1, sess1) = r1
      let _ = print (join "" ["Request #1: status=", show s1, " body_len=", show (length b1), " fd=", show (hs_fd sess1)])
      let r2 = https_session_get sess1 "/robots.txt"
      let (s2, b2, sess2) = r2
      let _ = print (join "" ["Request #2: status=", show s2, " body_len=", show (length b2), " fd=", show (hs_fd sess2)])
      let r3 = https_session_get sess2 "/gp/help/customer/display.html"
      let (s3, b3, sess3) = r3
      let _ = print (join "" ["Request #3: status=", show s3, " body_len=", show (length b3), " fd=", show (hs_fd sess3)])
      let _ = https_session_close sess3
      let all_ok = if s1 > 0 then (if s2 > 0 then (if s3 > 0 then 1 else 0) else 0) else 0
      let fd_same = if hs_fd sess1 == fd0 then (if hs_fd sess2 == fd0 then (if hs_fd sess3 == fd0 then 1 else 0) else 0) else 0
      if all_ok == 1 then
        if fd_same == 1 then
          let _ = print "Keep-alive: PASS (3/3 requests, one socket)"
          0
        else
          let _ = print "Keep-alive: FAIL (fd changed across requests)"
          3
      else
        let _ = print "Keep-alive: FAIL (one or more requests did not return status)"
        4
