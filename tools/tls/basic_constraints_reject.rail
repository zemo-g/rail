-- BasicConstraints regression — feed a forged chain [leaf, signer] where
-- `signer` is a legitimately-CA-signed END-ENTITY cert (BasicConstraints
-- cA=FALSE) that the attacker used to sign a leaf claiming
-- SAN=api.anthropic.com. `signer` chains to a root we control (bc_root.pem),
-- so WITHOUT a basicConstraints check the walk terminates at that root and
-- returns 1 (universal MITM: any DV cert becomes a signing CA). WITH the
-- check, cc_try_inter must reject `signer` as a non-CA issuer and return 0.
--
-- Fixtures generated offline (tools/tls/fixtures/): bc_root.pem is a
-- self-signed CA (cA=TRUE); signer M (CA:FALSE) is issued by it; forged
-- leaf L (SAN=api.anthropic.com) is signed by M's key.
import "stdlib/https_strict.rail"

-- Forged leaf: CN/SAN=api.anthropic.com, issuer=attacker-controlled.example
leaf_hex _ = ""

-- Signer M: end-entity (CA:FALSE), Subject=attacker-controlled.example,
-- issued by Test Root CA BC (present in bc_root.pem).
signer_hex _ = ""

main =
  let leaf = hex_to_bytes (leaf_hex 0)
  let signer = hex_to_bytes (signer_hex 0)
  let store = pem_load_trust_store "tools/tls/fixtures/bc_root.pem"
  if arr_get store 3 == 0 then let _ = print "FAIL: trust store load failed" in 1
  else
    let certs = arr_new 2 0
    let lens = arr_new 2 0
    let _ = arr_set certs 0 leaf
    let _ = arr_set lens 0 (arr_len leaf)
    let _ = arr_set certs 1 signer
    let _ = arr_set lens 1 (arr_len signer)
    let ok = cc_walk_chain store certs lens 2
    let _ = print (join "" ["cc_walk_chain returned ", show ok])
    if ok == 0 then
      let _ = print "PASS: non-CA signer rejected (basicConstraints enforced)"
      0
    else
      let _ = print "FAIL: non-CA cert accepted as signing CA (MITM regression)"
      1
