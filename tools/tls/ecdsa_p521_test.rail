-- ECDSA-P521-SHA512 known-good vector. Generated from openssl with a
-- fresh key pair signing "hello p521 from rail\n"; the message hash,
-- signature (parsed from the DER SEQUENCE { r INTEGER, s INTEGER })
-- and public key are captured below. The hash is SHA-512 (64 bytes);
-- we left-pad two zero bytes so bn_from_be reads it as a 66-byte
-- big-endian P-521 integer.
--
-- Also runs two negative-control flips to make sure a bad signature
-- is actually rejected.
import "stdlib/hmac.rail"
import "stdlib/rsa_pss.rail"
import "stdlib/ecdsa_p521.rail"

p521_tweak_first_byte b =
  let c = arr_new 66 0
  let _ = sha_copy_bytes b c 0 0 66
  let _ = arr_set c 65 (bit_and (arr_get c 65 + 1) 255)
  c

main =
  let qx = hex_to_bytes "01c9a23a690cbad5fc3b4e15ec1955f203b3ac2be42ea6464294b3afbd5e92692d0e8bf5d7900dbc4958ea56518f8e2e25a7d11509cc71c9b5a524d748223f1f7764"
  let qy = hex_to_bytes "01a0c36afb18704db802d08e3d398a4565a319e32f18f0a47ee70a7baf431492fa543df247ee80cbe02f70a2674747d9f8d73336c5d1fc4e5ecc3926cb37dbc13185"
  let h = hex_to_bytes "0000264789ef58a99caba0e7c8788fdeaaf9d09ab00140af2b319ed23de784ecc9624ffe553b9ee7a99d4d3c816b3c6e697eae8415dfd7d7ccb2bd3d65c9a5bf7465"
  let r = hex_to_bytes "019c036315da600073949192330e8d3e912c8d8c47fb110e7fe78c64c597fd0230f5ece0f3e6b74194848eef64c3470617d70e07f736f50495151643db7d796a7c8f"
  let s = hex_to_bytes "011eb2d4c6015c960e97f7291fdebf7b5bd1050ba2d905877b5263ca6545b31db1d63b309a89604d6e31fe1c843e47df3f44a23dbbc3f420d4054519bbe88a4fa81f"
  let _ = print "ECDSA-P521-SHA512 verify:"
  let ok = ecdsa_p521_verify qx qy h r s
  let _ = print (join "" ["  valid     = ", show ok])
  let h_bad = p521_tweak_first_byte h
  let ok_h = ecdsa_p521_verify qx qy h_bad r s
  let _ = print (join "" ["  bad_hash  = ", show ok_h])
  let s_bad = p521_tweak_first_byte s
  let ok_s = ecdsa_p521_verify qx qy h r s_bad
  let _ = print (join "" ["  bad_s     = ", show ok_s])
  if ok == 1 then
    if ok_h == 0 then
      if ok_s == 0 then
        let _ = print "PASS"
        0
      else
        let _ = print "FAIL: bad-s accepted"
        3
    else
      let _ = print "FAIL: bad-hash accepted"
      2
  else
    let _ = print "FAIL: good signature rejected"
    1
