-- probe_verify.rail — Step 2a anchor for grammar-walked sampling.
--
-- Smallest possible test of the "compiler-as-verifier" lever:
-- given a partial Rail prefix, append a closing sentinel, and ask
-- the actual compiler whether the result parses cleanly. Returns
-- 1 (good) or 0 (bad).
--
-- Standalone: doesn't touch the inference loop. If this works on
-- hand-picked good/bad cases, step 2b earns the right to wire it
-- into lm_infer_cpu.rail. If it doesn't, no inference path was
-- modified and nothing is lost.

verify_prefix prefix =
  let suffix = "\nmain =\n  0\n"
  let candidate = cat [prefix, suffix]
  let _ = write_file "/tmp/probe_candidate.rail" candidate
  let out = shell "./rail_native /tmp/probe_candidate.rail >/dev/null 2>&1 && echo 1 || echo 0"
  let first = str_sub out 0 1
  if first == "1" then 1 else 0

run_case name prefix expected =
  let got = verify_prefix prefix
  let pass = if got == expected then "PASS" else "FAIL"
  let _ = print (cat [pass, "  ", name, "  expected=", show expected, " got=", show got])
  if got == expected then 1 else 0

main =
  let _ = print "probe_verify — step 2a sanity"
  let r1 = run_case "valid_complete_helper" "add a b = a + b" 1
  let r2 = run_case "valid_arith_helper" "double x = x * 2" 1
  let r3 = run_case "incomplete_expression" "add a b = a +" 0
  let r4 = run_case "gibberish" "xxxnotvalidatall" 0
  let r5 = run_case "empty_prefix" "" 1
  let r6 = run_case "valid_recursive_helper" "fact n = if n <= 1 then 1 else n * fact (n - 1)" 1
  let total = r1 + r2 + r3 + r4 + r5 + r6
  let _ = print (cat ["score: ", show total, "/6"])
  0
