-- matmul_timer.rail — minimal isolation bench for the Spur-pace regression.
--
-- Times N back-to-back tgl_matmul_f64 calls at v54-shape (m=1024, k=256,
-- n=256) and writes per-call wall-clock to /tmp/matmul_timer.log. Skips
-- ALL the trainer surface (sampling, embedding, attention, optimizer,
-- ckpt) so we can see whether the foreign matmul itself is slow or
-- whether the Rail loop layer around it is.
--
-- Output one line per call: "i=N t=<epoch.ns>"
-- Plus one summary line at the end with mean/min/max if we feel fancy.

import "stdlib/tensor.rail"

foreign getpid u -> int

cat parts = join "" parts

-- Allocate a float_arr of `n` elements seeded with a deterministic-ish
-- pattern. Real values don't matter for timing; we just need pages
-- touched.
fill_arr arr n =
  fill_loop arr 0 n
fill_loop arr i n =
  if i >= n then 0
  else
    let _ = float_arr_set arr i (int_to_float ((i * 7919) % 100))
    fill_loop arr (i + 1) n

-- Per-iteration: write a "i=N t=..." line to disk. Each shell echo flushes,
-- so we get real-time per-call latency in the log.
log_step i log_path =
  let cmd = cat ["echo \"i=", show i, " t=$(date +%s.%N)\" >> ", log_path]
  let _ = shell cmd
  0

run_loop a b c m k n iters i log_path =
  if i >= iters then 0
  else
    let _ = tgl_matmul_f64 a b c m k n
    let _ = log_step i log_path
    run_loop a b c m k n iters (i + 1) log_path

main =
  let log_path = "/tmp/matmul_timer.log"
  let _ = shell (cat ["echo '' > ", log_path])

  let m = 1024
  let k = 256
  let n = 256
  let iters = 100

  let _ = print (cat ["matmul_timer: m=", show m, " k=", show k, " n=", show n, " iters=", show iters])

  -- Allocate input/output buffers (raw float_arrs; tgl_matmul_f64 takes the
  -- raw pointer past the Rail count header).
  let a = float_arr_new (m * k) 0.0
  let b = float_arr_new (k * n) 0.0
  let c = float_arr_new (m * n) 0.0

  let _ = fill_arr a (m * k)
  let _ = fill_arr b (k * n)

  let _ = print "buffers filled, calling tgl_init..."
  let _ = tgl_init 0
  let _ = print "tgl_init done"

  let _ = log_step 0 log_path
  let _ = run_loop a b c m k n iters 0 log_path

  let _ = print "done. summary in /tmp/matmul_timer.log"
  0
