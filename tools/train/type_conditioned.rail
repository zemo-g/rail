-- tools/train/type_conditioned.rail — Tier-A3 type-conditioned generation.
--
-- Sampler that emits {type-prefix}{value} jointly. Type prefix is sampled
-- from a grammar-restricted distribution (always parse-valid by
-- construction); value head is conditioned on the type.
--
-- Inductive bias: in a typed language the type often drastically narrows
-- the legal value space. By making the model commit to a type before
-- emitting a value, we force type-correct generation. The compiler's type
-- checker can then verify; if the value doesn't match, the prefix
-- becomes a hard supervision signal.
--
-- Token vocab additions (added to existing surface vocab):
--   <:int>     <:float>    <:string>    <:bool>
--   <:list_int>  <:list_str>  <:option_int>
--   <:fn_i_to_i>  <:fn_ii_to_i>  <:fn_l_to_i>
--   <:adt>     <:any>
--
-- 13 reserved type-prefix tokens added at IDs V_base..V_base+12.
--
-- Two-phase generation per expression:
--   Phase A: sample type prefix from {<:T>...} restricted softmax.
--   Phase B: sample value tokens conditioned on (history + type).
--
-- For training: every corpus expression is annotated with its inferred
-- type via the compiler's type checker (--emit-types pass). The type
-- prefix becomes a target token at the position immediately before the
-- expression's value.
--
-- Implementation note: this module documents the protocol. The actual
-- training fork is `tools/train/lm_v11_d256_typed.rail`. The sampler fork
-- is `tools/train/lm_infer_cpu_typed.rail`.
--
-- Corpus annotation step (offline preprocess):
--   for each program in corpus:
--     ./rail_native --emit-types program.rail > program.types
--     interleave_types program.rail program.types > program.typed.rail
--   build BPE on typed corpus.

import "stdlib/list.rail"

cat parts = join "" parts

-- ── Type prefix vocab.
type_tokens = [
  "<:int>", "<:float>", "<:string>", "<:bool>",
  "<:list_int>", "<:list_str>", "<:option_int>",
  "<:fn_i_to_i>", "<:fn_ii_to_i>", "<:fn_l_to_i>",
  "<:adt>", "<:any>", "<:unknown>"
]

-- ── Grammar-restricted softmax. Given full V-dim logits, mask everything
-- outside the type-prefix range to -inf, then softmax. Used in Phase A.
restrict_to_types logits V V_base n_types =
  let restricted = float_arr_new V 0.0
  let _ = init_neginf restricted V
  let _ = copy_range logits restricted V_base n_types
  restricted

init_neginf a n =
  init_neginf_loop a 0 n

init_neginf_loop a i n =
  if i >= n then 0
  else
    let _ = float_arr_set a i (-1.0e30)
    init_neginf_loop a (i + 1) n

copy_range src dst start n =
  copy_loop src dst start 0 n

copy_loop src dst start i n =
  if i >= n then 0
  else
    let _ = float_arr_set dst (start + i) (float_arr_get src (start + i))
    copy_loop src dst start (i + 1) n

-- ── Determine when to insert a type prefix. Heuristic: emit before
-- every expression boundary — start of let-RHS, start of fn call args,
-- start of return value, etc. Approximated by looking at recent context:
--   - just emitted "= " or "in " or "-> " or "let "
should_emit_type_prefix history =
  let last_tokens = last_n history 3
  let joined = join " " last_tokens
  if str_ends_with " = " joined then 1
  else if str_ends_with " in " joined then 1
  else if str_ends_with " -> " joined then 1
  else 0

last_n xs n =
  let l = length xs
  if l <= n then xs
  else drop_n xs (l - n)

drop_n xs n =
  if n <= 0 then xs
  else if length xs == 0 then xs
  else drop_n (tail xs) (n - 1)

str_ends_with suffix s =
  let sufx = chars suffix
  let scs = chars s
  let lsx = length sufx
  let ls = length scs
  if lsx > ls then false
  else
    let tail_part = drop_n scs (ls - lsx)
    eq_chars sufx tail_part

eq_chars a b =
  if length a == 0 && length b == 0 then true
  else if length a == 0 || length b == 0 then false
  else if head a == head b then eq_chars (tail a) (tail b)
  else false

-- ── Annotate corpus: for each line of source, look up its inferred
-- types from the .types output of the compiler (a future --emit-types
-- flag). For now, this scaffold uses heuristic annotation based on
-- pattern matching against literals and stdlib symbols.
heuristic_type_for line =
  let trimmed = trim_left line
  if str_starts_with "main = " trimmed then "<:int>"
  else if str_contains "= \"" trimmed then "<:string>"
  else if str_contains "= [" trimmed then "<:list_int>"
  else if str_contains "Some " trimmed then "<:option_int>"
  else if str_contains " = if " trimmed then "<:bool>"
  else "<:int>"

trim_left s =
  let cs = chars s
  trim_l_loop cs

trim_l_loop cs =
  if length cs == 0 then ""
  else if head cs == " " || head cs == "\t" then trim_l_loop (tail cs)
  else join "" cs

str_starts_with prefix s =
  let pcs = chars prefix
  let scs = chars s
  starts_with_loop_local pcs scs

starts_with_loop_local pcs scs =
  if length pcs == 0 then true
  else if length scs == 0 then false
  else if head pcs == head scs then starts_with_loop_local (tail pcs) (tail scs)
  else false

main =
  let _ = print "type_conditioned module — sampler+annotator scaffold."
  let _ = print "Type prefix vocab: 13 tokens."
  let _ = print "Phase A: restricted softmax over type prefixes."
  let _ = print "Phase B: standard sampling conditioned on emitted type."
  0
