-- tools/train/gated_min_ckpt.rail — Tier-C3 verifier-gated min-checkpoint.
--
-- Drop-in module for trainers. Replaces the standard "save when val_loss
-- hits new low" min-ckpt with a stricter gate: save only when BOTH
--   1. val_loss improves over previous best
--   2. held-out compile rate (50 prompts disjoint from bench) does NOT
--      regress from previous saved ckpt
--
-- Held-out prompts live at training/prompts/heldout_50.txt — one per line,
-- format: <prompt-text>|<optional-expected-stdout>
--
-- Per `val_loss_underread.md`: val_loss alone misses rerank-implicit
-- output narrowing; the held-out gate is the second signal that catches
-- collapse-then-fluke regressions.
--
-- Compatible with EMA shadow weights (Tier-C3 second half): if EMA is
-- active, the gate evaluates EMA weights, not the raw weights.
--
-- Usage from trainer:
--   import "tools/train/gated_min_ckpt.rail"
--
--   -- once at start of training:
--   let gate_state = init_gate "training/prompts/heldout_50.txt"
--
--   -- inside training loop, every K=500 steps:
--   let gate_state = maybe_save_gated gate_state val_loss step ckpt_prefix
--                                     blocks w_e gf adams_blocks adams_e adams_gf

import "stdlib/list.rail"
import "stdlib/checkpoint.rail"

cat parts = join "" parts

-- ── Gate state: float_arr of [best_val_loss, last_compile_rate, last_step].
init_gate heldout_path =
  let state = float_arr_new 4 1.0e30  -- best_val_loss sentinel = +inf
  let _ = float_arr_set state 1 0.0   -- last_compile_rate
  let _ = float_arr_set state 2 0.0   -- last_step
  let _ = float_arr_set state 3 0.0   -- save_count
  state

-- ── Run held-out compile-rate check by spawning N inference subprocesses
-- against the LATEST checkpoint, grading each, returning pass count.
heldout_compile_rate ckpt_prefix heldout_path n_prompts max_gen =
  -- For overnight scope: spawn one inference per prompt at temp=0.8 k=10
  -- via parallel_rerank.sh wrapper. Returns pass count out of n_prompts.
  let cmd = cat [
    "tools/train/heldout_check.sh ",
    " --ckpt ", ckpt_prefix,
    " --prompts ", heldout_path,
    " --n ", show n_prompts,
    " --max ", show max_gen,
    " 2>/dev/null"]
  let out = trim (shell cmd)
  let pass_str = extract_pass_count out
  parse_int pass_str

extract_pass_count out =
  let lines = split "\n" out
  extract_pass_loop (reverse lines)

extract_pass_loop ls =
  if length ls == 0 then "0"
  else
    let line = head ls
    if str_starts_with "PASS=" line then
      str_sub line 5 (length (chars line) - 5)
    else extract_pass_loop (tail ls)

trim s =
  let cs = chars s
  let stripped = trim_left_loop cs
  let r = trim_right_loop (chars stripped) []
  r

trim_left_loop cs =
  if length cs == 0 then ""
  else if head cs == " " || head cs == "\n" || head cs == "\t" then trim_left_loop (tail cs)
  else join "" cs

trim_right_loop cs acc =
  if length cs == 0 then join "" (reverse acc)
  else
    let c = head cs
    if c == " " || c == "\n" || c == "\t" then
      if length (tail cs) == 0 then join "" (reverse acc)
      else trim_right_loop (tail cs) (cons c acc)
    else trim_right_loop (tail cs) (cons c acc)

str_starts_with prefix s =
  let pcs = chars prefix
  let scs = chars s
  starts_with_loop pcs scs

starts_with_loop pcs scs =
  if length pcs == 0 then true
  else if length scs == 0 then false
  else if head pcs == head scs then starts_with_loop (tail pcs) (tail scs)
  else false

-- ── Decision: does this step warrant a save?
should_save gate_state val_loss new_compile_rate =
  let best_vl = float_arr_get gate_state 0
  let last_cr = float_arr_get gate_state 1
  let val_improved = val_loss < best_vl
  let cr_held = new_compile_rate >= last_cr
  if val_improved && cr_held then 1 else 0

-- ── The trainer-facing entry. Called periodically (every K=500 steps).
maybe_save_gated gate_state val_loss step ckpt_prefix
                  blocks w_e gf adams_blocks adams_e adams_gf =
  -- run held-out check first
  let temp_prefix = cat [ckpt_prefix, "_step", show step, "_temp"]
  -- In a real call, we'd save a temp checkpoint, run held-out, decide,
  -- and either commit (rename to final prefix) or discard. For this
  -- module skeleton, we save the temp and return the decision.
  let _ = save_checkpoint temp_prefix (cons w_e (cons gf blocks))
                          (cons adams_e (cons adams_gf adams_blocks)) step val_loss
  let n_held = 50
  let max_gen = 64
  let new_cr = heldout_compile_rate temp_prefix
                 "training/prompts/heldout_50.txt" n_held max_gen
  let new_cr_norm = (int_to_float new_cr) / (int_to_float n_held)

  let do_save = should_save gate_state val_loss new_cr_norm
  if do_save == 1 then
    -- commit: rename temp prefix to canonical, update gate state
    let canon = ckpt_prefix
    let mv_cmd = cat ["tools/train/promote_ckpt.sh ", temp_prefix, " ", canon]
    let _ = shell mv_cmd
    let _ = float_arr_set gate_state 0 val_loss
    let _ = float_arr_set gate_state 1 new_cr_norm
    let _ = float_arr_set gate_state 2 (int_to_float step)
    let cur_count = float_to_int (float_arr_get gate_state 3)
    let _ = float_arr_set gate_state 3 (int_to_float (cur_count + 1))
    let _ = print (cat [
      "  [GATE] step=", show step,
      " val_loss=", show_float val_loss,
      " compile=", show new_cr, "/", show n_held,
      "  ✓ saved (#", show (cur_count + 1), ")"])
    gate_state
  else
    let rm_cmd = cat ["rm -f ", temp_prefix, ".*"]
    let _ = shell rm_cmd
    let _ = print (cat [
      "  [GATE] step=", show step,
      " val_loss=", show_float val_loss,
      " compile=", show new_cr, "/", show n_held,
      "  ✗ rejected (val<best=", if val_loss < float_arr_get gate_state 0 then "yes" else "no",
      ", cr_held=", if new_cr_norm >= float_arr_get gate_state 1 then "yes" else "no", ")"])
    gate_state

main =
  let _ = print "gated_min_ckpt module — import only, do not run directly"
  0
