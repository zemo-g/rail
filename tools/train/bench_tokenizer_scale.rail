-- tools/train/bench_tokenizer_scale.rail — stage-test the new counted-loop
-- build_vocab across corpus sizes.
--
-- The wrapper script copies a specific-sized slice to /tmp/rail_bench_corpus.txt
-- and invokes this program under /usr/bin/time -l so peak RSS is captured
-- from the outside. This program itself records wall-clock around
-- build_vocab + encode_into_arr so we can split tokenizer time from
-- overall process time.
--
-- Usage (invoked by tools/bench/tokenizer_scale_bench.sh):
--   head -c <N> training/rail_corpus_stdlib.txt > /tmp/rail_bench_corpus.txt
--   /usr/bin/time -l ./rail_native run tools/train/bench_tokenizer_scale.rail

import "stdlib/tokenizer.rail"

bench_path = "/tmp/rail_bench_corpus.txt"

-- Millisecond wall clock via perl Time::HiRes (same pattern as
-- tools/bench/tensor_ops.rail). ~1ms shell overhead per call, negligible
-- against multi-second tokenizer walks.
now_ms _ =
  let s = shell "perl -MTime::HiRes -e 'print int(Time::HiRes::time()*1000)'"
  parse_int s

-- Parse a decimal integer string (digits only). We can't pull socket.rail
-- or bpe.rail here since tokenizer.rail must stay standalone.
bench_digit_val c =
  if c == "0" then 0
  else if c == "1" then 1
  else if c == "2" then 2
  else if c == "3" then 3
  else if c == "4" then 4
  else if c == "5" then 5
  else if c == "6" then 6
  else if c == "7" then 7
  else if c == "8" then 8
  else if c == "9" then 9
  else (0 - 1)

parse_int_acc cs acc =
  if length cs == 0 then acc
  else
    let d = bench_digit_val (head cs)
    if d < 0 then acc
    else parse_int_acc (tail cs) (acc * 10 + d)

parse_int s = parse_int_acc (chars s) 0

-- Counted-loop encode → int list. We don't need the full float_arr path
-- here; we're timing the vocab + encode hot spots, not training
-- throughput. Mirrors the O(n·V) discipline from lm_v3_chunked:enc_fast_loop.
enc_list_loop cs n i vocab acc =
  if i >= n then reverse acc
  else enc_list_loop (tail cs) n (i + 1) vocab (cons (char_id vocab (head cs)) acc)

encode_fast vocab text =
  let cs = chars text
  let n = length cs
  enc_list_loop cs n 0 vocab []

main =
  let _ = print "tokenizer_scale_bench v1"
  let text = read_file bench_path
  let n_chars = length (chars text)
  let _ = print (cat ["corpus_chars=", show n_chars])

  let t0 = now_ms 0
  let vocab = build_vocab text
  let t1 = now_ms 0
  let V = vocab_size vocab
  let _ = print (cat ["vocab_size=", show V])
  let _ = print (cat ["build_vocab_ms=", show (t1 - t0)])

  let t2 = now_ms 0
  let ids = encode_fast vocab text
  let t3 = now_ms 0
  let n_ids = length ids
  let _ = print (cat ["encoded_ids=", show n_ids])
  let _ = print (cat ["encode_ms=", show (t3 - t2)])

  let _ = print (cat ["total_tok_ms=", show ((t1 - t0) + (t3 - t2))])
  0
