-- lm_v3_chunked_jit_long.rail — Phase 2.1 of the trace+JIT plan
-- (rail-jit-fused-kernels-plan).  Forks lm_v3_chunked_bf16_full_long.rail
-- and swaps two op groups in m_block_fwd for JIT'd fused Metal kernels:
--   (a) rmsnorm + 3 matmul (Q,K,V) → jit_run_rmsnorm_qkv
--       Exports Q | K | V | R (rstd) | LN1 from one packed buffer.
--   (b) silu + hadamard            → jit_run_silu_hadamard
--       Exports h_act | sigmoid(h_gate) from one packed buffer.
-- Backward pass is unchanged — it reads rstd1, ln1, h_gate_sig from the
-- packed buffers via the cache list with the same shapes as before.
--
-- Goal: validate that per-kernel JIT wins (35× rmsnorm+QKV / 18× silu+
-- hadamard, measured at Phase 1.4) translate to per-step throughput.
-- pack2 (post-attn rmsnorm) stays unfused for this round — it's a
-- rmsnorm-only pattern, not rmsnorm+QKV.
--
import "stdlib/transformer.rail"
import "stdlib/optim.rail"
import "stdlib/tokenizer.rail"
import "stdlib/oracle.rail"
import "stdlib/jit.rail"

-- Chunk size = the seq dimension the model sees each step.
-- Must be < corpus_len so we have valid offsets to sample.
seq_len = 512

-- Where the full corpus comes from. Swap for a concatenated-stdlib file
-- once we confirm sampling works on this smaller input.
corpus_path = "stdlib/optim.rail"

init_weight arr n seed = init_w_loop arr n seed 0

init_w_loop arr n seed i =
  if i >= n then 0
  else
    let raw = ((i * 97 + seed * 13) % 100) - 50
    let _ = float_arr_set arr i (0.01 * int_to_float raw)
    init_w_loop arr n (seed + 1) (i + 1)

unwrap t = match t | Tensor d _ _ -> d

mk_tensor data shape =
  Tensor data shape (compute_strides shape)

-- Copy n floats from src starting at src_off into dst starting at 0.
block_split src src_off dst n i =
  if i >= n then 0
  else
    let _ = float_arr_set dst i (float_arr_get src (src_off + i))
    block_split src src_off dst n (i + 1)

-- Per-block JIT context.  Holds the kernel IDs (compiled once) plus
-- pre-allocated scratch + output buffers reused across training steps.
-- Layout:
--   0 = kid_qkv (int)             — pipeline ID for fused rmsnorm+QKV
--   1 = kid_silu (int)            — pipeline ID for fused silu+hadamard
--   2 = qkv_packed (float_arr)    — scratch (4*seq*d + seq) Q|K|V|R|LN1
--   3 = q (Tensor)                — backed by float_arr (seq*d)
--   4 = k (Tensor)                — backed by float_arr (seq*d)
--   5 = v (Tensor)                — backed by float_arr (seq*d)
--   6 = ln1 (Tensor)              — backed by float_arr (seq*d)
--   7 = rstd1_data (float_arr)    — raw seq floats, consumed by m_block_bwd
--   8 = h_pack (float_arr)        — scratch (2*seq*d_ff)
--   9 = h_act (Tensor)            — backed by float_arr (seq*d_ff)
--  10 = h_sig_data (float_arr)    — raw seq*d_ff floats, consumed by bwd
mk_jit_ctx seq d d_ff kid_qkv kid_silu =
  let qkv_packed = float_arr_new (4 * seq * d + seq) 0.0
  let q_data = float_arr_new (seq * d) 0.0
  let k_data = float_arr_new (seq * d) 0.0
  let v_data = float_arr_new (seq * d) 0.0
  let ln1_data = float_arr_new (seq * d) 0.0
  let rstd1_data = float_arr_new seq 0.0
  let q   = mk_tensor q_data   (cons seq (cons d []))
  let k   = mk_tensor k_data   (cons seq (cons d []))
  let v   = mk_tensor v_data   (cons seq (cons d []))
  let ln1 = mk_tensor ln1_data (cons seq (cons d []))
  let h_pack = float_arr_new (2 * seq * d_ff) 0.0
  let h_act_data = float_arr_new (seq * d_ff) 0.0
  let h_sig_data = float_arr_new (seq * d_ff) 0.0
  let h_act = mk_tensor h_act_data (cons seq (cons d_ff []))
  cons kid_qkv (cons kid_silu (cons qkv_packed (cons q (cons k (cons v (cons ln1 (cons rstd1_data (cons h_pack (cons h_act (cons h_sig_data []))))))))))

ones_loop_m arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 1.0
    ones_loop_m arr n (i + 1)

-- ── Fast corpus → float_arr of ids.
-- Counted loop avoids the O(n²) `length cs == 0` check that encode_loop
-- in stdlib/tokenizer.rail uses. At n=9250 the naïve encode is 85M ops,
-- this one is O(n * V) ≈ 740K ops.
enc_fast_loop arr cs vocab i n =
  if i >= n then 0
  else
    let c = head cs
    let id = char_id vocab c
    let _ = float_arr_set arr i (int_to_float id)
    enc_fast_loop arr (tail cs) vocab (i + 1) n

encode_into_arr arr text vocab =
  let cs = chars text
  let n = length cs
  let _ = enc_fast_loop arr cs vocab 0 n
  n

-- ── LCG rng. State = one int stored in a float_arr[1] (via int↔float
-- bit-lossless for small ints). Modulus 2^31 keeps state in int range.
lcg_state_new seed =
  let a = float_arr_new 1 0.0
  let _ = float_arr_set a 0 (int_to_float seed)
  a

lcg_next state =
  let s = float_to_int (float_arr_get state 0)
  let new_s = (s * 1664525 + 1013904223) % 2147483648
  let _ = float_arr_set state 0 (int_to_float new_s)
  new_s

-- ── Zero a range of a float_arr before we refill it.
zero_range arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 0.0
    zero_range arr n (i + 1)

-- ── Fill x (shape [seq, V]) with one-hot vectors for ids_arr[offset..
-- offset+seq-1], and labels (shape [seq]) with ids_arr[offset+1..
-- offset+seq]. x is zeroed first because the previous step's one-hots
-- sit in the same scratch.
fill_onehot_arr dst ids_arr V seq offset i =
  if i >= seq then 0
  else
    let c = float_to_int (float_arr_get ids_arr (offset + i))
    let _ = float_arr_set dst (i * V + c) 1.0
    fill_onehot_arr dst ids_arr V seq offset (i + 1)

fill_labels_arr arr ids_arr seq offset i =
  if i >= seq then 0
  else
    let id = float_arr_get ids_arr (offset + i + 1)
    let _ = float_arr_set arr i id
    fill_labels_arr arr ids_arr seq offset (i + 1)

-- Given batch_ctx, sample a fresh chunk in place into x_data and labels_data.
-- batch_ctx layout: [x, labels, ids_arr, rng, corpus_len]
sample_chunk batch_ctx V seq =
  let x = list_nth 0 batch_ctx
  let labels = list_nth 1 batch_ctx
  let ids_arr = list_nth 2 batch_ctx
  let rng = list_nth 3 batch_ctx
  let corpus_len = list_nth 4 batch_ctx
  let r = lcg_next rng
  -- Ensure offset + seq + 1 <= corpus_len (need labels[seq-1] = ids[offset+seq])
  let max_off = corpus_len - seq - 1
  let offset = r % max_off
  match x | Tensor xd _ _ ->
    match labels | Tensor ld _ _ ->
      let _ = zero_range xd (seq * V) 0
      let _ = fill_onehot_arr xd ids_arr V seq offset 0
      let _ = fill_labels_arr ld ids_arr seq offset 0
      offset

-- ── Standard cross-entropy + grad (identical to lm_v3_multi).
m_ce_loss_loop pd ld seq V acc i =
  if i >= seq then 0
  else
    let target = float_to_int (float_arr_get ld i)
    let p = float_arr_get pd (i * V + target)
    let p2 = if p < 0.00000001 then 0.00000001 else p
    let cur = float_arr_get acc 0
    let _ = float_arr_set acc 0 (cur - log p2)
    m_ce_loss_loop pd ld seq V acc (i + 1)

m_ce_loss probs labels seq V = match probs
  | Tensor pd _ _ -> match labels
    | Tensor ld _ _ ->
      let acc = float_arr_new 1 0.0
      let _ = m_ce_loss_loop pd ld seq V acc 0
      (float_arr_get acc 0) / int_to_float seq

m_ce_grad_loop dst probs labels seq V invN i =
  if i >= seq * V then 0
  else
    let row = i / V
    let col = i % V
    let target = float_to_int (float_arr_get labels row)
    let p = float_arr_get probs i
    let g = if col == target then (p - 1.0) * invN else p * invN
    let _ = float_arr_set dst i g
    m_ce_grad_loop dst probs labels seq V invN (i + 1)

m_hadamard_loop ad bd cd n i =
  if i >= n then 0
  else
    let a = float_arr_get ad i
    let b = float_arr_get bd i
    let _ = float_arr_set cd i (a * b)
    m_hadamard_loop ad bd cd n (i + 1)

m_hadamard a b = match a
  | Tensor ad a_shape _ -> match b
    | Tensor bd _ _ ->
      let n = list_product a_shape
      let cd = float_arr_new n 0.0
      let _ = m_hadamard_loop ad bd cd n 0
      Tensor cd a_shape (compute_strides a_shape)

-- ── Block forward.  Two op groups fused via JIT'd Metal kernels:
--   (a) rmsnorm+QKV: 4 dispatches → 1.  Outputs Q,K,V,rstd1,ln1.
--   (b) silu+hadamard: 2 CPU loops + 1 GPU dispatch → 1 GPU dispatch.
-- Backward sees the same cache layout as the unfused baseline.
m_block_fwd x w_block jit_ctx seq d =
  let w_q = list_nth 0 w_block
  let w_k = list_nth 1 w_block
  let w_v = list_nth 2 w_block
  let w_o = list_nth 3 w_block
  let w_gate = list_nth 4 w_block
  let w_up = list_nth 5 w_block
  let w_down = list_nth 6 w_block
  let g1 = list_nth 7 w_block
  let g2 = list_nth 8 w_block

  -- FUSED rmsnorm + QKV  (4 GPU dispatches → 1)
  let kid_qkv    = list_nth 0 jit_ctx
  let qkv_packed = list_nth 2 jit_ctx
  let q          = list_nth 3 jit_ctx
  let k          = list_nth 4 jit_ctx
  let v          = list_nth 5 jit_ctx
  let ln1        = list_nth 6 jit_ctx
  let rstd1      = list_nth 7 jit_ctx
  let _ = jit_run_rmsnorm_qkv kid_qkv (unwrap x) (unwrap g1) (unwrap w_q) (unwrap w_k) (unwrap w_v) qkv_packed seq d
  let total = seq * d
  let _ = block_split qkv_packed 0               (unwrap q)   total 0
  let _ = block_split qkv_packed total           (unwrap k)   total 0
  let _ = block_split qkv_packed (2 * total)     (unwrap v)   total 0
  let _ = block_split qkv_packed (3 * total)     rstd1        seq   0
  let _ = block_split qkv_packed (3 * total + seq) (unwrap ln1) total 0

  let _ = rope_apply q
  let _ = rope_apply k

  let kt = tensor_transpose k
  let scores = matmul_bf16 q kt
  let scale = 1.0 / sqrt (int_to_float d)
  let scaled = tensor_scale scores scale
  let sd = unwrap scaled
  let _ = apply_causal_mask_loop sd seq 0 0
  let attn = tensor_softmax scaled
  let attn_val = matmul_bf16 attn v
  let attn_out = matmul_bf16 attn_val w_o
  let x_attn = tensor_add x attn_out

  -- pack2 stays UNFUSED — rmsnorm-only pattern, no QKV trailing.
  let pack2 = rmsnorm_save x_attn g2
  let ln2 = head pack2
  let rstd2 = head (tail pack2)

  let h_gate = matmul_bf16 ln2 w_gate
  let h_up = matmul_bf16 ln2 w_up

  -- FUSED silu + hadamard  (2 CPU loops → 1 GPU dispatch)
  let kid_silu   = list_nth 1 jit_ctx
  let h_pack     = list_nth 8 jit_ctx
  let h_act      = list_nth 9 jit_ctx
  let h_gate_sig = list_nth 10 jit_ctx
  let hN = seq * (3 * d)
  let _ = jit_run_silu_hadamard kid_silu (unwrap h_gate) (unwrap h_up) h_pack hN
  let _ = block_split h_pack 0  (unwrap h_act) hN 0
  let _ = block_split h_pack hN h_gate_sig     hN 0

  let h_out = matmul_bf16 h_act w_down
  let x_out = tensor_add x_attn h_out

  let r0 = cons rstd2 []
  let r1 = cons rstd1 r0
  let r2 = cons h_act r1
  let r3 = cons h_gate_sig r2
  let r4 = cons h_up r3
  let r5 = cons h_gate r4
  let r6 = cons ln2 r5
  let r7 = cons x_attn r6
  let r8 = cons attn_val r7
  let r9 = cons attn r8
  let r10 = cons v r9
  let r11 = cons k r10
  let r12 = cons q r11
  let r13 = cons ln1 r12
  let r14 = cons x r13
  cons x_out r14

m_block_bwd dx_out cache w_block seq d =
  let x_in = list_nth 1 cache
  let ln1 = list_nth 2 cache
  let q = list_nth 3 cache
  let k = list_nth 4 cache
  let v = list_nth 5 cache
  let attn = list_nth 6 cache
  let attn_val = list_nth 7 cache
  let x_attn = list_nth 8 cache
  let ln2 = list_nth 9 cache
  let h_gate = list_nth 10 cache
  let h_up = list_nth 11 cache
  let h_gate_sig = list_nth 12 cache
  let h_act = list_nth 13 cache
  let rstd1 = list_nth 14 cache
  let rstd2 = list_nth 15 cache
  let w_q = list_nth 0 w_block
  let w_k = list_nth 1 w_block
  let w_v = list_nth 2 w_block
  let w_o = list_nth 3 w_block
  let w_gate = list_nth 4 w_block
  let w_up = list_nth 5 w_block
  let w_down = list_nth 6 w_block
  let g1 = list_nth 7 w_block
  let g2 = list_nth 8 w_block

  let dffn_out = dx_out
  let hact_T = tensor_transpose h_act
  -- grad-weight: stays f64 (fp16 lost convergence at 50 steps)
  let d_wdown = matmul_bf16 hact_T dffn_out
  let wdown_T = tensor_transpose w_down
  -- grad-input: kept f64 after 500-step run showed cumulative divergence
  let dh_act = matmul_bf16 dffn_out wdown_T
  let hg_d = unwrap h_gate
  let d_ff = 3 * d
  let hg_n = seq * d_ff
  let h_gate_silu_d = float_arr_new hg_n 0.0
  let _ = m_hadamard_loop hg_d h_gate_sig h_gate_silu_d hg_n 0
  let h_gate_silu = Tensor h_gate_silu_d (cons seq (cons d_ff [])) (compute_strides (cons seq (cons d_ff [])))
  let dh_up = m_hadamard dh_act h_gate_silu
  let dh_silu = m_hadamard dh_act h_up
  let dh_gate = silu_backward h_gate dh_silu h_gate_sig
  let ln2_T = tensor_transpose ln2
  -- grad-weight: stays f64
  let d_wgate = matmul_bf16 ln2_T dh_gate
  let d_wup = matmul_bf16 ln2_T dh_up
  let wgate_T = tensor_transpose w_gate
  let wup_T = tensor_transpose w_up
  let d_ln2_gate = matmul_bf16 dh_gate wgate_T
  let d_ln2_up = matmul_bf16 dh_up wup_T
  let d_ln2_out = tensor_add d_ln2_gate d_ln2_up

  let d_x_attn_ln = rmsnorm_backward_dx x_attn g2 rstd2 d_ln2_out
  let d_g2 = rmsnorm_backward_gamma x_attn rstd2 d_ln2_out
  let dx_attn = tensor_add dx_out d_x_attn_ln

  let dattn_out = dx_attn
  let attn_val_T = tensor_transpose attn_val
  -- grad-weight: stays f64
  let d_wo = matmul_bf16 attn_val_T dattn_out
  let wo_T = tensor_transpose w_o
  let d_attn_val = matmul_bf16 dattn_out wo_T
  let (d_q_rot, d_k_rot, d_v_proj) = attention_backward q k v attn d_attn_val
  let _ = rope_apply_inverse d_q_rot
  let _ = rope_apply_inverse d_k_rot

  let ln1_T = tensor_transpose ln1
  -- grad-weight: stays f64
  let d_wq = matmul_bf16 ln1_T d_q_rot
  let d_wk = matmul_bf16 ln1_T d_k_rot
  let d_wv = matmul_bf16 ln1_T d_v_proj
  let wq_T = tensor_transpose w_q
  let wk_T = tensor_transpose w_k
  let wv_T = tensor_transpose w_v
  let dx_q = matmul_bf16 d_q_rot wq_T
  let dx_k = matmul_bf16 d_k_rot wk_T
  let dx_v = matmul_bf16 d_v_proj wv_T
  let dx_qk = tensor_add dx_q dx_k
  let d_ln1_out = tensor_add dx_qk dx_v

  let d_x_in_ln = rmsnorm_backward_dx x_in g1 rstd1 d_ln1_out
  let d_g1 = rmsnorm_backward_gamma x_in rstd1 d_ln1_out
  let dx_in = tensor_add dx_attn d_x_in_ln

  let g0 = cons d_g2 []
  let gA = cons d_g1 g0
  let gB = cons d_wdown gA
  let g1g = cons d_wup gB
  let g2g = cons d_wgate g1g
  let g3g = cons d_wo g2g
  let g4g = cons d_wv g3g
  let g5g = cons d_wk g4g
  let g6g = cons d_wq g5g
  cons dx_in g6g

m_forward x w_e blocks block_jits gf seq V d =
  let x_embed = matmul x w_e

  let b0_weights = list_nth 0 blocks
  let b0_jit = list_nth 0 block_jits
  let cache0 = m_block_fwd x_embed b0_weights b0_jit seq d
  let x_after_b0 = head cache0

  let b1_weights = list_nth 1 blocks
  let b1_jit = list_nth 1 block_jits
  let cache1 = m_block_fwd x_after_b0 b1_weights b1_jit seq d
  let x_after_b1 = head cache1

  let packf = rmsnorm_save x_after_b1 gf
  let x_final = head packf
  let rstd_final = head (tail packf)

  let we_t = tensor_transpose w_e
  let logits = matmul x_final we_t
  let probs = tensor_softmax logits

  let r0 = cons x_embed []
  let r1 = cons cache0 r0
  let r2 = cons cache1 r1
  let r3 = cons rstd_final r2
  let r4 = cons x_final r3
  cons probs r4

m_train_step x labels blocks block_jits w_e gf adams_e adams_gf adams_blocks seq V d dlog_buf lr =
  let result = m_forward x w_e blocks block_jits gf seq V d
  let probs = list_nth 0 result
  let x_final = list_nth 1 result
  let rstd_final = list_nth 2 result
  let cache1 = list_nth 3 result
  let cache0 = list_nth 4 result
  let x_embed = list_nth 5 result
  let x_after_b0 = head cache0

  let loss = m_ce_loss probs labels seq V

  match probs | Tensor pd _ _ -> match labels | Tensor ld _ _ ->
    let invN = 1.0 / int_to_float seq
    let _ = m_ce_grad_loop dlog_buf pd ld seq V invN 0
    let dlog_t = Tensor dlog_buf (cons seq (cons V [])) (compute_strides (cons seq (cons V [])))

    let dx_final_head = matmul dlog_t w_e
    let dlog_T = tensor_transpose dlog_t
    let d_we_head = matmul dlog_T x_final

    let x_block_final = list_nth 0 cache1
    let dx_block_final = rmsnorm_backward_dx x_block_final gf rstd_final dx_final_head
    let d_gf = rmsnorm_backward_gamma x_block_final rstd_final dx_final_head

    let b1_weights = list_nth 1 blocks
    let grads1 = m_block_bwd dx_block_final cache1 b1_weights seq d
    let dx_after_b0 = list_nth 0 grads1
    let d_wq1 = list_nth 1 grads1
    let d_wk1 = list_nth 2 grads1
    let d_wv1 = list_nth 3 grads1
    let d_wo1 = list_nth 4 grads1
    let d_wgate1 = list_nth 5 grads1
    let d_wup1 = list_nth 6 grads1
    let d_wdown1 = list_nth 7 grads1
    let d_g1_b1 = list_nth 8 grads1
    let d_g2_b1 = list_nth 9 grads1

    let b0_weights = list_nth 0 blocks
    let grads0 = m_block_bwd dx_after_b0 cache0 b0_weights seq d
    let dx_embed = list_nth 0 grads0
    let d_wq0 = list_nth 1 grads0
    let d_wk0 = list_nth 2 grads0
    let d_wv0 = list_nth 3 grads0
    let d_wo0 = list_nth 4 grads0
    let d_wgate0 = list_nth 5 grads0
    let d_wup0 = list_nth 6 grads0
    let d_wdown0 = list_nth 7 grads0
    let d_g1_b0 = list_nth 8 grads0
    let d_g2_b0 = list_nth 9 grads0

    let xT = tensor_transpose x
    let d_we_embed = matmul xT dx_embed
    let d_we = tensor_add d_we_head d_we_embed

    let we_d = unwrap w_e
    let dwe_d = unwrap d_we
    let st_we = list_nth 0 adams_e
    let _ = adam_update_raw we_d dwe_d st_we lr adam_default_b1 adam_default_b2 adam_default_eps

    let gf_d = unwrap gf
    let dgf_d = unwrap d_gf
    let st_gf = list_nth 0 adams_gf
    let _ = adam_update_raw gf_d dgf_d st_gf lr adam_default_b1 adam_default_b2 adam_default_eps

    let b0_adams = list_nth 0 adams_blocks
    let _ = adam_update_raw (unwrap (list_nth 0 b0_weights)) (unwrap d_wq0) (list_nth 0 b0_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 1 b0_weights)) (unwrap d_wk0) (list_nth 1 b0_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 2 b0_weights)) (unwrap d_wv0) (list_nth 2 b0_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 3 b0_weights)) (unwrap d_wo0) (list_nth 3 b0_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 4 b0_weights)) (unwrap d_wgate0) (list_nth 4 b0_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 5 b0_weights)) (unwrap d_wup0) (list_nth 5 b0_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 6 b0_weights)) (unwrap d_wdown0) (list_nth 6 b0_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 7 b0_weights)) (unwrap d_g1_b0) (list_nth 7 b0_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 8 b0_weights)) (unwrap d_g2_b0) (list_nth 8 b0_adams) lr adam_default_b1 adam_default_b2 adam_default_eps

    let b1_adams = list_nth 1 adams_blocks
    let _ = adam_update_raw (unwrap (list_nth 0 b1_weights)) (unwrap d_wq1) (list_nth 0 b1_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 1 b1_weights)) (unwrap d_wk1) (list_nth 1 b1_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 2 b1_weights)) (unwrap d_wv1) (list_nth 2 b1_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 3 b1_weights)) (unwrap d_wo1) (list_nth 3 b1_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 4 b1_weights)) (unwrap d_wgate1) (list_nth 4 b1_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 5 b1_weights)) (unwrap d_wup1) (list_nth 5 b1_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 6 b1_weights)) (unwrap d_wdown1) (list_nth 6 b1_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 7 b1_weights)) (unwrap d_g1_b1) (list_nth 7 b1_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap (list_nth 8 b1_weights)) (unwrap d_g2_b1) (list_nth 8 b1_adams) lr adam_default_b1 adam_default_b2 adam_default_eps
    loss

-- batch_ctx = [x, labels, corpus_ids_arr, rng, corpus_len]
-- Sampling + arena_reset + train_step happen every iteration.
m_train_loop batch_ctx blocks block_jits w_e gf adams_e adams_gf adams_blocks seq V d dlog_buf base_lr warmup max_steps step =
  if step >= max_steps then 0
  else
    let x = list_nth 0 batch_ctx
    let labels = list_nth 1 batch_ctx
    let _ = sample_chunk batch_ctx V seq
    let lr = cosine_decay step warmup max_steps base_lr
    let mk = arena_mark 0
    let loss = m_train_step x labels blocks block_jits w_e gf adams_e adams_gf adams_blocks seq V d dlog_buf lr
    let _ = arena_reset mk
    let _ = print (cat ["step ", show step, "  lr=", show_float lr, "  loss=", show_float loss])
    m_train_loop batch_ctx blocks block_jits w_e gf adams_e adams_gf adams_blocks seq V d dlog_buf base_lr warmup max_steps (step + 1)

m_eval_loss batch_ctx blocks block_jits w_e gf seq V d =
  let _ = sample_chunk batch_ctx V seq
  let x = list_nth 0 batch_ctx
  let labels = list_nth 1 batch_ctx
  let result = m_forward x w_e blocks block_jits gf seq V d
  let probs = list_nth 0 result
  m_ce_loss probs labels seq V

mk_block d d_ff seed_base =
  let wq_data = float_arr_new (d * d) 0.0
  let _ = init_scaled wq_data (d * d) d seed_base
  let w_q = Tensor wq_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wk_data = float_arr_new (d * d) 0.0
  let _ = init_scaled wk_data (d * d) d (seed_base + 1)
  let w_k = Tensor wk_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wv_data = float_arr_new (d * d) 0.0
  let _ = init_scaled wv_data (d * d) d (seed_base + 2)
  let w_v = Tensor wv_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wo_data = float_arr_new (d * d) 0.0
  let _ = init_scaled wo_data (d * d) d (seed_base + 3)
  let w_o = Tensor wo_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wgate_data = float_arr_new (d * d_ff) 0.0
  let _ = init_scaled wgate_data (d * d_ff) d (seed_base + 4)
  let w_gate = Tensor wgate_data (cons d (cons d_ff [])) (compute_strides (cons d (cons d_ff [])))
  let wup_data = float_arr_new (d * d_ff) 0.0
  let _ = init_scaled wup_data (d * d_ff) d (seed_base + 5)
  let w_up = Tensor wup_data (cons d (cons d_ff [])) (compute_strides (cons d (cons d_ff [])))
  let wdown_data = float_arr_new (d_ff * d) 0.0
  let _ = init_scaled wdown_data (d_ff * d) d_ff (seed_base + 6)
  let w_down = Tensor wdown_data (cons d_ff (cons d [])) (compute_strides (cons d_ff (cons d [])))
  let g1_data = float_arr_new d 1.0
  let _ = ones_loop_m g1_data d 0
  let g1 = Tensor g1_data (cons d []) (cons 1 [])
  let g2_data = float_arr_new d 1.0
  let _ = ones_loop_m g2_data d 0
  let g2 = Tensor g2_data (cons d []) (cons 1 [])
  cons w_q (cons w_k (cons w_v (cons w_o (cons w_gate (cons w_up (cons w_down (cons g1 (cons g2 []))))))))

mk_block_adams d d_ff =
  let st_q = adam_state (d * d)
  let st_k = adam_state (d * d)
  let st_v = adam_state (d * d)
  let st_o = adam_state (d * d)
  let st_gate = adam_state (d * d_ff)
  let st_up = adam_state (d * d_ff)
  let st_down = adam_state (d_ff * d)
  let st_g1 = adam_state d
  let st_g2 = adam_state d
  cons st_q (cons st_k (cons st_v (cons st_o (cons st_gate (cons st_up (cons st_down (cons st_g1 (cons st_g2 []))))))))

main =
  let _ = print "=== lm_v3_chunked (2-block, chunked sampling from full optim.rail) ==="

  let text = read_file corpus_path
  let vocab = build_vocab text
  let V = vocab_size vocab
  let _ = print (cat ["corpus chars=", show (length (chars text)), "  vocab size=", show V])

  -- Encode full corpus into a fixed-size float_arr for O(1) random access.
  let corpus_len = length (chars text)
  let ids_arr = float_arr_new corpus_len 0.0
  let _ = encode_into_arr ids_arr text vocab
  let _ = print (cat ["corpus encoded to arr (", show corpus_len, " ids)"])

  let seq = seq_len
  let max_off = corpus_len - seq - 1
  let _ = print (cat ["seq_len=", show seq, "  max offset=", show max_off])

  -- Pre-allocate scratch one-hot + labels. These get mutated each step.
  let x_data = float_arr_new (seq * V) 0.0
  let x = Tensor x_data (cons seq (cons V [])) (compute_strides (cons seq (cons V [])))
  let labels_data = float_arr_new seq 0.0
  let labels = Tensor labels_data (cons seq []) (cons 1 [])

  -- RNG state (deterministic across runs for reproducibility).
  let rng = lcg_state_new 42

  let batch_ctx = cons x (cons labels (cons ids_arr (cons rng (cons corpus_len []))))

  let d = 64
  let d_ff = 3 * d

  let we_data = float_arr_new (V * d) 0.0
  let _ = init_scaled we_data (V * d) V 1
  let w_e = Tensor we_data (cons V (cons d [])) (compute_strides (cons V (cons d [])))

  let gf_data = float_arr_new d 1.0
  let _ = ones_loop_m gf_data d 0
  let gf = Tensor gf_data (cons d []) (cons 1 [])

  let block0 = mk_block d d_ff 100
  let block1 = mk_block d d_ff 200
  let blocks = cons block0 (cons block1 [])

  -- Compile fused Metal kernels once (shared across blocks) + per-block
  -- pre-allocated scratch / output buffers.  Persistent for the run.
  let _ = print "[jit] compiling fused rmsnorm+QKV kernel..."
  let kid_qkv = jit_compile_rmsnorm_qkv 0
  let _ = print (cat ["[jit]   kid_qkv=", show kid_qkv])
  let _ = print "[jit] compiling fused silu+hadamard kernel..."
  let kid_silu = jit_compile_silu_hadamard 0
  let _ = print (cat ["[jit]   kid_silu=", show kid_silu])
  let b0_jit = mk_jit_ctx seq d d_ff kid_qkv kid_silu
  let b1_jit = mk_jit_ctx seq d d_ff kid_qkv kid_silu
  let block_jits = cons b0_jit (cons b1_jit [])

  let st_we = adam_state (V * d)
  let st_gf = adam_state d
  let adams_e = cons st_we []
  let adams_gf = cons st_gf []
  let block0_adams = mk_block_adams d d_ff
  let block1_adams = mk_block_adams d d_ff
  let adams_blocks = cons block0_adams (cons block1_adams [])

  let dlog_buf = float_arr_new (seq * V) 0.0

  let base_lr = 0.02
  let warmup = 100
  let max_steps = 10000

  let loss0 = m_eval_loss batch_ctx blocks block_jits w_e gf seq V d
  let _ = print (cat ["initial loss (on one sampled chunk)=", show_float loss0, "  uniform=", show_float (log (int_to_float V))])
  let _ = print (cat ["training ", show max_steps, " steps..."])

  let _ = m_train_loop batch_ctx blocks block_jits w_e gf adams_e adams_gf adams_blocks seq V d dlog_buf base_lr warmup max_steps 0

  let loss1 = m_eval_loss batch_ctx blocks block_jits w_e gf seq V d
  let _ = print (cat ["\nfinal loss (fresh chunk)=", show_float loss1])
  let _ = print "(compare to lm_v3_multi fixed-corpus baseline: 1.546 at step 429)"
  0
