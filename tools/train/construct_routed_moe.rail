-- tools/train/construct_routed_moe.rail — Tier-D3 construct-routed MoE.
--
-- Sparse mixture-of-experts with routing per Rail construct. Total params
-- comparable to dense d=256, but per-construct inductive bias for DSL
-- code-gen.
--
-- Construct routes (8 experts):
--   E0  PROLOGUE   — module imports, type defs, top-level decl headers
--   E1  LET        — let bindings, local scoping
--   E2  MATCH      — pattern matching, ADT consumption
--   E3  LAMBDA_FN  — lambda bodies, fn definitions
--   E4  ARITH      — arithmetic + boolean expressions
--   E5  IO         — print, write_file, read_line, shell
--   E6  CALL       — function application, builtin invocation
--   E7  MISC       — fallthrough (lists, strings, atoms, fallback)
--
-- Each expert is its own MLP block (d_model=128, ff_mult=4), per-token
-- routing via a tiny gate network conditioned on the last 4 surface
-- tokens. Top-1 routing (each token assigned to exactly one expert).
--
-- Param accounting (vs dense d=256, 2-block reference):
--   Dense:    2 blocks × (Q,K,V,O,gate,up,down) × (256×256 each) ≈ 920K
--   MoE:      shared attention (2 blocks × QKVO × 256² ≈ 260K)
--           + 8 experts × (gate,up,down) × 128² × 4 ≈ 8 × 200K ≈ 1.6M
--   Total MoE ≈ 1.86M, similar order. Routing adds minimal overhead.
--
-- Routing decision (gate network):
--   features = last_4_tokens_embedding (concat) → d=512 vector
--   logits   = features · W_gate (512 × 8)
--   route    = argmax(logits)   -- top-1
-- Auxiliary load-balance loss on routing distribution prevents
-- collapse to one expert.
--
-- Implementation: this file is the SCAFFOLD with shape declarations.
-- Full implementation requires:
--   1. New stdlib/moe.rail module — block forward with gate + N experts
--   2. Fork lm_v07 trainer → lm_v12_d128_moe_8x.rail
--   3. Construct-classifier function (heuristic, called per token at
--      training time to provide ground-truth routes during a warmup
--      phase before learning the gate).

import "stdlib/list.rail"
import "stdlib/transformer.rail"

cat parts = join "" parts

n_experts = 8

construct_names = [
  "PROLOGUE", "LET", "MATCH", "LAMBDA_FN",
  "ARITH", "IO", "CALL", "MISC"
]

-- ── Heuristic construct classifier (training-time supervision target
-- for the gate during warmup). Looks at last few tokens of context.
classify_construct ctx =
  let recent = last_text ctx 16
  if str_starts_with "import" recent then 0
  else if str_starts_with "type " recent then 0
  else if str_contains " let " recent then 1
  else if str_contains " in " recent then 1
  else if str_contains " match " recent then 2
  else if str_contains "| " recent then 2
  else if str_starts_with "\\" recent then 3
  else if str_contains " -> " recent then 3
  else if str_contains " + " recent || str_contains " - " recent ||
          str_contains " * " recent || str_contains " / " recent then 4
  else if str_contains " == " recent || str_contains " < " recent then 4
  else if str_contains "print" recent || str_contains "write_file" recent then 5
  else if str_contains "read_" recent || str_contains "shell" recent then 5
  else if str_contains "(" recent && str_contains ")" recent then 6
  else 7

last_text s n =
  let cs = chars s
  let l = length cs
  if l <= n then s
  else join "" (drop_n_local cs (l - n))

drop_n_local xs n =
  if n <= 0 then xs
  else if length xs == 0 then xs
  else drop_n_local (tail xs) (n - 1)

str_starts_with prefix s =
  let pcs = chars prefix
  let scs = chars s
  ssw_loop_l pcs scs

ssw_loop_l pcs scs =
  if length pcs == 0 then true
  else if length scs == 0 then false
  else if head pcs == head scs then ssw_loop_l (tail pcs) (tail scs)
  else false

main =
  let _ = print "construct_routed_moe scaffold."
  let _ = print "8 experts. Top-1 routing. Heuristic classifier provided."
  let _ = print "Implementation: stdlib/moe.rail + lm_v12_d128_moe_8x.rail."
  0
