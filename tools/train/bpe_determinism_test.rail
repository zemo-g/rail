-- bpe_determinism_test.rail — assert the fast path (bpe_train) and the
-- legacy path (bpe_train_legacy) produce byte-identical BPE structs on
-- a fixed corpus. If this passes, the rewrite is a pure perf change.
import "stdlib/bpe.rail"

repeat_cat s k acc =
  if k == 0 then acc
  else repeat_cat s (k - 1) (cat [acc, s])

-- Compare two merge lists element-wise: (a, b, nid) triples must match.
eq_merges_loop xs ys =
  if length xs == 0 then length ys == 0
  else if length ys == 0 then false
  else
    let xh = head xs
    let yh = head ys
    let (xa, xb, xn) = xh
    let (ya, yb, yn) = yh
    if xa == ya then
      if xb == yb then
        if xn == yn then eq_merges_loop (tail xs) (tail ys)
        else false
      else false
    else false

-- Compare two vocab lists element-wise: strings must be byte-identical.
str_eq a b =
  let ca = chars a
  let cb = chars b
  str_eq_loop ca cb

str_eq_loop xs ys =
  if length xs == 0 then length ys == 0
  else if length ys == 0 then false
  else if head xs == head ys then str_eq_loop (tail xs) (tail ys)
  else false

eq_vocab_loop xs ys =
  if length xs == 0 then length ys == 0
  else if length ys == 0 then false
  else if str_eq (head xs) (head ys) then eq_vocab_loop (tail xs) (tail ys)
  else false

unwrap_merges b = match b | BPE m _ _ -> m
unwrap_vocab  b = match b | BPE _ v _ -> v
unwrap_size   b = match b | BPE _ _ s -> s

main =
  let seed = "let x = if cond then a + b else c * d -- comment\n"
  let corpus = repeat_cat seed 80 ""
  let n = length (chars corpus)
  let _ = print (cat ["corpus chars: ", show n])

  let target = 256
  let b_fast = bpe_train corpus target
  let b_leg  = bpe_train_legacy corpus target

  let sf = unwrap_size b_fast
  let sl = unwrap_size b_leg
  let _ = print (cat ["fast size=", show sf, "  legacy size=", show sl])

  let size_ok = sf == sl

  let mf = unwrap_merges b_fast
  let ml = unwrap_merges b_leg
  let merges_ok = eq_merges_loop mf ml
  let _ = print (cat ["merges count fast=", show (length mf), " legacy=", show (length ml)])

  let vf = unwrap_vocab b_fast
  let vl = unwrap_vocab b_leg
  let vocab_ok = eq_vocab_loop vf vl
  let _ = print (cat ["vocab count fast=", show (length vf), " legacy=", show (length vl)])

  let all_ok =
    if size_ok then
      if merges_ok then
        if vocab_ok then true
        else false
      else false
    else false

  let verdict =
    if all_ok then "PASS: fast path ≡ legacy path (merges + vocab + size)"
    else "FAIL: divergence between fast and legacy"
  let _ = print verdict

  -- Round-trip: fast-trained bpe encodes/decodes cleanly.
  let ids = bpe_encode b_fast corpus
  let back = bpe_decode b_fast ids
  let rt_ok = str_eq corpus back
  let rt_verdict = if rt_ok then "PASS: fast round-trip exact" else "FAIL: fast round-trip diverged"
  let _ = print rt_verdict
  0
