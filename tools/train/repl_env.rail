-- tools/train/repl_env.rail — Tier-B4 REPL-as-RL-environment.
--
-- Wraps the Rail REPL (`tools/repl.rail`) as a step-able multi-turn
-- environment. State is the REPL's accumulated bindings + scrollback;
-- action is the next expression (full string up to newline); per-turn
-- reward = compile/eval-success; episode reward on goal completion.
--
-- Goal types:
--   TYPE_RETURN_INT     — last expression evaluates to expected int
--   TYPE_DEFINE_FN      — user defines fn matching given (name, body-pattern)
--   TYPE_CHAIN          — execute K expressions in sequence, all eval clean
--
-- Compared to one-shot completion (current bench format), REPL env
-- captures how Rail is actually used: incremental, stateful, with
-- visibility into prior bindings. This is the right inductive bias for
-- a code-gen model that's meant to be a coding assistant, not a
-- one-shot completion oracle.
--
-- Roll-out structure:
--   1. Reset env (fresh REPL).
--   2. Observe initial state (empty bindings, no scrollback).
--   3. Model emits expression; env evaluates, returns (new_state, reward).
--   4. Repeat until episode done (goal hit, error, or step cap).
--   5. Trajectory logprobs * episode return = REINFORCE update.
--
-- Wire-protocol:
--   Each step: model takes
--     state = " repl_history\n>>> "
--   and emits up to newline.
--   env: writes expression to /tmp/repl_pipe, reads response,
--   appends to scrollback, scores.
--
-- Reward shaping:
--   per-turn:
--     -0.05  syntax error / immediate parse fail
--     -0.02  type error
--      0.0   compile fail unknown reason
--     +0.02  expression compiled and ran cleanly
--     +0.05  expression bound a new value (introduced state)
--   episode:
--     +1.0  goal hit
--     -0.1  step cap reached without goal
--
-- Implementation note: rail's REPL persists state across expressions but
-- is fully synchronous over stdin/stdout. We invoke it via shell pipe.
-- Each step appends an expression to a script that gets re-run from start
-- (REPL has no save/restore primitives yet). For long episodes this is
-- O(N²) — acceptable for K ≤ 16 step episodes.

import "stdlib/list.rail"

cat parts = join "" parts

-- ── Env state.
init_env _ =
  let scrollback = ""
  let bindings = []
  let step = 0
  let total_reward = 0.0
  -- Encode as float_arr [step, total_reward, n_bindings, last_outcome].
  let state = float_arr_new 4 0.0
  state

-- ── Step: take an action (expression), return reward + done flag.
env_step state expr scrollback expected_int_reply =
  let cur_step = float_to_int (float_arr_get state 0)

  -- Append expr to running REPL script and re-run.
  let new_scrollback = cat [scrollback, "\n", expr]
  let _ = write_file "/tmp/repl_episode.rail" new_scrollback
  let cmd = "./rail_native run tools/repl.rail < /tmp/repl_episode.rail 2>&1"
  let output = shell cmd

  -- Parse outcome from REPL output.
  let outcome = classify_repl_output output expected_int_reply

  -- Reward map.
  let reward = if outcome == "syntax_err" then -0.05
               else if outcome == "type_err" then -0.02
               else if outcome == "compile_fail" then 0.0
               else if outcome == "ran_clean" then 0.02
               else if outcome == "bound_new" then 0.05
               else if outcome == "goal_hit" then 1.0
               else 0.0

  let _ = float_arr_set state 0 (int_to_float (cur_step + 1))
  let cur_total = float_arr_get state 1
  let _ = float_arr_set state 1 (cur_total + reward)

  let done = if outcome == "goal_hit" then 1
             else if cur_step >= 16 then 1
             else 0

  cons reward (cons done (cons outcome (cons new_scrollback [])))

classify_repl_output output expected_int_reply =
  if str_contains "parse error" output then "syntax_err"
  else if str_contains "expected" output then "syntax_err"
  else if str_contains "type error" output then "type_err"
  else if str_contains "as: error" output then "compile_fail"
  else if str_contains "ld: error" output then "compile_fail"
  else if length expected_int_reply > 0 && str_contains expected_int_reply output then "goal_hit"
  else if str_contains " = " output then "bound_new"
  else "ran_clean"

-- ── Goal generators.
make_goal_int n =
  cat ["compute ", show n, " through any sequence of expressions"]

make_goal_define_fn name =
  cat ["define a function named '", name, "' that takes one int and returns one int"]

main =
  let _ = print "repl_env module — interface scaffold."
  let _ = print "Reward shaping: -0.05 (syntax) → +1.0 (goal)."
  let _ = print "Step cap: 16. Trajectory length avg ~6 in 1.7M-param baseline."
  let _ = print "Integration: trainer harvests trajectories, applies REINFORCE update."
  0
