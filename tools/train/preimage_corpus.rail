-- tools/train/preimage_corpus.rail — Tier-A4 pre-image objective.
--
-- For each compiling program P in the corpus:
--   1. Run via rail_native, capture stdout O.
--   2. Emit two paired training examples:
--      forward:  prompt="generate program for: <O>" → completion=P
--      reverse:  prompt=P → completion=O
--
-- The forward direction inverts the compiler. Trains semantic
-- understanding: model must learn "what produces this output" not just
-- "what's the next token in this surface form."
--
-- Multiplies effective corpus size 2× and adds an output→program signal
-- that no surface-only corpus carries.
--
-- Output: training/corpora/preimage_pairs.txt
-- Format:
--   ── PAIR <id> ──
--   <forward>
--   prompt: generate program producing: <O>
--   ----
--   <P>
--   ── END FORWARD ──
--   <reverse>
--   prompt: <P>
--   ----
--   <O>
--   ── END REVERSE ──
--
-- The trainer's chunked sampler reads this format and treats each pair as
-- a sequence pair. The "── PAIR" markers act as section anchors.
--
-- Usage:
--   ./rail_native run tools/train/preimage_corpus.rail \
--       <input_corpus.rail> [output.txt]

import "stdlib/list.rail"

cat parts = join "" parts

-- ── Split corpus into individual programs by `main =` boundary.
split_programs src =
  let lines = split "\n" src
  split_programs_loop lines [] []

split_programs_loop lines current acc =
  if length lines == 0 then
    if length current == 0 then reverse acc
    else reverse (cons (join "\n" (reverse current)) acc)
  else
    let line = head lines
    if str_starts_with "main = " (trim_left line) then
      let new_acc = if length current == 0 then acc
                    else cons (join "\n" (reverse current)) acc
      split_programs_loop (tail lines) (cons line []) new_acc
    else split_programs_loop (tail lines) (cons line current) acc

trim_left s =
  let cs = chars s
  trim_l_loop cs

trim_l_loop cs =
  if length cs == 0 then ""
  else if head cs == " " || head cs == "\t" then trim_l_loop (tail cs)
  else join "" cs

str_starts_with prefix s =
  let pcs = chars prefix
  let scs = chars s
  ssw_loop pcs scs

ssw_loop pcs scs =
  if length pcs == 0 then true
  else if length scs == 0 then false
  else if head pcs == head scs then ssw_loop (tail pcs) (tail scs)
  else false

-- ── Run a single program, capture stdout (or error).
run_program prog =
  let path = "/tmp/preimage_probe.rail"
  let _ = write_file path prog
  let cmd = "tools/run_with_timeout.sh 5 ./rail_native run /tmp/preimage_probe.rail 2>/dev/null"
  shell cmd

trim s =
  let cs = chars s
  let r = trim_loop cs []
  join "" r

trim_loop cs acc =
  if length cs == 0 then reverse acc
  else
    let c = head cs
    if c == "\n" || c == "\r" then trim_loop (tail cs) acc
    else trim_loop (tail cs) (cons c acc)

-- ── Emit forward and reverse pair markers.
emit_pair id prog output =
  cat [
    "── PAIR ", show id, " ──\n",
    "── FORWARD ──\n",
    "prompt: generate program producing: ", trim output, "\n",
    "----\n",
    prog, "\n",
    "── END FORWARD ──\n",
    "── REVERSE ──\n",
    "prompt: ", prog, "\n",
    "----\n",
    trim output, "\n",
    "── END REVERSE ──\n\n"
  ]

main =
  let cmdline = args
  if length cmdline < 2 then
    let _ = print "usage: preimage_corpus.rail <input.rail> [out.txt]"
    1
  else
    let in_path = nth 1 cmdline
    let out_path = if length cmdline < 3 then "training/corpora/preimage_pairs.txt"
                                       else nth 2 cmdline

    let src = read_file in_path
    if is_error src then
      let _ = print (cat ["error reading ", in_path])
      1
    else
      let progs = split_programs src
      let _ = print (cat ["found ", show (length progs), " programs"])

      let pairs = build_pairs progs 0 []
      let body = cat (reverse pairs)
      let _ = write_file out_path body
      let _ = print (cat ["wrote ", show (length (chars body)),
                          " bytes to ", out_path])
      0

build_pairs progs idx acc =
  if length progs == 0 then acc
  else
    let p = head progs
    let output = run_program p
    if length (chars output) == 0 then build_pairs (tail progs) (idx + 1) acc
    else
      let pair = emit_pair idx p output
      build_pairs (tail progs) (idx + 1) (cons pair acc)
