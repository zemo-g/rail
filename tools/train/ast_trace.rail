-- tools/train/ast_trace.rail — Tier-A2 shallow AST trace emitter.
--
-- Produces a parallel token stream of structural markers per source line,
-- suitable as auxiliary loss target. Does NOT modify compile.rail (a full
-- compiler-instrumented version is future work; this shallow version is
-- enough to falsify whether parse-trace aux loss is a lever at this scale).
--
-- Output format (one trace line per source line):
--   <DECL>foo<PARAM>x<PARAM>y<EQ><BODY>...</BODY></DECL>     -- top-level fn decl
--   <LET>name<EQ><EXPR>...</EXPR></LET>                      -- let binding
--   <MATCH><SCRUT>x</SCRUT><ARM>...</ARM></MATCH>            -- match
--   <APP>f<ARG>x</ARG></APP>                                  -- application
--   <LAMBDA>x<BODY>...</BODY></LAMBDA>                       -- lambda
--   <IF><COND>...<THEN>...<ELSE>...</IF>                     -- if expr
--   <ATOM>literal</ATOM>                                      -- leaf
--   <COMMENT>text</COMMENT>                                   -- comment
--   <BLANK>                                                   -- blank line
--
-- Two streams are emitted:
--   <input>.surface  — raw source byte stream
--   <input>.asttrace — structural token stream, line-aligned to surface
--
-- Trainer consumes both as a 2-channel sequence with separate vocabs.
--
-- Usage:
--   ./rail_native run tools/train/ast_trace.rail <input.rail> [output_prefix]

import "stdlib/list.rail"

cat parts = join "" parts

-- ── Lightweight char predicates.
is_alpha_char c = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c == "_")
is_digit_char c = c >= "0" && c <= "9"
is_ident_char c = is_alpha_char c || is_digit_char c
is_space_char c = c == " " || c == "\t"

-- ── Trim leading whitespace.
trim_left s =
  let cs = chars s
  trim_left_loop cs

trim_left_loop cs =
  if length cs == 0 then ""
  else if is_space_char (head cs) then trim_left_loop (tail cs)
  else join "" cs

-- ── Identify line kind.
classify_line raw =
  let line = trim_left raw
  if length (chars line) == 0 then "BLANK"
  else if str_starts_with "--" line then "COMMENT"
  else if str_starts_with "import " line then "IMPORT"
  else if str_starts_with "type " line then "TYPE"
  else if str_starts_with "let " line then "LET"
  else if str_starts_with "match " line then "MATCH"
  else if str_starts_with "if " line then "IF"
  else if str_starts_with "| " line then "ARM"
  else if str_contains "=" line then "DECL_OR_LET"
  else "EXPR"

-- ── Emit per-line trace.
emit_line_trace raw =
  let kind = classify_line raw
  if kind == "BLANK" then "<BLANK>"
  else if kind == "COMMENT" then cat ["<COMMENT>", trim_left raw, "</COMMENT>"]
  else if kind == "IMPORT" then cat ["<IMPORT>", trim_left raw, "</IMPORT>"]
  else if kind == "TYPE" then cat ["<TYPE>", trim_left raw, "</TYPE>"]
  else if kind == "LET" then emit_let_trace raw
  else if kind == "MATCH" then emit_match_trace raw
  else if kind == "IF" then emit_if_trace raw
  else if kind == "ARM" then cat ["<ARM>", trim_left raw, "</ARM>"]
  else if kind == "DECL_OR_LET" then emit_decl_trace raw
  else cat ["<EXPR>", trim_left raw, "</EXPR>"]

-- ── Specific shape emitters.
emit_let_trace line =
  let trimmed = trim_left line
  let after_let = str_sub trimmed 4 (length (chars trimmed) - 4)
  let eq_pos = str_find " = " after_let
  if eq_pos < 0 then cat ["<LET><MALFORMED>", after_let, "</MALFORMED></LET>"]
  else
    let name = str_sub after_let 0 eq_pos
    let body = str_sub after_let (eq_pos + 3) (length (chars after_let) - eq_pos - 3)
    cat ["<LET>", name, "<EQ><BODY>", body, "</BODY></LET>"]

emit_match_trace line =
  let trimmed = trim_left line
  let after_match = str_sub trimmed 6 (length (chars trimmed) - 6)
  cat ["<MATCH><SCRUT>", after_match, "</SCRUT></MATCH>"]

emit_if_trace line =
  let trimmed = trim_left line
  cat ["<IF>", trimmed, "</IF>"]

emit_decl_trace line =
  let trimmed = trim_left line
  let eq_pos = str_find " = " trimmed
  if eq_pos < 0 then cat ["<EXPR>", trimmed, "</EXPR>"]
  else
    let lhs = str_sub trimmed 0 eq_pos
    let rhs = str_sub trimmed (eq_pos + 3) (length (chars trimmed) - eq_pos - 3)
    let parts = split " " lhs
    if length parts == 0 then cat ["<EXPR>", trimmed, "</EXPR>"]
    else
      let name = head parts
      let params_text = join " " (tail parts)
      cat ["<DECL>", name, "<PARAM>", params_text, "<EQ><BODY>", rhs, "</BODY></DECL>"]

str_starts_with prefix s =
  let pcs = chars prefix
  let scs = chars s
  starts_with_loop pcs scs

starts_with_loop pcs scs =
  if length pcs == 0 then true
  else if length scs == 0 then false
  else if head pcs == head scs then starts_with_loop (tail pcs) (tail scs)
  else false

main =
  if length args < 2 then
    let _ = print "usage: ast_trace.rail <input.rail> [output_prefix]"
    0
  else
    let in_path = nth 1 args
    let out_prefix = if length args < 3 then in_path else nth 2 args

    let src = read_file in_path
    if is_error src then
      let _ = print (cat ["error reading ", in_path])
      1
    else
      let lines = split "\n" src
      let trace_lines = map emit_line_trace lines
      let trace_body = join "\n" trace_lines

      let _ = write_file (cat [out_prefix, ".surface"]) src
      let _ = write_file (cat [out_prefix, ".asttrace"]) trace_body

      let _ = print (cat ["surface: ", show (length (chars src)), " bytes"])
      let _ = print (cat ["trace:   ", show (length (chars trace_body)), " bytes (",
                          show (length lines), " lines)"])
      0
