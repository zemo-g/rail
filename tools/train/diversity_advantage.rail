-- tools/train/diversity_advantage.rail — Tier-C2 diversity-aware GRPO advantage.
--
-- Computes the modified GRPO advantage:
--   A_i = (r_i - mean(r)) / std(r)   -- standard GRPO term
--       - λ_div · KL(π(·|p, sample_i), group_mean_dist)   -- diversity penalty
--
-- Defends against 20-sample mode collapse — when 20 rerank samples for the
-- same prompt converge to identical outputs, the diversity term penalizes
-- the policy for over-confidence even on rewarded outputs.
--
-- Per `dylib_first_token_only.md` and the broader sampling-collapse pattern:
-- without this term, training-time samples narrow into a single mode that
-- val_loss doesn't catch and rerank exposes only at bench time.
--
-- Inputs (one call per prompt, post-rollout):
--   rewards        : float_arr of N rewards (from grade_stage.rail)
--   sample_logprobs: float_arr of N×T per-token logprobs (the sampled tokens)
--   sample_distrs  : Tensor of N×T×V softmax probabilities at each step
--   λ_div          : scalar weight, typical 0.05–0.1
--
-- Output (per sample):
--   advantage_i = (r_i - mean) / std - λ_div · KL_to_group_mean

import "stdlib/list.rail"
import "stdlib/transformer.rail"

cat parts = join "" parts

-- ── Helpers.
arr_mean a n =
  if n == 0 then 0.0
  else
    let s = arr_sum_loop a 0 n 0.0
    s / int_to_float n

arr_sum_loop a i n acc =
  if i >= n then acc
  else arr_sum_loop a (i + 1) n (acc + float_arr_get a i)

arr_std a n mean =
  if n <= 1 then 1.0
  else
    let ss = arr_var_loop a 0 n mean 0.0
    let var = ss / int_to_float n
    let s = if var < 1.0e-8 then 1.0e-4 else sqrt_approx var
    s

arr_var_loop a i n mean acc =
  if i >= n then acc
  else
    let d = (float_arr_get a i) - mean
    arr_var_loop a (i + 1) n mean (acc + d * d)

-- Newton-Raphson sqrt approximation; stdlib doesn't have sqrt for floats yet.
sqrt_approx x =
  if x < 1.0e-12 then 0.0
  else sqrt_iter x x 0

sqrt_iter x guess i =
  if i >= 8 then guess
  else
    let new_guess = 0.5 * (guess + x / guess)
    sqrt_iter x new_guess (i + 1)

-- ── KL divergence between two distributions over V tokens.
-- Both are float_arr[V] of probabilities (assumed sum to 1).
kl_divergence p q V =
  kl_loop p q 0 V 0.0

kl_loop p q i V acc =
  if i >= V then acc
  else
    let pi = float_arr_get p i
    let qi = float_arr_get q i
    let term = if pi < 1.0e-12 then 0.0
               else if qi < 1.0e-12 then pi * 30.0  -- log(huge) clipped
               else pi * (log_approx pi - log_approx qi)
    kl_loop p q (i + 1) V (acc + term)

-- log approximation via series; stdlib doesn't have log either.
log_approx x =
  if x <= 0.0 then -30.0
  else if x > 1.0e6 then log_approx_large x
  else log_series x

log_series x =
  -- expand log(x) = 2 * (u + u^3/3 + u^5/5 + ...) where u = (x-1)/(x+1)
  let u = (x - 1.0) / (x + 1.0)
  let u2 = u * u
  let s1 = u
  let s3 = (u * u2) / 3.0
  let s5 = (u * u2 * u2) / 5.0
  let s7 = (u * u2 * u2 * u2) / 7.0
  2.0 * (s1 + s3 + s5 + s7)

log_approx_large x =
  -- Reduce: log(x) = log(x/2) + log(2). log(2) ≈ 0.693147.
  if x <= 1.0e6 then log_series x
  else log_approx_large (x / 2.0) + 0.693147

-- ── Compute group-mean distribution: average π(·|p, sample_i) across N samples.
-- Each sample_distrs[i] is a T×V slice; we average over i AT EACH (t,v).
-- Returns a float_arr of T×V representing the mean dist.
group_mean_distrs sample_distrs N T V =
  let mean_arr = float_arr_new (T * V) 0.0
  let _ = group_mean_loop sample_distrs N T V mean_arr 0
  mean_arr

group_mean_loop sample_distrs N T V mean_arr i =
  if i >= N then 0
  else
    let slice = nth i sample_distrs
    let _ = accum_into mean_arr slice (T * V) (1.0 / int_to_float N)
    group_mean_loop sample_distrs N T V mean_arr (i + 1)

accum_into dst src n weight =
  accum_loop dst src 0 n weight

accum_loop dst src i n weight =
  if i >= n then 0
  else
    let cur = float_arr_get dst i
    let add = (float_arr_get src i) * weight
    let _ = float_arr_set dst i (cur + add)
    accum_loop dst src (i + 1) n weight

-- ── Per-step KL between sample_i's distribution and group mean.
sample_kl_to_group sample_distr group_mean T V =
  sample_kl_loop sample_distr group_mean 0 T V 0.0

sample_kl_loop sd gm t T V acc =
  if t >= T then acc / int_to_float T
  else
    let off = t * V
    let pd = slice_arr sd off V
    let gd = slice_arr gm off V
    let kl_t = kl_divergence pd gd V
    sample_kl_loop sd gm (t + 1) T V (acc + kl_t)

slice_arr a off n =
  let s = float_arr_new n 0.0
  let _ = slice_loop a off s 0 n
  s

slice_loop src off dst i n =
  if i >= n then 0
  else
    let _ = float_arr_set dst i (float_arr_get src (off + i))
    slice_loop src off dst (i + 1) n

-- ── Main: compute advantages.
compute_advantages rewards sample_distrs N T V lambda_div =
  let mean_r = arr_mean rewards N
  let std_r = arr_std rewards N mean_r
  let group_mean = group_mean_distrs sample_distrs N T V
  let advs = float_arr_new N 0.0

  let _ = adv_loop rewards sample_distrs group_mean N T V mean_r std_r lambda_div advs 0
  advs

adv_loop rewards sample_distrs group_mean N T V mean_r std_r lambda_div advs i =
  if i >= N then 0
  else
    let r_i = float_arr_get rewards i
    let advantage = (r_i - mean_r) / std_r
    let sd_i = nth i sample_distrs
    let kl_i = sample_kl_to_group sd_i group_mean T V
    let final_adv = advantage - lambda_div * kl_i
    let _ = float_arr_set advs i final_adv
    adv_loop rewards sample_distrs group_mean N T V mean_r std_r lambda_div advs (i + 1)

main =
  let _ = print "diversity_advantage module — import only, no main entry"
  0
