-- bench_diagnose_jit_real.rail — wall-clock speedup on actual teacher fixes.
--
-- Reads triples_v2.txt, takes the first N FIXED blocks, grades them
-- through `diagnose` (slow) or `diagnose_fast` (fast), reports counts.
--
-- Usage:
--   ./rail_native run tools/train/bench_diagnose_jit_real.rail slow [N]
--   ./rail_native run tools/train/bench_diagnose_jit_real.rail fast [N]
--
-- Default N=200. Run under shell `time` to compare wall-clock.

import "jit/ir.rail"
import "tools/train/diagnose_jit.rail"

corpus_path = "training/triples_v2.txt"

extract_fixed chunk =
  let f_off = str_find "<FIXED>\n" chunk
  if f_off < 0 then ""
  else
    let start = f_off + 8
    let total = length (chars chunk)
    str_sub chunk start (total - start)

mode_arg = if length args > 1 then head (tail args) else "slow"

-- N is hard-wired (avoid str→int parsing dependency).
n_arg = 200

grade1 mode src =
  if mode == "fast" then diagnose_fast src
  else diagnose src

bench_loop mode chunks idx limit ok_ct fail_ct =
  if length chunks == 0 then cons ok_ct (cons fail_ct [])
  else if idx >= limit then cons ok_ct (cons fail_ct [])
  else
    let chunk = head chunks
    let fixed = extract_fixed chunk
    if length (chars fixed) == 0 then
      bench_loop mode (tail chunks) idx limit ok_ct fail_ct
    else
      let pair = grade1 mode fixed
      let ok = head pair
      if ok == 1 then bench_loop mode (tail chunks) (idx + 1) limit (ok_ct + 1) fail_ct
      else bench_loop mode (tail chunks) (idx + 1) limit ok_ct (fail_ct + 1)

main =
  let _ = print (cat ["MODE=", mode_arg, " N=", show n_arg])
  let corpus = read_file corpus_path
  let chunks = str_split "<END>\n\n" corpus
  let r = bench_loop mode_arg chunks 0 n_arg 0 0
  let total_ok = head r
  let total_fail = head (tail r)
  let _ = print (cat ["GRADED ok=", show total_ok, " fail=", show total_fail])
  0
