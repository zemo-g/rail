-- lm_v3_chunked_half.rail — Phase 5a HalfTensor training variant.
--
-- Weights + fwd-path activations live as HalfTensor end-to-end.
-- The 9 matmuls per block × 2 blocks use matmul_half (zero-cast fp16).
-- Non-matmul half ops use temporary cast shims (tensor_of_half →
-- f64 op → half_of_tensor) until Mini's kernels land, at which
-- point each X_half_shim is replaced with direct X_half.
-- Backward stays f64 (Phase 4b lesson): cast dx from HalfTensor
-- at m_block_bwd entry, compute grads + Adam in f64, pack updated
-- weight back into the HalfTensor slot at adam step.
-- Based on lm_v3_chunked.rail (frozen reference). Header kept
-- verbatim below for traceability.
--
-- Based on lm_v3_multi.rail (2-block, d=64, RMSNorm + RoPE + SwiGLU +
-- tied embeddings + AdamW + Kaiming-scaled init). Only the data pipeline
-- differs: instead of training on a fixed 600-char prefix, we load the
-- full stdlib/optim.rail (9.2KB) as the corpus and sample a random
-- seq_len=512 chunk each training step.
--
-- The per-step working set is bounded by seq_len, identical to the
-- fixed-corpus baseline, so memory behavior should match. What changes
-- is that over many steps the model sees the full corpus, not just the
-- prefix — which is what unlocks real-scale training.
--
-- Sampler primitives:
--   encode_into_arr : fills a float_arr with token ids (O(n*V), not O(n²))
--   lcg_next        : LCG rng state in a float_arr[1]
--   sample_chunk    : in-place fill x (one-hot) and labels from a random
--                     offset into the corpus id array
-- Training loop stays the same; only `main` changes to use sampler.
import "stdlib/transformer.rail"
import "stdlib/optim.rail"
import "stdlib/tokenizer.rail"
import "stdlib/oracle.rail"
import "stdlib/checkpoint.rail"

-- Chunk size = the seq dimension the model sees each step.
-- Must be < corpus_len so we have valid offsets to sample.
seq_len = 1024

-- Spur-v66 — TRUE TWO-LOSS-HEAD trainer (combined gradient before Adam).
-- Per step: forward A and B, compute grads_a (alpha-scaled) and grads_b
-- ((1-alpha)-scaled), element-wise sum into combined grad, ONE Adam update.
-- Adam moments see ONE combined gradient per step instead of alternating
-- per-corpus full gradients (v62/v63's failure mode).
-- alpha = 0.75 (compile.rail dominant). 3000 steps from scratch.
corpus_path = "training/corpora/spur_compile_back_quarter.txt"
phase_b_corpus_path = "training/corpora/spur_comprehension_seed_v3.txt"

eval_interval = 100
n_eval_chunks = 10
eval_seed = 1337
eval_seed_b = 1338
rss_interval = 500
rss_log_path = "/tmp/spur_v66_rss.txt"
eval_log_path = "/tmp/spur_v66_eval.txt"

-- ── HalfTensor cast shims. Drop-in replacements that round-trip through
-- f64 until Mini ships real half kernels. Numerically equivalent (same
-- kernel just called with cast wrapper); slower but correct.
-- add_half_shim retired 2026-04-21 — stdlib add_half (real kernel) in use.

-- scale_half_shim retired 2026-04-21 — stdlib scale_half (real kernel) in use.

-- transpose_half_shim retired 2026-04-21 — stdlib transpose_half (real) in use.

-- softmax_half_shim retired 2026-04-21 — stdlib softmax_half (log-sum-exp
-- kernel, overflow-safe) in use.

-- ── Half-weight Adam update. Cast the HalfTensor weight to a temp f64
-- Tensor, run the existing adam_update_raw in-place on the temp, pack
-- the updated f64 back into the HalfTensor's underlying packed-half
-- float_arr. Adam state (m, v) stays f64. No identity change to the
-- HalfTensor cell — callers keep their reference.
half_adam_update w_h dw_t st lr =
  match w_h | HalfTensor h_data shape _ ->
    let t = tensor_of_half w_h
    let t_data = unwrap t
    let dw_data = unwrap dw_t
    let _ = adam_update_raw t_data dw_data st lr adam_default_b1 adam_default_b2 adam_default_eps
    let n = list_product shape
    let _ = tgl_f64_to_half t_data h_data n
    0

-- ── Walk a 9-weight block list and cast each entry to HalfTensor.
cast_block_to_half b =
  let w_q = half_of_tensor (list_nth 0 b)
  let w_k = half_of_tensor (list_nth 1 b)
  let w_v = half_of_tensor (list_nth 2 b)
  let w_o = half_of_tensor (list_nth 3 b)
  let w_gate = half_of_tensor (list_nth 4 b)
  let w_up = half_of_tensor (list_nth 5 b)
  let w_down = half_of_tensor (list_nth 6 b)
  let g1 = half_of_tensor (list_nth 7 b)
  let g2 = half_of_tensor (list_nth 8 b)
  cons w_q (cons w_k (cons w_v (cons w_o (cons w_gate (cons w_up (cons w_down (cons g1 (cons g2 []))))))))

init_weight arr n seed = init_w_loop arr n seed 0

init_w_loop arr n seed i =
  if i >= n then 0
  else
    let raw = ((i * 97 + seed * 13) % 100) - 50
    let _ = float_arr_set arr i (0.01 * int_to_float raw)
    init_w_loop arr n (seed + 1) (i + 1)

unwrap t = match t | Tensor d _ _ -> d

ones_loop_m arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 1.0
    ones_loop_m arr n (i + 1)

-- ── Fast corpus → float_arr of ids.
-- Counted loop avoids the O(n²) `length cs == 0` check that encode_loop
-- in stdlib/tokenizer.rail uses. At n=9250 the naïve encode is 85M ops,
-- this one is O(n * V) ≈ 740K ops.
enc_fast_loop arr cs vocab i n =
  if i >= n then 0
  else
    let c = head cs
    let id = char_id vocab c
    let _ = float_arr_set arr i (int_to_float id)
    enc_fast_loop arr (tail cs) vocab (i + 1) n

encode_into_arr arr text vocab =
  let cs = chars text
  let n = length cs
  let _ = enc_fast_loop arr cs vocab 0 n
  n

-- ── LCG rng. State = one int stored in a float_arr[1] (via int↔float
-- bit-lossless for small ints). Modulus 2^31 keeps state in int range.
lcg_state_new seed =
  let a = float_arr_new 1 0.0
  let _ = float_arr_set a 0 (int_to_float seed)
  a

lcg_next state =
  let s = float_to_int (float_arr_get state 0)
  let new_s = (s * 1664525 + 1013904223) % 2147483648
  let _ = float_arr_set state 0 (int_to_float new_s)
  new_s

-- ── Zero a range of a float_arr before we refill it.
zero_range arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 0.0
    zero_range arr n (i + 1)

-- ── Fill x (shape [seq, V]) with one-hot vectors for ids_arr[offset..
-- offset+seq-1], and labels (shape [seq]) with ids_arr[offset+1..
-- offset+seq]. x is zeroed first because the previous step's one-hots
-- sit in the same scratch.
fill_onehot_arr dst ids_arr V seq offset i =
  if i >= seq then 0
  else
    let c = float_to_int (float_arr_get ids_arr (offset + i))
    let _ = float_arr_set dst (i * V + c) 1.0
    fill_onehot_arr dst ids_arr V seq offset (i + 1)

fill_labels_arr arr ids_arr seq offset i =
  if i >= seq then 0
  else
    let id = float_arr_get ids_arr (offset + i + 1)
    let _ = float_arr_set arr i id
    fill_labels_arr arr ids_arr seq offset (i + 1)

-- Given batch_ctx, sample a fresh chunk in place into x_data and labels_data.
-- batch_ctx layout (Phase 5h.2): [x, labels, ids_arr, rng, corpus_len,
-- eval_offsets, mask_global, mask_chunk].
-- Indices 0-5 unchanged from Phase 1d; 6 + 7 added for loss masking.
sample_chunk batch_ctx V seq =
  let x = list_nth 0 batch_ctx
  let labels = list_nth 1 batch_ctx
  let ids_arr = list_nth 2 batch_ctx
  let rng = list_nth 3 batch_ctx
  let corpus_len = list_nth 4 batch_ctx
  let mask_global = list_nth 6 batch_ctx
  let mask_chunk = list_nth 7 batch_ctx
  let r = lcg_next rng
  -- Ensure offset + seq + 1 <= corpus_len (need labels[seq-1] = ids[offset+seq])
  let max_off = corpus_len - seq - 1
  let offset = r % max_off
  match x | Tensor xd _ _ ->
    match labels | Tensor ld _ _ ->
      match mask_chunk | Tensor mcd _ _ ->
        let _ = zero_range xd (seq * V) 0
        let _ = fill_onehot_arr xd ids_arr V seq offset 0
        let _ = fill_labels_arr ld ids_arr seq offset 0
        let _ = fill_mask_chunk_arr mcd mask_global seq offset 0
        offset

-- Variant of sample_chunk that takes a FIXED offset (for held-out eval).
-- Does not consume the training rng. Eval uses unmasked CE so we don't
-- bother filling the mask_chunk here — m_eval_loss / m_eval_multi_loop
-- call the unmasked m_ce_loss path.
sample_chunk_at batch_ctx V seq offset =
  let x = list_nth 0 batch_ctx
  let labels = list_nth 1 batch_ctx
  let ids_arr = list_nth 2 batch_ctx
  match x | Tensor xd _ _ ->
    match labels | Tensor ld _ _ ->
      let _ = zero_range xd (seq * V) 0
      let _ = fill_onehot_arr xd ids_arr V seq offset 0
      let _ = fill_labels_arr ld ids_arr seq offset 0
      offset

-- Generate n fixed eval offsets once at startup, using a SEPARATE lcg seed
-- so training rng sees the same sequence it would without the eval set.
-- Returns a float_arr of length n holding offsets as ints-in-floats.
gen_eval_offsets n max_off seed =
  let offsets = float_arr_new n 0.0
  let eval_rng = lcg_state_new seed
  let _ = gen_eval_loop offsets eval_rng n max_off 0
  offsets

gen_eval_loop offsets rng n max_off i =
  if i >= n then 0
  else
    let r = lcg_next rng
    let off = r % max_off
    let _ = float_arr_set offsets i (int_to_float off)
    gen_eval_loop offsets rng n max_off (i + 1)

-- ─────────────────────────────────────────────────────────────────────
-- Phase 5h.2 — Loss masking
-- ─────────────────────────────────────────────────────────────────────
-- Build a global per-char mask over the full corpus. Mask=1.0 for chars
-- the model should predict (stdlib code + content inside <FIXED>...<END>);
-- mask=0.0 for chars whose gradient we want to suppress (BROKEN/DIAG
-- content + the protocol marker tokens themselves). At sample time we
-- slice this mask the same way we slice ids → labels, so each chunk's
-- mask vector matches its labels vector position-for-position.

-- Find first occurrence of `needle` in `haystack` at or after `from_pos`,
-- returning -1 if not found. CRITICAL: hl (length of haystack) is passed
-- explicitly. `length (chars haystack)` allocates a 1.25M-element list and
-- walks it; doing that per call to find_from blew up an overnight smoke
-- run (~407 CPU minutes before kill).
find_from_text needle haystack hl from_pos =
  let nl = length (chars needle)
  find_from_loop needle nl haystack hl from_pos

find_from_loop needle nl haystack hl pos =
  if pos < 0 then 0 - 1
  else if pos > hl - nl then 0 - 1
  else
    let sub = str_sub haystack pos nl
    if sub == needle then pos
    else find_from_loop needle nl haystack hl (pos + 1)

-- Fill mask_arr[start..end_excl] with `value`.
fill_range_arr arr start end_excl value =
  if start >= end_excl then 0
  else
    let _ = float_arr_set arr start value
    fill_range_arr arr (start + 1) end_excl value

-- Walk the triples region marking each <FIXED>\n...<END>\n\n block's
-- CONTENT (between the two markers, marker bytes themselves stay 0).
mark_fixed_blocks_loop mask text n cur =
  if cur >= n then 0
  else
    let fixed_start = find_from_text "<FIXED>\n" text n cur
    if fixed_start < 0 then 0
    else
      let content_start = fixed_start + 8  -- length of "<FIXED>\n"
      let end_start = find_from_text "<END>" text n content_start
      if end_start < 0 then 0
      else
        let _ = fill_range_arr mask content_start end_start 1.0
        mark_fixed_blocks_loop mask text n end_start

build_loss_mask text n =
  -- v0.4e — NO MASK: every position contributes equally. float_arr_new
  -- already initializes every element to 1.0, so fill_range_arr is
  -- redundant — and at the larger 7.24MB corpus it self-recurses with
  -- a float param past the stack overflow point (Rail's float-TCO is
  -- deferred, so float-bearing self-loops do not get tail-call
  -- optimization). Skip the fill.
  float_arr_new n 1.0

-- Slice mask_global[offset..offset+seq-1] into the per-chunk mask Tensor's
-- internal float_arr. Symmetric to fill_labels_arr.
fill_mask_chunk_arr arr mask_arr seq offset i =
  if i >= seq then 0
  else
    let m = float_arr_get mask_arr (offset + i)
    let _ = float_arr_set arr i m
    fill_mask_chunk_arr arr mask_arr seq offset (i + 1)

-- Sum over the chunk's mask = number of "kept" (unmasked) positions.
mask_sum_loop arr seq i acc =
  if i >= seq then acc
  else
    let m = float_arr_get arr i
    mask_sum_loop arr seq (i + 1) (acc + m)

-- Masked CE loss: sum of -log p(target) over kept positions, divided by
-- max(1, n_kept). Equivalent to standard CE on a sub-batch of kept tokens.
m_ce_loss_masked_loop pd ld mask seq V acc i =
  if i >= seq then 0
  else
    let m = float_arr_get mask i
    if m < 0.5 then m_ce_loss_masked_loop pd ld mask seq V acc (i + 1)
    else
      let target = float_to_int (float_arr_get ld i)
      let p = float_arr_get pd (i * V + target)
      let p2 = if p < 0.00000001 then 0.00000001 else p
      let cur = float_arr_get acc 0
      let _ = float_arr_set acc 0 (cur - log p2)
      m_ce_loss_masked_loop pd ld mask seq V acc (i + 1)

m_ce_loss_masked probs labels mask seq V n_kept = match probs
  | Tensor pd _ _ -> match labels
    | Tensor ld _ _ -> match mask
      | Tensor md _ _ ->
        let acc = float_arr_new 1 0.0
        let _ = m_ce_loss_masked_loop pd ld md seq V acc 0
        let denom = if n_kept < 1.0 then 1.0 else n_kept
        (float_arr_get acc 0) / denom

-- Masked CE grad: zero-gradient on mask=0 positions; on kept positions,
-- normalize by 1/n_kept (NOT 1/seq) so each kept token contributes equal
-- weight regardless of how many other tokens were masked in this chunk.
m_ce_grad_masked_loop dst probs labels mask seq V invKept i =
  if i >= seq * V then 0
  else
    let row = i / V
    let col = i % V
    let m = float_arr_get mask row
    let target = float_to_int (float_arr_get labels row)
    let p = float_arr_get probs i
    let g_raw = if col == target then (p - 1.0) * invKept else p * invKept
    let g = g_raw * m
    let _ = float_arr_set dst i g
    m_ce_grad_masked_loop dst probs labels mask seq V invKept (i + 1)

-- ── Standard cross-entropy + grad (identical to lm_v3_multi).
-- Kept for held-out eval (m_eval_loss / m_eval_multi_loop) so the eval
-- number reflects raw next-token CE on each chunk, comparable across runs.
m_ce_loss_loop pd ld seq V acc i =
  if i >= seq then 0
  else
    let target = float_to_int (float_arr_get ld i)
    let p = float_arr_get pd (i * V + target)
    let p2 = if p < 0.00000001 then 0.00000001 else p
    let cur = float_arr_get acc 0
    let _ = float_arr_set acc 0 (cur - log p2)
    m_ce_loss_loop pd ld seq V acc (i + 1)

m_ce_loss probs labels seq V = match probs
  | Tensor pd _ _ -> match labels
    | Tensor ld _ _ ->
      let acc = float_arr_new 1 0.0
      let _ = m_ce_loss_loop pd ld seq V acc 0
      (float_arr_get acc 0) / int_to_float seq

m_ce_grad_loop dst probs labels seq V invN i =
  if i >= seq * V then 0
  else
    let row = i / V
    let col = i % V
    let target = float_to_int (float_arr_get labels row)
    let p = float_arr_get probs i
    let g = if col == target then (p - 1.0) * invN else p * invN
    let _ = float_arr_set dst i g
    m_ce_grad_loop dst probs labels seq V invN (i + 1)

m_hadamard_loop ad bd cd n i =
  if i >= n then 0
  else
    let a = float_arr_get ad i
    let b = float_arr_get bd i
    let _ = float_arr_set cd i (a * b)
    m_hadamard_loop ad bd cd n (i + 1)

m_hadamard a b = match a
  | Tensor ad a_shape _ -> match b
    | Tensor bd _ _ ->
      let n = list_product a_shape
      let cd = float_arr_new n 0.0
      let _ = m_hadamard_loop ad bd cd n 0
      Tensor cd a_shape (compute_strides a_shape)

-- ── Block forward — HalfTensor weights + HalfTensor activations.
-- rmsnorm_save, rope_apply, apply_causal_mask_loop, silu_forward all
-- stay f64 with local tensor_of_half / half_of_tensor wrappers. These
-- are narrow-band per-element ops; fp16 savings are small and
-- precision loss hurts disproportionately.
-- The 9 matmuls use matmul_half (zero-cast). 4 of softmax/scale/add/
-- transpose use shim versions that swap to real half kernels as Mini
-- lands them.
-- Cache saves HalfTensor for activations, Tensor for rstd/h_gate_sig
-- (produced by f64 path). m_block_bwd casts as needed.
m_block_fwd x_h w_block seq d =
  let w_q = list_nth 0 w_block
  let w_k = list_nth 1 w_block
  let w_v = list_nth 2 w_block
  let w_o = list_nth 3 w_block
  let w_gate = list_nth 4 w_block
  let w_up = list_nth 5 w_block
  let w_down = list_nth 6 w_block
  let g1 = list_nth 7 w_block
  let g2 = list_nth 8 w_block

  let x_f = tensor_of_half x_h
  let g1_f = tensor_of_half g1
  let pack1 = rmsnorm_save x_f g1_f
  let ln1_f = head pack1
  let rstd1 = head (tail pack1)
  let ln1 = half_of_tensor ln1_f

  let q = matmul_half ln1 w_q
  let k = matmul_half ln1 w_k
  let v = matmul_half ln1 w_v
  let q_f = tensor_of_half q
  let k_f = tensor_of_half k
  let _ = rope_apply q_f
  let _ = rope_apply k_f
  let q_post = half_of_tensor q_f
  let k_post = half_of_tensor k_f

  let kt = transpose_half k_post
  let scores = matmul_half q_post kt
  let scale = 1.0 / sqrt (int_to_float d)
  let scaled = scale_half scores scale
  let scaled_f = tensor_of_half scaled
  let sd = unwrap scaled_f
  let _ = apply_causal_mask_loop sd seq 0 0
  let scaled_masked = half_of_tensor scaled_f
  let attn = softmax_half scaled_masked
  let attn_val = matmul_half attn v
  let attn_out = matmul_half attn_val w_o
  let x_attn = add_half x_h attn_out

  let x_attn_f = tensor_of_half x_attn
  let g2_f = tensor_of_half g2
  let pack2 = rmsnorm_save x_attn_f g2_f
  let ln2_f = head pack2
  let rstd2 = head (tail pack2)
  let ln2 = half_of_tensor ln2_f

  let h_gate = matmul_half ln2 w_gate
  let h_up = matmul_half ln2 w_up
  let h_gate_f_pre = tensor_of_half h_gate
  let silu_pack = silu_forward h_gate_f_pre
  let h_gate_silu_f = head silu_pack
  let h_gate_sig = head (tail silu_pack)
  let h_up_f = tensor_of_half h_up
  let h_act_f = m_hadamard h_gate_silu_f h_up_f
  let h_act = half_of_tensor h_act_f
  let h_out = matmul_half h_act w_down
  let x_out = add_half x_attn h_out

  let r0 = cons rstd2 []
  let r1 = cons rstd1 r0
  let r2 = cons h_act r1
  let r3 = cons h_gate_sig r2
  let r4 = cons h_up r3
  let r5 = cons h_gate r4
  let r6 = cons ln2 r5
  let r7 = cons x_attn r6
  let r8 = cons attn_val r7
  let r9 = cons attn r8
  let r10 = cons v r9
  let r11 = cons k_post r10
  let r12 = cons q_post r11
  let r13 = cons ln1 r12
  let r14 = cons x_h r13
  cons x_out r14

-- ── Block backward — receives HalfTensor dx_out, HalfTensor w_block,
-- and cache with mixed HalfTensor/Tensor entries. Casts all halves
-- to f64 at entry; returns grads as Tensor (for f64 adam_update_raw).
-- Adam-step caller (m_train_step) packs each grad's update back into
-- the corresponding HalfTensor slot via half_adam_update.
m_block_bwd dx_out_h cache w_block_h seq d =
  let dx_out = tensor_of_half dx_out_h
  let x_in = tensor_of_half (list_nth 1 cache)
  let ln1 = tensor_of_half (list_nth 2 cache)
  let q = tensor_of_half (list_nth 3 cache)
  let k = tensor_of_half (list_nth 4 cache)
  let v = tensor_of_half (list_nth 5 cache)
  let attn = tensor_of_half (list_nth 6 cache)
  let attn_val = tensor_of_half (list_nth 7 cache)
  let x_attn = tensor_of_half (list_nth 8 cache)
  let ln2 = tensor_of_half (list_nth 9 cache)
  let h_gate = tensor_of_half (list_nth 10 cache)
  let h_up = tensor_of_half (list_nth 11 cache)
  let h_gate_sig = list_nth 12 cache
  let h_act = tensor_of_half (list_nth 13 cache)
  let rstd1 = list_nth 14 cache
  let rstd2 = list_nth 15 cache
  let w_q = tensor_of_half (list_nth 0 w_block_h)
  let w_k = tensor_of_half (list_nth 1 w_block_h)
  let w_v = tensor_of_half (list_nth 2 w_block_h)
  let w_o = tensor_of_half (list_nth 3 w_block_h)
  let w_gate = tensor_of_half (list_nth 4 w_block_h)
  let w_up = tensor_of_half (list_nth 5 w_block_h)
  let w_down = tensor_of_half (list_nth 6 w_block_h)
  let g1 = tensor_of_half (list_nth 7 w_block_h)
  let g2 = tensor_of_half (list_nth 8 w_block_h)

  let dffn_out = dx_out
  let hact_T = tensor_transpose h_act
  let d_wdown = matmul hact_T dffn_out
  let wdown_T = tensor_transpose w_down
  let dh_act = matmul dffn_out wdown_T
  let hg_d = unwrap h_gate
  let d_ff = 3 * d
  let hg_n = seq * d_ff
  let h_gate_silu_d = float_arr_new hg_n 0.0
  let _ = m_hadamard_loop hg_d h_gate_sig h_gate_silu_d hg_n 0
  let h_gate_silu = Tensor h_gate_silu_d (cons seq (cons d_ff [])) (compute_strides (cons seq (cons d_ff [])))
  let dh_up = m_hadamard dh_act h_gate_silu
  let dh_silu = m_hadamard dh_act h_up
  let dh_gate = silu_backward h_gate dh_silu h_gate_sig
  let ln2_T = tensor_transpose ln2
  let d_wgate = matmul ln2_T dh_gate
  let d_wup = matmul ln2_T dh_up
  let wgate_T = tensor_transpose w_gate
  let wup_T = tensor_transpose w_up
  let d_ln2_gate = matmul dh_gate wgate_T
  let d_ln2_up = matmul dh_up wup_T
  let d_ln2_out = tensor_add d_ln2_gate d_ln2_up

  let d_x_attn_ln = rmsnorm_backward_dx x_attn g2 rstd2 d_ln2_out
  let d_g2 = rmsnorm_backward_gamma x_attn rstd2 d_ln2_out
  let dx_attn = tensor_add dx_out d_x_attn_ln

  let dattn_out = dx_attn
  let attn_val_T = tensor_transpose attn_val
  let d_wo = matmul attn_val_T dattn_out
  let wo_T = tensor_transpose w_o
  let d_attn_val = matmul dattn_out wo_T
  let (d_q_rot, d_k_rot, d_v_proj) = attention_backward q k v attn d_attn_val
  let _ = rope_apply_inverse d_q_rot
  let _ = rope_apply_inverse d_k_rot

  let ln1_T = tensor_transpose ln1
  let d_wq = matmul ln1_T d_q_rot
  let d_wk = matmul ln1_T d_k_rot
  let d_wv = matmul ln1_T d_v_proj
  let wq_T = tensor_transpose w_q
  let wk_T = tensor_transpose w_k
  let wv_T = tensor_transpose w_v
  let dx_q = matmul d_q_rot wq_T
  let dx_k = matmul d_k_rot wk_T
  let dx_v = matmul d_v_proj wv_T
  let dx_qk = tensor_add dx_q dx_k
  let d_ln1_out = tensor_add dx_qk dx_v

  let d_x_in_ln = rmsnorm_backward_dx x_in g1 rstd1 d_ln1_out
  let d_g1 = rmsnorm_backward_gamma x_in rstd1 d_ln1_out
  let dx_in = tensor_add dx_attn d_x_in_ln

  let g0 = cons d_g2 []
  let gA = cons d_g1 g0
  let gB = cons d_wdown gA
  let g1g = cons d_wup gB
  let g2g = cons d_wgate g1g
  let g3g = cons d_wo g2g
  let g4g = cons d_wv g3g
  let g5g = cons d_wk g4g
  let g6g = cons d_wq g5g
  cons dx_in g6g

-- ── Forward pass. Input x is one-hot Tensor (stays f64 so training
-- loop's bwd xT * dx_embed is unchanged). Cast to HalfTensor once at
-- entry; run the full tower on HalfTensors; cast back to Tensor for
-- CE loss. Weights (w_e_h, blocks_h, gf_h) are HalfTensor throughout.
m_forward x w_e_h blocks_h gf_h seq V d =
  let x_h = half_of_tensor x
  let x_embed = matmul_half x_h w_e_h

  let b0_weights_h = list_nth 0 blocks_h
  let cache0 = m_block_fwd x_embed b0_weights_h seq d
  let x_after_b0 = head cache0

  let b1_weights_h = list_nth 1 blocks_h
  let cache1 = m_block_fwd x_after_b0 b1_weights_h seq d
  let x_after_b1_h = head cache1

  let x_after_b1 = tensor_of_half x_after_b1_h
  let gf_f = tensor_of_half gf_h
  let packf = rmsnorm_save x_after_b1 gf_f
  let x_final = head packf
  let rstd_final = head (tail packf)

  let x_final_h = half_of_tensor x_final
  let we_t_h = transpose_half w_e_h
  let logits_h = matmul_half x_final_h we_t_h
  let logits = tensor_of_half logits_h
  let probs = tensor_softmax logits

  let r0 = cons x_embed []
  let r1 = cons cache0 r0
  let r2 = cons cache1 r1
  let r3 = cons rstd_final r2
  let r4 = cons x_final r3
  cons probs r4

-- ── Training step. x is f64 Tensor (one-hot); all weights are
-- HalfTensor. Forward runs on halves, bwd casts to f64 at each
-- m_block_bwd entry, adam updates use half_adam_update to pack the
-- updated f64 weight back into the HalfTensor cell in place.
m_train_step x labels mask_chunk blocks_h w_e_h gf_h adams_e adams_gf adams_blocks seq V d dlog_buf lr =
  let result = m_forward x w_e_h blocks_h gf_h seq V d
  let probs = list_nth 0 result
  let x_final = list_nth 1 result
  let rstd_final = list_nth 2 result
  let cache1 = list_nth 3 result
  let cache0 = list_nth 4 result

  -- γ LR multiplier: RMSNorm γs learn too fast at global lr; ported from
  -- lm_v3_chunked_4block.rail:425 (tuning from commit 924e0c5). Applied to
  -- gf + g1/g2 across both blocks — 5 γ tensors total at depth=2.
  let lr_g = lr * adam_lr_mult_gamma

  -- Phase 5h.2: masked CE. n_kept counts unmasked positions; loss is the
  -- per-kept-token CE; gradient zeros masked positions and normalizes by
  -- 1/n_kept so each kept token contributes unit weight regardless of
  -- how many other positions in this chunk were masked.
  match mask_chunk | Tensor mcd _ _ -> match probs | Tensor pd _ _ -> match labels | Tensor ld _ _ ->
    let n_kept = mask_sum_loop mcd seq 0 0.0
    let loss = m_ce_loss_masked probs labels mask_chunk seq V n_kept
    let invKept = if n_kept < 1.0 then 0.0 else 1.0 / n_kept
    let _ = m_ce_grad_masked_loop dlog_buf pd ld mcd seq V invKept 0
    let dlog_t = Tensor dlog_buf (cons seq (cons V [])) (compute_strides (cons seq (cons V [])))

    let w_e_f = tensor_of_half w_e_h
    let dx_final_head = matmul dlog_t w_e_f
    let dlog_T = tensor_transpose dlog_t
    let d_we_head = matmul dlog_T x_final

    let x_block_final_h = list_nth 0 cache1
    let x_block_final = tensor_of_half x_block_final_h
    let gf_f = tensor_of_half gf_h
    let dx_block_final_f = rmsnorm_backward_dx x_block_final gf_f rstd_final dx_final_head
    let d_gf = rmsnorm_backward_gamma x_block_final rstd_final dx_final_head
    let dx_block_final = half_of_tensor dx_block_final_f

    let b1_weights = list_nth 1 blocks_h
    let grads1 = m_block_bwd dx_block_final cache1 b1_weights seq d
    let dx_after_b0 = list_nth 0 grads1
    let d_wq1 = list_nth 1 grads1
    let d_wk1 = list_nth 2 grads1
    let d_wv1 = list_nth 3 grads1
    let d_wo1 = list_nth 4 grads1
    let d_wgate1 = list_nth 5 grads1
    let d_wup1 = list_nth 6 grads1
    let d_wdown1 = list_nth 7 grads1
    let d_g1_b1 = list_nth 8 grads1
    let d_g2_b1 = list_nth 9 grads1

    let dx_after_b0_h = half_of_tensor dx_after_b0
    let b0_weights = list_nth 0 blocks_h
    let grads0 = m_block_bwd dx_after_b0_h cache0 b0_weights seq d
    let dx_embed = list_nth 0 grads0
    let d_wq0 = list_nth 1 grads0
    let d_wk0 = list_nth 2 grads0
    let d_wv0 = list_nth 3 grads0
    let d_wo0 = list_nth 4 grads0
    let d_wgate0 = list_nth 5 grads0
    let d_wup0 = list_nth 6 grads0
    let d_wdown0 = list_nth 7 grads0
    let d_g1_b0 = list_nth 8 grads0
    let d_g2_b0 = list_nth 9 grads0

    let xT = tensor_transpose x
    let d_we_embed = matmul xT dx_embed
    let d_we = tensor_add d_we_head d_we_embed

    let st_we = list_nth 0 adams_e
    let _ = half_adam_update w_e_h d_we st_we lr

    let st_gf = list_nth 0 adams_gf
    let _ = half_adam_update gf_h d_gf st_gf lr_g

    let b0_adams = list_nth 0 adams_blocks
    let _ = half_adam_update (list_nth 0 b0_weights) d_wq0 (list_nth 0 b0_adams) lr
    let _ = half_adam_update (list_nth 1 b0_weights) d_wk0 (list_nth 1 b0_adams) lr
    let _ = half_adam_update (list_nth 2 b0_weights) d_wv0 (list_nth 2 b0_adams) lr
    let _ = half_adam_update (list_nth 3 b0_weights) d_wo0 (list_nth 3 b0_adams) lr
    let _ = half_adam_update (list_nth 4 b0_weights) d_wgate0 (list_nth 4 b0_adams) lr
    let _ = half_adam_update (list_nth 5 b0_weights) d_wup0 (list_nth 5 b0_adams) lr
    let _ = half_adam_update (list_nth 6 b0_weights) d_wdown0 (list_nth 6 b0_adams) lr
    let _ = half_adam_update (list_nth 7 b0_weights) d_g1_b0 (list_nth 7 b0_adams) lr_g
    let _ = half_adam_update (list_nth 8 b0_weights) d_g2_b0 (list_nth 8 b0_adams) lr_g

    let b1_adams = list_nth 1 adams_blocks
    let _ = half_adam_update (list_nth 0 b1_weights) d_wq1 (list_nth 0 b1_adams) lr
    let _ = half_adam_update (list_nth 1 b1_weights) d_wk1 (list_nth 1 b1_adams) lr
    let _ = half_adam_update (list_nth 2 b1_weights) d_wv1 (list_nth 2 b1_adams) lr
    let _ = half_adam_update (list_nth 3 b1_weights) d_wo1 (list_nth 3 b1_adams) lr
    let _ = half_adam_update (list_nth 4 b1_weights) d_wgate1 (list_nth 4 b1_adams) lr
    let _ = half_adam_update (list_nth 5 b1_weights) d_wup1 (list_nth 5 b1_adams) lr
    let _ = half_adam_update (list_nth 6 b1_weights) d_wdown1 (list_nth 6 b1_adams) lr
    let _ = half_adam_update (list_nth 7 b1_weights) d_g1_b1 (list_nth 7 b1_adams) lr_g
    let _ = half_adam_update (list_nth 8 b1_weights) d_g2_b1 (list_nth 8 b1_adams) lr_g
    loss

-- v66: same fwd + bwd as m_train_step but RETURNS grads instead of applying
-- Adam. `scale` multiplies into 1/n_kept so per-step gradient is pre-scaled
-- (caller passes alpha or 1-alpha). Loss is written to loss_buf[0]. Returns
-- a flat list of 20 grad Tensors mirroring weights_flat order:
--   [d_we, d_gf, d_wq0, d_wk0, d_wv0, d_wo0, d_wgate0, d_wup0, d_wdown0,
--    d_g1_b0, d_g2_b0, d_wq1, d_wk1, d_wv1, d_wo1, d_wgate1, d_wup1, d_wdown1,
--    d_g1_b1, d_g2_b1]
m_compute_grads x labels mask_chunk blocks_h w_e_h gf_h seq V d dlog_buf scale loss_buf =
  let result = m_forward x w_e_h blocks_h gf_h seq V d
  let probs = list_nth 0 result
  let x_final = list_nth 1 result
  let rstd_final = list_nth 2 result
  let cache1 = list_nth 3 result
  let cache0 = list_nth 4 result

  match mask_chunk | Tensor mcd _ _ -> match probs | Tensor pd _ _ -> match labels | Tensor ld _ _ ->
    let n_kept = mask_sum_loop mcd seq 0 0.0
    let loss = m_ce_loss_masked probs labels mask_chunk seq V n_kept
    let _ = float_arr_set loss_buf 0 loss
    let invKept = if n_kept < 1.0 then 0.0 else scale / n_kept
    let _ = m_ce_grad_masked_loop dlog_buf pd ld mcd seq V invKept 0
    let dlog_t = Tensor dlog_buf (cons seq (cons V [])) (compute_strides (cons seq (cons V [])))

    let w_e_f = tensor_of_half w_e_h
    let dx_final_head = matmul dlog_t w_e_f
    let dlog_T = tensor_transpose dlog_t
    let d_we_head = matmul dlog_T x_final

    let x_block_final_h = list_nth 0 cache1
    let x_block_final = tensor_of_half x_block_final_h
    let gf_f = tensor_of_half gf_h
    let dx_block_final_f = rmsnorm_backward_dx x_block_final gf_f rstd_final dx_final_head
    let d_gf = rmsnorm_backward_gamma x_block_final rstd_final dx_final_head
    let dx_block_final = half_of_tensor dx_block_final_f

    let b1_weights = list_nth 1 blocks_h
    let grads1 = m_block_bwd dx_block_final cache1 b1_weights seq d
    let dx_after_b0 = list_nth 0 grads1
    let d_wq1 = list_nth 1 grads1
    let d_wk1 = list_nth 2 grads1
    let d_wv1 = list_nth 3 grads1
    let d_wo1 = list_nth 4 grads1
    let d_wgate1 = list_nth 5 grads1
    let d_wup1 = list_nth 6 grads1
    let d_wdown1 = list_nth 7 grads1
    let d_g1_b1 = list_nth 8 grads1
    let d_g2_b1 = list_nth 9 grads1

    let dx_after_b0_h = half_of_tensor dx_after_b0
    let b0_weights = list_nth 0 blocks_h
    let grads0 = m_block_bwd dx_after_b0_h cache0 b0_weights seq d
    let dx_embed = list_nth 0 grads0
    let d_wq0 = list_nth 1 grads0
    let d_wk0 = list_nth 2 grads0
    let d_wv0 = list_nth 3 grads0
    let d_wo0 = list_nth 4 grads0
    let d_wgate0 = list_nth 5 grads0
    let d_wup0 = list_nth 6 grads0
    let d_wdown0 = list_nth 7 grads0
    let d_g1_b0 = list_nth 8 grads0
    let d_g2_b0 = list_nth 9 grads0

    let xT = tensor_transpose x
    let d_we_embed = matmul xT dx_embed
    let d_we = tensor_add d_we_head d_we_embed

    let g0 = cons d_g2_b1 []
    let g1 = cons d_g1_b1 g0
    let g2 = cons d_wdown1 g1
    let g3 = cons d_wup1 g2
    let g4 = cons d_wgate1 g3
    let g5 = cons d_wo1 g4
    let g6 = cons d_wv1 g5
    let g7 = cons d_wk1 g6
    let g8 = cons d_wq1 g7
    let g9 = cons d_g2_b0 g8
    let g10 = cons d_g1_b0 g9
    let g11 = cons d_wdown0 g10
    let g12 = cons d_wup0 g11
    let g13 = cons d_wgate0 g12
    let g14 = cons d_wo0 g13
    let g15 = cons d_wv0 g14
    let g16 = cons d_wk0 g15
    let g17 = cons d_wq0 g16
    let g18 = cons d_gf g17
    cons d_we g18

-- Element-wise sum of two grad lists (parallel index). Returns a new list
-- of 20 Tensors. Uses tensor_add which allocates fresh; arena_reset at the
-- outer step boundary will free.
combine_grads_loop ga gb i =
  if i >= 20 then []
  else
    let g_a = list_nth i ga
    let g_b = list_nth i gb
    let combined = tensor_add g_a g_b
    cons combined (combine_grads_loop ga gb (i + 1))

-- Apply Adam to each weight using its corresponding grad and state. Uses
-- lr for non-gamma weights, lr_g for gamma weights (indices 1, 9, 10, 18, 19).
apply_adam_flat_loop weights states grads lr lr_g i =
  if i >= 20 then 0
  else
    let w = list_nth i weights
    let g = list_nth i grads
    let s = list_nth i states
    let is_gamma = if i == 1 then 1
                   else if i == 9 then 1
                   else if i == 10 then 1
                   else if i == 18 then 1
                   else if i == 19 then 1
                   else 0
    let cur_lr = if is_gamma == 1 then lr_g else lr
    let _ = half_adam_update w g s cur_lr
    apply_adam_flat_loop weights states grads lr lr_g (i + 1)

-- Two-loss-head step. Forwards both corpora through CURRENT weights, computes
-- gradient lists scaled by alpha and (1-alpha), sums them, and applies a
-- single Adam update. This is the key architectural change vs v62/v63's
-- step-interleave: Adam moments see ONE combined gradient per step, not
-- alternating per-corpus full gradients.
m_two_head_step ctx_a ctx_b weights_flat states_flat blocks_h w_e_h gf_h seq V d dlog_buf alpha lr loss_buf_a loss_buf_b =
  let lr_g = lr * adam_lr_mult_gamma
  let x_a = list_nth 0 ctx_a
  let labels_a = list_nth 1 ctx_a
  let mask_a = list_nth 7 ctx_a
  let x_b = list_nth 0 ctx_b
  let labels_b = list_nth 1 ctx_b
  let mask_b = list_nth 7 ctx_b
  let grads_a = m_compute_grads x_a labels_a mask_a blocks_h w_e_h gf_h seq V d dlog_buf alpha loss_buf_a
  let grads_b = m_compute_grads x_b labels_b mask_b blocks_h w_e_h gf_h seq V d dlog_buf (1.0 - alpha) loss_buf_b
  let combined = combine_grads_loop grads_a grads_b 0
  let _ = apply_adam_flat_loop weights_flat states_flat combined lr lr_g 0
  0

-- v66 two-loss-head: every step samples chunks from BOTH corpora, computes
-- gradient lists scaled by alpha and (1-alpha), sums them, and applies ONE
-- Adam update. Eval uses ctx_a only (same compile.rail held-out as v54).
-- alpha is hardcoded to 0.75 (matches v62's 25% comp ratio in expectation
-- but with combined-gradient semantics). Loss buffers are re-used across
-- steps; the ones logged here are the per-step CE values.
m_train_loop batch_ctx blocks w_e gf adams_e adams_gf adams_blocks seq V d dlog_buf min_buf base_lr warmup max_steps weights_flat adams_flat best_buf ckpt_best step =
  if step >= max_steps then 0
  else
    let ctx_a = list_nth 0 batch_ctx
    let ctx_b = list_nth 1 batch_ctx
    let _ = maybe_rss_snapshot step
    let mean = maybe_eval ctx_a blocks w_e gf seq V d step
    let _ = maybe_save_best mean weights_flat adams_flat best_buf step ckpt_best
    let _ = sample_chunk ctx_a V seq
    let _ = sample_chunk ctx_b V seq
    let lr = cosine_decay step warmup max_steps base_lr
    let mk = arena_mark 0
    let loss_buf_a = float_arr_new 1 0.0
    let loss_buf_b = float_arr_new 1 0.0
    let _ = m_two_head_step ctx_a ctx_b weights_flat adams_flat blocks w_e gf seq V d dlog_buf 0.75 lr loss_buf_a loss_buf_b
    let loss_a = float_arr_get loss_buf_a 0
    let loss_b = float_arr_get loss_buf_b 0
    let combined_loss = 0.75 * loss_a + 0.25 * loss_b
    let _ = arena_reset mk
    let cur_min = float_arr_get min_buf 0
    let new_min = if combined_loss < cur_min then combined_loss else cur_min
    let _ = float_arr_set min_buf 0 new_min
    let _ = print (cat ["step ", show step, "  lr=", show_float lr, "  Lcomb=", show_float combined_loss, "  La=", show_float loss_a, "  Lb=", show_float loss_b])
    m_train_loop batch_ctx blocks w_e gf adams_e adams_gf adams_blocks seq V d dlog_buf min_buf base_lr warmup max_steps weights_flat adams_flat best_buf ckpt_best (step + 1)

m_eval_loss batch_ctx blocks w_e gf seq V d =
  let _ = sample_chunk batch_ctx V seq
  let x = list_nth 0 batch_ctx
  let labels = list_nth 1 batch_ctx
  let result = m_forward x w_e blocks gf seq V d
  let probs = list_nth 0 result
  m_ce_loss probs labels seq V

-- ══════════════════════════════════════════════════════════════════════════════
-- Phase 1d.1 — multi-chunk held-out eval
-- ══════════════════════════════════════════════════════════════════════════════
-- Runs forward-only on n fixed eval offsets. Returns [sum, sqsum] in accum.
-- Caller computes mean = sum/n, std = sqrt(sqsum/n - mean*mean).
-- Accum layout: [sum, sqsum, n_total] — n stored in accum[2] to keep helper
-- loop at 10 params (rail_quirks: keep helpers ≤10 params on Studio binary).
m_eval_multi batch_ctx blocks w_e gf seq V d eval_offsets n =
  let accum = float_arr_new 3 0.0
  let _ = float_arr_set accum 2 (int_to_float n)
  let _ = m_eval_multi_loop batch_ctx blocks w_e gf seq V d eval_offsets accum 0
  accum

m_eval_multi_loop batch_ctx blocks w_e gf seq V d eval_offsets accum i =
  let n = float_to_int (float_arr_get accum 2)
  if i >= n then 0
  else
    let off = float_to_int (float_arr_get eval_offsets i)
    let _ = sample_chunk_at batch_ctx V seq off
    let x = list_nth 0 batch_ctx
    let labels = list_nth 1 batch_ctx
    let mk = arena_mark 0
    let result = m_forward x w_e blocks gf seq V d
    let probs = list_nth 0 result
    let loss = m_ce_loss probs labels seq V
    let _ = arena_reset mk
    let cur_sum = float_arr_get accum 0
    let cur_sqsum = float_arr_get accum 1
    let _ = float_arr_set accum 0 (cur_sum + loss)
    let _ = float_arr_set accum 1 (cur_sqsum + loss * loss)
    m_eval_multi_loop batch_ctx blocks w_e gf seq V d eval_offsets accum (i + 1)

-- min-checkpoint: save when a new best eval mean is hit.
-- best_buf[0] = best mean seen, best_buf[1] = step of best (as float).
-- ckpt_best is the prefix path; weights_flat/adams_flat are the same
-- cons-lists used for the final save (their underlying float_arrs are
-- mutated in-place by Adam, so serializing them here captures the
-- current state of training).
maybe_save_best mean weights_flat adams_flat best_buf step ckpt_best =
  if mean < float_arr_get best_buf 0 then
    let _ = float_arr_set best_buf 0 mean
    let _ = float_arr_set best_buf 1 (int_to_float step)
    let _ = save_half_checkpoint ckpt_best weights_flat adams_flat step mean
    let _ = print (cat ["  >>> new best mean=", show_float mean, " saved at step=", show step])
    0
  else
    0

-- Run a multi-chunk eval iff step is a multiple of eval_interval.
-- Appends "step=X mean=Y std=Z" to eval_log_path. Also prints to stdout
-- so you can see progress live. Eval_offsets sits at batch_ctx[5].
-- Returns the eval mean as a float (or 1.0e30 if not an eval step) so
-- the caller can detect new bests and save min-checkpoints.
maybe_eval batch_ctx blocks w_e gf seq V d step =
  if step % eval_interval == 0 then
    let eval_offsets = list_nth 5 batch_ctx
    let accum = m_eval_multi batch_ctx blocks w_e gf seq V d eval_offsets n_eval_chunks
    let sum = float_arr_get accum 0
    let sqsum = float_arr_get accum 1
    let n_f = int_to_float n_eval_chunks
    let mean = sum / n_f
    let var = (sqsum / n_f) - (mean * mean)
    let std = if var > 0.0 then sqrt var else 0.0
    let msg = cat ["eval@step=", show step, " mean=", show_float mean, " std=", show_float std, " n=", show n_eval_chunks]
    let _ = print msg
    let _ = shell (cat ["echo '", msg, "' >> ", eval_log_path])
    mean
  else
    1.0e30

-- Phase 1d.2 — RSS snapshot via shell. $PPID inside /bin/sh is the calling
-- process (rail_native or the compiled binary). Appends to rss_log_path
-- every rss_interval steps. Diagnostic only — `time -l` still gives peak.
maybe_rss_snapshot step =
  if step % rss_interval == 0 then
    let cmd = cat ["echo \"step=", show step, " rss_kb=$(ps -o rss= -p $PPID 2>/dev/null | tr -d ' ')\" >> ", rss_log_path]
    let _ = shell cmd
    0
  else
    0

mk_block d d_ff seed_base =
  let wq_data = float_arr_new (d * d) 0.0
  let _ = init_scaled wq_data (d * d) d seed_base
  let w_q = Tensor wq_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wk_data = float_arr_new (d * d) 0.0
  let _ = init_scaled wk_data (d * d) d (seed_base + 1)
  let w_k = Tensor wk_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wv_data = float_arr_new (d * d) 0.0
  let _ = init_scaled wv_data (d * d) d (seed_base + 2)
  let w_v = Tensor wv_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wo_data = float_arr_new (d * d) 0.0
  let _ = init_scaled wo_data (d * d) d (seed_base + 3)
  let w_o = Tensor wo_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wgate_data = float_arr_new (d * d_ff) 0.0
  let _ = init_scaled wgate_data (d * d_ff) d (seed_base + 4)
  let w_gate = Tensor wgate_data (cons d (cons d_ff [])) (compute_strides (cons d (cons d_ff [])))
  let wup_data = float_arr_new (d * d_ff) 0.0
  let _ = init_scaled wup_data (d * d_ff) d (seed_base + 5)
  let w_up = Tensor wup_data (cons d (cons d_ff [])) (compute_strides (cons d (cons d_ff [])))
  let wdown_data = float_arr_new (d_ff * d) 0.0
  let _ = init_scaled wdown_data (d_ff * d) d_ff (seed_base + 6)
  let w_down = Tensor wdown_data (cons d_ff (cons d [])) (compute_strides (cons d_ff (cons d [])))
  let g1_data = float_arr_new d 1.0
  let _ = ones_loop_m g1_data d 0
  let g1 = Tensor g1_data (cons d []) (cons 1 [])
  let g2_data = float_arr_new d 1.0
  let _ = ones_loop_m g2_data d 0
  let g2 = Tensor g2_data (cons d []) (cons 1 [])
  cons w_q (cons w_k (cons w_v (cons w_o (cons w_gate (cons w_up (cons w_down (cons g1 (cons g2 []))))))))

mk_block_adams d d_ff =
  let st_q = adam_state (d * d)
  let st_k = adam_state (d * d)
  let st_v = adam_state (d * d)
  let st_o = adam_state (d * d)
  let st_gate = adam_state (d * d_ff)
  let st_up = adam_state (d * d_ff)
  let st_down = adam_state (d_ff * d)
  let st_g1 = adam_state d
  let st_g2 = adam_state d
  cons st_q (cons st_k (cons st_v (cons st_o (cons st_gate (cons st_up (cons st_down (cons st_g1 (cons st_g2 []))))))))

main =
  let _ = print "=== Spur-v62 interleaved (75% compile.rail BQ + 25% comp v3) ==="

  -- Build vocab over UNION of A + B corpora so any char in either is encoded.
  let text_a = read_file corpus_path
  let text_b = read_file phase_b_corpus_path
  let text_union = cat [text_a, "\n", text_b]
  let vocab = build_vocab text_union
  let V = vocab_size vocab
  let _ = print (cat ["[A] chars=", show (length (chars text_a)), "  [B] chars=", show (length (chars text_b)), "  union vocab V=", show V])

  let corpus_len_a = length (chars text_a)
  let ids_arr_a = float_arr_new corpus_len_a 0.0
  let _ = encode_into_arr ids_arr_a text_a vocab
  let corpus_len_b = length (chars text_b)
  let ids_arr_b = float_arr_new corpus_len_b 0.0
  let _ = encode_into_arr ids_arr_b text_b vocab
  let _ = print (cat ["encoded both corpora; max_off A=", show (corpus_len_a - seq_len - 1), " B=", show (corpus_len_b - seq_len - 1)])

  let seq = seq_len

  -- Shared scratch.
  let x_data = float_arr_new (seq * V) 0.0
  let x = Tensor x_data (cons seq (cons V [])) (compute_strides (cons seq (cons V [])))
  let labels_data = float_arr_new seq 0.0
  let labels = Tensor labels_data (cons seq []) (cons 1 [])
  let mask_chunk_data = float_arr_new seq 0.0
  let mask_chunk = Tensor mask_chunk_data (cons seq []) (cons 1 [])

  let rng = lcg_state_new 77

  let eval_offsets_a = gen_eval_offsets n_eval_chunks (corpus_len_a - seq - 1) eval_seed
  let eval_offsets_b = gen_eval_offsets n_eval_chunks (corpus_len_b - seq - 1) eval_seed_b
  let _ = print (cat ["eval sets: A seed=", show eval_seed, " B seed=", show eval_seed_b])

  let mask_global_a = build_loss_mask text_a corpus_len_a
  let mask_global_b = build_loss_mask text_b corpus_len_b

  let _ = shell (cat ["echo '' > ", rss_log_path])
  let _ = shell (cat ["echo '' > ", eval_log_path])

  let batch_ctx_a = cons x (cons labels (cons ids_arr_a (cons rng (cons corpus_len_a (cons eval_offsets_a (cons mask_global_a (cons mask_chunk [])))))))
  let batch_ctx_b = cons x (cons labels (cons ids_arr_b (cons rng (cons corpus_len_b (cons eval_offsets_b (cons mask_global_b (cons mask_chunk [])))))))
  let ctxs = cons batch_ctx_a (cons batch_ctx_b [])

  let d = 256
  let d_ff = 3 * d

  let we_data = float_arr_new (V * d) 0.0
  let _ = init_scaled we_data (V * d) V 1
  let w_e_init = Tensor we_data (cons V (cons d [])) (compute_strides (cons V (cons d [])))
  let w_e = half_of_tensor w_e_init

  let gf_data = float_arr_new d 1.0
  let _ = ones_loop_m gf_data d 0
  let gf_init = Tensor gf_data (cons d []) (cons 1 [])
  let gf = half_of_tensor gf_init

  let block0_init = mk_block d d_ff 100
  let block0 = cast_block_to_half block0_init
  let block1_init = mk_block d d_ff 200
  let block1 = cast_block_to_half block1_init
  let blocks = cons block0 (cons block1 [])

  let st_we = adam_state (V * d)
  let st_gf = adam_state d
  let adams_e = cons st_we []
  let adams_gf = cons st_gf []
  let block0_adams = mk_block_adams d d_ff
  let block1_adams = mk_block_adams d d_ff
  let adams_blocks = cons block0_adams (cons block1_adams [])

  let dlog_buf = float_arr_new (seq * V) 0.0
  let min_buf = float_arr_new 1 1.0e30
  let best_buf = float_arr_new 2 1.0e30
  let _ = float_arr_set best_buf 1 (0.0 - 1.0)

  let base_lr = 0.01
  let warmup = 100
  let max_steps = 3000

  let weights_flat = append (cons w_e (cons gf [])) (append block0 block1)
  let adams_flat = append (cons st_we (cons st_gf [])) (append block0_adams block1_adams)
  let ckpt_final = "training/rail_native/checkpoints/spur_v66_step3000"
  let ckpt_best  = "training/rail_native/checkpoints/spur_v66_best"
  let _ = shell "mkdir -p training/rail_native/checkpoints"

  let loss0 = m_eval_loss batch_ctx_a blocks w_e gf seq V d
  let _ = print (cat ["initial loss (A)=", show_float loss0, "  uniform=", show_float (log (int_to_float V))])
  let _ = print (cat ["training ", show max_steps, " steps with two-loss-head: alpha=0.75 compile.rail + 0.25 comp v3, combined gradient before Adam"])

  let _ = m_train_loop ctxs blocks w_e gf adams_e adams_gf adams_blocks seq V d dlog_buf min_buf base_lr warmup max_steps weights_flat adams_flat best_buf ckpt_best 0

  let loss_a_end = m_eval_loss batch_ctx_a blocks w_e gf seq V d
  let loss_b_end = m_eval_loss batch_ctx_b blocks w_e gf seq V d
  let min_loss = float_arr_get min_buf 0
  let best_mean = float_arr_get best_buf 0
  let best_step = float_to_int (float_arr_get best_buf 1)

  let _ = save_half_checkpoint ckpt_final weights_flat adams_flat max_steps loss_a_end
  let _ = print (cat ["saved final ckpt: ", ckpt_final, " (A_eval=", show_float loss_a_end, " B_eval=", show_float loss_b_end, ")"])
  let _ = print (cat ["best A_eval=", show_float best_mean, " step=", show best_step, " -> ", ckpt_best])
  let _ = print (cat ["min training loss=", show_float min_loss])
  0
