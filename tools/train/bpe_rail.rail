-- bpe_rail.rail — Train a BPE tokenizer on the Rail codebase.
--
-- Reads concatenated stdlib/*.rail + selected tools/*.rail, trains BPE
-- to target_vocab, reports compression ratio, and saves the tokenizer.
import "stdlib/bpe.rail"

main =
  let _ = print "=== BPE tokenizer training on Rail source ==="

  -- Gather corpus. Stream via shell so we don't maintain an explicit
  -- file list inline — easier to extend over time.
  let _ = shell "cat stdlib/*.rail tools/compile.rail tools/train/lm_transformer.rail tools/train/bpe_rail.rail > /tmp/rail_corpus.txt 2>&1"
  let corpus = read_file "/tmp/rail_corpus.txt"
  let n_chars = length (chars corpus)
  let _ = print (cat ["corpus chars: ", show n_chars])

  -- Target vocab size. V=2048 first — BPE training is O(corpus × vocab)
  -- so we want to see it complete before trying V=8192.
  let target_vocab = 2048
  let _ = print (cat ["training BPE to vocab=", show target_vocab, " ..."])

  let bpe = bpe_train corpus target_vocab
  match bpe | BPE merges vocab size ->
    let _ = print (cat ["learned vocab size = ", show size])
    let _ = print (cat ["merges learned = ", show (length merges)])

    -- Encode the corpus and measure compression.
    let ids = bpe_encode bpe corpus
    let n_tokens = length ids
    let _ = print (cat ["tokens = ", show n_tokens, "  (", show n_chars, " chars)"])
    let _ = print (cat ["chars/token = ", show_float (int_to_float n_chars / int_to_float n_tokens)])

    -- Round-trip check on the first 1KB.
    let _ = bpe_save "/tmp/rail_bpe_v2048" bpe
    let _ = print "saved to /tmp/rail_bpe_v2048.{vocab,merges}"
    0
