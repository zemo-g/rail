-- lm_fake_smoke.rail — minimal trainer-shaped script for orchestrator smokes.
-- Has the seed_trainer.sh substitution targets (lcg_state_new, ckpt_best,
-- ckpt_final). Sleeps 3 seconds, writes a fake checkpoint meta, exits 0.

import "stdlib/list.rail"

cat parts = join "" parts

lcg_state_new seed = seed

main =
  let rng = lcg_state_new 77
  let ckpt_best = "training/rail_native/checkpoints/lm_fake_smoke_best"
  let ckpt_final = "training/rail_native/checkpoints/lm_fake_smoke_step3000"
  let _ = print (cat ["fake trainer running, rng=", show rng])
  let _ = shell "sleep 3"
  let _ = write_file ckpt_best "step=10\nbest_val_loss=3.0\n"
  let _ = print (cat ["fake done; ckpt=", ckpt_best])
  0
