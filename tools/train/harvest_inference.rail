-- harvest_inference.rail — Phase 5h.4 model-failure-driven triple harvester.
--
-- Companion to harvest_teacher.rail (which mines an alternative fix
-- for an EXISTING (broken, diag) pair). This harvester instead
-- generates fresh BROKEN snippets by sampling Spur-0.1 itself at
-- temperature 0.8: for each bench-like prompt P we draw N candidates,
-- compile each, and on failure ask the Qwen-3.6 teacher to fix the
-- (candidate, diag) pair. If the teacher's fix compiles cleanly we
-- emit a (broken=candidate, diag, fixed=teacher_fix) triple.
--
-- Why: the v1 harvest_teacher source corpus was mutation-derived
-- BROKEN snippets — synthetic failure modes. This harvester captures
-- ACTUAL inference-time failure modes (the distributional shift
-- between "what mutations of compile-clean code look like" and
-- "what an undertrained transformer actually produces"). Stack with
-- the v1 harvest for v0.5 corpus.
--
-- Output: training/triples_inference_v1.txt, same <BROKEN>/<DIAG>/
-- <FIXED>/<END> format as triples_v2.txt and triples_harvested_v1.txt
-- so a future cat-build folds them in for free.
--
-- CLI:  ./rail_native run tools/train/harvest_inference.rail \
--           --prefix training/rail_native/checkpoints/d256_half_step3000 \
--           --candidates 10 --max-tokens 128 --seed 1000
--
-- Approx cost: 12 prompts × N candidates × ~3-5s gen + ~10s teacher
-- per failure ≈ 10–20 min for N=10.

import "stdlib/llm.rail"
import "tools/train/diagnose.rail"

teacher_ip = "10.42.0.2"
teacher_port = "8081"
teacher_model = "/Users/user/models/Qwen3.6-35B-A3B-8bit"

output_path = "training/triples_inference_v1.txt"
log_path = "/tmp/harvest_inference.log"
gen_bin = "/tmp/rail_harvest_inf_gen"

-- Default checkpoint: Spur-0.1 (d=256 × 2-block × half × 3000 steps).
default_prefix = "training/rail_native/checkpoints/d256_half_step3000"
default_candidates = "10"
default_max_tokens = "256"
default_seed_base = "1000"
default_temp = "1.0"

-- ── Inline parse_int_str (to_int is float→int).
parse_int_acc cs acc =
  if length cs == 0 then acc
  else
    let c = head cs
    let d = char_to_int c - 48
    if d < 0 then acc
    else if d > 9 then acc
    else parse_int_acc (tail cs) (acc * 10 + d)

parse_int_str s = parse_int_acc (chars s) 0

-- ── CLI argv parsing (mirrors bench_railnative.rail).
argv_get_loop xs key =
  if length xs == 0 then ""
  else if head xs == key then
    if length (tail xs) > 0 then head (tail xs) else ""
  else argv_get_loop (tail xs) key

argv_get_default key dflt =
  let v = argv_get_loop args key
  if length (chars v) == 0 then dflt else v

-- ── Shell-escape a prompt for double-quoted bash slot.
shell_dq_escape s =
  let a = str_replace "\\" "\\\\" s
  let b = str_replace "\"" "\\\"" a
  let c = str_replace "`" "\\`" b
  str_replace "$" "\\$" c

-- ── Seed prompts: bench-like starters across the bands Spur-0.1 fails
-- on most often. Mix of (a) original 12 short prefixes and (b) 8
-- harder/longer prefixes that bias toward known-failure regions —
-- multi-arm match, ADT chains, free-variable completions, recursive
-- evaluators. Longer prefixes give the model more context to drift
-- in, increasing the rate at which temp=1.0 sampling produces
-- compile-failures we can mine.
seed_prompts _ = [
  -- ── Original 12 short prefixes ──
  "fact n = if n <= 1 then 1 else n * fact (n - 1)\nmain = ",
  "double x = x * 2\nmain = ",
  "split_words s = split \" \" s\nmain = ",
  "join_csv xs = join \",\" xs\nmain = ",
  "type Opt = | Some x | None\nget_or o = match o | Some x -> x | None -> 0\nmain = ",
  "type Res = | Ok x | Err x\nrun r = match r | Ok v -> v | Err _ -> 0\nmain = ",
  "type Pair = | Pair a b\nfst p = match p | Pair a _ -> a\nmain = ",
  "type Expr = | Num x | Add a b\neval e = match e | Num x -> x | Add a b -> eval a + eval b\nmain = ",
  "type Instr = | MOV | ADD | RET\nasm i = match i | MOV -> \"mov\" | ADD -> \"add\" | RET -> \"ret\"\nmain = ",
  "count_lines text = length (split \"\\n\" text)\nmain = ",
  "doubled xs = map (\\x -> x * 2) xs\nmain = ",
  "-- complete this factorial so it prints 120\nfact n = ",
  -- ── 8 harder prefixes (Tools / Compiler / Comprehend) ──
  -- Multi-arm match with side-effecting branches
  "type Cmd = | Print s | Quit | Noop\nrun c = match c\n  | Print s -> let _ = print s in 0\n  | Quit -> 1\n  | Noop -> ",
  -- Recursive evaluator with two ADT arms
  "type Expr = | Num x | Add a b | Mul a b\neval e = match e\n  | Num x -> x\n  | Add a b -> eval a + eval b\n  | Mul a b -> ",
  -- ADT + helper function chain
  "type Tree = | Leaf x | Node l r\nsum_tree t = match t\n  | Leaf x -> x\n  | Node l r -> sum_tree l + sum_tree r\nmain = ",
  -- Comprehend with constraint
  "-- write a function that reverses a list of ints and prints it\nrev xs = ",
  -- Multi-statement let-chain
  "process xs =\n  let n = length xs\n  let half = n / 2\n  let first_half = ",
  -- ADT consumer with show
  "type Color = | Red | Green | Blue\nname c = match c\n  | Red -> \"red\"\n  | Green -> \"green\"\n  | Blue -> ",
  -- Higher-order with lambda return
  "compose f g = \\x -> f (g x)\ninc x = x + 1\ndouble x = x * 2\nmain = ",
  -- Comprehend free-form
  "-- write a function that takes two lists and returns their pairwise sums\nzip_sum xs ys = "]

-- ── Run gen_bin with one prompt+seed, return decoded text.
run_one_gen prefix prompt max_gen seed temp =
  let esc = shell_dq_escape prompt
  let cmd = cat [gen_bin,
                 " --prefix ", prefix,
                 " --max ", show max_gen,
                 " --k 10",
                 " --temp ", temp,
                 " --seed ", show seed,
                 " --prompt \"", esc, "\" 2>/dev/null"]
  shell cmd

-- ── Build teacher prompt for (broken, diag) pair (same as harvest_teacher).
sys_prompt =
  "You are a Rail compiler engineer. The user provides a broken Rail program and the compiler's diagnostic. Reply with ONLY a corrected Rail program (no markdown, no explanation, no commentary). The program must compile cleanly with `./rail_native`. Preserve the original program's structure where possible — minimal edit only."

user_prompt_for broken diag =
  cat ["<BROKEN>\n", broken, "\n<DIAG>\n", diag, "\n<FIXED>\n"]

teacher_body user_prompt =
  let q = "\""
  let esc_sys = llm_json_esc sys_prompt
  let esc_usr = llm_json_esc user_prompt
  let esc_model = llm_json_esc teacher_model
  cat ["{", q, "model", q, ":", q, esc_model, q, ",",
       q, "messages", q, ":[",
       "{", q, "role", q, ":", q, "system", q, ",", q, "content", q, ":", q, esc_sys, q, "},",
       "{", q, "role", q, ":", q, "user", q, ",", q, "content", q, ":", q, esc_usr, q, "}],",
       q, "max_tokens", q, ":2048,",
       q, "temperature", q, ":0.3,",
       q, "chat_template_kwargs", q, ":{", q, "enable_thinking", q, ":true}}"]

teacher_call user_prompt =
  let body = teacher_body user_prompt
  let _ = write_file "/tmp/rail_inf_teacher_req.json" body
  let cmd = cat [
    "curl -s -m 120 http://", teacher_ip, ":", teacher_port, "/v1/chat/completions ",
    "-H 'Content-Type: application/json' ",
    "-d @/tmp/rail_inf_teacher_req.json 2>/dev/null | ",
    "jq -r '.choices[0].message.content // empty' 2>/dev/null > /tmp/rail_inf_teacher_resp.txt && ",
    "perl -0777 -pe '",
    "s/^\\s+//; s/\\s+$//; ",
    "s/<think>.*?<\\/think>\\s*//gs; ",
    "s/^```[^\\n]*\\n(.*?)\\n```.*$/$1/s; ",
    "s/\\n\\n\\*\\*.*//s; ",
    "s/\\n\\nExplanation.*//s; ",
    "s/\\n\\nNote:.*//s",
    "' /tmp/rail_inf_teacher_resp.txt"]
  shell cmd

emit_triple broken diag teacher_fix =
  let triple = cat ["<BROKEN>\n", broken, "\n<DIAG>\n", diag, "\n<FIXED>\n", teacher_fix, "\n<END>\n\n"]
  let _ = write_file "/tmp/rail_inf_harvest_part.txt" triple
  shell (cat ["cat /tmp/rail_inf_harvest_part.txt >> ", output_path])

-- ── Process one (prompt, candidate) pair. Returns a rejection-reason
-- code so the outer log can tally where candidates die:
--   1 = kept (teacher fix compiles, triple emitted)
--   0 = candidate compiles cleanly (no failure to learn from)
--  -1 = candidate fails compile but no diagnostic could be extracted
--  -2 = teacher returned empty (transport / model error)
--  -3 = teacher returned a fix that does not compile
process_candidate candidate =
  let pair = diagnose candidate
  let ok = head pair
  if ok == 1 then 0
  else
    let diag = head (tail pair)
    if length (chars diag) == 0 then 0 - 1
    else
      let teacher_fix = teacher_call (user_prompt_for candidate diag)
      if length (chars teacher_fix) == 0 then 0 - 2
      else
        let pair2 = diagnose teacher_fix
        let ok2 = head pair2
        if ok2 == 0 then 0 - 3
        else
          let _ = emit_triple candidate diag teacher_fix
          1

-- Map rejection code → short label for the per-candidate log.
reason_label code =
  if code == 1 then "kept"
  else if code == 0 then "clean"
  else if code == 0 - 1 then "no-diag"
  else if code == 0 - 2 then "teacher-empty"
  else if code == 0 - 3 then "teacher-fix-broken"
  else "unknown"

-- ── For one prompt, draw N candidates and process each.
gen_loop prefix prompt n_cand max_tok seed_base i kept temp =
  if i >= n_cand then kept
  else
    let candidate = run_one_gen prefix prompt max_tok (seed_base + i) temp
    if length (chars candidate) == 0 then
      let _ = shell (cat ["echo '  cand ", show i, " reason=empty-gen' >> ", log_path])
      gen_loop prefix prompt n_cand max_tok seed_base (i + 1) kept temp
    else
      let code = process_candidate candidate
      let added = if code == 1 then 1 else 0
      let _ = shell (cat ["echo '  cand ", show i, " reason=", reason_label code, "' >> ", log_path])
      gen_loop prefix prompt n_cand max_tok seed_base (i + 1) (kept + added) temp

-- ── Outer loop over seed prompts.
prompt_loop prompts prefix n_cand max_tok seed_base p_idx total_kept temp =
  if length prompts == 0 then total_kept
  else
    let prompt = head prompts
    let _ = print (cat ["[prompt ", show p_idx, "/20] drawing ", show n_cand, " candidates"])
    let _ = shell (cat ["echo '[prompt ", show p_idx, "] ", str_replace "\n" "\\n" prompt, "' >> ", log_path])
    let kept = gen_loop prefix prompt n_cand max_tok (seed_base + p_idx * 1000) 0 0 temp
    let _ = print (cat ["  kept=", show kept])
    prompt_loop (tail prompts) prefix n_cand max_tok seed_base (p_idx + 1) (total_kept + kept) temp

-- ── Compile gen_bin once at startup (same retry pattern as bench).
compile_gen =
  let script = cat [
    "cd ~/projects/rail && for i in 1 2 3 4 5; do ",
    "bash -c \"./rail_native tools/train/lm_infer_v3_half.rail >/dev/null 2>&1 && cp /tmp/rail_out ", gen_bin, "\"; ",
    "sz=$(stat -f %z ", gen_bin, " 2>/dev/null || echo 0); ",
    "if [ \"$sz\" -gt 100000 ]; then echo \"ok: $sz bytes\"; break; fi; ",
    "echo \"attempt $i too small ($sz bytes)\"; sleep 1; done"]
  shell script

main =
  let prefix = argv_get_default "--prefix" default_prefix
  let n_cand_str = argv_get_default "--candidates" default_candidates
  let max_tok_str = argv_get_default "--max-tokens" default_max_tokens
  let seed_str = argv_get_default "--seed" default_seed_base
  let temp = argv_get_default "--temp" default_temp

  let n_cand = parse_int_str n_cand_str
  let max_tok = parse_int_str max_tok_str
  let seed_base = parse_int_str seed_str

  let _ = print (cat ["=== harvest_inference: ", prefix])
  let _ = print (cat ["candidates/prompt=", show n_cand, " max_tokens=", show max_tok, " seed=", show seed_base, " temp=", temp])
  let _ = print (cat ["teacher: ", teacher_ip, ":", teacher_port])
  let _ = shell (cat ["rm -f ", output_path, " ", log_path, " && touch ", output_path, " ", log_path])

  let _ = print "compiling gen_bin (lm_infer_v3_half) ..."
  let comp = compile_gen
  let _ = print (cat ["  ", comp])

  let prompts = seed_prompts 0
  let total = prompt_loop prompts prefix n_cand max_tok seed_base 0 0 temp

  let _ = print (cat ["\nharvested ", show total, " inference-failure triples → ", output_path])
  let sz = head (str_split "\n" (shell (cat ["wc -c < ", output_path])))
  let _ = print (cat ["output size: ", sz, " chars"])
  0
