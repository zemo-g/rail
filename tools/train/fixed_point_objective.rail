-- tools/train/fixed_point_objective.rail — Tier-D5 fixed-point objective.
--
-- Generate (P, output_O) pairs from corpus programs. Then train the model:
-- given O, generate P' such that run(P') = O. Reward = output equivalence
-- (compile + run + diff stdout).
--
-- Tests semantic understanding, not surface mimicry. The model isn't
-- learning to reproduce P from prompts about P; it's learning what
-- produces O.
--
-- Two-stage pipeline:
--   Stage 1 (offline): for each corpus program P:
--     run(P) → O                    (executable corpus only)
--     emit pair (O, P)
--   Stage 2 (training): use the (O, P) pairs as forward pairs.
--     prompt = "produce: " + O
--     completion = P
--     loss = standard CE
--   Stage 3 (RL polish, optional): roll out P', compile-and-run,
--     diff against O, reward = (P_O == O ? 1.0 : 0.0)
--
-- Difference from preimage_corpus.rail (Tier-A4): A4 emits both
-- forward and reverse pairs in one corpus stream as auxiliary data.
-- D5 trains the inverse direction as PRIMARY objective with eval-loop
-- reward, not just CE on text. Stronger semantic signal.
--
-- The cost: every roll-out requires a compile+run, ~50ms × 20 samples
-- per prompt = 1 sec/prompt. Affordable.
--
-- Output: training/corpora/fixed_point_pairs.jsonl
-- Format:
--   {"output": "<O>", "program": "<P>", "verified": true}
--
-- Stage 3 reward harness (offline, run per ckpt):
--   for each (O, P) in held-out set:
--     P' = sample(model, "produce: " + O)
--     compile P' → bin'
--     O' = run bin'
--     reward += (O' == O ? 1 : 0)

import "stdlib/list.rail"

cat parts = join "" parts

-- ── Parse corpus into individual programs at `main =` boundaries.
split_progs src =
  let lines = split "\n" src
  split_progs_loop lines [] []

split_progs_loop lines current acc =
  if length lines == 0 then
    if length current == 0 then reverse acc
    else reverse (cons (join "\n" (reverse current)) acc)
  else
    let line = head lines
    if str_starts_with "main = " (trim_left line) then
      let new_acc = if length current == 0 then acc
                    else cons (join "\n" (reverse current)) acc
      split_progs_loop (tail lines) (cons line []) new_acc
    else split_progs_loop (tail lines) (cons line current) acc

trim_left s =
  let cs = chars s
  trim_l_loop cs

trim_l_loop cs =
  if length cs == 0 then ""
  else if head cs == " " || head cs == "\t" then trim_l_loop (tail cs)
  else join "" cs

str_starts_with prefix s =
  let pcs = chars prefix
  let scs = chars s
  ssw_loop pcs scs

ssw_loop pcs scs =
  if length pcs == 0 then true
  else if length scs == 0 then false
  else if head pcs == head scs then ssw_loop (tail pcs) (tail scs)
  else false

run_program prog =
  let _ = write_file "/tmp/fp_probe.rail" prog
  let cmd = "./rail_native run /tmp/fp_probe.rail 2>/dev/null"
  shell cmd

trim s =
  let cs = chars s
  trim_loop cs []

trim_loop cs acc =
  if length cs == 0 then join "" (reverse acc)
  else
    let c = head cs
    if c == "\n" || c == "\r" then trim_loop (tail cs) acc
    else trim_loop (tail cs) (cons c acc)

json_escape s =
  let cs = chars s
  let escaped = json_loop cs []
  cat ["\"", join "" escaped, "\""]

json_loop cs acc =
  if length cs == 0 then reverse acc
  else
    let c = head cs
    let esc = if c == "\"" then "\\\""
              else if c == "\\" then "\\\\"
              else if c == "\n" then "\\n"
              else if c == "\t" then "\\t"
              else if c == "\r" then "\\r"
              else c
    json_loop (tail cs) (cons esc acc)

emit_pair output prog verified =
  cat ["{\"output\": ", json_escape output,
       ", \"program\": ", json_escape prog,
       ", \"verified\": ", if verified == 1 then "true" else "false", "}\n"]

main =
  let cmdline = args
  if length cmdline < 2 then
    let _ = print "usage: fixed_point_objective.rail <input.rail> [out.jsonl]"
    1
  else
    let in_path = nth 1 cmdline
    let out_path = if length cmdline < 3 then "training/corpora/fixed_point_pairs.jsonl"
                                       else nth 2 cmdline

    let src = read_file in_path
    if is_error src then
      let _ = print (cat ["error reading ", in_path])
      1
    else
      let progs = split_progs src
      let _ = print (cat ["found ", show (length progs), " programs"])

      let pairs = build_fp_pairs progs []
      let body = cat (reverse pairs)
      let _ = write_file out_path body
      let _ = print (cat ["wrote ", show (length pairs), " (output, program) pairs"])
      0

build_fp_pairs progs acc =
  if length progs == 0 then acc
  else
    let p = head progs
    let output = run_program p
    let trimmed_output = trim output
    if length (chars trimmed_output) == 0 then build_fp_pairs (tail progs) acc
    else
      let pair = emit_pair trimmed_output p 1
      build_fp_pairs (tail progs) (cons pair acc)
