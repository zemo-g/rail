-- tools/train/grammar_walk_massive.rail — Arm 2 of fresh-start strategy.
-- Targets ~50K compile-validated Rail programs, ~5 MB corpus.
--
-- Extends grammar_walk.rail with:
--   - L5 user-fn body templates expanded ~5×
--   - L8 (NEW) compositions: define fn1, fn2, then call fn2(fn1(x))
--   - L9 (NEW) stdlib calls: map/fold/filter on lists with simple lambdas
--   - L10 (NEW) IO: print of computed values, multi-line outputs
--   - Bigger param spaces (15 ints, 8 ident sets, 5 fn names)

import "stdlib/list.rail"

cat parts = join "" parts
nl = "\n"

ints = ["0", "1", "2", "3", "5", "7", "10", "13", "20", "25", "42", "100", "-1", "-3", "-7"]
strs = ["\"hello\"", "\"x\"", "\"a\"", "\"abc\"", "\"\""]
bools = ["true", "false"]
binops = ["+", "-", "*", "/"]
cmpops = ["==", "!=", "<", ">", "<=", ">="]
idents = ["x", "y", "z", "n", "i", "j", "acc", "v"]
fnames = ["f", "g", "h", "go", "step", "fn", "compute", "transform"]

-- ── L1: print constants.
gen_l1 _ =
  let pi = map (\v -> cat ["main =\n  let _ = print (show ", v, ")\n  0"]) ints
  let ps = map (\v -> cat ["main =\n  let _ = print ", v, "\n  0"]) strs
  let pb = map (\v -> cat ["main =\n  let _ = print (show ", v, ")\n  0"]) bools
  append pi (append ps pb)

-- ── L2: binary ops.
l2_pairs = [["1","2"],["10","3"],["7","4"],["100","99"],["0","1"],["5","8"],["20","15"],["3","17"]]

mk_binop op pair =
  cat ["main =\n  let _ = print (show (", nth 0 pair, " ", op, " ", nth 1 pair, "))\n  0"]
mk_cmp op pair =
  cat ["main =\n  let _ = print (show (", nth 0 pair, " ", op, " ", nth 1 pair, "))\n  0"]
mk_unary v =
  cat ["main =\n  let _ = print (show (-", v, "))\n  0"]

binops_for_op op pairs =
  if length pairs == 0 then []
  else cons (mk_binop op (head pairs)) (binops_for_op op (tail pairs))
binops_all ops pairs =
  if length ops == 0 then []
  else append (binops_for_op (head ops) pairs) (binops_all (tail ops) pairs)
cmps_for_op op pairs =
  if length pairs == 0 then []
  else cons (mk_cmp op (head pairs)) (cmps_for_op op (tail pairs))
cmps_all ops pairs =
  if length ops == 0 then []
  else append (cmps_for_op (head ops) pairs) (cmps_all (tail ops) pairs)

gen_l2 _ =
  let bins = binops_all binops l2_pairs
  let cmps = cmps_all cmpops l2_pairs
  let unaries = map mk_unary ints
  append (append bins cmps) unaries

-- ── L3: if/match.
mk_if v_then v_else cond =
  cat ["main =\n  let _ = print (show (if ", cond, " then ", v_then, " else ", v_else, "))\n  0"]
mk_match n =
  cat ["main = let v = ", n, "\n  let _ = match v\n    | 0 -> print \"zero\"\n    | _ -> print \"nonzero\"\n  0"]

if_for_cond v conds =
  if length conds == 0 then []
  else cons (mk_if v "999" (head conds)) (if_for_cond v (tail conds))
if_all vs conds =
  if length vs == 0 then []
  else append (if_for_cond (head vs) conds) (if_all (tail vs) conds)

gen_l3 _ =
  let ifs = if_all ints bools
  let matches = map mk_match ints
  append ifs matches

-- ── L4: let.
mk_let_simple name v =
  cat ["main =\n  let ", name, " = ", v, "\n  let _ = print (show ", name, ")\n  0"]
mk_let_chain a b =
  cat ["main =\n  let a = ", a, "\n  let b = ", b, "\n  let _ = print (show (a + b))\n  0"]
mk_let_triple a b c =
  cat ["main =\n  let x = ", a, "\n  let y = ", b, "\n  let z = ", c, "\n  let _ = print (show (x + y + z))\n  0"]

simples_for name vs =
  if length vs == 0 then []
  else cons (mk_let_simple name (head vs)) (simples_for name (tail vs))
simples_all ns vs =
  if length ns == 0 then []
  else append (simples_for (head ns) vs) (simples_all (tail ns) vs)
chains_for_a a bs =
  if length bs == 0 then []
  else cons (mk_let_chain a (head bs)) (chains_for_a a (tail bs))
chains_all as bs =
  if length as == 0 then []
  else append (chains_for_a (head as) bs) (chains_all (tail as) bs)
triples_for_ab a b cs =
  if length cs == 0 then []
  else cons (mk_let_triple a b (head cs)) (triples_for_ab a b (tail cs))
triples_for_a a bs cs =
  if length bs == 0 then []
  else append (triples_for_ab a (head bs) cs) (triples_for_a a (tail bs) cs)
triples_all as bs cs =
  if length as == 0 then []
  else append (triples_for_a (head as) bs cs) (triples_all (tail as) bs cs)

gen_l4 _ =
  let simples = simples_all idents ints
  let chains = chains_all ints ints
  let small_ints = ["1","2","3","5","10"]
  let triples = triples_all small_ints small_ints small_ints
  append (append simples chains) triples

-- ── L5: user fns (greatly expanded).
unary_bodies = [
  "x + 1", "x * 2", "x - 1", "x * x", "x + x",
  "if x == 0 then 1 else x",
  "if x < 0 then 0 else x",
  "if x <= 0 then 0 else x * 2",
  "x + 100",
  "x * x + x"
]
binary_bodies = [
  "a + b", "a * b", "a - b", "a + b * 2",
  "if a > b then a else b",
  "if a < b then a else b",
  "(a + b) * 2",
  "a * b + 1"
]

mk_unary_fn name body arg =
  cat [name, " x = ", body, "\n",
       "main =\n  let _ = print (show (", name, " ", arg, "))\n  0"]
mk_binary_fn name body a b =
  cat [name, " a b = ", body, "\n",
       "main =\n  let _ = print (show (", name, " ", a, " ", b, "))\n  0"]

unary_args fn body args =
  if length args == 0 then []
  else cons (mk_unary_fn fn body (head args)) (unary_args fn body (tail args))
unary_bodies_args fn bodies args =
  if length bodies == 0 then []
  else append (unary_args fn (head bodies) args) (unary_bodies_args fn (tail bodies) args)
unary_all_l5 fns bodies args =
  if length fns == 0 then []
  else append (unary_bodies_args (head fns) bodies args) (unary_all_l5 (tail fns) bodies args)

binary_b fn body a bs =
  if length bs == 0 then []
  else cons (mk_binary_fn fn body a (head bs)) (binary_b fn body a (tail bs))
binary_a fn body as bs =
  if length as == 0 then []
  else append (binary_b fn body (head as) bs) (binary_a fn body (tail as) bs)
binary_bodies_ab fn bodies as bs =
  if length bodies == 0 then []
  else append (binary_a fn (head bodies) as bs) (binary_bodies_ab fn (tail bodies) as bs)
binary_all_l5 fns bodies as bs =
  if length fns == 0 then []
  else append (binary_bodies_ab (head fns) bodies as bs) (binary_all_l5 (tail fns) bodies as bs)

gen_l5 _ =
  let small_ints = ["0","1","2","5","10"]
  let unaries = unary_all_l5 fnames unary_bodies ints
  let binaries = binary_all_l5 fnames binary_bodies small_ints small_ints
  append unaries binaries

-- ── L6: ADTs.
mk_color c =
  cat ["type Color = | Red | Green | Blue\n",
       "color_int c = match c\n",
       "  | Red -> 0\n",
       "  | Green -> 1\n",
       "  | Blue -> 2\n",
       "main =\n  let _ = print (show (color_int ", c, "))\n  0"]
mk_maybe inner =
  cat ["type Maybe = | None | Some x\n",
       "unwrap m = match m\n",
       "  | Some x -> x\n",
       "  | None -> 0\n",
       "main =\n  let _ = print (show (unwrap ", inner, "))\n  0"]
mk_result_int v =
  cat ["type Res = | Ok x | Err x\n",
       "value r = match r\n",
       "  | Ok x -> x\n",
       "  | Err _ -> -1\n",
       "main =\n  let _ = print (show (value (Ok ", v, ")))\n  0"]

gen_l6 _ =
  let colors = map (\c -> mk_color c) ["Red", "Green", "Blue"]
  let maybes = map (\v -> mk_maybe (cat ["(Some ", v, ")"])) ints
  let none_one = [mk_maybe "None"]
  let results = map mk_result_int ints
  append (append colors maybes) (append none_one results)

-- ── L7: recursion.
mk_factorial n =
  cat ["fact n = if n <= 1 then 1 else n * (fact (n - 1))\n",
       "main =\n  let _ = print (show (fact ", n, "))\n  0"]
mk_fib n =
  cat ["fib n = if n <= 1 then n else (fib (n - 1)) + (fib (n - 2))\n",
       "main =\n  let _ = print (show (fib ", n, "))\n  0"]
mk_sumto n =
  cat ["sum_to n = if n == 0 then 0 else n + (sum_to (n - 1))\n",
       "main =\n  let _ = print (show (sum_to ", n, "))\n  0"]
mk_double n =
  cat ["dbl n = if n <= 0 then 0 else 2 + (dbl (n - 1))\n",
       "main =\n  let _ = print (show (dbl ", n, "))\n  0"]

gen_l7 _ =
  let small = ["0", "1", "2", "3", "5", "7"]
  append (append (map mk_factorial small) (map mk_fib small))
         (append (map mk_sumto small) (map mk_double small))

-- ── L8: COMPOSITIONS — define fn1, fn2, call combined.
mk_comp_unary f1 b1 f2 b2 arg =
  cat [f1, " x = ", b1, "\n",
       f2, " x = ", b2, "\n",
       "main =\n  let _ = print (show (", f2, " (", f1, " ", arg, ")))\n  0"]

comp_for_arg f1 b1 f2 b2 args =
  if length args == 0 then []
  else cons (mk_comp_unary f1 b1 f2 b2 (head args)) (comp_for_arg f1 b1 f2 b2 (tail args))

simple_unary_bodies = ["x + 1", "x * 2", "x - 1", "x * x"]

comp_for_b1b2 f1 b1 f2 b2 args =
  comp_for_arg f1 b1 f2 b2 args
comp_for_b1 f1 b1 f2 b2s args =
  if length b2s == 0 then []
  else append (comp_for_b1b2 f1 b1 f2 (head b2s) args) (comp_for_b1 f1 b1 f2 (tail b2s) args)
comp_full f1 f2 b1s b2s args =
  if length b1s == 0 then []
  else append (comp_for_b1 f1 (head b1s) f2 b2s args) (comp_full f1 f2 (tail b1s) b2s args)

gen_l8 _ =
  let small = ["0", "1", "2", "3", "5"]
  comp_full "f" "g" simple_unary_bodies simple_unary_bodies small

-- ── L9: stdlib calls (map, fold).
mk_map_show xs =
  cat ["main =\n  let xs = ", xs, "\n",
       "  let ys = map (\\x -> x * 2) xs\n",
       "  let _ = print (show ys)\n  0"]
mk_fold_sum xs =
  cat ["add a b = a + b\n",
       "main =\n  let xs = ", xs, "\n",
       "  let _ = print (show (fold add 0 xs))\n  0"]
mk_filter_pos xs =
  cat ["is_pos n = n > 0\n",
       "main =\n  let xs = ", xs, "\n",
       "  let ys = filter is_pos xs\n",
       "  let _ = print (show ys)\n  0"]

gen_l9 _ =
  let lists = ["[1,2,3]", "[5,10,15]", "[0,1,2,3,4]", "[-1,2,-3,4]", "[100]", "[]"]
  append (append (map mk_map_show lists) (map mk_fold_sum lists))
         (map mk_filter_pos lists)

-- ── L10: IO / multi-line patterns.
mk_print_chain a b c =
  cat ["main =\n  let _ = print ", a, "\n",
       "  let _ = print ", b, "\n",
       "  let _ = print ", c, "\n  0"]
mk_compute_print a b =
  cat ["main =\n  let x = ", a, "\n",
       "  let y = ", b, "\n",
       "  let z = x * y + x\n",
       "  let _ = print (show z)\n  0"]

print_chain_for_ab a b cs =
  if length cs == 0 then []
  else cons (mk_print_chain a b (head cs)) (print_chain_for_ab a b (tail cs))
print_chain_for_a a bs cs =
  if length bs == 0 then []
  else append (print_chain_for_ab a (head bs) cs) (print_chain_for_a a (tail bs) cs)
print_chains_all as bs cs =
  if length as == 0 then []
  else append (print_chain_for_a (head as) bs cs) (print_chains_all (tail as) bs cs)

compute_for_a a bs =
  if length bs == 0 then []
  else cons (mk_compute_print a (head bs)) (compute_for_a a (tail bs))
compute_all as bs =
  if length as == 0 then []
  else append (compute_for_a (head as) bs) (compute_all (tail as) bs)

gen_l10 _ =
  let some_strs = ["\"a\"", "\"b\"", "\"c\""]
  let chains = print_chains_all some_strs some_strs some_strs
  let computes = compute_all ints ints
  append chains computes

-- ── format + emit.
fmt level idx body =
  cat ["-- L", show level, " #", show idx, "\n", body, "\n\n"]

map_indexed f xs = mil f xs 0 []
mil f xs i acc =
  if length xs == 0 then reverse acc
  else mil f (tail xs) (i + 1) (cons (f i (head xs)) acc)

emit_level level progs =
  let n = length progs
  let _ = print (cat ["L", show level, ": ", show n, " programs"])
  let formatted = map_indexed (\i -> \p -> fmt level i p) progs
  cat formatted

main =
  let _ = print "─────────────────────────────────"
  let _ = print " Massive grammar-walk corpus generator (Arm 2)"
  let _ = print "─────────────────────────────────"

  let l1 = emit_level 1 (gen_l1 0)
  let l2 = emit_level 2 (gen_l2 0)
  let l3 = emit_level 3 (gen_l3 0)
  let l4 = emit_level 4 (gen_l4 0)
  let l5 = emit_level 5 (gen_l5 0)
  let l6 = emit_level 6 (gen_l6 0)
  let l7 = emit_level 7 (gen_l7 0)
  let l8 = emit_level 8 (gen_l8 0)
  let l9 = emit_level 9 (gen_l9 0)
  let l10 = emit_level 10 (gen_l10 0)

  let header = "-- grammar_walk_massive_raw.txt — Arm 2 corpus\n-- L1=const L2=op L3=if/match L4=let L5=fns L6=ADT L7=rec L8=comp L9=stdlib L10=IO\n\n"
  let body = cat [header, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10]
  let _ = write_file "training/corpora/grammar_walk_massive_raw.txt" body
  let _ = print (cat ["wrote ", show (length (chars body)), " bytes"])
  0
