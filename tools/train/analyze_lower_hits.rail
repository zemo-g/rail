-- analyze_lower_hits.rail — sample teacher-fix corpus, measure lower-hit rate.
--
-- Reads triples_v2.txt, extracts FIXED blocks, runs lower_source_ok on
-- each, prints HITS/TOTAL.

import "jit/ir.rail"
import "tools/train/diagnose_jit.rail"

corpus_path = "training/triples_v2.txt"

-- Extract just the FIXED block text from a single triple chunk.
-- chunk = "<BROKEN>\n...<DIAG>\n...<FIXED>\nFIX_TEXT\n"  (trailing \n possibly)
extract_fixed chunk =
  let f_off = str_find "<FIXED>\n" chunk
  if f_off < 0 then ""
  else
    let start = f_off + 8  -- length of "<FIXED>\n" is 8 bytes
    let total = length (chars chunk)
    str_sub chunk start (total - start)

count_loop chunks idx hits =
  if length chunks == 0 then cons idx (cons hits [])
  else
    let chunk = head chunks
    let fixed = extract_fixed chunk
    if length (chars fixed) == 0 then count_loop (tail chunks) idx hits
    else
      let h = lower_source_ok fixed
      count_loop (tail chunks) (idx + 1) (hits + h)

main =
  let corpus = read_file corpus_path
  let chunks = str_split "<END>\n\n" corpus
  let _ = print (cat ["chunks=", show (length chunks)])
  let r = count_loop chunks 0 0
  let total = head r
  let hits = head (tail r)
  let _ = print (cat ["TOTAL=", show total, " LOWER_HITS=", show hits])
  0
