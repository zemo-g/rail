-- tokenizer_determinism_test.rail — assert the counted-loop build_vocab
-- produces the exact same first-appearance vocab ordering as the legacy
-- O(n²) collect_unique on a fixed 256-char corpus.
--
-- If this passes, downstream code (encode/decode, saved vocab files,
-- trained models) is bit-identical across the rewrite.
import "stdlib/tokenizer.rail"

-- A deterministic 256-character corpus with ~40 distinct characters.
-- "The quick brown fox..." is 44 chars; ×6 = 264; slice to 256 via
-- repeat_cat + truncate.
repeat_cat s k acc =
  if k == 0 then acc
  else repeat_cat s (k - 1) (cat [acc, s])

take_n cs n acc =
  if n == 0 then reverse acc
  else if length cs == 0 then reverse acc
  else take_n (tail cs) (n - 1) (cons (head cs) acc)

truncate256 s =
  let cs = chars s
  let kept = take_n cs 256 []
  join "" kept

-- Character-by-character equality of two vocab lists.
eq_chars_loop xs ys =
  if length xs == 0 then length ys == 0
  else if length ys == 0 then false
  else if head xs == head ys then eq_chars_loop (tail xs) (tail ys)
  else false

-- Unwrap Vocab to get the chars list.
vocab_chars v = match v
  | Vocab cs _ -> cs

main =
  let seed = "The quick brown fox jumps over the lazy dog.\n"
  let big = repeat_cat seed 10 ""
  let corpus = truncate256 big
  let n = length (chars corpus)
  let _ = print (cat ["corpus length: ", show n])

  let v_new = build_vocab corpus
  let v_old = build_vocab_old corpus

  let cs_new = vocab_chars v_new
  let cs_old = vocab_chars v_old
  let _ = print (cat ["new vocab size: ", show (length cs_new)])
  let _ = print (cat ["old vocab size: ", show (length cs_old)])

  let ok_order = eq_chars_loop cs_new cs_old
  let ok_size  = (length cs_new) == (length cs_old)

  let verdict =
    if ok_order then
      if ok_size then "PASS: new build_vocab matches legacy ordering + size"
      else "FAIL: size mismatch"
    else "FAIL: first-appearance ordering diverged"
  let _ = print verdict

  -- Spot-check round-trip with the new vocab on the same corpus.
  let ids = encode v_new corpus
  let back = decode v_new ids
  let rt_ok = eq_chars_loop (chars corpus) (chars back)
  let rt_verdict = if rt_ok then "PASS: round-trip exact" else "FAIL: round-trip diverged"
  let _ = print rt_verdict
  0
