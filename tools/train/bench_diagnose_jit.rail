-- bench_diagnose_jit.rail — wall-clock comparison: diagnose vs diagnose_fast.
--
-- Usage:
--   ./rail_native run tools/train/bench_diagnose_jit.rail slow
--   ./rail_native run tools/train/bench_diagnose_jit.rail fast
--
-- Run both under shell `time` to compare. The corpus is hardcoded;
-- a mix of lowerable (integer subset) and non-lowerable (strings,
-- lists, multi-arg fns, broken). Each program is graded REPEATS times
-- in a row to amortize startup.

import "jit/ir.rail"
import "tools/train/diagnose_jit.rail"

repeats = 3

-- Lowerable sources (JIT fast path) — 7 programs.
src_l1 = "main = 7 + 13"
src_l2 = "main = let x = 7 + 13 in x"
src_l3 = "main = let a = 1 + 2 in let b = a * 5 in b - 4"
src_l4 = "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = fact 5"
src_l5 = "fib n = if n < 2 then n else (fib (n - 1)) + (fib (n - 2))\nmain = fib 10"
src_l6 = "tri n = if n < 1 then 0 else n + tri (n - 1)\nmain = tri 100"
src_l7 = "main = print (show (let x = 99 in x + 1))"

-- Non-lowerable but compile-clean (slow path; will compile cleanly).
-- 7 programs covering strings, lists, multi-arg, ADT match.
src_n1 = "main = let _ = print \"hello\"\n  0"
src_n2 = "main = let xs = [1,2,3,4,5]\n  let _ = print (show (length xs))\n  0"
src_n3 = "add a b = a + b\nmain = add 3 4"
src_n4 = "double x = x * 2\nmap_double xs = map double xs\nmain = let r = map_double [1,2,3] in length r"
src_n5 = "main = let s = cat [\"abc\", \"def\"] in length (chars s)"
src_n6 = "type Opt = | Some x | None\nfromOpt o d = match o\n  | Some v -> v\n  | None -> d\nmain = fromOpt (Some 42) 0"
src_n7 = "main = let xs = filter (\\x -> x > 2) [1,2,3,4,5] in length xs"

-- Broken programs (slow path; will fail to compile).
src_b1 = "main = let x = ((((\n  0"
src_b2 = "main = head"
src_b3 = "main = print"

-- Mode selection — runtime arg parse.
-- When invoked via `./rail_native run`, args[0] is the binary path
-- (/tmp/rail_out) and args[1] is the first user arg.
mode_arg = if length args > 1 then head (tail args) else "slow"

-- One sweep through the full corpus = 17 grades.
-- We do `repeats` sweeps to get a stable wall-clock.
grade1 mode src =
  if mode == "fast" then diagnose_fast src
  else diagnose src

sweep mode =
  let corpus = [src_l1, src_l2, src_l3, src_l4, src_l5, src_l6, src_l7,
                src_n1, src_n2, src_n3, src_n4, src_n5, src_n6, src_n7,
                src_b1, src_b2, src_b3]
  sweep_loop mode corpus 0 0

sweep_loop mode corpus ok_ct fail_ct =
  if length corpus == 0 then cons ok_ct (cons fail_ct [])
  else
    let pair = grade1 mode (head corpus)
    let ok = head pair
    if ok == 1 then sweep_loop mode (tail corpus) (ok_ct + 1) fail_ct
    else sweep_loop mode (tail corpus) ok_ct (fail_ct + 1)

repeat_sweeps mode n total_ok total_fail =
  if n == 0 then cons total_ok (cons total_fail [])
  else
    let s = sweep mode
    let new_ok = total_ok + (head s)
    let new_fail = total_fail + (head (tail s))
    repeat_sweeps mode (n - 1) new_ok new_fail

count_lower_hits corpus hits =
  if length corpus == 0 then hits
  else
    let h = lower_source_ok (head corpus)
    count_lower_hits (tail corpus) (hits + h)

main =
  let _ = print (cat ["MODE=", mode_arg, " REPEATS=", show repeats])

  -- Report lower-hit rate once (cheap).
  let corpus = [src_l1, src_l2, src_l3, src_l4, src_l5, src_l6, src_l7,
                src_n1, src_n2, src_n3, src_n4, src_n5, src_n6, src_n7,
                src_b1, src_b2, src_b3]
  let lower_hits = count_lower_hits corpus 0
  let n_corpus = length corpus
  let _ = print (cat ["CORPUS=", show n_corpus, " LOWER_HITS=", show lower_hits])

  -- Run all sweeps.
  let r = repeat_sweeps mode_arg repeats 0 0
  let total_ok = head r
  let total_fail = head (tail r)
  let _ = print (cat ["GRADED ok=", show total_ok, " fail=", show total_fail,
                      " (sweeps=", show repeats, "x", show n_corpus, ")"])
  0
