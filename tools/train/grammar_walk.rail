-- tools/train/grammar_walk.rail — Tier-B2 grammar-walked curriculum generator.
--
-- Synthesizes Rail programs by enumerating bottom-up through the language
-- grammar. Each level adds one construct. Output is a single corpus file
-- with all programs concatenated, separated by blank lines + level tags.
--
-- The compiler is the oracle: a separate validation pass (#15 in the
-- overnight task list) compiles each program and keeps only passing ones.
-- This file is the SOURCE of programs; filtering happens downstream.
--
-- Levels:
--   L1 — int + string + bool + nil constants printed
--   L2 — unary/binary arithmetic + boolean + comparison
--   L3 — if/match
--   L4 — let
--   L5 — user-defined functions
--   L6 — ADT definition + match
--   L7 — recursion
--
-- Output: training/corpora/grammar_walk_raw.txt
-- Run after #15 to filter to compile-passing only.

import "stdlib/list.rail"

cat parts = join "" parts
nl = "\n"

-- Literal slot values used across templates.
ints = ["0", "1", "2", "5", "10", "42", "100", "-1", "-7"]
strs = ["\"hello\"", "\"x\"", "\"\"", "\"a b c\""]
bools = ["true", "false"]
binops = ["+", "-", "*", "/"]
cmpops = ["==", "!=", "<", ">", "<=", ">="]
boolops = ["&&", "||"]
idents = ["x", "y", "z", "n", "i", "acc"]
fnames = ["f", "g", "h", "go", "step"]
adt_names = ["Color", "Status", "Shape", "Maybe"]

-- ── L1: print a constant.
gen_l1 _ =
  let progs_int = map (\v -> cat ["main =\n  let _ = print (show ", v, ")\n  0"]) ints
  let progs_str = map (\v -> cat ["main =\n  let _ = print ", v, "\n  0"]) strs
  let progs_bool = map (\v -> cat ["main =\n  let _ = print (show ", v, ")\n  0"]) bools
  let progs_nil = ["main =\n  let _ = print (show [])\n  0"]
  append (append progs_int progs_str) (append progs_bool progs_nil)

-- ── L2: print a binary op result.
l2_pairs_int = [["1","2"],["10","3"],["7","4"],["100","99"],["0","1"]]

mk_binop op pair =
  cat ["main =\n  let _ = print (show (", nth 0 pair, " ", op, " ", nth 1 pair, "))\n  0"]

mk_cmp op pair =
  cat ["main =\n  let _ = print (show (", nth 0 pair, " ", op, " ", nth 1 pair, "))\n  0"]

mk_bool op a b =
  cat ["main =\n  let _ = print (show (", a, " ", op, " ", b, "))\n  0"]

mk_unary v =
  cat ["main =\n  let _ = print (show (-", v, "))\n  0"]

-- Named helpers replace nested closures (which segfault per CLAUDE.md
-- pattern; explicit recursion works around it).
binops_for_op op pairs =
  if length pairs == 0 then []
  else cons (mk_binop op (head pairs)) (binops_for_op op (tail pairs))

binops_all ops pairs =
  if length ops == 0 then []
  else append (binops_for_op (head ops) pairs) (binops_all (tail ops) pairs)

cmps_for_op op pairs =
  if length pairs == 0 then []
  else cons (mk_cmp op (head pairs)) (cmps_for_op op (tail pairs))

cmps_all ops pairs =
  if length ops == 0 then []
  else append (cmps_for_op (head ops) pairs) (cmps_all (tail ops) pairs)

gen_l2 _ =
  let bins = binops_all binops l2_pairs_int
  let cmps = cmps_all cmpops l2_pairs_int
  let unaries = map mk_unary ints
  append (append bins cmps) unaries

-- ── L3: if/match.
mk_if_int v_then v_else cond =
  cat ["main =\n  let _ = print (show (if ", cond, " then ", v_then, " else ", v_else, "))\n  0"]

mk_match_int n =
  cat ["main = let v = ", n, "\n  let _ = match v\n    | 0 -> print \"zero\"\n    | _ -> print \"nonzero\"\n  0"]

if_each_cond v conds =
  if length conds == 0 then []
  else cons (mk_if_int v "999" (head conds)) (if_each_cond v (tail conds))

if_all_v ints_list conds =
  if length ints_list == 0 then []
  else append (if_each_cond (head ints_list) conds) (if_all_v (tail ints_list) conds)

if_simple_each_bool bs =
  if length bs == 0 then []
  else cons (mk_if_int "1" "0" (head bs)) (if_simple_each_bool (tail bs))

gen_l3 _ =
  let ifs1 = if_simple_each_bool bools
  let ifs2 = if_all_v ints bools
  let matches = map mk_match_int ints
  append (append ifs1 ifs2) matches

-- ── L4: let bindings.
mk_let_simple name v =
  cat ["main = let ", name, " = ", v, " in let _ = print (show ", name, ")\n  0"]

mk_let_chain a_v b_v =
  cat ["main = let a = ", a_v, "\n  let b = ", b_v, "\n  let _ = print (show (a + b))\n  0"]

mk_let_nested =
  "main = let outer = 10\n  let _ = let inner = outer * 2\n            print (show inner)\n  0"

simples_for_name name vs =
  if length vs == 0 then []
  else cons (mk_let_simple name (head vs)) (simples_for_name name (tail vs))

simples_all names vs =
  if length names == 0 then []
  else append (simples_for_name (head names) vs) (simples_all (tail names) vs)

chains_for_a a bs =
  if length bs == 0 then []
  else cons (mk_let_chain a (head bs)) (chains_for_a a (tail bs))

chains_all as bs =
  if length as == 0 then []
  else append (chains_for_a (head as) bs) (chains_all (tail as) bs)

gen_l4 _ =
  let simples = simples_all idents ints
  let chains = chains_all ints ints
  cons mk_let_nested (append simples chains)

-- ── L5: user-defined functions.
mk_user_unary name body call_arg =
  cat [name, " ", "x", " = ", body, "\n",
       "main =\n  let _ = print (show (", name, " ", call_arg, "))\n  0"]

mk_user_binary name body a b =
  cat [name, " a b = ", body, "\n",
       "main =\n  let _ = print (show (", name, " ", a, " ", b, "))\n  0"]

unary_bodies = ["x + 1", "x * 2", "x - 1", "x * x", "if x == 0 then 1 else x"]
binary_bodies = ["a + b", "a * b", "a - b", "if a > b then a else b"]

unary_for_args fn body args =
  if length args == 0 then []
  else cons (mk_user_unary fn body (head args)) (unary_for_args fn body (tail args))

unary_for_fn_bodies fn bodies args =
  if length bodies == 0 then []
  else append (unary_for_args fn (head bodies) args) (unary_for_fn_bodies fn (tail bodies) args)

unary_all fns bodies args =
  if length fns == 0 then []
  else append (unary_for_fn_bodies (head fns) bodies args) (unary_all (tail fns) bodies args)

binary_for_b fn body a bs =
  if length bs == 0 then []
  else cons (mk_user_binary fn body a (head bs)) (binary_for_b fn body a (tail bs))

binary_for_a fn body as bs =
  if length as == 0 then []
  else append (binary_for_b fn body (head as) bs) (binary_for_a fn body (tail as) bs)

binary_for_fn_bodies fn bodies as bs =
  if length bodies == 0 then []
  else append (binary_for_a fn (head bodies) as bs) (binary_for_fn_bodies fn (tail bodies) as bs)

binary_all fns bodies as bs =
  if length fns == 0 then []
  else append (binary_for_fn_bodies (head fns) bodies as bs) (binary_all (tail fns) bodies as bs)

gen_l5 _ =
  let unaries = unary_all fnames unary_bodies ints
  let binaries = binary_all fnames binary_bodies ints ints
  append unaries binaries

-- ── L6: ADTs + match.
mk_adt_color cons_choice =
  cat ["type Color = | Red | Green | Blue\n",
       "color_to_int c = match c\n",
       "  | Red -> 0\n",
       "  | Green -> 1\n",
       "  | Blue -> 2\n",
       "main =\n  let _ = print (show (color_to_int ", cons_choice, "))\n  0"]

mk_adt_maybe inner =
  cat ["type Maybe = | None | Some x\n",
       "unwrap_or_zero m = match m\n",
       "  | Some x -> x\n",
       "  | None -> 0\n",
       "main =\n  let _ = print (show (unwrap_or_zero ", inner, "))\n  0"]

gen_l6 _ =
  let colors = map (\c -> mk_adt_color c) ["Red", "Green", "Blue"]
  let maybes_some = map (\v -> mk_adt_maybe (cat ["(Some ", v, ")"])) ints
  let maybes_none = ["main_dummy = 0"]
  cons (mk_adt_maybe "None") (append colors maybes_some)

-- ── L7: recursion.
mk_factorial n =
  cat ["fact n = if n <= 1 then 1 else n * (fact (n - 1))\n",
       "main =\n  let _ = print (show (fact ", n, "))\n  0"]

mk_fib n =
  cat ["fib n = if n <= 1 then n else (fib (n - 1)) + (fib (n - 2))\n",
       "main =\n  let _ = print (show (fib ", n, "))\n  0"]

mk_sum_to n =
  cat ["sum_to n = if n == 0 then 0 else n + (sum_to (n - 1))\n",
       "main =\n  let _ = print (show (sum_to ", n, "))\n  0"]

mk_count_down n =
  cat ["countdown n = if n == 0 then \"done\"\n",
       "  else let _ = print (show n)\n",
       "       countdown (n - 1)\n",
       "main = countdown ", n]

gen_l7 _ =
  let small_n = ["0", "1", "2", "3", "5", "7", "10"]
  let facts = map mk_factorial small_n
  let fibs = map mk_fib small_n
  let sums = map mk_sum_to small_n
  let countdowns = map mk_count_down ["3", "5"]
  append (append facts fibs) (append sums countdowns)

-- ── Format programs with level tags.
fmt_program level idx body =
  cat ["-- L", show level, " #", show idx, "\n", body, "\n\n"]

emit_level out_buf level progs =
  let n = length progs
  let _ = print (cat ["L", show level, ": ", show n, " programs"])
  let formatted = map_indexed (\i -> \p -> fmt_program level i p) progs
  cat formatted

map_indexed f xs = map_indexed_loop f xs 0 []

map_indexed_loop f xs i acc =
  if length xs == 0 then reverse acc
  else map_indexed_loop f (tail xs) (i + 1) (cons (f i (head xs)) acc)

main =
  let _ = print "─────────────────────────────────"
  let _ = print " Grammar-walk corpus generator"
  let _ = print "─────────────────────────────────"

  let l1 = emit_level "" 1 (gen_l1 0)
  let l2 = emit_level "" 2 (gen_l2 0)
  let l3 = emit_level "" 3 (gen_l3 0)
  let l4 = emit_level "" 4 (gen_l4 0)
  let l5 = emit_level "" 5 (gen_l5 0)
  let l6 = emit_level "" 6 (gen_l6 0)
  let l7 = emit_level "" 7 (gen_l7 0)

  let header = "-- grammar_walk_raw.txt — synthesized curriculum corpus\n-- L1=constants L2=ops L3=if/match L4=let L5=fns L6=ADTs L7=recursion\n\n"
  let body = cat [header, l1, l2, l3, l4, l5, l6, l7]

  let _ = write_file "training/corpora/grammar_walk_raw.txt" body
  let _ = print (cat ["wrote ", show (length (chars body)), " bytes to training/corpora/grammar_walk_raw.txt"])
  0
