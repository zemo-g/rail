-- diagnose_jit.rail — JIT-pre-filter wrapper around diagnose.rail.
--
-- Public entry points:
--   diagnose_fast src     -> [compile_ok, diag]   (drop-in for diagnose)
--   lower_source_ok src   -> 1 if lowerable, 0 otherwise
--
-- Strategy:
--   1. Try `lower_source src`. If it returns ["ok", _], the source
--      parsed and is in the JIT-lowerable subset (integer arithmetic,
--      single-arg recursion, if/let, print(show n)). Return [1, ""]
--      without ever invoking ./rail_native.
--   2. Otherwise fall back to `diagnose src`, which shells out to
--      `./rail_native` (~100 ms) to get the real compile_ok + diag.
--
-- Note: lower-success is a strong predicate — if the JIT's parser +
-- IR-builder accepts the source, ./rail_native almost certainly will
-- too (the JIT subset is strictly stricter). False positives have not
-- been observed across the lower-test fixtures.
--
-- Note: when lower fails, we *don't* surface the JIT error message;
-- we punt entirely to ./rail_native because the JIT rejects much
-- valid Rail (strings, lists, ADTs, multi-arg fns) that compiles
-- cleanly. Lower-fail means "JIT can't grade", not "doesn't compile".
--
-- Note: there is no in-process counter for fast-path hits. Rail's
-- nullary re-evaluation defeats top-level mutable cells (see
-- rail_quirks.md). Callers that need hit-rate stats should call
-- `lower_source_ok` separately and accumulate locally.
--
-- Import order (matters — Rail does not dedupe):
--   import "jit/ir.rail"        -- brings op_* constants + make_fn
--   import "tools/train/diagnose_jit.rail"
-- diagnose_jit.rail itself pulls jit/lex.rail, jit/syntax.rail,
-- jit/lower.rail, and tools/train/diagnose.rail.

import "jit/lower.rail"
import "tools/train/diagnose.rail"

lower_source_ok src =
  let r = lower_source src
  if (head r) == "ok" then 1 else 0

diagnose_fast src =
  let r = lower_source src
  if (head r) == "ok" then
    cons 1 (cons "" [])
  else
    diagnose src
