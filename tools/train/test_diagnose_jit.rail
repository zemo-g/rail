-- test_diagnose_jit.rail — smoke for diagnose_jit's fast-path + fallback.
import "jit/ir.rail"
import "tools/train/diagnose_jit.rail"

src_lowerable = "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = fact 5"
-- Compile-clean but still outside the lowerable subset (Stage 6+: file I/O).
src_nonlower  = "main = let s = read_file \"/tmp/nonexistent_for_test\"\n  length (chars s)"
src_broken    = "main = let x = ((((\n  0"

check label src want_ok want_lower must_have_diag =
  let pair = diagnose_fast src
  let ok = head pair
  let diag = head (tail pair)
  let lower_hit = lower_source_ok src
  if ok != want_ok then
    let _ = print (cat ["[", label, "] FAIL ok=", show ok, " want=", show want_ok, " diag=[", diag, "]"])
    1
  else if lower_hit != want_lower then
    let _ = print (cat ["[", label, "] FAIL lower_hit=", show lower_hit, " want=", show want_lower])
    1
  else if must_have_diag == 1 then
    if length (chars diag) == 0 then
      let _ = print (cat ["[", label, "] FAIL ok=", show ok, " (expected non-empty diag)"])
      1
    else
      let _ = print (cat ["[", label, "] OK ok=", show ok, " lower=", show lower_hit, " diag=[", diag, "]"])
      0
  else
    let _ = print (cat ["[", label, "] OK ok=", show ok, " lower=", show lower_hit])
    0

main =
  let r1 = check "lowerable" src_lowerable 1 1 0
  let r2 = check "nonlower"  src_nonlower  1 0 0
  let r3 = check "broken"    src_broken    0 0 1
  let total = r1 + r2 + r3
  if total == 0 then
    let _ = print "ALL DIAGNOSE_JIT PASS"
    0
  else
    let _ = print (cat ["DIAGNOSE_JIT FAILS: ", show total])
    1
