-- gen_triples.rail — harvest (broken, diagnostic, fixed) training triples.
-- Walk a list of 40 compile-clean seed programs. For each seed and each
-- of N_RNG rng variations, apply each of the 6 mutation ops. Emit valid
-- triples (where the mutation produced a detectable compiler error) to
-- training/triples_v1.txt in the format documented in DIAGNOSTIC_CORPUS.md.

import "tools/train/mutate.rail"
import "tools/train/diagnose.rail"

-- ── Number of rng variations per (seed, op). Only the rng-sensitive
-- ops (currently just mut_delete_line) produce different outputs per
-- rng seed; others always return the same broken version. The filter
-- de-duplicates so we don't emit the same triple twice.
n_rng_per_seed = 4

-- ── 40 seed programs. Each must compile cleanly standalone. Short,
-- diverse patterns: let, match, recursion, ADTs, ops, string ops,
-- list ops, higher-order functions.

seed_01 = "main = let _ = print 42\n  0\n"
seed_02 = "add a b = a + b\nmain = let _ = print (show (add 2 3))\n  0\n"
seed_03 = "fact n = if n <= 1 then 1 else n * fact (n - 1)\nmain = let _ = print (show (fact 5))\n  0\n"
seed_04 = "type Opt = | Some x | None\nunwrap o = match o | Some x -> x | None -> 0\nmain = let _ = print (show (unwrap (Some 7)))\n  0\n"
seed_05 = "sum_list xs = fold add 0 xs\nadd a b = a + b\nmain = let _ = print (show (sum_list [1, 2, 3, 4, 5]))\n  0\n"
seed_06 = "double x = x * 2\nmain = let _ = print (show (double 21))\n  0\n"
seed_07 = "reverse_str s = join \"\" (reverse (chars s))\nmain = let _ = print (reverse_str \"hello\")\n  0\n"
seed_08 = "type Tree = | Leaf | Node v l r\ncount t = match t | Leaf -> 0 | Node _ l r -> 1 + count l + count r\nmain = let _ = print (show (count (Node 1 Leaf Leaf)))\n  0\n"
seed_09 = "fib n = if n <= 1 then n else fib (n - 1) + fib (n - 2)\nmain = let _ = print (show (fib 7))\n  0\n"
seed_10 = "square x = x * x\nmain = let _ = print (show (square 9))\n  0\n"
seed_11 = "neg x = 0 - x\nmain = let _ = print (show (neg 7))\n  0\n"
seed_12 = "is_pos x = x > 0\nmain = let _ = print (show (is_pos 5))\n  0\n"
seed_13 = "max2 a b = if a > b then a else b\nmain = let _ = print (show (max2 3 7))\n  0\n"
seed_14 = "min2 a b = if a < b then a else b\nmain = let _ = print (show (min2 3 7))\n  0\n"
seed_15 = "abs_int x = if x < 0 then 0 - x else x\nmain = let _ = print (show (abs_int (0 - 12)))\n  0\n"
seed_16 = "second xs = head (tail xs)\nmain = let _ = print (show (second [10, 20, 30]))\n  0\n"
seed_17 = "third xs = head (tail (tail xs))\nmain = let _ = print (show (third [1, 2, 3, 4]))\n  0\n"
seed_18 = "sum_to n = if n <= 0 then 0 else n + sum_to (n - 1)\nmain = let _ = print (show (sum_to 5))\n  0\n"
seed_19 = "pow b n = if n == 0 then 1 else b * pow b (n - 1)\nmain = let _ = print (show (pow 2 10))\n  0\n"
seed_20 = "gcd a b = if b == 0 then a else gcd b (a % b)\nmain = let _ = print (show (gcd 48 18))\n  0\n"
seed_21 = "doubled xs = map double xs\ndouble x = x * 2\nmain = let _ = print (show (doubled [1, 2, 3]))\n  0\n"
seed_22 = "evens xs = filter is_even xs\nis_even n = n % 2 == 0\nmain = let _ = print (show (evens [1, 2, 3, 4, 5, 6]))\n  0\n"
seed_23 = "len_str s = length (chars s)\nmain = let _ = print (show (len_str \"hello\"))\n  0\n"
seed_24 = "has_nl s = str_contains \"\\n\" s\nmain = let _ = print (show (has_nl \"a b c\"))\n  0\n"
seed_25 = "type Res = | Ok v | Err msg\nget_ok r = match r | Ok v -> v | Err _ -> 0\nmain = let _ = print (show (get_ok (Ok 42)))\n  0\n"
seed_26 = "type Pair = | Pair a b\nfst p = match p | Pair a _ -> a\nmain = let _ = print (show (fst (Pair 3 4)))\n  0\n"
seed_27 = "id x = x\nmain = let _ = print (show (id 99))\n  0\n"
seed_28 = "compose f g x = f (g x)\ninc x = x + 1\ndec x = x - 1\nmain = let _ = print (show (compose inc dec 10))\n  0\n"
seed_29 = "triangular n = if n <= 0 then 0 else n + triangular (n - 1)\nmain = let _ = print (show (triangular 5))\n  0\n"
seed_30 = "count_down n = if n <= 0 then 0 else let _ = print (show n) in count_down (n - 1)\nmain = let _ = count_down 3\n  0\n"
seed_31 = "first_line s = head (split \"\\n\" s)\nmain = let _ = print (first_line \"abc\\ndef\")\n  0\n"
seed_32 = "split_get s = split \" \" s\nmain = let _ = print (show (split_get \"a b c\"))\n  0\n"
seed_33 = "join_csv xs = join \",\" xs\nmain = let _ = print (join_csv [\"a\", \"b\", \"c\"])\n  0\n"
seed_34 = "cube x = x * x * x\nmain = let _ = print (show (cube 3))\n  0\n"
seed_35 = "sum_sq a b = square a + square b\nsquare x = x * x\nmain = let _ = print (show (sum_sq 3 4))\n  0\n"
seed_36 = "avg2 a b = (a + b) / 2\nmain = let _ = print (show (avg2 10 20))\n  0\n"
seed_37 = "all_pos xs = fold pick 1 xs\npick acc x = if x > 0 then acc else 0\nmain = let _ = print (show (all_pos [1, 2, 3]))\n  0\n"
seed_38 = "rev_list xs = reverse xs\nmain = let _ = print (show (rev_list [1, 2, 3, 4]))\n  0\n"
seed_39 = "count_match xs v = length (filter_eq v xs)\nfilter_eq v xs = filter eqv xs\neqv x = 1 == 1\nmain = let _ = print (show (count_match [1, 2, 1, 3] 1))\n  0\n"
seed_40 = "type Stat = | Init | Run | Done\nadv s = match s | Init -> Run | Run -> Done | Done -> Done\nmain = let _ = print \"ok\"\n  0\n"

-- Single-line cons chain because Rail's parser can't span multi-line cons-nesting.
seeds_1_to_10 = cons seed_01 (cons seed_02 (cons seed_03 (cons seed_04 (cons seed_05 (cons seed_06 (cons seed_07 (cons seed_08 (cons seed_09 (cons seed_10 [])))))))))
seeds_11_to_20 = cons seed_11 (cons seed_12 (cons seed_13 (cons seed_14 (cons seed_15 (cons seed_16 (cons seed_17 (cons seed_18 (cons seed_19 (cons seed_20 [])))))))))
seeds_21_to_30 = cons seed_21 (cons seed_22 (cons seed_23 (cons seed_24 (cons seed_25 (cons seed_26 (cons seed_27 (cons seed_28 (cons seed_29 (cons seed_30 [])))))))))
seeds_31_to_40 = cons seed_31 (cons seed_32 (cons seed_33 (cons seed_34 (cons seed_35 (cons seed_36 (cons seed_37 (cons seed_38 (cons seed_39 (cons seed_40 [])))))))))

all_seeds = append (append seeds_1_to_10 seeds_11_to_20) (append seeds_21_to_30 seeds_31_to_40)

-- ── Triple emission.
format_triple broken diag fixed =
  join "" ["<BROKEN>\n", broken, if starts_with_newline broken then "" else "\n", "<DIAG>\n", diag, "\n<FIXED>\n", fixed, if starts_with_newline fixed then "" else "\n", "<END>\n\n"]

starts_with_newline s =
  if length (chars s) == 0 then 1 == 0
  else (head (chars s)) == "\n"

-- ── For a single (seed, op) pair, try N_RNG rng seeds, emit distinct triples.
rng_sweep_loop seed op rng_i fh acc seen_hashes =
  if rng_i >= n_rng_per_seed then acc
  else
    let rng = lcg_state_new (rng_i * 7919 + op * 97 + 1)
    let broken = mutate op seed rng
    if broken == seed then rng_sweep_loop seed op (rng_i + 1) fh acc seen_hashes
    else
      -- Deduplicate by string-equality against already-seen in this loop.
      if list_contains seen_hashes broken then rng_sweep_loop seed op (rng_i + 1) fh acc seen_hashes
      else
        let diag_pair = diagnose broken
        let diag = head (tail diag_pair)
        if length (chars diag) == 0 then rng_sweep_loop seed op (rng_i + 1) fh acc (cons broken seen_hashes)
        else
          let triple = format_triple broken diag seed
          let _ = append_to_file fh triple
          rng_sweep_loop seed op (rng_i + 1) fh (acc + 1) (cons broken seen_hashes)

list_contains lst item =
  if length lst == 0 then 1 == 0
  else if head lst == item then 1 == 1
  else list_contains (tail lst) item

-- ── Per-seed outer loop: try all N_OPS mutation ops.
per_seed_loop seed op fh acc =
  if op >= n_mutations then acc
  else
    let got = rng_sweep_loop seed op 0 fh 0 []
    per_seed_loop seed (op + 1) fh (acc + got)

append_to_file path text =
  let _ = write_file "/tmp/rail_triple_part.txt" text
  shell (join "" ["cat /tmp/rail_triple_part.txt >> ", path])

-- ── Outer loop over seeds.
process_seeds_loop seeds idx fh total =
  if length seeds == 0 then total
  else
    let seed = head seeds
    let got = per_seed_loop seed 0 fh 0
    let _ = print (join "" ["seed ", show idx, ": ", show got, " triples (", show (length (chars seed)), " chars seed)"])
    process_seeds_loop (tail seeds) (idx + 1) fh (total + got)

main =
  let out_path = "training/triples_v1.txt"
  let _ = shell (join "" ["rm -f ", out_path])
  let _ = write_file out_path ""
  let _ = print (join "" ["writing triples -> ", out_path, " (", show (length all_seeds), " seeds, ", show n_rng_per_seed, " rngs, ", show n_mutations, " ops)"])
  let total = process_seeds_loop all_seeds 0 out_path 0
  let _ = print (join "" ["\nharvested ", show total, " triples"])
  let sz = trim_nl (shell (join "" ["wc -c < ", out_path]))
  let _ = print (join "" ["corpus size: ", sz, " chars"])
  0

trim_nl s = head (split "\n" s)
