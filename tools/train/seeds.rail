-- seeds.rail — library of compile-clean seed programs used by gen_triples.rail.
-- Each seed must compile cleanly standalone (warnings OK, errors not). Single-
-- line `\n`-escaped definitions because Rail's parser can't span multi-line
-- string literals comfortably.
--
-- Layout: 120 seeds in 12 cons-chains of 10, then `all_seeds` joins them.

-- ─── Original 40 (seeds 1-40) ────────────────────────────────────────
seed_01 = "main = let _ = print 42\n  0\n"
seed_02 = "add a b = a + b\nmain = let _ = print (show (add 2 3))\n  0\n"
seed_03 = "fact n = if n <= 1 then 1 else n * fact (n - 1)\nmain = let _ = print (show (fact 5))\n  0\n"
seed_04 = "type Opt = | Some x | None\nunwrap o = match o | Some x -> x | None -> 0\nmain = let _ = print (show (unwrap (Some 7)))\n  0\n"
seed_05 = "sum_list xs = fold add 0 xs\nadd a b = a + b\nmain = let _ = print (show (sum_list [1, 2, 3, 4, 5]))\n  0\n"
seed_06 = "double x = x * 2\nmain = let _ = print (show (double 21))\n  0\n"
seed_07 = "reverse_str s = join \"\" (reverse (chars s))\nmain = let _ = print (reverse_str \"hello\")\n  0\n"
seed_08 = "type Tree = | Leaf | Node v l r\ncount t = match t | Leaf -> 0 | Node _ l r -> 1 + count l + count r\nmain = let _ = print (show (count (Node 1 Leaf Leaf)))\n  0\n"
seed_09 = "fib n = if n <= 1 then n else fib (n - 1) + fib (n - 2)\nmain = let _ = print (show (fib 7))\n  0\n"
seed_10 = "square x = x * x\nmain = let _ = print (show (square 9))\n  0\n"
seed_11 = "neg x = 0 - x\nmain = let _ = print (show (neg 7))\n  0\n"
seed_12 = "is_pos x = x > 0\nmain = let _ = print (show (is_pos 5))\n  0\n"
seed_13 = "max2 a b = if a > b then a else b\nmain = let _ = print (show (max2 3 7))\n  0\n"
seed_14 = "min2 a b = if a < b then a else b\nmain = let _ = print (show (min2 3 7))\n  0\n"
seed_15 = "abs_int x = if x < 0 then 0 - x else x\nmain = let _ = print (show (abs_int (0 - 12)))\n  0\n"
seed_16 = "second xs = head (tail xs)\nmain = let _ = print (show (second [10, 20, 30]))\n  0\n"
seed_17 = "third xs = head (tail (tail xs))\nmain = let _ = print (show (third [1, 2, 3, 4]))\n  0\n"
seed_18 = "sum_to n = if n <= 0 then 0 else n + sum_to (n - 1)\nmain = let _ = print (show (sum_to 5))\n  0\n"
seed_19 = "pow b n = if n == 0 then 1 else b * pow b (n - 1)\nmain = let _ = print (show (pow 2 10))\n  0\n"
seed_20 = "gcd a b = if b == 0 then a else gcd b (a % b)\nmain = let _ = print (show (gcd 48 18))\n  0\n"
seed_21 = "doubled xs = map double xs\ndouble x = x * 2\nmain = let _ = print (show (doubled [1, 2, 3]))\n  0\n"
seed_22 = "evens xs = filter is_even xs\nis_even n = n % 2 == 0\nmain = let _ = print (show (evens [1, 2, 3, 4, 5, 6]))\n  0\n"
seed_23 = "len_str s = length (chars s)\nmain = let _ = print (show (len_str \"hello\"))\n  0\n"
seed_24 = "has_nl s = str_contains \"\\n\" s\nmain = let _ = print (show (has_nl \"a b c\"))\n  0\n"
seed_25 = "type Res = | Ok v | Err msg\nget_ok r = match r | Ok v -> v | Err _ -> 0\nmain = let _ = print (show (get_ok (Ok 42)))\n  0\n"
seed_26 = "type Pair = | Pair a b\nfst p = match p | Pair a _ -> a\nmain = let _ = print (show (fst (Pair 3 4)))\n  0\n"
seed_27 = "id x = x\nmain = let _ = print (show (id 99))\n  0\n"
seed_28 = "compose f g x = f (g x)\ninc x = x + 1\ndec x = x - 1\nmain = let _ = print (show (compose inc dec 10))\n  0\n"
seed_29 = "triangular n = if n <= 0 then 0 else n + triangular (n - 1)\nmain = let _ = print (show (triangular 5))\n  0\n"
seed_30 = "count_down n = if n <= 0 then 0 else let _ = print (show n) in count_down (n - 1)\nmain = let _ = count_down 3\n  0\n"
seed_31 = "first_line s = head (split \"\\n\" s)\nmain = let _ = print (first_line \"abc\\ndef\")\n  0\n"
seed_32 = "split_get s = split \" \" s\nmain = let _ = print (show (split_get \"a b c\"))\n  0\n"
seed_33 = "join_csv xs = join \",\" xs\nmain = let _ = print (join_csv [\"a\", \"b\", \"c\"])\n  0\n"
seed_34 = "cube x = x * x * x\nmain = let _ = print (show (cube 3))\n  0\n"
seed_35 = "sum_sq a b = square a + square b\nsquare x = x * x\nmain = let _ = print (show (sum_sq 3 4))\n  0\n"
seed_36 = "avg2 a b = (a + b) / 2\nmain = let _ = print (show (avg2 10 20))\n  0\n"
seed_37 = "all_pos xs = fold pick 1 xs\npick acc x = if x > 0 then acc else 0\nmain = let _ = print (show (all_pos [1, 2, 3]))\n  0\n"
seed_38 = "rev_list xs = reverse xs\nmain = let _ = print (show (rev_list [1, 2, 3, 4]))\n  0\n"
seed_39 = "count_match xs v = length (filter_eq v xs)\nfilter_eq v xs = filter eqv xs\neqv x = 1 == 1\nmain = let _ = print (show (count_match [1, 2, 1, 3] 1))\n  0\n"
seed_40 = "type Stat = | Init | Run | Done\nadv s = match s | Init -> Run | Run -> Done | Done -> Done\nmain = let _ = print \"ok\"\n  0\n"

-- ─── String-heavy (seeds 41-55) — exercise mut_unclosed_string + join/split ops.
seed_41 = "concat_two = join \" \" [\"hello\", \"world\"]\nmain = let _ = print concat_two\n  0\n"
seed_42 = "greet name = join \"\" [\"hi \", name, \"!\"]\nmain = let _ = print (greet \"alice\")\n  0\n"
seed_43 = "first_word s = head (split \" \" s)\nmain = let _ = print (first_word \"foo bar\")\n  0\n"
seed_44 = "is_yes s = if s == \"yes\" then 1 else 0\nmain = let _ = print (show (is_yes \"yes\"))\n  0\n"
seed_45 = "csv_join xs = join \",\" xs\nmain = let _ = print (csv_join [\"a\", \"b\", \"c\"])\n  0\n"
seed_46 = "tag_int n = join \"\" [\"<int:\", show n, \">\"]\nmain = let _ = print (tag_int 42)\n  0\n"
seed_47 = "long_str = \"aaaaaaaaaaaaaaaaaaaa\"\nmain = let _ = print long_str\n  0\n"
seed_48 = "prefix_match p s = if (str_sub s 0 (length (chars p))) == p then 1 else 0\nmain = let _ = print (show (prefix_match \"foo\" \"foobar\"))\n  0\n"
seed_49 = "concat3 a b c = join \"\" [a, b, c]\nmain = let _ = print (concat3 \"x\" \"y\" \"z\")\n  0\n"
seed_50 = "lines_count s = length (split \"\\n\" s)\nmain = let _ = print (show (lines_count \"a\\nb\\nc\"))\n  0\n"
seed_51 = "has_a s = str_contains \"a\" s\nmain = let _ = print (show (has_a \"banana\"))\n  0\n"
seed_52 = "find_x s = str_find \"x\" s\nmain = let _ = print (show (find_x \"axb\"))\n  0\n"
seed_53 = "rep s = join \"\" [s, s, s]\nmain = let _ = print (rep \"ab\")\n  0\n"
seed_54 = "split_csv s = str_split \", \" s\nmain = let _ = print (show (split_csv \"a, b, c\"))\n  0\n"
seed_55 = "label_msg = join \" \" [\"INFO:\", \"ready\"]\nmain = let _ = print label_msg\n  0\n"

-- ─── Multi-arm matches (seeds 56-75) — exercise mut_drop_arrow / mut_drop_pipe.
seed_56 = "type Color = | Red | Green | Blue\ncode c = match c | Red -> 0 | Green -> 1 | Blue -> 2\nmain = let _ = print (show (code Green))\n  0\n"
seed_57 = "type Dir = | N | S | E | W\nopp d = match d | N -> S | S -> N | E -> W | W -> E\nto_i d = match d | N -> 0 | S -> 1 | E -> 2 | W -> 3\nmain = let _ = print (show (to_i (opp E)))\n  0\n"
seed_58 = "type Light = | On | Off\ntoggle l = match l | On -> Off | Off -> On\nis_on l = match l | On -> 1 | Off -> 0\nmain = let _ = print (show (is_on (toggle Off)))\n  0\n"
seed_59 = "type Bin = | Zero | One\nflip b = match b | Zero -> One | One -> Zero\nval b = match b | Zero -> 0 | One -> 1\nmain = let _ = print (show (val (flip Zero)))\n  0\n"
seed_60 = "type Suit = | Spade | Heart | Diamond | Club\nis_red s = match s | Heart -> 1 | Diamond -> 1 | Spade -> 0 | Club -> 0\nmain = let _ = print (show (is_red Heart))\n  0\n"
seed_61 = "type Op = | Add | Sub | Mul\napply o a b = match o | Add -> a + b | Sub -> a - b | Mul -> a * b\nmain = let _ = print (show (apply Mul 6 7))\n  0\n"
seed_62 = "type Sgn = | Pos | Neg | Zer\nclassify n = if n > 0 then Pos else if n < 0 then Neg else Zer\ncode s = match s | Pos -> 1 | Neg -> 0 - 1 | Zer -> 0\nmain = let _ = print (show (code (classify 5)))\n  0\n"
seed_63 = "type Maybe = | Just v | Nothing\ndefault m = match m | Just v -> v | Nothing -> 0\nmain = let _ = print (show (default (Just 9)))\n  0\n"
seed_64 = "type Shape = | Circle r | Square s | Rect w h\narea sh = match sh | Circle r -> r * r * 3 | Square s -> s * s | Rect w h -> w * h\nmain = let _ = print (show (area (Rect 3 4)))\n  0\n"
seed_65 = "type Lvl = | Low | Mid | High\nrank l = match l | Low -> 1 | Mid -> 5 | High -> 9\nmain = let _ = print (show (rank Mid))\n  0\n"
seed_66 = "type Btn = | Yes | No | Cancel\nact b = match b | Yes -> 1 | No -> 0 | Cancel -> 0 - 1\nmain = let _ = print (show (act Cancel))\n  0\n"
seed_67 = "type Day = | Mon | Tue | Wed\nnxt d = match d | Mon -> Tue | Tue -> Wed | Wed -> Mon\nidx d = match d | Mon -> 0 | Tue -> 1 | Wed -> 2\nmain = let _ = print (show (idx (nxt Mon)))\n  0\n"
seed_68 = "type Side = | LeftS | RightS\nflip s = match s | LeftS -> RightS | RightS -> LeftS\nbit s = match s | LeftS -> 0 | RightS -> 1\nmain = let _ = print (show (bit (flip LeftS)))\n  0\n"
seed_69 = "type Card = | Lo n | Hi n\nval c = match c | Lo n -> n | Hi n -> n * 10\nmain = let _ = print (show (val (Hi 7)))\n  0\n"
seed_70 = "type Pr2 = | P a b\npfst p = match p | P a b -> a\npsnd p = match p | P a b -> b\nmain = let _ = print (show (pfst (P 11 22) + psnd (P 11 22)))\n  0\n"
seed_71 = "type Lst = | Nil | Cons2 h t\nlfst xs = match xs | Nil -> 0 | Cons2 h t -> h\nmain = let _ = print (show (lfst (Cons2 5 Nil)))\n  0\n"
seed_72 = "type Tri = | Ta | Tb | Tc\ncode t = match t | Ta -> 0 | Tb -> 1 | Tc -> 2\nback i = if i == 0 then Ta else if i == 1 then Tb else Tc\nmain = let _ = print (show (code (back 1)))\n  0\n"
seed_73 = "type Result2 = | Ok2 v | Err2 e\nget r = match r | Ok2 v -> v | Err2 e -> 0 - 1\nmain = let _ = print (show (get (Ok2 100)))\n  0\n"
seed_74 = "type Animal = | Dog | Cat | Fish\nlegs a = match a | Dog -> 4 | Cat -> 4 | Fish -> 0\nmain = let _ = print (show (legs Cat))\n  0\n"
seed_75 = "type Mood = | Happy | Sad | Angry | Calm\nscore m = match m | Happy -> 10 | Sad -> 0 - 5 | Angry -> 0 - 10 | Calm -> 5\nmain = let _ = print (show (score Calm))\n  0\n"

-- ─── ADT-heavy (seeds 76-90) — exercise mut_bad_ctor_name.
seed_76 = "type Box = | Box v\nopenb b = match b | Box v -> v\ndoubleb b = match b | Box v -> Box (v * 2)\nmain = let _ = print (show (openb (doubleb (Box 7))))\n  0\n"
seed_77 = "type Pt = | Pt x y\nshift p dx = match p | Pt x y -> Pt (x + dx) (y + dx)\nptx p = match p | Pt x y -> x\nmain = let _ = print (show (ptx (shift (Pt 1 2) 10)))\n  0\n"
seed_78 = "type Triple = | Tri a b c\ntsum t = match t | Tri a b c -> a + b + c\nmain = let _ = print (show (tsum (Tri 1 2 3)))\n  0\n"
seed_79 = "type Status = | Init | Run | Done\nfinal s = match s | Init -> 0 | Run -> 0 | Done -> 1\nmain = let _ = print (show (final Done))\n  0\n"
seed_80 = "type Token = | TInt v | TStr s\ntype_id t = match t | TInt v -> 0 | TStr s -> 1\nmain = let _ = print (show (type_id (TInt 42)))\n  0\n"
seed_81 = "type Json = | JN | JB b | JI i\nis_int j = match j | JI i -> 1 | JN -> 0 | JB b -> 0\nmain = let _ = print (show (is_int (JI 5)))\n  0\n"
seed_82 = "type Tree2 = | Leaf2 | Br2 v l r\nsumt t = match t | Leaf2 -> 0 | Br2 v l r -> v + sumt l + sumt r\nmain = let _ = print (show (sumt (Br2 1 (Br2 2 Leaf2 Leaf2) Leaf2)))\n  0\n"
seed_83 = "type Key = | KStr s | KInt n\nkey_id k = match k | KStr s -> 0 | KInt n -> 1\nmain = let _ = print (show (key_id (KStr \"x\")))\n  0\n"
seed_84 = "type Sum4 = | Aa | Bb | Cc | Dd\nrank2 s = match s | Aa -> 1 | Bb -> 2 | Cc -> 3 | Dd -> 4\nmain = let _ = print (show (rank2 Cc))\n  0\n"
seed_85 = "type Vec = | V x y z\nvsum v = match v | V x y z -> x + y + z\nmain = let _ = print (show (vsum (V 4 5 6)))\n  0\n"
seed_86 = "type Wrap = | W a\nupw f w = match w | W a -> W (f a)\noutw w = match w | W a -> a\ndbl x = x * 2\nmain = let _ = print (show (outw (upw dbl (W 11))))\n  0\n"
seed_87 = "type Ev = | EvA n | EvB n\nev_val e = match e | EvA n -> n | EvB n -> n * 2\nmain = let _ = print (show (ev_val (EvB 7) + ev_val (EvA 3)))\n  0\n"
seed_88 = "type Tagged = | Tag s n\ntag_n t = match t | Tag s n -> n\ntag_s t = match t | Tag s n -> s\nmain = let _ = print (tag_s (Tag \"key\" 9))\n  0\n"
seed_89 = "type State = | StateA n | StateB s n\nstn st = match st | StateA n -> n | StateB s n -> n\nmain = let _ = print (show (stn (StateB \"x\" 100)))\n  0\n"
seed_90 = "type Cell = | Empty | Filled v\ncval c = match c | Empty -> 0 | Filled v -> v\nmain = let _ = print (show (cval (Filled 42)))\n  0\n"

-- ─── == comparisons (seeds 91-105) — exercise mut_swap_eq_assign.
seed_91 = "is_zero n = if n == 0 then 1 else 0\nmain = let _ = print (show (is_zero 0))\n  0\n"
seed_92 = "is_eq a b = if a == b then 1 else 0\nmain = let _ = print (show (is_eq 7 7))\n  0\n"
seed_93 = "type_check a b = if a == b then a else 0\nmain = let _ = print (show (type_check 5 5))\n  0\n"
seed_94 = "div_safe a b = if b == 0 then 0 else a / b\nmain = let _ = print (show (div_safe 10 0))\n  0\n"
seed_95 = "all_eq3 a b c = if a == b then (if b == c then 1 else 0) else 0\nmain = let _ = print (show (all_eq3 4 4 4))\n  0\n"
seed_96 = "first_zero xs = if length xs == 0 then 0 - 1 else if head xs == 0 then 0 else first_zero (tail xs)\nmain = let _ = print (show (first_zero [1, 0, 2]))\n  0\n"
seed_97 = "is_a s = if s == \"a\" then 1 else 0\nmain = let _ = print (show (is_a \"a\"))\n  0\n"
seed_98 = "any_eq xs v = if length xs == 0 then 0 else if head xs == v then 1 else any_eq (tail xs) v\nmain = let _ = print (show (any_eq [1, 2, 3] 2))\n  0\n"
seed_99 = "even_n n = if n % 2 == 0 then 1 else 0\nmain = let _ = print (show (even_n 8))\n  0\n"
seed_100 = "ones xs = if length xs == 0 then 0 else (if head xs == 1 then 1 else 0) + ones (tail xs)\nmain = let _ = print (show (ones [1, 2, 1, 1, 3]))\n  0\n"
seed_101 = "match_check a b = if a == b then a + b else 0\nmain = let _ = print (show (match_check 6 6))\n  0\n"
seed_102 = "all_zeros xs = if length xs == 0 then 1 else if head xs == 0 then all_zeros (tail xs) else 0\nmain = let _ = print (show (all_zeros [0, 0, 0]))\n  0\n"
seed_103 = "key_eq a b = if a == b then 1 else 0\nmain = let _ = print (show (key_eq \"foo\" \"foo\"))\n  0\n"
seed_104 = "is_one n = if n == 1 then n + 99 else 0 - 1\nis_two n = if n == 2 then n * 50 else 0 - 5\nmain = let _ = print (show (is_one 1 + is_two 2))\n  0\n"
seed_105 = "leq_eq a b = if a == b then 0 else if a < b then 0 - 1 else 1\nmain = let _ = print (show (leq_eq 5 5))\n  0\n"

-- ─── Arithmetic chains (seeds 106-120) — exercise mut_type_mismatch.
seed_106 = "mix1 a b = a * 2 + b * 3\nmain = let _ = print (show (mix1 10 7))\n  0\n"
seed_107 = "poly x = x * x + x * 2 + 1\nmain = let _ = print (show (poly 5))\n  0\n"
seed_108 = "dot3 a b c x y z = a * x + b * y + c * z\nmain = let _ = print (show (dot3 1 2 3 4 5 6))\n  0\n"
seed_109 = "scale a b = a * 100 + b\nmain = let _ = print (show (scale 3 7))\n  0\n"
seed_110 = "ema a b k = a * k + b * (100 - k)\nmain = let _ = print (show (ema 50 80 30))\n  0\n"
seed_111 = "quad a b c x = a * x * x + b * x + c\nmain = let _ = print (show (quad 1 2 3 4))\n  0\n"
seed_112 = "tri n = n * (n + 1) / 2\nmain = let _ = print (show (tri 10))\n  0\n"
seed_113 = "vol l w h = l * w * h\nmain = let _ = print (show (vol 3 4 5))\n  0\n"
seed_114 = "delta a b = a * a - b * b\nmain = let _ = print (show (delta 5 3))\n  0\n"
seed_115 = "blend a b k = (a * k + b * (10 - k)) / 10\nmain = let _ = print (show (blend 100 200 3))\n  0\n"
seed_116 = "stride n m = n + m * 4\nmain = let _ = print (show (stride 3 5))\n  0\n"
seed_117 = "sum4 a b c d = a + b + c + d\nmain = let _ = print (show (sum4 1 2 3 4))\n  0\n"
seed_118 = "mul3 a b c = a * b * c\nmain = let _ = print (show (mul3 2 3 4))\n  0\n"
seed_119 = "linear m x b = m * x + b\nmain = let _ = print (show (linear 2 5 3))\n  0\n"
seed_120 = "expr a b c = a + b * c - a * b\nmain = let _ = print (show (expr 2 3 4))\n  0\n"

