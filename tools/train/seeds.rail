all_old = append (append seeds_1_to_10 seeds_11_to_20) (append seeds_21_to_30 seeds_31_to_40)
all_new1 = append (append seeds_41_to_50 seeds_51_to_60) (append seeds_61_to_70 seeds_71_to_80)
