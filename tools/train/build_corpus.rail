-- tools/train/build_corpus.rail — concatenate every stdlib/*.rail file
-- into a single text corpus for tokenizer/LM training.
--
-- Layout:
--   <blank>
--   -- FILE: stdlib/<name>.rail
--   <file contents>
--   <blank>
--   -- FILE: stdlib/<next>.rail
--   ...
--
-- The blank line + `-- FILE:` marker is a lightweight document separator
-- the LM can learn. Since each file already ends in `\n`, this gives the
-- spec'd `\n-- FILE: <path>\n` delimiter naturally.
--
-- We shell out the actual concatenation (`cat >>`) rather than building
-- a giant string in Rail — the bump allocator has a hard wall on strings
-- in the hundreds of KB, and the corpus is ~540 KB.
--
-- Usage: ./rail_native run tools/train/build_corpus.rail
-- Output: training/rail_corpus_stdlib.txt

corpus_out = "training/rail_corpus_stdlib.txt"

-- Fresh, zero-byte output.
trunc_out path =
  let _ = shell (cat ["mkdir -p \"$(dirname '", path, "')\" && : > '", path, "'"])
  0

-- Append one file: blank line + `-- FILE: <path>` header + file body.
append_entry out relpath =
  let cmd = cat ["{ echo ''; echo '-- FILE: ", relpath, "'; cat '", relpath, "'; } >> '", out, "'"]
  let _ = shell cmd
  0

-- Walk the path list; skip empty entries (trailing newline from `ls`).
build_all_loop out paths =
  if length paths == 0 then 0
  else
    let p = head paths
    if length p == 0 then build_all_loop out (tail paths)
    else
      let _ = append_entry out p
      build_all_loop out (tail paths)

main =
  let _ = trunc_out corpus_out
  -- Alphabetical order for determinism across runs / machines.
  let list_out = shell "ls -1 stdlib/*.rail | LC_ALL=C sort"
  let paths = split "\n" list_out
  let n_files = length paths
  let _ = print (cat ["files: ", show n_files])
  let _ = build_all_loop corpus_out paths
  let sz = shell (cat ["wc -c < '", corpus_out, "' | tr -d ' \n'"])
  let _ = print (cat ["wrote: ", corpus_out, "  size_bytes=", sz])
  0
