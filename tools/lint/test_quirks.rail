-- tools/lint/test_quirks.rail — synthetic corpus for check_quirks.rail
-- This file deliberately contains one example of each quirk we want to catch.
-- It is NOT meant to compile; it is parsed-as-text by the linter only.

-- Q001 — heterogeneous numeric literal list (int and float mixed)
mixed_list = [1, 2.5, 3]

-- A clean float-returning helper used for Q003 below.
make_float x = 1.5 + x

-- Q002 — high-arity helper (11 params on the LHS)
big_helper a b c d e f g h i j k = a + b + c + d + e + f + g + h + i + j + k

-- Q003 — unwrapped call to a float-returning fn (should be `0.0 + make_float 2`)
user_of_float = make_float 2

main =
  let _ = print (show mixed_list)
  let _ = print (show big_helper)
  let _ = print (show user_of_float)
  0
