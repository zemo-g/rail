-- tools/spurarm/corpus/v2/templates.rail
--
-- DATA module: the 60/24/8/12 template tables per SPEC §2.
--
-- This file is pure data. The Cartesian sampling logic lives in
-- synthesize_procedural.rail; we keep the lists here so adding a
-- new verb / adverb / target-form / landmark is a one-line diff.
--
-- IMPORTANT: this file is currently NOT imported by
-- synthesize_procedural.rail; instead, the same lists are inlined
-- there. The reason is operational, not architectural:
--   * Rail's import system shares module-level state per top-level
--     `import` in the parent file.
--   * The procedural generator is already at the edge of what fits
--     comfortably alongside arm_sim + coord_map; adding another
--     import enlarges the surface where the json+arm_sim conflict
--     pattern from [[feedback_rail_compile_traps]] could re-trigger.
-- If a future bump-up of vocabulary makes inlining unwieldy, switch
-- synthesize_procedural to `import "tools/spurarm/corpus/v2/templates.rail"`
-- and delete the inline copies there. The exported names match.

-- 60 verbs (spec §2 row 1).
verbs_60 = [
  "move", "reach", "go", "navigate", "place", "position", "send",
  "push", "shift", "slide", "ease", "glide", "dart", "advance",
  "retreat", "lift", "drop", "pluck", "grab", "snatch",
  "set", "lay", "plant", "drop off", "retrieve", "fetch", "return",
  "park", "sit", "idle", "sweep", "draw", "trace", "scan",
  "brush", "scribble", "hop", "jump", "dab", "tap",
  "poke", "tip", "touch", "kiss", "point", "gesture", "wave",
  "salute", "wiggle", "nudge", "edge", "drift", "hover",
  "settle", "perch", "rest", "halt", "freeze", "pause", "travel"]

-- 24 adverbs / qualifiers (spec §2 row 2).
adverbs_24 = [
  "slowly", "quickly", "smoothly", "carefully", "precisely",
  "gently", "briskly", "rapidly", "deliberately", "casually",
  "firmly", "lightly", "in a hurry", "without rushing",
  "with care", "exactly", "approximately", "roughly",
  "just barely", "a little", "way over", "slightly",
  "partially", "fully"]

-- 8 target-form codes (spec §2 row 3). The rendering function lives
-- in synthesize_procedural.rail::render_target_form because forms
-- 5/6/7 need a coord context to expand against.
--
-- 0: exact coords "(x, y, z)"
-- 1: "coordinates x y z"
-- 2: "the position (x, y, z)"
-- 3: named point A/B/C/D
-- 4: ORIGIN
-- 5: relative offset ("2 cm to the right of B")
-- 6: descriptive ("upper-left corner")
-- 7: "current position" + delta

-- 12 landmarks / contexts (spec §2 row 4).
landmarks_12 = [
  "",
  "from where you are",
  "above the table",
  "before you do anything else",
  "after a brief pause",
  "then return",
  "while gripping",
  "once you reach it",
  "if you can",
  "even if it's awkward",
  "as best you can",
  "starting from home"]

-- Named points referenced by target-form codes 3 and 5.
template_named_names = ["A", "B", "C", "D"]
template_named_coords =
  [[10, 0, 5],
   [10, 10, 5],
   [20, 10, 5],
   [20, 20, 5]]
