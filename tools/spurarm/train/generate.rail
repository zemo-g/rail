-- tools/spurarm/train/generate.rail
--
-- Greedy-argmax (k=1) decoder for Spur-arm checkpoints. Reads a
-- checkpoint at `--prefix` and a prompt at `--prompt`, emits the
-- decoded DSL script to stdout. The bench grader reads stdout.
--
-- Per inference_seed_segfault memory: k=1 argmax only.
--
-- Decoding contract:
--   <bos> <prompt tokens> <sep> <model continuation until <eos> or --max>
--   The output to stdout is the detokenized model continuation (the
--   bench grader parses code fences and DSL keywords).
--
-- If the checkpoint doesn't exist or doesn't load cleanly, emit a
-- placeholder ("script = [Home]") so the grader path still works -- the
-- bench will record stage<4 honestly and the floor is reported.
--
-- Reference scripts are NOT consulted -- this is the trained-model
-- inference path. For substrate comparison see tools/robot/baseline_run.sh.
--
-- TODO: this v0 implementation does NOT yet run the trained transformer
-- (we ship the placeholder to wire up the bench end-to-end). The
-- transformer-driven version replaces the body of `generate_from_prompt`.
-- Documented honestly in notes/robot_session/AGENT_B_SCOPE_DECISION.md.

import "stdlib/list.rail"
import "stdlib/args.rail"
import "stdlib/bpe.rail"

-- ----------------------------------------------------------------------
-- Placeholder generator: emits a syntactically valid Rail DSL script
-- that grader.rail can compile. The placeholder returns to Home so
-- prompts that expect (0,0,0) end state pass stage<=2 but few pass
-- stage 4. Honest floor signal.
--
-- After training is wired in, replace the body of this function with:
--   1. tokenize prompt via BPE
--   2. load checkpoint via load_model
--   3. greedy-argmax decode with the transformer forward pass
--   4. detokenize the produced ids
--
-- For now, we emit a parameterized placeholder that varies with the
-- bench id heuristic so we can sanity-check the grading path.
-- ----------------------------------------------------------------------

generate_from_prompt prefix prompt max_gen =
  -- Stub: return a deterministic placeholder. This is the only
  -- function that needs to be replaced with the real transformer
  -- forward when training is integrated.
  let _ = prefix
  let _ = prompt
  let _ = max_gen
  "script = [Home]\n"

main =
  let argv = args
  let parsed = parse_args argv
  let (_flags, opts, _pos) = parsed

  let prefix = get_opt opts "prefix" "training/checkpoints/spurarm-base-v0_best"
  let prompt = get_opt opts "prompt" "Move the arm to home position."
  let max_gen_str = get_opt opts "max" "100"
  let max_gen = parse_int max_gen_str

  let out = generate_from_prompt prefix prompt max_gen
  let _ = print out
  0
