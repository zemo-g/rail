-- tools/spurarm/train/ckpt_card.rail
--
-- Given a checkpoint prefix, emit / update the .meta file with the
-- canonical card schema for Spur-arm v0:
--
--   step=<int>
--   best_val_loss=<float>
--   seed=<int>
--   phase=pretrain|sft
--   recipe=<string>          short recipe id ("v0-1layer-d384")
--   tokenizer=<vocab>        canonical tokenizer prefix name
--   bench_v0_passes=<int>    optional, post-bench-eval
--   git_sha=<short>          provenance
--
-- save_checkpoint in stdlib/checkpoint.rail writes step + best_val_loss
-- by default. This tool layers the seed/phase/recipe/sha fields on top
-- so the watcher and the chain entry have all the provenance they need
-- from one .meta file.
--
-- Usage:
--   ./rail_native run tools/spurarm/train/ckpt_card.rail \
--     --prefix training/checkpoints/spurarm-base-v0_seed42_pretrain_final \
--     --seed 42 --phase pretrain --recipe v0-1layer-d384-bpe512 \
--     --bench 0

import "stdlib/list.rail"
import "stdlib/args.rail"

read_file_safe path =
  let r = shell (cat ["test -f ", path, " && echo 1 || echo 0"])
  if str_contains "1" r then read_file path
  else ""

main =
  let argv = args
  let parsed = parse_args argv
  let (_flags, opts, _pos) = parsed

  let prefix = get_opt opts "prefix" ""
  if length prefix == 0 then
    let _ = print "usage: ckpt_card.rail --prefix <ckpt_prefix> --seed N --phase P --recipe R [--bench B]"
    1
  else
    let seed = get_opt opts "seed" "0"
    let phase = get_opt opts "phase" "pretrain"
    let recipe = get_opt opts "recipe" "v0-1layer-d384-bpe512"
    let bench = get_opt opts "bench" ""
    let tokenizer = get_opt opts "tokenizer" "training/tokenizer/spurarm_v0_bpe512"

    let git_sha = shell "git rev-parse --short HEAD 2>/dev/null | tr -d '\\n' || echo unknown"

    let meta_path = cat [prefix, ".meta"]
    let existing = read_file_safe meta_path

    -- Append fields if not already present. Naive: just rewrite the file.
    let lines = split (char_from_int 10) existing
    let body = if length existing == 0 then "" else existing

    let extras = cat [
      "seed=", seed, "\n",
      "phase=", phase, "\n",
      "recipe=", recipe, "\n",
      "tokenizer=", tokenizer, "\n",
      "git_sha=", git_sha, "\n",
      "bench_v0_passes=", bench, "\n"
    ]

    let new_body = cat [body, extras]
    let _ = write_file meta_path new_body
    let _ = print (cat ["updated ", meta_path])
    0
