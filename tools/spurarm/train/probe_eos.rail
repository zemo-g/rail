-- tools/spurarm/train/probe_eos.rail
--
-- Stage 6 pre-probe: at each generated step, logs the argmax token + its
-- probability and p(EOS=2). Decisively names the Stage 6 cap:
--   - p(EOS) tiny everywhere ⇒ Cap E (loss/EOS supervision)
--   - p(EOS) reasonable but argmax cycles ⇒ Cap F (decoding regularization)
--   - both look fine but bench fails ⇒ Cap D (architecture)

import "stdlib/list.rail"
import "stdlib/args.rail"
import "stdlib/bpe.rail"
import "stdlib/transformer.rail"
import "stdlib/optim.rail"
import "stdlib/checkpoint.rail"
import "stdlib/spurarm_model.rail"

fixed_seq_len _ = 48
tokenizer_prefix _ = "training/tokenizer/spurarm_v0_bpe512"
bos_id _ = 1
eos_id _ = 2
sep_id _ = 3

unwrap t = match t | Tensor d _ _ -> d

relu_fwd_simple src dst n i =
  if i >= n then 0
  else
    let v = float_arr_get src i
    let pos = if v > 0.0 then v else 0.0
    let _ = float_arr_set dst i pos
    relu_fwd_simple src dst n (i + 1)

pe_loop arr seq d p k =
  if p >= seq then 0
  else if k >= d then pe_loop arr seq d (p + 1) 0
  else
    let exp_arg = int_to_float (k - (k % 2)) / int_to_float d
    let denom = pow 10000.0 exp_arg
    let angle = int_to_float p / denom
    let v = if (k % 2) == 0 then sin angle else cos angle
    let _ = float_arr_set arr (p * d + k) v
    pe_loop arr seq d p (k + 1)

build_pe seq d =
  let arr = float_arr_new (seq * d) 0.0
  let _ = pe_loop arr seq d 0 0
  arr

add_buf_inplace dst src n i =
  if i >= n then 0
  else
    let cur = float_arr_get dst i
    let s = float_arr_get src i
    let _ = float_arr_set dst i (cur + s)
    add_buf_inplace dst src n (i + 1)

forward_inf x w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff =
  let e = matmul x w_e
  -- Cap D (Stage 6): RoPE replaces additive sinusoidal-PE.
  let x_pe = e
  let ln1_out = layernorm x_pe ln_g ln_b
  let q = matmul ln1_out w_q
  let k = matmul ln1_out w_k
  let v = matmul ln1_out w_v
  let _ = rope_apply q
  let _ = rope_apply k
  let kt = tensor_transpose k
  let scores = matmul q kt
  let scale = 1.0 / sqrt (int_to_float d)
  let scaled = tensor_scale scores scale
  let sd = unwrap scaled
  let _ = apply_causal_mask_loop sd seq 0 0
  let attn = tensor_softmax scaled
  let attn_out = matmul attn v
  let x_attn = tensor_add x_pe attn_out
  let ln2_out = layernorm x_attn ln_g ln_b
  let ffn_h_pre = matmul ln2_out w_f1
  let ffn_h_pre_d = unwrap ffn_h_pre
  let ffn_h_data = float_arr_new (seq * d_ff) 0.0
  let _ = relu_fwd_simple ffn_h_pre_d ffn_h_data (seq * d_ff) 0
  let ffn_h = Tensor ffn_h_data (cons seq (cons d_ff [])) (compute_strides (cons seq (cons d_ff [])))
  let ffn_out = matmul ffn_h w_f2
  let x_blk = tensor_add x_attn ffn_out
  let logits = matmul x_blk w_o
  let probs = tensor_softmax logits
  probs

clamp_id id V =
  if id < 0 then 0
  else if id >= V then 0
  else id

zero_arr_loop arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 0.0
    zero_arr_loop arr n (i + 1)

fill_input_loop x_data ids n seq V i =
  if i >= seq then 0
  else
    let id_raw = if i < n then list_nth i ids else 0
    let id = clamp_id id_raw V
    let _ = float_arr_set x_data (i * V + id) 1.0
    fill_input_loop x_data ids n seq V (i + 1)

build_input_array x_data ids seq V =
  let n = length ids
  let _ = zero_arr_loop x_data (seq * V) 0
  let _ = fill_input_loop x_data ids n seq V 0
  0

argmax_row_inner probs row V j best_id best_val =
  if j >= V then best_id
  else
    let p = float_arr_get probs (row * V + j)
    if p > best_val then argmax_row_inner probs row V (j + 1) j p
    else argmax_row_inner probs row V (j + 1) best_id best_val

argmax_row probs row V =
  argmax_row_inner probs row V 1 0 (float_arr_get probs (row * V))

argmax_val_inner probs row V j best_val =
  if j >= V then best_val
  else
    let p = float_arr_get probs (row * V + j)
    if p > best_val then argmax_val_inner probs row V (j + 1) p
    else argmax_val_inner probs row V (j + 1) best_val

argmax_val probs row V =
  argmax_val_inner probs row V 1 (float_arr_get probs (row * V))

-- Format a float to 6 decimal places via int scaling. Returns a string.
fmt_prob p =
  let scaled = float_to_int (p * 1000000.0)
  let whole = scaled / 1000000
  let frac = scaled - (whole * 1000000)
  let frac_str =
    if frac < 10 then join "" (cons "00000" (cons (show frac) []))
    else if frac < 100 then join "" (cons "0000" (cons (show frac) []))
    else if frac < 1000 then join "" (cons "000" (cons (show frac) []))
    else if frac < 10000 then join "" (cons "00" (cons (show frac) []))
    else if frac < 100000 then join "" (cons "0" (cons (show frac) []))
    else show frac
  join "" (cons (show whole) (cons "." (cons frac_str [])))

-- Probe loop. At each step, fill input from current ids, run forward, log:
--   step | top_id | top_prob | p(EOS) | top_id_text
probe_loop ids cur_len weights pe seq V d d_ff x_data x_t bpe step max_steps max_eos =
  if step >= max_steps then max_eos
  else if cur_len >= seq then max_eos
  else
    let mk = arena_mark 0
    let w_e = list_nth 0 weights
    let w_q = list_nth 1 weights
    let w_k = list_nth 2 weights
    let w_v = list_nth 3 weights
    let w_o = list_nth 4 weights
    let w_f1 = list_nth 5 weights
    let w_f2 = list_nth 6 weights
    let ln_g = list_nth 7 weights
    let ln_b = list_nth 8 weights
    let _ = build_input_array x_data ids seq V
    let probs_t = forward_inf x_t w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff
    let pd = unwrap probs_t
    let row = cur_len - 1
    let top_id = argmax_row pd row V
    let top_val = argmax_val pd row V
    let eos_p = float_arr_get pd (row * V + (eos_id 0))
    let top_text = bpe_decode bpe (cons top_id [])
    let parts =
      cons "step=" (
      cons (show step) (
      cons " cur_len=" (
      cons (show cur_len) (
      cons " top_id=" (
      cons (show top_id) (
      cons " top_p=" (
      cons (fmt_prob top_val) (
      cons " p(EOS)=" (
      cons (fmt_prob eos_p) (
      cons " top_text=" (
      cons top_text [])))))))))))
    let line = join "" parts
    let _ = print line
    let new_max_eos = if eos_p > max_eos then eos_p else max_eos
    let _ = arena_reset mk
    let new_ids = append ids (cons top_id [])
    probe_loop new_ids (cur_len + 1) weights pe seq V d d_ff x_data x_t bpe (step + 1) max_steps new_max_eos

build_weight_tensors V d d_ff =
  let we_data = float_arr_new (V * d) 0.0
  let w_e = Tensor we_data (cons V (cons d [])) (compute_strides (cons V (cons d [])))
  let wq_data = float_arr_new (d * d) 0.0
  let w_q = Tensor wq_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wk_data = float_arr_new (d * d) 0.0
  let w_k = Tensor wk_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wv_data = float_arr_new (d * d) 0.0
  let w_v = Tensor wv_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wo_data = float_arr_new (d * V) 0.0
  let w_o = Tensor wo_data (cons d (cons V [])) (compute_strides (cons d (cons V [])))
  let wf1_data = float_arr_new (d * d_ff) 0.0
  let w_f1 = Tensor wf1_data (cons d (cons d_ff [])) (compute_strides (cons d (cons d_ff [])))
  let wf2_data = float_arr_new (d_ff * d) 0.0
  let w_f2 = Tensor wf2_data (cons d_ff (cons d [])) (compute_strides (cons d_ff (cons d [])))
  let lng_data = float_arr_new d 1.0
  let ln_g = Tensor lng_data (cons d []) (cons 1 [])
  let lnb_data = float_arr_new d 0.0
  let ln_b = Tensor lnb_data (cons d []) (cons 1 [])
  cons w_e (cons w_q (cons w_k (cons w_v (cons w_o (cons w_f1 (cons w_f2 (cons ln_g (cons ln_b []))))))))

build_prompt_ids bpe prompt =
  let raw = bpe_encode bpe prompt
  let with_bos = cons (bos_id 0) raw
  append with_bos (cons (sep_id 0) [])

main =
  let argv = args
  let parsed = parse_args argv
  let (_flags, opts, _pos) = parsed

  let prefix = get_opt opts "prefix" "training/checkpoints/spurarm-base-v0_seed314_pretrain_final"
  let prompt = get_opt opts "prompt" "Move the arm to point A."
  let max_steps = parse_int (get_opt opts "max" "12")

  let seq = fixed_seq_len 0
  let d = spurarm_v0_d_model 0
  let V = spurarm_v0_vocab_size 0
  let d_ff = spurarm_v0_d_ff 0

  let have_ckpt = ckpt_exists prefix
  if have_ckpt == 0 then
    let _ = print "probe: ckpt missing, exiting"
    0
  else
    let bpe = bpe_load (tokenizer_prefix 0)
    let weights = build_weight_tensors V d d_ff
    let _ = load_model_into prefix weights
    let pe = build_pe seq d
    let x_data = float_arr_new (seq * V) 0.0
    let x_t = Tensor x_data (cons seq (cons V [])) (compute_strides (cons seq (cons V [])))
    let prompt_ids = build_prompt_ids bpe prompt
    let p_len = length prompt_ids
    let hdr =
      cons "probe: prefix=" (
      cons prefix (
      cons " p_len=" (
      cons (show p_len) (
      cons " V=" (
      cons (show V) (
      cons " EOS_id=" (
      cons (show (eos_id 0)) [])))))))
    let _ = print (join "" hdr)
    let max_eos = probe_loop prompt_ids p_len weights pe seq V d d_ff x_data x_t bpe 0 max_steps 0.0
    let tail =
      cons "probe: max_p(EOS) over " (
      cons (show max_steps) (
      cons " steps = " (
      cons (fmt_prob max_eos) [])))
    let _ = print (join "" tail)
    0
