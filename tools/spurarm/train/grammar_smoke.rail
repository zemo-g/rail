-- tools/spurarm/train/grammar_smoke.rail
--
-- Smoke harness for stdlib/rail_grammar.rail. Walks reference scripts
-- (expected valid) and known-degenerate model outputs (expected invalid)
-- through the validator. Prints PASS/FAIL summary.

import "stdlib/list.rail"
import "stdlib/rail_grammar.rail"

check_case label text expect_valid expected_acc actual_acc =
  let got = is_valid_prefix text
  let ok = if got == expect_valid then 1 else 0
  let mark = if ok == 1 then "OK  " else "FAIL"
  let _ = print (cat [mark, " | expect=", show expect_valid, " got=", show got, " | ", label])
  (expected_acc + 1, actual_acc + ok)

main =
  let r0 = check_case "complete b01 ref" "script = [\n  MoveTo 10 0 5\n]\n" 1 0 0
  let (e0, a0) = r0
  let r1 = check_case "complete b06 ref" "script = [\n  MoveTo 10 0 5,\n  SetGrip GripClose,\n  MoveTo 10 10 5,\n  SetGrip GripOpen\n]\n" 1 e0 a0
  let (e1, a1) = r1
  let r2 = check_case "complete with helpers" "script = [\n  move_to 10 0 5,\n  grip_close,\n  move_to 10 10 5,\n  grip_open\n]\n" 1 e1 a1
  let (e2, a2) = r2
  let r3 = check_case "empty list" "script = []" 1 e2 a2
  let (e3, a3) = r3
  let r4 = check_case "prefix mid-keyword" "scri" 1 e3 a3
  let (e4, a4) = r4
  let r5 = check_case "prefix after eq" "script = " 1 e4 a4
  let (e5, a5) = r5
  let r6 = check_case "prefix in cmd name" "script = [MoveT" 1 e5 a5
  let (e6, a6) = r6
  let r7 = check_case "prefix mid-args" "script = [MoveTo 10 0 " 1 e6 a6
  let (e7, a7) = r7
  let r8 = check_case "prefix after grip" "script = [SetGrip GripOp" 1 e7 a7
  let (e8, a8) = r8

  let r10 = check_case "degenerate CCCC" "script = [CCCCC" 0 e8 a8
  let (e10, a10) = r10
  let r11 = check_case "degenerate cycle script = [script = [" "script = [script = [" 0 e10 a10
  let (e11, a11) = r11
  let r12 = check_case "missing keyword" "[MoveTo 10 0 5]" 0 e11 a11
  let (e12, a12) = r12
  let r13 = check_case "bad keyword" "movetoo 1 2 3" 0 e12 a12
  let (e13, a13) = r13
  let r14 = check_case "letters in int slot" "script = [MoveTo 10 0 x" 0 e13 a13
  let (e14, a14) = r14
  let r15 = check_case "junk after close" "script = []garbage" 0 e14 a14
  let (e15, a15) = r15
  let r16 = check_case "unknown cmd" "script = [Teleport 1 2 3]" 0 e15 a15
  let (e16, a16) = r16
  let r17 = check_case "bad grip arg" "script = [SetGrip Foo]" 0 e16 a16
  let (e17, a17) = r17

  let _ = print (cat ["===", show a17, "/", show e17, " grammar smoke cases PASS ==="])
  if a17 == e17 then 0 else 1
