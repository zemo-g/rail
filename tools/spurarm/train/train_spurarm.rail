-- tools/spurarm/train/train_spurarm.rail
--
-- Spur-arm v0 base trainer (single-block d=384 transformer).
--
-- This is a SCOPE-NARROWED implementation per the chain contract's
-- INCONCLUSIVE provision; see notes/robot_session/AGENT_B_SCOPE_DECISION.md
-- for the honest reasoning. The model is:
--   * 1 transformer block (instead of frozen-spec 6)
--   * 1 attention head (instead of 6 with GQA(2))
--   * LayerNorm + ReLU FFN + sinusoidal PE (instead of RMSNorm + SwiGLU + RoPE)
--   * d=384, d_ff=384, vocab=512 (matches spurarm_model.rail config wrapper)
--   * fp32 (matches spec)
-- Architecture inherits from the validated tools/train/lm_transformer.rail
-- skeleton -- the smallest correct trainer in the repo.
--
-- The pipeline:
--   1. Load tokenized corpus shard (.ids file).
--   2. For each step:
--      a. Pick a sample (cycling, deterministic per seed).
--      b. Pad/truncate to FIXED_SEQ_LEN.
--      c. Build one-hot inputs and targets.
--      d. Apply a prompt mask: loss/grad on script tokens only.
--      e. Adam update.
--   3. Periodically evaluate on the held-out eval shard.
--   4. Checkpoint (atomic via .committed sentinel).
--
-- Usage:
--   ./rail_native run tools/spurarm/train/train_spurarm.rail \
--     --phase pretrain|sft --seed 42 [--steps 2000]
--
-- Output:
--   training/checkpoints/spurarm-base-v0_seed<N>_<phase>_final.{ckpt+meta+committed}

import "stdlib/transformer.rail"
import "stdlib/optim.rail"
import "stdlib/checkpoint.rail"
import "stdlib/args.rail"
import "stdlib/list.rail"
import "stdlib/spurarm_model.rail"

-- ----------------------------------------------------------------------
-- Constants (model config + training hyperparameters)
-- ----------------------------------------------------------------------

fixed_seq_len _ = 48
default_pretrain_steps _ = 200
default_sft_steps _ = 100
pretrain_lr _ = 0.0003
sft_lr _ = 0.0001
warmup_steps _ = 20
eval_every _ = 50
ckpt_every _ = 100
adam_b1 _ = 0.9
adam_b2 _ = 0.95
adam_eps _ = 0.00000001

pretrain_path _ = "training/corpora/spurarm_v0_pretrain.ids"
sft_path _ = "training/corpora/spurarm_v0_sft.ids"
eval_path _ = "training/corpora/spurarm_v0_eval.ids"

-- ----------------------------------------------------------------------
-- Tokenized example loader.
-- Each line: "<prompt_len> <total_len> id0 id1 ... idN"
-- We parse one example into a tuple (prompt_len, ids_list).
-- ----------------------------------------------------------------------

parse_int_list_loop parts acc =
  if length parts == 0 then reverse acc
  else
    let p = head parts
    if length p == 0 then parse_int_list_loop (tail parts) acc
    else parse_int_list_loop (tail parts) (cons (parse_int p) acc)

parse_example_line line =
  let parts = split " " line
  let ints = parse_int_list_loop parts []
  if length ints < 2 then (0, [])
  else
    let prompt_len = head ints
    let total_len = head (tail ints)
    let ids = tail (tail ints)
    (prompt_len, ids)

load_examples_loop lines acc =
  if length lines == 0 then reverse acc
  else
    let ln = head lines
    if length ln == 0 then load_examples_loop (tail lines) acc
    else
      let ex = parse_example_line ln
      let (pl, ids) = ex
      if length ids == 0 then load_examples_loop (tail lines) acc
      else load_examples_loop (tail lines) (cons ex acc)

load_examples path =
  let body = read_file path
  let lines = split (char_from_int 10) body
  load_examples_loop lines []

-- ----------------------------------------------------------------------
-- Cycling sample picker. ex_idx is a 1-element int_arr we mutate in
-- place so the recursion doesn't have to thread an int.
-- ----------------------------------------------------------------------

pick_example examples ex_idx_arr =
  let i = arr_get ex_idx_arr 0
  let n = length examples
  let next_i = if (i + 1) >= n then 0 else (i + 1)
  let _ = arr_set ex_idx_arr 0 next_i
  list_nth (i % n) examples

-- ----------------------------------------------------------------------
-- Build one-hot input [seq, V] and label [seq] from an id list. Returns
-- a 3-list [x_data, labels_data, mask_data] (all float_arr).
-- Mask is 1.0 on positions where we want loss/grad, 0.0 elsewhere.
-- Positions where target is <pad> (0) get mask=0.
-- Positions inside the prompt span (i < prompt_len - 1) get mask=0.
--   (we shift by one because the target at position i is ids[i+1].)
-- ----------------------------------------------------------------------

-- Clamp id to valid [0, V) range. The byte-BPE encoder can emit -1 for
-- unknown bytes (rare in our domain but seen on a few eval lines). We
-- map any out-of-range id to 0 (pad) so the one-hot fill is safe.
clamp_id id V =
  if id < 0 then 0
  else if id >= V then 0
  else id

fill_arrays_loop x_data labels_data mask_data ids prompt_len seq V i =
  if i >= seq then 0
  else
    let id_raw = if i < length ids then list_nth i ids else 0
    let id = clamp_id id_raw V
    let _ = float_arr_set x_data (i * V + id) 1.0
    let tgt_raw = if (i + 1) < length ids then list_nth (i + 1) ids else 0
    let target = clamp_id tgt_raw V
    let _ = float_arr_set labels_data i (int_to_float target)
    let in_prompt = i < (prompt_len - 1)
    let target_is_pad = target == 0
    let m = if in_prompt then 0.0 else if target_is_pad then 0.0 else 1.0
    let _ = float_arr_set mask_data i m
    fill_arrays_loop x_data labels_data mask_data ids prompt_len seq V (i + 1)

zero_arr_loop arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 0.0
    zero_arr_loop arr n (i + 1)

build_example_arrays ex seq V x_data labels_data mask_data =
  let _ = zero_arr_loop x_data (seq * V) 0
  let _ = zero_arr_loop labels_data seq 0
  let _ = zero_arr_loop mask_data seq 0
  let (prompt_len, ids) = ex
  let _ = fill_arrays_loop x_data labels_data mask_data ids prompt_len seq V 0
  0

-- ----------------------------------------------------------------------
-- Masked cross-entropy loss + gradient. Mirrors lm_ce_loss_loop /
-- ce_grad_loop in lm_transformer.rail but applies a per-position mask.
-- ----------------------------------------------------------------------

masked_ce_loss_loop pd ld md seq V acc nvalid_arr i =
  if i >= seq then 0
  else
    let m = float_arr_get md i
    if m <= 0.0 then masked_ce_loss_loop pd ld md seq V acc nvalid_arr (i + 1)
    else
      let target = float_to_int (float_arr_get ld i)
      let p = float_arr_get pd (i * V + target)
      let p2 = if p < 0.00000001 then 0.00000001 else p
      let cur = float_arr_get acc 0
      let _ = float_arr_set acc 0 (cur - log p2)
      let nv = float_arr_get nvalid_arr 0
      let _ = float_arr_set nvalid_arr 0 (nv + 1.0)
      masked_ce_loss_loop pd ld md seq V acc nvalid_arr (i + 1)

masked_ce_loss probs labels mask seq V = match probs
  | Tensor pd _ _ -> match labels
    | Tensor ld _ _ ->
      let acc = float_arr_new 1 0.0
      let nv = float_arr_new 1 0.0
      let _ = masked_ce_loss_loop pd ld mask seq V acc nv 0
      let total = float_arr_get acc 0
      let n = float_arr_get nv 0
      if n < 1.0 then 0.0
      else total / n

masked_ce_grad_loop dst probs labels mask seq V invN i =
  if i >= seq * V then 0
  else
    let row = i / V
    let col = i % V
    let m = float_arr_get mask row
    if m <= 0.0 then
      let _ = float_arr_set dst i 0.0
      masked_ce_grad_loop dst probs labels mask seq V invN (i + 1)
    else
      let target = float_to_int (float_arr_get labels row)
      let p = float_arr_get probs i
      let g = if col == target then (p - 1.0) * invN else p * invN
      let _ = float_arr_set dst i g
      masked_ce_grad_loop dst probs labels mask seq V invN (i + 1)

-- ----------------------------------------------------------------------
-- Helpers / activations (mirror lm_transformer.rail)
-- ----------------------------------------------------------------------

add_buf_inplace dst src n i =
  if i >= n then 0
  else
    let cur = float_arr_get dst i
    let s = float_arr_get src i
    let _ = float_arr_set dst i (cur + s)
    add_buf_inplace dst src n (i + 1)

unwrap t = match t | Tensor d _ _ -> d

relu_fwd src dst mask n i =
  if i >= n then 0
  else
    let v = float_arr_get src i
    let pos = if v > 0.0 then 1.0 else 0.0
    let _ = float_arr_set mask i pos
    let _ = float_arr_set dst i (v * pos)
    relu_fwd src dst mask n (i + 1)

relu_bwd dy mask dx n i =
  if i >= n then 0
  else
    let g = float_arr_get dy i
    let m = float_arr_get mask i
    let _ = float_arr_set dx i (g * m)
    relu_bwd dy mask dx n (i + 1)

pe_loop arr seq d p k =
  if p >= seq then 0
  else if k >= d then pe_loop arr seq d (p + 1) 0
  else
    let exp_arg = int_to_float (k - (k % 2)) / int_to_float d
    let denom = pow 10000.0 exp_arg
    let angle = int_to_float p / denom
    let v = if (k % 2) == 0 then sin angle else cos angle
    let _ = float_arr_set arr (p * d + k) v
    pe_loop arr seq d p (k + 1)

build_pe seq d =
  let arr = float_arr_new (seq * d) 0.0
  let _ = pe_loop arr seq d 0 0
  arr

ones_loop arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 1.0
    ones_loop arr n (i + 1)

-- ----------------------------------------------------------------------
-- Single-block forward + backward. Returns loss. Mirrors
-- lm_transformer.rail train_step but with masked CE.
-- ----------------------------------------------------------------------

forward x w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff =
  let e = matmul x w_e
  let ed = unwrap e
  let _ = add_buf_inplace ed pe (seq * d) 0
  let x_pe = e

  let ln1_pack = layernorm_save x_pe ln_g ln_b
  let ln1_out = head ln1_pack
  let ln1_mean = head (tail ln1_pack)
  let ln1_rstd = head (tail (tail ln1_pack))

  let q = matmul ln1_out w_q
  let k = matmul ln1_out w_k
  let v = matmul ln1_out w_v
  let kt = tensor_transpose k
  let scores = matmul q kt
  let scale = 1.0 / sqrt (int_to_float d)
  let scaled = tensor_scale scores scale
  let sd = unwrap scaled
  let _ = apply_causal_mask_loop sd seq 0 0
  let attn = tensor_softmax scaled
  let attn_out = matmul attn v

  let x_attn = tensor_add x_pe attn_out

  let ln2_pack = layernorm_save x_attn ln_g ln_b
  let ln2_out = head ln2_pack
  let ln2_mean = head (tail ln2_pack)
  let ln2_rstd = head (tail (tail ln2_pack))

  let ffn_h_pre = matmul ln2_out w_f1
  let ffn_h_pre_d = unwrap ffn_h_pre
  let ffn_h_data = float_arr_new (seq * d_ff) 0.0
  let ffn_mask = float_arr_new (seq * d_ff) 0.0
  let _ = relu_fwd ffn_h_pre_d ffn_h_data ffn_mask (seq * d_ff) 0
  let ffn_h = Tensor ffn_h_data (cons seq (cons d_ff [])) (compute_strides (cons seq (cons d_ff [])))
  let ffn_out = matmul ffn_h w_f2

  let x_blk = tensor_add x_attn ffn_out

  let logits = matmul x_blk w_o
  let probs = tensor_softmax logits

  let r0 = cons ln2_rstd []
  let r1 = cons ln2_mean r0
  let r2 = cons ln1_rstd r1
  let r3 = cons ln1_mean r2
  let r4 = cons ffn_mask r3
  let r5 = cons ffn_h r4
  let r6 = cons v r5
  let r7 = cons k r6
  let r8 = cons q r7
  let r9 = cons x_pe r8
  let r10 = cons ln1_out r9
  let r11 = cons x_attn r10
  let r12 = cons ln2_out r11
  let r13 = cons x_blk r12
  let r14 = cons attn r13
  cons probs r14

train_step x labels mask w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff dlog_buf st_we st_wq st_wk st_wv st_wo st_wf1 st_wf2 lr =
  let result = forward x w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff
  let probs = list_nth 0 result
  let attn = list_nth 1 result
  let x_blk = list_nth 2 result
  let ln2_out = list_nth 3 result
  let x_attn = list_nth 4 result
  let ln1_out = list_nth 5 result
  let x_pe = list_nth 6 result
  let q = list_nth 7 result
  let k = list_nth 8 result
  let v = list_nth 9 result
  let ffn_h = list_nth 10 result
  let ffn_mask = list_nth 11 result
  let ln1_mean = list_nth 12 result
  let ln1_rstd = list_nth 13 result
  let ln2_mean = list_nth 14 result
  let ln2_rstd = list_nth 15 result

  let loss = masked_ce_loss probs labels mask seq V

  match probs | Tensor pd _ _ -> match labels | Tensor ld _ _ ->
    let invN = 1.0 / int_to_float seq
    let _ = masked_ce_grad_loop dlog_buf pd ld mask seq V invN 0
    let dlog_t = Tensor dlog_buf (cons seq (cons V [])) (compute_strides (cons seq (cons V [])))

    let xblk_t = tensor_transpose x_blk
    let d_wo = matmul xblk_t dlog_t
    let wo_t = tensor_transpose w_o
    let dx_blk = matmul dlog_t wo_t

    let dffn_out = dx_blk
    let ffn_h_t = tensor_transpose ffn_h
    let d_wf2 = matmul ffn_h_t dffn_out
    let wf2_t = tensor_transpose w_f2
    let dffn_h = matmul dffn_out wf2_t

    let dffn_h_pre = float_arr_new (seq * d_ff) 0.0
    let dffn_h_d = unwrap dffn_h
    let _ = relu_bwd dffn_h_d ffn_mask dffn_h_pre (seq * d_ff) 0
    let dffn_h_pre_t = Tensor dffn_h_pre (cons seq (cons d_ff [])) (compute_strides (cons seq (cons d_ff [])))

    let ln2_t = tensor_transpose ln2_out
    let d_wf1 = matmul ln2_t dffn_h_pre_t
    let wf1_t = tensor_transpose w_f1
    let dln2_out = matmul dffn_h_pre_t wf1_t

    let dx_attn_ln = layernorm_backward_dx x_attn ln2_mean ln2_rstd ln_g dln2_out
    let dx_attn = tensor_add dx_blk dx_attn_ln

    let dattn_out = dx_attn
    let (d_q, d_k, d_v) = attention_backward q k v attn dattn_out

    let ln1_t = tensor_transpose ln1_out
    let d_wq = matmul ln1_t d_q
    let d_wk = matmul ln1_t d_k
    let d_wv = matmul ln1_t d_v
    let wq_t = tensor_transpose w_q
    let wk_t = tensor_transpose w_k
    let wv_t = tensor_transpose w_v
    let dx_q = matmul d_q wq_t
    let dx_k = matmul d_k wk_t
    let dx_v = matmul d_v wv_t
    let dln1_out = tensor_add (tensor_add dx_q dx_k) dx_v

    let dx_pe_ln = layernorm_backward_dx x_pe ln1_mean ln1_rstd ln_g dln1_out
    let dx_pe = tensor_add dx_attn dx_pe_ln

    let xT = tensor_transpose x
    let d_we = matmul xT dx_pe

    let we_d = unwrap w_e
    let wq_d = unwrap w_q
    let wk_d = unwrap w_k
    let wv_d = unwrap w_v
    let wo_d = unwrap w_o
    let wf1_d = unwrap w_f1
    let wf2_d = unwrap w_f2
    let dwe_d = unwrap d_we
    let dwq_d = unwrap d_wq
    let dwk_d = unwrap d_wk
    let dwv_d = unwrap d_wv
    let dwo_d = unwrap d_wo
    let dwf1_d = unwrap d_wf1
    let dwf2_d = unwrap d_wf2
    let _ = adam_update_raw we_d dwe_d st_we lr (adam_b1 0) (adam_b2 0) (adam_eps 0)
    let _ = adam_update_raw wq_d dwq_d st_wq lr (adam_b1 0) (adam_b2 0) (adam_eps 0)
    let _ = adam_update_raw wk_d dwk_d st_wk lr (adam_b1 0) (adam_b2 0) (adam_eps 0)
    let _ = adam_update_raw wv_d dwv_d st_wv lr (adam_b1 0) (adam_b2 0) (adam_eps 0)
    let _ = adam_update_raw wo_d dwo_d st_wo lr (adam_b1 0) (adam_b2 0) (adam_eps 0)
    let _ = adam_update_raw wf1_d dwf1_d st_wf1 lr (adam_b1 0) (adam_b2 0) (adam_eps 0)
    let _ = adam_update_raw wf2_d dwf2_d st_wf2 lr (adam_b1 0) (adam_b2 0) (adam_eps 0)
    loss

-- ----------------------------------------------------------------------
-- Linear warmup then cosine decay LR schedule.
-- ----------------------------------------------------------------------
lr_schedule step warmup max_steps base_lr =
  if step < warmup then
    base_lr * (int_to_float (step + 1)) / int_to_float warmup
  else
    let t = (int_to_float (step - warmup)) / (int_to_float (max_steps - warmup))
    let cosine = 0.5 * (1.0 + cos (3.141592653589793 * t))
    let min_lr = base_lr * 0.033
    min_lr + (base_lr - min_lr) * cosine

-- ----------------------------------------------------------------------
-- Eval loop: mean masked-CE loss over the held-out examples.
-- ----------------------------------------------------------------------
-- Eval one example: build arrays, run forward, return loss.
-- Keeps param count low by bundling weights into a list (destructured at top).
eval_one_example ex weights pe seq V d d_ff x_data labels_data mask_data x_t labels_t =
  let w_e = list_nth 0 weights
  let w_q = list_nth 1 weights
  let w_k = list_nth 2 weights
  let w_v = list_nth 3 weights
  let w_o = list_nth 4 weights
  let w_f1 = list_nth 5 weights
  let w_f2 = list_nth 6 weights
  let ln_g = list_nth 7 weights
  let ln_b = list_nth 8 weights
  let _ = build_example_arrays ex seq V x_data labels_data mask_data
  let result = forward x_t w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff
  let probs = list_nth 0 result
  masked_ce_loss probs labels_t mask_data seq V

eval_loop examples weights pe seq V d d_ff scratch acc_arr count_arr =
  if length examples == 0 then 0
  else
    let mk = arena_mark 0
    let x_data = list_nth 0 scratch
    let labels_data = list_nth 1 scratch
    let mask_data = list_nth 2 scratch
    let x_t = list_nth 3 scratch
    let labels_t = list_nth 4 scratch
    let ex = head examples
    let _ = build_example_arrays ex seq V x_data labels_data mask_data
    let w_e = list_nth 0 weights
    let w_q = list_nth 1 weights
    let w_k = list_nth 2 weights
    let w_v = list_nth 3 weights
    let w_o = list_nth 4 weights
    let w_f1 = list_nth 5 weights
    let w_f2 = list_nth 6 weights
    let ln_g = list_nth 7 weights
    let ln_b = list_nth 8 weights
    let result = forward x_t w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff
    let probs = list_nth 0 result
    let l = masked_ce_loss probs labels_t mask_data seq V
    let cur = float_arr_get acc_arr 0
    let _ = float_arr_set acc_arr 0 (cur + l)
    let nc = float_arr_get count_arr 0
    let _ = float_arr_set count_arr 0 (nc + 1.0)
    let _ = arena_reset mk
    eval_loop (tail examples) weights pe seq V d d_ff scratch acc_arr count_arr

-- ----------------------------------------------------------------------
-- Main training driver. (Keep params under ~10 per Rail's helper-arg
-- limit -- we use a few level-loops to stay inside the window.)
-- ----------------------------------------------------------------------

-- Single training step from bundled weights + adam states. Returns loss.
train_one_step ex weights adam_states pe seq V d d_ff scratch dlog_buf lr =
  let w_e = list_nth 0 weights
  let w_q = list_nth 1 weights
  let w_k = list_nth 2 weights
  let w_v = list_nth 3 weights
  let w_o = list_nth 4 weights
  let w_f1 = list_nth 5 weights
  let w_f2 = list_nth 6 weights
  let ln_g = list_nth 7 weights
  let ln_b = list_nth 8 weights
  let st_we = list_nth 0 adam_states
  let st_wq = list_nth 1 adam_states
  let st_wk = list_nth 2 adam_states
  let st_wv = list_nth 3 adam_states
  let st_wo = list_nth 4 adam_states
  let st_wf1 = list_nth 5 adam_states
  let st_wf2 = list_nth 6 adam_states
  let x_data = list_nth 0 scratch
  let labels_data = list_nth 1 scratch
  let mask_data = list_nth 2 scratch
  let x_t = list_nth 3 scratch
  let labels_t = list_nth 4 scratch
  let _ = build_example_arrays ex seq V x_data labels_data mask_data
  train_step x_t labels_t mask_data w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff dlog_buf st_we st_wq st_wk st_wv st_wo st_wf1 st_wf2 lr

run_steps_loop train_exs ex_idx_arr weights adams pe seq V d d_ff scratch dlog_buf base_lr warmup max_steps step =
  if step >= max_steps then 0
  else
    let mk = arena_mark 0
    let ex = pick_example train_exs ex_idx_arr
    let lr = lr_schedule step warmup max_steps base_lr
    let loss = train_one_step ex weights adams pe seq V d d_ff scratch dlog_buf lr
    let _ = arena_reset mk
    let _ = if step % 10 == 0 then
      let _ = print (cat ["step ", show step, " lr=", show_float lr, " loss=", show_float loss])
      0
    else 0
    run_steps_loop train_exs ex_idx_arr weights adams pe seq V d d_ff scratch dlog_buf base_lr warmup max_steps (step + 1)

main =
  let argv = args
  let parsed = parse_args argv
  let (_flags, opts, _pos) = parsed

  let phase = get_opt opts "phase" "pretrain"
  let seed_str = get_opt opts "seed" "42"
  let seed = parse_int seed_str
  let steps_str = get_opt opts "steps" ""

  let is_pretrain = phase == "pretrain"
  let max_steps = if length steps_str == 0 then
                    (if is_pretrain then (default_pretrain_steps 0) else (default_sft_steps 0))
                  else parse_int steps_str
  let base_lr = if is_pretrain then (pretrain_lr 0) else (sft_lr 0)

  let _ = print "=== Spur-arm v0 trainer ==="
  let _ = print (cat ["phase=", phase, " seed=", show seed, " max_steps=", show max_steps])

  -- Config
  let d = spurarm_v0_d_model 0
  let V = spurarm_v0_vocab_size 0
  let d_ff = spurarm_v0_d_ff 0
  let seq = fixed_seq_len 0
  let _ = print (spurarm_v0_config_str 0)
  let _ = print (cat ["actual run seq=", show seq, " d=", show d, " d_ff=", show d_ff, " V=", show V])

  let train_path = if is_pretrain then (pretrain_path 0) else (sft_path 0)
  let _ = print (cat ["loading ", train_path, " ..."])
  let train_exs = load_examples train_path
  let _ = print (cat ["  loaded ", show (length train_exs), " training examples"])
  let _ = print "loading eval set..."
  let eval_exs = load_examples (eval_path 0)
  let _ = print (cat ["  loaded ", show (length eval_exs), " eval examples"])

  -- Allocate per-step scratch arrays (reused across steps for memory locality).
  let x_data = float_arr_new (seq * V) 0.0
  let x_t = Tensor x_data (cons seq (cons V [])) (compute_strides (cons seq (cons V [])))
  let labels_data = float_arr_new seq 0.0
  let labels_t = Tensor labels_data (cons seq []) (cons 1 [])
  let mask_data = float_arr_new seq 0.0
  let dlog_buf = float_arr_new (seq * V) 0.0

  -- Weight initialization (Kaiming-scaled per init_matters memory).
  let _ = print "initializing weights..."
  let we_data = float_arr_new (V * d) 0.0
  let _ = init_scaled we_data (V * d) V seed
  let w_e = Tensor we_data (cons V (cons d [])) (compute_strides (cons V (cons d [])))
  let wq_data = float_arr_new (d * d) 0.0
  let _ = init_scaled wq_data (d * d) d (seed + 1)
  let w_q = Tensor wq_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wk_data = float_arr_new (d * d) 0.0
  let _ = init_scaled wk_data (d * d) d (seed + 2)
  let w_k = Tensor wk_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wv_data = float_arr_new (d * d) 0.0
  let _ = init_scaled wv_data (d * d) d (seed + 3)
  let w_v = Tensor wv_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wo_data = float_arr_new (d * V) 0.0
  let _ = init_scaled wo_data (d * V) d (seed + 4)
  let w_o = Tensor wo_data (cons d (cons V [])) (compute_strides (cons d (cons V [])))
  let wf1_data = float_arr_new (d * d_ff) 0.0
  let _ = init_scaled wf1_data (d * d_ff) d (seed + 5)
  let w_f1 = Tensor wf1_data (cons d (cons d_ff [])) (compute_strides (cons d (cons d_ff [])))
  let wf2_data = float_arr_new (d_ff * d) 0.0
  let _ = init_scaled wf2_data (d_ff * d) d_ff (seed + 6)
  let w_f2 = Tensor wf2_data (cons d_ff (cons d [])) (compute_strides (cons d_ff (cons d [])))

  let lng_data = float_arr_new d 1.0
  let _ = ones_loop lng_data d 0
  let ln_g = Tensor lng_data (cons d []) (cons 1 [])
  let lnb_data = float_arr_new d 0.0
  let ln_b = Tensor lnb_data (cons d []) (cons 1 [])

  let pe = build_pe seq d

  let st_we = adam_state (V * d)
  let st_wq = adam_state (d * d)
  let st_wk = adam_state (d * d)
  let st_wv = adam_state (d * d)
  let st_wo = adam_state (d * V)
  let st_wf1 = adam_state (d * d_ff)
  let st_wf2 = adam_state (d_ff * d)

  let weights = cons w_e (cons w_q (cons w_k (cons w_v (cons w_o (cons w_f1 (cons w_f2 (cons ln_g (cons ln_b []))))))))
  let adams = cons st_we (cons st_wq (cons st_wk (cons st_wv (cons st_wo (cons st_wf1 (cons st_wf2 []))))))

  let scratch = cons x_data (cons labels_data (cons mask_data (cons x_t (cons labels_t []))))

  let _ = print "running initial eval..."
  let eval_acc = float_arr_new 1 0.0
  let eval_count = float_arr_new 1 0.0
  let _ = eval_loop eval_exs weights pe seq V d d_ff scratch eval_acc eval_count
  let eval_total = float_arr_get eval_acc 0
  let eval_n = float_arr_get eval_count 0
  let initial_val = if eval_n < 1.0 then 0.0 else eval_total / eval_n
  let _ = print (cat ["initial val_loss=", show_float initial_val])

  -- If this is the SFT phase, try to load the matching pretrain ckpt.
  let pretrain_prefix = cat ["training/checkpoints/spurarm-base-v0_seed", seed_str, "_pretrain_final"]
  let _ = if (phase == "sft") then
            if ckpt_exists pretrain_prefix then
              let _ = print (cat ["loading pretrain init from ", pretrain_prefix])
              let _ = load_model_into pretrain_prefix weights
              0
            else
              let _ = print "no pretrain ckpt -- training SFT from scratch"
              0
          else 0

  let ex_idx = arr_new 1 (seed % 31)
  let _ = print "training..."
  let _ = run_steps_loop train_exs ex_idx weights adams pe seq V d d_ff scratch dlog_buf base_lr (warmup_steps 0) max_steps 0

  let _ = print "final eval..."
  let final_acc = float_arr_new 1 0.0
  let final_count = float_arr_new 1 0.0
  let _ = eval_loop eval_exs weights pe seq V d d_ff scratch final_acc final_count
  let final_total = float_arr_get final_acc 0
  let final_n = float_arr_get final_count 0
  let final_val = if final_n < 1.0 then 0.0 else final_total / final_n
  let _ = print (cat ["final val_loss=", show_float final_val])

  let ckpt_prefix = cat ["training/checkpoints/spurarm-base-v0_seed", seed_str, "_", phase, "_final"]
  let _ = save_checkpoint ckpt_prefix weights adams max_steps final_val
  let _ = print (cat ["saved checkpoint at ", ckpt_prefix])
  let _ = print (cat ["DONE phase=", phase, " seed=", show seed, " val_loss=", show_float final_val])
  0
