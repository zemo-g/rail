-- tools/spurarm/train/tokenize_corpus.rail
--
-- Apply the trained byte-BPE tokenizer to the corpus jsonls and emit
-- token-id shards.
--
-- Output format (text, easy to parse with split):
--   <prompt_len> <total_len> id0 id1 id2 ... idN\n
--
-- Where prompt_len = number of tokens up to and including <sep> (id 3).
-- total_len = total tokens including <bos>, prompt, <sep>, script, <eos>.
-- The trainer masks loss on the first <prompt_len> positions.
--
-- Usage:
--   ./rail_native run tools/spurarm/train/tokenize_corpus.rail
--
-- Inputs:  training/corpora/spurarm_v0_pretrain.jsonl
--          training/corpora/spurarm_v0_sft.jsonl
--          training/corpora/spurarm_v0_eval.jsonl
-- Outputs: training/corpora/spurarm_v0_pretrain.ids
--          training/corpora/spurarm_v0_sft.ids
--          training/corpora/spurarm_v0_eval.ids

import "stdlib/list.rail"
import "stdlib/args.rail"
import "stdlib/bpe.rail"

tokenizer_prefix _ = "training/tokenizer/spurarm_v0_bpe512"
pad_id _ = 0
bos_id _ = 1
eos_id _ = 2
sep_id _ = 3

-- ----------------------------------------------------------------------
-- JSONL field extractor (duplicated from build_tokenizer.rail; same
-- minimal unescape semantics).
-- ----------------------------------------------------------------------

unescape_chars cs acc =
  if length cs == 0 then reverse acc
  else
    let c = head cs
    if c == "\\" then
      let rest = tail cs
      if length rest == 0 then reverse (cons c acc)
      else
        let n = head rest
        if n == "n" then unescape_chars (tail rest) (cons (char_from_int 10) acc)
        else if n == "t" then unescape_chars (tail rest) (cons (char_from_int 9) acc)
        else if n == "\"" then unescape_chars (tail rest) (cons "\"" acc)
        else if n == "\\" then unescape_chars (tail rest) (cons "\\" acc)
        else unescape_chars rest (cons c acc)
    else unescape_chars (tail cs) (cons c acc)

unescape s = join "" (unescape_chars (chars s) [])

find_close_quote cs i n =
  if i >= n then i
  else
    let c = head cs
    if c == "\\" then
      if (i + 1) >= n then i + 1
      else find_close_quote (tail (tail cs)) (i + 2) n
    else if c == "\"" then i
    else find_close_quote (tail cs) (i + 1) n

extract_field key line =
  let needle = cat ["\"", key, "\":\""]
  let i = str_find needle line
  if i < 0 then ""
  else
    let start = i + length needle
    let rest = str_sub line start (length line - start)
    let rest_chars = chars rest
    let close_off = find_close_quote rest_chars 0 (length rest_chars)
    let raw = str_sub rest 0 close_off
    unescape raw

-- ----------------------------------------------------------------------
-- Render an id list as a space-separated string.
-- ----------------------------------------------------------------------

ids_to_str_loop ids acc =
  if length ids == 0 then acc
  else
    let id = head ids
    let sep_pre = if length acc == 0 then "" else " "
    ids_to_str_loop (tail ids) (cat [acc, sep_pre, show id])

ids_to_str ids = ids_to_str_loop ids ""

-- ----------------------------------------------------------------------
-- Process one JSONL file -> one .ids file. Streams line by line and
-- writes the buffer in one shot at the end (corpora are <100MB).
-- ----------------------------------------------------------------------

tokenize_one_line bpe line =
  let nl_v = extract_field "nl" line
  let sc_v = extract_field "script" line
  if length nl_v == 0 then []
  else if length sc_v == 0 then []
  else
    let prompt_ids = bpe_encode bpe nl_v
    let script_ids = bpe_encode bpe sc_v
    let with_bos = cons (bos_id 0) prompt_ids
    let with_sep = append with_bos (cons (sep_id 0) [])
    let prompt_len = length with_sep
    let with_script = append with_sep script_ids
    let with_eos = append with_script (cons (eos_id 0) [])
    let total = length with_eos
    cons prompt_len (cons total with_eos)

-- Build a reverse list of per-line outputs; join once at end. Avoids
-- O(N^2) string-concat blowup. Stops at max_lines for budget control
-- (BPE encode is O(N x M-merges) per call, so we cap aggressively;
-- 5000 pretrain + 5000 SFT pairs is plenty for the v0 trainer).
process_lines_loop bpe lines outputs count remaining =
  if remaining <= 0 then (outputs, count)
  else if length lines == 0 then (outputs, count)
  else
    let line = head lines
    if length line == 0 then process_lines_loop bpe (tail lines) outputs count remaining
    else
      let tok = tokenize_one_line bpe line
      if length tok == 0 then process_lines_loop bpe (tail lines) outputs count remaining
      else
        let prompt_len = head tok
        let total = head (tail tok)
        let ids = tail (tail tok)
        let line_out = cat [show prompt_len, " ", show total, " ", ids_to_str ids, "\n"]
        let _ = if (count + 1) % 200 == 0 then
          let _ = print (cat ["  ... ", show (count + 1), " examples done"])
          0
        else 0
        process_lines_loop bpe (tail lines) (cons line_out outputs) (count + 1) (remaining - 1)

process_file bpe in_path out_path max_lines =
  let _ = print (cat ["tokenizing ", in_path, " -> ", out_path, " (cap=", show max_lines, ")"])
  let body = read_file in_path
  let lines = split (char_from_int 10) body
  let result = process_lines_loop bpe lines [] 0 max_lines
  let (outs, count) = result
  let out_str = join "" (reverse outs)
  let _ = write_file out_path out_str
  let _ = print (cat ["  wrote ", show count, " tokenized examples"])
  count

-- ----------------------------------------------------------------------
-- main
-- ----------------------------------------------------------------------

main =
  let argv = args
  let parsed = parse_args argv
  let (_flags, opts, _pos) = parsed

  let split_name = get_opt opts "split" "all"
  let max_str = get_opt opts "max" ""

  let _ = print "=== Spur-arm corpus tokenization ==="
  let bpe = bpe_load (tokenizer_prefix 0)
  let v = bpe_vocab_size bpe
  let _ = print (cat ["loaded tokenizer vocab_size=", show v])

  let want_pre = if split_name == "pretrain" then 1 else if split_name == "all" then 1 else 0
  let want_sft = if split_name == "sft" then 1 else if split_name == "all" then 1 else 0
  let want_eval = if split_name == "eval" then 1 else if split_name == "all" then 1 else 0

  let default_max = 1500
  let max_lines = if length max_str == 0 then default_max else parse_int max_str

  let _ = if want_pre == 1 then
    let _ = process_file bpe "training/corpora/spurarm_v0_pretrain.jsonl" "training/corpora/spurarm_v0_pretrain.ids" max_lines
    0
  else 0

  let _ = if want_sft == 1 then
    let _ = process_file bpe "training/corpora/spurarm_v0_sft.jsonl" "training/corpora/spurarm_v0_sft.ids" max_lines
    0
  else 0

  let _ = if want_eval == 1 then
    let _ = process_file bpe "training/corpora/spurarm_v0_eval.jsonl" "training/corpora/spurarm_v0_eval.ids" 200
    0
  else 0

  let _ = print "done."
  0
