-- tools/ast.rail -- Rail's syntax tree as data types.
--
-- The parser (tools/compile.rail, pa .. pprog_ast) builds these. The passes after it still
-- read the older list form (["O", op, l, r] and so on); ast_decls_list converts for them,
-- until each pass reads the types directly. Imported by tools/compile.rail.

type Node =
  | NInt str
  | NFloat str
  | NStr str
  | NBool str
  | NNull
  | NVar str
  | NOp str Node Node
  | NApp Node Node
  | NLam str Node
  | NList [Node]
  | NTup [Node]
  | NLet str Node Node
  | NLetTup [str] Node Node
  | NIf Node Node Node
  | NMatch Node [Arm]
  | NErr str str

-- a match arm: constructor (or `#int:5`, `#str:x`, `_`), the names it binds, the body, a guard
type Arm = | Arm str [str] Node Guard
type Guard = | NoGuard | Guard Node

type Decl =
  | DFn str [str] Node
  | DType str [Variant]
  | DForeign str int str
  | DLink str
  | DGradMark str
  | DErr str str

-- a constructor: name, index in its type, arity, auth mask, each field's declared type
type Variant = | Variant str int int [int] [Field]
type Field = | FName str | FList Field

ast_is_err d = match d
  | DErr m p -> true
  | _ -> false

-- ── the list form the later passes read ──
ast_list n = match n
  | NInt v -> ["I", v]
  | NFloat v -> ["FL", v]
  | NStr v -> ["S", v]
  | NBool v -> ["B", v]
  | NNull -> ["NULL"]
  | NVar v -> ["V", v]
  | NOp o l r -> ["O", o, ast_list l, ast_list r]
  | NApp f a -> ["A", ast_list f, ast_list a]
  | NLam p b -> ["F", p, ast_list b]
  | NList es -> ["L", ast_lists es]
  | NTup es -> ["T", ast_lists es]
  | NLet x v b -> ["D", x, ast_list v, ast_list b]
  | NLetTup xs v b -> ["TD", xs, ast_list v, ast_list b]
  | NIf c t e -> ["?", ast_list c, ast_list t, ast_list e]
  | NMatch s arms -> ["M", ast_list s, ast_arms_list arms]
  | NErr m p -> ["E", m, p]
ast_lists ns = if ns == [] then [] else cons (ast_list (head ns)) (ast_lists (tail ns))
ast_arms_list arms = if arms == [] then [] else cons (ast_arm_list (head arms)) (ast_arms_list (tail arms))
ast_arm_list a = match a
  | Arm c bs body g -> [c, bs, ast_list body, ast_guard_list g]
ast_guard_list g = match g
  | NoGuard -> []
  | Guard n -> ast_list n

ast_decl_list d = match d
  | DFn n ps b -> ["fn", n, ps, ast_list b]
  | DType n vs -> ["TY", n, ast_variants_list vs]
  | DForeign n ar rk -> ["FN_EXT", n, ar, rk]
  | DLink l -> ["LINK", l]
  | DGradMark g -> ["GRADMARK", g]
  | DErr m p -> ["E", m, p]
ast_decls_list ds = if ds == [] then [] else cons (ast_decl_list (head ds)) (ast_decls_list (tail ds))
ast_variants_list vs = if vs == [] then [] else cons (ast_variant_list (head vs)) (ast_variants_list (tail vs))
ast_variant_list v = match v
  | Variant c idx ar mask fs -> [c, idx, ar, mask, ast_fields_list fs]
ast_fields_list fs = if fs == [] then [] else cons (ast_field_list (head fs)) (ast_fields_list (tail fs))
ast_field_list f = match f
  | FName t -> ["name", t]
  | FList g -> ["list", ast_field_list g]
