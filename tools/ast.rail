-- tools/ast.rail -- Rail's syntax tree as data types.
--
-- The parser (tools/compile.rail, pa .. pprog_ast) builds these and every pass after it reads
-- them. Imported by tools/compile.rail.

type Node =
  | NInt str
  | NFloat str
  | NStr str
  | NBool str
  | NNull
  | NVar str
  | NOp str Node Node
  | NApp Node Node
  | NLam str Node
  | NList [Node]
  | NTup [Node]
  | NLet str Node Node
  | NLetTup [str] Node Node
  | NIf Node Node Node
  | NMatch Node [Arm]
  | NErr str str

-- a match arm: constructor (or `#int:5`, `#str:x`, `_`), the names it binds, the body, a guard
type Arm = | Arm str [str] Node Guard
type Guard = | NoGuard | Guard Node

type Decl =
  | DFn str [str] Node
  | DType str [Variant]
  | DForeign str int str
  | DLink str
  | DGradMark str
  | DErr str str

-- a constructor: name, index in its type, arity, auth mask, each field's declared type
type Variant = | Variant str int int [int] [Field]
type Field = | FName str | FList Field | FArr Field | FTup [Field]

ast_is_err d = match d
  | DErr m p -> true
  | _ -> false

-- ── walking the tree ──
-- `f a b` is NApp (NApp f a) b: the name at the head and the arguments in order, or
-- ("_expr", []) when the head is not a name
ast_flat n = match n
  | NApp f a -> ast_flat_app f a
  | NVar v -> (v, [])
  | _ -> ("_expr", [])
ast_flat_app f a = let (nm, args) = ast_flat f in (nm, append args [a])
ast_app_fn n = match n
  | NApp f a -> ast_app_fn f
  | _ -> n
-- `\a b -> e` is NLam a (NLam b e): the parameters and the innermost body
ast_lam_params n = match n
  | NLam p b -> ast_lam_more p b
  | _ -> ([], n)
ast_lam_more p b = let (ps, body) = ast_lam_params b in (cons p ps, body)

-- ── positional accessors (codegen dispatches on the tag, then reads a child) ──
-- tag: "I" "FL" "S" "B" "NULL" "V" "O" "A" "F" "L" "T" "D" "TD" "?" "M" "E"
nd_tag n = match n
  | NInt v -> "I"
  | NFloat v -> "FL"
  | NStr v -> "S"
  | NBool v -> "B"
  | NNull -> "NULL"
  | NVar v -> "V"
  | NOp o l r -> "O"
  | NApp f a -> "A"
  | NLam p b -> "F"
  | NList es -> "L"
  | NTup es -> "T"
  | NLet x v b -> "D"
  | NLetTup xs v b -> "TD"
  | NIf c t e -> "?"
  | NMatch s arms -> "M"
  | NErr m p -> "E"
-- the string in first position: a literal's text, a variable's name, an operator, a lambda's
-- parameter, a let's name, an error's message
nd_s1 n = match n
  | NInt v -> v
  | NFloat v -> v
  | NStr v -> v
  | NBool v -> v
  | NVar v -> v
  | NOp o l r -> o
  | NLam p b -> p
  | NLet x v b -> x
  | NErr m p -> m
  | _ -> ""
-- the node in first position: an application's function, a condition, a scrutinee
nd_n1 n = match n
  | NApp f a -> f
  | NIf c t e -> c
  | NMatch s arms -> s
  | _ -> NNull
-- second position: an operator's left side, an application's argument, a lambda's body, a
-- let's value, a then-branch
nd_n2 n = match n
  | NOp o l r -> l
  | NApp f a -> a
  | NLam p b -> b
  | NLet x v b -> v
  | NLetTup xs v b -> v
  | NIf c t e -> t
  | _ -> NNull
-- third position: an operator's right side, a let's body, an else-branch
nd_n3 n = match n
  | NOp o l r -> r
  | NLet x v b -> b
  | NLetTup xs v b -> b
  | NIf c t e -> e
  | _ -> NNull
-- a list's or tuple's elements; a tuple let's names; a match's arms
nd_elems n = match n
  | NList es -> es
  | NTup es -> es
  | _ -> []
nd_names n = match n
  | NLetTup xs v b -> xs
  | _ -> []
nd_arms n = match n
  | NMatch s arms -> arms
  | _ -> []
arm_ctor a = match a
  | Arm c bs b g -> c
arm_binds a = match a
  | Arm c bs b g -> bs
arm_body a = match a
  | Arm c bs b g -> b
arm_guard a = match a
  | Arm c bs b g -> g
-- a fn declaration's parts
decl_fn_name d = match d
  | DFn n ps b -> n
  | _ -> ""
decl_fn_params d = match d
  | DFn n ps b -> ps
  | _ -> []
decl_fn_body d = match d
  | DFn n ps b -> b
  | _ -> NNull
decl_is_fn d = match d
  | DFn n ps b -> true
  | _ -> false
-- whether n is the variable `name`
ast_is_var n name = match n
  | NVar v -> v == name
  | _ -> false

-- a string two nodes share only when they are the same tree: every string in it is
-- length-prefixed, so no literal's text can imitate structure
ast_key n = match n
  | NInt v -> ast_key_s "I" v
  | NFloat v -> ast_key_s "F" v
  | NStr v -> ast_key_s "S" v
  | NBool v -> ast_key_s "B" v
  | NNull -> "N"
  | NVar v -> ast_key_s "V" v
  | NOp o l r -> cat [ast_key_s "O" o, ast_key l, ast_key r]
  | NApp f a -> cat ["A", ast_key f, ast_key a]
  | NLam p b -> cat [ast_key_s "L" p, ast_key b]
  | NList es -> cat ["[", show (length es), ast_keys es]
  | NTup es -> cat ["(", show (length es), ast_keys es]
  | NLet x v b -> cat [ast_key_s "D" x, ast_key v, ast_key b]
  | NLetTup xs v b -> cat ["T", show (length xs), ast_key_ss xs, ast_key v, ast_key b]
  | NIf c t e -> cat ["?", ast_key c, ast_key t, ast_key e]
  | NMatch s arms -> cat ["M", show (length arms), ast_key s, ast_key_arms arms]
  | NErr m p -> cat [ast_key_s "E" m, ast_key_s "p" p]
ast_key_s tag s = cat [tag, show (length s), ":", s]
ast_keys ns = if ns == [] then "" else cat [ast_key (head ns), ast_keys (tail ns)]
ast_key_ss ss = if ss == [] then "" else cat [ast_key_s "s" (head ss), ast_key_ss (tail ss)]
ast_key_arms arms = if arms == [] then "" else cat [ast_key_arm (head arms), ast_key_arms (tail arms)]
ast_key_arm a = match a
  | Arm c bs b g -> cat [ast_key_s "a" c, show (length bs), ast_key_ss bs, ast_key b, ast_key_guard g]
ast_key_guard g = match g
  | NoGuard -> "n"
  | Guard n -> cat ["g", ast_key n]

-- whether any match arm in the tree has a guard
ast_has_guard n = match n
  | NOp o l r -> ast_has_guard l || ast_has_guard r
  | NApp f a -> ast_has_guard f || ast_has_guard a
  | NLam p b -> ast_has_guard b
  | NList es -> ast_any_guard es
  | NTup es -> ast_any_guard es
  | NLet x v b -> ast_has_guard v || ast_has_guard b
  | NLetTup xs v b -> ast_has_guard v || ast_has_guard b
  | NIf c t e -> ast_has_guard c || ast_has_guard t || ast_has_guard e
  | NMatch s arms -> ast_has_guard s || ast_arms_guard arms
  | _ -> false
ast_any_guard ns = if ns == [] then false else ast_has_guard (head ns) || ast_any_guard (tail ns)
ast_arms_guard arms = if arms == [] then false else ast_arm_guard (head arms) || ast_arms_guard (tail arms)
ast_arm_guard a = match a
  | Arm c bs b g -> ast_guard_here g || ast_has_guard b
ast_guard_here g = match g
  | NoGuard -> false
  | Guard n -> true
ast_decls_have_guard ds =
  if ds == [] then false
  else if ast_decl_has_guard (head ds) then true
  else ast_decls_have_guard (tail ds)
ast_decl_has_guard d = match d
  | DFn n ps b -> ast_has_guard b
  | _ -> false
