-- tools/ast.rail -- Rail's syntax tree as data types.
--
-- The parser (tools/compile.rail, pa .. pprog_ast) builds these. The passes after it still
-- read the older list form (["O", op, l, r] and so on); ast_decls_list converts for them,
-- until each pass reads the types directly. Imported by tools/compile.rail.

type Node =
  | NInt str
  | NFloat str
  | NStr str
  | NBool str
  | NNull
  | NVar str
  | NOp str Node Node
  | NApp Node Node
  | NLam str Node
  | NList [Node]
  | NTup [Node]
  | NLet str Node Node
  | NLetTup [str] Node Node
  | NIf Node Node Node
  | NMatch Node [Arm]
  | NErr str str

-- a match arm: constructor (or `#int:5`, `#str:x`, `_`), the names it binds, the body, a guard
type Arm = | Arm str [str] Node Guard
type Guard = | NoGuard | Guard Node

type Decl =
  | DFn str [str] Node
  | DType str [Variant]
  | DForeign str int str
  | DLink str
  | DGradMark str
  | DErr str str

-- a constructor: name, index in its type, arity, auth mask, each field's declared type
type Variant = | Variant str int int [int] [Field]
type Field = | FName str | FList Field | FArr Field | FTup [Field]

ast_is_err d = match d
  | DErr m p -> true
  | _ -> false

-- ── the list form the later passes read ──
ast_list n = match n
  | NInt v -> ["I", v]
  | NFloat v -> ["FL", v]
  | NStr v -> ["S", v]
  | NBool v -> ["B", v]
  | NNull -> ["NULL"]
  | NVar v -> ["V", v]
  | NOp o l r -> ["O", o, ast_list l, ast_list r]
  | NApp f a -> ["A", ast_list f, ast_list a]
  | NLam p b -> ["F", p, ast_list b]
  | NList es -> ["L", ast_lists es]
  | NTup es -> ["T", ast_lists es]
  | NLet x v b -> ["D", x, ast_list v, ast_list b]
  | NLetTup xs v b -> ["TD", xs, ast_list v, ast_list b]
  | NIf c t e -> ["?", ast_list c, ast_list t, ast_list e]
  | NMatch s arms -> ["M", ast_list s, ast_arms_list arms]
  | NErr m p -> ["E", m, p]
ast_lists ns = if ns == [] then [] else cons (ast_list (head ns)) (ast_lists (tail ns))
ast_arms_list arms = if arms == [] then [] else cons (ast_arm_list (head arms)) (ast_arms_list (tail arms))
ast_arm_list a = match a
  | Arm c bs body g -> [c, bs, ast_list body, ast_guard_list g]
ast_guard_list g = match g
  | NoGuard -> []
  | Guard n -> ast_list n

ast_decl_list d = match d
  | DFn n ps b -> ["fn", n, ps, ast_list b]
  | DType n vs -> ["TY", n, ast_variants_list vs]
  | DForeign n ar rk -> ["FN_EXT", n, ar, rk]
  | DLink l -> ["LINK", l]
  | DGradMark g -> ["GRADMARK", g]
  | DErr m p -> ["E", m, p]
ast_decls_list ds = if ds == [] then [] else cons (ast_decl_list (head ds)) (ast_decls_list (tail ds))
ast_variants_list vs = if vs == [] then [] else cons (ast_variant_list (head vs)) (ast_variants_list (tail vs))
ast_variant_list v = match v
  | Variant c idx ar mask fs -> [c, idx, ar, mask, ast_fields_list fs]
ast_fields_list fs = if fs == [] then [] else cons (ast_field_list (head fs)) (ast_fields_list (tail fs))
ast_field_list f = match f
  | FName t -> ["name", t]
  | FList g -> ["list", ast_field_list g]
  | FArr g -> ["arr", ast_field_list g]
  | FTup gs -> ["tup", ast_fields_list gs]

-- ── walking the tree ──
-- `f a b` is NApp (NApp f a) b: the name at the head and the arguments in order, or
-- ("_expr", []) when the head is not a name
ast_flat n = match n
  | NApp f a -> ast_flat_app f a
  | NVar v -> (v, [])
  | _ -> ("_expr", [])
ast_flat_app f a = let (nm, args) = ast_flat f in (nm, append args [a])
ast_app_fn n = match n
  | NApp f a -> ast_app_fn f
  | _ -> n
-- `\a b -> e` is NLam a (NLam b e): the parameters and the innermost body
ast_lam_params n = match n
  | NLam p b -> ast_lam_more p b
  | _ -> ([], n)
ast_lam_more p b = let (ps, body) = ast_lam_params b in (cons p ps, body)

-- ── from the list form, for passes that still produce it ──
-- A list node holds its strings and ints in untyped lists; `cat [x]` and `bit_or x 0` read
-- them as a str and an int (builtins whose result type is fixed), so the typed tree does not
-- inherit dyn from where it came from.
ast_s x = cat [x]
ast_i x = bit_or x 0
ast_ss xs = if xs == [] then [] else cons (ast_s (head xs)) (ast_ss (tail xs))
ast_is xs = if xs == [] then [] else cons (ast_i (head xs)) (ast_is (tail xs))
ast_at xs i = if i <= 0 then head xs else ast_at (tail xs) (i - 1)
ast_of n =
  let tg = ast_s (head n)
  if tg == "I" then NInt (ast_s (ast_at n 1))
  else if tg == "FL" then NFloat (ast_s (ast_at n 1))
  else if tg == "S" then NStr (ast_s (ast_at n 1))
  else if tg == "B" then NBool (ast_s (ast_at n 1))
  else if tg == "NULL" then NNull
  else if tg == "V" then NVar (ast_s (ast_at n 1))
  else if tg == "O" then NOp (ast_s (ast_at n 1)) (ast_of (ast_at n 2)) (ast_of (ast_at n 3))
  else if tg == "A" then NApp (ast_of (ast_at n 1)) (ast_of (ast_at n 2))
  else if tg == "F" then NLam (ast_s (ast_at n 1)) (ast_of (ast_at n 2))
  else if tg == "L" then NList (ast_ofs (ast_at n 1))
  else if tg == "T" then NTup (ast_ofs (ast_at n 1))
  else if tg == "D" then NLet (ast_s (ast_at n 1)) (ast_of (ast_at n 2)) (ast_of (ast_at n 3))
  else if tg == "TD" then NLetTup (ast_ss (ast_at n 1)) (ast_of (ast_at n 2)) (ast_of (ast_at n 3))
  else if tg == "?" then NIf (ast_of (ast_at n 1)) (ast_of (ast_at n 2)) (ast_of (ast_at n 3))
  else if tg == "M" then NMatch (ast_of (ast_at n 1)) (ast_arms_of (ast_at n 2))
  else if tg == "E" then NErr (ast_s (ast_at n 1)) (if length n > 2 then ast_s (ast_at n 2) else "0")
  else NErr (cat ["unknown node ", tg]) "0"
ast_ofs ns = if ns == [] then [] else cons (ast_of (head ns)) (ast_ofs (tail ns))
ast_arms_of arms = if arms == [] then [] else cons (ast_arm_of (head arms)) (ast_arms_of (tail arms))
ast_arm_of a =
  let g = if length a > 3 then ast_at a 3 else []
  Arm (ast_s (head a)) (ast_ss (ast_at a 1)) (ast_of (ast_at a 2)) (if g == [] then NoGuard else Guard (ast_of g))

ast_decl_of d =
  let tg = ast_s (head d)
  if tg == "fn" then DFn (ast_s (ast_at d 1)) (ast_ss (ast_at d 2)) (ast_of (ast_at d 3))
  else if tg == "TY" then DType (ast_s (ast_at d 1)) (ast_variants_of (ast_at d 2))
  else if tg == "FN_EXT" then DForeign (ast_s (ast_at d 1)) (ast_i (ast_at d 2)) (ast_s (ast_at d 3))
  else if tg == "LINK" then DLink (ast_s (ast_at d 1))
  else if tg == "GRADMARK" then DGradMark (ast_s (ast_at d 1))
  else if tg == "E" then DErr (ast_s (ast_at d 1)) (if length d > 2 then ast_s (ast_at d 2) else "0")
  else DErr (cat ["unknown decl ", tg]) "0"
ast_decls_of ds = if ds == [] then [] else cons (ast_decl_of (head ds)) (ast_decls_of (tail ds))
ast_variants_of vs = if vs == [] then [] else cons (ast_variant_of (head vs)) (ast_variants_of (tail vs))
ast_variant_of v = Variant (ast_s (head v)) (ast_i (ast_at v 1)) (ast_i (ast_at v 2)) (ast_is (ast_at v 3)) (if length v > 4 then ast_fields_of (ast_at v 4) else [])
ast_fields_of fs = if fs == [] then [] else cons (ast_field_of (head fs)) (ast_fields_of (tail fs))
ast_field_of f =
  let tg = ast_s (head f)
  if tg == "list" then FList (ast_field_of (ast_at f 1))
  else if tg == "arr" then FArr (ast_field_of (ast_at f 1))
  else if tg == "tup" then FTup (ast_fields_of (ast_at f 1))
  else FName (ast_s (ast_at f 1))

-- ── the list form's positions, typed (codegen dispatches on the tag, then reads a child) ──
-- tag: "I" "FL" "S" "B" "NULL" "V" "O" "A" "F" "L" "T" "D" "TD" "?" "M" "E"
nd_tag n = match n
  | NInt v -> "I"
  | NFloat v -> "FL"
  | NStr v -> "S"
  | NBool v -> "B"
  | NNull -> "NULL"
  | NVar v -> "V"
  | NOp o l r -> "O"
  | NApp f a -> "A"
  | NLam p b -> "F"
  | NList es -> "L"
  | NTup es -> "T"
  | NLet x v b -> "D"
  | NLetTup xs v b -> "TD"
  | NIf c t e -> "?"
  | NMatch s arms -> "M"
  | NErr m p -> "E"
-- the string in first position: a literal's text, a variable's name, an operator, a lambda's
-- parameter, a let's name, an error's message
nd_s1 n = match n
  | NInt v -> v
  | NFloat v -> v
  | NStr v -> v
  | NBool v -> v
  | NVar v -> v
  | NOp o l r -> o
  | NLam p b -> p
  | NLet x v b -> x
  | NErr m p -> m
  | _ -> ""
-- the node in first position: an application's function, a condition, a scrutinee
nd_n1 n = match n
  | NApp f a -> f
  | NIf c t e -> c
  | NMatch s arms -> s
  | _ -> NNull
-- second position: an operator's left side, an application's argument, a lambda's body, a
-- let's value, a then-branch
nd_n2 n = match n
  | NOp o l r -> l
  | NApp f a -> a
  | NLam p b -> b
  | NLet x v b -> v
  | NLetTup xs v b -> v
  | NIf c t e -> t
  | _ -> NNull
-- third position: an operator's right side, a let's body, an else-branch
nd_n3 n = match n
  | NOp o l r -> r
  | NLet x v b -> b
  | NLetTup xs v b -> b
  | NIf c t e -> e
  | _ -> NNull
-- a list's or tuple's elements; a tuple let's names; a match's arms
nd_elems n = match n
  | NList es -> es
  | NTup es -> es
  | _ -> []
nd_names n = match n
  | NLetTup xs v b -> xs
  | _ -> []
nd_arms n = match n
  | NMatch s arms -> arms
  | _ -> []
arm_ctor a = match a
  | Arm c bs b g -> c
arm_binds a = match a
  | Arm c bs b g -> bs
arm_body a = match a
  | Arm c bs b g -> b
arm_guard a = match a
  | Arm c bs b g -> g
-- a fn declaration's parts
decl_fn_name d = match d
  | DFn n ps b -> n
  | _ -> ""
decl_fn_params d = match d
  | DFn n ps b -> ps
  | _ -> []
decl_fn_body d = match d
  | DFn n ps b -> b
  | _ -> NNull
decl_is_fn d = match d
  | DFn n ps b -> true
  | _ -> false

-- a string two nodes share only when they are the same tree: every string in it is
-- length-prefixed, so no literal's text can imitate structure
ast_key n = match n
  | NInt v -> ast_key_s "I" v
  | NFloat v -> ast_key_s "F" v
  | NStr v -> ast_key_s "S" v
  | NBool v -> ast_key_s "B" v
  | NNull -> "N"
  | NVar v -> ast_key_s "V" v
  | NOp o l r -> cat [ast_key_s "O" o, ast_key l, ast_key r]
  | NApp f a -> cat ["A", ast_key f, ast_key a]
  | NLam p b -> cat [ast_key_s "L" p, ast_key b]
  | NList es -> cat ["[", show (length es), ast_keys es]
  | NTup es -> cat ["(", show (length es), ast_keys es]
  | NLet x v b -> cat [ast_key_s "D" x, ast_key v, ast_key b]
  | NLetTup xs v b -> cat ["T", show (length xs), ast_key_ss xs, ast_key v, ast_key b]
  | NIf c t e -> cat ["?", ast_key c, ast_key t, ast_key e]
  | NMatch s arms -> cat ["M", show (length arms), ast_key s, ast_key_arms arms]
  | NErr m p -> cat [ast_key_s "E" m, ast_key_s "p" p]
ast_key_s tag s = cat [tag, show (length s), ":", s]
ast_keys ns = if ns == [] then "" else cat [ast_key (head ns), ast_keys (tail ns)]
ast_key_ss ss = if ss == [] then "" else cat [ast_key_s "s" (head ss), ast_key_ss (tail ss)]
ast_key_arms arms = if arms == [] then "" else cat [ast_key_arm (head arms), ast_key_arms (tail arms)]
ast_key_arm a = match a
  | Arm c bs b g -> cat [ast_key_s "a" c, show (length bs), ast_key_ss bs, ast_key b, ast_key_guard g]
ast_key_guard g = match g
  | NoGuard -> "n"
  | Guard n -> cat ["g", ast_key n]
