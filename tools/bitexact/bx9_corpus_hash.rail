-- BX9: the CORPUS is part of the attestation -- pin it with a content hash.
--
-- A reproducible training run needs a pinned input. The corpus is a curated,
-- fixed-order concatenation of real broad Rail source (stdlib + bitexact lib),
-- frozen as the committed artifact tools/bitexact/bx9_corpus.txt. We hash it
-- with pure-Rail SHA-256 (stdlib/sha256.rail, RFC 6234) -- the content hash is
-- the attestation anchor that BX10's checkpoint chain commits to and BX12's
-- foreign re-verifier reproduces "from data+config+seed".
--
-- Because the hash algorithm is a FIXED algorithm and standards-correct, the
-- foreign witness can use stock hashlib/sha256sum: the Rail digest equals the
-- standard SHA-256 of the same bytes bit-for-bit (verified vs shasum).
--
-- Gates:
--   D0  hash the corpus TWICE -> identical hex (deterministic content hash).
--   D3  bx9_foreign_check.py recomputes SHA-256 over the SAME corpus bytes with
--       Python hashlib AND re-assembles the corpus from the source list -> the
--       digest + byte count match the manifest bit-for-bit.

import "stdlib/sha256.rail"

bx9_corpus_path = "tools/bitexact/bx9_corpus.txt"
bx9_sources = "stdlib/list.rail stdlib/string.rail stdlib/map.rail stdlib/bytes.rail stdlib/json.rail stdlib/optim.rail stdlib/sha256.rail tools/bitexact/bx_fixed.rail stdlib/tensor.rail"

main =
  let corpus = read_file bx9_corpus_path in
  let h1 = sha256_hex corpus in
  let h2 = sha256_hex corpus in
  let d0 = if h1 == h2 then 0 else 1 in
  -- byte count via wc (cheap; avoids materializing a 108K-char list)
  let _ = shell "wc -c < tools/bitexact/bx9_corpus.txt | tr -d ' \n' > /tmp/bx9_bytes.txt" in
  let nbytes = read_file "/tmp/bx9_bytes.txt" in
  let manifest = join "" ["BX9 corpus manifest\nsources ", bx9_sources, "\nbytes ", nbytes, "\nsha256 ", h1, "\n"] in
  let _ = write_file "/tmp/bx9_manifest.txt" manifest in
  let _ = print (join "" ["BX9 D0 (content hash deterministic): ", if d0 == 0 then "PASS" else "FAIL"]) in
  let _ = print (join "" ["BX9 corpus bytes: ", nbytes]) in
  let _ = print (join "" ["BX9 corpus SHA-256: ", h1]) in
  let _ = print (if d0 == 0
    then "BX9 PASS: corpus pinned by content hash; manifest written for D3"
    else "BX9 FAIL") in
  0
