-- bx_fxsqrt_check: prints bx4_fxsqrt(xq) for a fixed list of xq values.
-- Harness (bx_fxsqrt_check.sh) cross-checks every line against Python's exact isqrt(xq<<24):
--   * small/mid xq (no overflow) -> must equal the OLD bx4_isqrt(xq*2^24) -> byte-identical artifacts
--   * large xq (xq*2^24 overflows 63-bit) -> must be the TRUE floor(sqrt), where the old code was garbage
import "tools/bitexact/bx_fixed.rail"

-- print "xq result" so the harness can pair them
emit xq = let _ = print (cat [show xq, " ", show (bx4_fxsqrt xq)]) in 0

main =
  let _ = emit 0 in
  let _ = emit 1 in
  let _ = emit 17 in
  let _ = emit 1000 in
  let _ = emit 16777216 in            -- 2^24 (real x = 1.0)
  let _ = emit 100000000 in
  let _ = emit 274877906944 in        -- 2^38 boundary
  let _ = emit 549755813888 in        -- 2^39
  let _ = emit 1099511627776 in       -- 2^40
  let _ = emit 8796093022208 in       -- 2^43 (handoff's measured meansq peak)
  let _ = emit 20250000000000 in      -- 4.5e6^2, the bx_overflow_test magnitude (~2^44)
  let _ = emit 35184372088832 in      -- 2^45
  0
