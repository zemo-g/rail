-- R1c + R1d (1B ladder): large-argument exact range reduction + exact-integer RoPE.
--
-- R1c: RoPE angles theta = pos * freq reach ~seq_len (>> 2*pi), so bx4_sinb/bx4_cosb reduce via a
-- 48-bit-precise 2*pi (single-limb int63, valid theta < 16384). Gate: FD vs libm over [0, 8000].
--
-- R1d: exact-integer RoPE. The HF/Gemma rotate-half form, every step a FIXED INTEGER algorithm:
--   freq_i  = base^(-2i/d)         -- generated by bx4_fxexp (NO float in the exact path)
--   theta   = pos * freq_i
--   out[i]      = ( q[i]*cos(theta) - q[i+d/2]*sin(theta) ) / S
--   out[i+d/2]  = ( q[i+d/2]*cos(theta) + q[i]*sin(theta) ) / S
-- So RoPE reproduces bit-for-bit on any device. Gate: FD vs a libm float-RoPE reference; the
-- pos=0 IDENTITY (theta=0 -> out==q exactly); and D0 (exact RoPE run-twice bit-identical).
--
-- Honest scope: freq table is F=24, so at very long positions theta = pos*freq_q carries up to
-- ~pos*0.5/S rad of freq-quant error (~2e-4 at pos=8000). Bit-exactness is unaffected; tighter
-- long-context ACCURACY wants an F=48 freq table (a clean R3 follow-up). Tol set accordingly.
--
-- Build: ./rail_native --out-prefix /tmp/r1rope tools/bitexact/r1_rope.rail
-- Run:   /tmp/r1rope

import "tools/bitexact/bx_fixed.rail"

foreign sin x -> float
foreign cos x -> float
foreign pow x y -> float

-- ln(10000)*S = 154523870 (standard RoPE base). Gemma global layers use 1000000 -> 231785805.
-- freq_i * S = exp( -(2i*ln_base)/d ) computed by the exact-integer exp.
r1_freq_q i d lnb = bx4_fxexp (0 - ((2 * i * lnb) / d))

-- ===== R1c: FD vs libm at large angles (carry maxima in float_arr cells, int-only loop) =====
r1c_sweep N j step maxs maxc =
  if j >= N then 0
  else
    let theta = (int_to_float j) *. step in
    let thq = bx4_quant theta in
    let s = bx4_back (bx4_sinb thq) in
    let c = bx4_back (bx4_cosb thq) in
    let es = bx4_fabs (s -. (sin theta)) in
    let ec = bx4_fabs (c -. (cos theta)) in
    let _ = float_arr_set maxs 0 (if es >. (float_arr_get maxs 0) then es else (float_arr_get maxs 0)) in
    let _ = float_arr_set maxc 0 (if ec >. (float_arr_get maxc 0) then ec else (float_arr_get maxc 0)) in
    r1c_sweep N (j + 1) step maxs maxc

-- ===== R1d: exact-integer RoPE on a head vector q (length d), at position pos =====
r1d_rope q out d pos lnb i =
  if i + i >= d then out
  else
    let fq = r1_freq_q i d lnb in
    let thq = pos * fq in
    let cq = bx4_cosb thq in
    let sq = bx4_sinb thq in
    let qi = arr_get q i in
    let qj = arr_get q (i + d / 2) in
    let _ = arr_set out i ((qi * cq - qj * sq) / 16777216) in
    let _ = arr_set out (i + d / 2) ((qj * cq + qi * sq) / 16777216) in
    r1d_rope q out d pos lnb (i + 1)

-- float reference RoPE (libm pow/sin/cos)
r1d_ref qf out d pos i =
  if i + i >= d then out
  else
    let f = pow 10000.0 (0.0 -. ((2.0 *. (int_to_float i)) /. (int_to_float d))) in
    let th = (int_to_float pos) *. f in
    let c = cos th in
    let s = sin th in
    let qi = float_arr_get qf i in
    let qj = float_arr_get qf (i + d / 2) in
    let _ = float_arr_set out i (qi *. c -. qj *. s) in
    let _ = float_arr_set out (i + d / 2) (qj *. c +. qi *. s) in
    r1d_ref qf out d pos (i + 1)

-- deterministic head vector: fixed-point values bounded in ~[-1, 1]
r1_imod a b = a - (a / b) * b
r1d_fillq q d i =
  if i >= d then q
  else
    let v = ((r1_imod (i * 37 + 11) 25) - 12) * 1398101 in   -- in [-12,12]*S/12 ~ [-1,1]*S
    let _ = arr_set q i v in
    r1d_fillq q d (i + 1)
r1d_i2f src dst d i =
  if i >= d then dst
  else let _ = float_arr_set dst i (bx4_back (arr_get src i)) in r1d_i2f src dst d (i + 1)

-- max | exact - ref | over the rotated vector; acc is a float_arr[1] cell (int-only loop --
-- a float accumulator reading loop-indexed arrays SEGFAULTS, per rail-bug-self-loop-cross-dep-args)
r1d_maxerr ex rf d acc i =
  if i >= d then 0
  else
    let e = bx4_fabs ((bx4_back (arr_get ex i)) -. (float_arr_get rf i)) in
    let _ = float_arr_set acc 0 (if e >. (float_arr_get acc 0) then e else (float_arr_get acc 0)) in
    r1d_maxerr ex rf d acc (i + 1)
r1d_eq A B d i bad =
  if i >= d then bad
  else r1d_eq A B d (i + 1) (if (arr_get A i) == (arr_get B i) then bad else bad + 1)

-- one RoPE check at a position: returns max abs error vs float ref
r1d_at d pos lnb =
  let q = r1d_fillq (arr_new d 0) d 0 in
  let qf = r1d_i2f q (float_arr_new d 0.0) d 0 in
  let ex = r1d_rope q (arr_new d 0) d pos lnb 0 in
  let rf = r1d_ref qf (float_arr_new d 0.0) d pos 0 in
  let acc = float_arr_new 1 0.0 in
  let _ = r1d_maxerr ex rf d acc 0 in
  float_arr_get acc 0

main =
  -- R1c gate
  let N = 8000 in
  let step = 1.0 in
  let maxs = float_arr_new 1 0.0 in
  let maxc = float_arr_new 1 0.0 in
  let _ = r1c_sweep N 0 step maxs maxc in
  let es = float_arr_get maxs 0 in
  let ec = float_arr_get maxc 0 in
  let ctol = 0.00002 in
  let okc = if es <. ctol then (if ec <. ctol then 1 else 0) else 0 in
  let _ = print (cat ["R1c reduce  theta in [0,", show N, "]  max|sin-ref|=", show es, "  max|cos-ref|=", show ec, "   ", if okc == 1 then "PASS" else "FAIL"]) in
  -- R1d gate
  let d = 256 in
  let lnb = 154523870 in
  let e0 = r1d_at d 0 lnb in            -- pos 0: must be EXACTLY identity -> 0 error
  let e1 = r1d_at d 1 lnb in
  let e37 = r1d_at d 37 lnb in
  let e512 = r1d_at d 512 lnb in
  let e8k = r1d_at d 8000 lnb in
  -- pos=0 identity (exact): exact RoPE == original q bit-for-bit
  let q = r1d_fillq (arr_new d 0) d 0 in
  let ex0 = r1d_rope q (arr_new d 0) d 0 lnb 0 in
  let badId = r1d_eq ex0 q d 0 0 in
  -- D0: exact RoPE at pos 8000 run twice -> bit-identical
  let a = r1d_rope q (arr_new d 0) d 8000 lnb 0 in
  let b = r1d_rope q (arr_new d 0) d 8000 lnb 0 in
  let badD0 = r1d_eq a b d 0 0 in
  let rtol = 0.001 in
  let worst = if e1 >. e37 then e1 else e37 in
  let worst2 = if worst >. e512 then worst else e512 in
  let worst3 = if worst2 >. e8k then worst2 else e8k in
  let okd = if worst3 <. rtol then (if badId == 0 then (if badD0 == 0 then 1 else 0) else 0) else 0 in
  let _ = print (cat ["R1d RoPE    d=", show d, "  err pos1=", show e1, " pos37=", show e37, " pos512=", show e512, " pos8000=", show e8k]) in
  let _ = print (cat ["            pos0-identity-mism=", show badId, "  D0-mism=", show badD0, "   ", if okd == 1 then "PASS" else "FAIL"]) in
  let allok = if okc == 1 then okd else 0 in
  let _ = print (if allok == 1
    then "R1 PASS: exact-integer RoPE is a fixed integer algorithm -- 48-bit range reduction holds to libm at theta=8000, rotation matches the float reference, pos=0 is bit-exact identity, and the exact path reproduces itself bit-for-bit. The main missing transcendental for the 1B forward is closed."
    else "R1 FAIL: inspect the R1c or R1d line") in
  if allok == 1 then 0 else 1
