-- LM1: the GENERATING rung -- a char-level next-token Rail LANGUAGE MODEL whose
-- ENTIRE training trajectory is bit-exact AND attested, and which DECODES to emit
-- Rail source gated by the LM0 compile-as-oracle. This crosses the bridge no prior
-- rung crossed: BX10 proved attested bit-exact training on a toy REGRESSION net that
-- emits no Rail; LM1 retargets that exact-integer core (forward/backward/Adam atoms +
-- the rung24/25 Ed25519 hash-chain) onto a next-token objective over a real Rail
-- corpus, then greedily decodes a program and runs it through the user-facing metric.
--
-- MODEL (deliberately minimal, to reuse the PROVEN BX10 exact-integer machinery 1:1):
--   * vocab      = distinct chars of the corpus, first-appearance order (deterministic)
--   * embeddings = FROZEN deterministic d-vector per token id (NOT trained) -> the
--                  trainable parameters are exactly W1,W2, so the reverse-mode grads and
--                  Adam are byte-identical to BX10's (no new gradient paths to get wrong)
--   * context    = positional-weighted average of the last C token embeddings (exact int)
--   * head       = z1 = W1.x ; h1 = gelu(z1) ; logits = W2.h1   (W2 is V x hidden)
--   * objective  = MSE against the one-hot of the next token (0.5*||logits - e_tgt||^2).
--                  Squared-error-on-one-hot keeps the whole loss exact-integer with NO
--                  softmax/exp (bx4_fxexp exists for a future CE upgrade); decode = argmax.
--   * training   = SGD over corpus (context->next) pairs, one pair/step, exact Adam.
--
-- BIT-EXACT + ATTESTED (identical ritual to BX10, new LOCAL genesis/seed strings):
--   Per step, at the PRE-update weights:
--     w_hex = SHA256(canon W1 ";;" canon W2) ; g_hex = SHA256(canon dW1 ";;" canon dW2)
--     link  = SHA256(prev "|" step "|" w_hex "|" g_hex "|" loss) ; sig = Ed25519(seed,link)
--   prev(step0)=genesis. Signed ledger -> /tmp/lm1_chain.txt for the LM1 foreign re-verifier.
--   Data seed (koff) is pinned to the SHA-256 of tools/bitexact/lm1_corpus.txt, so the run
--   is provably a function of the pinned corpus. LOCAL/DEV keys only (never a prod surface).
--
-- THE 7-HOUR-BURN RULE: the user-facing metric (LM0 compile-as-oracle) runs at the FIRST
-- checkpoint. Reported HONESTLY: a tiny undertrained char-MLP will not yet emit compilable
-- Rail, so the MODEL's own generated-program compile% is expected ~0 -- that 0 is the
-- BASELINE the future (more data, more steps, a real transformer head) must beat. What is
-- proven NOW is the machinery: exact-integer LM training that reproduces bit-for-bit and is
-- Ed25519-attested + foreign re-verifiable, with the honest gate wired in front of it.
--
-- Gates (all must hold):
--   D0         re-run the WHOLE training+chain -> identical chain head AND final dataset loss
--   okSigs     every per-step signature verifies under the run pubkey
--   okProg     datasetLossK < datasetLoss0 (real descent over the WHOLE corpus, exact int)
--   okTamper   a one-byte-flipped signature is REJECTED
--   okWrongKey a signature from a different key is REJECTED
--
-- Build: ./rail_native --out-prefix /tmp/lm1 tools/bitexact/lm1_attested_train.rail
-- Run:   /tmp/lm1        (writes /tmp/lm1_chain.txt + /tmp/lm1_gen.rail)

import "tools/bitexact/bx_fixed.rail"
import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"

-- ===== small utilities (BX10) =====
lm1_nth xs i = if i <= 0 then head xs else lm1_nth (tail xs) (i - 1)
lm1_imod a b = a - (a / b) * b
lm1_len xs = if xs == [] then 0 else 1 + lm1_len (tail xs)
lm1_hex2int s i n acc = if i >= n then acc
  else lm1_hex2int s (i + 1) n (acc * 16 + (str_find (str_sub s i 1) "0123456789abcdef"))
lm1_take n xs = if n <= 0 then [] else if xs == [] then [] else cons (head xs) (lm1_take (n - 1) (tail xs))
lm1_snoc xs v = if xs == [] then cons v [] else cons (head xs) (lm1_snoc (tail xs) v)

-- ===== char-level vocab + tokenization (deterministic, first-appearance order) =====
lm1_vocab_go cs acc = if cs == [] then acc
  else let c = head cs in
       let acc2 = if str_contains c acc then acc else cat [acc, c] in
       lm1_vocab_go (tail cs) acc2
lm1_vocab corpus = lm1_vocab_go (chars corpus) ""
lm1_tokens_go cs vocab = if cs == [] then [] else cons (str_find (head cs) vocab) (lm1_tokens_go (tail cs) vocab)
lm1_tokens corpus vocab = lm1_tokens_go (chars corpus) vocab
lm1_decode ids vocab = if ids == [] then "" else cat [str_sub vocab (head ids) 1, lm1_decode (tail ids) vocab]

-- (context, next-token) pairs over a sliding window of C tokens
lm1_pairs ids c = if (lm1_len ids) <= c then [] else cons (lm1_take c ids, lm1_nth ids c) (lm1_pairs (tail ids) c)

-- ===== exact-integer vector / matrix ops (BX6 atoms; one truncation per output) =====
lm1_dot_go u v acc = if u == [] then acc else lm1_dot_go (tail u) (tail v) (acc + (head u) * (head v))
lm1_dot u v = (lm1_dot_go u v 0) / 16777216
lm1_matvec rows v = if rows == [] then [] else cons (lm1_dot (head rows) v) (lm1_matvec (tail rows) v)
lm1_vadd u v = if u == [] then [] else cons ((head u) + (head v)) (lm1_vadd (tail u) (tail v))
lm1_vsub u v = if u == [] then [] else cons ((head u) - (head v)) (lm1_vsub (tail u) (tail v))
lm1_zeros d = if d < 1 then [] else cons 0 (lm1_zeros (d - 1))
lm1_divS xs = if xs == [] then [] else cons ((head xs) / 16777216) (lm1_divS (tail xs))
lm1_vscale_raw s row = if row == [] then [] else cons (s * (head row)) (lm1_vscale_raw s (tail row))
lm1_vdivk xs k = if xs == [] then [] else cons ((head xs) / k) (lm1_vdivk (tail xs) k)
lm1_mtv_go rows v acc = if rows == [] then acc else lm1_mtv_go (tail rows) (tail v) (lm1_vadd acc (lm1_vscale_raw (head v) (head rows)))
lm1_matvec_t rows v cols = lm1_divS (lm1_mtv_go rows v (lm1_zeros cols))
lm1_outer_row ui w = if w == [] then [] else cons ((ui * (head w)) / 16777216) (lm1_outer_row ui (tail w))
lm1_outer u w = if u == [] then [] else cons (lm1_outer_row (head u) w) (lm1_outer (tail u) w)
lm1_geluv xs = if xs == [] then [] else cons (bx4_gelu (head xs)) (lm1_geluv (tail xs))
lm1_dz1 z1 dh1 = if z1 == [] then [] else cons (((bx4_gelu_grad (head z1)) * (head dh1)) / 16777216) (lm1_dz1 (tail z1) (tail dh1))

-- ===== deterministic fixed-point init (BX10 cell family) =====
lm1_cell0 kind i j koff = (lm1_imod (kind * 101 + i * 5 + j * 3 + 7 + koff) 13 - 6) * 1398101
lm1_genvec_go kind j cols koff = if j >= cols then [] else cons (lm1_cell0 kind 0 j koff) (lm1_genvec_go kind (j + 1) cols koff)
lm1_genvec kind cols koff = lm1_genvec_go kind 0 cols koff
lm1_initrow kind i j cols koff = if j >= cols then []
  else cons (cons (lm1_cell0 kind i j koff) (cons 0 (cons 0 []))) (lm1_initrow kind i (j + 1) cols koff)
lm1_initmat_go kind i rows cols koff = if i >= rows then []
  else cons (lm1_initrow kind i 0 cols koff) (lm1_initmat_go kind (i + 1) rows cols koff)
lm1_initmat kind rows cols koff = lm1_initmat_go kind 0 rows cols koff
lm1_throw crow = if crow == [] then [] else cons (head (head crow)) (lm1_throw (tail crow))
lm1_thmat cm = if cm == [] then [] else cons (lm1_throw (head cm)) (lm1_thmat (tail cm))

-- ===== FROZEN embeddings + context vector (positional-weighted average) =====
lm1_emb id d = lm1_genvec (id + 1) d 0
lm1_wtot c = (c * (c + 1)) / 2
lm1_ctxacc ctx p d acc = if ctx == [] then acc
  else lm1_ctxacc (tail ctx) (p + 1) d (lm1_vadd acc (lm1_vscale_raw (p + 1) (lm1_emb (head ctx) d)))
lm1_ctx_vec ctx d c = lm1_vdivk (lm1_ctxacc ctx 0 d (lm1_zeros d)) (lm1_wtot c)
lm1_onehot_go k i v = if i >= v then [] else cons (if i == k then 16777216 else 0) (lm1_onehot_go k (i + 1) v)
lm1_onehot k v = lm1_onehot_go k 0 v

-- ===== forward + MSE-on-one-hot loss + reverse-mode gradients (exact-integer) =====
lm1_forward w1 w2 x = lm1_matvec w2 (lm1_geluv (lm1_matvec w1 x))
lm1_sq dv = (dv * dv) / 16777216
lm1_sqsum xs = if xs == [] then 0 else (lm1_sq (head xs)) + lm1_sqsum (tail xs)
lm1_loss w1 w2 x t = (lm1_sqsum (lm1_vsub (lm1_forward w1 w2 x) t)) / 2
lm1_grads w1 w2 x t hidden =
  let z1 = lm1_matvec w1 x in
  let h1 = lm1_geluv z1 in
  let z2 = lm1_matvec w2 h1 in
  let dz2 = lm1_vsub z2 t in
  let dW2 = lm1_outer dz2 h1 in
  let dh1 = lm1_matvec_t w2 dz2 hidden in
  let dz1 = lm1_dz1 z1 dh1 in
  let dW1 = lm1_outer dz1 x in
  cons dW1 (cons dW2 [])

-- ===== exact-integer Adam (BX7 atoms) =====
lm1_powfx_a base acc t = if t <= 0 then acc else lm1_powfx_b base ((acc * base) / 16777216) (t - 1)
lm1_powfx_b base acc t = if t <= 0 then acc else lm1_powfx_a base ((acc * base) / 16777216) (t - 1)
lm1_powfx base t = lm1_powfx_a base 16777216 t
lm1_adam th m v g beta1 beta2 lr eps bc1 bc2 =
  let m2 = ((beta1 * m) / 16777216) + (((16777216 - beta1) * g) / 16777216) in
  let g2 = (g * g) / 16777216 in
  let v2 = ((beta2 * v) / 16777216) + (((16777216 - beta2) * g2) / 16777216) in
  let mhat = (m2 * 16777216) / bc1 in
  let vhat = (v2 * 16777216) / bc2 in
  let denom = (bx4_fxsqrt vhat) + eps in
  let step = (lr * mhat) / denom in
  cons (th - step) (cons m2 (cons v2 []))
lm1_updcell cell g beta1 beta2 lr eps bc1 bc2 =
  lm1_adam (head cell) (head (tail cell)) (head (tail (tail cell))) g beta1 beta2 lr eps bc1 bc2
lm1_updrow crow grow beta1 beta2 lr eps bc1 bc2 =
  if crow == [] then []
  else cons (lm1_updcell (head crow) (head grow) beta1 beta2 lr eps bc1 bc2) (lm1_updrow (tail crow) (tail grow) beta1 beta2 lr eps bc1 bc2)
lm1_updmat cm gm beta1 beta2 lr eps bc1 bc2 =
  if cm == [] then []
  else cons (lm1_updrow (head cm) (head gm) beta1 beta2 lr eps bc1 bc2) (lm1_updmat (tail cm) (tail gm) beta1 beta2 lr eps bc1 bc2)

-- ===== canonical serialization (for the commitments) =====
lm1_canon_row xs = if xs == [] then "" else cat [show (head xs), " ", lm1_canon_row (tail xs)]
lm1_canon_mat m = if m == [] then "" else cat [lm1_canon_row (head m), ";", lm1_canon_mat (tail m)]

-- ===== dataset total loss (for okProg: descent over the WHOLE corpus) =====
lm1_dsloss_go pairs w1 w2 d v c acc = if pairs == [] then acc
  else let pr = head pairs in let (ctx, tgt) = pr in
       let x = lm1_ctx_vec ctx d c in let t = lm1_onehot tgt v in
       lm1_dsloss_go (tail pairs) w1 w2 d v c (acc + (lm1_loss w1 w2 x t))
lm1_dsloss pairs w1 w2 d v c = lm1_dsloss_go pairs w1 w2 d v c 0

-- ===== one signed record at the PRE-update weights, then one Adam step =====
lm1_record pairs w1c w2c d hidden v c beta1 beta2 lr eps seed pk prev_hex step_i bc1 bc2 =
  let np = lm1_len pairs in
  let j = lm1_imod step_i np in
  let pr = lm1_nth pairs j in
  let (ctx, tgt) = pr in
  let x = lm1_ctx_vec ctx d c in
  let t = lm1_onehot tgt v in
  let w1 = lm1_thmat w1c in
  let w2 = lm1_thmat w2c in
  let loss = lm1_loss w1 w2 x t in
  let gs = lm1_grads w1 w2 x t hidden in
  let dW1 = lm1_nth gs 0 in
  let dW2 = lm1_nth gs 1 in
  let w_hex = sha256_hex (cat [lm1_canon_mat w1, ";;", lm1_canon_mat w2]) in
  let g_hex = sha256_hex (cat [lm1_canon_mat dW1, ";;", lm1_canon_mat dW2]) in
  let loss_str = show loss in
  let link_str = cat [prev_hex, "|", show step_i, "|", w_hex, "|", g_hex, "|", loss_str] in
  let link_b = sha256 link_str in
  let link_hex = bytes_to_hex link_b 32 in
  let sig = ed25519_sign seed link_b 32 in
  let sig_hex = bytes_to_hex sig 64 in
  let ok = ed25519_verify pk link_b 32 sig in
  let nw1 = lm1_updmat w1c dW1 beta1 beta2 lr eps bc1 bc2 in
  let nw2 = lm1_updmat w2c dW2 beta1 beta2 lr eps bc1 bc2 in
  let line = cat [show step_i, " ", w_hex, " ", g_hex, " ", loss_str, " ", prev_hex, " ", link_hex, " ", sig_hex] in
  cons link_hex (cons line (cons ok (cons nw1 (cons nw2 (cons loss [])))))

lm1_chain pairs w1c w2c d hidden v c beta1 beta2 lr eps seed pk kk i prev_hex acc all_ok =
  if i >= kk then cons all_ok (cons acc (cons prev_hex (cons w1c (cons w2c []))))
  else
    let bc1 = 16777216 - (lm1_powfx beta1 (i + 1)) in
    let bc2 = 16777216 - (lm1_powfx beta2 (i + 1)) in
    let r = lm1_record pairs w1c w2c d hidden v c beta1 beta2 lr eps seed pk prev_hex i bc1 bc2 in
    let link_hex = lm1_nth r 0 in
    let line = lm1_nth r 1 in
    let ok = lm1_nth r 2 in
    let nw1 = lm1_nth r 3 in
    let nw2 = lm1_nth r 4 in
    lm1_chain pairs nw1 nw2 d hidden v c beta1 beta2 lr eps seed pk kk (i + 1) link_hex (cat [acc, line, "\n"]) (all_ok * ok)

-- ===== greedy decode: emit a Rail program from a seed context =====
lm1_argmax_go xs i best bi = if xs == [] then bi
  else if (head xs) > best then lm1_argmax_go (tail xs) (i + 1) (head xs) i
       else lm1_argmax_go (tail xs) (i + 1) best bi
lm1_argmax xs = lm1_argmax_go (tail xs) 1 (head xs) 0
lm1_gen w1 w2 ctx d c g acc = if g <= 0 then acc
  else let nid = lm1_argmax (lm1_forward w1 w2 (lm1_ctx_vec ctx d c)) in
       lm1_gen w1 w2 (tail (lm1_snoc ctx nid)) d c (g - 1) (lm1_snoc acc nid)

main =
  let _ = shell "rm -f /tmp/lm1_chain.txt /tmp/lm1_gen.rail" in
  let _ = shell "mkdir -p /tmp/lm_completions" in
  let d = 8 in
  let hidden = 16 in
  let cwin = 8 in
  let kk = 48 in
  let gen_n = 64 in
  let beta1 = 15099494 in
  let beta2 = 16760439 in
  let lr = 838861 in
  let eps = 16777 in

  -- PIN: data seed is a function of the LM1 corpus content hash
  let corpus = read_file "tools/bitexact/lm1_corpus.txt" in
  let chash = sha256_hex corpus in
  let cseed = lm1_hex2int chash 0 6 0 in
  let koff = lm1_imod cseed 7 in
  let vocab = lm1_vocab corpus in
  let vsize = lm1_len (chars vocab) in
  let ids = lm1_tokens corpus vocab in
  let pairs = lm1_pairs ids cwin in
  let npairs = lm1_len pairs in
  let w1c0 = lm1_initmat 0 hidden d koff in
  let w2c0 = lm1_initmat 1 vsize hidden koff in

  -- EPHEMERAL LOCAL DEV KEY + LOCAL genesis (never a prod sign surface / live pulse)
  let seed = sha256 "lm1.local.ephemeral.dev.seed.v1" in
  let pk = ed25519_pk_from_sk seed in
  let pk_hex = bytes_to_hex pk 32 in
  let genesis_hex = sha256_hex "LM1.LOCAL.BEACON.GENESIS.dev" in

  -- ===== the attested training run =====
  let res = lm1_chain pairs w1c0 w2c0 d hidden vsize cwin beta1 beta2 lr eps seed pk kk 0 genesis_hex "" 1 in
  let all_ok = lm1_nth res 0 in
  let body = lm1_nth res 1 in
  let head_link = lm1_nth res 2 in
  let fw1 = lm1_nth res 3 in
  let fw2 = lm1_nth res 4 in

  -- dataset-loss descent over the WHOLE corpus (initial vs final weights)
  let ds0 = lm1_dsloss pairs (lm1_thmat w1c0) (lm1_thmat w2c0) d vsize cwin in
  let dsK = lm1_dsloss pairs (lm1_thmat fw1) (lm1_thmat fw2) d vsize cwin in

  -- persist the signed ledger (header carries everything the re-verifier needs)
  let header = cat ["# LM1v1 ", pk_hex, " ", genesis_hex, " ", show kk, " ", chash, " ", show koff, " ", show d, " ", show hidden, " ", show vsize, " ", show cwin, "\n"] in
  let _ = write_file "/tmp/lm1_chain.txt" (cat [header, body]) in

  -- ===== greedy decode -> emit a Rail program, then the user-facing metric =====
  let ctx0 = lm1_take cwin ids in
  let gen_ids = lm1_gen (lm1_thmat fw1) (lm1_thmat fw2) ctx0 d cwin gen_n [] in
  let gen_src = lm1_decode gen_ids vocab in
  let _ = write_file "/tmp/lm1_gen.rail" gen_src in
  -- compile the MODEL's generated program directly (its honest compile% at this checkpoint)
  let _ = shell "./rail_native --out-prefix /tmp/lm1_gen_bin /tmp/lm1_gen.rail > /tmp/lm1_gen.log 2>&1" in
  let glog = read_file "/tmp/lm1_gen.log" in
  let model_compiles = if str_contains "ld: OK" glog then 1 else 0 in
  -- run the LM0 instrument on CLEAN references for liveness (does it still discriminate?)
  let _ = shell "rm -f /tmp/lm_completions/*.rail" in
  let _ = shell "./rail_native --out-prefix /tmp/lm1_lm0_bin tools/bitexact/lm0_compile_eval.rail > /tmp/lm1_lm0_build.log 2>&1" in
  let _ = shell "/tmp/lm1_lm0_bin > /tmp/lm1_lm0_run.log 2>&1" in
  let lm0raw = read_file "/tmp/lm0_eval.txt" in
  let lm0live = if lm0raw == "" then "(unavailable)" else head (str_split " " lm0raw) in

  -- D0: re-run the WHOLE training + chain -> must be bit-identical
  let res2 = lm1_chain pairs w1c0 w2c0 d hidden vsize cwin beta1 beta2 lr eps seed pk kk 0 genesis_hex "" 1 in
  let head2 = lm1_nth res2 2 in
  let dsK2 = lm1_dsloss pairs (lm1_thmat (lm1_nth res2 3)) (lm1_thmat (lm1_nth res2 4)) d vsize cwin in
  let d0 = if head_link == head2 then (if dsK == dsK2 then 0 else 1) else 1 in

  -- falsification probes (prove the verifier genuinely discriminates)
  let pmsg = sha256 "lm1.tamper.probe" in
  let psig = ed25519_sign seed pmsg 32 in
  let okGood = ed25519_verify pk pmsg 32 psig in
  let tsig = arr_new 64 0 in
  let _ = sha_copy_bytes psig tsig 0 0 64 in
  let _ = arr_set tsig 5 (bit_xor (arr_get tsig 5) 1) in
  let okBad = ed25519_verify pk pmsg 32 tsig in
  let seed2 = sha256 "lm1.other.key" in
  let wsig = ed25519_sign seed2 pmsg 32 in
  let okW = ed25519_verify pk pmsg 32 wsig in

  -- Gates
  let okSigs = if all_ok == 1 then 1 else 0 in
  let okProg = if dsK < ds0 then 1 else 0 in
  let okTamper = if okGood == 1 then (if okBad == 0 then 1 else 0) else 0 in
  let okWrongKey = if okW == 0 then 1 else 0 in
  let okD0 = if d0 == 0 then 1 else 0 in
  let all = okSigs * okProg * okTamper * okWrongKey * okD0 in

  let _ = print (cat ["LM1 attested bit-exact char-LM: vocab=", show vsize, " d=", show d, " hidden=", show hidden, " ctx=", show cwin, " pairs=", show npairs, " steps=", show kk, " (exact-integer F=24)"]) in
  let _ = print (cat ["LM1 corpus pin: SHA-256 ", chash, "  koff=", show koff]) in
  let _ = print (cat ["LM1 first-checkpoint user-facing eval: LM0 instrument compile% = ", lm0live, " [LIVE/discriminating]; MODEL generated-Rail compiles = ", show model_compiles, " [honest baseline -- undertrained char-MLP]"]) in
  let _ = print (cat ["LM1 pubkey=", pk_hex]) in
  let _ = print (cat ["LM1 chain head=", head_link]) in
  let _ = print (cat ["LM1 datasetLoss0=", show ds0, " datasetLossK=", show dsK, " (fixed-point; descent=", show okProg, ")"]) in
  let _ = print (cat ["LM1 D0 (re-run whole training bit-identical)=", show okD0, "  per-step sigs verify=", show okSigs, "  tamper-reject=", show okTamper, "  wrong-key-reject=", show okWrongKey]) in
  let _ = print (cat ["LM1 signed ledger: /tmp/lm1_chain.txt (", show kk, " records); generated program: /tmp/lm1_gen.rail (", show gen_n, " chars)"]) in
  let _ = print (if all == 1
    then "LM1 PASS: bit-exact attested next-token LM training; whole run reproduces bit-for-bit (D0) + tamper-evident + corpus-pinned; user-facing gate wired + reported honestly"
    else "LM1 FAIL") in
  if all == 1 then 0 else 1
