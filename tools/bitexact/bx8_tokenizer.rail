-- BX8: a REAL BPE tokenizer (stdlib/bpe.rail) replacing the char-level scheme,
-- wired as a bit-exact, foreign-reproducible stage of the training pipeline.
--
-- Tokenization is already INTEGER-domain (text -> token ids), so unlike the
-- numeric core (BX4-BX7) it carries no float non-associativity. The frontier
-- property it must still satisfy is DETERMINISM + FOREIGN REPRODUCIBILITY: the
-- exact merge list and the exact id sequence must be a fixed algorithm, so an
-- independent re-impl (BX12) reproduces the model's INPUT bit-for-bit -- without
-- that, "reproduce every checkpoint from data+config+seed" has no fixed seed.
--
-- stdlib/bpe.rail is deterministic by construction:
--   * base vocab = distinct chars in first-appearance order
--   * best pair  = max adjacency count, tie-break the SMALLEST packed key
--                  (a*2^20+b), via an in-order tree walk with strict v>best
--   * merge apply = greedy left-to-right, consume both tokens on a hit
--   * stop when target hit OR best count < 2
-- Every step is integer; no libm, no float, no schedule dependence.
--
-- Gates:
--   D0  train+encode TWICE -> byte-identical (merges + id stream string-equal).
--   D3  bx8_foreign_check.py re-implements BPE train+encode in pure Python and
--       reproduces the SAME merges and the SAME id sequence from the SAME corpus
--       bytes (/tmp/bx8_corpus.txt) -> the tokenizer is foreign-reproducible.

import "stdlib/bpe.rail"

-- A small but real broad-text corpus (English + Rail source), heavy in common
-- bigrams/words so BPE learns genuine merges. ASCII-only (flows to .asciz).
bx8_corpus = "the quick brown fox jumps over the lazy dog. the rain in spain falls mainly on the plain. she sells sea shells by the sea shore. let main = print hello world. let add a b = a + b in add three and four. the the the and and and for for for. fixed point arithmetic is exact and associative so any device reproduces the same bits. integer addition is associative and order independent. the the and and for for let let add add the the the."

-- pull the ordered merge list out of the BPE struct
bx8_merges_of bpe = match bpe
  | BPE m v s -> m

-- flatten a merge triple (a,b,nid) and an id list to space-separated strings
bx8_merge_str m = let mm = m in let a = bx8_fst3 mm in let b = bx8_snd3 mm in let c = bx8_thd3 mm in join "" [show a, " ", show b, " ", show c, " "]
bx8_fst3 t = let (a, b, c) = t in a
bx8_snd3 t = let (a, b, c) = t in b
bx8_thd3 t = let (a, b, c) = t in c
bx8_merges_str ms = join "" (map bx8_merge_str ms)
bx8_ids_str ids = if ids == [] then "" else join "" [show (head ids), " ", bx8_ids_str (tail ids)]

-- full dump string: vocab size, merges line, ids line
bx8_dump_str vsize merges ids = join "" [show vsize, "\n", bx8_merges_str merges, "\n", bx8_ids_str ids, "\n"]

bx8_len xs = if xs == [] then 0 else 1 + bx8_len (tail xs)

main =
  let target = 90 in
  let bpe1 = bpe_train bx8_corpus target in
  let ids1 = bpe_encode bpe1 bx8_corpus in
  let vsize1 = bpe_vocab_size bpe1 in
  let merges1 = bx8_merges_of bpe1 in
  let s1 = bx8_dump_str vsize1 merges1 ids1 in
  -- D0: independent re-run must be byte-identical
  let bpe2 = bpe_train bx8_corpus target in
  let ids2 = bpe_encode bpe2 bx8_corpus in
  let vsize2 = bpe_vocab_size bpe2 in
  let merges2 = bx8_merges_of bpe2 in
  let s2 = bx8_dump_str vsize2 merges2 ids2 in
  let d0 = if s1 == s2 then 0 else 1 in
  -- decode round-trip: bpe_decode . bpe_encode == corpus (lossless tokenizer)
  let back = bpe_decode bpe1 ids1 in
  let rt = if back == bx8_corpus then 0 else 1 in
  let ncorp = bx8_len (chars bx8_corpus) in
  let nids = bx8_len ids1 in
  let nmerges = bx8_len merges1 in
  let _ = print (join "" ["BX8 D0 (run-twice tokenization identical): ", if d0 == 0 then "PASS" else "FAIL"]) in
  let _ = print (join "" ["BX8 decode round-trip (lossless): ", if rt == 0 then "PASS" else "FAIL"]) in
  let _ = print (join "" ["BX8 corpus chars: ", show ncorp, "  vocab size: ", show vsize1, "  merges: ", show nmerges, "  ids: ", show nids]) in
  let comp = (ncorp * 100) / (nids + 1) in
  let _ = print (join "" ["BX8 compression (chars*100/ids): ", show comp, " (>100 = real BPE compression)"]) in
  let _ = write_file "/tmp/bx8_corpus.txt" bx8_corpus in
  let _ = write_file "/tmp/bx8_dump.txt" s1 in
  let _ = print (if d0 + rt == 0
    then "BX8 PASS: real BPE tokenizer deterministic (D0) + lossless; corpus+dump written for D3"
    else "BX8 FAIL") in
  0
