-- LM5 (rung 16): SINGLE-HEAD SELF-ATTENTION. LM4 proved an attested bit-exact char-LM with
-- TRAINED embeddings that crosses the user-facing compile gate. LM5 inserts one self-attention
-- layer BETWEEN the embedding rows and the MLP head (the MLP is unchanged). Forward:
--   rows = [ E[ctx[0]], ..., E[ctx[C-1]] ]                (C rows, each length d)
--   att  = attention(Wq,Wk,Wv, rows, isd)                 (C rows, each length d)
--   x'   = flatten(att)                                   (input dim = C*d, fed to the MLP)
-- where scores[i][j] = (dot(Q[i],K[j]) * isd)/S ; probs = softmax(scores) ; out[i] = Σj probs[i][j]·V[j].
-- Wq,Wk,Wv are d×d trainable matrices; isd = round(S/sqrt(d)) is a pinned constant (mul-operand only).
-- Backward: the MLP's input-gradient dx (len C*d) is reshaped to dOut (C rows of d), fed to
-- attn_bwd (validated bit-for-bit vs Python), which returns dWq/dWk/dWv and dX; dX is flattened
-- and scattered into dE exactly as LM4. The checkpoint commitment now binds the attention weights:
--   w_hex = SHA256(canon W1 ";;" W2 ";;" E ";;" Wq ";;" Wk ";;" Wv).
--
-- ATTESTATION (CHECKPOINT-CADENCE): exact-integer epochs; at each epoch boundary a checkpoint
-- commits the post-epoch (W1,W2,E,Wq,Wk,Wv) state:
--   link = SHA256(prev "|" epoch "|" w_hex "|" loss) ; sig = Ed25519(seed, link) ; prev(ckpt0)=genesis
-- Signed ledger -> /tmp/lm5_chain.txt for the LM5 foreign re-verifier, which RE-RUNS every step
-- and must reproduce every checkpoint commitment bit-for-bit. LOCAL/DEV keys + LOCAL genesis only.
--
-- Gates: D0 (whole run reproduces) . okSigs . okProg (descent) . okModel (>=50% compile) .
--        okTamper (flipped sig rejected) . okWrongKey (foreign key rejected)
--
-- Build: ./rail_native --out-prefix /tmp/lm5 tools/bitexact/lm5_attested_train.rail
-- Run:   /tmp/lm5        (writes /tmp/lm5_chain.txt + /tmp/lm_completions/*.rail)

import "tools/bitexact/bx_fixed.rail"
import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"

-- ===== small utilities =====
lm4_nth xs i = if i <= 0 then head xs else lm4_nth (tail xs) (i - 1)
lm4_imod a b = a - (a / b) * b
lm4_len xs = if xs == [] then 0 else 1 + lm4_len (tail xs)
lm4_take n xs = if n <= 0 then [] else if xs == [] then [] else cons (head xs) (lm4_take (n - 1) (tail xs))
lm4_drop n xs = if n <= 0 then xs else if xs == [] then [] else lm4_drop (n - 1) (tail xs)
lm4_snoc xs v = if xs == [] then cons v [] else cons (head xs) (lm4_snoc (tail xs) v)
lm4_app xs ys = if xs == [] then ys else cons (head xs) (lm4_app (tail xs) ys)
lm4_digit c = str_find c "0123456789"
lm4_hd_int_go cs acc = if cs == [] then acc
  else let dc = lm4_digit (head cs) in
       if dc < 0 then acc else lm4_hd_int_go (tail cs) (acc * 10 + dc)
lm4_hd_int s = lm4_hd_int_go (chars s) 0

-- ===== vocab + tokens (deterministic, first-appearance order) =====
lm4_vocab_go cs acc = if cs == [] then acc
  else let c = head cs in
       let acc2 = if str_contains c acc then acc else cat [acc, c] in
       lm4_vocab_go (tail cs) acc2
lm4_vocab corpus = lm4_vocab_go (chars corpus) ""
lm4_tokens_go cs vocab = if cs == [] then [] else cons (str_find (head cs) vocab) (lm4_tokens_go (tail cs) vocab)
lm4_tokens corpus vocab = lm4_tokens_go (chars corpus) vocab
lm4_decode ids vocab = if ids == [] then "" else cat [str_sub vocab (head ids) 1, lm4_decode (tail ids) vocab]
lm4_pairs ids c = if (lm4_len ids) <= c then [] else cons (lm4_take c ids, lm4_nth ids c) (lm4_pairs (tail ids) c)

-- ===== exact-integer vector / matrix ops (F=24; one truncation per output) =====
lm4_dot_go u v acc = if u == [] then acc else lm4_dot_go (tail u) (tail v) (acc + (head u) * (head v))
lm4_dot u v = (lm4_dot_go u v 0) / 16777216
lm4_matvec rows v = if rows == [] then [] else cons (lm4_dot (head rows) v) (lm4_matvec (tail rows) v)
lm4_vadd u v = if u == [] then [] else cons ((head u) + (head v)) (lm4_vadd (tail u) (tail v))
lm4_vsub u v = if u == [] then [] else cons ((head u) - (head v)) (lm4_vsub (tail u) (tail v))
lm4_zeros d = if d < 1 then [] else cons 0 (lm4_zeros (d - 1))
lm4_divS xs = if xs == [] then [] else cons ((head xs) / 16777216) (lm4_divS (tail xs))
lm4_vscale_raw s row = if row == [] then [] else cons (s * (head row)) (lm4_vscale_raw s (tail row))
lm4_mtv_go rows v acc = if rows == [] then acc else lm4_mtv_go (tail rows) (tail v) (lm4_vadd acc (lm4_vscale_raw (head v) (head rows)))
lm4_matvec_t rows v cols = lm4_divS (lm4_mtv_go rows v (lm4_zeros cols))
lm4_outer_row ui w = if w == [] then [] else cons ((ui * (head w)) / 16777216) (lm4_outer_row ui (tail w))
lm4_outer u w = if u == [] then [] else cons (lm4_outer_row (head u) w) (lm4_outer (tail u) w)
lm4_geluv xs = if xs == [] then [] else cons (bx4_gelu (head xs)) (lm4_geluv (tail xs))
lm4_dz1 z1 dh1 = if z1 == [] then [] else cons (((bx4_gelu_grad (head z1)) * (head dh1)) / 16777216) (lm4_dz1 (tail z1) (tail dh1))

-- ===== deterministic fixed-point init (cell = [theta,m,v]) =====
lm4_cell0 kind i j koff = (lm4_imod (kind * 101 + i * 5 + j * 3 + 7 + koff) 13 - 6) * 1398101
lm4_genvec_go kind j cols koff = if j >= cols then [] else cons (lm4_cell0 kind 0 j koff) (lm4_genvec_go kind (j + 1) cols koff)
lm4_genvec kind cols koff = lm4_genvec_go kind 0 cols koff
lm4_initrow kind i j cols koff = if j >= cols then []
  else cons (cons (lm4_cell0 kind i j koff) (cons 0 (cons 0 []))) (lm4_initrow kind i (j + 1) cols koff)
lm4_initmat_go kind i rows cols koff = if i >= rows then []
  else cons (lm4_initrow kind i 0 cols koff) (lm4_initmat_go kind (i + 1) rows cols koff)
lm4_initmat kind rows cols koff = lm4_initmat_go kind 0 rows cols koff
lm4_throw crow = if crow == [] then [] else cons (head (head crow)) (lm4_throw (tail crow))
lm4_thmat cm = if cm == [] then [] else cons (lm4_throw (head cm)) (lm4_thmat (tail cm))

-- ===== TRAINED embeddings: E[vsize][d] of Adam cells, row id init kind=id+1 (== LM2 frozen) =====
lm4_emb_initrow id d = lm4_initrow (id + 1) 0 0 d 0
lm4_emb_initmat_go i vsize d = if i >= vsize then [] else cons (lm4_emb_initrow i d) (lm4_emb_initmat_go (i + 1) vsize d)
lm4_emb_initmat vsize d = lm4_emb_initmat_go 0 vsize d
lm4_emb_gather emb id = lm4_nth emb id
lm4_ctx_vec emb ctx = if ctx == [] then [] else lm4_app (lm4_emb_gather emb (head ctx)) (lm4_ctx_vec emb (tail ctx))
lm4_onehot_go k i v = if i >= v then [] else cons (if i == k then 16777216 else 0) (lm4_onehot_go k (i + 1) v)
lm4_onehot k v = lm4_onehot_go k 0 v

-- ===== embedding-gradient scatter: dx (length C*d) -> dE (vsize x d), repeats SUM =====
lm4_chunk xs k d = lm4_take d (lm4_drop (k * d) xs)
lm4_zeros_mat rows cols = if rows <= 0 then [] else cons (lm4_zeros cols) (lm4_zeros_mat (rows - 1) cols)
lm4_addrow_go mat idx vec i = if mat == [] then []
  else cons (if i == idx then lm4_vadd (head mat) vec else head mat) (lm4_addrow_go (tail mat) idx vec (i + 1))
lm4_addrow_at mat idx vec = lm4_addrow_go mat idx vec 0
lm4_scatter dEmb ctx dx d k = if ctx == [] then dEmb
  else let ch = lm4_chunk dx k d in
       let nd = lm4_addrow_at dEmb (head ctx) ch in
       lm4_scatter nd (tail ctx) dx d (k + 1)

-- ===== cross-entropy core (rung 15): fixed-point ln + softmax + CE loss + CE grad =====
-- Ported bit-for-bit from the proven sm_list kernel (validates vs /tmp/sm_golden.out). s (=S)
-- and s2 (=2S) are threaded as RUNTIME values (array-cell origin in main) -- a large int literal
-- in COMPARISON-operand position fails to assemble. The softmax/cegrad path is s-FREE (16777216
-- only in multiply/divide operand position); only the LOSS path (celoss -> fxln) carries s. ln
-- range-reduction uses mutual-recursion pairs to dodge the self-loop cross-dep-arg miscompile.
ln_up_a m k s = if m >= s then k else ln_up_b (m + m) (k - 1) s
ln_up_b m k s = if m >= s then k else ln_up_a (m + m) (k - 1) s
ln_upm_a m s = if m >= s then m else ln_upm_b (m + m) s
ln_upm_b m s = if m >= s then m else ln_upm_a (m + m) s
ln_dn_a m k s2 = if m < s2 then k else ln_dn_b (m / 2) (k + 1) s2
ln_dn_b m k s2 = if m < s2 then k else ln_dn_a (m / 2) (k + 1) s2
ln_dnm_a m s2 = if m < s2 then m else ln_dnm_b (m / 2) s2
ln_dnm_b m s2 = if m < s2 then m else ln_dnm_a (m / 2) s2
ln_mant m =
  let num = (m - 16777216) * 16777216 in
  let den = m + 16777216 in
  let t = num / den in
  let t2 = (t * t) / 16777216 in
  let a0 = t in
  let tp3 = (t * t2) / 16777216 in
  let a1 = a0 + tp3 / 3 in
  let tp5 = (tp3 * t2) / 16777216 in
  let a2 = a1 + tp5 / 5 in
  let tp7 = (tp5 * t2) / 16777216 in
  let a3 = a2 + tp7 / 7 in
  let tp9 = (tp7 * t2) / 16777216 in
  let a4 = a3 + tp9 / 9 in
  let tp11 = (tp9 * t2) / 16777216 in
  let a5 = a4 + tp11 / 11 in
  let tp13 = (tp11 * t2) / 16777216 in
  let a6 = a5 + tp13 / 13 in
  a6 + a6
fxln x s =
  if x < 1 then 0
  else
    let s2 = s + s in
    let k0 = ln_up_a x 0 s in
    let m0 = ln_upm_a x s in
    let k1 = ln_dn_a m0 k0 s2 in
    let m1 = ln_dnm_a m0 s2 in
    k1 * 11629080 + ln_mant m1
l_vmax_go xs m = if xs == [] then m else let v = head xs in if v > m then l_vmax_go (tail xs) v else l_vmax_go (tail xs) m
l_vmax xs = l_vmax_go (tail xs) (head xs)
l_exps xs m = if xs == [] then [] else cons (bx4_fxexp (head xs - m)) (l_exps (tail xs) m)
l_vsum xs = if xs == [] then 0 else (head xs) + l_vsum (tail xs)
l_smnorm es z = if es == [] then [] else cons ((head es * 16777216) / z) (l_smnorm (tail es) z)
l_softmax xs = let m = l_vmax xs in let es = l_exps xs m in let z = l_vsum es in l_smnorm es z
l_nth xs i = if i == 0 then head xs else l_nth (tail xs) (i - 1)
l_celoss xs tgt s = let m = l_vmax xs in let es = l_exps xs m in let z = l_vsum es in m + (fxln z s) - (l_nth xs tgt)
l_cegrad_go sm i tgt =
  if sm == [] then []
  else
    let ind = if i == tgt then 1 else 0 in
    let oh = ind * 16777216 in
    cons ((head sm) - oh) (l_cegrad_go (tail sm) (i + 1) tgt)
l_cegrad xs tgt = l_cegrad_go (l_softmax xs) 0 tgt

-- ===== rung-16 single-head self-attention: forward + backward (VALIDATED bit-exact) =====
-- Grafted verbatim from /tmp/rung16_attn.rail (fwd) + /tmp/rung16_attn_bwd.rail (bwd, 75/75).
-- Shared softmax (l_softmax/l_vmax/l_exps/l_vsum/l_smnorm) reuses the CE core above (identical).
-- Bare-named helpers below do NOT collide with lm4_*/l_* (verified). Accumulation loops that
-- permute/cross-use args are MUTUAL-RECURSION PAIRS to dodge the self-loop miscompile.
fxm a b = (a * b) / 16777216
dot_go a b acc = if a == [] then acc else dot_go (tail a) (tail b) (acc + (head a) * (head b))
fx_dot a b = (dot_go a b 0) / 16777216
ptdot_go a b acc = if a == [] then acc else ptdot_go (tail a) (tail b) (acc + fxm (head a) (head b))
ptdot a b = ptdot_go a b 0
matvec W x = if W == [] then [] else cons (fx_dot (head W) x) (matvec (tail W) x)
project W xs = if xs == [] then [] else cons (matvec W (head xs)) (project W (tail xs))
nth_l xs i = if i == 0 then head xs else nth_l (tail xs) (i - 1)
len_l xs = if xs == [] then 0 else 1 + len_l (tail xs)
zeros n = if n == 0 then [] else cons 0 (zeros (n - 1))
vadd a b = if a == [] then [] else cons ((head a) + (head b)) (vadd (tail a) (tail b))
scalevec w v = if v == [] then [] else cons (fxm w (head v)) (scalevec w (tail v))
vscale_acc acc w v = if v == [] then [] else cons ((head acc) + fxm w (head v)) (vscale_acc (tail acc) w (tail v))
vscale_add acc w v = if v == [] then [] else cons ((head acc) + (w * (head v)) / 16777216) (vscale_add (tail acc) w (tail v))
madd_go A B = if A == [] then [] else cons (vadd (head A) (head B)) (madd_go (tail A) (tail B))
madd A B = madd_go A B
zmat r c = if r == 0 then [] else cons (zeros c) (zmat (r - 1) c)
scores_row qi K isd = if K == [] then [] else cons (((fx_dot qi (head K)) * isd) / 16777216) (scores_row qi (tail K) isd)
probs_go Q K isd = if Q == [] then [] else cons (l_softmax (scores_row (head Q) K isd)) (probs_go (tail Q) K isd)
wsum_go attn V acc = if attn == [] then acc else wsum_go (tail attn) (tail V) (vscale_add acc (head attn) (head V))
attn_out_row qi K V isd = let sc = scores_row qi K isd in let aw = l_softmax sc in let dk = len_l (head V) in wsum_go aw V (zeros dk)
attn_all_go Q K V isd = if Q == [] then [] else cons (attn_out_row (head Q) K V isd) (attn_all_go (tail Q) K V isd)
attention Wq Wk Wv xs isd = let Q = project Wq xs in let K = project Wk xs in let V = project Wv xs in attn_all_go Q K V isd
dvcol_a P dO j acc = if P == [] then acc else dvcol_b (tail P) (tail dO) j (vscale_acc acc (nth_l (head P) j) (head dO))
dvcol_b P dO j acc = if P == [] then acc else dvcol_a (tail P) (tail dO) j (vscale_acc acc (nth_l (head P) j) (head dO))
dv_all_go P dO j T dk = if j == T then [] else cons (dvcol_a P dO j (zeros dk)) (dv_all_go P dO (j + 1) T dk)
dv_all P dO dk = dv_all_go P dO 0 (len_l P) dk
dprow_go dOi V = if V == [] then [] else cons (ptdot dOi (head V)) (dprow_go dOi (tail V))
dp_all_go dO V = if dO == [] then [] else cons (dprow_go (head dO) V) (dp_all_go (tail dO) V)
dp_all dO V = dp_all_go dO V
ddot_row_go Pi dPi rd isd = if Pi == [] then [] else
  let ds = fxm (head Pi) ((head dPi) - rd) in
  cons (fxm ds isd) (ddot_row_go (tail Pi) (tail dPi) rd isd)
ddot_row Pi dPi isd = let rd = ptdot Pi dPi in ddot_row_go Pi dPi rd isd
dqrow_a dd K acc = if dd == [] then acc else dqrow_b (tail dd) (tail K) (vscale_acc acc (head dd) (head K))
dqrow_b dd K acc = if dd == [] then acc else dqrow_a (tail dd) (tail K) (vscale_acc acc (head dd) (head K))
dkcontrib_go dd qi = if dd == [] then [] else cons (scalevec (head dd) qi) (dkcontrib_go (tail dd) qi)
dkcontrib dd qi = dkcontrib_go dd qi
outer_go u x = if u == [] then [] else cons (scalevec (head u) x) (outer_go (tail u) x)
outer u x = outer_go u x
tmv_a dU W acc = if dU == [] then acc else tmv_b (tail dU) (tail W) (vscale_acc acc (head dU) (head W))
tmv_b dU W acc = if dU == [] then acc else tmv_a (tail dU) (tail W) (vscale_acc acc (head dU) (head W))
dq_all_go P dP Q K isd =
  if P == [] then []
  else
    let dd = ddot_row (head P) (head dP) isd in
    let dkk = len_l (head Q) in
    cons (dqrow_a dd K (zeros dkk)) (dq_all_go (tail P) (tail dP) (tail Q) K isd)
dq_all P dP Q K isd = dq_all_go P dP Q K isd
dk_fold_a P dP Q isd acc = if P == [] then acc else
  let dd = ddot_row (head P) (head dP) isd in
  dk_fold_b (tail P) (tail dP) (tail Q) isd (madd acc (dkcontrib dd (head Q)))
dk_fold_b P dP Q isd acc = if P == [] then acc else
  let dd = ddot_row (head P) (head dP) isd in
  dk_fold_a (tail P) (tail dP) (tail Q) isd (madd acc (dkcontrib dd (head Q)))
dw_fold_a dU xs acc = if dU == [] then acc else dw_fold_b (tail dU) (tail xs) (madd acc (outer (head dU) (head xs)))
dw_fold_b dU xs acc = if dU == [] then acc else dw_fold_a (tail dU) (tail xs) (madd acc (outer (head dU) (head xs)))
dx_all_go dQ dKg dV Wq Wk Wv d =
  if dQ == [] then []
  else
    let a = tmv_a (head dQ) Wq (zeros d) in
    let b = tmv_a (head dKg) Wk a in
    let c = tmv_a (head dV) Wv b in
    cons c (dx_all_go (tail dQ) (tail dKg) (tail dV) Wq Wk Wv d)
dx_all dQ dKg dV Wq Wk Wv d = dx_all_go dQ dKg dV Wq Wk Wv d
attn_bwd Wq Wk Wv xs isd dOut =
  let Q = project Wq xs in
  let K = project Wk xs in
  let V = project Wv xs in
  let T = len_l xs in
  let d = len_l (head xs) in
  let dk = len_l (head V) in
  let P = probs_go Q K isd in
  let dP = dp_all dOut V in
  let dV = dv_all P dOut dk in
  let dQ = dq_all P dP Q K isd in
  let dKg = dk_fold_a P dP Q isd (zmat T (len_l (head K))) in
  let dWq = dw_fold_a dQ xs (zmat (len_l (head Q)) d) in
  let dWk = dw_fold_a dKg xs (zmat (len_l (head K)) d) in
  let dWv = dw_fold_a dV xs (zmat dk d) in
  let dX = dx_all dQ dKg dV Wq Wk Wv d in
  cons dWq (cons dWk (cons dWv (cons dX [])))

-- ===== lm5 glue: ctx -> emb rows (list, not concat); flatten rows -> vec; reshape vec -> rows =====
lm5_ctx_rows emb ctx = if ctx == [] then [] else cons (lm4_emb_gather emb (head ctx)) (lm5_ctx_rows emb (tail ctx))
lm5_flatten rows = if rows == [] then [] else lm4_app (head rows) (lm5_flatten (tail rows))
lm5_reshape xs d = if xs == [] then [] else cons (lm4_take d xs) (lm5_reshape (lm4_drop d xs) d)
lm5_qkv_init kind d = lm4_initmat kind d d 0

-- ===== forward (emb rows -> attention -> concat -> MLP) + CE loss + reverse-mode gradients =====
-- Forward is identical to rung 14; argmax(z2) = argmax(softmax z2) so greedy decode is unchanged.
-- Loss switches MSE -> cross-entropy; the upstream gradient switches dz2 = z2 - onehot  ->
-- dz2 = softmax(z2) - onehot = l_cegrad z2 tgt (bounded in [-S,S], so no clip needed on dz2;
-- the deeper dx still gets lm4_clipg in Adam). Everything downstream of dz2 is byte-identical.
lm4_forward w1 w2 wq wk wv rows isd = lm4_matvec w2 (lm4_geluv (lm4_matvec w1 (lm5_flatten (attention wq wk wv rows isd))))
lm4_celoss_fwd w1 w2 wq wk wv rows isd tgt s = l_celoss (lm4_forward w1 w2 wq wk wv rows isd) tgt s
lm4_grads w1 w2 wq wk wv rows isd tgt hidden indim d =
  let att = attention wq wk wv rows isd in
  let x = lm5_flatten att in
  let z1 = lm4_matvec w1 x in
  let h1 = lm4_geluv z1 in
  let z2 = lm4_matvec w2 h1 in
  let dz2 = l_cegrad z2 tgt in
  let dW2 = lm4_outer dz2 h1 in
  let dh1 = lm4_matvec_t w2 dz2 hidden in
  let dz1 = lm4_dz1 z1 dh1 in
  let dW1 = lm4_outer dz1 x in
  let dx = lm4_matvec_t w1 dz1 indim in
  let dOut = lm5_reshape dx d in
  let ab = attn_bwd wq wk wv rows isd dOut in
  let dWq = lm4_nth ab 0 in
  let dWk = lm4_nth ab 1 in
  let dWv = lm4_nth ab 2 in
  let dxe = lm5_flatten (lm4_nth ab 3) in
  cons dW1 (cons dW2 (cons dWq (cons dWk (cons dWv (cons dxe [])))))

-- ===== gradient clipping (prevents the g*g overflow in Adam's v-update) =====
-- The embedding gradient dx = W1^T . dz1 is the largest (two matmuls deep); squaring it in
-- g2=(g*g)/S overflows int63 (g ~ 1e11 fixed -> g*g ~ 1e22 >> 2^62) -> garbage Adam step ->
-- divergence cascade. Cap each component to +/-2^30 (cap=16777216*64, arithmetic-operand so no
-- big-literal codegen trap): g*g <= 2^60 < 2^62 (4x margin). Bit-exact integer clamp.
lm4_clipg g = let cap = 16777216 * 64 in
  if g > cap then cap else (if g < (0 - cap) then (0 - cap) else g)

-- ===== exact-integer Adam (incremental bias correction passed in) =====
lm4_adam th m v g beta1 beta2 lr eps bc1 bc2 =
  let m2 = ((beta1 * m) / 16777216) + (((16777216 - beta1) * g) / 16777216) in
  let g2 = (g * g) / 16777216 in
  let v2 = ((beta2 * v) / 16777216) + (((16777216 - beta2) * g2) / 16777216) in
  let mhat = (m2 * 16777216) / bc1 in
  let vhat = (v2 * 16777216) / bc2 in
  let denom = (bx4_fxsqrt vhat) + eps in
  let step = (lr * mhat) / denom in
  cons (th - step) (cons m2 (cons v2 []))
lm4_updcell cell g beta1 beta2 lr eps bc1 bc2 =
  lm4_adam (head cell) (head (tail cell)) (head (tail (tail cell))) (lm4_clipg g) beta1 beta2 lr eps bc1 bc2
lm4_updrow crow grow beta1 beta2 lr eps bc1 bc2 =
  if crow == [] then []
  else cons (lm4_updcell (head crow) (head grow) beta1 beta2 lr eps bc1 bc2) (lm4_updrow (tail crow) (tail grow) beta1 beta2 lr eps bc1 bc2)
lm4_updmat cm gm beta1 beta2 lr eps bc1 bc2 =
  if cm == [] then []
  else cons (lm4_updrow (head cm) (head gm) beta1 beta2 lr eps bc1 bc2) (lm4_updmat (tail cm) (tail gm) beta1 beta2 lr eps bc1 bc2)

-- ===== canonical serialization (for the checkpoint commitments) =====
-- O(N) canon: build a flat piece-list then a SINGLE cat (right-nested cat re-measured
-- the growing suffix at every level -> O(N^2), ~180 calls/run dominated wall time).
-- Output is byte-identical (trailing " " per element, trailing ";" per row) -> same SHA256.
lm4_canon_row_p xs = if xs == [] then [] else cons (show (head xs)) (cons " " (lm4_canon_row_p (tail xs)))
lm4_canon_row xs = cat (lm4_canon_row_p xs)
lm4_canon_mat_p m = if m == [] then [] else cons (lm4_canon_row (head m)) (cons ";" (lm4_canon_mat_p (tail m)))
lm4_canon_mat m = cat (lm4_canon_mat_p m)

-- ===== dataset total loss (for okProg + per-checkpoint loss) =====
lm4_dsloss_go pairs w1 w2 emb wq wk wv isd v s acc = if pairs == [] then acc
  else let pr = head pairs in let (ctx, tgt) = pr in
       lm4_dsloss_go (tail pairs) w1 w2 emb wq wk wv isd v s (acc + (lm4_celoss_fwd w1 w2 wq wk wv (lm5_ctx_rows emb ctx) isd tgt s))
lm4_dsloss pairs w1 w2 emb wq wk wv isd v s = lm4_dsloss_go pairs w1 w2 emb wq wk wv isd v s 0

-- ===== training: one exact-integer step (updates W1, W2 AND E) =====
lm4_step w1c w2c ec wqc wkc wvc pair d hidden v indim isd beta1 beta2 lr eps pow1 pow2 =
  let (ctx, tgt) = pair in
  let emb = lm4_thmat ec in
  let rows = lm5_ctx_rows emb ctx in
  let w1 = lm4_thmat w1c in
  let w2 = lm4_thmat w2c in
  let wq = lm4_thmat wqc in
  let wk = lm4_thmat wkc in
  let wv = lm4_thmat wvc in
  let gs = lm4_grads w1 w2 wq wk wv rows isd tgt hidden indim d in
  let dW1 = lm4_nth gs 0 in
  let dW2 = lm4_nth gs 1 in
  let dWq = lm4_nth gs 2 in
  let dWk = lm4_nth gs 3 in
  let dWv = lm4_nth gs 4 in
  let dxe = lm4_nth gs 5 in
  let dEmb = lm4_scatter (lm4_zeros_mat v d) ctx dxe d 0 in
  let np1 = (pow1 * beta1) / 16777216 in
  let np2 = (pow2 * beta2) / 16777216 in
  let bc1 = 16777216 - np1 in
  let bc2 = 16777216 - np2 in
  let nw1 = lm4_updmat w1c dW1 beta1 beta2 lr eps bc1 bc2 in
  let nw2 = lm4_updmat w2c dW2 beta1 beta2 lr eps bc1 bc2 in
  let nwq = lm4_updmat wqc dWq beta1 beta2 lr eps bc1 bc2 in
  let nwk = lm4_updmat wkc dWk beta1 beta2 lr eps bc1 bc2 in
  let nwv = lm4_updmat wvc dWv beta1 beta2 lr eps bc1 bc2 in
  let nec = lm4_updmat ec dEmb beta1 beta2 lr eps bc1 bc2 in
  cons nw1 (cons nw2 (cons nec (cons nwq (cons nwk (cons nwv (cons np1 (cons np2 [])))))))

lm4_epoch w1c w2c ec wqc wkc wvc pairs d hidden v indim isd beta1 beta2 lr eps pow1 pow2 =
  if pairs == [] then cons w1c (cons w2c (cons ec (cons wqc (cons wkc (cons wvc (cons pow1 (cons pow2 [])))))))
  else let r = lm4_step w1c w2c ec wqc wkc wvc (head pairs) d hidden v indim isd beta1 beta2 lr eps pow1 pow2 in
       lm4_epoch (lm4_nth r 0) (lm4_nth r 1) (lm4_nth r 2) (lm4_nth r 3) (lm4_nth r 4) (lm4_nth r 5) (tail pairs) d hidden v indim isd beta1 beta2 lr eps (lm4_nth r 6) (lm4_nth r 7)

-- ===== one signed CHECKPOINT at the post-epoch weights (binds W1, W2 AND E) =====
lm4_ckpt w1c w2c ec wqc wkc wvc pairs d v isd s seed pk prev_hex epoch_i =
  let w1 = lm4_thmat w1c in
  let w2 = lm4_thmat w2c in
  let emb = lm4_thmat ec in
  let wq = lm4_thmat wqc in
  let wk = lm4_thmat wkc in
  let wv = lm4_thmat wvc in
  let loss = lm4_dsloss pairs w1 w2 emb wq wk wv isd v s in
  let w_hex = sha256_hex (cat [lm4_canon_mat w1, ";;", lm4_canon_mat w2, ";;", lm4_canon_mat emb, ";;", lm4_canon_mat wq, ";;", lm4_canon_mat wk, ";;", lm4_canon_mat wv]) in
  let loss_str = show loss in
  let link_str = cat [prev_hex, "|", show epoch_i, "|", w_hex, "|", loss_str] in
  let link_b = sha256 link_str in
  let link_hex = bytes_to_hex link_b 32 in
  let sig = ed25519_sign seed link_b 32 in
  let sig_hex = bytes_to_hex sig 64 in
  let ok = ed25519_verify pk link_b 32 sig in
  let line = cat [show epoch_i, " ", w_hex, " ", loss_str, " ", prev_hex, " ", link_hex, " ", sig_hex] in
  cons link_hex (cons line (cons ok (cons loss [])))

-- ===== checkpoint-cadence attested training: one epoch then one signed checkpoint =====
lm4_chain w1c w2c ec wqc wkc wvc pairs d hidden v indim isd s beta1 beta2 lr eps pow1 pow2 seed pk epochs i prev_hex acc all_ok =
  if i >= epochs then cons all_ok (cons acc (cons prev_hex (cons w1c (cons w2c (cons ec (cons wqc (cons wkc (cons wvc []))))))))
  else
    let e = lm4_epoch w1c w2c ec wqc wkc wvc pairs d hidden v indim isd beta1 beta2 lr eps pow1 pow2 in
    let nw1 = lm4_nth e 0 in
    let nw2 = lm4_nth e 1 in
    let nec = lm4_nth e 2 in
    let nwq = lm4_nth e 3 in
    let nwk = lm4_nth e 4 in
    let nwv = lm4_nth e 5 in
    let np1 = lm4_nth e 6 in
    let np2 = lm4_nth e 7 in
    let ck = lm4_ckpt nw1 nw2 nec nwq nwk nwv pairs d v isd s seed pk prev_hex i in
    let link_hex = lm4_nth ck 0 in
    let line = lm4_nth ck 1 in
    let ok = lm4_nth ck 2 in
    lm4_chain nw1 nw2 nec nwq nwk nwv pairs d hidden v indim isd s beta1 beta2 lr eps np1 np2 seed pk epochs (i + 1) link_hex (cat [acc, line, "\n"]) (all_ok * ok)

-- ===== D0 re-run: re-derive the trajectory + link chain WITHOUT re-signing =====
lm4_link_only w1c w2c ec wqc wkc wvc pairs d v isd s prev_hex epoch_i =
  let w1 = lm4_thmat w1c in
  let w2 = lm4_thmat w2c in
  let emb = lm4_thmat ec in
  let wq = lm4_thmat wqc in
  let wk = lm4_thmat wkc in
  let wv = lm4_thmat wvc in
  let loss = lm4_dsloss pairs w1 w2 emb wq wk wv isd v s in
  let w_hex = sha256_hex (cat [lm4_canon_mat w1, ";;", lm4_canon_mat w2, ";;", lm4_canon_mat emb, ";;", lm4_canon_mat wq, ";;", lm4_canon_mat wk, ";;", lm4_canon_mat wv]) in
  let link_str = cat [prev_hex, "|", show epoch_i, "|", w_hex, "|", show loss] in
  bytes_to_hex (sha256 link_str) 32
lm4_chain_d0 w1c w2c ec wqc wkc wvc pairs d hidden v indim isd s beta1 beta2 lr eps pow1 pow2 epochs i prev_hex =
  if i >= epochs then cons prev_hex (cons w1c (cons w2c (cons ec (cons wqc (cons wkc (cons wvc []))))))
  else
    let e = lm4_epoch w1c w2c ec wqc wkc wvc pairs d hidden v indim isd beta1 beta2 lr eps pow1 pow2 in
    let nw1 = lm4_nth e 0 in
    let nw2 = lm4_nth e 1 in
    let nec = lm4_nth e 2 in
    let nwq = lm4_nth e 3 in
    let nwk = lm4_nth e 4 in
    let nwv = lm4_nth e 5 in
    let np1 = lm4_nth e 6 in
    let np2 = lm4_nth e 7 in
    let link_hex = lm4_link_only nw1 nw2 nec nwq nwk nwv pairs d v isd s prev_hex i in
    lm4_chain_d0 nw1 nw2 nec nwq nwk nwv pairs d hidden v indim isd s beta1 beta2 lr eps np1 np2 epochs (i + 1) link_hex

-- ===== greedy decode -> per-task prompt completion -> emit MODEL completions =====
lm4_argmax_go xs i best bi = if xs == [] then bi
  else if (head xs) > best then lm4_argmax_go (tail xs) (i + 1) (head xs) i
       else lm4_argmax_go (tail xs) (i + 1) best bi
lm4_argmax xs = lm4_argmax_go (tail xs) 1 (head xs) 0
lm4_gen w1 w2 emb wq wk wv isd ctx c g acc = if g <= 0 then acc
  else let nid = lm4_argmax (lm4_forward w1 w2 wq wk wv (lm5_ctx_rows emb ctx) isd) in
       lm4_gen w1 w2 emb wq wk wv isd (tail (lm4_snoc ctx nid)) c (g - 1) (lm4_snoc acc nid)
lm4_lastc ids c = let n = lm4_len ids in if n <= c then ids else lm4_lastc (tail ids) c
lm4_finish full =
  let k = str_find " in 0" full in
  if k < 0 then full else cat [str_sub full 0 (k + 5), "\n"]
lm4_complete w1 w2 emb wq wk wv isd vocab c prompt gcap =
  let pids = lm4_tokens prompt vocab in
  let seedp = lm4_lastc pids c in
  let gen_ids = lm4_gen w1 w2 emb wq wk wv isd seedp c gcap [] in
  lm4_finish (cat [prompt, lm4_decode gen_ids vocab])
lm4_emit w1 w2 emb wq wk wv isd vocab c id prompt gcap =
  write_file (cat ["/tmp/lm_completions/", id, ".rail"]) (lm4_complete w1 w2 emb wq wk wv isd vocab c prompt gcap)
lm4_emit_all w1 w2 emb wq wk wv isd vocab c ids prompt gcap =
  if ids == [] then 0
  else let _ = lm4_emit w1 w2 emb wq wk wv isd vocab c (head ids) prompt gcap in
       lm4_emit_all w1 w2 emb wq wk wv isd vocab c (tail ids) prompt gcap

main =
  let _ = shell "rm -f /tmp/lm5_chain.txt" in
  let _ = shell "rm -f /tmp/lm_completions/*.rail" in
  let _ = shell "mkdir -p /tmp/lm_completions" in
  let d = 8 in
  let hidden = 32 in
  let cwin = 8 in
  let epochs = 100 in
  let gcap = 48 in
  let beta1 = 15099494 in
  let beta2 = 16760439 in
  let lr = 209715 in
  let eps = 16777 in
  let sc = arr_new 1 0 in
  let _ = arr_set sc 0 16777216 in
  let s = arr_get sc 0 in
  let isdc = arr_new 1 0 in
  let _ = arr_set isdc 0 5931642 in
  let isd = arr_get isdc 0 in

  -- PIN: provenance is a function of the LM5 corpus content hash; isd = round(S/sqrt(d=8))
  let corpus = read_file "tools/bitexact/lm5_corpus.txt" in
  let chash = sha256_hex corpus in
  let vocab = lm4_vocab corpus in
  let vsize = lm4_len (chars vocab) in
  let ids = lm4_tokens corpus vocab in
  let pairs = lm4_pairs ids cwin in
  let npairs = lm4_len pairs in
  let indim = cwin * d in
  let w1c0 = lm4_initmat 0 hidden indim 0 in
  let w2c0 = lm4_initmat 1 vsize hidden 0 in
  let ec0 = lm4_emb_initmat vsize d in
  let wqc0 = lm5_qkv_init 30 d in
  let wkc0 = lm5_qkv_init 31 d in
  let wvc0 = lm5_qkv_init 32 d in

  -- EPHEMERAL LOCAL DEV KEY + LOCAL genesis (never a prod sign surface / live pulse)
  let seed = sha256 "lm5.local.ephemeral.dev.seed.v1" in
  let pk = ed25519_pk_from_sk seed in
  let pk_hex = bytes_to_hex pk 32 in
  let genesis_hex = sha256_hex "LM5.LOCAL.BEACON.GENESIS.dev" in

  -- ===== the attested training run (checkpoint-cadence; trains W1, W2, E, Wq, Wk, Wv) =====
  let res = lm4_chain w1c0 w2c0 ec0 wqc0 wkc0 wvc0 pairs d hidden vsize indim isd s beta1 beta2 lr eps 16777216 16777216 seed pk epochs 0 genesis_hex "" 1 in
  let all_ok = lm4_nth res 0 in
  let body = lm4_nth res 1 in
  let head_link = lm4_nth res 2 in
  let fw1c = lm4_nth res 3 in
  let fw2c = lm4_nth res 4 in
  let fec = lm4_nth res 5 in
  let fwqc = lm4_nth res 6 in
  let fwkc = lm4_nth res 7 in
  let fwvc = lm4_nth res 8 in
  let fw1 = lm4_thmat fw1c in
  let fw2 = lm4_thmat fw2c in
  let femb = lm4_thmat fec in
  let fwq = lm4_thmat fwqc in
  let fwk = lm4_thmat fwkc in
  let fwv = lm4_thmat fwvc in
  let emb0 = lm4_thmat ec0 in

  -- dataset-loss descent over the WHOLE corpus (initial vs final weights)
  let ds0 = lm4_dsloss pairs (lm4_thmat w1c0) (lm4_thmat w2c0) emb0 (lm4_thmat wqc0) (lm4_thmat wkc0) (lm4_thmat wvc0) isd vsize s in
  let dsK = lm4_dsloss pairs fw1 fw2 femb fwq fwk fwv isd vsize s in

  -- persist the signed ledger (header carries everything the re-verifier needs)
  let header = cat ["# LM5v1 ", pk_hex, " ", genesis_hex, " ", show epochs, " ", chash,
                    " d=", show d, " hidden=", show hidden, " vsize=", show vsize, " cwin=", show cwin,
                    " beta1=", show beta1, " beta2=", show beta2, " lr=", show lr, " eps=", show eps, " isd=", show isd, "\n"] in
  let _ = write_file "/tmp/lm5_chain.txt" (cat [header, body]) in

  -- ===== user-facing gate: the MODEL's OWN completions, scored by the LM0 oracle =====
  let pr = "main = let _ = print (show (" in
  let ids_list = ["b1_1","b1_2","b1_3","b1_4","b1_5","b2_1","b2_2","b2_3","b2_4","b2_5","b3_1","b3_2","b3_3","b3_4","b3_5","b4_1","b4_2","b4_3","b4_4","b4_5","b5_1","b5_2","b5_3","b5_4","b5_5","b6_1","b6_2","b6_3","b6_4","b6_5"] in
  let _ = lm4_emit_all fw1 fw2 femb fwq fwk fwv isd vocab cwin ids_list pr gcap in
  let sample = lm4_complete fw1 fw2 femb fwq fwk fwv isd vocab cwin pr gcap in
  let _ = shell "./rail_native --out-prefix /tmp/lm5_lm0_bin tools/bitexact/lm0_compile_eval.rail > /tmp/lm5_lm0_build.log 2>&1" in
  let _ = shell "/tmp/lm5_lm0_bin > /tmp/lm5_lm0_run.log 2>&1" in
  let lm0raw = read_file "/tmp/lm0_eval.txt" in
  let model_pct = if lm0raw == "" then 0 - 1 else lm4_hd_int lm0raw in

  -- D0: re-run the WHOLE training + link chain (NO re-sign) -> head must be bit-identical
  let res2 = lm4_chain_d0 w1c0 w2c0 ec0 wqc0 wkc0 wvc0 pairs d hidden vsize indim isd s beta1 beta2 lr eps 16777216 16777216 epochs 0 genesis_hex in
  let head2 = lm4_nth res2 0 in
  let dsK2 = lm4_dsloss pairs (lm4_thmat (lm4_nth res2 1)) (lm4_thmat (lm4_nth res2 2)) (lm4_thmat (lm4_nth res2 3)) (lm4_thmat (lm4_nth res2 4)) (lm4_thmat (lm4_nth res2 5)) (lm4_thmat (lm4_nth res2 6)) isd vsize s in
  let d0 = if head_link == head2 then (if dsK == dsK2 then 0 else 1) else 1 in

  -- falsification probes (prove the verifier genuinely discriminates)
  let pmsg = sha256 "lm5.tamper.probe" in
  let psig = ed25519_sign seed pmsg 32 in
  let okGood = ed25519_verify pk pmsg 32 psig in
  let tsig = arr_new 64 0 in
  let _ = sha_copy_bytes psig tsig 0 0 64 in
  let _ = arr_set tsig 5 (bit_xor (arr_get tsig 5) 1) in
  let okBad = ed25519_verify pk pmsg 32 tsig in
  let seed2 = sha256 "lm5.other.key" in
  let wsig = ed25519_sign seed2 pmsg 32 in
  let okW = ed25519_verify pk pmsg 32 wsig in

  -- Gates
  let okSigs = if all_ok == 1 then 1 else 0 in
  let okProg = if dsK < ds0 then 1 else 0 in
  let okModel = if model_pct >= 50 then 1 else 0 in
  let okTamper = if okGood == 1 then (if okBad == 0 then 1 else 0) else 0 in
  let okWrongKey = if okW == 0 then 1 else 0 in
  let okD0 = if d0 == 0 then 1 else 0 in
  let all = okSigs * okProg * okModel * okTamper * okWrongKey * okD0 in

  let _ = print (cat ["LM5 attested bit-exact char-LM (SINGLE-HEAD SELF-ATTENTION + trained embeddings): vocab=", show vsize, " d=", show d, " hidden=", show hidden, " ctx=", show cwin, " indim=", show indim, " pairs=", show npairs, " epochs=", show epochs, " isd=", show isd, " (exact-integer F=24)"]) in
  let _ = print (cat ["LM5 corpus pin: SHA-256 ", chash]) in
  let _ = print (cat ["LM5 USER-FACING GATE: MODEL's own completions compile% = ", show model_pct, " (LM0 compile-as-oracle; >=50 required)"]) in
  let _ = print (cat ["LM5 sample MODEL completion: ", sample]) in
  let _ = print (cat ["LM5 pubkey=", pk_hex]) in
  let _ = print (cat ["LM5 chain head=", head_link]) in
  let _ = print (cat ["LM5 datasetLoss0=", show ds0, " datasetLossK=", show dsK, " (fixed-point; descent=", show okProg, ")"]) in
  let _ = print (cat ["LM5 D0 (re-run whole training bit-identical)=", show okD0, "  per-ckpt sigs verify=", show okSigs, "  tamper-reject=", show okTamper, "  wrong-key-reject=", show okWrongKey]) in
  let _ = print (cat ["LM5 signed ledger: /tmp/lm5_chain.txt (", show epochs, " checkpoints; w_hex binds W1;;W2;;E;;Wq;;Wk;;Wv)"]) in
  let _ = print (if all == 1
    then "LM5 PASS: bit-exact attested char-LM with SINGLE-HEAD SELF-ATTENTION + TRAINED embeddings that CROSSES the user-facing compile gate; whole run reproduces bit-for-bit (D0) + checkpoint-chained (binds Wq/Wk/Wv/E) + tamper-evident + corpus-pinned"
    else "LM5 FAIL") in
  if all == 1 then 0 else 1
