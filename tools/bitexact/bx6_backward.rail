-- BX6: bit-exact transformer BACKWARD pass (reverse-mode AD) in exact-integer fixed-point.
--
-- BX5 made the forward block bit-exact. Training also needs the BACKWARD pass to reproduce
-- bit-for-bit -- otherwise the gradient (hence every weight update, hence the whole trajectory)
-- diverges across machines/schedules. BX6 routes the FD-verified backward atoms (the P3 net__rgrad
-- family: matvec-layer reverse = outer(grad,x) for dW, W^T*grad for dx, act'(z) .* upstream) through
-- the SAME exact-integer ops, so every gradient integer is a fixed algorithm.
--
-- Target net (the reusable matvec-layer reverse, identical structure to P3 slice-4/5):
--   z1 = W1 . x ;  h1 = gelu(z1) ;  z2 = W2 . h1 ;  L = sum(z2)
-- Reverse:
--   dz2 = 1 (=S) ; dW2 = outer(dz2,h1) ; dh1 = W2^T . dz2 ;
--   dz1 = gelu'(z1) .* dh1 ; dW1 = outer(dz1,x) ; dx = W1^T . dz1
-- The genuinely-new exact atom is gelu' (bx4_gelu_grad in bx_fixed.rail) -- a fixed-point
-- transcendental DERIVATIVE. Everything else is exact-integer matvec/outer/elementwise.
--
-- Gates:
--   D0  run the backward twice -> bit-identical (gradient-sum equality).
--   D1  reduction order-independence: W1^T.dz1 left-fold == right-fold (integer-associative).
--   GC  correctness: analytic gradient vs CENTRAL finite-difference of the (fixed-point) loss,
--       aggregate relative error -- proves the integer backward computes the RIGHT gradient.
--   D3  a Python big-int re-impl reproduces every gradient integer bit-for-bit (bx6_foreign_check.py).
--
-- Fixed-point F=24, S=2^24. Weights+input generated by the same integer formula as BX5.

import "tools/bitexact/bx_fixed.rail"

-- ===== deterministic fixed-point data generator (same formula as BX5) =====
bx6_imod a b = a - (a / b) * b
bx6_cell kind i j = (bx6_imod (kind * 101 + i * 5 + j * 3 + 7) 13 - 6) * 1398101
bx6_genrow kind i j cols = if j >= cols then [] else cons (bx6_cell kind i j) (bx6_genrow kind i (j + 1) cols)
bx6_genmat kind i rows cols = if i >= rows then [] else cons (bx6_genrow kind i 0 cols) (bx6_genmat kind (i + 1) rows cols)

-- ===== exact integer vector / matrix ops (one truncation per output element) =====
bx6_dot_go u v acc = if u == [] then acc else bx6_dot_go (tail u) (tail v) (acc + (head u) * (head v))
bx6_dot u v = (bx6_dot_go u v 0) / 16777216
bx6_matvec rows v = if rows == [] then [] else cons (bx6_dot (head rows) v) (bx6_matvec (tail rows) v)
bx6_vadd u v = if u == [] then [] else cons ((head u) + (head v)) (bx6_vadd (tail u) (tail v))
bx6_vsum xs = if xs == [] then 0 else (head xs) + bx6_vsum (tail xs)
bx6_zeros d = if d < 1 then [] else cons 0 (bx6_zeros (d - 1))
bx6_rep n val = if n < 1 then [] else cons val (bx6_rep (n - 1) val)
bx6_divS xs = if xs == [] then [] else cons ((head xs) / 16777216) (bx6_divS (tail xs))

-- matvec-transpose: (W^T v)[j] = sum_i W[i][j] v[i].  Accumulate raw scaled rows (no truncation
-- inside the reduction), divide by S once per output element at the end.
bx6_vscale_raw s row = if row == [] then [] else cons (s * (head row)) (bx6_vscale_raw s (tail row))
bx6_mtv_go rows v acc = if rows == [] then acc else bx6_mtv_go (tail rows) (tail v) (bx6_vadd acc (bx6_vscale_raw (head v) (head rows)))
bx6_matvec_t rows v cols = bx6_divS (bx6_mtv_go rows v (bx6_zeros cols))
-- right-fold variant for D1 (different summation ORDER, must give identical integers)
bx6_mtv_rev_go rows v cols = if rows == [] then bx6_zeros cols
  else bx6_vadd (bx6_vscale_raw (head v) (head rows)) (bx6_mtv_rev_go (tail rows) (tail v) cols)
bx6_matvec_t_rev rows v cols = bx6_divS (bx6_mtv_rev_go rows v cols)

-- outer product: (u (x) w)[i][j] = u[i] w[j] / S
bx6_outer_row ui w = if w == [] then [] else cons ((ui * (head w)) / 16777216) (bx6_outer_row ui (tail w))
bx6_outer u w = if u == [] then [] else cons (bx6_outer_row (head u) w) (bx6_outer (tail u) w)

-- elementwise activation
bx6_geluv xs = if xs == [] then [] else cons (bx4_gelu (head xs)) (bx6_geluv (tail xs))
-- dz1 = gelu'(z1) .* dh1  (elementwise, one truncation per element)
bx6_dz1 z1 dh1 = if z1 == [] then [] else cons (((bx4_gelu_grad (head z1)) * (head dh1)) / 16777216) (bx6_dz1 (tail z1) (tail dh1))

-- ===== forward + scalar loss =====
bx6_loss w1 w2 x = bx6_vsum (bx6_matvec w2 (bx6_geluv (bx6_matvec w1 x)))

-- ===== reverse-mode gradients (exact-integer) =====
-- shared upstream cotangent at the hidden pre-activation
bx6_compute_dz1 w1 w2 x d hidden =
  let z1 = bx6_matvec w1 x in
  let dz2 = bx6_rep d 16777216 in
  let dh1 = bx6_matvec_t w2 dz2 hidden in
  bx6_dz1 z1 dh1
bx6_grad_dx w1 w2 x d hidden = bx6_matvec_t w1 (bx6_compute_dz1 w1 w2 x d hidden) d
bx6_grad_dx_rev w1 w2 x d hidden = bx6_matvec_t_rev w1 (bx6_compute_dz1 w1 w2 x d hidden) d
bx6_grad_dW1 w1 w2 x d hidden = bx6_outer (bx6_compute_dz1 w1 w2 x d hidden) x
bx6_grad_dW2 w1 w2 x d hidden =
  let z1 = bx6_matvec w1 x in
  let h1 = bx6_geluv z1 in
  let dz2 = bx6_rep d 16777216 in
  bx6_outer dz2 h1

-- ===== gates =====
bx6_msum rows = if rows == [] then 0 else (bx6_vsum (head rows)) + bx6_msum (tail rows)
bx6_gradsum w1 w2 x d hidden = (bx6_vsum (bx6_grad_dx w1 w2 x d hidden)) + (bx6_msum (bx6_grad_dW1 w1 w2 x d hidden)) + (bx6_msum (bx6_grad_dW2 w1 w2 x d hidden))

bx6_listeq a b = if a == [] then (if b == [] then 0 else 1)
  else (if (head a) == (head b) then 0 else 1) + bx6_listeq (tail a) (tail b)

-- central finite-difference gradient check (correctness oracle)
bx6_nth xs i = if i <= 0 then head xs else bx6_nth (tail xs) (i - 1)
bx6_abs n = if n < 0 then 0 - n else n
bx6_addidx xs i delta j = if xs == [] then [] else cons (if i == j then (head xs) + delta else head xs) (bx6_addidx (tail xs) i delta (j + 1))
bx6_fd_coord w1 w2 x i delta =
  let xp = bx6_addidx x i delta 0 in
  let xm = bx6_addidx x i (0 - delta) 0 in
  (bx6_loss w1 w2 xp) - (bx6_loss w1 w2 xm)
bx6_pred_coord dx i delta = ((bx6_nth dx i) * 2 * delta) / 16777216
-- sweep coords, accumulate |pred-act| and |act| -> aggregate relative error (robust to small-grad coords)
bx6_gc_go w1 w2 x dx d delta i sumerr sumact =
  if i >= d then cons sumerr (cons sumact [])
  else
    let act = bx6_fd_coord w1 w2 x i delta in
    let pred = bx6_pred_coord dx i delta in
    bx6_gc_go w1 w2 x dx d delta (i + 1) (sumerr + (bx6_abs (pred - act))) (sumact + (bx6_abs act))

-- D3 dump: dx row, then dW1 rows, then dW2 rows (space-separated integers, one group per line)
bx6_dumprow xs = if xs == [] then "\n" else join "" (cons (show (head xs)) (cons " " (cons (bx6_dumprow (tail xs)) [])))
bx6_dumprows rows = if rows == [] then "" else join "" (cons (bx6_dumprow (head rows)) (cons (bx6_dumprows (tail rows)) []))

main =
  let d = 4 in
  let hidden = 8 in
  let w1 = bx6_genmat 0 0 hidden d in
  let w2 = bx6_genmat 1 0 d hidden in
  let x = bx6_genrow 8 0 0 d in
  let dx = bx6_grad_dx w1 w2 x d hidden in
  let dW1 = bx6_grad_dW1 w1 w2 x d hidden in
  let dW2 = bx6_grad_dW2 w1 w2 x d hidden in
  -- D0: run-twice gradient-sum identical
  let c1 = bx6_gradsum w1 w2 x d hidden in
  let c2 = bx6_gradsum w1 w2 x d hidden in
  let d0 = if c1 == c2 then 0 else 1 in
  -- D1: dx left-fold == right-fold (reduction order-independence)
  let dxr = bx6_grad_dx_rev w1 w2 x d hidden in
  let d1 = bx6_listeq dx dxr in
  -- GC: aggregate FD relative error in 1e-6 units
  let delta = 32767 in
  let gc = bx6_gc_go w1 w2 x dx d delta 0 0 0 in
  let sumerr = head gc in
  let sumact = head (tail gc) in
  let agg = sumerr * 1000000 / (sumact + 1) in
  let gcok = if agg < 50000 then 0 else 1 in
  let _ = print (join "" (cons "BX6 D0 (run-twice backward identical): " (cons (if d0 == 0 then "PASS" else "FAIL") []))) in
  let _ = print (join "" (cons "BX6 D1 (reduction order-independent dx): " (cons (if d1 == 0 then "PASS" else "FAIL") []))) in
  let _ = print (join "" (cons "BX6 grad-check agg rel err (e-6): " (cons (show agg) (cons (if gcok == 0 then "  PASS" else "  FAIL") [])))) in
  let _ = print (join "" (cons "BX6 backward grad-sum: " (cons (show c1) []))) in
  let _ = write_file "/tmp/bx6_dump.txt" (join "" (cons (bx6_dumprow dx) (cons (bx6_dumprows dW1) (cons (bx6_dumprows dW2) [])))) in
  let _ = print (if d0 + d1 + gcok == 0
    then "BX6 PASS: exact-integer backward deterministic (D0) + order-independent (D1) + FD-correct (GC); dump for D3"
    else "BX6 FAIL") in
  0
