-- R1a (1B ladder): exact-integer sin/cos at F=24 -- the main missing transcendental for RoPE.
-- Same fixed-algorithm discipline as bx4_fxexp: a FIXED INTEGER poly + octant reduction, so
-- CPU/GPU/foreign all produce BIT-IDENTICAL output. Coeffs c_i = round(S/i!) (the reciprocal
-- factorials -- literally the bx4_exp_poly family). All divides truncate toward zero.
--
-- Method: reduce theta in [0, 2*pi) to an octant rq in [0, pi/2), fold rq>pi/4 via the cofunction
-- identity to a in [0, pi/4], evaluate sin/cos by Horner in u = a^2, then re-sign by octant.
--
-- Gate (this file): FD vs foreign libm sin/cos over a dense sweep of [0, 2*pi) AND the
-- Pythagorean identity sin^2 + cos^2 == 1 (an algorithm-INDEPENDENT falsifier). D0 (pure-integer
-- determinism) is trivially exact. Once green, bx4_sin/bx4_cos promote into bx_fixed.rail.
--
-- Build: ./rail_native --out-prefix /tmp/r1a tools/bitexact/r1a_exact_trig.rail
-- Run:   /tmp/r1a

import "tools/bitexact/bx_fixed.rail"

foreign sin x -> float
foreign cos x -> float

-- bx4_sin_unit / bx4_cos_unit / bx4_sin / bx4_cos now live in bx_fixed.rail (promoted after
-- this gate proved them). This file remains the R1a FD-vs-libm + Pythagorean gate artifact.

-- ===== FD + identity sweep over [0, 2*pi). maxima carried in float_arr cells (int-only loop). =====
r1_sweep N j step maxs maxc maxp =
  if j >= N then 0
  else
    let theta = (int_to_float j) *. step in
    let thq = bx4_quant theta in
    let s = bx4_back (bx4_sin thq) in
    let c = bx4_back (bx4_cos thq) in
    let rs = sin theta in
    let rc = cos theta in
    let es = bx4_fabs (s -. rs) in
    let ec = bx4_fabs (c -. rc) in
    let ep = bx4_fabs (s *. s +. c *. c -. 1.0) in
    let _ = float_arr_set maxs 0 (if es >. (float_arr_get maxs 0) then es else (float_arr_get maxs 0)) in
    let _ = float_arr_set maxc 0 (if ec >. (float_arr_get maxc 0) then ec else (float_arr_get maxc 0)) in
    let _ = float_arr_set maxp 0 (if ep >. (float_arr_get maxp 0) then ep else (float_arr_get maxp 0)) in
    r1_sweep N (j + 1) step maxs maxc maxp

main =
  let N = 8192 in
  let step = 6.283185307179586 /. (int_to_float N) in
  let maxs = float_arr_new 1 0.0 in
  let maxc = float_arr_new 1 0.0 in
  let maxp = float_arr_new 1 0.0 in
  let _ = r1_sweep N 0 step maxs maxc maxp in
  let es = float_arr_get maxs 0 in
  let ec = float_arr_get maxc 0 in
  let ep = float_arr_get maxp 0 in
  let tol = 0.00002 in
  let ok = if es <. tol then (if ec <. tol then (if ep <. tol then 1 else 0) else 0) else 0 in
  -- spot checks (localize octant-sign bugs)
  let s30 = bx4_back (bx4_sin (bx4_quant 0.5235987755982988)) in   -- sin(pi/6)=0.5
  let cpi = bx4_back (bx4_cos (bx4_quant 3.141592653589793)) in    -- cos(pi)=-1
  let _ = print (cat ["R1a sin/cos  N=", show N,
    "  max|sin-ref|=", show es, "  max|cos-ref|=", show ec, "  max|s^2+c^2-1|=", show ep]) in
  let _ = print (cat ["       spot  sin(pi/6)=", show s30, " (want 0.5)   cos(pi)=", show cpi, " (want -1)"]) in
  let _ = print (if ok == 1
    then "R1a PASS: exact-integer sin/cos reproduce libm within tol over [0,2pi) AND satisfy sin^2+cos^2=1 -- the RoPE transcendental is now a fixed integer algorithm."
    else "R1a FAIL: exact-integer trig diverged from libm or broke the Pythagorean identity -- inspect the max-error line") in
  if ok == 1 then 0 else 1
