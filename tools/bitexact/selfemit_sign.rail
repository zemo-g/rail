-- Seal rung 35: Ed25519-bind the self-emission certificate (which commits the emitted src_hex,
-- the honest fixed-point binary sha, the test-pass count, and the mutation-breaks verdict) onto
-- the emission chain -> the whole self-emission artifact becomes ONE signed, foreign-verifiable record.
-- LOCAL/DEV key only (same ephemeral dev seed as the trainer); never a prod sign surface.
import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"

main =
  let cert = read_file "out/selfemit_cert.txt" in
  let cert_hex = sha256_hex cert in
  let chain = read_file "out/selfemit_chain.txt" in
  let prev_hex = sha256_hex chain in
  let seed = sha256 "lm10.local.ephemeral.dev.seed.v1" in
  let pk = ed25519_pk_from_sk seed in
  let pk_hex = bytes_to_hex pk 32 in
  let link_str = cat [prev_hex, "|SELFEMIT|", cert_hex] in
  let link_b = sha256 link_str in
  let link_hex = bytes_to_hex link_b 32 in
  let sig = ed25519_sign seed link_b 32 in
  let sig_hex = bytes_to_hex sig 64 in
  let ok = ed25519_verify pk link_b 32 sig in
  let rec = cat ["SELFEMIT ", cert_hex, " ", prev_hex, " ", link_hex, " ", sig_hex, "\n"] in
  let _ = write_file "out/selfemit_chain.txt" (cat [chain, rec]) in
  let _ = print "===== RUNG 35 SEAL: self-emission certificate signed onto the chain =====" in
  let _ = print (cat ["cert sha256 = ", cert_hex]) in
  let _ = print (cat ["prev (chain) = ", prev_hex]) in
  let _ = print (cat ["SELFEMIT link = ", link_hex]) in
  let _ = print (cat ["signature verifies = ", show ok, "   pubkey = ", pk_hex]) in
  let _ = print (if ok == 1 then "SEALED: rung 35 is one Ed25519-bound artifact (emission + fixed-point + tests + mutation)." else "SEAL FAILED") in
  if ok == 1 then 0 else 1
