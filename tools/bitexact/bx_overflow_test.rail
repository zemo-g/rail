-- Regression guard for the INFINITE-LOOP / 63-bit-overflow class in bx_fixed.rail.
-- bx4_topbit's `d*4 > n` overflowed and SPUN FOREVER on massive-activation RMS inputs (the Qwen3
-- layer-3 hang, 2026-06-19; fixed via `d > n/4`). The guard: feed bx4_fxsqrt a COMPUTED large value
-- whose internal `xq * 2^24` overflows (the exact shape that hung) -- if bx4_topbit ever regresses,
-- THIS TEST HANGS (CI/suite timeout catches it; a hang is worse than a crash because it's silent).
-- Values are COMPUTED (a*a), never bare literals (>=32768 value-literals hit the tag-mov codegen trap).
-- PASS = reaching the final line (i.e. every overflow-prone bx4 call terminated) AND isqrt exactness.
import "tools/bitexact/bx_fixed.rail"
main =
  let ok1 = if (bx4_isqrt 144) == 12 then 1 else 0 in       -- exactness, no overflow
  let ok2 = if (bx4_isqrt 1000000) == 1000 then 1 else 0 in
  let mq  = 3300000 * 3300000 in                            -- ~1.09e13 = SmolLM2/Qwen max meansq shape
  let s1  = bx4_fxsqrt mq in                                 -- internal xq*2^24 OVERFLOWS -> must TERMINATE
  let s2  = bx4_fxsqrt (4500000 * 4500000) in                -- another overflowing magnitude -> TERMINATE
  let e1  = bx4_fxexp (0 - (1000000 * 16777)) in             -- large-negative exp arg -> TERMINATE (~0)
  let c1  = bx4_cosb (5 * 16777216) in                       -- RoPE-shaped angle -> TERMINATE
  let _ = print (cat ["reached-end: fxsqrt(", show s1, ",", show s2, ") fxexp=", show e1, " cosb=", show c1]) in
  let pass = if (ok1 + ok2) == 2 then 1 else 0 in
  let _ = print (cat ["BX_OVERFLOW_GUARD ", if pass == 1 then "PASS" else "FAIL", " (reached end => no infinite loop; isqrt exact)"]) in
  if pass == 1 then 0 else 1
