-- Does the NEW overflow-safe bx4_fxsqrt differ from the OLD bx4_isqrt(xq*2^24)
-- for NON-overflow xq (xq*2^24 < 2^62, i.e. xq < 2^38)? If they ever differ here,
-- the fix changed established (attested) behavior beyond the overflow cases.
import "tools/bitexact/bx_fixed.rail"

-- old definition, inline (pre-fix): floor(sqrt(xq<<24)) via digit-by-digit isqrt
old_fxsqrt xq = bx4_isqrt (xq * 16777216)

-- walk xq from lo by step up to hi, count + show mismatches (cap shown to 20)
chk lo hi step shown =
  if lo > hi then let _ = print (cat ["done up to ", show hi, "  (shown ", show shown, " mismatches)"]) in 0
  else
    let nw = bx4_fxsqrt lo in
    let od = old_fxsqrt lo in
    if nw == od then chk (lo + step) hi step shown
    else
      let _ = if shown < 20 then print (cat ["MISMATCH xq=", show lo, " new=", show nw, " old=", show od]) else 0 in
      chk (lo + step) hi step (shown + 1)

main =
  let _ = print "dense 1..200000 step 1:" in
  let _ = chk 1 200000 1 0 in
  let _ = print "sweep 200000..274000000000 step 9999983 (up to ~2^38):" in
  let _ = chk 200000 274000000000 9999983 0 in
  0
