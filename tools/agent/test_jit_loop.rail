-- tools/agent/test_jit_loop.rail — smoke test for the JIT agent loop.
--
-- Exercises the JIT path with a canned LLM response (no network, no API
-- key). Identical to what jit_loop.rail --offline does, but invoked
-- directly through the library API so we get the integer result back
-- and can assert it.
--
-- Convention (matches tools/test/rail_test.rail): exit 0 AND last line
-- "PASS" on success; non-zero exit on failure.
--
-- Run:  ./rail_native run tools/agent/test_jit_loop.rail

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"
import "jit/lower.rail"
import "jit/grade.rail"

-- Mirror jit_loop.rail's offline_src so a change there is caught here.
canned_fib10_src _ =
  cat ["fib n = if n < 2 then n else fib (n - 1) + fib (n - 2)\n",
       "main = fib 10\n"]

-- Second canned source: factorial. Sanity check that we aren't single-fixture
-- coincidence.
canned_fact6_src _ =
  cat ["fact n = if n < 2 then 1 else n * fact (n - 1)\n",
       "main = fact 6\n"]

run_one label src expected =
  let _ = print (cat ["[", label, "] running..."])
  let r = try_jit_grade src
  if (head r) == "jit_ok" then
    let got = head (tail r)
    if got == expected then
      let _ = print (cat ["[", label, "] OK got=", show got])
      0
    else
      let _ = print (cat ["[", label, "] FAIL got=", show got, " expected=", show expected])
      1
  else
    let _ = print (cat ["[", label, "] LOWER/JIT FAIL: ", head (tail r)])
    1

main =
  let _ = print "test_jit_loop — offline smoke (no network)"
  let _ = print "============================================"
  let f1 = run_one "offline_fib10"  (canned_fib10_src 0) 55
  let f2 = run_one "offline_fact6"  (canned_fact6_src 0) 720
  let total = f1 + f2
  if total == 0 then
    let _ = print "PASS"
    0
  else
    let _ = print (cat ["FAIL (", show total, " case(s))"])
    1
