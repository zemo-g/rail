-- tools/garmin/test_thumb2_asm.rail - End-to-end assembler test.
--
-- Builds a tiny Rail-emitted Thumb-2 program with branches, calls, loops,
-- and label resolution; finalises; then disassembles via stdlib/thumb2.rail
-- to verify everything round-trips.

import "stdlib/thumb2.rail"
import "stdlib/thumb2_asm.rail"

print_bytes buf n =
  print_bytes_loop buf n 0 ""

print_bytes_loop buf n i acc =
  if i >= n then print acc
  else
    let b = arr_get buf i
    let hi = bit_and (shr b 4) 15
    let lo = bit_and b 15
    let ch = if hi < 10 then char_from_int (48 + hi) else char_from_int (87 + hi)
    let cl = if lo < 10 then char_from_int (48 + lo) else char_from_int (87 + lo)
    let sep = if (i + 1) == n then ""
              else if (bit_and (i + 1) 3) == 0 then "  "
              else " "
    print_bytes_loop buf n (i + 1) (cat [acc, ch, cl, sep])

main =
  let _ = print "=== Symbolic assembler test (base addr 0x2000) ==="

  let s = asm_new 8192   -- emit as if at flash 0x2000

  -- Declare three labels. asm_decl_label returns an id; we save them.
  let l_main = asm_decl_label s
  let l_loop = asm_decl_label s
  let l_done = asm_decl_label s

  -- main: (auto-bound to offset of the next-queued instruction)
  let _ = asm_label_here s l_main
  let _ = asm_push s 16 1                 -- push {r4, lr}
  let _ = asm_movs_imm8 s 4 0             -- movs r4, #0      counter = 0
  let _ = asm_b s l_loop                  -- b.w loop  (forward; resolved in pass 2)

  -- loop:
  let _ = asm_label_here s l_loop
  let _ = asm_cmp_imm8 s 4 10             -- cmp r4, #10
  let _ = asm_bcond s l_done 0            -- beq.w done   (cond=0 EQ)
  let _ = asm_adds_imm8 s 4 1             -- adds r4, #1
  let _ = asm_b s l_loop                  -- b.w loop  (backward)

  -- done:
  let _ = asm_label_here s l_done
  let _ = asm_pop s 16 1                  -- pop {r4, pc}

  -- Finalise: run pass 1 (layout) and pass 2 (emit).
  let total = asm_finalize s
  let _ = print (cat ["assembled ", show total, " bytes"])
  let buf = asm_buf s
  let _ = print_bytes buf total

  -- Round-trip: disassemble what we just emitted.
  let _ = print "\n=== disassembly of the emitted bytes ==="
  let _ = t2_disasm buf 0 total 32
  0
