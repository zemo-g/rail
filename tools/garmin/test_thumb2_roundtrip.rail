-- tools/garmin/test_thumb2_roundtrip.rail
--
-- Round-trip test: encode every supported instruction with known operands,
-- then run the decoder on the bytes, assert decoded fields match.
--
-- Output is a per-instruction line:  PASS|FAIL  mnemonic  encoded-hex  decoded-target

import "stdlib/thumb2.rail"
import "stdlib/thumb2_emit.rail"

ok_count = 0
fail_count = 0

-- Quick t2_decode_str variant that doesn't reuse decode helpers
hex2 n =
  let h = "0123456789abcdef"
  let cs = chars h
  let hi = bit_and (shr n 4) 15
  let lo = bit_and n 15
  cat [head (drop_str hi cs), head (drop_str lo cs)]

bytes_of buf n i acc =
  if i >= n then acc
  else bytes_of buf n (i + 1) (cat [acc, hex2 (arr_get buf i)])

drop_str n cs =
  if n <= 0 then cs
  else drop_str (n - 1) (tail cs)

-- Check an encode/decode pair.  expected_kind / expected_target taken from
-- the call site.
check name buf base length expected_kind expected_target =
  let r = t2_decode buf 0
  let kind = arr_get r 0
  let target = arr_get r 1
  let len = arr_get r 2
  -- target needs slice_origin adjustment if it's a branch (kinds 1/2/3/4/5/9)
  let is_branch = (kind == 1) || (kind == 2) || (kind == 3) || (kind == 4) || (kind == 5) || (kind == 9)
  let target_abs = if is_branch then target + base else target
  let bytes_str = bytes_of buf len 0 ""
  let kind_ok = kind == expected_kind
  let len_ok = len == length
  let target_ok = (expected_target < 0) || (target_abs == expected_target)
  let pass = kind_ok && len_ok && target_ok
  let mark = if pass then "PASS" else "FAIL"
  let _ = print (cat [mark, " ", name, "  bytes=", bytes_str,
                      "  kind=", show kind, "/", show expected_kind,
                      "  len=", show len, "/", show length,
                      "  target=0x", show target_abs, " vs 0x", show expected_target])
  pass

run_test name addr encoder_fn expected_kind expected_target expected_len =
  let buf = arr_new 8 0
  let _ = encoder_fn buf
  check name buf addr expected_len expected_kind expected_target

main =
  let _ = print "=== Thumb-2 encode/decode round-trip ==="
  -- B uncond from 0x100 to 0x140 (delta = +60)
  let _ = run_test "B 0x100 -> 0x140" 256 (\buf -> te_b buf 0 256 320) 1 320 2
  -- B uncond backwards from 0x100 to 0x080
  let _ = run_test "B 0x100 -> 0x080" 256 (\buf -> te_b buf 0 256 128) 1 128 2
  -- Bcond eq from 0x100 to 0x110
  let _ = run_test "Beq 0x100 -> 0x110" 256 (\buf -> te_bcond buf 0 256 272 0) 2 272 2
  -- Bcond ne backwards from 0x100 to 0x080
  let _ = run_test "Bne 0x100 -> 0x080" 256 (\buf -> te_bcond buf 0 256 128 1) 2 128 2
  -- BL forward from 0x1000 to 0x2000
  let _ = run_test "BL 0x1000 -> 0x2000" 4096 (\buf -> te_bl buf 0 4096 8192) 3 8192 4
  -- BL backward from 0x10000 to 0xC304
  let _ = run_test "BL 0x10000 -> 0xC304" 65536 (\buf -> te_bl buf 0 65536 49924) 3 49924 4
  -- B.W far forward
  let _ = run_test "B.W 0x100 -> 0x10000" 256 (\buf -> te_b_w buf 0 256 65536) 4 65536 4
  -- Bcond.W (cond=1 ne, far forward)
  let _ = run_test "Bne.W 0x1000 -> 0xC55A" 4096 (\buf -> te_bcond_w buf 0 4096 50522 1) 5 50522 4
  -- BX r0 / r14 (no target)
  let _ = run_test "BX r0" 0 (\buf -> te_bx buf 0 0) 6 (0 - 1) 2
  let _ = run_test "BX r14 (LR)" 0 (\buf -> te_bx buf 0 14) 6 (0 - 1) 2
  -- Stack ops
  let _ = run_test "POP {r4, pc}" 0 (\buf -> te_pop buf 0 16 1) 7 (0 - 1) 2
  let _ = run_test "PUSH {r4, lr}" 0 (\buf -> te_push buf 0 16 1) 8 (0 - 1) 2
  -- NOP
  let _ = run_test "NOP" 0 (\buf -> te_nop buf 0) 10 (0 - 1) 2
  -- Concrete byte exactness vs disassembled firmware:
  -- 0xC31C: f044 f800   bl   0x50320     (0xc31c + 4 = 0xc320; 0x50320 - 0xc320 = 0x44000)
  -- 0xC330: f043 fff8   bl   0x50324     (0xc330 + 4 = 0xc334; 0x50324 - 0xc334 = 0x43FF0)
  let buf = arr_new 4 0
  let _ = te_bl buf 0 49948 328480
  let b0 = arr_get buf 0
  let b1 = arr_get buf 1
  let b2 = arr_get buf 2
  let b3 = arr_get buf 3
  let mark = if b0 == 68 && b1 == 240 && b2 == 0 && b3 == 248 then "PASS" else "FAIL"
  let _ = print (cat [mark, " concrete BL c31c->50320 -> f044 f800: bytes ", show b0, " ", show b1, " ", show b2, " ", show b3])
  let buf2 = arr_new 4 0
  let _ = te_bl buf2 0 49968 328484
  let c0 = arr_get buf2 0
  let c1 = arr_get buf2 1
  let c2 = arr_get buf2 2
  let c3 = arr_get buf2 3
  let mark2 = if c0 == 67 && c1 == 240 && c2 == 248 && c3 == 255 then "PASS" else "FAIL"
  let _ = print (cat [mark2, " concrete BL c330->50324 -> f043 fff8: bytes ", show c0, " ", show c1, " ", show c2, " ", show c3])
  0
