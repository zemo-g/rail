-- tools/garmin/analyze_deep.rail — Multi-pass sensor analysis for one
-- FIT activity file. Streams every record into a per-sample buffer, then
-- runs HR zones, 5-min splits, cardiac drift, climbs, elevation profile,
-- and lap decoding.
--
-- Usage:
--   ./rail_native run tools/garmin/analyze_deep.rail <fit_path>

import "stdlib/fit.rail"
import "stdlib/fmt.rail"

-- ── Acc layout ──
-- 0 record_count  1 lap_count  2 sport  3 file_type
-- 4 session_t_first  5 session_t_last
-- 6 session_distance_cm  7 session_active_ms  8 session_avg_hr
-- 9 session_calories
acc_new _ =
  let a = arr_new 16 0
  let _ = arr_set a 2 (0 - 1)
  let _ = arr_set a 3 (0 - 1)
  a

-- ── Records buffer (8 ints / record) ──
-- 0 t  1 hr  2 spd_mmps  3 alt_raw  4 lat_semi  5 lon_semi  6 dist_cm  7 temp
rec_init records i =
  let base = i * 8
  let _ = arr_set records (base + 0) 0
  let _ = arr_set records (base + 1) 0
  let _ = arr_set records (base + 2) 0
  let _ = arr_set records (base + 3) 0
  let _ = arr_set records (base + 4) 2147483647
  let _ = arr_set records (base + 5) 2147483647
  let _ = arr_set records (base + 6) 0
  let _ = arr_set records (base + 7) 127
  0

rec_set_field records i fdef kind v =
  let base = i * 8
  if fdef == 253 && kind == 0 then arr_set records (base + 0) v
  else if fdef == 3 && kind == 0 && v != 255 then arr_set records (base + 1) v
  else if fdef == 6 && kind == 0 && v != 65535 then arr_set records (base + 2) v
  else if fdef == 73 && kind == 0 && v != 4294967295 then arr_set records (base + 2) v
  else if fdef == 2 && kind == 0 && v != 65535 then arr_set records (base + 3) v
  else if fdef == 78 && kind == 0 && v != 4294967295 then arr_set records (base + 3) v
  else if fdef == 0 && kind == 1 then arr_set records (base + 4) v
  else if fdef == 1 && kind == 1 then arr_set records (base + 5) v
  else if fdef == 5 && kind == 0 && v != 4294967295 then arr_set records (base + 6) v
  else if fdef == 13 && kind == 1 && v != 127 then arr_set records (base + 7) v
  else 0

rec_observe records i schema buf rec_off nf arch j =
  if j >= nf then 0
  else
    let fdef = schema_field_def schema j
    let sz = schema_field_size schema j
    let bt = schema_field_type schema j
    let foff = rec_off + schema_field_offset schema j
    let dec = fit_decode_field buf foff sz bt arch
    let kind = arr_get dec 0
    let v = arr_get dec 1
    let _ = if kind != 3 then rec_set_field records i fdef kind v else 0
    rec_observe records i schema buf rec_off nf arch (j + 1)

-- ── Laps buffer (16 ints / lap) ──
-- 0 t_start  1 t_end  2 elapsed_ms  3 timer_ms  4 distance_cm
-- 5 calories 6 avg_spd_mmps  7 max_spd_mmps
-- 8 avg_hr  9 max_hr
-- 10 ascent_m  11 descent_m  12 intensity  13 sport
lap_init laps i =
  let base = i * 16
  let _ = arr_set laps (base + 0) 0
  let _ = arr_set laps (base + 1) 0
  let _ = arr_set laps (base + 2) 0
  let _ = arr_set laps (base + 3) 0
  let _ = arr_set laps (base + 4) 0
  let _ = arr_set laps (base + 5) 0
  let _ = arr_set laps (base + 6) 0
  let _ = arr_set laps (base + 7) 0
  let _ = arr_set laps (base + 8) 0
  let _ = arr_set laps (base + 9) 0
  let _ = arr_set laps (base + 10) 0
  let _ = arr_set laps (base + 11) 0
  let _ = arr_set laps (base + 12) 0
  let _ = arr_set laps (base + 13) 0
  0

lap_set_field laps i fdef kind v =
  let base = i * 16
  if fdef == 2 && kind == 0 then arr_set laps (base + 0) v
  else if fdef == 253 && kind == 0 then arr_set laps (base + 1) v
  else if fdef == 7 && kind == 0 then arr_set laps (base + 2) v
  else if fdef == 8 && kind == 0 then arr_set laps (base + 3) v
  else if fdef == 9 && kind == 0 then arr_set laps (base + 4) v
  else if fdef == 11 && kind == 0 then arr_set laps (base + 5) v
  else if fdef == 13 && kind == 0 && v != 65535 then arr_set laps (base + 6) v
  else if fdef == 14 && kind == 0 && v != 65535 then arr_set laps (base + 7) v
  else if fdef == 110 && kind == 0 && v != 4294967295 then arr_set laps (base + 6) v
  else if fdef == 111 && kind == 0 && v != 4294967295 then arr_set laps (base + 7) v
  else if fdef == 15 && kind == 0 then arr_set laps (base + 8) v
  else if fdef == 16 && kind == 0 then arr_set laps (base + 9) v
  else if fdef == 21 && kind == 0 then arr_set laps (base + 10) v
  else if fdef == 22 && kind == 0 then arr_set laps (base + 11) v
  else if fdef == 23 && kind == 0 then arr_set laps (base + 12) v
  else if fdef == 25 && kind == 0 then arr_set laps (base + 13) v
  else 0

lap_observe laps i schema buf rec_off nf arch j =
  if j >= nf then 0
  else
    let fdef = schema_field_def schema j
    let sz = schema_field_size schema j
    let bt = schema_field_type schema j
    let foff = rec_off + schema_field_offset schema j
    let dec = fit_decode_field buf foff sz bt arch
    let kind = arr_get dec 0
    let v = arr_get dec 1
    let _ = if kind != 3 then lap_set_field laps i fdef kind v else 0
    lap_observe laps i schema buf rec_off nf arch (j + 1)

session_observe acc schema buf rec_off nf arch j =
  if j >= nf then 0
  else
    let fdef = schema_field_def schema j
    let sz = schema_field_size schema j
    let bt = schema_field_type schema j
    let foff = rec_off + schema_field_offset schema j
    let dec = fit_decode_field buf foff sz bt arch
    let kind = arr_get dec 0
    let v = arr_get dec 1
    let _ = if fdef == 5 && kind == 0 then arr_set acc 2 v
            else if fdef == 9 && kind == 0 then arr_set acc 6 v
            else if fdef == 8 && kind == 0 then arr_set acc 7 v
            else if fdef == 16 && kind == 0 then arr_set acc 8 v
            else if fdef == 11 && kind == 0 then arr_set acc 9 v
            else if fdef == 2 && kind == 0 then arr_set acc 4 v
            else if fdef == 253 && kind == 0 then arr_set acc 5 v
            else 0
    session_observe acc schema buf rec_off nf arch (j + 1)

file_id_observe acc schema buf rec_off nf arch j =
  if j >= nf then 0
  else
    let fdef = schema_field_def schema j
    let sz = schema_field_size schema j
    let bt = schema_field_type schema j
    let foff = rec_off + schema_field_offset schema j
    let dec = fit_decode_field buf foff sz bt arch
    let kind = arr_get dec 0
    let v = arr_get dec 1
    let _ = if fdef == 0 && kind == 0 then arr_set acc 3 v else 0
    file_id_observe acc schema buf rec_off nf arch (j + 1)

walk fit table acc records laps cursor =
  let buf = fit_buf fit
  let endp = fit_data_end fit
  if cursor >= endp then 0
  else
    let h = arr_get buf cursor
    let after_hdr = cursor + 1
    if bit_and h 128 != 0 then 0
    else
      let local_id = bit_and h 15
      if bit_and h 64 != 0 then
        let has_dev = bit_and (shr h 5) 1
        let dr = parse_def buf after_hdr has_dev
        let schema = arr_get dr 0
        let after = arr_get dr 1
        let _ = arr_set table local_id schema
        walk fit table acc records laps after
      else
        let schema = arr_get table local_id
        if schema == 0 then 0
        else
          let body = schema_total schema
          let g = schema_global schema
          let nf = schema_nfields schema
          let arch = schema_arch schema
          let _ = if g == 20 then
                    let i = arr_get acc 0
                    if i < 8192 then
                      let _ = rec_init records i
                      let _ = rec_observe records i schema buf after_hdr nf arch 0
                      arr_set acc 0 (i + 1)
                    else 0
                  else if g == 19 then
                    let i = arr_get acc 1
                    if i < 64 then
                      let _ = lap_init laps i
                      let _ = lap_observe laps i schema buf after_hdr nf arch 0
                      arr_set acc 1 (i + 1)
                    else 0
                  else if g == 18 then session_observe acc schema buf after_hdr nf arch 0
                  else if g == 0 then file_id_observe acc schema buf after_hdr nf arch 0
                  else 0
          walk fit table acc records laps (after_hdr + body)

-- ── Format helpers ──
sport_name n =
  if n == 0 then "generic"
  else if n == 1 then "running"
  else if n == 2 then "cycling"
  else if n == 5 then "swimming"
  else if n == 11 then "walking"
  else if n == 17 then "hiking"
  else cat ["sport(", show n, ")"]

fmt_hms secs =
  if secs < 0 then "-"
  else
    let h = secs / 3600
    let m = (secs / 60) - h * 60
    let s = secs - (secs / 60) * 60
    if h > 0 then cat [show h, ":", zero_pad m 2, ":", zero_pad s 2]
    else cat [zero_pad m 2, ":", zero_pad s 2]

fmt_km cm =
  if cm <= 0 then "-"
  else
    let km_int = cm / 100000
    let hundredths = (cm / 1000) - km_int * 100
    cat [show km_int, ".", zero_pad hundredths 2, " km"]

fmt_kmh mmps =
  if mmps <= 0 then "-"
  else
    let kmh_x100 = mmps * 36 / 100
    let intp = kmh_x100 / 100
    let frac = kmh_x100 - intp * 100
    cat [lpad (show intp) 2, ".", zero_pad frac 2]

fmt_alt_raw_int raw =
  raw / 5 - 500

bar_str frac width =
  let n_chars = if frac < 0 then 0
                else if frac > width then width
                else frac
  repeat_char "#" n_chars

-- Record accessors
rec_t  records i = arr_get records (i * 8 + 0)
rec_hr records i = arr_get records (i * 8 + 1)
rec_sp records i = arr_get records (i * 8 + 2)
rec_al records i = arr_get records (i * 8 + 3)
rec_la records i = arr_get records (i * 8 + 4)
rec_lo records i = arr_get records (i * 8 + 5)
rec_d  records i = arr_get records (i * 8 + 6)
rec_te records i = arr_get records (i * 8 + 7)

-- ── Pass: observed HR max ──
max_hr records n i acc =
  if i >= n then acc
  else
    let h = rec_hr records i
    let na = if h > acc then h else acc
    max_hr records n (i + 1) na

-- ── Pass: HR zone histogram (% of observed max) ──
zone_count records n hrmax lo hi i acc =
  if i >= n then acc
  else
    let h = rec_hr records i
    let hit = if h > 0 then
                let pct = h * 100 / hrmax
                if pct >= lo && pct < hi then 1 else 0
              else 0
    zone_count records n hrmax lo hi (i + 1) (acc + hit)

print_zone label cnt n interval_ms hrmax lo hi =
  let secs = cnt * interval_ms / 1000
  let pct_int = if n > 0 then cnt * 100 / n else 0
  let lo_bpm = hrmax * lo / 100
  let hi_raw = hrmax * hi / 100
  let hi_bpm = if hi_raw > hrmax then hrmax else hi_raw
  let bar = bar_str (pct_int * 40 / 100) 40
  print (cat [rpad label 6, " ",
              lpad (show lo_bpm) 3, "-", lpad (show hi_bpm) 3, " bpm  ",
              lpad (fmt_hms secs) 8, "  ",
              lpad (cat [show pct_int, "%"]) 4, "  ", bar])

print_hr_zones records n hrmax interval_ms =
  let _ = print (cat ["HR zones (observed max = ", show hrmax, " bpm; zones span 50-100% of that):"])
  let z0 = zone_count records n hrmax 0 50 0 0
  let z1 = zone_count records n hrmax 50 60 0 0
  let z2 = zone_count records n hrmax 60 70 0 0
  let z3 = zone_count records n hrmax 70 80 0 0
  let z4 = zone_count records n hrmax 80 90 0 0
  let z5 = zone_count records n hrmax 90 200 0 0
  let _ = print_zone "  Z0" z0 n interval_ms hrmax 0 50
  let _ = print_zone "  Z1" z1 n interval_ms hrmax 50 60
  let _ = print_zone "  Z2" z2 n interval_ms hrmax 60 70
  let _ = print_zone "  Z3" z3 n interval_ms hrmax 70 80
  let _ = print_zone "  Z4" z4 n interval_ms hrmax 80 90
  let _ = print_zone "  Z5" z5 n interval_ms hrmax 90 200
  0

-- ── Pass: 5-minute splits ──
-- For each record, bucket = (t - t0) / 300. Track per-bucket: sum_hr, n_hr,
-- last_dist, first_dist, sum_alt, n_alt, t_start, t_end. Up to 32 buckets.
splits_init b =
  let _ = arr_set b 0 0
  let _ = arr_set b 1 0
  let _ = arr_set b 2 (0 - 1)
  let _ = arr_set b 3 0
  let _ = arr_set b 4 0
  let _ = arr_set b 5 0
  let _ = arr_set b 6 0
  let _ = arr_set b 7 0
  0

split_accum splits k hr d alt =
  let base = k * 8
  let _ = if hr > 0 then
            let _ = arr_set splits (base + 0) (arr_get splits (base + 0) + hr)
            arr_set splits (base + 1) (arr_get splits (base + 1) + 1)
          else 0
  let _ = if d > 0 then
            let cur = arr_get splits (base + 2)
            let _ = if cur < 0 then arr_set splits (base + 2) d else 0
            arr_set splits (base + 3) d
          else 0
  let _ = if alt > 0 then
            let _ = arr_set splits (base + 4) (arr_get splits (base + 4) + alt)
            arr_set splits (base + 5) (arr_get splits (base + 5) + 1)
          else 0
  0

splits_pass records n t0 splits i =
  if i >= n then 0
  else
    let t = rec_t records i
    let off = t - t0
    let k = off / 300
    if k < 32 then
      let _ = if k >= 0 then
                let base = k * 8
                let _ = if arr_get splits (base + 6) == 0 then arr_set splits (base + 6) t else 0
                let _ = arr_set splits (base + 7) t
                split_accum splits k (rec_hr records i) (rec_d records i) (rec_al records i)
              else 0
      splits_pass records n t0 splits (i + 1)
    else 0

print_splits_row k splits =
  let base = k * 8
  let n_hr = arr_get splits (base + 1)
  let avg_hr = if n_hr > 0 then arr_get splits (base + 0) / n_hr else 0
  let dist0 = arr_get splits (base + 2)
  let dist1 = arr_get splits (base + 3)
  let d_cm = if dist0 < 0 then 0 else dist1 - dist0
  let n_alt = arr_get splits (base + 5)
  let avg_alt_raw = if n_alt > 0 then arr_get splits (base + 4) / n_alt else 0
  let avg_alt_m = if n_alt > 0 then fmt_alt_raw_int avg_alt_raw else 0
  let t0 = arr_get splits (base + 6)
  let t1 = arr_get splits (base + 7)
  let dur = if t1 > t0 then t1 - t0 else 0
  let avg_kmh_x100 = if dur > 0 then d_cm * 36 / dur / 10 else 0
  let kmh_int = avg_kmh_x100 / 100
  let kmh_frac = avg_kmh_x100 - kmh_int * 100
  print (cat [
    lpad (cat [show (k * 5), "-", show (k * 5 + 5)]) 7, " min  ",
    "dist ", lpad (fmt_km d_cm) 7, "  ",
    "avg HR ", lpad (show avg_hr) 3, "  ",
    "avg ", lpad (show kmh_int) 2, ".", zero_pad kmh_frac 2, " km/h  ",
    "alt ", lpad (show avg_alt_m) 4, " m"])

print_splits_loop splits k max_k =
  if k >= max_k then 0
  else
    let base = k * 8
    let any = arr_get splits (base + 1) + arr_get splits (base + 5)
    let _ = if any > 0 then print_splits_row k splits else 0
    print_splits_loop splits (k + 1) max_k

print_splits records n t0 dur =
  let max_k = (dur + 299) / 300
  let kk = if max_k > 32 then 32 else max_k
  let splits = arr_new 256 0
  let _ = splits_init_loop splits 0 32
  let _ = splits_pass records n t0 splits 0
  let _ = print "5-min splits (distance / avg HR / avg speed / avg altitude):"
  print_splits_loop splits 0 kk

splits_init_loop splits k max_k =
  if k >= max_k then 0
  else
    let base = k * 8
    let _ = arr_set splits (base + 0) 0
    let _ = arr_set splits (base + 1) 0
    let _ = arr_set splits (base + 2) (0 - 1)
    let _ = arr_set splits (base + 3) 0
    let _ = arr_set splits (base + 4) 0
    let _ = arr_set splits (base + 5) 0
    let _ = arr_set splits (base + 6) 0
    let _ = arr_set splits (base + 7) 0
    splits_init_loop splits (k + 1) max_k

-- ── Pass: cardiac drift ──
-- Compare avg HR / avg speed in first half vs second half (by record index).
half_stats records lo hi i hr_sum hr_n sp_sum sp_n =
  if i >= hi then
    let r = arr_new 4 0
    let _ = arr_set r 0 hr_sum
    let _ = arr_set r 1 hr_n
    let _ = arr_set r 2 sp_sum
    let _ = arr_set r 3 sp_n
    r
  else
    let h = rec_hr records i
    let s = rec_sp records i
    let nh_sum = if h > 0 then hr_sum + h else hr_sum
    let nh_n = if h > 0 then hr_n + 1 else hr_n
    let ns_sum = if s > 0 then sp_sum + s else sp_sum
    let ns_n = if s > 0 then sp_n + 1 else sp_n
    half_stats records lo hi (i + 1) nh_sum nh_n ns_sum ns_n

print_drift records n =
  let mid = n / 2
  let h1 = half_stats records 0 mid 0 0 0 0 0
  let h2 = half_stats records mid n mid 0 0 0 0
  let hr1 = if arr_get h1 1 > 0 then arr_get h1 0 / arr_get h1 1 else 0
  let hr2 = if arr_get h2 1 > 0 then arr_get h2 0 / arr_get h2 1 else 0
  let sp1 = if arr_get h1 3 > 0 then arr_get h1 2 / arr_get h1 3 else 0
  let sp2 = if arr_get h2 3 > 0 then arr_get h2 2 / arr_get h2 3 else 0
  let drift = if hr1 > 0 then (hr2 - hr1) * 100 / hr1 else 0
  let _ = print (cat ["First half  : avg HR ", show hr1, " bpm  @ avg ", fmt_kmh sp1, " km/h"])
  let _ = print (cat ["Second half : avg HR ", show hr2, " bpm  @ avg ", fmt_kmh sp2, " km/h"])
  let _ = print (cat ["HR drift    : ", show drift, "% (positive = HR rose at similar work)"])
  0

-- ── Pass: climbs ──
-- A climb is a run of records where altitude increases monotonically (with
-- small downward tolerance) and accumulated gain >= 5 m. Print up to 8 climbs.
print_climb_row idx t_start t_end gain_raw dist_cm =
  let dur = t_end - t_start
  let gain_m = gain_raw / 5
  let grade_x10 = if dist_cm > 0 then gain_raw * 10000 / 5 / dist_cm else 0
  let grade_int = grade_x10 / 10
  let grade_frac = grade_x10 - grade_int * 10
  let grade_frac_abs = if grade_frac < 0 then 0 - grade_frac else grade_frac
  print (cat ["  #", show idx, "  +", lpad (show gain_m) 3, " m over ",
              lpad (fmt_hms dur) 6, "  (", lpad (fmt_km dist_cm) 7, ", ",
              show grade_int, ".", show grade_frac_abs, "% grade)"])

-- Low-water / high-water peak detector. State (8-int array):
--   0 mode (0=seek_low, 1=in_climb)
--   1 low_alt   2 low_t   3 low_d
--   4 high_alt  5 high_t  6 high_d
--   7 climbs_emitted
-- Climb emit threshold: 25 raw (5 m). Downturn threshold: 10 raw (2 m).

climb_state_new _ =
  let s = arr_new 8 0
  let _ = arr_set s 1 (0 - 1)
  s

climb_seek_low st a t d =
  if a < arr_get st 1 || arr_get st 1 < 0 then
    let _ = arr_set st 1 a
    let _ = arr_set st 2 t
    let _ = arr_set st 3 d
    let _ = arr_set st 4 a
    let _ = arr_set st 5 t
    let _ = arr_set st 6 d
    0
  else if a >= arr_get st 1 + 25 then
    let _ = arr_set st 0 1
    let _ = arr_set st 4 a
    let _ = arr_set st 5 t
    let _ = arr_set st 6 d
    0
  else 0

climb_in_climb st a t d =
  if a > arr_get st 4 then
    let _ = arr_set st 4 a
    let _ = arr_set st 5 t
    let _ = arr_set st 6 d
    0
  else if a <= arr_get st 4 - 10 then
    let _ = print_climb_row (arr_get st 7 + 1) (arr_get st 2) (arr_get st 5)
                            (arr_get st 4 - arr_get st 1) (arr_get st 6 - arr_get st 3)
    let _ = arr_set st 7 (arr_get st 7 + 1)
    let _ = arr_set st 0 0
    let _ = arr_set st 1 a
    let _ = arr_set st 2 t
    let _ = arr_set st 3 d
    let _ = arr_set st 4 a
    let _ = arr_set st 5 t
    let _ = arr_set st 6 d
    0
  else 0

climbs_pass records n i st =
  if i >= n then arr_get st 7
  else
    let a = rec_al records i
    let t = rec_t records i
    let d = rec_d records i
    if a == 0 then climbs_pass records n (i + 1) st
    else
      let _ = if arr_get st 0 == 0 then climb_seek_low st a t d
              else climb_in_climb st a t d
      climbs_pass records n (i + 1) st

print_climbs records n =
  let _ = print "Climb segments (low-to-high >= 5 m, peak detected on 2 m downturn):"
  let st = climb_state_new 0
  let count = climbs_pass records n 0 st
  if count == 0 then print "  (no climbs above threshold; ride was effectively flat)" else 0

-- ── Pass: elevation sparkline (60-col, 6 rows) ──
elev_bin records n t0 dur bins nbins i =
  if i >= n then 0
  else
    let t = rec_t records i
    let off = t - t0
    let k = if dur > 0 then off * nbins / dur else 0
    let kk = if k >= nbins then nbins - 1 else (if k < 0 then 0 else k)
    let a = rec_al records i
    if a > 0 then
      let _ = arr_set bins (kk * 2 + 0) (arr_get bins (kk * 2 + 0) + fmt_alt_raw_int a)
      let _ = arr_set bins (kk * 2 + 1) (arr_get bins (kk * 2 + 1) + 1)
      elev_bin records n t0 dur bins nbins (i + 1)
    else
      elev_bin records n t0 dur bins nbins (i + 1)

elev_avg bins k =
  let n = arr_get bins (k * 2 + 1)
  if n == 0 then 0 - 9999
  else arr_get bins (k * 2 + 0) / n

elev_minmax bins nbins k mn mx =
  if k >= nbins then
    let r = arr_new 2 0
    let _ = arr_set r 0 mn
    let _ = arr_set r 1 mx
    r
  else
    let v = elev_avg bins k
    let nmn = if v > 0 - 9999 && v < mn then v else mn
    let nmx = if v > 0 - 9999 && v > mx then v else mx
    elev_minmax bins nbins (k + 1) nmn nmx

elev_row_str bins nbins row rows mn mx k acc =
  if k >= nbins then acc
  else
    let v = elev_avg bins k
    let band = if v <= 0 - 9999 then 0 - 1
               else if mx == mn then rows / 2
               else (v - mn) * (rows - 1) / (mx - mn)
    let target_row = (rows - 1) - row
    let ch = if band == target_row then "#"
             else if band > target_row then "|"
             else " "
    elev_row_str bins nbins row rows mn mx (k + 1) (append acc ch)

print_elev_row bins nbins row rows mn mx =
  let s = elev_row_str bins nbins row rows mn mx 0 ""
  let label = if row == 0 then cat [lpad (show mx) 4, " m  "]
              else if row == rows - 1 then cat [lpad (show mn) 4, " m  "]
              else "        "
  print (cat [label, s])

print_elev_loop bins nbins row rows mn mx =
  if row >= rows then 0
  else
    let _ = print_elev_row bins nbins row rows mn mx
    print_elev_loop bins nbins (row + 1) rows mn mx

print_elev records n t0 dur =
  let nbins = 60
  let rows = 6
  let bins = arr_new (nbins * 2) 0
  let _ = elev_bin records n t0 dur bins nbins 0
  let mm = elev_minmax bins nbins 0 999999 (0 - 999999)
  let mn = arr_get mm 0
  let mx = arr_get mm 1
  if mx <= 0 - 999998 then
    let _ = print "  (no altitude data)"
    0
  else
    let _ = print "Elevation profile (time on x, altitude on y):"
    print_elev_loop bins nbins 0 rows mn mx

-- ── Pass: laps ──
print_lap_row laps i =
  let base = i * 16
  let timer = arr_get laps (base + 3) / 1000
  let dist = arr_get laps (base + 4)
  let avg_sp = arr_get laps (base + 6)
  let avg_hr = arr_get laps (base + 8)
  let max_hr = arr_get laps (base + 9)
  let asc = arr_get laps (base + 10)
  let desc = arr_get laps (base + 11)
  let cal = arr_get laps (base + 5)
  print (cat ["  #", lpad (show (i + 1)) 2, "  ",
              lpad (fmt_hms timer) 6, "  ",
              lpad (fmt_km dist) 7, "  ",
              "avg ", fmt_kmh avg_sp, " km/h  ",
              "HR ", lpad (show avg_hr) 3, "/", lpad (show max_hr) 3, "  ",
              "+", lpad (show asc) 3, "/-", lpad (show desc) 3, " m  ",
              lpad (show cal) 4, " kcal"])

print_laps_loop laps i n =
  if i >= n then 0
  else
    let _ = print_lap_row laps i
    print_laps_loop laps (i + 1) n

print_laps laps n =
  if n == 0 then
    let _ = print "  (no lap messages)"
    0
  else
    let _ = print (cat ["Auto laps (", show n, " total):"])
    let _ = print "       timer    dist     avg km/h     avg/max HR    asc/desc   kcal"
    print_laps_loop laps 0 n

-- ── Top-level ──
main =
  let argv = args
  let path = if length argv >= 2 then head (tail argv) else ""
  if length (chars path) == 0 then
    let _ = print "usage: rail_native run tools/garmin/analyze_deep.rail <fit_path>"
    1
  else
    let fit = fit_load path
    if fit_valid fit == 0 then
      let _ = print (cat ["invalid FIT file: ", path])
      1
    else
      let table = arr_new 16 0
      let acc = acc_new 0
      let records = arr_new 65536 0
      let laps = arr_new 1024 0
      let _ = walk fit table acc records laps (fit_data_off fit)
      let n = arr_get acc 0
      let lap_n = arr_get acc 1
      let t0 = if n > 0 then rec_t records 0 else 0
      let t_end = if n > 0 then rec_t records (n - 1) else 0
      let dur = t_end - t0
      let active_ms = arr_get acc 7
      let active = active_ms / 1000
      let interval_ms = if n > 0 && active_ms > 0 then active_ms / n else 1000
      let hrmax = max_hr records n 0 0
      let hrmax_used = if hrmax > 0 then hrmax else 180

      let _ = print "================================================================"
      let _ = print (cat ["WORKOUT DEEP DIVE  ", path])
      let _ = print "================================================================"
      let _ = print (cat ["Sport       ", sport_name (arr_get acc 2)])
      let _ = print (cat ["Started     ", fit_fmt_unix_utc (fit_unix_of t0)])
      let _ = print (cat ["Ended       ", fit_fmt_unix_utc (fit_unix_of t_end)])
      let _ = print (cat ["Active      ", fmt_hms active, "   Elapsed ", fmt_hms dur,
                          "   (paused ", fmt_hms (dur - active), ")"])
      let _ = print (cat ["Distance    ", fmt_km (arr_get acc 6),
                          "   Calories ", show (arr_get acc 9), " kcal",
                          "   Avg HR ", show (arr_get acc 8), " bpm"])
      let _ = print (cat ["Records     ", show n,
                          "  (~", show interval_ms, " ms/sample)",
                          "   Laps ", show lap_n])
      let _ = print ""
      let _ = print "─── HR ZONES ───"
      let _ = print_hr_zones records n hrmax_used interval_ms
      let _ = print ""
      let _ = print "─── 5-MIN SPLITS ───"
      let _ = print_splits records n t0 dur
      let _ = print ""
      let _ = print "─── CARDIAC DRIFT ───"
      let _ = print_drift records n
      let _ = print ""
      let _ = print "─── CLIMBS ───"
      let _ = print_climbs records n
      let _ = print ""
      let _ = print "─── ELEVATION PROFILE ───"
      let _ = print_elev records n t0 dur
      let _ = print ""
      let _ = print "─── LAPS ───"
      let _ = print_laps laps lap_n
      0
