-- tools/garmin/fuzz_fit_pass5.rail - Pass-5 schema-mismatched mutations.
--
-- Pass 4 found that 5 directories silently consume our drops without
-- logging: Activity/, Records/, Schedule/, Goals/, DeleteFiles/. These
-- are the highest-value targets - lack of log entries often correlates
-- with weaker validation. Pass 5 ships dir-specific FITs with schemas
-- that match what the firmware EXPECTS for each dir's parser, then
-- corrupts post-gate fields.
--
-- Each FIT:
--   1. Header (valid CRC, valid data_size)
--   2. Definition for global msg 0 (file_id) with our identity (passes gate)
--   3. Data record matching that schema
--   4. Definition for a SECOND, dir-specific message type with hostile
--      field values (oversize ints, huge counts, edge timestamps)
--   5. Data record matching that second def
--   6. Trailing CRC
--
-- Targets:
--   p5_activity.fit  -> Activity/   (msg 34 = activity, msg 18 = session)
--   p5_record.fit    -> Records/    (msg 20 = record, msg 113 = lap)
--   p5_schedule.fit  -> Schedule/   (msg 28 = schedule)
--   p5_goal.fit      -> Goals/      (msg 15 = goal)
--   p5_delete.fit    -> DeleteFiles/ (file_id only - test what triggers consumption)

import "stdlib/fit_emit.rail"

-- Standard file_id (passes the gate).
gate_passing_file_id _ =
  let f5 = cons (fe_field 0 1 0) []
  let f4 = cons (fe_field 2 2 132) f5
  let f3 = cons (fe_field 1 2 132) f4
  let f2 = cons (fe_field 4 4 134) f3
  cons (fe_field 3 4 140) f2

emit_gate_passing_payload s file_type =
  let _ = fe_write_u32_le s 3422906732
  let _ = fe_write_u32_le s 1145000000
  let _ = fe_write_u16_le s 1
  let _ = fe_write_u16_le s 3126
  let _ = fe_write_u8 s file_type
  0

-- Activity message (msg 34): timestamp + total_timer_time + num_sessions
-- + type. Hostile: total_timer_time = 0xFFFFFFFF (overflow if used as ms)
activity_fields _ =
  let f4 = cons (fe_field 2 1 0) []           -- field 2: type
  let f3 = cons (fe_field 1 2 132) f4         -- field 1: num_sessions
  let f2 = cons (fe_field 0 4 134) f3         -- field 0: total_timer_time
  cons (fe_field 253 4 134) f2                -- field 253: timestamp

mut_activity path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 4
  -- def for msg 34 (activity) at local_id 1
  let _ = fe_emit_def s 1 34 0 (activity_fields 0)
  let _ = fe_write_u8 s 1
  let _ = fe_write_u32_le s 4294967295   -- timestamp = max u32
  let _ = fe_write_u32_le s 4294967295   -- total_timer_time = max
  let _ = fe_write_u16_le s 65535        -- num_sessions
  let _ = fe_write_u8 s 255              -- type = invalid
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

-- Record message (msg 20): timestamp + position_lat + position_long + heart_rate
record_fields _ =
  let f4 = cons (fe_field 3 1 2) []           -- field 3: heart_rate uint8
  let f3 = cons (fe_field 1 4 133) f4         -- field 1: position_long sint32
  let f2 = cons (fe_field 0 4 133) f3         -- field 0: position_lat sint32
  cons (fe_field 253 4 134) f2

mut_record path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 4
  let _ = fe_emit_def s 1 20 0 (record_fields 0)
  let _ = fe_write_u8 s 1
  let _ = fe_write_u32_le s 4294967295   -- timestamp max
  let _ = fe_write_u32_le s 2147483648   -- pos_lat = INT_MIN (most negative)
  let _ = fe_write_u32_le s 2147483647   -- pos_long = INT_MAX
  let _ = fe_write_u8 s 255              -- heart_rate = invalid
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

-- Schedule message (msg 28): time_created + scheduled_time + type + completed
schedule_fields _ =
  let f4 = cons (fe_field 4 1 0) []           -- field 4: completed enum
  let f3 = cons (fe_field 5 1 0) f4           -- field 5: type enum
  let f2 = cons (fe_field 6 4 134) f3         -- field 6: scheduled_time
  cons (fe_field 0 4 134) f2                  -- field 0: manufacturer ... no, time_created is field 0 here

mut_schedule path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 7      -- type 7 = schedules
  let _ = fe_emit_def s 1 28 0 (schedule_fields 0)
  let _ = fe_write_u8 s 1
  let _ = fe_write_u32_le s 4294967295
  let _ = fe_write_u32_le s 4294967295
  let _ = fe_write_u8 s 255
  let _ = fe_write_u8 s 255
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

-- Goal message (msg 15): start_date + end_date + type + value
goal_fields _ =
  let f4 = cons (fe_field 3 4 134) []         -- field 3: value
  let f3 = cons (fe_field 4 1 0) f4           -- field 4: repeat enum
  let f2 = cons (fe_field 2 4 134) f3         -- field 2: end_date
  cons (fe_field 1 4 134) f2                  -- field 1: start_date

mut_goal path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 11     -- type 11 = goals
  let _ = fe_emit_def s 1 15 0 (goal_fields 0)
  let _ = fe_write_u8 s 1
  let _ = fe_write_u32_le s 4294967295
  let _ = fe_write_u32_le s 4294967295
  let _ = fe_write_u8 s 255
  let _ = fe_write_u32_le s 4294967295
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

-- DeleteFiles: file_id only (no extra record). Test if mere presence of
-- a valid FIT in DeleteFiles/ triggers anything beyond consumption.
mut_delete path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 4
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

main =
  let argv = args
  let out_dir = if length argv >= 2 then head (tail argv)
                else "~/garmin_recon/fuzz/fit_corpus_p5"
  let _ = shell (cat ["mkdir -p '", out_dir, "'"])
  let _ = print (cat ["pass-5 corpus -> ", out_dir])
  let _ = mut_activity (cat [out_dir, "/p5_activity.fit"])
  let _ = print "  p5_activity.fit"
  let _ = mut_record (cat [out_dir, "/p5_record.fit"])
  let _ = print "  p5_record.fit"
  let _ = mut_schedule (cat [out_dir, "/p5_schedule.fit"])
  let _ = print "  p5_schedule.fit"
  let _ = mut_goal (cat [out_dir, "/p5_goal.fit"])
  let _ = print "  p5_goal.fit"
  let _ = mut_delete (cat [out_dir, "/p5_delete.fit"])
  let _ = print "  p5_delete.fit"
  0
