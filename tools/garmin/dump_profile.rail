-- tools/garmin/dump_profile.rail — Extract user_profile (global=3) from a
-- Settings.fit file. Prints age/weight/height/HRmax/zones if present.
--
-- Usage:
--   ./rail_native run tools/garmin/dump_profile.rail <Settings.fit>

import "stdlib/fit.rail"
import "stdlib/fmt.rail"

profile_observe acc schema buf rec_off nf arch j =
  if j >= nf then 0
  else
    let fdef = schema_field_def schema j
    let sz = schema_field_size schema j
    let bt = schema_field_type schema j
    let foff = rec_off + schema_field_offset schema j
    let dec = fit_decode_field buf foff sz bt arch
    let kind = arr_get dec 0
    let v = arr_get dec 1
    let _ = if kind != 3 then arr_set acc fdef v else 0
    profile_observe acc schema buf rec_off nf arch (j + 1)

zones_observe zones schema buf rec_off nf arch j =
  if j >= nf then 0
  else
    let fdef = schema_field_def schema j
    let sz = schema_field_size schema j
    let bt = schema_field_type schema j
    let foff = rec_off + schema_field_offset schema j
    let dec = fit_decode_field buf foff sz bt arch
    let kind = arr_get dec 0
    let v = arr_get dec 1
    let _ = if kind != 3 then arr_set zones fdef v else 0
    zones_observe zones schema buf rec_off nf arch (j + 1)

walk fit table acc zones cursor =
  let buf = fit_buf fit
  let endp = fit_data_end fit
  if cursor >= endp then 0
  else
    let h = arr_get buf cursor
    let after_hdr = cursor + 1
    if bit_and h 128 != 0 then 0
    else
      let local_id = bit_and h 15
      if bit_and h 64 != 0 then
        let has_dev = bit_and (shr h 5) 1
        let dr = parse_def buf after_hdr has_dev
        let schema = arr_get dr 0
        let after = arr_get dr 1
        let _ = arr_set table local_id schema
        walk fit table acc zones after
      else
        let schema = arr_get table local_id
        if schema == 0 then 0
        else
          let body = schema_total schema
          let g = schema_global schema
          let nf = schema_nfields schema
          let arch = schema_arch schema
          let _ = if g == 3 then profile_observe acc schema buf after_hdr nf arch 0
                  else if g == 8 then zones_observe zones schema buf after_hdr nf arch 0
                  else 0
          walk fit table acc zones (after_hdr + body)

main =
  let argv = args
  let path = if length argv >= 2 then head (tail argv) else "/Volumes/GARMIN/GARMIN/Settings/Settings.fit"
  let fit = fit_load path
  if fit_valid fit == 0 then
    let _ = print (cat ["invalid: ", path])
    1
  else
    let table = arr_new 16 0
    let acc = arr_new 256 (0 - 1)
    let zones = arr_new 256 (0 - 1)
    let _ = walk fit table acc zones (fit_data_off fit)
    let _ = print (cat ["Settings: ", path])
    let _ = print "------------------------------------------------"
    let gender = arr_get acc 1
    let age = arr_get acc 2
    let height = arr_get acc 3
    let weight = arr_get acc 4
    let max_run = arr_get acc 8
    let max_bike = arr_get acc 9
    let max_hr = arr_get acc 10
    let _ = if gender >= 0 then
              print (cat ["Gender         ", if gender == 0 then "female" else if gender == 1 then "male" else cat ["enum(", show gender, ")"]])
            else 0
    let _ = if age >= 0 && age != 255 then print (cat ["Age            ", show age, " yrs"]) else 0
    let _ = if height >= 0 && height != 255 then print (cat ["Height         ", show height, " cm"]) else 0
    let _ = if weight >= 0 && weight != 65535 then
              let kg_x10 = weight
              let kg = kg_x10 / 10
              let frac = kg_x10 - kg * 10
              print (cat ["Weight         ", show kg, ".", show frac, " kg"])
            else 0
    let _ = if max_hr >= 0 && max_hr != 255 then print (cat ["Default HR_max ", show max_hr, " bpm"]) else 0
    let _ = if max_run >= 0 && max_run != 255 then print (cat ["Run HR_max     ", show max_run, " bpm"]) else 0
    let _ = if max_bike >= 0 && max_bike != 255 then print (cat ["Bike HR_max    ", show max_bike, " bpm"]) else 0
    let _ = print ""
    let _ = print "HR zone thresholds (global=8 hr_zone msg, fdef=1 high_bpm):"
    let z1 = arr_get zones 1
    let _ = if z1 >= 0 then print (cat ["  hr_zone field 1 = ", show z1]) else print "  (no hr_zone messages found)"
    0
