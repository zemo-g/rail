-- tools/garmin/fuzz_fit_pass3.rail - Pass-3 FIT mutator.
--
-- Pass-2 confirmed the file_id gate filters on (serial AND product AND
-- manufacturer AND type AND time-window). Pass-3 PASSES THE GATE (valid
-- file_id with this watch's identity) and then attaches a SECOND record
-- with hostile field values. Tests whether the parser keeps validating
-- after the gate or trusts post-gate records.
--
-- Strategies:
--   p3_two_file_ids       gate passes, then a SECOND file_id with conflict
--   p3_session_after_fid  gate passes, then a session msg with edge values
--   p3_huge_string        gate passes, then a 200-byte string field
--   p3_many_records       gate passes, then 100 file_id records back-to-back
--   p3_bogus_base_type    gate passes, then a def with base_type=0xFF (invalid)

import "stdlib/fit_emit.rail"

gate_passing_file_id _ =
  let f5 = cons (fe_field 0 1 0) []
  let f4 = cons (fe_field 2 2 132) f5
  let f3 = cons (fe_field 1 2 132) f4
  let f2 = cons (fe_field 4 4 134) f3
  cons (fe_field 3 4 140) f2

emit_gate_passing_payload s =
  let _ = fe_write_u32_le s 3422906732
  let _ = fe_write_u32_le s 1145000000
  let _ = fe_write_u16_le s 1
  let _ = fe_write_u16_le s 3126
  let _ = fe_write_u8 s 4
  0

mut_two_file_ids path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s
  let _ = fe_write_u8 s 0
  let _ = fe_write_u32_le s 4294967295
  let _ = fe_write_u32_le s 4294967295
  let _ = fe_write_u16_le s 65535
  let _ = fe_write_u16_le s 65535
  let _ = fe_write_u8 s 255
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

session_fields _ =
  let f3 = cons (fe_field 6 1 0) []
  let f2 = cons (fe_field 5 1 0) f3
  let f1 = cons (fe_field 1 1 0) f2
  cons (fe_field 0 1 0) f1

mut_session_after_fid path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s
  let _ = fe_emit_def s 1 18 0 (session_fields 0)
  let _ = fe_write_u8 s 1
  let _ = fe_write_u8 s 8
  let _ = fe_write_u8 s 1
  let _ = fe_write_u8 s 255
  let _ = fe_write_u8 s 255
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

huge_string_fields _ = cons (fe_field 0 200 7) []

mut_zero_loop s n i =
  if i >= n then 0
  else
    let _ = fe_write_u8 s 0
    mut_zero_loop s n (i + 1)

mut_huge_string path =
  let s = fe_new 512
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s
  let _ = fe_emit_def s 1 0 0 (huge_string_fields 0)
  let _ = fe_write_u8 s 1
  let _ = mut_zero_loop s 200 0
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

mut_record_loop s i n =
  if i >= n then 0
  else
    let _ = fe_write_u8 s 0
    let _ = emit_gate_passing_payload s
    mut_record_loop s (i + 1) n

mut_many_records path =
  let s = fe_new 4096
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s
  let _ = mut_record_loop s 0 100
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

mut_bogus_base_type path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s
  let bogus = cons (fe_field 0 4 255) []
  let _ = fe_emit_def s 1 18 0 bogus
  let _ = fe_write_u8 s 1
  let _ = fe_write_u32_le s 0
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

main =
  let argv = args
  let out_dir = if length argv >= 2 then head (tail argv)
                else "~/garmin_recon/fuzz/fit_corpus_p3"
  let _ = shell (cat ["mkdir -p '", out_dir, "'"])
  let _ = print (cat ["pass-3 corpus -> ", out_dir])
  let _ = mut_two_file_ids (cat [out_dir, "/p3_two_file_ids.fit"])
  let _ = print "  p3_two_file_ids.fit"
  let _ = mut_session_after_fid (cat [out_dir, "/p3_session_after_fid.fit"])
  let _ = print "  p3_session_after_fid.fit"
  let _ = mut_huge_string (cat [out_dir, "/p3_huge_string.fit"])
  let _ = print "  p3_huge_string.fit"
  let _ = mut_many_records (cat [out_dir, "/p3_many_records.fit"])
  let _ = print "  p3_many_records.fit"
  let _ = mut_bogus_base_type (cat [out_dir, "/p3_bogus_base_type.fit"])
  let _ = print "  p3_bogus_base_type.fit"
  0
