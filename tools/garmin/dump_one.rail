-- tools/garmin/dump_one.rail — Decode a single FIT file and print one
-- summary line. Designed to be invoked once per file from a shell loop
-- (see tools/garmin/dump.sh) so each FIT decode runs in a fresh process.
--
-- Usage:
--   ./rail_native run tools/garmin/dump_one.rail <path>

import "stdlib/fit.rail"
import "stdlib/fmt.rail"

sport_name n =
  if n == 0 then "generic"
  else if n == 1 then "running"
  else if n == 2 then "cycling"
  else if n == 5 then "swimming"
  else if n == 11 then "walking"
  else if n == 13 then "alpine_ski"
  else if n == 14 then "snowboarding"
  else if n == 15 then "rowing"
  else if n == 17 then "hiking"
  else if n == 19 then "paddling"
  else cat ["sport(", show n, ")"]

file_type_name n =
  if n == 1 then "device"
  else if n == 2 then "settings"
  else if n == 3 then "sport"
  else if n == 4 then "activity"
  else if n == 5 then "workout"
  else if n == 6 then "course"
  else if n == 7 then "schedules"
  else if n == 9 then "weight"
  else if n == 10 then "totals"
  else if n == 14 then "blood_pressure"
  else if n == 15 then "monitoring_a"
  else if n == 20 then "activity_sum"
  else if n == 28 then "monitor_daily"
  else if n == 32 then "monitoring_b"
  else cat ["type(", show n, ")"]

fmt_distance raw =
  if raw <= 0 then "-"
  else if raw < 100000 then cat [show (raw / 100), " m"]
  else
    let km_int = raw / 100000
    let hundredths = (raw / 1000) - km_int * 100
    cat [show km_int, ".", zero_pad hundredths 2, " km"]

fmt_timer raw =
  if raw <= 0 then "-"
  else
    let secs = raw / 1000
    let h = secs / 3600
    let m = (secs / 60) - h * 60
    let s = secs - (secs / 60) * 60
    if h > 0 then cat [show h, ":", zero_pad m 2, ":", zero_pad s 2]
    else cat [show m, ":", zero_pad s 2]

session_line st =
  let last_ts = arr_get st 3
  let unix_t = if last_ts > 0 then fit_unix_of last_ts else 0
  cat ["sport=", rpad (sport_name (arr_get st 4)) 10,
       " ", lpad (fmt_distance (arr_get st 6)) 10,
       " ", lpad (fmt_timer (arr_get st 7)) 9,
       " hr_avg=", lpad (show (arr_get st 8)) 3,
       " end=", fit_fmt_unix_utc unix_t]

meta_line st =
  let last_ts = arr_get st 3
  let tail_str = if last_ts > 0 then
                   cat [" end=", fit_fmt_unix_utc (fit_unix_of last_ts)]
                 else ""
  cat ["def=", lpad (show (arr_get st 1)) 2,
       " data=", lpad (show (arr_get st 2)) 4,
       tail_str]

main =
  let argv = args
  let path = if length argv >= 2 then head (tail argv) else ""
  if length (chars path) == 0 then
    let _ = print "usage: rail_native run tools/garmin/dump_one.rail <path>"
    1
  else
    let fit = fit_load path
    let size = if fit_valid fit == 0 then 0 else fit_total fit
    let prefix = cat [rpad path 56, "  ", lpad (show size) 8, " B  "]
    if fit_valid fit == 0 then
      let _ = print (cat [prefix, "invalid"])
      0
    else
      let st = fit_summarize fit
      let body = if arr_get st 5 == 1 then session_line st else meta_line st
      let _ = print (cat [prefix, rpad (file_type_name (arr_get st 9)) 14, " ", body])
      0
