-- tools/garmin/gcd_dump.rail - dump the record structure of a GCD file.
--
-- Usage:
--   ./rail_native run tools/garmin/gcd_dump.rail <path-to-GCD>

import "stdlib/gcd.rail"

main =
  let argv = args
  let path = if length argv >= 2 then head (tail argv) else ""
  if length (chars path) == 0 then
    let _ = print "usage: rail_native run tools/garmin/gcd_dump.rail <path>"
    1
  else
    let g = gcd_load path
    if gcd_valid g == 0 then
      let _ = print (cat ["INVALID GCD: ", path])
      1
    else
      let _ = print (cat ["=== ", path, " ==="])
      let _ = print (cat ["GARMIN  V", show (gcd_version g / 100),
                          ".", show (gcd_version g - (gcd_version g / 100) * 100),
                          "  total=", show (gcd_total g), " bytes"])
      let _ = print "----------------------------------------------------------------------"
      let _ = gcd_walk g
      let _ = print "----------------------------------------------------------------------"
      let _ = gcd_extract_streams g ""
      0
