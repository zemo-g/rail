-- tools/garmin/fuzz_fit_pass6.rail - Pass-6 deep fuzz on the two real parsers.
--
-- Pass 5 narrowed the attack surface to just THREE real parsers:
--   NewFiles/  (hardened, exhausted)
--   Workouts/  (real parser, ~10 extra evnt lines per drop)
--   Settings/  (real parser, ~10 extra evnt lines per drop)
--
-- Pass 6 ships schema-RICH mutations targeting the latter two:
--
--   p6_workout_basic.fit    Workouts/  - file_id + workout(msg26) basic
--   p6_workout_steps.fit    Workouts/  - file_id + workout + 50 workout_step(msg27)
--                                        records with cycling local_ids and
--                                        edge field values
--   p6_workout_overflow.fit Workouts/  - file_id + workout with num_valid_steps
--                                        = 0xFFFFFFFF (overflow if used as count)
--   p6_settings_basic.fit   Settings/  - file_id + device_settings(msg2)
--   p6_settings_profile.fit Settings/  - file_id + user_profile(msg3) with
--                                        hostile age/weight/height/gender
--   p6_settings_hrzone.fit  Settings/  - file_id + hr_zone(msg8) with
--                                        out-of-order zone boundaries
--   p6_settings_multi.fit   Settings/  - file_id + many records of different
--                                        message types interleaved
--
-- All FITs pass the integrity gates (valid CRC, valid data_size, structural
-- sanity, matching this watch's serial+product+mfg).

import "stdlib/fit_emit.rail"

gate_passing_file_id _ =
  let f5 = cons (fe_field 0 1 0) []
  let f4 = cons (fe_field 2 2 132) f5
  let f3 = cons (fe_field 1 2 132) f4
  let f2 = cons (fe_field 4 4 134) f3
  cons (fe_field 3 4 140) f2

emit_gate_passing_payload s file_type =
  let _ = fe_write_u32_le s 3422906732
  let _ = fe_write_u32_le s 1145000000
  let _ = fe_write_u16_le s 1
  let _ = fe_write_u16_le s 3126
  let _ = fe_write_u8 s file_type
  0

-- ===== Workouts ===========================================================

-- workout (msg 26): wkt_name(string,15) + sport(enum) + capabilities(uint32z)
--                    + num_valid_steps(uint16) + protection(uint16)
workout_fields _ =
  let f5 = cons (fe_field 11 2 132) []      -- protection
  let f4 = cons (fe_field 6 2 132) f5        -- num_valid_steps (overload)
  let f3 = cons (fe_field 5 4 140) f4        -- capabilities (uint32z)
  let f2 = cons (fe_field 4 1 0) f3          -- sport (enum)
  cons (fe_field 8 15 7) f2                  -- wkt_name (string 15B)

mut_workout_basic path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 5     -- type 5 = workout
  let _ = fe_emit_def s 1 26 0 (workout_fields 0)
  let _ = fe_write_u8 s 1
  -- payload: 15-byte name (no NUL), 1B sport, 4B caps, 2B num_steps, 2B protection
  let _ = mut_namebytes s 65 0
  let _ = fe_write_u8 s 0                    -- sport = generic
  let _ = fe_write_u32_le s 0                -- caps
  let _ = fe_write_u16_le s 1                -- num_steps = 1
  let _ = fe_write_u16_le s 0                -- protection
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

mut_namebytes s b i =
  if i >= 15 then 0
  else
    let _ = fe_write_u8 s b
    mut_namebytes s b (i + 1)

mut_workout_overflow path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 5
  let _ = fe_emit_def s 1 26 0 (workout_fields 0)
  let _ = fe_write_u8 s 1
  let _ = mut_namebytes s 65 0
  let _ = fe_write_u8 s 255                  -- invalid sport
  let _ = fe_write_u32_le s 4294967295       -- caps = max
  let _ = fe_write_u16_le s 65535            -- num_valid_steps = 0xFFFF
  let _ = fe_write_u16_le s 65535            -- protection = max
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

-- workout_step (msg 27): step_name(string,16) + duration_type(enum)
--                         + duration_value(uint32) + target_type(enum)
--                         + target_value(uint32) + intensity(enum)
workout_step_fields _ =
  let f5 = cons (fe_field 7 1 0) []          -- intensity
  let f4 = cons (fe_field 5 4 134) f5        -- target_value
  let f3 = cons (fe_field 4 1 0) f4          -- target_type
  let f2 = cons (fe_field 1 4 134) f3        -- duration_value
  cons (fe_field 0 1 0) f2                   -- duration_type

mut_workout_steps path =
  let s = fe_new 4096
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 5
  let _ = fe_emit_def s 1 26 0 (workout_fields 0)
  let _ = fe_write_u8 s 1
  let _ = mut_namebytes s 65 0
  let _ = fe_write_u8 s 0
  let _ = fe_write_u32_le s 0
  let _ = fe_write_u16_le s 50               -- claim 50 steps
  let _ = fe_write_u16_le s 0
  let _ = fe_emit_def s 2 27 0 (workout_step_fields 0)
  let _ = mut_step_loop s 0 50
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

mut_step_loop s i n =
  if i >= n then 0
  else
    let _ = fe_write_u8 s 2                  -- local_id 2
    let _ = fe_write_u8 s 0                  -- duration_type
    let _ = fe_write_u32_le s 4294967295     -- duration_value = max
    let _ = fe_write_u8 s 0                  -- target_type
    let _ = fe_write_u32_le s 4294967295     -- target_value = max
    let _ = fe_write_u8 s 255                -- intensity = max
    mut_step_loop s (i + 1) n

-- ===== Settings ==========================================================

-- device_settings (msg 2): timestamp + utc_offset + time_offset + time_mode + ...
-- v0: small subset
device_settings_fields _ =
  let f3 = cons (fe_field 4 1 0) []          -- backlight_mode
  let f2 = cons (fe_field 5 1 0) f3          -- time_mode
  cons (fe_field 1 4 134) f2                 -- utc_offset

mut_settings_basic path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 2     -- type 2 = settings
  let _ = fe_emit_def s 1 2 0 (device_settings_fields 0)
  let _ = fe_write_u8 s 1
  let _ = fe_write_u32_le s 4294967295       -- utc_offset
  let _ = fe_write_u8 s 255                  -- time_mode
  let _ = fe_write_u8 s 255                  -- backlight_mode
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

-- user_profile (msg 3): friendly_name + gender + age + height + weight + ...
user_profile_fields _ =
  let f4 = cons (fe_field 4 2 132) []        -- weight (10g units)
  let f3 = cons (fe_field 3 1 2) f4          -- height
  let f2 = cons (fe_field 2 1 2) f3          -- age
  cons (fe_field 1 1 0) f2                   -- gender

mut_settings_profile path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 2
  let _ = fe_emit_def s 1 3 0 (user_profile_fields 0)
  let _ = fe_write_u8 s 1
  let _ = fe_write_u8 s 255                  -- gender = invalid
  let _ = fe_write_u8 s 255                  -- age = invalid (no human is 255)
  let _ = fe_write_u8 s 0                    -- height = 0 cm (invalid)
  let _ = fe_write_u16_le s 65535            -- weight = max
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

-- hr_zone (msg 8): high_bpm[5] - the 5 zone boundaries
-- We emit them OUT OF ORDER (zone 4 < zone 1) - if the firmware doesn't sanity
-- check, this could trigger zone arithmetic underflow.
hr_zone_fields _ =
  cons (fe_field 1 1 2) []                   -- high_bpm

mut_settings_hrzone path =
  let s = fe_new 256
  let _ = fe_emit_header s 0
  let _ = fe_emit_def s 0 0 0 (gate_passing_file_id 0)
  let _ = fe_write_u8 s 0
  let _ = emit_gate_passing_payload s 2
  let _ = fe_emit_def s 1 8 0 (hr_zone_fields 0)
  -- 5 zones, in DESCENDING order (zone 0 = highest = 200, zone 4 = lowest = 100)
  let _ = fe_write_u8 s 1
  let _ = fe_write_u8 s 200
  let _ = fe_write_u8 s 1
  let _ = fe_write_u8 s 175
  let _ = fe_write_u8 s 1
  let _ = fe_write_u8 s 150
  let _ = fe_write_u8 s 1
  let _ = fe_write_u8 s 125
  let _ = fe_write_u8 s 1
  let _ = fe_write_u8 s 100
  let _ = fe_emit_trailing_crc s 0
  let _ = fe_finalize s
  fe_save s path

main =
  let argv = args
  let out_dir = if length argv >= 2 then head (tail argv)
                else "/Users/user/garmin_recon/fuzz/fit_corpus_p6"
  let _ = shell (cat ["mkdir -p '", out_dir, "'"])
  let _ = print (cat ["pass-6 corpus -> ", out_dir])
  let _ = mut_workout_basic (cat [out_dir, "/p6_workout_basic.fit"])
  let _ = print "  p6_workout_basic.fit"
  let _ = mut_workout_overflow (cat [out_dir, "/p6_workout_overflow.fit"])
  let _ = print "  p6_workout_overflow.fit"
  let _ = mut_workout_steps (cat [out_dir, "/p6_workout_steps.fit"])
  let _ = print "  p6_workout_steps.fit (50 steps with edge values)"
  let _ = mut_settings_basic (cat [out_dir, "/p6_settings_basic.fit"])
  let _ = print "  p6_settings_basic.fit"
  let _ = mut_settings_profile (cat [out_dir, "/p6_settings_profile.fit"])
  let _ = print "  p6_settings_profile.fit (hostile age/weight)"
  let _ = mut_settings_hrzone (cat [out_dir, "/p6_settings_hrzone.fit"])
  let _ = print "  p6_settings_hrzone.fit (descending zones)"
  0
