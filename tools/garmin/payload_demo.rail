-- tools/garmin/payload_demo.rail - End-to-end Rail -> Cortex-M Thumb-2 demo.
--
-- Builds a complete (toy) bare-metal payload:
--   * vector table (initial SP + reset + 14 system handlers + 16 IRQ handlers)
--   * reset stub:  bl main; b halt
--   * main:        write 0xDEADBEEF to MMIO 0x40047024 (SIM_SDID address);
--                  read MMIO 0x4002C000 (DSPI0 base) into r3;
--                  return.
--   * halt:        b .
--
-- The output is a raw binary buffer; we disassemble it to verify
-- structure end-to-end.

import "stdlib/thumb2.rail"
import "stdlib/cortexm_runtime.rail"
-- thumb2_asm and thumb2_emit are pulled in transitively via cortexm_runtime;
-- importing them directly would double-include their symbols and crash `as`.

print_word_grid buf n cols =
  print_word_grid_loop buf n cols 0 ""

print_word_grid_loop buf n cols i acc =
  if i >= n then print acc
  else
    let b = arr_get buf i
    let hi = bit_and (shr b 4) 15
    let lo = bit_and b 15
    let ch = if hi < 10 then char_from_int (48 + hi) else char_from_int (87 + hi)
    let cl = if lo < 10 then char_from_int (48 + lo) else char_from_int (87 + lo)
    let new_acc = cat [acc, ch, cl]
    let nl_break = (bit_and (i + 1) 15) == 0
    let nl = if nl_break then "\n" else " "
    if nl_break then
      let _ = print new_acc
      print_word_grid_loop buf n cols (i + 1) ""
    else print_word_grid_loop buf n cols (i + 1) (cat [new_acc, " "])

main =
  let _ = print "=== Rail -> Cortex-M Thumb-2 payload build ==="

  -- Place the binary at flash address 0x2000 (matches the Instinct's
  -- application Reset_Handler convention from Phase 2 disassembly).
  let s = asm_new 8192

  -- Declare labels for vector-table targets and code regions.
  let l_reset = asm_decl_label s
  let l_halt = asm_decl_label s
  let l_main = asm_decl_label s

  -- Sketch a 16-IRQ device for compactness (real chip has 100ish).
  let _ = cm_emit_vector_table s 537001984 l_reset l_halt 16   -- sp = 0x20020000

  -- Reset stub:
  let _ = asm_label_here s l_reset
  let _ = cm_emit_reset s l_main l_halt

  -- Halt:
  let _ = cm_emit_halt s l_halt

  -- main:
  let _ = asm_label_here s l_main
  let _ = asm_push s 16 1                              -- push {r4, lr}
  let _ = cm_mmio_w32 s 1074033700 3735928559          -- *(0x40047024) = 0xDEADBEEF
  let _ = cm_mmio_r32 s 3 1073922048                   -- r3 = *(0x4002C000)
  let _ = asm_pop s 16 1                               -- pop {r4, pc}

  let total = cm_finalize s
  let buf = asm_buf s
  let _ = print (cat ["assembled ", show total, " bytes"])
  let _ = print "raw bytes (16 per row):"
  let _ = print_word_grid buf total 16
  let _ = print "\n=== disassembly ==="
  let _ = t2_disasm buf 0 total 64
  0
