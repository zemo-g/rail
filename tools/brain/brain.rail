-- tools/brain/brain.rail — empire's Brain (v0 scaffold)
--
-- One Rail process, five modules behind one tick. Sits beside
-- cortex.rail; cortex.rail can dispatch into brain as one of its
-- whitelisted tools when it wants to delegate richer reasoning.
--
-- Modules (sections in this file for v0; split into files when one
-- outgrows ~150 lines):
--   memory        — short-term log + long-term k=v store on disk
--   cognition     — current goal, plan, next step (stub for now)
--   common_sense  — sanity bounds on plan steps (stub for now)
--   meta          — watches the others; can rewrite their state (stub)
--   speech        — output gating + channel routing (stub)
--
-- State persists to ~/.ledatic/brain/. Every tick appends to the
-- short-term log so we can see the cognitive pipeline run end-to-end.

brain_dir _ = "/Users/ledaticempire/.ledatic/brain"

ensure_brain_dir _ =
  let _ = shell (cat ["mkdir -p ", brain_dir 0])
  0

-- ── helpers ────────────────────────────────────────────────────────
sq_esc s = str_replace "'" "'\\''" s

trim_nl s =
  if length s == 0 then s
  else
    let last = str_sub s (length s - 1) 1
    if last == "\n" then str_sub s 0 (length s - 1)
    else s

now_iso _ = trim_nl (shell "date -u +%Y-%m-%dT%H:%M:%SZ")

-- ── memory ────────────────────────────────────────────────────────
short_term_file _ = cat [brain_dir 0, "/short_term.log"]
long_term_file _ = cat [brain_dir 0, "/long_term.kv"]

memory_append kind content =
  let line = cat [now_iso 0, "\t", kind, "\t", content]
  let cmd = cat ["printf '%s\\n' '", sq_esc line, "' >> ", short_term_file 0]
  let _ = shell cmd
  0

memory_recall_recent n =
  shell (cat ["tail -n ", show n, " ", short_term_file 0, " 2>/dev/null"])

memory_get key =
  let cmd = cat ["grep '^", key, "=' ", long_term_file 0, " 2>/dev/null | tail -1 | sed 's/^[^=]*=//'"]
  trim_nl (shell cmd)

memory_set key val =
  let cmd = cat ["printf '%s=%s\\n' '", sq_esc key, "' '", sq_esc val, "' >> ", long_term_file 0]
  let _ = shell cmd
  0

memory_tick _ =
  let _ = memory_append "tick" "memory"
  0

-- ── cognition (stub) ───────────────────────────────────────────────
-- Will own: goal selection, plan generation, next-step extraction.
-- v0 just records that it ticked.
cognition_tick _ =
  let _ = memory_append "tick" "cognition"
  0

-- ── common_sense (stub) ────────────────────────────────────────────
-- Will own: sanity bounds on plan steps. Reject impossible asks
-- before they reach speech.
common_sense_tick _ =
  let _ = memory_append "tick" "common_sense"
  0

-- ── meta (stub) ────────────────────────────────────────────────────
-- Will own: watches the other four, rewrites their state when they
-- get stuck. Notices ruts, triggers a goal review.
meta_tick _ =
  let _ = memory_append "tick" "meta"
  0

-- ── perception ────────────────────────────────────────────────────
-- v0: a single text file Slack writes into. Returns "" if no
-- perception is pending. After consuming, perception.txt is cleared.
perception_file _ = cat [brain_dir 0, "/perception.txt"]
response_file _   = cat [brain_dir 0, "/last_response.txt"]

read_perception _ =
  let raw = shell (cat ["cat ", perception_file 0, " 2>/dev/null"])
  trim_nl raw

clear_perception _ =
  let _ = shell (cat ["rm -f ", perception_file 0])
  0

write_response text =
  let cmd = cat ["printf '%s\\n' '", sq_esc text, "' > ", response_file 0]
  let _ = shell cmd
  0

-- ── speech ─────────────────────────────────────────────────────────
-- v0: writes a response to ~/.ledatic/brain/last_response.txt for
-- whoever invoked us to pick up. Slack listener does the actual
-- posting. Future: speech decides WHETHER to respond at all and
-- WHICH channel it belongs in.
speech_tick perception =
  let _ = memory_append "tick" "speech"
  let body =
    if length perception == 0 then "(no perception this tick — silent)"
    else
      cat ["heard: \"", perception, "\"\n",
           "thought trace (this tick):\n",
           memory_recall_recent 6]
  let _ = write_response body
  0

-- ── tick orchestration ─────────────────────────────────────────────
-- Linear pipeline: perception → memory → cognition → common_sense →
-- meta → speech. Each module can read from memory; only memory +
-- speech persist side-effects beyond the tick.
tick perception =
  let _ = if length perception > 0 then memory_append "perception" perception else 0
  let _ = memory_tick 0
  let _ = cognition_tick 0
  let _ = common_sense_tick 0
  let _ = meta_tick 0
  let _ = speech_tick perception
  0

main =
  let _ = ensure_brain_dir 0
  let perception = read_perception 0
  let _ = print "brain v0: tick begin"
  let _ = if length perception > 0
            then print (cat ["perception: ", perception])
            else print "perception: (empty)"
  let _ = tick perception
  let _ = clear_perception 0
  let _ = print "brain v0: tick end. response written to last_response.txt"
  0
