# Sample program: writes 0xDEADBEEF to a fake MMIO address, reads back,
# computes a value, writes it elsewhere, halts.
#
# Compile with:
#   ./rail_native run tools/cortexm/compile_cm.rail tools/cortexm/sample.cm

# Stage a 32-bit constant in r4 (will be our value-to-write).
load_imm32 r4 0xDEADBEEF

# Address register r5 = 0x40047424 (a fake "SIM_SDID-ish" location).
load_imm32 r5 0x40047424

# Write r4 to *r5
mmio_w r5 r4

# Address register r6 = 0x4002C000 (DSPI0 base on Kinetis K6x)
load_imm32 r6 0x4002C000

# Read into r7
mmio_r r7 r6

# Compute r4 = r4 + r7 (just so we exercise ADDS reg-form)
add r4 r4 r7

# Multiply r4 by r7 in place (exercise MULS)
mul r4 r7

# Subtract r7 from r4
sub r4 r4 r7

# Move r4 to r0 (return value of main)
mov r0 r4

# A nop just to confirm the encoder
nop
