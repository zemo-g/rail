-- test_bitops.cm - exercise bit-op operators in v1 compiler.
-- Validates AND, OR, XOR, SHL, SHR all parse and emit correct Thumb-2.

main =
  let a = 0xCAFE
  let b = 0xF0F0
  let c = a & b           -- 0xC0F0
  let d = a | b           -- 0xFAFE
  let e = a ^ b           -- 0x3A0E
  let f = 1 << 8           -- 0x100
  let g = 0xFF00 >> 4      -- 0x0FF0
  -- Combine - mask bottom 4 bits and shift to top:
  let h = (0xABCD & 0xF) << 4    -- 0xD0
  -- Return last computed value in r0 for inspection.
  h
