-- tools/cortexm/lcd_clear.cm - Sharp Memory LCD CLEAR command via Kinetis DSPI0.
--
-- Real Cortex-M firmware shape: configures DSPI0 peripheral as master,
-- 8-bit frame, LSB-first; pulls CS high; pushes the 2-byte CLEAR command
-- (0x20, 0x00) through DSPI_PUSHR; polls DSPI_SR for transfer-complete;
-- pulls CS low; loops with a delay between clears (the LCD's COM-inversion
-- requirement: must keep refreshing or it ages out).
--
-- Kinetis K6x DSPI0 register map (0x4002C000 base):
--   DSPI_MCR    + 0x00  master control (master enable, halt, clear FIFO)
--   DSPI_TCR    + 0x08  transfer counter
--   DSPI_CTAR0  + 0x0C  clock and transfer attributes
--   DSPI_SR     + 0x2C  status (TCF = bit 31)
--   DSPI_PUSHR  + 0x34  TX FIFO push (data + CTAR-select + EOQ + CS-flags)
--
-- GPIO C (Sharp LCD CS pin assumed on PORTC bit 0):
--   GPIOC_PDOR  0x400FF080  port C data output
--   GPIOC_PDDR  0x400FF094  port C data direction
--   PORTC_PCR0  0x4004B000  pin-control register for muxing
--
-- This is a v0 - register addresses are best-guess from K6x family memory
-- map; exact pinout and CTAR baud-rate values need confirmation against
-- the actual Instinct schematic. The COMPILER produces byte-correct Thumb-2
-- regardless; once the addresses are pinned, this program runs.
--
-- Total: 8 locals, nested control flow, 25+ MMIO ops. v1 compiler stress test.

main =
  -- Stage all base addresses up front (8 locals exactly).
  let dspi_mcr = 0x4002C000
  let dspi_ctar0 = 0x4002C00C
  let dspi_sr = 0x4002C02C
  let dspi_pushr = 0x4002C034
  let portc_dout = 0x400FF080
  let portc_dir = 0x400FF094
  let cs_mask = 0x00000001
  let cycles = 100

  -- Configure CS pin as GPIO output.
  mmio_w portc_dir cs_mask

  -- DSPI master mode, halt asserted (no transfers yet); clear TX/RX FIFOs.
  -- MCR = MSTR | HALT | CLR_TXF | CLR_RXF = 0x80018003
  mmio_w dspi_mcr 2147582979

  -- CTAR0: 8-bit frame, LSB-first, CPOL=0, CPHA=0, prescaler 7, scaler F
  -- = 0x38007007
  mmio_w dspi_ctar0 939556871

  -- Release halt: MCR = MSTR (no halt) = 0x80000000
  mmio_w dspi_mcr 2147483648

  -- Top loop: send CLEAR command repeatedly.
  let i = 0
  while i < cycles do
    -- Pull CS high (active high for Sharp Memory LCD).
    mmio_w portc_dout cs_mask

    -- Push first byte of CLEAR command (0x20). PUSHR layout:
    --   CONT=1 EOQ=0 CTCNT=0 CTAS=0 PCS=0 TXDATA=0x20  -> 0x80000020
    mmio_w dspi_pushr 2147483680

    -- Poll status for TCF (bit 31). Read SR until top bit set.
    let sr = mmio_r dspi_sr
    while sr < 2147483648 do
      let sr = mmio_r dspi_sr
    done

    -- Push second byte (0x00) with EOQ flag set to deassert PCS.
    -- CONT=0 EOQ=1 CTAS=0 PCS=0 TXDATA=0x00 -> 0x08000000
    mmio_w dspi_pushr 134217728

    -- Wait for completion again.
    let sr = mmio_r dspi_sr
    while sr < 2147483648 do
      let sr = mmio_r dspi_sr
    done

    -- Pull CS low, idle bus.
    mmio_w portc_dout 0

    let i = i + 1
  done

  -- Final result returned in r0 = number of cycles completed.
  mmio_r dspi_sr
