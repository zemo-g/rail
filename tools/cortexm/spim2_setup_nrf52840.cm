-- tools/cortexm/spim2_setup_nrf52840.cm - Configure nRF52840 SPIM2 peripheral.
--
-- Real nRF52840 firmware shape: configure SPIM2 with pin assignments,
-- frequency, ORDER (LSB-first per Sharp Memory LCD requirement), enable
-- the peripheral, and enter the wait-loop ready for TX. Full peripheral
-- bring-up sequence in 8 locals.
--
-- nRF52840 SPIM2 base = 0x40023000.
-- Register offsets (per Nordic nRF52840 Product Spec):
--   TASKS_START      0x010
--   TASKS_STOP       0x014
--   EVENTS_STOPPED   0x104
--   EVENTS_END       0x118
--   ENABLE           0x500   (write 7 to enable SPIM)
--   PSEL.SCK         0x508   (pin connected to SCK; bit 31 = disconnect)
--   PSEL.MOSI        0x50C
--   PSEL.MISO        0x510
--   PSEL.CSN         0x514
--   FREQUENCY        0x524   (8 MHz = 0x80000000; 4 MHz = 0x40000000)
--   RXD.PTR          0x534
--   RXD.MAXCNT       0x538
--   TXD.PTR          0x544
--   TXD.MAXCNT       0x548
--   CONFIG           0x554   (bit 0 = ORDER; 0=MSB-first, 1=LSB-first)
--
-- Pin assignments are guessed for a generic Sharp Memory LCD wiring on
-- the Instinct: SCK=P0.13, MOSI=P0.14, CSN=P0.15. Real wiring will be
-- pinned via a future firmware analysis pass on the actual GPIOTE
-- configure code.
--
-- This program does NOT transmit yet (we'd need a static TX buffer in
-- RAM, which v1 doesn't have - that's a v2 task). It only brings the
-- peripheral up. Once we have arrays in v2, we add the TX path.

main =
  let spim2_enable = 0x40023500
  let spim2_psel_sck = 0x40023508
  let spim2_psel_mosi = 0x4002350C
  let spim2_psel_csn = 0x40023514
  let spim2_frequency = 0x40023524
  let spim2_config = 0x40023554
  let spim2_psel_miso = 0x40023510
  let pin_sck = 13

  -- Disable peripheral first (write 0 to ENABLE).
  mmio_w spim2_enable 0

  -- Assign SCK to P0.13 (port=0, pin=13, connected). PSEL format:
  --   bits 0..4 = pin (0..31)
  --   bit 5 = port (0 or 1)
  --   bit 31 = disconnect (1 = unused)
  -- For P0.13: 0x00000000 | 13 = 13.
  mmio_w spim2_psel_sck pin_sck

  -- Assign MOSI to P0.14.
  mmio_w spim2_psel_mosi 14

  -- Assign CSN to P0.15.
  mmio_w spim2_psel_csn 15

  -- MISO unused: set bit 31 to disconnect.
  mmio_w spim2_psel_miso 2147483648

  -- Frequency = 8 MHz = M8 = 0x80000000.
  mmio_w spim2_frequency 2147483648

  -- CONFIG: bit 0 = ORDER (1 = LSB-first per Sharp Memory LCD spec)
  --         bit 1 = CPHA (0 = leading sample)
  --         bit 2 = CPOL (0 = active high)
  --         => CONFIG = 0x00000001
  mmio_w spim2_config 1

  -- Enable peripheral: write 7 to ENABLE.
  mmio_w spim2_enable 7

  -- Spin reading ENABLE register to confirm peripheral is up.
  let i = 0
  let n = 1000
  while i < n do
    let i = i + 1
  done

  -- Return current ENABLE value (should read back as 7).
  mmio_r spim2_enable
