-- Driver-style demo: GPIO bit toggle blink loop.
-- Targets Kinetis K6x GPIOC port at MMIO 0x400FF080 (PDOR) / 0x400FF094 (PDDR).
-- Toggles bit 8 (PORTC pin 8) in a delayed loop.
--
-- Realistic firmware code: 7 locals, nested while loops, MMIO writes,
-- arithmetic in the loop bodies. This is the kind of code a watchface's
-- GPIO scaffolding looks like before the SPI / display layer goes on top.

main =
  let port_dout = 0x400FF080
  let port_dir = 0x400FF094
  let pin_mask = 0x100
  let blink_count = 50
  let delay_inner = 1000

  mmio_w port_dir pin_mask

  let i = 0
  while i < blink_count do
    mmio_w port_dout pin_mask
    let j = 0
    while j < delay_inner do
      let j = j + 1
    done
    mmio_w port_dout 0
    let j = 0
    while j < delay_inner do
      let j = j + 1
    done
    let i = i + 1
  done
