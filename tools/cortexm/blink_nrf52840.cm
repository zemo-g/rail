-- tools/cortexm/blink_nrf52840.cm - GPIO toggle demo for Nordic nRF52840.
--
-- Real Nordic nRF52840 firmware shape: P0_DIRSET sets a pin as output,
-- P0_OUTSET drives it high, P0_OUTCLR drives it low. Tight delay loop
-- between toggles. This is the canonical "first-light" demo on Nordic.
--
-- nRF52840 GPIO (Port 0, base 0x50000000):
--   P0_OUT      0x50000504  data output (read or write)
--   P0_OUTSET   0x50000508  set bits (write 1s, no read-modify-write)
--   P0_OUTCLR   0x5000050C  clear bits
--   P0_IN       0x50000510  pin input
--   P0_DIR      0x50000514  direction (1 = output)
--   P0_DIRSET   0x50000518  set direction bits to output
--   P0_DIRCLR   0x5000051C  clear direction (back to input)
--   P0_LATCH    0x50000520
--   P0_PIN_CNF  0x50000700-0x5000077C  per-pin (32 regs, 4 B each)
--
-- Pin assignments on the actual Instinct PCB are unknown without a board
-- photo or a pin-cnf trace from the firmware. P0.13 is the LED on most
-- Nordic dev kits and a reasonable guess for any "user LED equivalent"
-- on the watch (likely the haptic motor or a backlight rail).
--
-- Re-targets the 7-local watchface skeleton with the correct nRF52840
-- register layout. Compiler unchanged - the v1 backend just emits
-- different MMIO constants.

main =
  let gpio_dirset = 0x50000518
  let gpio_outset = 0x50000508
  let gpio_outclr = 0x5000050C
  let pin_mask = 0x00002000      -- bit 13 = P0.13
  let cycles = 100
  let inner_delay = 10000

  -- Set the pin as output via DIRSET (write-1-to-set semantics).
  mmio_w gpio_dirset pin_mask

  let i = 0
  while i < cycles do
    mmio_w gpio_outset pin_mask
    let j = 0
    while j < inner_delay do
      let j = j + 1
    done
    mmio_w gpio_outclr pin_mask
    let j = 0
    while j < inner_delay do
      let j = j + 1
    done
    let i = i + 1
  done

  -- Return current OUTSET state in r0 for the bootloader to inspect.
  mmio_r gpio_outset
