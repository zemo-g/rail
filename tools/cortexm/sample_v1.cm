-- v1 sample: real Rail-flavored source with let, while, arithmetic, MMIO.
-- Behaviour:
--   counter = 0
--   while counter < 10:
--     mmio_w (0x40000000 + counter*4) (counter * 7)
--     counter = counter + 1
--   end
--   read 0x4002C000 into r0 (returned)

main =
  let base = 0x40000000
  let i = 0
  while i < 10 do
    mmio_w (base + i * 4) (i * 7)
    let i = i + 1
  done
  mmio_r 0x4002C000
