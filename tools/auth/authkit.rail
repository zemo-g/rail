-- tools/auth/authkit.rail — authenticated data structures, λ• model (Pillar 2, Stage A).
--
-- Stage A validates the construction as a PURE-RAIL LIBRARY (no compiler change): the SAME
-- lookup, run two ways. The Prover holds the full structure and emits a proof stream of shallow
-- projections; the Verifier holds ONLY the root digest and replays the proof, checking each node
-- against the running digest. Forging a wrong answer requires a sha256 collision.
-- (Stage B = a compiler desugar that derives Prover/Verifier from one `auth`-typed source.)
--
-- Canonical example: Merkle-tree membership. `fetch` is written once in spirit; here Prover and
-- Verifier share the projection/serialization and differ only in what they hold + emit/check.
--
-- Run: ./rail_native run tools/auth/authkit.rail
import "stdlib/sha256.rail"

type Tree = | Tip s | Bin l r

-- shallow projection: a node with its CHILDREN collapsed to their digests.
proj_of t = match t
  | Tip s -> cat ["T:", s]
  | Bin l r -> cat ["B:", digest l, ":", digest r]

-- digest of a (sub)tree = sha256 of its shallow projection (bottom-up Merkle root).
digest t = sha256_hex (proj_of t)

-- ── list helpers ─────────────────────────────────────────────────────
snoc xs x = reverse (cons x (reverse xs))
list_init xs = reverse (tail (reverse xs))
drop_n n xs = if n == 0 then xs else (if xs == [] then xs else drop_n (n - 1) (tail xs))
nth xs n = head (drop_n n xs)

is_tip pj = str_sub pj 0 2 == "T:"
tip_value pj = str_sub pj 2 (length (chars pj) - 2)

-- ── PROVER: holds the full tree; emits a projection at each node it opens ──
-- path: list of ints, 0=left, 1=right. Returns (value, proof_list).
prover_fetch t path proof = match t
  | Tip s -> (s, snoc proof (cat ["T:", s]))
  | Bin l r ->
      let proof2 = snoc proof (cat ["B:", digest l, ":", digest r])
      if head path == 0 then prover_fetch l (tail path) proof2
      else prover_fetch r (tail path) proof2

-- ── VERIFIER: holds ONLY `expected` (the root digest) + the proof; checks each step ──
verifier_fetch expected path proof =
  if proof == [] then error "proof exhausted"
  else
    let pj = head proof
    let rest = tail proof
    if sha256_hex pj != expected then error "digest mismatch (tampered / wrong root)"
    else if is_tip pj then tip_value pj
    else
      let parts = str_split ":" pj
      let dl = nth parts 1
      let dr = nth parts 2
      if head path == 0 then verifier_fetch dl (tail path) rest
      else verifier_fetch dr (tail path) rest

print_proof proof =
  if proof == [] then 0
  else
    let _ = print (cat ["    ", head proof])
    print_proof (tail proof)

show_result r =
  if is_error r then cat ["REJECT (", err_msg r, ")"]
  else cat ["accept value=", r]

main =
  let _ = print "=== Pillar 2 (Stage A): authenticated data structures, Merkle membership ==="
  let t = Bin (Bin (Tip "alpha") (Tip "bravo")) (Bin (Tip "charlie") (Tip "delta"))
  let root = digest t
  let _ = print (cat ["merkle root = ", root])
  -- path to "charlie" = R then L = [1, 0]
  let path = cons 1 (cons 0 [])
  let res = prover_fetch t path []
  let (val, proof) = res
  let _ = print (cat ["PROVER: value=", val, "  proof entries=", show (length proof)])
  let _ = print_proof proof
  -- Verifier holds ONLY root + proof (not the tree):
  let _ = print (cat ["VERIFIER (clean):    ", show_result (verifier_fetch root path proof)])
  -- Tamper: swap the last proof entry (the leaf projection) for a forgery, keep the root.
  let proof_bad = snoc (list_init proof) "T:HACKED"
  let _ = print (cat ["VERIFIER (tampered): ", show_result (verifier_fetch root path proof_bad)])
  -- Wrong root (forged digest) is also rejected:
  let _ = print (cat ["VERIFIER (bad root): ", show_result (verifier_fetch "deadbeef" path proof)])
  0
