-- tools/v5/test_asm.rail
-- v5 Phase 4a — verify the Rail assembler emits bytes identical to `as`.
--
-- Build a small .s source string in Rail, assemble it both ways, byte-diff.

import "tools/v5/asm.rail"

-- Hand-write an .s file containing every supported mnemonic.
test_source =
  cat [
    ".text\n",
    ".global _t\n",
    "_t:\n",
    "    mov  x16, #1\n",
    "    mov  x0,  #42\n",
    "    svc  #0x80\n",
    "    mov  x19, x10\n",
    "    add  x10, x19, x27\n",
    "    sub  x19, x27, x9\n",
    "    mul  x19, x10, x27\n",
    "    cmp  x19, x27\n",
    "    cmp  x9, #100\n",
    "    nop\n",
    "    ret\n"
  ]

-- Walk buf for n bytes, print hex.
show_bytes buf n = show_bytes_loop buf 0 n ""
show_bytes_loop buf i n acc =
  if i >= n then acc
  else
    let b = arr_get buf i
    let hi = bit_and (shr b 4) 15
    let lo = bit_and b 15
    let h = cat [hex_d hi, hex_d lo]
    let sep = if (i + 1) == n then "" else if bit_and (i + 1) 3 == 0 then " " else ""
    show_bytes_loop buf (i + 1) n (cat [acc, h, sep])

hex_d n =
  if n < 10 then char_from_int (48 + n)
  else char_from_int (87 + n)

main =
  let _ = write_file "/tmp/asm_test.s" test_source
  -- Run system `as` for ground truth, dump .text via otool.
  let _ = shell "as -arch arm64 -o /tmp/asm_test.o /tmp/asm_test.s && otool -t /tmp/asm_test.o | tail -n +3 > /tmp/asm_test.otool"
  let truth_raw = read_file "/tmp/asm_test.otool"
  let _ = print "===Ground truth (as + otool)==="
  let _ = print truth_raw

  -- Run our Rail assembler.
  let nbytes = asm_bytes_len test_source
  let _ = print (cat ["Rail asm says: ", show nbytes, " bytes"])
  let buf = asm_assemble test_source 1024
  let hex = show_bytes buf nbytes
  let _ = print (cat ["Rail bytes:    ", hex])
  0
