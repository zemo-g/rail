-- tools/v5/asm_gate.rail — the REAL acceptance gate for the assembler.
-- Reads /tmp/gate_insns.txt (one self-contained instruction per line, extracted
-- from genuine compile.rail .s output), assembles each via asm.rail, and writes
-- the decimal 32-bit word per line to /tmp/gate_rail.txt. A Python driver diffs
-- those words against system `as` (the ground truth). Replaces the curated
-- test_asm_full.rail fixture as the bar: a real .s must match `as` byte-for-byte.
import "tools/v5/asm.rail"
g_nl _ = char_from_int 10
g_slen s = length (chars s)

g_process lines acc =
  if lines == [] then acc
  else
    let line = head lines
    if (g_slen line) == 0 then g_process (tail lines) acc
    else
      let parts = asm_split_mn_ops (asm_ltrim line)
      let word = asm_encode_insn (head parts) (head (tail parts)) 0 []
      g_process (tail lines) (cat [acc, show word, g_nl 0])

main =
  let content = read_file "/tmp/gate_insns.txt"
  let _ = write_file "/tmp/gate_rail.txt" (g_process (str_split (g_nl 0) content) "")
  print "assembled /tmp/gate_insns.txt -> /tmp/gate_rail.txt"
