-- tools/v5/dyld_macho.rail — minimal CLASSIC (LC_DYLD_INFO, non-lazy) DYNAMIC
-- Mach-O executable in pure Rail. Binds a libSystem import into __DATA_CONST,__got
-- and calls it through a __stubs entry. No `as`, no `ld`, no `codesign`.
--
-- Spec (workflow-derived from a running `ld -no_fixup_chains` reference /tmp/min,
-- every field as-verified): ~/.ledatic/macho_dylink_spec.txt. macOS 26.3 arm64.
-- DEMO: _main = `bl getpid_stub ; mov x16,#1 ; svc #0x80`  -> exit(getpid()&0xff).
--
-- Build:  cd ~/projects/rail-https && ./rail_native --out-prefix /tmp/rd run tools/v5/dyld_macho.rail
--         /tmp/v5_dyld_demo ; echo $?    (expect nonzero = pid&0xff)

import "stdlib/macho.rail"
import "stdlib/codesign.rail"

-- ── layout constants (N=1 import, code_size=12) ─────────────────────────────
text_vm_base = 4294967296          -- 0x100000000
page = 16384                       -- 0x4000
ncmds_d      = 13
sizeofcmds_d = 864                 -- 72+232+152+72+48+24+80+32+24+32+24+56+16
lc_end_d     = 896                 -- 32 + 864
code_size_d  = 12                  -- bl + mov + svc
text_off_d   = 896
stubs_off_d  = 908                 -- align4(896+12)
got_off_d    = 16384
got_vm_d     = 4294983680          -- 0x100004000
text_vm_d    = 4294968192          -- 0x100000380 (= base+896)
stubs_vm_d   = 4294968204          -- 0x10000038c
linkedit_off = 32768               -- 2*page
linkedit_vm  = 4295000064          -- 0x100008000
linkedit_fsz = 408                 -- cs_off_d(32880)+sig_total_d(296)-linkedit_off(32768); must NOT exceed EOF (strict validation)
-- LINKEDIT subsection offsets (computed; see spec container-math)
bind_off_d   = 32768
bind_size_d  = 15
sym_off_d    = 32784               -- align8(32768+15)
nsyms_d      = 3
sym_size_d   = 48                  -- 3*16
ind_off_d    = 32832               -- 32784+48
ind_size_d   = 8                   -- 2*4
str_off_d    = 32840               -- 32832+8
str_raw_d    = 36                  -- 0x20,0x00 + "_getpid\0"(8) + "_main\0"(6) + "__mh_execute_header\0"(20)
cs_off_d     = 32880               -- align16(32840+36=32876)
sig_total_d  = 296                 -- cs_total_size_n(32880): 3 code pages -> cd 256 + 40
-- strtab name offsets
strx_getpid = 2
strx_main   = 10
strx_mh     = 16

-- ── section_64 (80 bytes) ───────────────────────────────────────────────────
emit_section64 buf off sect seg addr size foff align flags r1 r2 =
  let s1 = mw_str_padded buf off sect 16
  let s2 = mw_str_padded buf s1 seg 16
  let s3 = mw_u64 buf s2 addr
  let s4 = mw_u64 buf s3 size
  let s5 = mw_u32 buf s4 foff
  let s6 = mw_u32 buf s5 align
  let s7 = mw_u32 buf s6 0
  let s8 = mw_u32 buf s7 0
  let s9 = mw_u32 buf s8 flags
  let s10 = mw_u32 buf s9 r1
  let s11 = mw_u32 buf s10 r2
  mw_u32 buf s11 0

-- LC_SEGMENT_64 __TEXT with __text + __stubs (cmdsize 232)
emit_seg_text2 buf off =
  let o1 = mw_u32 buf off 25
  let o2 = mw_u32 buf o1 232
  let o3 = mw_str_padded buf o2 "__TEXT" 16
  let o4 = mw_u64 buf o3 text_vm_base
  let o5 = mw_u64 buf o4 page
  let o6 = mw_u64 buf o5 0
  let o7 = mw_u64 buf o6 page
  let o8 = mw_u32 buf o7 5
  let o9 = mw_u32 buf o8 5
  let o10 = mw_u32 buf o9 2
  let o11 = mw_u32 buf o10 0
  let a = emit_section64 buf o11 "__text" "__TEXT" text_vm_d code_size_d text_off_d 0 2147484672 0 0
  emit_section64 buf a "__stubs" "__TEXT" stubs_vm_d code_size_d stubs_off_d 2 2147484680 0 12

-- LC_SEGMENT_64 __DATA_CONST with __got (cmdsize 152)
emit_seg_datac buf off =
  let o1 = mw_u32 buf off 25
  let o2 = mw_u32 buf o1 152
  let o3 = mw_str_padded buf o2 "__DATA_CONST" 16
  let o4 = mw_u64 buf o3 got_vm_d
  let o5 = mw_u64 buf o4 page
  let o6 = mw_u64 buf o5 got_off_d
  let o7 = mw_u64 buf o6 page
  let o8 = mw_u32 buf o7 3
  let o9 = mw_u32 buf o8 3
  let o10 = mw_u32 buf o9 1
  let o11 = mw_u32 buf o10 16
  emit_section64 buf o11 "__got" "__DATA_CONST" got_vm_d 8 got_off_d 3 6 1 0

-- LC_DYLD_INFO_ONLY (48) — only the bind stream is non-empty
emit_dyld_info buf off =
  let o1 = mw_u32 buf off 2147483682     -- 0x80000022 LC_DYLD_INFO_ONLY
  let o2 = mw_u32 buf o1 48
  let o3 = mw_u32 buf o2 0
  let o4 = mw_u32 buf o3 0                -- rebase 0/0
  let o5 = mw_u32 buf o4 bind_off_d
  let o6 = mw_u32 buf o5 bind_size_d
  let o7 = mw_u32 buf o6 0
  let o8 = mw_u32 buf o7 0                -- weak 0/0
  let o9 = mw_u32 buf o8 0
  let o10 = mw_u32 buf o9 0               -- lazy 0/0
  let o11 = mw_u32 buf o10 0
  mw_u32 buf o11 0                        -- export 0/0

-- LC_DYSYMTAB (80) — 0 local, 2 extdef, 1 undef; indirect symtab @ ind_off
emit_dysymtab_d buf off =
  let o1 = mw_u32 buf off 11
  let o2 = mw_u32 buf o1 80
  let o3 = mw_u32 buf o2 0
  let o4 = mw_u32 buf o3 0                -- ilocal/nlocal
  let o5 = mw_u32 buf o4 0
  let o6 = mw_u32 buf o5 2                -- iextdef/nextdef
  let o7 = mw_u32 buf o6 2
  let o8 = mw_u32 buf o7 1                -- iundef/nundef
  let o9 = mw_u32 buf o8 0
  let o10 = mw_u32 buf o9 0               -- tocoff/ntoc
  let o11 = mw_u32 buf o10 0
  let o12 = mw_u32 buf o11 0              -- modtaboff/nmodtab
  let o13 = mw_u32 buf o12 0
  let o14 = mw_u32 buf o13 0              -- extrefsymoff/nextrefsyms
  let o15 = mw_u32 buf o14 ind_off_d
  let o16 = mw_u32 buf o15 2             -- indirectsymoff/nindirectsyms
  let o17 = mw_u32 buf o16 0
  let o18 = mw_u32 buf o17 0             -- extreloff/nextrel
  let o19 = mw_u32 buf o18 0
  mw_u32 buf o19 0                       -- locreloff/nlocrel

-- LC_LOAD_DYLIB libSystem (56)
emit_load_dylib buf off =
  let o1 = mw_u32 buf off 12  let o2 = mw_u32 buf o1 56
  let o3 = mw_u32 buf o2 24                               -- name offset
  let o4 = mw_u32 buf o3 2                                -- timestamp
  let o5 = mw_u32 buf o4 88866816                         -- cur 1356.0.0 = 0x054C0000
  let o6 = mw_u32 buf o5 65536                            -- compat 1.0.0 = 0x00010000
  let o7 = mw_cstr buf o6 "/usr/lib/libSystem.B.dylib"
  mw_zeros buf o7 (off + 56 - o7)

-- ── nlist_64 (16) ───────────────────────────────────────────────────────────
emit_nlist buf off strx ntype nsect ndesc nval =
  let o1 = mw_u32 buf off strx
  let o2 = mw_u8 buf o1 ntype
  let o3 = mw_u8 buf o2 nsect
  let o4 = mw_u16 buf o3 ndesc
  mw_u64 buf o4 nval

-- ── all load commands ───────────────────────────────────────────────────────
emit_all_lc buf =
  let p0 = emit_mach_header buf 0 ncmds_d sizeofcmds_d mh_flags_pie_exec
  let p1 = emit_segment_64_nosects buf p0 "__PAGEZERO" 0 4294967296 0 0 0 0
  let p2 = emit_seg_text2 buf p1
  let p3 = emit_seg_datac buf p2
  let p4 = emit_segment_64_nosects buf p3 "__LINKEDIT" linkedit_vm page linkedit_off linkedit_fsz 1 1
  let p5 = emit_dyld_info buf p4
  let p6 = emit_symtab buf p5 sym_off_d nsyms_d str_off_d str_raw_d
  let p7 = emit_dysymtab_d buf p6
  let p8 = emit_load_dylinker buf p7
  let p9 = emit_uuid buf p8
  let p10 = emit_build_version buf p9 1703936 1703936     -- minos/sdk 26.0 (0x1a0000)
  let p11 = emit_main buf p10 text_off_d 0
  let p12 = emit_load_dylib buf p11
  emit_code_signature_lc buf p12 cs_off_d sig_total_d

-- ── code, stubs, got, LINKEDIT data ─────────────────────────────────────────
emit_text_and_stubs buf =
  -- __text @ 896: bl stub0 ; mov x16,#1 ; svc #0x80
  let _ = mw_u32 buf text_off_d 2483027971      -- 0x94000003
  let _ = mw_u32 buf (text_off_d + 4) 3531604016 -- 0xD2800030 movz x16,#1
  let _ = mw_u32 buf (text_off_d + 8) 3556773889 -- 0xD4001001 svc #0x80
  -- __stubs @ 908: adrp x16,#4page ; ldr x16,[x16] ; br x16
  let _ = mw_u32 buf stubs_off_d 2415919152      -- 0x90000030
  let _ = mw_u32 buf (stubs_off_d + 4) 4181721616 -- 0xF9400210
  let _ = mw_u32 buf (stubs_off_d + 8) 3592356352 -- 0xD61F0200 br x16
  0

emit_bind buf =
  let b1 = mw_u8 buf bind_off_d 17               -- 0x11 SET_DYLIB_ORDINAL_IMM|1
  let b2 = mw_u8 buf b1 64                        -- 0x40 SET_SYMBOL_TRAILING_FLAGS_IMM
  let b3 = mw_cstr buf b2 "_getpid"               -- name + NUL
  let b4 = mw_u8 buf b3 81                         -- 0x51 SET_TYPE_IMM|POINTER
  let b5 = mw_u8 buf b4 114                        -- 0x72 SET_SEGMENT_AND_OFFSET_ULEB seg=2
  let b6 = mw_u8 buf b5 0                          -- uleb offset 0
  let b7 = mw_u8 buf b6 144                        -- 0x90 DO_BIND
  mw_u8 buf b7 0                                   -- 0x00 DONE

emit_linkedit_tables buf =
  -- symtab (3 nlist): [0] __mh_execute_header extdef, [1] _main extdef, [2] _getpid undef
  let s0 = emit_nlist buf sym_off_d strx_mh 15 1 16 text_vm_base
  let s1 = emit_nlist buf s0 strx_main 15 1 0 text_vm_d
  let s2 = emit_nlist buf s1 strx_getpid 1 0 256 0
  -- indirect symtab: stub0 -> symidx 2, got0 -> symidx 2
  let i0 = mw_u32 buf ind_off_d 2
  let i1 = mw_u32 buf i0 2
  -- strtab: 0x20, 0x00, "_getpid\0", "_main\0", "__mh_execute_header\0"
  let t0 = mw_u8 buf str_off_d 32
  let t1 = mw_u8 buf t0 0
  let t2 = mw_cstr buf t1 "_getpid"
  let t3 = mw_cstr buf t2 "_main"
  mw_cstr buf t3 "__mh_execute_header"

main =
  let file_size = cs_off_d + sig_total_d
  let buf = arr_new file_size 0
  let _ = emit_all_lc buf
  let _ = emit_text_and_stubs buf
  let _ = emit_bind buf
  let _ = emit_linkedit_tables buf
  -- ad-hoc sign in place (N-page generalized; execSeg = __TEXT [0, page))
  let _ = emit_signature_n buf cs_off_d cs_off_d 0 page
  let _ = macho_write_file "/tmp/v5_dyld_demo" buf file_size
  print "wrote /tmp/v5_dyld_demo (run; expect exit = getpid & 0xff)"
