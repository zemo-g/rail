-- audit_npage_sign.rail — adversarial N-page signer harness.
-- Builds the SAME valid dynamic Mach-O as dyld_macho.rail, but pads __LINKEDIT
-- so the signature offset (cs_off = code_limit) lands at a chosen byte, exercising
-- emit_signature_n across page counts 1,2,3,5,10. Each binary is written to
-- /tmp/v5_sign_<cs_off> for codesign --verify --strict.
--
-- We DON'T move any real linkedit tables; we just choose cs_off = align16(target)
-- and size LINKEDIT to reach EOF. The tables stay at their original small offsets;
-- the gap between them and cs_off is zero padding (legal — linkedit just has slack).
--
-- Run:  ./rail_native --out-prefix /tmp/audX run tools/v5/audit_npage_sign.rail <cs_off>
-- where <cs_off> picks the page bucket (e.g. 8192->1pg, 20000->2pg, 32880->3pg,
-- 70000->5pg, 150000->10pg). cs_off must be >= 32876 (after the real tables) and
-- 16-aligned; harness aligns it.

import "stdlib/macho.rail"
import "stdlib/codesign.rail"

text_vm_base = 4294967296
page = 16384
ncmds_d      = 13
sizeofcmds_d = 864
code_size_d  = 12
text_off_d   = 896
stubs_off_d  = 908
got_off_d    = 16384
got_vm_d     = 4294983680
text_vm_d    = 4294968192
stubs_vm_d   = 4294968204
linkedit_off = 32768
linkedit_vm  = 4295000064
bind_off_d   = 32768
bind_size_d  = 15
sym_off_d    = 32784
nsyms_d      = 3
ind_off_d    = 32832
str_off_d    = 32840
str_raw_d    = 36
strx_getpid = 2
strx_main   = 10
strx_mh     = 16

emit_section64 buf off sect seg addr size foff align flags r1 r2 =
  let s1 = mw_str_padded buf off sect 16
  let s2 = mw_str_padded buf s1 seg 16
  let s3 = mw_u64 buf s2 addr
  let s4 = mw_u64 buf s3 size
  let s5 = mw_u32 buf s4 foff
  let s6 = mw_u32 buf s5 align
  let s7 = mw_u32 buf s6 0
  let s8 = mw_u32 buf s7 0
  let s9 = mw_u32 buf s8 flags
  let s10 = mw_u32 buf s9 r1
  let s11 = mw_u32 buf s10 r2
  mw_u32 buf s11 0

emit_seg_text2 buf off =
  let o1 = mw_u32 buf off 25
  let o2 = mw_u32 buf o1 232
  let o3 = mw_str_padded buf o2 "__TEXT" 16
  let o4 = mw_u64 buf o3 text_vm_base
  let o5 = mw_u64 buf o4 page
  let o6 = mw_u64 buf o5 0
  let o7 = mw_u64 buf o6 page
  let o8 = mw_u32 buf o7 5
  let o9 = mw_u32 buf o8 5
  let o10 = mw_u32 buf o9 2
  let o11 = mw_u32 buf o10 0
  let a = emit_section64 buf o11 "__text" "__TEXT" text_vm_d code_size_d text_off_d 0 2147484672 0 0
  emit_section64 buf a "__stubs" "__TEXT" stubs_vm_d code_size_d stubs_off_d 2 2147484680 0 12

emit_seg_datac buf off =
  let o1 = mw_u32 buf off 25
  let o2 = mw_u32 buf o1 152
  let o3 = mw_str_padded buf o2 "__DATA_CONST" 16
  let o4 = mw_u64 buf o3 got_vm_d
  let o5 = mw_u64 buf o4 page
  let o6 = mw_u64 buf o5 got_off_d
  let o7 = mw_u64 buf o6 page
  let o8 = mw_u32 buf o7 3
  let o9 = mw_u32 buf o8 3
  let o10 = mw_u32 buf o9 1
  let o11 = mw_u32 buf o10 16
  emit_section64 buf o11 "__got" "__DATA_CONST" got_vm_d 8 got_off_d 3 6 1 0

emit_dyld_info buf off =
  let o1 = mw_u32 buf off 2147483682
  let o2 = mw_u32 buf o1 48
  let o3 = mw_u32 buf o2 0
  let o4 = mw_u32 buf o3 0
  let o5 = mw_u32 buf o4 bind_off_d
  let o6 = mw_u32 buf o5 bind_size_d
  let o7 = mw_u32 buf o6 0
  let o8 = mw_u32 buf o7 0
  let o9 = mw_u32 buf o8 0
  let o10 = mw_u32 buf o9 0
  let o11 = mw_u32 buf o10 0
  mw_u32 buf o11 0

emit_dysymtab_d buf off =
  let o1 = mw_u32 buf off 11
  let o2 = mw_u32 buf o1 80
  let o3 = mw_u32 buf o2 0
  let o4 = mw_u32 buf o3 0
  let o5 = mw_u32 buf o4 0
  let o6 = mw_u32 buf o5 2
  let o7 = mw_u32 buf o6 2
  let o8 = mw_u32 buf o7 1
  let o9 = mw_u32 buf o8 0
  let o10 = mw_u32 buf o9 0
  let o11 = mw_u32 buf o10 0
  let o12 = mw_u32 buf o11 0
  let o13 = mw_u32 buf o12 0
  let o14 = mw_u32 buf o13 0
  let o15 = mw_u32 buf o14 ind_off_d
  let o16 = mw_u32 buf o15 2
  let o17 = mw_u32 buf o16 0
  let o18 = mw_u32 buf o17 0
  let o19 = mw_u32 buf o18 0
  mw_u32 buf o19 0

emit_load_dylib buf off =
  let o1 = mw_u32 buf off 12
  let o2 = mw_u32 buf o1 56
  let o3 = mw_u32 buf o2 24
  let o4 = mw_u32 buf o3 2
  let o5 = mw_u32 buf o4 88866816
  let o6 = mw_u32 buf o5 65536
  let o7 = mw_cstr buf o6 "/usr/lib/libSystem.B.dylib"
  mw_zeros buf o7 (off + 56 - o7)

emit_nlist buf off strx ntype nsect ndesc nval =
  let o1 = mw_u32 buf off strx
  let o2 = mw_u8 buf o1 ntype
  let o3 = mw_u8 buf o2 nsect
  let o4 = mw_u16 buf o3 ndesc
  mw_u64 buf o4 nval

emit_all_lc buf cs_off sig_total linkedit_fsz =
  let p0 = emit_mach_header buf 0 ncmds_d sizeofcmds_d mh_flags_pie_exec
  let p1 = emit_segment_64_nosects buf p0 "__PAGEZERO" 0 4294967296 0 0 0 0
  let p2 = emit_seg_text2 buf p1
  let p3 = emit_seg_datac buf p2
  let p4 = emit_segment_64_nosects buf p3 "__LINKEDIT" linkedit_vm page linkedit_off linkedit_fsz 1 1
  let p5 = emit_dyld_info buf p4
  let p6 = emit_symtab buf p5 sym_off_d nsyms_d str_off_d str_raw_d
  let p7 = emit_dysymtab_d buf p6
  let p8 = emit_load_dylinker buf p7
  let p9 = emit_uuid buf p8
  let p10 = emit_build_version buf p9 1703936 1703936
  let p11 = emit_main buf p10 text_off_d 0
  let p12 = emit_load_dylib buf p11
  emit_code_signature_lc buf p12 cs_off sig_total

emit_text_and_stubs buf =
  let _ = mw_u32 buf text_off_d 2483027971
  let _ = mw_u32 buf (text_off_d + 4) 3531604016
  let _ = mw_u32 buf (text_off_d + 8) 3556773889
  let _ = mw_u32 buf stubs_off_d 2415919152
  let _ = mw_u32 buf (stubs_off_d + 4) 4181721616
  let _ = mw_u32 buf (stubs_off_d + 8) 3592356352
  0

emit_bind buf =
  let b1 = mw_u8 buf bind_off_d 17
  let b2 = mw_u8 buf b1 64
  let b3 = mw_cstr buf b2 "_getpid"
  let b4 = mw_u8 buf b3 81
  let b5 = mw_u8 buf b4 114
  let b6 = mw_u8 buf b5 0
  let b7 = mw_u8 buf b6 144
  mw_u8 buf b7 0

emit_linkedit_tables buf =
  let s0 = emit_nlist buf sym_off_d strx_mh 15 1 16 text_vm_base
  let s1 = emit_nlist buf s0 strx_main 15 1 0 text_vm_d
  let s2 = emit_nlist buf s1 strx_getpid 1 0 256 0
  let i0 = mw_u32 buf ind_off_d 2
  let i1 = mw_u32 buf i0 2
  let t0 = mw_u8 buf str_off_d 32
  let t1 = mw_u8 buf t0 0
  let t2 = mw_cstr buf t1 "_getpid"
  let t3 = mw_cstr buf t2 "_main"
  mw_cstr buf t3 "__mh_execute_header"

align16 x = ((x + 15) / 16) * 16

build_one cs_off =
  let n_code     = cs_n_code_pages cs_off
  let sig_total  = cs_total_size_n cs_off
  let file_size  = cs_off + sig_total
  let linkedit_fsz = file_size - linkedit_off
  let buf = arr_new file_size 0
  let _ = emit_all_lc buf cs_off sig_total linkedit_fsz
  let _ = emit_text_and_stubs buf
  let _ = emit_bind buf
  let _ = emit_linkedit_tables buf
  let _ = emit_signature_n buf cs_off cs_off 0 page
  let path = cat ["/tmp/v5_sign_", show cs_off]
  let _ = macho_write_file path buf file_size
  let _ = print (cat ["wrote ", path, " cs_off=", show cs_off, " n_code=", show n_code, " sig_total=", show sig_total, " file_size=", show file_size])
  0

-- targets chosen so align16(cs_off) lands in page buckets 1,2,3,5,10.
-- cs_off must be > 32876 (after the real linkedit tables). For the small
-- page counts we use a SECOND build path with tables packed early enough.
-- 1pg needs cs_off <= 16384 but tables end at 32876 -> impossible with this
-- layout, so 1-page is tested via a SEPARATE compact layout below.

main =
  let _ = build_one 32768    -- align16(32768)=32768 -> 2 pages
  let _ = build_one 32880    -- 3 pages (matches the demo)
  let _ = build_one 70000    -- align16 -> 70000 -> 5 pages (4*16384=65536 < 70000 <= 81920)
  let _ = build_one 150000   -- 10 pages (9*16384=147456 < 150000 <= 163840)
  let _ = build_one 49200    -- 4 pages (3*16384=49152 < 49200 <= 65536)
  let _ = build_one 1600000  -- ~98 pages (97*16384=1589248 < 1600000 <= 1605632)
  0
