-- audit_1page_sign.rail — exercise emit_signature_n with n_code=1 (single page)
-- AND emit_signature (the original fixed 1-page path), then byte-diff the two
-- signature blobs. They MUST be identical.
--
-- We don't need a runnable binary for the byte-diff: we just allocate two
-- identical 8192-byte buffers (cs_off=4096, code_limit=4096 -> 1 page), fill
-- both with the same pseudo-content, sign one with emit_signature and the other
-- with emit_signature_n, and compare the 232-byte signature regions.

import "stdlib/macho.rail"
import "stdlib/codesign.rail"

page = 16384

-- fill [0, n) with a deterministic byte pattern so the code hash is non-trivial
fill_pattern buf i n =
  if i >= n then 0
  else
    let _ = arr_set buf i (bit_and (i * 7 + 13) 255)
    fill_pattern buf (i + 1) n

-- compare two buffers over [off, off+n); return -1 if equal, else first diff idx
cmp_range a b off n i =
  if i >= n then 0 - 1
  else
    if (arr_get a (off + i)) == (arr_get b (off + i)) then cmp_range a b off n (i + 1)
    else off + i

main =
  let cs_off = 4096          -- 1 page (<= 16384)
  let file_size = cs_off + 232
  let bufA = arr_new file_size 0
  let bufB = arr_new file_size 0
  let _ = fill_pattern bufA 0 cs_off
  let _ = fill_pattern bufB 0 cs_off
  -- sign A with the ORIGINAL fixed 1-page path
  let _ = emit_signature   bufA cs_off cs_off 0 page
  -- sign B with the GENERALIZED path (n_code should be 1)
  let _ = emit_signature_n bufB cs_off cs_off 0 page
  let n1 = cs_n_code_pages cs_off
  let tot1 = cs_total_size_n cs_off
  let _ = print (cat ["n_code=", show n1, " total_n=", show tot1, " (orig total=232)"])
  let diff = cmp_range bufA bufB 0 file_size 0
  let _ = if diff < 0 then print "BYTE-IDENTICAL: emit_signature == emit_signature_n for 1 page"
          else print (cat ["*** DIFF at file offset ", show diff,
                           " A=", show (arr_get bufA diff),
                           " B=", show (arr_get bufB diff), " ***"])
  -- also dump both signature regions to disk for external diff
  let _ = macho_write_file "/tmp/sig_orig_1pg.bin" bufA file_size
  let _ = macho_write_file "/tmp/sig_gen_1pg.bin"  bufB file_size
  0
