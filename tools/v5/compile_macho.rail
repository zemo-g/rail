-- tools/v5/compile_macho.rail
-- v5 Phase 4b — file-level driver.
--
-- Reads an ARM64 .s file (the subset asm.rail covers — no external bl,
-- no @PAGE symbol refs, no .data section), assembles it via the pure-Rail
-- assembler, wraps in a Mach-O, ad-hoc-signs it, writes a runnable
-- executable. No `as`, `ld`, or `codesign` invoked.
--
-- Usage:
--   ./rail_native run tools/v5/compile_macho.rail path/to/prog.s
--   /tmp/v5_compiled ; echo $?

import "tools/v5/asm.rail"
import "stdlib/codesign.rail"

n_load_cmds   = 10
sizeof_cmds   = 528
code_offset   = 1024
sig_offset    = 16384
sig_size      = 232
file_size     = 16616
text_filesize = 16384
text_section_vmaddr = 4294968320
linkedit_vmaddr     = 4294983680
macos_minos = 720896
macos_sdk   = 720896

emit_all_cmds buf code_size =
  let p1 = emit_mach_header buf 0 n_load_cmds sizeof_cmds mh_flags_pie_exec
  let p2 = emit_segment_64_nosects buf p1 "__PAGEZERO" 0 pagezero_vmsize 0 0 vm_prot_none vm_prot_none
  let p3 = emit_segment_64_text buf p2 text_vmaddr text_filesize 0 text_filesize text_section_vmaddr code_size code_offset 2
  let p4 = emit_segment_64_nosects buf p3 "__LINKEDIT" linkedit_vmaddr page_size sig_offset sig_size vm_prot_r vm_prot_r
  let p5 = emit_symtab buf p4 sig_offset 0 sig_offset 0
  let p6 = emit_dysymtab_empty buf p5
  let p7 = emit_load_dylinker buf p6
  let p8 = emit_uuid buf p7
  let p9 = emit_build_version buf p8 macos_minos macos_sdk
  let p10 = emit_main buf p9 code_offset 0
  emit_code_signature_lc buf p10 sig_offset sig_size

copy_n dst dst_off src src_off n =
  if n <= 0 then dst_off
  else
    let _ = arr_set dst dst_off (arr_get src src_off)
    copy_n dst (dst_off + 1) src (src_off + 1) (n - 1)

main =
  let s_path = head (tail args)
  let src = read_file s_path
  let _ = print (cat ["read ", show (length (chars src)), " chars of asm from ", s_path])

  -- Assemble text → bytes
  let code_bytes_len = asm_bytes_len src
  let code_buf = asm_assemble src 4096
  let _ = print (cat ["assembled ", show code_bytes_len, " bytes (", show (code_bytes_len / 4), " instructions)"])

  -- Build Mach-O scaffold
  let buf = arr_new file_size 0
  let _ = emit_all_cmds buf code_bytes_len

  -- Copy code into __TEXT
  let _ = copy_n buf code_offset code_buf 0 code_bytes_len

  -- Ad-hoc sign in place
  let _ = emit_signature buf sig_offset sig_offset 0 text_filesize

  -- Write to disk
  let _ = macho_write_file "/tmp/v5_compiled" buf file_size
  let _ = print "wrote /tmp/v5_compiled"
  0
