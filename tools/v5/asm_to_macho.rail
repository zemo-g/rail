-- tools/v5/asm_to_macho.rail
-- v5 Phase 4a end-to-end: assembly TEXT → Rail assembler → Rail Mach-O
-- writer → Rail ad-hoc signer → runnable binary.
--
-- Bridges compile.rail's existing text-emitting backend to the new
-- pure-Rail toolchain. No `as`, no `ld`, no `codesign`.
--
-- Demo: assembles an exit-42 .s source string and writes /tmp/v5_asm_hello.

import "tools/v5/asm.rail"
import "stdlib/codesign.rail"

n_load_cmds   = 10
sizeof_cmds   = 528
code_offset   = 1024
sig_offset    = 16384
sig_size      = 232
file_size     = 16616
text_filesize = 16384
text_section_vmaddr = 4294968320
linkedit_vmaddr     = 4294983680
macos_minos = 720896
macos_sdk   = 720896

exit42_asm =
  cat [
    ".text\n",
    ".global _main\n",
    "_main:\n",
    "    mov  x16, #1\n",
    "    mov  x0,  #42\n",
    "    svc  #0x80\n",
    "    ret\n"
  ]

emit_all_cmds buf code_size =
  let p1 = emit_mach_header buf 0 n_load_cmds sizeof_cmds mh_flags_pie_exec
  let p2 = emit_segment_64_nosects buf p1 "__PAGEZERO" 0 pagezero_vmsize 0 0 vm_prot_none vm_prot_none
  let p3 = emit_segment_64_text buf p2 text_vmaddr text_filesize 0 text_filesize text_section_vmaddr code_size code_offset 2
  let p4 = emit_segment_64_nosects buf p3 "__LINKEDIT" linkedit_vmaddr page_size sig_offset sig_size vm_prot_r vm_prot_r
  let p5 = emit_symtab buf p4 sig_offset 0 sig_offset 0
  let p6 = emit_dysymtab_empty buf p5
  let p7 = emit_load_dylinker buf p6
  let p8 = emit_uuid buf p7
  let p9 = emit_build_version buf p8 macos_minos macos_sdk
  let p10 = emit_main buf p9 code_offset 0
  emit_code_signature_lc buf p10 sig_offset sig_size

-- Copy n bytes from src buffer at src_off into dst buffer at dst_off.
copy_n dst dst_off src src_off n =
  if n <= 0 then dst_off
  else
    let _ = arr_set dst dst_off (arr_get src src_off)
    copy_n dst (dst_off + 1) src (src_off + 1) (n - 1)

main =
  -- Step 1: assemble the text into bytes.
  let code_bytes_len = asm_bytes_len exit42_asm
  let code_buf = asm_assemble exit42_asm 256
  let _ = print (cat ["assembled ", show code_bytes_len, " bytes from text"])

  -- Step 2: build the Mach-O scaffold.
  let buf = arr_new file_size 0
  let _ = emit_all_cmds buf code_bytes_len

  -- Step 3: copy the assembled code into the binary at code_offset.
  let _ = copy_n buf code_offset code_buf 0 code_bytes_len

  -- Step 4: ad-hoc sign in place (page hash covers LC_CODE_SIGNATURE).
  let _ = emit_signature buf sig_offset sig_offset 0 text_filesize

  -- Step 5: write to disk via hex-pipe (sidestep write_file's strlen).
  let _ = macho_write_file "/tmp/v5_asm_hello" buf file_size
  let _ = print "wrote /tmp/v5_asm_hello — run it to exit 42"
  0
