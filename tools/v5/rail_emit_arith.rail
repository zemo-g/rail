-- tools/v5/rail_emit_arith.rail
-- v5 Phase 4 — multi-instruction arithmetic demo.
--
-- Emits a Mach-O that computes (3 * 7 + 21) on real ARM64 registers and
-- exits with the result (42). Validates that arithmetic instructions
-- emit + run correctly when wrapped in our Rail-built, Rail-signed
-- Mach-O.
--
--   ./rail_native run tools/v5/rail_emit_arith.rail
--   /tmp/v5_arith ; echo $?    ->  42

import "jit/arm64.rail"
import "stdlib/macho.rail"
import "stdlib/codesign.rail"

n_load_cmds   = 10
sizeof_cmds   = 528
code_offset   = 1024
code_size     = 32         -- 8 instructions × 4
sig_offset    = 16384
sig_size      = 232
file_size     = 16616
text_filesize = 16384
text_section_vmaddr = 4294968320
linkedit_vmaddr     = 4294983680
macos_minos = 720896
macos_sdk   = 720896

emit_arith_program buf base =
  let _ = cb_emit buf  base       (enc_mov_imm16 0 3)
  let _ = cb_emit buf (base + 4)  (enc_mov_imm16 1 7)
  let _ = cb_emit buf (base + 8)  (enc_mul 0 0 1)
  let _ = cb_emit buf (base + 12) (enc_mov_imm16 1 21)
  let _ = cb_emit buf (base + 16) (enc_add 0 0 1)
  let _ = cb_emit buf (base + 20) (enc_mov_imm16 16 1)
  let _ = cb_emit buf (base + 24) (enc_svc 128)
  let _ = cb_emit buf (base + 28) enc_ret
  base + 32

emit_all_cmds buf =
  let p1 = emit_mach_header buf 0 n_load_cmds sizeof_cmds mh_flags_pie_exec
  let p2 = emit_segment_64_nosects buf p1 "__PAGEZERO" 0 pagezero_vmsize 0 0 vm_prot_none vm_prot_none
  let p3 = emit_segment_64_text buf p2 text_vmaddr text_filesize 0 text_filesize text_section_vmaddr code_size code_offset 2
  let p4 = emit_segment_64_nosects buf p3 "__LINKEDIT" linkedit_vmaddr page_size sig_offset sig_size vm_prot_r vm_prot_r
  let p5 = emit_symtab buf p4 sig_offset 0 sig_offset 0
  let p6 = emit_dysymtab_empty buf p5
  let p7 = emit_load_dylinker buf p6
  let p8 = emit_uuid buf p7
  let p9 = emit_build_version buf p8 macos_minos macos_sdk
  let p10 = emit_main buf p9 code_offset 0
  emit_code_signature_lc buf p10 sig_offset sig_size

build_macho =
  let buf = arr_new file_size 0
  let r1 = emit_all_cmds buf
  let r2 = emit_arith_program buf code_offset
  let r3 = emit_signature buf sig_offset sig_offset 0 text_filesize
  buf

main =
  let buf = build_macho
  let _ = macho_write_file "/tmp/v5_arith" buf file_size
  let _ = print "wrote /tmp/v5_arith — runs `3 * 7 + 21` on ARM64, exits with result"
  0
