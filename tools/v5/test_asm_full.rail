-- tools/v5/test_asm_full.rail
-- v5 Phase 4b — verify the extended assembler covers ~40 mnemonics
-- byte-identically against `as`.

import "tools/v5/asm.rail"

-- A non-trivial program exercising every supported mnemonic.
test_source =
  cat [
    ".text\n",
    ".global _t\n",
    "_t:\n",
    -- Mov family
    "    mov  x16, #1\n",
    "    mov  x0,  #42\n",
    "    mov  x19, x10\n",
    "    movz x0, #5\n",
    "    movk x10, #5, lsl #16\n",
    -- Arith (reg-reg)
    "    add  x10, x19, x27\n",
    "    sub  x19, x27, x9\n",
    "    mul  x19, x10, x27\n",
    "    sdiv x19, x27, x9\n",
    "    udiv x19, x27, x9\n",
    "    madd x19, x27, x9, x13\n",
    "    msub x19, x27, x9, x13\n",
    -- Bitwise
    "    and  x19, x27, x9\n",
    "    orr  x10, x19, x27\n",
    "    eor  x27, x19, x10\n",
    "    tst  x19, x27\n",
    -- Shifts (register form)
    "    lsl  x19, x27, x9\n",
    "    lsr  x10, x19, x27\n",
    "    asr  x27, x10, x19\n",
    -- Compare + cset
    "    cmp  x19, x27\n",
    "    cmp  x9, #100\n",
    "    cset x19, eq\n",
    "    cset x27, ne\n",
    "    cset x10, lt\n",
    "    cset x9, gt\n",
    -- Memory (ldr/str with offset)
    "    ldr  x19, [x9, #8]\n",
    "    str  x19, [x9, #16]\n",
    -- Memory (ldp/stp)
    "    ldp  x19, x27, [x9, #32]\n",
    "    stp  x19, x27, [x9, #16]\n",
    -- Float
    "    fadd d10, d3, d15\n",
    "    fsub d5, d12, d8\n",
    "    fmul d15, d0, d7\n",
    "    fdiv d8, d8, d8\n",
    "    fcmp d5, d12\n",
    "    scvtf d15, x27\n",
    "    fcvtzs x19, d8\n",
    "    fmov d5, x19\n",
    "    fmov d8, d15\n",
    -- Branches with labels
    "    bl   tgt\n",
    "    b.eq tgt\n",
    "    b.ne tgt\n",
    "    b.lt tgt\n",
    "    b.gt tgt\n",
    "    b.le tgt\n",
    "    b.ge tgt\n",
    "    b.hi tgt\n",
    "    b.hs tgt\n",
    "    b.lo tgt\n",
    "    b.ls tgt\n",
    "    cbz  x19, tgt\n",
    "    cbnz x27, tgt\n",
    -- Branch register
    "    blr  x19\n",
    "    br   x9\n",
    -- Service + end
    "    svc  #0x80\n",
    "    nop\n",
    "tgt:\n",
    "    ret\n"
  ]

-- Walk buf for n bytes, print hex words (4 bytes each).
show_bytes buf n = show_bytes_loop buf 0 n ""
show_bytes_loop buf i n acc =
  if i >= n then acc
  else
    let b = arr_get buf i
    let hi = bit_and (shr b 4) 15
    let lo = bit_and b 15
    let h = cat [hex_d hi, hex_d lo]
    let sep = if (i + 1) == n then "" else if bit_and (i + 1) 3 == 0 then " " else ""
    show_bytes_loop buf (i + 1) n (cat [acc, h, sep])

hex_d n =
  if n < 10 then char_from_int (48 + n)
  else char_from_int (87 + n)

-- Hex parser to convert otool output to ints
parse_hex s = parse_hex_acc (chars s) 0
parse_hex_acc cs acc =
  if cs == [] then acc
  else
    let c = char_to_int (head cs)
    if c >= 48 && c <= 57 then parse_hex_acc (tail cs) (acc * 16 + (c - 48))
    else if c >= 97 && c <= 102 then parse_hex_acc (tail cs) (acc * 16 + (c - 87))
    else if c >= 65 && c <= 70 then parse_hex_acc (tail cs) (acc * 16 + (c - 55))
    else acc

-- Read bytes back from our buf as a 32-bit LE word.
buf_word buf i =
  let b0 = arr_get buf i
  let b1 = arr_get buf (i + 1)
  let b2 = arr_get buf (i + 2)
  let b3 = arr_get buf (i + 3)
  bit_or b0 (bit_or (shl b1 8) (bit_or (shl b2 16) (shl b3 24)))

-- Walk both rail bytes + otool ground-truth, count mismatches.
verify_loop buf nbytes truths i mismatches =
  if i * 4 >= nbytes then mismatches
  else if truths == [] then mismatches
  else
    let rail = buf_word buf (i * 4)
    let truth_hex = head truths
    let truth = parse_hex truth_hex
    if rail == truth then
      verify_loop buf nbytes (tail truths) (i + 1) mismatches
    else
      let _ = print (cat ["MISMATCH @", show (i*4), ": rail=", show rail, " truth=", show truth])
      verify_loop buf nbytes (tail truths) (i + 1) (mismatches + 1)

main =
  let _ = write_file "/tmp/asm_test_full.s" test_source
  let _ = shell "as -arch arm64 -o /tmp/asm_test_full.o /tmp/asm_test_full.s 2>&1"
  let _ = shell "otool -t /tmp/asm_test_full.o | tail -n +3 > /tmp/asm_test_full.otool"

  let nbytes = asm_bytes_len test_source
  let buf = asm_assemble test_source 1024
  let _ = print (cat ["Rail asm produced ", show nbytes, " bytes"])

  -- Parse otool output: each row is "addr  word1 word2 word3 word4"
  let truth_raw = read_file "/tmp/asm_test_full.otool"
  -- Words: each whitespace-separated 8-char hex token after the address.
  -- We tokenize crudely by splitting on space and skipping the address.
  let lines = str_split "\n" truth_raw
  let all_words = collect_words lines []
  let _ = print (cat ["Ground truth: ", show (length all_words), " words"])

  let fails = verify_loop buf nbytes all_words 0 0
  if fails == 0 then
    let _ = print (cat ["PASS: ", show (nbytes / 4), "/", show (nbytes / 4), " instructions match"])
    0
  else
    let _ = print (cat ["FAIL: ", show fails, " mismatches"])
    1

collect_words lines acc =
  if lines == [] then reverse acc
  else
    let line = head lines
    if line == "" then collect_words (tail lines) acc
    else
      let toks = str_split " " line
      -- Drop the address token (first), keep the rest
      collect_words (tail lines) (cat_rev (tail toks) acc)

cat_rev xs ys =
  if xs == [] then ys
  else
    let h = head xs
    if h == "" then cat_rev (tail xs) ys
    else cat_rev (tail xs) (cons h ys)
