-- tools/v5/asm_textgate.rail — WHOLE-PROGRAM text differential.
-- Reads a real compiler .s, runs asm_assemble over the entire file (pass1 label
-- offsets + pass2 emit), and writes the resulting __text bytes to /tmp/rail_text.bin.
-- A Python driver assembles the SAME .s with system `as`, extracts the __text
-- section, and byte-diffs. This proves the Rail assembler reproduces `as`'s text
-- section for the largest real program (the compiler itself), not just isolated
-- instructions. (Directives are skipped; data sections carry no instructions, so
-- the instruction stream = as's merged __text. Relocs/@PAGE emit base+0 like `as`.)
import "tools/v5/asm.rail"

main =
  let src = read_file "/tmp/textgate_src.s"
  let n = asm_bytes_len src
  let buf = asm_assemble src (n + 16)
  let _ = macho_write_file "/tmp/rail_text.bin" buf n
  let _ = print (cat ["assembled ", show n, " text bytes -> /tmp/rail_text.bin"])
  0
