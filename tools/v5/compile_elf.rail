-- tools/v5/compile_elf.rail
-- v5 Phase 5a — file-level driver: .s → Rail assembler → Rail ELF writer.
--
-- Static aarch64 Linux ELF, no external `as`, no `ld`.  Mirrors
-- tools/v5/compile_macho.rail but targets the simpler ELF format and
-- drops the codesign step (Linux doesn't require it).
--
-- Usage:
--   ./rail_native run tools/v5/compile_elf.rail path/to/prog.s [out_path]
--   scp out_path pi:/tmp/ && ssh pi '/tmp/<out_path>; echo $?'
--
-- The .s file MUST be the subset asm.rail covers (no @PAGE/:lo12: symbol
-- refs, no .data/.bss yet — Phase 5b extends both modules to handle those).

import "tools/v5/asm.rail"
import "stdlib/elf.rail"

main =
  let s_path = head (tail args)
  let out_path = if (tail (tail args)) == [] then "/tmp/v5_elf" else head (tail (tail args))
  let src = read_file s_path
  let _ = print (cat ["read ", show (length (chars src)), " chars of asm from ", s_path])

  -- Assemble text → bytes
  let code_size = asm_bytes_len src
  let code_buf = asm_assemble src 4096
  let _ = print (cat ["assembled ", show code_size, " bytes (", show (code_size / 4), " instructions)"])

  -- Build ELF
  let total_size = ehdr_size + phdr_size + code_size
  let buf = arr_new total_size 0
  let _ = elf_emit_tiny buf code_buf code_size
  let _ = elf_write_file out_path buf total_size
  let _ = print (cat ["wrote ", out_path, " (", show total_size, " bytes)"])
  0
