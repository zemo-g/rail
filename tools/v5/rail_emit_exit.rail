-- tools/v5/rail_emit_exit.rail
-- v5 Phase 4 parametric demo.
--
-- Take an exit code N from argv, emit a self-signed macOS ARM64 Mach-O
-- to /tmp/v5_exit that exits with code N.
--
--   ./rail_native run tools/v5/rail_emit_exit.rail 99
--   /tmp/v5_exit ; echo $?    ->  99
--
-- Same emitter as exit-42; this proves the pipeline is parameterised, not
-- a one-shot hand-tuning.

import "jit/arm64.rail"
import "stdlib/macho.rail"
import "stdlib/codesign.rail"

n_load_cmds   = 10
sizeof_cmds   = 528
code_offset   = 1024
code_size     = 16
sig_offset    = 16384
sig_size      = 232
file_size     = 16616
text_filesize = 16384
text_section_vmaddr = 4294968320
linkedit_vmaddr     = 4294983680
macos_minos = 720896
macos_sdk   = 720896

emit_exit_n buf base n =
  let _ = cb_emit buf  base       (enc_mov_imm16 16 1)
  let _ = cb_emit buf (base + 4)  (enc_mov_imm16 0 (bit_and n 65535))
  let _ = cb_emit buf (base + 8)  (enc_svc 128)
  let _ = cb_emit buf (base + 12) enc_ret
  base + 16

emit_all_cmds buf =
  let p1 = emit_mach_header buf 0 n_load_cmds sizeof_cmds mh_flags_pie_exec
  let p2 = emit_segment_64_nosects buf p1 "__PAGEZERO" 0 pagezero_vmsize 0 0 vm_prot_none vm_prot_none
  let p3 = emit_segment_64_text buf p2 text_vmaddr text_filesize 0 text_filesize text_section_vmaddr code_size code_offset 2
  let p4 = emit_segment_64_nosects buf p3 "__LINKEDIT" linkedit_vmaddr page_size sig_offset sig_size vm_prot_r vm_prot_r
  let p5 = emit_symtab buf p4 sig_offset 0 sig_offset 0
  let p6 = emit_dysymtab_empty buf p5
  let p7 = emit_load_dylinker buf p6
  let p8 = emit_uuid buf p7
  let p9 = emit_build_version buf p8 macos_minos macos_sdk
  let p10 = emit_main buf p9 code_offset 0
  emit_code_signature_lc buf p10 sig_offset sig_size

build_macho_exit_n n =
  let buf = arr_new file_size 0
  let r1 = emit_all_cmds buf
  let r2 = emit_exit_n buf code_offset n
  let r3 = emit_signature buf sig_offset sig_offset 0 text_filesize
  buf

main =
  let arg = head (tail args)
  let n = parse_int arg
  let buf = build_macho_exit_n n
  let _ = macho_write_file "/tmp/v5_exit" buf file_size
  let _ = print (cat ["wrote /tmp/v5_exit (will exit with code ", show n, ")"])
  0
