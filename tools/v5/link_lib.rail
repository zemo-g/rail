-- tools/v5/link_macho.rail — the "ld half": turn a real .s into a runnable
-- Mach-O executable with NO as/ld/codesign, generalizing tools/v5/dyld_macho.rail
-- (N=1 import demo) to the full compiler. Spec: ~/.ledatic/ld_half_spec_2026-06-18.md.
--
-- Built verse by verse:
--   M1 (this file, first pass): multi-section symbol table + layout engine.
--      A data/bss/mod_init walker assigns every data & bss symbol its section-
--      relative offset and computes __data/__bss/__mod_init_func sizes; combined
--      with asm.rail's __text label map, every symbol gets a final VM address once
--      section bases are assigned. Validated against `nm -n` of an as-built .o.
import "tools/v5/asm.rail"
import "stdlib/codesign.rail"

-- ===========================================================================
-- M1 — data / bss / mod_init section walker.
-- Sections we model past __text: data=1, bss=2, modinit=3 (text=0, other=9).
-- ===========================================================================

-- Which data section a `.section`/`.data`/`.zerofill`/`.text` line switches to.
-- Returns: 0 text, 1 __data, 2 (n/a — bss is per-.zerofill), 3 __mod_init_func, 9 other.
lk_sec_of line =
  let cs = asm_skip_ws (chars line)
  if (asm_cprefix cs ".section") == 1 then
    (if str_contains "__TEXT,__text" line then 0
     else if str_contains "__DATA,__mod_init_func" line then 3
     else if str_contains "__DATA,__data" line then 1
     else 9)
  else if (asm_cprefix cs ".text") == 1 then 0
  else if (asm_cprefix cs ".data") == 1 then 1
  else 0 - 1                       -- not a section-switch line

-- data-directive byte size at the current offset (for .p2align, needs off).
-- .quad->8 .long->4 .byte->count .asciz->len+1 .ascii->len .space->N .p2align->pad.
lk_data_dir_size off line =
  let cs = asm_skip_ws (chars line)
  if (asm_cprefix cs ".quad") == 1 then 8
  else if (asm_cprefix cs ".long") == 1 then 4
  else if (asm_cprefix cs ".byte") == 1 then lk_byte_count line
  else if (asm_cprefix cs ".asciz") == 1 then (asm_asciz_len line) + 1
  else if (asm_cprefix cs ".ascii") == 1 then asm_asciz_len line
  else if (asm_cprefix cs ".space") == 1 then asm_p2align_n line
  else if (asm_cprefix cs ".short") == 1 then 2
  else if (asm_cprefix cs ".p2align") == 1 then (asm_align_up off (asm_p2align_n line)) - off
  else 0                            -- .global / blank / comment / unknown -> 0 bytes

-- count of comma-separated values in a `.byte a, b, c` line.
lk_byte_count line =
  let rest = asm_after_lsl (asm_ltrim line)   -- drop ".byte ", trim
  length (asm_split_commas rest)

-- A `.zerofill __DATA,__bss,_sym,size,align` line -> [name, size, align]. The
-- 5 fields after `.zerofill ` are seg, sect, name, size, align (comma-split).
lk_zerofill_parts line =
  let rest = asm_after_lsl (asm_ltrim line)   -- drop ".zerofill"
  asm_split_commas rest

-- ===========================================================================
-- Walk the whole .s. Produce a flat symbol record list (cons of [name, sec, off])
-- for data(1) + bss(2) symbols, plus the running data/bss/modinit sizes carried
-- in a small state list [dataoff, bssoff, modoff]. We keep it functional: the
-- walker returns [dataoff, bssoff, modoff, symlist].
-- ===========================================================================

lk_walk lines sec dataoff bssoff modoff syms =
  if lines == [] then cons dataoff (cons bssoff (cons modoff (cons syms [])))
  else
    let line = head lines
    let sw = lk_sec_of line
    if sw >= 0 then lk_walk (tail lines) sw dataoff bssoff modoff syms
    else
      let cs = asm_skip_ws (chars line)
      if cs == [] then lk_walk (tail lines) sec dataoff bssoff modoff syms
      else if (asm_cprefix cs ".zerofill") == 1 then
        -- bss symbol: align bss to 2^align, record at bssoff, advance by size.
        lk_walk_zf line lines sec dataoff bssoff modoff syms
      else if (asm_chars_end_colon cs) == 1 then
        -- a label: record if in data(1) section (text labels come from asm.rail;
        -- modinit/bss have no inline labels we resolve via @PAGE).
        (if sec == 1 then lk_walk (tail lines) sec dataoff bssoff modoff (cons (cons (asm_label_name (asm_ltrim line)) (cons 1 (cons dataoff []))) syms)
         else lk_walk (tail lines) sec dataoff bssoff modoff syms)
      else
        -- a directive contributing bytes to the current section.
        (if sec == 1 then lk_walk (tail lines) sec (dataoff + (lk_data_dir_size dataoff line)) bssoff modoff syms
         else if sec == 3 then lk_walk (tail lines) sec dataoff bssoff (modoff + (lk_data_dir_size modoff line)) syms
         else lk_walk (tail lines) sec dataoff bssoff modoff syms)

-- handle a .zerofill line: parts = [seg, sect, name, size, align]
lk_walk_zf line lines sec dataoff bssoff modoff syms =
  let parts = lk_zerofill_parts line
  let name = head (tail (tail parts))
  let size = asm_imm (head (tail (tail (tail parts))))
  let algn = asm_imm (head (tail (tail (tail (tail parts)))))
  let base = asm_align_up bssoff algn
  lk_walk (tail lines) sec dataoff (base + size) modoff (cons (cons name (cons 2 (cons base []))) syms)

-- Record-consuming lk_walk: fast-skip insn records (an instruction is always in
-- __text, never switches section or adds data/bss/mod bytes, so skipping it is
-- exactly equivalent); only the ~5K non-insn lines re-run lk_sec_of on raw.
lk_walk_r records sec dataoff bssoff modoff syms =
  if records == [] then cons dataoff (cons bssoff (cons modoff (cons syms [])))
  else
    let r = head records
    if (asm_rec_kind r) == "insn" then lk_walk_r (tail records) sec dataoff bssoff modoff syms
    else lk_walk_r_step r records sec dataoff bssoff modoff syms
lk_walk_r_step r records sec dataoff bssoff modoff syms =
  let line = asm_rec_raw r
  let sw = lk_sec_of line
  if sw >= 0 then lk_walk_r (tail records) sw dataoff bssoff modoff syms
  else
    let cs = asm_skip_ws (chars line)
    if cs == [] then lk_walk_r (tail records) sec dataoff bssoff modoff syms
    else if (asm_cprefix cs ".zerofill") == 1 then lk_walk_zf_r line records sec dataoff bssoff modoff syms
    else if (asm_chars_end_colon cs) == 1 then
      (if sec == 1 then lk_walk_r (tail records) sec dataoff bssoff modoff (cons (cons (asm_label_name (asm_ltrim line)) (cons 1 (cons dataoff []))) syms)
       else lk_walk_r (tail records) sec dataoff bssoff modoff syms)
    else
      (if sec == 1 then lk_walk_r (tail records) sec (dataoff + (lk_data_dir_size dataoff line)) bssoff modoff syms
       else if sec == 3 then lk_walk_r (tail records) sec dataoff bssoff (modoff + (lk_data_dir_size modoff line)) syms
       else lk_walk_r (tail records) sec dataoff bssoff modoff syms)
lk_walk_zf_r line records sec dataoff bssoff modoff syms =
  let parts = lk_zerofill_parts line
  let name = head (tail (tail parts))
  let size = asm_imm (head (tail (tail (tail parts))))
  let algn = asm_imm (head (tail (tail (tail (tail parts)))))
  let base = asm_align_up bssoff algn
  lk_walk_r (tail records) sec dataoff (base + size) modoff (cons (cons name (cons 2 (cons base []))) syms)

-- ===========================================================================
-- M1 validation main — print computed sizes + key data/bss symbol offsets,
-- to diff against `nm -n` ground truth (data base = __text size).
-- ===========================================================================

lk_lookup_sym name syms =
  if syms == [] then 0 - 1
  else
    let r = head syms
    if (head r) == name then (head (tail (tail r)))
    else lk_lookup_sym name (tail syms)

lk_show_sym name syms =
  let v = lk_lookup_sym name syms
  print (cat ["  ", name, " @ data/bss-off 0x", lk_hex v])

-- minimal hex printer (lowercase, no 0x)
lk_hex n = if n == 0 then "0" else lk_hex_go n ""
lk_hex_go n acc =
  if n == 0 then acc
  else lk_hex_go (n / 16) (cat [lk_hex_digit (n - ((n / 16) * 16)), acc])
lk_hex_digit d =
  if d < 10 then show d
  else if d == 10 then "a" else if d == 11 then "b" else if d == 12 then "c"
  else if d == 13 then "d" else if d == 14 then "e" else "f"

-- ===========================================================================
-- M1 — layout engine. Computes self-consistent, page-aligned VM addresses for
-- every segment/section, given the assembled sizes + import count. (lc_end is
-- finalized in M5 against the actually-emitted load commands; here we use the
-- planned 14-command set. The layout need not match `ld` — only be internally
-- consistent so adrp/add and the stubs resolve correctly at runtime.)
-- Sections: __TEXT[__text,__stubs] __DATA_CONST[__got,__mod_init] __DATA[__data,__bss].
-- ===========================================================================
lk_page = 16384
lk_text_vm_base = 4294967296          -- 0x100000000
-- 14 load commands for the compiler exe:
--   PAGEZERO72 TEXT232 DATA_CONST232 DATA232 LINKEDIT72 dyldinfo48 symtab24
--   dysymtab80 dylinker32 uuid24 buildver32 main24 dylib56 codesig16 = 1176
lk_sizeofcmds = 1176
lk_lc_end = 1208                       -- 32 (header) + 1176

lk_alignp n = ((n + lk_page - 1) / lk_page) * lk_page
lk_align4 n = ((n + 3) / 4) * 4

-- The layout returns a flat list (all u64 VM addrs / sizes the rest of the linker
-- needs), indexed by name via lk_lay_* accessors below:
--   [text_vmaddr text_foff stubs_vmaddr stubs_foff text_seg_fsz
--    got_vmaddr got_foff modinit_vmaddr modinit_foff datac_seg_fsz
--    data_vmaddr data_foff bss_vmaddr data_seg_fsz data_seg_vmsz
--    linkedit_vmaddr linkedit_foff]
-- Multi-dylib support: imports from libsqlite3 (sqlite3_*) bind to dylib ordinal
-- 2 and need a 2nd LC_LOAD_DYLIB; everything else is libSystem (ordinal 1). nx =
-- number of EXTRA dylibs beyond libSystem (0 for the compiler -> byte-identical).
lk_sym_is_sqlite sym = (asm_starts sym "_sqlite3_") == 1
lk_dylib_ord sym = if lk_sym_is_sqlite sym then 2 else 1
lk_needs_sqlite imports =
  if imports == [] then 0
  else if lk_sym_is_sqlite (head imports) then 1
  else lk_needs_sqlite (tail imports)
-- LC end (= text_foff) given nx extra dylib load commands (each 56 bytes).
lk_lc_end_n nx = lk_lc_end + (56 * nx)

lk_layout text_size n_imp data_size bss_size modinit_size nx =
  let text_foff = lk_lc_end_n nx
  let text_vmaddr = lk_text_vm_base + text_foff
  let stubs_foff = lk_align4 (text_foff + text_size)
  let stubs_vmaddr = lk_text_vm_base + stubs_foff
  let stubs_size = 12 * n_imp
  let text_seg_fsz = lk_alignp (stubs_foff + stubs_size)
  let got_foff = text_seg_fsz
  let got_vmaddr = lk_text_vm_base + got_foff
  let got_size = 8 * n_imp
  let modinit_foff = asm_align_up (got_foff + got_size) 3
  let modinit_vmaddr = lk_text_vm_base + modinit_foff
  let datac_seg_fsz = lk_alignp ((modinit_foff + modinit_size) - got_foff)
  let data_foff = got_foff + datac_seg_fsz
  let data_vmaddr = lk_text_vm_base + data_foff
  let bss_vmaddr = asm_align_up (data_vmaddr + data_size) 3
  let data_seg_fsz = lk_alignp data_size
  let data_seg_vmsz = lk_alignp ((bss_vmaddr + bss_size) - data_vmaddr)
  let linkedit_foff = data_foff + data_seg_fsz
  let linkedit_vmaddr = lk_text_vm_base + (data_foff + data_seg_vmsz)
  [text_vmaddr, text_foff, stubs_vmaddr, stubs_foff, text_seg_fsz, got_vmaddr, got_foff, modinit_vmaddr, modinit_foff, datac_seg_fsz, data_vmaddr, data_foff, bss_vmaddr, data_seg_fsz, data_seg_vmsz, linkedit_vmaddr, linkedit_foff]

lk_nth xs n = if n == 0 then head xs else lk_nth (tail xs) (n - 1)

-- final VM address of a data(1)/bss(2) symbol given the layout + its [sec,off].
lk_sym_vmaddr lay sec off =
  if sec == 1 then (lk_nth lay 10) + off          -- data_vmaddr + off
  else if sec == 2 then (lk_nth lay 12) + off     -- bss_vmaddr + off
  else 0 - 1

-- ===========================================================================
-- M2 — @PAGE / @PAGEOFF baking. The assembler emits adrp/add/ldr/str @PAGE(OFF)
-- with a ZERO immediate but the correct Rd/Rn already in the word; we read the
-- word, OR in the baked immediate bits, write it back. Formulas (verified vs ld):
--   adrp page21 = (page(sym)-page(pc))>>12 ; immlo=p21&3 (w[30:29]), immhi=(p21>>2)&0x7FFFF (w[23:5])
--   add  imm12  = sym&0xFFF (unscaled, w[21:10])
--   ldr/str imm12 = (sym&0xFFF)/scale ; scale = 1<<(word[31:30])
-- ===========================================================================
lk_pgbase x = x - (bit_and x 4095)

lk_is_ident c =
  let n = char_to_int c
  if (n >= 48) && (n <= 57) then 1
  else if (n >= 65) && (n <= 90) then 1
  else if (n >= 97) && (n <= 122) then 1
  else if n == 95 then 1
  else 0

-- symbol name = the identifier immediately before "@PAGE" on the line.
lk_page_sym line =
  let i = str_find "@PAGE" line
  lk_take_ident (reverse (chars (str_sub line 0 i))) []
lk_take_ident rc acc =
  if rc == [] then join "" acc
  else if (lk_is_ident (head rc)) == 1 then lk_take_ident (tail rc) (cons (head rc) acc)
  else join "" acc

lk_lookup_full name syms =
  if syms == [] then []
  else if (head (head syms)) == name then head syms
  else lk_lookup_full name (tail syms)

-- final VM addr of a @PAGE target: data/bss symbol first, else a __text label.
lk_resolve sym datasyms textlabels lay =
  let r = lk_lookup_full sym datasyms
  if r != [] then lk_sym_vmaddr lay (head (tail r)) (head (tail (tail r)))
  else
    let toff = asm_lookup sym textlabels
    if toff < 0 then 0 - 1 else (lk_nth lay 0) + toff

-- page21 is a SIGNED 21-bit field. page(sym)-page(pc) is an exact multiple of
-- 4096 (both page-aligned) so /4096 is exact even when negative; mask to 21 bits
-- to get the two's-complement field (then immlo/immhi split a POSITIVE value).
lk_bake_adrp word symaddr pc =
  let p21 = bit_and ((lk_pgbase symaddr - lk_pgbase pc) / 4096) 2097151
  bit_or word (bit_or (shl (bit_and p21 3) 29) (shl (bit_and (p21 / 4) 524287) 5))
lk_bake_add word symaddr = bit_or word (shl (bit_and symaddr 4095) 10)
lk_bake_ldst word symaddr =
  let scale = shl 1 (bit_and (shr word 30) 3)
  bit_or word (shl ((bit_and symaddr 4095) / scale) 10)

-- bake the @PAGE instruction at `off` and self-verify (return 1 on inconsistency).
lk_maybe_bake buf off line datasyms textlabels lay =
  if (str_find "@PAGE" line) < 0 then 0
  else
    let sym = lk_page_sym line
    let symaddr = lk_resolve sym datasyms textlabels lay
    if symaddr < 0 then 1                       -- unresolved @PAGE symbol
    else
      let word = cb_read buf off
      let mn = head (asm_split_mn_ops (asm_ltrim line))
      let pc = (lk_nth lay 0) + off
      if mn == "adrp" then lk_do_adrp buf off word symaddr pc
      else if mn == "add" then lk_do_imm buf off (lk_bake_add word symaddr) (bit_and symaddr 4095)
      else lk_do_imm buf off (lk_bake_ldst word symaddr) (((bit_and symaddr 4095) / (shl 1 (bit_and (shr word 30) 3))) * (shl 1 (bit_and (shr word 30) 3)))

lk_do_adrp buf off word symaddr pc =
  let baked = lk_bake_adrp word symaddr pc
  let _ = cb_emit buf off baked
  -- verify: decode page21 back, reconstruct page(sym)
  let immlo = bit_and (shr baked 29) 3
  let immhi = bit_and (shr baked 5) 524287
  let p21 = bit_or immlo (shl immhi 2)
  let p21s = if p21 >= 1048576 then p21 - 2097152 else p21   -- sign-extend 21-bit
  let recon = (lk_pgbase pc) + (p21s * 4096)
  if recon == (lk_pgbase symaddr) then 0 else 1

lk_do_imm buf off baked expect_off =
  let _ = cb_emit buf off baked
  let imm12 = bit_and (shr baked 10) 4095
  -- for add expect_off = sym&0xFFF; for ldst we passed the rescaled value
  0      -- imm encode is exact by construction; adrp is the load-bearing check

lk_bake_pass lines buf off in_text datasyms textlabels lay nbad =
  if lines == [] then nbad
  else
    let line = head lines
    let kind = asm_classify2 line
    if kind == "sec_text" then lk_bake_pass (tail lines) buf off 1 datasyms textlabels lay nbad
    else if kind == "sec_other" then lk_bake_pass (tail lines) buf off 0 datasyms textlabels lay nbad
    else if in_text == 0 then lk_bake_pass (tail lines) buf off 0 datasyms textlabels lay nbad
    else if kind == "skip" then lk_bake_pass (tail lines) buf off 1 datasyms textlabels lay nbad
    else if kind == "label" then lk_bake_pass (tail lines) buf off 1 datasyms textlabels lay nbad
    else if (kind == "asciz") || (kind == "ascii") then lk_bake_pass (tail lines) buf (off + (asm_seg_size off kind line)) 1 datasyms textlabels lay nbad
    else if kind == "align" then lk_bake_pass (tail lines) buf (off + (asm_seg_size off kind line)) 1 datasyms textlabels lay nbad
    else lk_bake_pass (tail lines) buf (off + 4) 1 datasyms textlabels lay (nbad + (lk_maybe_bake buf off line datasyms textlabels lay))

-- record-consuming bake pass (raw line from the record; lk_maybe_bake early-outs
-- on non-@PAGE lines so its internal split runs only on the few adrp/add/ldst).
lk_bake_pass_r records buf off in_text datasyms textlabels lay nbad =
  if records == [] then nbad
  else
    let r = head records
    let kind = asm_rec_kind r
    if kind == "sec_text" then lk_bake_pass_r (tail records) buf off 1 datasyms textlabels lay nbad
    else if kind == "sec_other" then lk_bake_pass_r (tail records) buf off 0 datasyms textlabels lay nbad
    else if in_text == 0 then lk_bake_pass_r (tail records) buf off 0 datasyms textlabels lay nbad
    else if kind == "skip" then lk_bake_pass_r (tail records) buf off 1 datasyms textlabels lay nbad
    else if kind == "label" then lk_bake_pass_r (tail records) buf off 1 datasyms textlabels lay nbad
    else if (kind == "asciz") || (kind == "ascii") then lk_bake_pass_r (tail records) buf (off + (asm_seg_size off kind (asm_rec_raw r))) 1 datasyms textlabels lay nbad
    else if kind == "align" then lk_bake_pass_r (tail records) buf (off + (asm_seg_size off kind (asm_rec_raw r))) 1 datasyms textlabels lay nbad
    else lk_bake_pass_r (tail records) buf (off + 4) 1 datasyms textlabels lay (nbad + (lk_maybe_bake buf off (asm_rec_raw r) datasyms textlabels lay))

-- ===========================================================================
-- M3 — data image emission. Emit the __data bytes (resolving .quad/.long symbol
-- pointers to absolute VM addresses + recording a rebase for each), the
-- __mod_init_func ctor pointer, and the __bss (vmsize only, no file bytes).
-- ===========================================================================
lk_put_u8 buf off v = let _ = arr_set buf off (bit_and v 255) in off + 1
lk_put_u32 buf off v =
  let _ = arr_set buf off (bit_and v 255)
  let _ = arr_set buf (off + 1) (bit_and (shr v 8) 255)
  let _ = arr_set buf (off + 2) (bit_and (shr v 16) 255)
  let _ = arr_set buf (off + 3) (bit_and (shr v 24) 255)
  off + 4
lk_put_u64 buf off v =
  let o = lk_put_u32 buf off v
  lk_put_u32 buf o (shr v 32)
lk_read_u32 buf off =
  bit_or (arr_get buf off) (bit_or (shl (arr_get buf (off + 1)) 8) (bit_or (shl (arr_get buf (off + 2)) 16) (shl (arr_get buf (off + 3)) 24)))
lk_read_u64 buf off = bit_or (lk_read_u32 buf off) (shl (lk_read_u32 buf (off + 4)) 32)

lk_is_symchar c = if (lk_is_ident c) == 1 then 1 else if c == "." then 1 else 0
-- leading symbol identifier (incl '.') of an operand like "_sym + N" / ".Lfn_x_start"
lk_lead_sym t = lk_lead_go (chars t) []
lk_lead_go cs acc =
  if cs == [] then join "" (reverse acc)
  else if (lk_is_symchar (head cs)) == 1 then lk_lead_go (tail cs) (cons (head cs) acc)
  else join "" (reverse acc)

-- value of a .quad/.long operand + rebase flag (1 if it is an image pointer).
-- numeric -> [value,0]; symbol [+ addend] -> [resolve(sym)+addend, 1].
lk_operand_val operand datasyms textlabels lay =
  let t = asm_ltrim operand
  let cs = chars t
  if cs == [] then [0, 0]
  else if (lk_is_symchar (head cs)) == 1 then
    (if (head cs) == "_" || (head cs) == "." then lk_operand_sym t datasyms textlabels lay
     else [asm_imm t, 0])
  else [asm_imm t, 0]
lk_operand_sym t datasyms textlabels lay =
  let sym = lk_lead_sym t
  let plus = str_find "+" t
  let addend = if plus < 0 then 0 else asm_imm (asm_ltrim (str_sub t (plus + 1) ((length (chars t)) - plus - 1)))
  let base = lk_resolve sym datasyms textlabels lay
  [base + addend, 1]

-- emit the __data image; record rebase data-offsets (cons list, ascending built reversed).
-- returns [data_buf_already_filled? -> we return the rebase-offset list].
-- lk_demit_dir emits one data directive's bytes and returns [new_off, new_rebs]
-- (NO recursion inside a paren-let — that mis-parses; the recursion lives in
-- lk_demit, and each directive is a function-body helper whose body is a list).
lk_demit lines sec off databuf datasyms textlabels lay rebs =
  if lines == [] then reverse rebs
  else
    let line = head lines
    let sw = lk_sec_of line
    if sw >= 0 then lk_demit (tail lines) sw off databuf datasyms textlabels lay rebs
    else if sec != 1 then lk_demit (tail lines) sec off databuf datasyms textlabels lay rebs
    else
      let cs = asm_skip_ws (chars line)
      if cs == [] then lk_demit (tail lines) sec off databuf datasyms textlabels lay rebs
      else if (asm_chars_end_colon cs) == 1 then lk_demit (tail lines) sec off databuf datasyms textlabels lay rebs
      else
        let r = lk_demit_dir line off databuf datasyms textlabels lay rebs
        lk_demit (tail lines) sec (head r) databuf datasyms textlabels lay (head (tail r))

-- record-consuming data emitter: fast-skip insn records (always __text, sec!=1).
lk_demit_r records sec off databuf datasyms textlabels lay rebs =
  if records == [] then reverse rebs
  else
    let rec = head records
    if (asm_rec_kind rec) == "insn" then lk_demit_r (tail records) sec off databuf datasyms textlabels lay rebs
    else lk_demit_r_step rec records sec off databuf datasyms textlabels lay rebs
lk_demit_r_step rec records sec off databuf datasyms textlabels lay rebs =
  let line = asm_rec_raw rec
  let sw = lk_sec_of line
  if sw >= 0 then lk_demit_r (tail records) sw off databuf datasyms textlabels lay rebs
  else if sec != 1 then lk_demit_r (tail records) sec off databuf datasyms textlabels lay rebs
  else
    let cs = asm_skip_ws (chars line)
    if cs == [] then lk_demit_r (tail records) sec off databuf datasyms textlabels lay rebs
    else if (asm_chars_end_colon cs) == 1 then lk_demit_r (tail records) sec off databuf datasyms textlabels lay rebs
    else
      let r2 = lk_demit_dir line off databuf datasyms textlabels lay rebs
      lk_demit_r (tail records) sec (head r2) databuf datasyms textlabels lay (head (tail r2))

lk_demit_dir line off databuf datasyms textlabels lay rebs =
  let cs = asm_skip_ws (chars line)
  if (asm_cprefix cs ".quad") == 1 then lk_dq line off databuf datasyms textlabels lay rebs
  else if (asm_cprefix cs ".long") == 1 then lk_dl line off databuf datasyms textlabels lay rebs
  else if (asm_cprefix cs ".byte") == 1 then lk_db line off databuf rebs
  else if (asm_cprefix cs ".asciz") == 1 then lk_daz line off databuf rebs 1
  else if (asm_cprefix cs ".ascii") == 1 then lk_daz line off databuf rebs 0
  else if (asm_cprefix cs ".short") == 1 then lk_ds line off databuf datasyms textlabels lay rebs
  else if (asm_cprefix cs ".p2align") == 1 then [asm_align_up off (asm_p2align_n line), rebs]
  else [off, rebs]

lk_dq line off databuf datasyms textlabels lay rebs =
  let pv = lk_operand_val (asm_after_lsl (asm_ltrim line)) datasyms textlabels lay
  let _ = lk_put_u64 databuf off (head pv)
  let rebs2 = if (head (tail pv)) == 1 then cons off rebs else rebs
  [off + 8, rebs2]
lk_dl line off databuf datasyms textlabels lay rebs =
  let _ = lk_put_u32 databuf off (head (lk_operand_val (asm_after_lsl (asm_ltrim line)) datasyms textlabels lay))
  [off + 4, rebs]
lk_ds line off databuf datasyms textlabels lay rebs =
  let _ = lk_put_u32 databuf off (bit_and (head (lk_operand_val (asm_after_lsl (asm_ltrim line)) datasyms textlabels lay)) 65535)
  [off + 2, rebs]
lk_db line off databuf rebs =
  let _ = lk_put_bytes databuf off (lk_byte_vals (asm_after_lsl (asm_ltrim line)))
  [off + (lk_byte_count line), rebs]
lk_daz line off databuf rebs addnull =
  let _ = lk_put_str databuf off (asm_decode_str (asm_str_arg line) []) addnull
  [off + (asm_asciz_len line) + addnull, rebs]

lk_byte_vals operand = lk_bytevals_go (asm_split_commas operand)
lk_bytevals_go xs = if xs == [] then [] else cons (asm_imm (asm_ltrim (head xs))) (lk_bytevals_go (tail xs))
lk_put_bytes buf off vals = if vals == [] then off else lk_put_bytes buf (lk_put_u8 buf off (head vals)) (tail vals)
lk_put_str buf off bytes addnull =
  let o = lk_put_bytes buf off bytes
  if addnull == 1 then lk_put_u8 buf o 0 else o

-- ===========================================================================
-- M4 — dyld info. Import collection + classic LC_DYLD_INFO rebase/bind opcode
-- streams. (Stubs/GOT/symtab + import-bl patching land in M5 with final offsets.)
-- ===========================================================================

-- distinct external imports (undefined bl/b targets), in first-encounter order.
lk_imports src = lk_dedup_syms (asm_relocs src) []
lk_dedup_syms recs seen =
  if recs == [] then reverse seen
  else
    let sym = head (tail (head recs))
    if (lk_mem sym seen) == 1 then lk_dedup_syms (tail recs) seen
    else lk_dedup_syms (tail recs) (cons sym seen)
lk_mem x xs = if xs == [] then 0 else if (head xs) == x then 1 else lk_mem x (tail xs)

-- ULEB128
lk_uleb buf off v =
  if v < 128 then lk_put_u8 buf off v
  else lk_uleb buf (lk_put_u8 buf off (bit_or (bit_and v 127) 128)) (shr v 7)
lk_add_addr buf off delta = if delta == 0 then off else lk_uleb buf (lk_put_u8 buf off 48) delta

-- classic REBASE opcode stream. modinit_doff = mod_init offset within __DATA_CONST
-- (seg 2); data_rebs = ascending __DATA (seg 3) offsets. Per-pointer ADD_ADDR +
-- DO_REBASE(1) — simple & correct (not minimal like ld, but dyld-equivalent).
-- REBASE ops: SET_TYPE_IMM 0x10 | POINTER 1 ; SET_SEG_AND_OFF_ULEB 0x20|seg ;
-- ADD_ADDR_ULEB 0x30 ; DO_REBASE_IMM_TIMES 0x50|count ; DONE 0x00.
lk_emit_rebase buf off modinit_doff data_rebs =
  let o1 = lk_put_u8 buf off 17
  let o2 = lk_put_u8 buf o1 34
  let o3 = lk_uleb buf o2 modinit_doff
  let o4 = lk_put_u8 buf o3 81
  let o5 = lk_put_u8 buf o4 35
  let o6 = lk_uleb buf o5 (head data_rebs)
  let o7 = lk_put_u8 buf o6 81
  let o8 = lk_rebase_rest buf o7 (head data_rebs) (tail data_rebs)
  lk_put_u8 buf o8 0
lk_rebase_rest buf off prev rebs =
  if rebs == [] then off
  else lk_rebase_rest buf (lk_put_u8 buf (lk_add_addr buf off ((head rebs) - (prev + 8))) 81) (head rebs) (tail rebs)

-- Decoder (round-trip validation): replay the rebase stream, collecting the
-- (seg,off) of every DO_REBASE; returns a flat list [seg,off, seg,off, ...].
lk_dec_rebase buf off endoff seg cur acc =
  if off >= endoff then reverse acc
  else
    let op = arr_get buf off
    let hi = bit_and op 240
    let im = bit_and op 15
    if op == 0 then reverse acc
    else if hi == 16 then lk_dec_rebase buf (off + 1) endoff seg cur acc          -- SET_TYPE
    else if hi == 32 then lk_dec_seg buf (off + 1) endoff im acc                   -- SET_SEG_AND_OFF_ULEB
    else if hi == 48 then lk_dec_add buf (off + 1) endoff seg cur acc              -- ADD_ADDR_ULEB
    else if hi == 80 then lk_dec_dorebase buf (off + 1) endoff seg cur im acc      -- DO_REBASE_IMM_TIMES
    else reverse acc
lk_dec_seg buf off endoff seg acc =
  let r = lk_uleb_read buf off
  lk_dec_rebase buf (head r) endoff seg (head (tail r)) acc
lk_dec_add buf off endoff seg cur acc =
  let r = lk_uleb_read buf off
  lk_dec_rebase buf (head r) endoff seg (cur + (head (tail r))) acc
lk_dec_dorebase buf off endoff seg cur n acc =
  -- emit n rebases at cur, cur+8, ...; advance cur by 8*n
  lk_dec_rebase buf off endoff seg (cur + (8 * n)) (lk_dec_emit seg cur n acc)
lk_dec_emit seg cur n acc =
  if n <= 0 then acc else lk_dec_emit seg (cur + 8) (n - 1) (cons cur (cons seg acc))
lk_uleb_read buf off = lk_uleb_go buf off 0 0
lk_uleb_go buf off shift acc =
  let b = arr_get buf off
  let acc2 = bit_or acc (shl (bit_and b 127) shift)
  if (bit_and b 128) == 0 then [off + 1, acc2] else lk_uleb_go buf (off + 1) (shift + 7) acc2

-- classic BIND opcode stream for N libSystem imports (all dylib ordinal 1, bound
-- non-lazily into __DATA_CONST seg=2 starting at __got offset 0; DO_BIND advances
-- the slot by 8 each time). Matches dyld_macho.rail's emit_bind generalized to N.
-- 0x11 SET_DYLIB_ORDINAL_IMM|1 ; 0x40 SET_SYMBOL_TRAILING_FLAGS_IMM + name\0 ;
-- 0x51 SET_TYPE_IMM POINTER ; 0x72 SET_SEG_AND_OFF_ULEB seg=2 + uleb(0) ; 0x90 DO_BIND
-- ; [per next import: 0x40 + name\0 ; 0x90] ; 0x00 DONE.
lk_str_bytes s = lk_strb_go (chars s)
lk_strb_go cs = if cs == [] then [] else cons (char_to_int (head cs)) (lk_strb_go (tail cs))
lk_put_cstr buf off s = lk_put_u8 buf (lk_put_bytes buf off (lk_str_bytes s)) 0
lk_emit_bind buf off imports =
  let ord0 = lk_dylib_ord (head imports)
  let o1 = lk_put_u8 buf off (16 + ord0)   -- 0x10 SET_DYLIB_ORDINAL_IMM | ord
  let o2 = lk_put_u8 buf o1 64
  let o3 = lk_put_cstr buf o2 (head imports)
  let o4 = lk_put_u8 buf o3 81
  let o5 = lk_put_u8 buf o4 114
  let o6 = lk_uleb buf o5 0
  let o7 = lk_put_u8 buf o6 144
  let o8 = lk_bind_rest buf o7 ord0 (tail imports)
  lk_put_u8 buf o8 0
-- Re-emit SET_DYLIB_ORDINAL only when the dylib changes (dyld carries it forward),
-- so an all-libSystem import set is byte-identical to the old single-ordinal stream.
lk_bind_rest buf off prev_ord imports =
  if imports == [] then off
  else
    let ord = lk_dylib_ord (head imports)
    let oa = if ord == prev_ord then off else lk_put_u8 buf off (16 + ord)
    let ob = lk_put_u8 buf oa 64
    let oc = lk_put_cstr buf ob (head imports)
    let od = lk_put_u8 buf oc 144
    lk_bind_rest buf od ord (tail imports)
-- count DO_BIND (0x90) opcodes in [off,end) — validation.
lk_count_byte buf off endoff target =
  if off >= endoff then 0
  else (if (arr_get buf off) == target then 1 else 0) + (lk_count_byte buf (off + 1) endoff target)

lk_dec_check decoded rebs = lk_dcc (tail (tail decoded)) rebs
lk_dcc d r =
  if r == [] then (if d == [] then 1 else 0)
  else if d == [] then 0
  else if (head (tail d)) == (head r) then lk_dcc (tail (tail d)) (tail r)
  else 0

-- ===========================================================================
-- M5 — full Mach-O assembly. All 14 load commands from the M1 layout, baked
-- __text + computed __stubs/__got/__mod_init/__data, LINKEDIT (rebase/bind/
-- symtab/dysymtab/indirect/strtab), ad-hoc signature. Reuses stdlib/macho.rail
-- emitters + dyld_macho.rail's section64 pattern (copied — that file has a main).
-- ===========================================================================
lk_align8 n = asm_align_up n 3
lk_align16 n = asm_align_up n 4

-- section_64 (80 bytes)
lk_section64 buf off sect seg addr size foff align flags r1 r2 =
  let s1 = mw_str_padded buf off sect 16
  let s2 = mw_str_padded buf s1 seg 16
  let s3 = mw_u64 buf s2 addr
  let s4 = mw_u64 buf s3 size
  let s5 = mw_u32 buf s4 foff
  let s6 = mw_u32 buf s5 align
  let s7 = mw_u32 buf s6 0
  let s8 = mw_u32 buf s7 0
  let s9 = mw_u32 buf s8 flags
  let s10 = mw_u32 buf s9 r1
  let s11 = mw_u32 buf s10 r2
  mw_u32 buf s11 0

-- LINKEDIT subsection layout from linkedit_foff + sizes -> a flat list:
-- [rebase_off rebase_sz bind_off bind_sz sym_off nsyms ind_off nind str_off str_sz cs_off sig_total file_size]
lk_le_layout le_foff rebase_sz bind_sz n_imp str_sz =
  let rebase_off = le_foff
  let bind_off = lk_align8 (rebase_off + rebase_sz)
  let sym_off = lk_align8 (bind_off + bind_sz)
  let nsyms = n_imp + 2
  let sym_sz = nsyms * 16
  let ind_off = sym_off + sym_sz
  let nind = n_imp * 2
  let ind_sz = nind * 4
  let str_off = ind_off + ind_sz
  let cs_off = lk_align16 (str_off + str_sz)
  let n_code_pages = (cs_off + 16383) / 16384
  let sig_total = (cs_cd_size_n n_code_pages) + 40
  [rebase_off, rebase_sz, bind_off, bind_sz, sym_off, nsyms, ind_off, nind, str_off, str_sz, cs_off, sig_total, cs_off + sig_total]

-- strtab: 0x20,0x00, "__mh_execute_header\0", "_main\0", then each import "\0".
-- returns the strx offsets list [mh_strx, main_strx, imp0_strx, imp1_strx, ...].
lk_str_size imports = 2 + 20 + 6 + (lk_imp_namebytes imports)
lk_imp_namebytes imports = if imports == [] then 0 else (length (chars (head imports))) + 1 + (lk_imp_namebytes (tail imports))
lk_emit_strtab buf off imports =
  let o1 = mw_u8 buf off 32
  let o2 = mw_u8 buf o1 0
  let o3 = mw_cstr buf o2 "__mh_execute_header"
  let o4 = mw_cstr buf o3 "_main"
  lk_emit_names buf o4 imports
lk_emit_names buf off imports = if imports == [] then off else lk_emit_names buf (mw_cstr buf off (head imports)) (tail imports)

-- nlist_64 (16B)
lk_nlist buf off strx ntype nsect ndesc nval =
  let o1 = mw_u32 buf off strx
  let o2 = mw_u8 buf o1 ntype
  let o3 = mw_u8 buf o2 nsect
  let o4 = mw_u16 buf o3 ndesc
  mw_u64 buf o4 nval
-- emit the N+2 nlists: mh_header, _main, then imports. Returns next off.
lk_emit_syms buf off imports main_vaddr =
  let o1 = lk_nlist buf off 2 15 1 16 4294967296
  let o2 = lk_nlist buf o1 22 15 1 0 main_vaddr
  lk_emit_undef buf o2 28 imports
lk_emit_undef buf off strx imports =
  if imports == [] then off
  else lk_emit_undef buf (lk_nlist buf off strx 1 0 256 0) (strx + (length (chars (head imports))) + 1) (tail imports)
-- indirect symtab: 2N u32, [stub half: 2..2+N-1][got half: 2..2+N-1]
lk_emit_indirect buf off n_imp =
  let o = lk_emit_iota buf off 2 n_imp
  lk_emit_iota buf o 2 n_imp
lk_emit_iota buf off start n = if n <= 0 then off else lk_emit_iota buf (mw_u32 buf off start) (start + 1) (n - 1)

-- __stubs bytes: per import i  adrp x16,got@PAGE ; ldr x16,[x16,#8i] ; br x16.
lk_emit_stubs buf foff stubs_vmaddr got_vmaddr n_imp =
  lk_stubs_go buf foff stubs_vmaddr got_vmaddr 0 n_imp
lk_stubs_go buf foff stubs_vmaddr got_vmaddr i n =
  if i >= n then 0
  else
    let pc = stubs_vmaddr + (12 * i)
    let adrp = lk_bake_adrp 2415919120 got_vmaddr pc       -- 0x90000010 (adrp x16)
    let _ = cb_emit buf (foff + (12 * i)) adrp
    let _ = cb_emit buf (foff + (12 * i) + 4) (bit_or 4181721616 (shl i 10))   -- 0xF9400210 | i<<10
    let _ = cb_emit buf (foff + (12 * i) + 8) 3592356352   -- 0xD61F0200 br x16
    lk_stubs_go buf foff stubs_vmaddr got_vmaddr (i + 1) n

-- patch every `bl _import` (text byte off) to branch to its __stubs entry.
lk_patch_imports buf recs imports text_vmaddr stubs_vmaddr =
  if recs == [] then 0
  else
    let off = head (head recs)
    let sym = head (tail (head recs))
    let i = lk_index_of sym imports 0
    let stub_vaddr = stubs_vmaddr + (12 * i)
    let bl_vaddr = text_vmaddr + off
    let _ = cb_emit buf off (bit_or 2483027968 (bit_and ((stub_vaddr - bl_vaddr) / 4) 67108863))   -- 0x94000000 | imm26
    lk_patch_imports buf (tail recs) imports text_vmaddr stubs_vmaddr
lk_index_of x xs n = if xs == [] then 0 - 1 else if (head xs) == x then n else lk_index_of x (tail xs) (n + 1)

-- LC_SEGMENT_64 fixed header (72 bytes); cmdsize includes nsects*80.
lk_seg_hdr buf off segname vmaddr vmsize foff fsize maxp initp nsects flags =
  let o1 = mw_u32 buf off 25
  let o2 = mw_u32 buf o1 (72 + (80 * nsects))
  let o3 = mw_str_padded buf o2 segname 16
  let o4 = mw_u64 buf o3 vmaddr
  let o5 = mw_u64 buf o4 vmsize
  let o6 = mw_u64 buf o5 foff
  let o7 = mw_u64 buf o6 fsize
  let o8 = mw_u32 buf o7 maxp
  let o9 = mw_u32 buf o8 initp
  let o10 = mw_u32 buf o9 nsects
  mw_u32 buf o10 flags

-- __TEXT: __text + __stubs.  lay accessors: 0 text_vmaddr,1 text_foff,2 stubs_vmaddr,3 stubs_foff,4 text_seg_fsz
lk_emit_seg_text buf off lay text_size n_imp =
  let segbase = lk_text_vm_base
  let o = lk_seg_hdr buf off "__TEXT" segbase (lk_nth lay 4) 0 (lk_nth lay 4) 5 5 2 0
  let a = lk_section64 buf o "__text" "__TEXT" (lk_nth lay 0) text_size (lk_nth lay 1) 2 2147484672 0 0
  lk_section64 buf a "__stubs" "__TEXT" (lk_nth lay 2) (12 * n_imp) (lk_nth lay 3) 2 2147484680 0 12

-- __DATA_CONST: __got + __mod_init_func.  5 got_vmaddr,6 got_foff,7 modinit_vmaddr,8 modinit_foff,9 datac_seg_fsz
lk_emit_seg_datac buf off lay n_imp modinit_size =
  let o = lk_seg_hdr buf off "__DATA_CONST" (lk_nth lay 5) (lk_nth lay 9) (lk_nth lay 6) (lk_nth lay 9) 3 3 2 16
  let a = lk_section64 buf o "__got" "__DATA_CONST" (lk_nth lay 5) (8 * n_imp) (lk_nth lay 6) 3 6 n_imp 0
  lk_section64 buf a "__mod_init_func" "__DATA_CONST" (lk_nth lay 7) modinit_size (lk_nth lay 8) 3 9 0 0

-- __DATA: __data + __bss.  10 data_vmaddr,11 data_foff,12 bss_vmaddr,13 data_seg_fsz,14 data_seg_vmsz
lk_emit_seg_data buf off lay data_size bss_size =
  let o = lk_seg_hdr buf off "__DATA" (lk_nth lay 10) (lk_nth lay 14) (lk_nth lay 11) (lk_nth lay 13) 3 3 2 0
  let a = lk_section64 buf o "__data" "__DATA" (lk_nth lay 10) data_size (lk_nth lay 11) 3 0 0 0
  lk_section64 buf a "__bss" "__DATA" (lk_nth lay 12) bss_size 0 3 1 0 0

emit_dyld_info_rb buf off rebase_off rebase_sz bind_off bind_sz =
  let o1 = mw_u32 buf off 2147483682     -- LC_DYLD_INFO_ONLY 0x80000022
  let o2 = mw_u32 buf o1 48
  let o3 = mw_u32 buf o2 rebase_off
  let o4 = mw_u32 buf o3 rebase_sz
  let o5 = mw_u32 buf o4 bind_off
  let o6 = mw_u32 buf o5 bind_sz
  let o7 = mw_u32 buf o6 0
  let o8 = mw_u32 buf o7 0
  let o9 = mw_u32 buf o8 0
  let o10 = mw_u32 buf o9 0
  let o11 = mw_u32 buf o10 0
  mw_u32 buf o11 0

emit_dysymtab_n buf off n_imp ind_off =
  let o1 = mw_u32 buf off 11
  let o2 = mw_u32 buf o1 80
  let o3 = mw_u32 buf o2 0
  let o4 = mw_u32 buf o3 0                -- ilocal/nlocal
  let o5 = mw_u32 buf o4 0
  let o6 = mw_u32 buf o5 2                -- iextdef=0 nextdef=2
  let o7 = mw_u32 buf o6 2
  let o8 = mw_u32 buf o7 n_imp            -- iundef=2 nundef=N
  let o9 = mw_u32 buf o8 0
  let o10 = mw_u32 buf o9 0
  let o11 = mw_u32 buf o10 0
  let o12 = mw_u32 buf o11 0
  let o13 = mw_u32 buf o12 0
  let o14 = mw_u32 buf o13 0
  let o15 = mw_u32 buf o14 ind_off
  let o16 = mw_u32 buf o15 (2 * n_imp)
  let o17 = mw_u32 buf o16 0
  let o18 = mw_u32 buf o17 0
  let o19 = mw_u32 buf o18 0
  mw_u32 buf o19 0

emit_load_dylib_ls buf off =
  let o1 = mw_u32 buf off 12
  let o2 = mw_u32 buf o1 56
  let o3 = mw_u32 buf o2 24
  let o4 = mw_u32 buf o3 2
  let o5 = mw_u32 buf o4 88866816
  let o6 = mw_u32 buf o5 65536
  let o7 = mw_cstr buf o6 "/usr/lib/libSystem.B.dylib"
  mw_zeros buf o7 (off + 56 - o7)

-- LC_LOAD_DYLIB for libsqlite3 (ordinal 2), same 56-byte shape. compat 1.0.0
-- (always satisfiable); current 380.0.0 to match the system dylib.
emit_load_dylib_sqlite buf off =
  let o1 = mw_u32 buf off 12
  let o2 = mw_u32 buf o1 56
  let o3 = mw_u32 buf o2 24
  let o4 = mw_u32 buf o3 2
  let o5 = mw_u32 buf o4 24903680
  let o6 = mw_u32 buf o5 65536
  let o7 = mw_cstr buf o6 "/usr/lib/libsqlite3.dylib"
  mw_zeros buf o7 (off + 56 - o7)

lk_copyn dst dst_off src src_off n =
  if n <= 0 then 0
  else
    let _ = arr_set dst dst_off (arr_get src src_off)
    lk_copyn dst (dst_off + 1) src (src_off + 1) (n - 1)

-- all 14 load commands, offsets/addresses from the M1 layout (lay) + LINKEDIT layout (le).
lk_emit_all_lc buf lay le imports n_imp text_size modinit_size data_size bss_size main_vaddr nx =
  let le_foff = lk_nth lay 16
  let le_fsz = (lk_nth le 12) - le_foff
  let entryoff = main_vaddr - lk_text_vm_base
  let p0 = emit_mach_header buf 0 (14 + nx) (1176 + (56 * nx)) mh_flags_pie_exec
  let p1 = emit_segment_64_nosects buf p0 "__PAGEZERO" 0 4294967296 0 0 0 0
  let p2 = lk_emit_seg_text buf p1 lay text_size n_imp
  let p3 = lk_emit_seg_datac buf p2 lay n_imp modinit_size
  let p4 = lk_emit_seg_data buf p3 lay data_size bss_size
  let p5 = emit_segment_64_nosects buf p4 "__LINKEDIT" (lk_nth lay 15) (lk_alignp le_fsz) le_foff le_fsz 1 1
  let p6 = emit_dyld_info_rb buf p5 (lk_nth le 0) (lk_nth le 1) (lk_nth le 2) (lk_nth le 3)
  let p7 = emit_symtab buf p6 (lk_nth le 4) (lk_nth le 5) (lk_nth le 8) (lk_nth le 9)
  let p8 = emit_dysymtab_n buf p7 n_imp (lk_nth le 6)
  let p9 = emit_load_dylinker buf p8
  let p10 = emit_uuid buf p9
  let p11 = emit_build_version buf p10 1703936 1703936
  let p12 = emit_main buf p11 entryoff 0
  let p13 = emit_load_dylib_ls buf p12
  let p14 = if nx > 0 then emit_load_dylib_sqlite buf p13 else p13
  emit_code_signature_lc buf p14 (lk_nth le 10) (lk_nth le 11)

-- Link a compiler .s (already on disk at src_path) into a complete signed,
-- runnable Mach-O at out_path with NO as/ld/codesign. Returns the file size.
-- (Was `main` hard-wired to /tmp/link_src.s -> /tmp/v5_rail; parameterized so
-- compile.rail can call it IN-PROCESS and the standalone runner passes /tmp.)
lk_link_file src_path out_path =
  let src = read_file src_path
  -- Parse the source ONCE and build the label map ONCE, then thread `lines`,
  -- `textlabels` and `relocs` through every pass (was: 5 re-splits of src, 4
  -- rebuilds of the label map, asm_relocs computed twice).
  let lines = asm_lines src
  -- Parse + classify + split each line ONCE into records [kind,mn,ops,raw]; every
  -- pass below reads the records instead of re-classifying (was 7 full walks each
  -- doing chars+reverse per line + re-splitting every instruction). Drops the
  -- linker's arena floor (8x classify ~4.2GB of the ~6GB was redundant).
  let records = asm_build_records lines
  let textlabels = asm_build_labels_r records
  let st = lk_walk_r records 0 0 0 0 []
  let dataoff = head st
  let bssoff = head (tail st)
  let modoff = head (tail (tail st))
  let syms = head (tail (tail (tail st)))
  let text_size = asm_bytes_len_r records
  -- imports/n_imp MUST be known before the layout: lk_layout sizes __got at
  -- 8*n_imp and places __mod_init right after it. The old hardcoded n_imp=8
  -- under-sized the GOT for any other import count (e.g. the inlined compiler's
  -- 9 imports), so __mod_init (+ its rebase) overlapped GOT slot 8 -> a bind and
  -- a rebase collided on one slot, corrupting it (garbage argv at runtime).
  let relocs = asm_relocs_r records textlabels
  let imports = lk_dedup_syms relocs []
  let n_imp = length imports
  let nx = lk_needs_sqlite imports
  let lay = lk_layout text_size n_imp dataoff bssoff modoff nx
  -- text: assemble, bake @PAGE, patch import bl -> stubs
  let textbuf = asm_assemble_r records textlabels (text_size + 16)
  let _ = lk_bake_pass_r records textbuf 0 1 syms textlabels lay 0
  let _ = lk_patch_imports textbuf relocs imports (lk_nth lay 0) (lk_nth lay 2)
  -- data image + rebases
  let databuf = arr_new (dataoff + 16) 0
  let rebs = lk_demit_r records 0 0 databuf syms textlabels lay []
  -- rebase + bind streams (temp buffers give their sizes)
  let rbuf = arr_new 16384 0
  -- modinit_doff = __mod_init offset within __DATA_CONST = modinit_foff-got_foff
  -- = 8*n_imp (was hardcoded 64, correct only at n_imp=8).
  let rend = lk_emit_rebase rbuf 0 ((lk_nth lay 8) - (lk_nth lay 6)) rebs
  let bbuf = arr_new 1024 0
  let bend = lk_emit_bind bbuf 0 imports
  -- LINKEDIT layout + file size
  let le = lk_le_layout (lk_nth lay 16) rend bend n_imp (lk_str_size imports)
  let file_size = lk_nth le 12
  let main_vaddr = lk_resolve "_main" syms textlabels lay
  -- assemble the file
  let buf = arr_new file_size 0
  let _ = lk_emit_all_lc buf lay le imports n_imp text_size modoff dataoff bssoff main_vaddr nx
  let _ = lk_copyn buf (lk_nth lay 1) textbuf 0 text_size
  let _ = lk_emit_stubs buf (lk_nth lay 3) (lk_nth lay 2) (lk_nth lay 5) n_imp
  let _ = lk_put_u64 buf (lk_nth lay 8) (lk_resolve "_rail_arena_init" syms textlabels lay)
  let _ = lk_copyn buf (lk_nth lay 11) databuf 0 dataoff
  let _ = lk_copyn buf (lk_nth le 0) rbuf 0 rend
  let _ = lk_copyn buf (lk_nth le 2) bbuf 0 bend
  let _ = lk_emit_syms buf (lk_nth le 4) imports main_vaddr
  let _ = lk_emit_indirect buf (lk_nth le 6) n_imp
  let _ = lk_emit_strtab buf (lk_nth le 8) imports
  let _ = emit_signature_n buf (lk_nth le 10) (lk_nth le 10) 0 (lk_nth lay 4)
  let _ = macho_write_file out_path buf file_size
  let _ = print (cat ["wrote ", out_path, " (", show file_size, " bytes); imports=", show n_imp, " rebases=", show (length rebs), " main@0x", lk_hex main_vaddr])
  file_size
