-- tools/v5/link_macho.rail — standalone runner for the Rail Mach-O linker.
--
-- The linker LOGIC (lk_link_file + every lk_*/emit_* helper) now lives in
-- tools/v5/link_lib.rail (importable, no `main`) so tools/compile.rail can call
-- lk_link_file IN-PROCESS during self-compile (no shell-out, no as/ld/codesign).
-- This thin wrapper preserves the standalone build + every existing invocation:
--   ./rail_native --out-prefix /tmp/v5_linker tools/v5/link_macho.rail
-- reads /tmp/link_src.s and writes the signed Mach-O to /tmp/v5_rail.
import "tools/v5/link_lib.rail"

main =
  let _ = lk_link_file "/tmp/link_src.s" "/tmp/v5_rail"
  0
