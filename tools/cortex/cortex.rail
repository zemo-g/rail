-- tools/cortex/cortex.rail — the empire's cortex
--
-- Pure Rail. Spiritual successor to ~/empire/legacy/cortex_v1/ (Python,
-- retired 2026-02-26). v2 is an LLM tool-loop wrapped in v1's safety
-- scaffolding (4 tiers, cooldowns, rate limits, kill switch, audit).
--
-- v1 of cortex.rail: tiers + tools encoded as parallel arrays / int
-- codes rather than ADTs. Rail's compiler had pathological compile
-- time on the ADT version (>6 min hang) — the parallel-list version
-- is uglier but compiles in seconds.

-- TLS imports: only ONE of the TLS-using stdlib clients can be in scope
-- without hanging the compiler — the duplicate transitive imports of
-- the TLS stack trigger a pathological compile path. We keep
-- anthropic_client (needed for Claude) and shell out to curl for the
-- one Slack post per tick. Earned 2026-05-04 after a 6-min compile hang.
import "stdlib/anthropic_client.rail"

-- ── paths ──────────────────────────────────────────────────────────
cortex_dir _ = "/Users/ledaticempire/.ledatic/cortex"
kill_switch _ = "/Users/ledaticempire/.ledatic/cortex/kill"
audit_log _ = "/Users/ledaticempire/.ledatic/cortex/decisions.jsonl"
state_file _ = "/Users/ledaticempire/.ledatic/cortex/state.json"
escalation_dir _ = "/Users/ledaticempire/.ledatic/cortex/escalations"
goals_file _ = "/Users/ledaticempire/.ledatic/cortex/goals.md"
anthropic_key _ = "/Users/ledaticempire/.fleet/anthropic_key"
slack_token _ = "/Users/ledaticempire/.fleet/slack_token"
slack_channel _ = "D0ATHQ1BQD7"

-- ── safety tiers (int codes — 0/1/2/3) ─────────────────────────────
tier_always_safe _ = 0
tier_reversible _ = 1
tier_money _ = 2
tier_human _ = 3

tier_label t =
  if t == 0 then "AlwaysSafe"
  else if t == 1 then "Reversible"
  else if t == 2 then "Money"
  else "Human"

tier_max_per_hour t =
  if t == 0 then 10
  else if t == 1 then 3
  else if t == 2 then 2
  else 1

tier_cooldown_sec t =
  if t == 0 then 120
  else if t == 1 then 600
  else if t == 2 then 1800
  else 3600

-- ── tool whitelist (parallel lists, indexed by position) ───────────
tool_names _ = [
  "wait",
  "audit_dry",
  "audit",
  "verify",
  "tail_heal",
  "tail_drift",
  "tail_attest"
]

tool_tiers _ = [0, 0, 0, 0, 0, 0, 0]

tool_cmds _ = [
  "",
  "/Users/ledaticempire/projects/rail-https/tools/attest/drift_audit.sh --dry",
  "/Users/ledaticempire/projects/rail-https/tools/attest/drift_audit.sh",
  "/Users/ledaticempire/projects/rail-https/tools/attest/verify_published.sh",
  "tail -20 /Users/ledaticempire/.fleet/self_healer/heal.log",
  "tail -30 /Users/ledaticempire/.ledatic/drift/audit.log",
  "tail -20 /Users/ledaticempire/.ledatic/attest/daily.log"
]

tool_descs _ = [
  "Pass — observe only this tick.",
  "drift_audit dry-run.",
  "Full drift_audit.",
  "Walk every published binary, verify integrity.",
  "Last 20 lines of heal.log.",
  "Last 30 lines of drift audit history.",
  "Last 20 lines of daily attest log."
]

-- helper: nth element of a list
nth xs i =
  if i <= 0 then head xs
  else nth (tail xs) (i - 1)

-- helper: index of first match in a list, or -1
index_of_in name xs i =
  if xs == [] then 0 - 1
  else if (head xs) == name then i
  else index_of_in name (tail xs) (i + 1)

index_of name = index_of_in name (tool_names 0) 0

-- ── shell helpers ──────────────────────────────────────────────────
trim_nl s =
  let n = length s
  if n == 0 then ""
  else
    let last = str_sub s (n - 1) 1
    if last == "\n" then str_sub s 0 (n - 1)
    else s

now_epoch _ = trim_nl (shell "date -u +%s")
now_iso _ = trim_nl (shell "date -u +%Y-%m-%dT%H:%M:%SZ")

file_exists path =
  trim_nl (shell (cat ["test -f ", path, " && echo yes || echo no"])) == "yes"

ensure_dirs _ =
  let _ = shell (cat ["mkdir -p ", cortex_dir 0])
  let _ = shell (cat ["mkdir -p ", escalation_dir 0])
  0

read_safe path =
  if file_exists path then read_file path else ""

-- ── perception bus ─────────────────────────────────────────────────
heal_tail _ = shell "tail -30 /Users/ledaticempire/.fleet/self_healer/events.jsonl 2>/dev/null"
drift_summary _ = read_safe "/Users/ledaticempire/.ledatic/drift/last_audit.json"
beacon_snapshot _ = shell "curl -fsS --max-time 4 https://ledatic.org/entropy/pulse 2>/dev/null"
fleet_snapshot _ = shell "curl -fsS --max-time 4 https://ledatic.org/fleet/status.json 2>/dev/null"
witness_snapshot _ = shell "curl -fsS --max-time 4 https://ledatic.org/witness/fleet0/latest 2>/dev/null"

goals_text _ =
  let g = read_safe (goals_file 0)
  if g == "" then "(no goals.md)" else g

-- ── lists ──────────────────────────────────────────────────────────
filter_nonempty xs =
  if xs == [] then []
  else
    let h = head xs
    let rest = tail xs
    if h == "" then filter_nonempty rest
    else cons h (filter_nonempty rest)

is_line_for tool_target line =
  let parts = split " " line
  if parts == [] then false
  else (head parts) == tool_target

filter_out_tool tool_target xs =
  if xs == [] then []
  else
    let h = head xs
    let rest = tail xs
    if is_line_for tool_target h then filter_out_tool tool_target rest
    else cons h (filter_out_tool tool_target rest)

state_for_in tool_target xs =
  if xs == [] then (0, 0)
  else
    let line = head xs
    let parts = split " " line
    if length parts < 3 then state_for_in tool_target (tail xs)
    else
      let n = head parts
      if n == tool_target then
        let ts = parse_int (head (tail parts))
        let ct = parse_int (head (tail (tail parts)))
        (ts, ct)
      else state_for_in tool_target (tail xs)

state_for tool_target =
  let raw = read_safe (state_file 0)
  let lines = filter_nonempty (split "\n" raw)
  state_for_in tool_target lines

can_run_idx i =
  let tier = nth (tool_tiers 0) i
  let cd = tier_cooldown_sec tier
  let max_hr = tier_max_per_hour tier
  let st = state_for (nth (tool_names 0) i)
  let last = let (a, b) = st in a
  let count = let (a, b) = st in b
  let now = parse_int (now_epoch 0)
  let elapsed = now - last
  if elapsed < cd then false
  else if count >= max_hr then false
  else true

-- ── prompt builder ─────────────────────────────────────────────────
tool_lines_in i =
  if i >= length (tool_names 0) then ""
  else
    let line = cat ["  - ", nth (tool_names 0) i, " [", tier_label (nth (tool_tiers 0) i), "] ", nth (tool_descs 0) i, "\n"]
    cat [line, tool_lines_in (i + 1)]

tools_block _ = tool_lines_in 0

prompt_header _ =
  "You are the cortex of a self-monitoring software organism. At each 5-minute tick you read what's happening and pick AT MOST ONE action from the whitelist below. Most ticks should be `wait` — only act on clear drift, freshness, or integrity signals.\n\n"

prompt_footer _ =
  "## Output (STRICT — first two lines exactly)\nTOOL: <one of the whitelist names>\nREASON: <one sentence>\n\nIf unsure, choose `wait`."

build_prompt _ =
  let now = now_iso 0
  let beacon = beacon_snapshot 0
  let witness = witness_snapshot 0
  let fleet = fleet_snapshot 0
  let drift = drift_summary 0
  let heal = heal_tail 0
  let goals = goals_text 0
  let part_a = cat [prompt_header 0, "Time: ", now, "\n\n## Goals\n", goals, "\n\n## Beacon\n", beacon]
  let part_b = cat ["\n\n## Witness\n", witness, "\n\n## Fleet\n", fleet, "\n\n## Last drift\n", drift]
  let part_c = cat ["\n\n## Heal events\n", heal, "\n\n## Tools\n", tools_block 0, "\n", prompt_footer 0]
  cat [part_a, part_b, part_c]

-- ── claude call ────────────────────────────────────────────────────
-- The anthropic_client returns body text with JSON-encoded escapes
-- still literal (e.g. `\n` is two chars: backslash + n). Decode them
-- to real characters so downstream line-based parsing works.
decode_json_escapes s =
  let s1 = str_replace (cat [char_from_int 92, "n"]) "\n" s
  let s2 = str_replace (cat [char_from_int 92, char_from_int 34]) (cat [char_from_int 34]) s1
  str_replace (cat [char_from_int 92, char_from_int 92]) (cat [char_from_int 92]) s2

ask_claude prompt =
  let r = anthropic_chat "claude-haiku-4-5-20251001" prompt 200 (anthropic_key 0)
  let status = let (a, b) = r in a
  let text = let (a, b) = r in b
  if status == 200 then decode_json_escapes text
  else cat ["(claude error status=", show status, ")"]

-- ── parse response ─────────────────────────────────────────────────
extract_after marker text =
  let i = str_find marker text
  if i < 0 then ""
  else
    let st = i + length marker
    let rest = str_sub text st (length text - st)
    let nl = str_find "\n" rest
    if nl < 0 then trim_nl rest
    else trim_nl (str_sub rest 0 nl)

trim_lead s =
  if length s == 0 then s
  else
    let first = str_sub s 0 1
    if first == " " then trim_lead (str_sub s 1 (length s - 1))
    else s

parse_choice text =
  let raw_tool = extract_after "TOOL:" text
  let raw_reason = extract_after "REASON:" text
  (trim_lead raw_tool, trim_lead raw_reason)

-- ── dispatch ───────────────────────────────────────────────────────
execute_idx i =
  let cmd = nth (tool_cmds 0) i
  if cmd == "" then "(noop — wait)"
  else shell (cat [cmd, " 2>&1 | head -40"])

-- ── audit (build via shell printf — keeps Rail-side cat short) ─────
sq_esc s = str_replace "'" "'\\''" s

truncate s n =
  if length s <= n then s
  else cat [str_sub s 0 n, "..."]

write_audit ts choice reason verdict result =
  let result_short = truncate result 800
  let cmd = cat ["printf '{\"ts\":\"%s\",\"tool\":\"%s\",\"reason\":\"%s\",\"verdict\":\"%s\",\"result\":\"%s\"}\\n' '",
                 sq_esc ts, "' '", sq_esc choice, "' '", sq_esc reason, "' '", sq_esc verdict, "' '", sq_esc result_short, "' >> ",
                 audit_log 0]
  shell cmd

-- ── state update ───────────────────────────────────────────────────
join_lines xs =
  if xs == [] then ""
  else
    let h = head xs
    let rest = tail xs
    if rest == [] then h
    else cat [h, "\n", join_lines rest]

bump_state tool_target =
  let raw = read_safe (state_file 0)
  let lines = filter_nonempty (split "\n" raw)
  let kept = filter_out_tool tool_target lines
  let st = state_for tool_target
  let count = let (a, b) = st in b
  let now = now_epoch 0
  let new_line = cat [tool_target, " ", now, " ", show (count + 1)]
  let kept_body = join_lines kept
  let body = if kept_body == "" then new_line else cat [kept_body, "\n", new_line]
  write_file (state_file 0) (cat [body, "\n"])

-- ── slack via curl ─────────────────────────────────────────────────
-- (We can't import slack_client.rail alongside anthropic_client.rail
-- without hanging the compile — see import comment up top.)
slack_announce text =
  let payload_cmd = cat ["jq -nc --arg ch '", slack_channel 0, "' --arg t '", sq_esc text, "' '{channel: $ch, text: $t, mrkdwn: true}'"]
  let payload = trim_nl (shell payload_cmd)
  let curl_cmd = cat ["curl -s --max-time 8 -X POST 'https://slack.com/api/chat.postMessage' -H 'Authorization: Bearer '\"$(cat ", slack_token 0, ")\" -H 'Content-Type: application/json; charset=utf-8' -d '", sq_esc payload, "' | grep -q '\"ok\":true' && echo ok || echo fail"]
  trim_nl (shell curl_cmd)

-- ── tick ───────────────────────────────────────────────────────────
dispatch_idx i ts choice reason =
  if can_run_idx i then
    let _ = print (cat ["cortex: dispatching ", nth (tool_names 0) i])
    let result = execute_idx i
    let _ = bump_state (nth (tool_names 0) i)
    let _ = write_audit ts choice reason "executed" result
    if (nth (tool_names 0) i) == "wait" then 0
    else
      let msg = cat ["*🧠 cortex tick* — `", nth (tool_names 0) i, "`\n*reason:* ", reason, "\n```\n", truncate result 1200, "\n```"]
      let _ = print (slack_announce msg)
      0
  else
    let _ = write_audit ts choice reason "cooldown" ""
    let _ = print (cat ["cortex: ", nth (tool_names 0) i, " on cooldown — skip"])
    0

tick _ =
  let _ = ensure_dirs 0
  if file_exists (kill_switch 0) then
    let _ = print "cortex: kill switch active — exit"
    0
  else
    let _ = print "cortex: building perception"
    let prompt = build_prompt 0
    let _ = print "cortex: calling claude"
    let response = ask_claude prompt
    let parsed = parse_choice response
    let choice = let (a, b) = parsed in a
    let reason = let (a, b) = parsed in b
    let _ = print (cat ["cortex: choice=", choice, " reason=", reason])
    let ts = now_iso 0
    let idx = index_of choice
    if idx < 0 then
      let _ = write_audit ts choice reason "unknown_tool" ""
      let _ = print "cortex: unknown tool — recorded"
      0
    else dispatch_idx idx ts choice reason

main = tick 0
