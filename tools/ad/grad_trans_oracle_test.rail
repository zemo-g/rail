-- tools/ad/grad_trans_oracle_test.rail -- P3 C2: transcendental differential oracle for #grad.
--
-- C1 proved multi-input arithmetic gradients against three witnesses. C2 extends the desugar
-- to the unary transcendental set (sin/cos/exp/tanh/sqrt/log) via the chain rule. This harness
-- exercises three transcendental forward functions and checks d/dx at several points against
-- three INDEPENDENT witnesses:
--   (1) synthesized -- the compiler's #grad desugar emits f__grad over the real Rail AST
--   (2) symbolic    -- diff.rail differentiates an independent Expr encoding of the same f
--   (3) numeric     -- central finite-difference on the Expr (a totally different method)
-- (1) and (2) are bit-identical (same chain-rule shapes, same operand order); both match (3)
-- within tolerance. A mismatch on any point is a miscompiled gradient.
--
-- Run from the repo root: ./rail_native run tools/ad/grad_trans_oracle_test.rail

import "tools/ad/diff.rail"

#grad ft
ft x = tanh x

#grad ge
ge x = exp (x *. x)

#grad gsq
gsq x = sqrt x

-- check one point: synth (syn) vs symbolic (eval of g at xs[xi]) vs numeric (num_grad).
-- Floats flow only through float_arr_get / eval / num_grad; the sole float-scalar param is
-- syn (the proven-safe idiom from grad_oracle_test). x is read from the xs array by index.
-- NB: typecheck warns "comparison < on int and float" below -- sym/num are float returns the
-- inference pass conservatively tags int. Benign: codegen emits fcmp; results are correct.
check label fexpr g inputs consts xs xi syn =
  let x = float_arr_get xs xi
  let _ = float_arr_set inputs 0 x
  let sym = eval g inputs consts
  let num = num_grad fexpr inputs consts 0
  let dssr = sym - syn
  let dss = if dssr < 0.0 then 0.0 - dssr else dssr
  let dsnr = sym - num
  let dsn = if dsnr < 0.0 then 0.0 - dsnr else dsnr
  let ok = if dss == 0.0 then (if dsn < 0.001 then 1 else 0) else 0
  let _ = print (cat ["  ", label, " @", show_float x, "   synth=", show_float syn, "   symbolic=", show_float sym, "   numeric=", show_float num, "   ", (if ok == 1 then "AGREE" else "DIVERGE")])
  ok

main =
  let _ = print "=== P3 C2: transcendental three-witness oracle (#grad vs diff.rail vs numeric) ==="
  let consts = float_arr_new 2 0.0
  let _ = float_arr_set consts 0 0.0
  let _ = float_arr_set consts 1 1.0
  let inputs = float_arr_new 1 0.0
  -- f(x) = tanh x          f'(x) = 1 - tanh(x)^2
  let e_tanh = Tanh (Var 0)
  let g_tanh = diff e_tanh 0
  -- f(x) = exp(x*x)        f'(x) = exp(x*x) * 2x
  let e_exp = Exp (Mul (Var 0) (Var 0))
  let g_exp = diff e_exp 0
  -- f(x) = sqrt x          f'(x) = 1 / (2 sqrt x)
  let e_sqrt = Sqrt (Var 0)
  let g_sqrt = diff e_sqrt 0
  let _ = print (cat ["  d/dx tanh(x)  = ", show_expr g_tanh])
  let _ = print (cat ["  d/dx exp(x*x) = ", show_expr g_exp])
  let _ = print (cat ["  d/dx sqrt(x)  = ", show_expr g_sqrt])
  -- nine test points (flat): tanh @ {0, 0.5, -1}, exp @ {0, 1, -0.5}, sqrt @ {4, 1, 0.25}.
  let xs = float_arr_new 9 0.0
  let _ = float_arr_set xs 0 0.0
  let _ = float_arr_set xs 1 0.5
  let _ = float_arr_set xs 2 (0.0 -. 1.0)
  let _ = float_arr_set xs 3 0.0
  let _ = float_arr_set xs 4 1.0
  let _ = float_arr_set xs 5 (0.0 -. 0.5)
  let _ = float_arr_set xs 6 4.0
  let _ = float_arr_set xs 7 1.0
  let _ = float_arr_set xs 8 0.25
  -- synthesized partials from the COMPILER-EMITTED f__grad (selector 0 = sole input):
  let syn = float_arr_new 9 0.0
  let _ = float_arr_set syn 0 (ft__grad 0.0 0)
  let _ = float_arr_set syn 1 (ft__grad 0.5 0)
  let _ = float_arr_set syn 2 (ft__grad (0.0 -. 1.0) 0)
  let _ = float_arr_set syn 3 (ge__grad 0.0 0)
  let _ = float_arr_set syn 4 (ge__grad 1.0 0)
  let _ = float_arr_set syn 5 (ge__grad (0.0 -. 0.5) 0)
  let _ = float_arr_set syn 6 (gsq__grad 4.0 0)
  let _ = float_arr_set syn 7 (gsq__grad 1.0 0)
  let _ = float_arr_set syn 8 (gsq__grad 0.25 0)
  let _ = print "tanh:"
  let a0 = check "tanh'" e_tanh g_tanh inputs consts xs 0 (float_arr_get syn 0)
  let a1 = check "tanh'" e_tanh g_tanh inputs consts xs 1 (float_arr_get syn 1)
  let a2 = check "tanh'" e_tanh g_tanh inputs consts xs 2 (float_arr_get syn 2)
  let _ = print "exp(x*x):"
  let b0 = check "exp'" e_exp g_exp inputs consts xs 3 (float_arr_get syn 3)
  let b1 = check "exp'" e_exp g_exp inputs consts xs 4 (float_arr_get syn 4)
  let b2 = check "exp'" e_exp g_exp inputs consts xs 5 (float_arr_get syn 5)
  let _ = print "sqrt:"
  let c0 = check "sqrt'" e_sqrt g_sqrt inputs consts xs 6 (float_arr_get syn 6)
  let c1 = check "sqrt'" e_sqrt g_sqrt inputs consts xs 7 (float_arr_get syn 7)
  let c2 = check "sqrt'" e_sqrt g_sqrt inputs consts xs 8 (float_arr_get syn 8)
  let total = a0 + a1 + a2 + b0 + b1 + b2 + c0 + c1 + c2
  let _ = print (cat ["RESULT: ", show total, "/9 points agree across all three witnesses"])
  if total == 9 then 0 else 1
