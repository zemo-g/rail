-- V5 slice 4 differential oracle: reverse-mode AD for the matvec-layer LET-form
--   f W x = let z = float_mat_vec W x in float_arr_sum (float_arr_map act z)
-- a dense layer (flat row-major W, out*n) + elementwise nonlinearity act (#grad
-- unary) + sum readout. The synthesized f__rgrad W x __gy __wrt returns:
--   __wrt=0 -> dL/dW = outer(ct_z, x)  (length out*n)
--   __wrt=1 -> dL/dx = W^T . ct_z       (length n)   where ct_z_j = act'(z_j)*__gy
--
-- Each component is cross-checked TWO ways:
--   1. hand-derived analytic gradient (closed form, no primal call)
--   2. central finite differences on the actual forward primal f
-- This is the gate the V5-s4 commit message claims but never committed in-tree.
-- Run: ./rail_native run tools/ad/grad_rev_matvec_oracle_test.rail

import "stdlib/float_arr.rail"

#grad sq
sq z = z *. z

#grad f
f W x =
  let z = float_mat_vec W x
  float_arr_sum (float_arr_map sq z)

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. 0.01 then 1 else 0

-- central finite difference of f w.r.t. W[idx]
fd_w W x idx =
  let h = 0.0001
  let orig = float_arr_get W idx
  let _ = float_arr_set W idx (orig +. h)
  let fp = f W x
  let _ = float_arr_set W idx (orig -. h)
  let fm = f W x
  let _ = float_arr_set W idx orig
  (fp -. fm) /. (2.0 *. h)

-- central finite difference of f w.r.t. x[idx]
fd_x W x idx =
  let h = 0.0001
  let orig = float_arr_get x idx
  let _ = float_arr_set x idx (orig +. h)
  let fp = f W x
  let _ = float_arr_set x idx (orig -. h)
  let fm = f W x
  let _ = float_arr_set x idx orig
  (fp -. fm) /. (2.0 *. h)

mkW =
  let W = float_arr_new 6 0.0
  let _ = float_arr_set W 0 1.0
  let _ = float_arr_set W 1 2.0
  let _ = float_arr_set W 2 3.0
  let _ = float_arr_set W 3 4.0
  let _ = float_arr_set W 4 5.0
  let _ = float_arr_set W 5 6.0
  W

mkX =
  let x = float_arr_new 3 0.0
  let _ = float_arr_set x 0 0.5
  let _ = float_arr_set x 1 (0.0 -. 1.0)
  let _ = float_arr_set x 2 2.0
  x

main =
  let _ = print "=== P3 V5-s4: reverse-mode matvec-layer oracle (f__rgrad vs analytic vs finite-diff) ==="
  -- W = [[1,2,3],[4,5,6]] (out=2,n=3), x = [0.5,-1,2]
  -- z = [4.5, 9.0]; L = sum(z^2) = 20.25 + 81 = 101.25
  -- ct_z = 2z = [9, 18]
  -- dL/dW = outer(ctz,x) = [4.5,-9,18, 9,-18,36]
  -- dL/dx = W^T ctz = [1*9+4*18, 2*9+5*18, 3*9+6*18] = [81,108,135]
  let W = mkW
  let x = mkX
  -- reverse-mode dL/dW (__gy=1.0, __wrt=0)
  let gW = f__rgrad W x 1.0 0
  let dw0 = float_arr_get gW 0
  let dw1 = float_arr_get gW 1
  let dw2 = float_arr_get gW 2
  let dw3 = float_arr_get gW 3
  let dw4 = float_arr_get gW 4
  let dw5 = float_arr_get gW 5
  -- analytic dW
  let a0 = fnear dw0 4.5
  let a1 = fnear dw1 (0.0 -. 9.0)
  let a2 = fnear dw2 18.0
  let a3 = fnear dw3 9.0
  let a4 = fnear dw4 (0.0 -. 18.0)
  let a5 = fnear dw5 36.0
  -- finite-diff dW
  let b0 = fnear dw0 (fd_w W x 0)
  let b1 = fnear dw1 (fd_w W x 1)
  let b2 = fnear dw2 (fd_w W x 2)
  let b3 = fnear dw3 (fd_w W x 3)
  let b4 = fnear dw4 (fd_w W x 4)
  let b5 = fnear dw5 (fd_w W x 5)
  -- reverse-mode dL/dx (__gy=1.0, __wrt=1)
  let gX = f__rgrad W x 1.0 1
  let dx0 = float_arr_get gX 0
  let dx1 = float_arr_get gX 1
  let dx2 = float_arr_get gX 2
  -- analytic dx
  let c0 = fnear dx0 81.0
  let c1 = fnear dx1 108.0
  let c2 = fnear dx2 135.0
  -- finite-diff dx
  let d0 = fnear dx0 (fd_x W x 0)
  let d1 = fnear dx1 (fd_x W x 1)
  let d2 = fnear dx2 (fd_x W x 2)
  let total = a0+a1+a2+a3+a4+a5 + b0+b1+b2+b3+b4+b5 + c0+c1+c2 + d0+d1+d2
  let _ = print (cat [show total, "/18 matvec-layer reverse-mode checks passed"])
  if total == 18 then 0 else 1
