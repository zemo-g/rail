-- C5.1 reverse-mode-through-control-flow differential oracle. C5.0 taught forward-mode
-- to differentiate if-expressions piecewise; C5.1 does the same for the reverse sweep.
-- Reverse-mode previously punted the "?" AST node -- grad_rev_flat returned false for any
-- if-body, so NO f__rgrad was synthesized at all (relu__rgrad was an undefined symbol).
-- C5.1: grad_rev_push guards the cotangent by the primal predicate and pushes it into each
-- branch -- ct reaches the THEN branch only when c holds, the ELSE branch only when it does
-- not. So d(if c then a else b)/dp = [c] da/dp + [not c] db/dp, the reverse mirror of the
-- forward "?" rule, and the existing pushback machinery distributes the guarded cotangent.
--
-- Each reverse gradient component is cross-checked against TWO independent witnesses:
--   1. forward-mode f__grad .. i  (the C5.0 differentiator -- a DIFFERENT code path, itself
--      already cross-checked vs analytic AND numeric central-difference in grad_if_oracle_test)
--   2. a hand-derived closed-form analytic gradient (the step / sign / slope)
-- The forward/reverse cross-check is the load-bearing invariant: f__rgrad[i] == f__grad..i.
-- 28 checks total. Run from the repo root:
--   ./rail_native run tools/ad/grad_rev_if_oracle_test.rail

-- relu x = max(x,0):  d/dx = if x>0 then 1 else 0  (the step function)
#grad relu
relu x = if x >. 0.0 then x else 0.0

-- absf x = |x|:  d/dx = if x>0 then 1 else -1  (the sign function)
#grad absf
absf x = if x >. 0.0 then x else (0.0 -. x)

-- pw x = if x>1 then x^2 else x:  d/dx = if x>1 then 2x else 1  (slope changes branch)
#grad pw
pw x = if x >. 1.0 then x *. x else x

-- g a b = if a>b then a^2 else b^2:  da = if a>b then 2a else 0,  db = if a>b then 0 else 2b
-- multi-input flat-if: the reverse sweep must guard EACH param's adjoint by the same predicate.
#grad g
g a b = if a >. b then a *. a else b *. b

-- lif x = let t=2x in if t>1 then t else x:  lif' = if 2x>1 then 2 else 1  (if AFTER a let --
-- the guarded cotangent is pushed through the if, then back through the binding t=x+x).
#grad lif
lif x =
  let t = x +. x
  if t >. 1.0 then t else x

-- gl a b = let s=a+b in if s>0 then a^2 else b^2:  da = if s>0 then 2a else 0,
-- db = if s>0 then 0 else 2b.  The capstone: multi-input AND let-spine AND if, with the
-- predicate keyed off a let-bound intermediate (s must be in scope inside the guards).
#grad gl
gl a b =
  let s = a +. b
  if s >. 0.0 then a *. a else b *. b

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. 0.001 then 1 else 0

main =
  let _ = print "=== P3 C5.1: reverse-mode-through-control-flow oracle (f__rgrad vs forward-mode vs analytic) ==="
  let sd = float_arr_new 1 0.0
  -- relu at 2.0 (active branch x): grad = 1.0
  let gr = float_arr_new 1 0.0
  let _ = relu__rgrad 2.0 gr
  let r2 = float_arr_get gr 0
  let _ = float_arr_set sd 0 (relu__grad 2.0 0)
  let c1 = fnear r2 (float_arr_get sd 0)
  let c2 = fnear r2 1.0
  -- relu at -1.0 (active branch 0.0): grad = 0.0
  let _ = relu__rgrad (0.0 -. 1.0) gr
  let rm1 = float_arr_get gr 0
  let _ = float_arr_set sd 0 (relu__grad (0.0 -. 1.0) 0)
  let c3 = fnear rm1 (float_arr_get sd 0)
  let c4 = fnear rm1 0.0
  -- absf at 3.0 (active branch x): grad = 1.0
  let ga = float_arr_new 1 0.0
  let _ = absf__rgrad 3.0 ga
  let a3 = float_arr_get ga 0
  let _ = float_arr_set sd 0 (absf__grad 3.0 0)
  let c5 = fnear a3 (float_arr_get sd 0)
  let c6 = fnear a3 1.0
  -- absf at -2.0 (active branch -x): grad = -1.0  (the sign flip)
  let _ = absf__rgrad (0.0 -. 2.0) ga
  let am2 = float_arr_get ga 0
  let _ = float_arr_set sd 0 (absf__grad (0.0 -. 2.0) 0)
  let c7 = fnear am2 (float_arr_get sd 0)
  let c8 = fnear am2 (0.0 -. 1.0)
  -- pw at 3.0 (active branch x^2): grad = 2x = 6.0
  let gp = float_arr_new 1 0.0
  let _ = pw__rgrad 3.0 gp
  let p3 = float_arr_get gp 0
  let _ = float_arr_set sd 0 (pw__grad 3.0 0)
  let c9 = fnear p3 (float_arr_get sd 0)
  let c10 = fnear p3 6.0
  -- pw at 0.5 (active branch x): grad = 1.0
  let _ = pw__rgrad 0.5 gp
  let p05 = float_arr_get gp 0
  let _ = float_arr_set sd 0 (pw__grad 0.5 0)
  let c11 = fnear p05 (float_arr_get sd 0)
  let c12 = fnear p05 1.0
  -- g at (3,2) (active branch a^2): da = 2a = 6.0, db = 0.0  (multi-input, ONE rgrad call)
  let gg = float_arr_new 2 0.0
  let _ = g__rgrad 3.0 2.0 gg
  let gda = float_arr_get gg 0
  let gdb = float_arr_get gg 1
  let _ = float_arr_set sd 0 (g__grad 3.0 2.0 0)
  let c13 = fnear gda (float_arr_get sd 0)
  let c14 = fnear gda 6.0
  let _ = float_arr_set sd 0 (g__grad 3.0 2.0 1)
  let c15 = fnear gdb (float_arr_get sd 0)
  let c16 = fnear gdb 0.0
  -- g at (1,4) (active branch b^2): da = 0.0, db = 2b = 8.0
  let _ = g__rgrad 1.0 4.0 gg
  let gda2 = float_arr_get gg 0
  let gdb2 = float_arr_get gg 1
  let _ = float_arr_set sd 0 (g__grad 1.0 4.0 0)
  let c17 = fnear gda2 (float_arr_get sd 0)
  let c18 = fnear gda2 0.0
  let _ = float_arr_set sd 0 (g__grad 1.0 4.0 1)
  let c19 = fnear gdb2 (float_arr_get sd 0)
  let c20 = fnear gdb2 8.0
  -- lif at 2.0 (t=4>1, active branch t): grad = d(2x) = 2.0  (if after a let)
  let gl2 = float_arr_new 1 0.0
  let _ = lif__rgrad 2.0 gl2
  let l2 = float_arr_get gl2 0
  let _ = float_arr_set sd 0 (lif__grad 2.0 0)
  let c21 = fnear l2 (float_arr_get sd 0)
  let c22 = fnear l2 2.0
  -- lif at 0.2 (t=0.4<1, active branch x): grad = 1.0
  let _ = lif__rgrad 0.2 gl2
  let l02 = float_arr_get gl2 0
  let _ = float_arr_set sd 0 (lif__grad 0.2 0)
  let c23 = fnear l02 (float_arr_get sd 0)
  let c24 = fnear l02 1.0
  -- gl at (3,2) (s=5>0, active branch a^2): da = 2a = 6.0, db = 0.0  (multi-input let+if)
  let ggl = float_arr_new 2 0.0
  let _ = gl__rgrad 3.0 2.0 ggl
  let glda = float_arr_get ggl 0
  let gldb = float_arr_get ggl 1
  let _ = float_arr_set sd 0 (gl__grad 3.0 2.0 0)
  let c25 = fnear glda (float_arr_get sd 0)
  let c26 = fnear glda 6.0
  let c27 = fnear gldb 0.0
  -- gl at (-3,1) (s=-2<0, active branch b^2): da = 0.0, db = 2b = 2.0  (predicate keyed off s)
  let _ = gl__rgrad (0.0 -. 3.0) 1.0 ggl
  let gldb2 = float_arr_get ggl 1
  let _ = float_arr_set sd 0 (gl__grad (0.0 -. 3.0) 1.0 1)
  let c28 = fnear gldb2 (float_arr_get sd 0)
  let total = c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19 + c20 + c21 + c22 + c23 + c24 + c25 + c26 + c27 + c28
  let _ = print (cat [show total, "/28 reverse-control-flow-oracle checks passed"])
  if total == 28 then 0 else 1
