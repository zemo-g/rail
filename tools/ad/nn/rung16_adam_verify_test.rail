-- Rung 16 gate oracle: Adam AND AdamW parameter update, verified by EQUIVALENCE.
-- Two independent code paths must agree (fnear, tol 0.005 abs + 0.01 rel):
--   PATH A: vectorized float_arr Adam/AdamW state machine (m,v per-param arrays),
--           stepped 3 times over a tiny param vector with a fixed gradient seq.
--   PATH B: an independent SCALAR reference that recomputes one chosen element's
--           final weight by threading m,v,w through function PARAMETERS only
--           (recursive accumulators are codegen-safe; let-floats across calls are
--           NOT -- callee-saved-float-reg bug). Path B mirrors the math by hand.
-- Hyperparameters: b1=0.9, b2=0.999, eps=1e-8, lr=0.01, wd=0.01.
-- Run: /tmp/rail_atoms --out-prefix /tmp/r16 run tools/ad/nn/rung16_adam_verify_test.rail
--
-- NOTE on stdlib/optim.rail: NOT imported. optim.rail requires stdlib/tensor.rail
-- (Tensor ADT + tgl_adam_update_f64 + gpu_available GPU foreign symbols) which do
-- not link standalone under /tmp/rail_atoms. The standalone equivalence (Path A vs
-- the by-hand scalar Path B) is the deliverable, per the brief.

import "stdlib/float_arr.rail"

foreign sqrt x -> float
foreign pow x y -> float

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. (0.005 +. (0.01 *. (fabs1 b))) then 1 else 0

-- ---------- PATH A: vectorized Adam over float_arr state ----------
-- m = b1*m + (1-b1)*g ; v = b2*v + (1-b2)*g*g
-- mhat = m/(1-b1^t) ; vhat = v/(1-b2^t)
-- w := w - lr*mhat/(sqrt(vhat)+eps)
-- (AdamW: first w := w - lr*wd*w on every element, then the Adam step.)
adam_vec_loop w g m v lr b1 b2 eps bc1 bc2 n i =
  if i >= n then 0
  else
    let gi = float_arr_get g i
    let mi = (b1 *. (float_arr_get m i)) +. ((1.0 -. b1) *. gi)
    let vi = (b2 *. (float_arr_get v i)) +. ((1.0 -. b2) *. (gi *. gi))
    let _ = float_arr_set m i mi
    let _ = float_arr_set v i vi
    let mhat = mi /. bc1
    let vhat = vi /. bc2
    let wi = float_arr_get w i
    let _ = float_arr_set w i (wi -. ((lr *. mhat) /. ((sqrt vhat) +. eps)))
    adam_vec_loop w g m v lr b1 b2 eps bc1 bc2 n (i + 1)

decay_vec_loop w lr_wd n i =
  if i >= n then 0
  else
    let wi = float_arr_get w i
    let _ = float_arr_set w i (wi -. (lr_wd *. wi))
    decay_vec_loop w lr_wd n (i + 1)

-- One Adam step at 1-based t. with_decay=1 -> AdamW (decoupled wd first).
adam_vec_step w g m v lr b1 b2 eps wd t n with_decay =
  let t_f = int_to_float t
  let bc1 = 1.0 -. (pow b1 t_f)
  let bc2 = 1.0 -. (pow b2 t_f)
  let _ = if with_decay == 1 then decay_vec_loop w (lr *. wd) n 0 else 0
  adam_vec_loop w g m v lr b1 b2 eps bc1 bc2 n 0

-- g[i] at step t (1..3): a fixed, distinct-per-element gradient sequence.
-- column = element, row = step. Encoded inline (no float-let-across-call risk:
-- every return is a literal expression).
gseq i t =
  if i == 0 then (if t == 1 then 0.10 else (if t == 2 then 0.20 else 0.30))
  else if i == 1 then (if t == 1 then (0.0 -. 0.30) else (if t == 2 then 0.05 else (0.0 -. 0.15)))
  else if i == 2 then (if t == 1 then 0.50 else (if t == 2 then (0.0 -. 0.10) else 0.25))
  else (if t == 1 then 0.02 else (if t == 2 then 0.40 else (0.0 -. 0.20)))

fill_g g n t i =
  if i >= n then g
  else
    let _ = float_arr_set g i (gseq i t)
    fill_g g n t (i + 1)

-- run the 3-step vec optimizer; returns the mutated w array.
run_vec w m v lr b1 b2 eps wd n with_decay t =
  if t > 3 then w
  else
    let g = float_arr_new n 0.0
    let _ = fill_g g n t 0
    let _ = adam_vec_step w g m v lr b1 b2 eps wd t n with_decay
    run_vec w m v lr b1 b2 eps wd n with_decay (t + 1)

-- ---------- PATH B: independent SCALAR reference for one element idx ----------
-- Threads w,m,v through function PARAMETERS across the recursion (safe). At each
-- step it pulls the same gradient gseq idx t, applies AdamW decay if requested,
-- runs the Adam math, and recurses with the updated scalars. Returns final w.
scalar_ref idx w m v lr b1 b2 eps wd with_decay t =
  if t > 3 then w
  else
    let wd0 = if with_decay == 1 then (w -. ((lr *. wd) *. w)) else w
    let gi = gseq idx t
    let mi = (b1 *. m) +. ((1.0 -. b1) *. gi)
    let vi = (b2 *. v) +. ((1.0 -. b2) *. (gi *. gi))
    let t_f = int_to_float t
    let bc1 = 1.0 -. (pow b1 t_f)
    let bc2 = 1.0 -. (pow b2 t_f)
    let mhat = mi /. bc1
    let vhat = vi /. bc2
    let w1 = wd0 -. ((lr *. mhat) /. ((sqrt vhat) +. eps))
    scalar_ref idx w1 mi vi lr b1 b2 eps wd with_decay (t + 1)

-- initial weights, distinct per element.
w0 i =
  if i == 0 then 1.00
  else if i == 1 then (0.0 -. 0.50)
  else if i == 2 then 0.30
  else 0.70

fill_w w n i =
  if i >= n then w
  else
    let _ = float_arr_set w i (w0 i)
    fill_w w n (i + 1)

-- compare every element of a finished vec run against scalar_ref.
chk_elems w n lr b1 b2 eps wd with_decay i acc =
  if i >= n then acc
  else
    let va = float_arr_get w i
    let vb = scalar_ref i (w0 i) 0.0 0.0 lr b1 b2 eps wd with_decay 1
    chk_elems w n lr b1 b2 eps wd with_decay (i + 1) (acc + (fnear va vb))

-- run a full vec optimizer for the given decay flag and check all elements.
run_and_check lr b1 b2 eps wd n with_decay =
  let w = float_arr_new n 0.0
  let _ = fill_w w n 0
  let m = float_arr_new n 0.0
  let v = float_arr_new n 0.0
  let _ = run_vec w m v lr b1 b2 eps wd n with_decay 1
  chk_elems w n lr b1 b2 eps wd with_decay 0 0

main =
  let _ = print "=== Rung 16 GATE: Adam + AdamW update (vec state machine vs by-hand scalar ref, 3 steps) ==="
  let n = 4
  let lr = 0.01
  let b1 = 0.9
  let b2 = 0.999
  let eps = 0.00000001
  let wd = 0.01
  let cAdam = run_and_check lr b1 b2 eps wd n 0
  let cAdamW = run_and_check lr b1 b2 eps wd n 1
  let total = cAdam + cAdamW
  let _ = print (cat [show cAdam, "/4 Adam  ", show cAdamW, "/4 AdamW"])
  let _ = print (cat [show total, "/8 optimizer update checks passed"])
  if total == 8 then 0 else 1
