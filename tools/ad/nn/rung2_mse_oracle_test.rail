-- Rung 2 gate oracle: mean-squared-error loss + its gradient, cross-checked
-- against central finite differences. Standalone float_arr, no Tensor ADT.
--   L = (1/N) * sum_i (y_i - t_i)^2
--   grad wrt y_i = 2*(y_i - t_i)/N
-- The loss is itself the scalar readout, so there is no upstream Up here.
-- FD perturbs y. Mirrors the rung5 matmul template convention exactly.
-- Run: /tmp/rail_atoms --out-prefix /tmp/rung2 run tools/ad/nn/rung2_mse_oracle_test.rail

import "stdlib/float_arr.rail"

-- forward: sum of squared residuals, threaded via a float accumulator arg.
mse_acc y t n i acc =
  if i >= n then acc
  else
    let d = (float_arr_get y i) -. (float_arr_get t i)
    mse_acc y t n (i + 1) (acc +. (d *. d))

-- L = (1/N) * sum (y-t)^2.  N passed as float via int->float promotion.
mse_loss y t n =
  let s = mse_acc y t n 0 0.0
  s /. (int_to_float n)

-- analytic grad: g_i = 2*(y_i - t_i)/N
mse_grad_fill y t n g idx =
  if idx >= n then g
  else
    let d = (float_arr_get y idx) -. (float_arr_get t idx)
    let v = (2.0 *. d) /. (int_to_float n)
    let _ = float_arr_set g idx v
    mse_grad_fill y t n g (idx + 1)

mse_grad y t n =
  let g = float_arr_new n 0.0
  mse_grad_fill y t n g 0

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. (0.005 +. (0.01 *. (fabs1 b))) then 1 else 0

fd_y y t n idx =
  let h = 0.0001
  let orig = float_arr_get y idx
  let _ = float_arr_set y idx (orig +. h)
  let fp = mse_loss y t n
  let _ = float_arr_set y idx (orig -. h)
  let fm = mse_loss y t n
  let _ = float_arr_set y idx orig
  (fp -. fm) /. (2.0 *. h)

chk g y t n cnt idx acc =
  if idx >= cnt then acc
  else
    let gi = float_arr_get g idx
    let fi = fd_y y t n idx
    chk g y t n cnt (idx + 1) (acc + (fnear gi fi))

mkY =
  let y = float_arr_new 5 0.0
  let _ = float_arr_set y 0 0.5
  let _ = float_arr_set y 1 (0.0 -. 0.3)
  let _ = float_arr_set y 2 1.2
  let _ = float_arr_set y 3 (0.0 -. 0.8)
  let _ = float_arr_set y 4 0.1
  y

mkT =
  let t = float_arr_new 5 0.0
  let _ = float_arr_set t 0 0.2
  let _ = float_arr_set t 1 0.1
  let _ = float_arr_set t 2 0.9
  let _ = float_arr_set t 3 (0.0 -. 0.4)
  let _ = float_arr_set t 4 (0.0 -. 0.2)
  t

main =
  let _ = print "=== Rung 2 GATE: MSE loss + grad (vs finite-diff, N=5) ==="
  let y = mkY
  let t = mkT
  let g = mse_grad y t 5
  let c = chk g y t 5 5 0 0
  let _ = print (cat [show c, "/5 MSE grad checks passed"])
  if c == 5 then 0 else 1
