-- Rung 6 GATE: SYNTHESIZED residual-block whole-net reverse-mode AD with FAN-OUT.
-- A #grad net whose body fans x out into a skip AND a sublayer --
--   net W x g = let z = float_mat_vec W x in let s = float_arr_map sq z in
--               let r = float_arr_map2 add2 x s in float_dot r g
-- makes compile.rail synthesize  net__rgrad W x g __gy __wrt  that SUMS the two cotangents
-- arriving at x (the skip cotangent cty PLUS the sublayer input cotangent W^T.ctz). This is
-- the structurally new reverse piece vs the strict layer-chain: a binding consumed twice.
-- __wrt=0 -> dL/dW, 1 -> dL/dx. g is the fixed upstream cotangent (never differentiated).
-- Every synthesized component is cross-checked vs central finite differences of the primal --
-- the load-bearing falsification of the fan-out synthesis. RED until rung-6 synth lands.
-- Run: ./rail_native run tools/ad/nn/rung6_residual_oracle_test.rail

import "stdlib/float_arr.rail"

#grad sq
sq z = z *. z

add2 a b = a +. b

#grad net
net W x g =
  let z = float_mat_vec W x
  let s = float_arr_map sq z
  let r = float_arr_map2 add2 x s
  float_dot r g

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. (0.005 +. (0.01 *. (fabs1 b))) then 1 else 0

fd_w W x g idx =
  let h = 0.0001
  let orig = float_arr_get W idx
  let _ = float_arr_set W idx (orig +. h)
  let fp = net W x g
  let _ = float_arr_set W idx (orig -. h)
  let fm = net W x g
  let _ = float_arr_set W idx orig
  (fp -. fm) /. (2.0 *. h)

fd_x W x g idx =
  let h = 0.0001
  let orig = float_arr_get x idx
  let _ = float_arr_set x idx (orig +. h)
  let fp = net W x g
  let _ = float_arr_set x idx (orig -. h)
  let fm = net W x g
  let _ = float_arr_set x idx orig
  (fp -. fm) /. (2.0 *. h)

chk_arr gr fd W x g n i acc =
  if i >= n then acc
  else
    let gi = float_arr_get gr i
    let fi = fd W x g i
    chk_arr gr fd W x g n (i + 1) (acc + (fnear gi fi))

mkW =
  let W = float_arr_new 9 0.0
  let _ = float_arr_set W 0 0.5
  let _ = float_arr_set W 1 0.2
  let _ = float_arr_set W 2 (0.0 -. 0.1)
  let _ = float_arr_set W 3 0.4
  let _ = float_arr_set W 4 0.3
  let _ = float_arr_set W 5 (0.0 -. 0.2)
  let _ = float_arr_set W 6 (0.0 -. 0.15)
  let _ = float_arr_set W 7 0.25
  let _ = float_arr_set W 8 0.1
  W

mkX =
  let x = float_arr_new 3 0.0
  let _ = float_arr_set x 0 0.5
  let _ = float_arr_set x 1 (0.0 -. 0.3)
  let _ = float_arr_set x 2 0.2
  x

mkG =
  let g = float_arr_new 3 0.0
  let _ = float_arr_set g 0 0.7
  let _ = float_arr_set g 1 (0.0 -. 0.4)
  let _ = float_arr_set g 2 0.5
  g

main =
  let _ = print "=== Rung 6 GATE: synthesized residual fan-out net__rgrad (vs finite-diff) ==="
  let W = mkW
  let x = mkX
  let g = mkG
  let gW = net__rgrad W x g 1.0 0
  let gX = net__rgrad W x g 1.0 1
  let cW = chk_arr gW fd_w W x g 9 0 0
  let cX = chk_arr gX fd_x W x g 3 0 0
  let total = cW + cX
  let _ = print (cat [show cW, "/9 dW  ", show cX, "/3 dx (fan-out sum)"])
  let _ = print (cat [show total, "/12 synthesized residual reverse-mode checks passed"])
  if total == 12 then 0 else 1
