-- Rung 19 gate oracle: char-level tokenizer -> int ids -> shifted (input,
-- next-token) training pairs, with alignment verified.
--   tokenize: a known ASCII string "abcab" -> int ids via char_to_int.
--     'a'=97 'b'=98 'c'=99  =>  ids = [97,98,99,97,98]  (length L=5)
--   shifted pairs: for ids of length L there are L-1 pairs; pair t
--     (t=0..L-2) has input = ids[t], target = ids[t+1].
--     Stored as two parallel int arrays inp[t]=ids[t], tgt[t]=ids[t+1].
-- VERIFY: ids length == 5; ids[0] == char_to_int "a"; and for every t,
--   inp[t]==ids[t] AND tgt[t]==ids[t+1]. Each correct assertion is counted.
-- Char-level is deterministic; no bpe. Int arrays via arr_new/arr_get/arr_set
-- (int builtins); char_to_int / chars are compiler builtins. ASCII-only.
-- Run: /tmp/rail_atoms --out-prefix /tmp/rung19 run tools/ad/nn/rung19_tokenizer_pairs_verify_test.rail

-- ---- tokenizer: string -> int-id array ------------------------------------
-- Walk the char list, writing char_to_int of each char into ids[i].
tok_fill cs ids i =
  if cs == [] then ids
  else
    let _ = arr_set ids i (char_to_int (head cs))
    tok_fill (tail cs) ids (i + 1)

-- tokenize s : returns a fresh int array of length (length s), ids[i] = code
-- of the i-th character. Char-level, deterministic.
tokenize_chars s =
  let cs = chars s
  let n = length cs
  let ids = arr_new n 0
  tok_fill cs ids 0

-- ---- shifted (input, next-token) pairs ------------------------------------
-- inp[t] = ids[t], tgt[t] = ids[t+1], for t = 0 .. L-2.
pairs_fill ids np inp tgt t =
  if t >= np then 0
  else
    let _ = arr_set inp t (arr_get ids t)
    let _ = arr_set tgt t (arr_get ids (t + 1))
    pairs_fill ids np inp tgt (t + 1)

-- ---- verification loop ----------------------------------------------------
-- For each t check inp[t]==ids[t] (1) and tgt[t]==ids[t+1] (1). acc counts hits.
chk_pairs ids inp tgt np t acc =
  if t >= np then acc
  else
    let a = if (arr_get inp t) == (arr_get ids t) then 1 else 0
    let b = if (arr_get tgt t) == (arr_get ids (t + 1)) then 1 else 0
    chk_pairs ids inp tgt np (t + 1) (acc + a + b)

main =
  let _ = print "=== Rung 19 GATE: char-level tokenizer -> ids -> shifted pairs ==="
  let s = "abcab"
  let ids = tokenize_chars s
  let L = arr_len ids
  -- two structural assertions on the ids themselves
  let a_len = if L == 5 then 1 else 0
  let a_first = if (arr_get ids 0) == (char_to_int "a") then 1 else 0
  -- build the L-1 shifted pairs
  let np = L - 1
  let inp = arr_new np 0
  let tgt = arr_new np 0
  let _ = pairs_fill ids np inp tgt 0
  -- 2 assertions per pair == 2*(L-1) == 8 for L=5
  let pc = chk_pairs ids inp tgt np 0 0
  let total = a_len + a_first + pc
  -- N = 2 structural + 2*np pair assertions = 2 + 8 = 10
  let n = 2 + (2 * np)
  let _ = print (cat [show a_len, "/1 ids-length  ", show a_first, "/1 ids[0]==code('a')"])
  let _ = print (cat [show pc, "/", show (2 * np), " pair alignment (input==ids[t] & target==ids[t+1])"])
  let _ = print (cat [show total, "/", show n, " tokenizer+pairs checks passed"])
  if total == n then 0 else 1
