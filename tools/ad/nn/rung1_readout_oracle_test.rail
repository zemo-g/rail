-- Rung 1 GATE: SYNTHESIZED whole-net reverse-mode AD with a generalized DOT readout.
-- A #grad net ending in  float_dot y g  makes compile.rail synthesize
--   net__rgrad W1 W2 x g __gy __wrt
-- seeding the terminal cotangent from the dot readout (__cty_i = g_i * __gy) instead of
-- the hardwired sum broadcast. __wrt=0 -> dL/dW1, 1 -> dL/dW2, 2 -> dL/dx (g is the
-- fixed upstream cotangent, never differentiated). Every synthesized gradient component
-- is cross-checked against central finite differences of the actual forward primal --
-- the load-bearing falsification of the readout-seed generalization.
-- Run: ./rail_native run tools/ad/nn/rung1_readout_oracle_test.rail

import "stdlib/float_arr.rail"

#grad sq
sq z = z *. z

#grad net
net W1 W2 x g =
  let h1 = float_arr_map sq (float_mat_vec W1 x)
  let y  = float_arr_map sq (float_mat_vec W2 h1)
  float_dot y g

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. (0.005 +. (0.01 *. (fabs1 b))) then 1 else 0

fd_w1 W1 W2 x g idx =
  let h = 0.0001
  let orig = float_arr_get W1 idx
  let _ = float_arr_set W1 idx (orig +. h)
  let fp = net W1 W2 x g
  let _ = float_arr_set W1 idx (orig -. h)
  let fm = net W1 W2 x g
  let _ = float_arr_set W1 idx orig
  (fp -. fm) /. (2.0 *. h)

fd_w2 W1 W2 x g idx =
  let h = 0.0001
  let orig = float_arr_get W2 idx
  let _ = float_arr_set W2 idx (orig +. h)
  let fp = net W1 W2 x g
  let _ = float_arr_set W2 idx (orig -. h)
  let fm = net W1 W2 x g
  let _ = float_arr_set W2 idx orig
  (fp -. fm) /. (2.0 *. h)

fd_x W1 W2 x g idx =
  let h = 0.0001
  let orig = float_arr_get x idx
  let _ = float_arr_set x idx (orig +. h)
  let fp = net W1 W2 x g
  let _ = float_arr_set x idx (orig -. h)
  let fm = net W1 W2 x g
  let _ = float_arr_set x idx orig
  (fp -. fm) /. (2.0 *. h)

chk_arr gr fd W1 W2 x g n i acc =
  if i >= n then acc
  else
    let gi = float_arr_get gr i
    let fi = fd W1 W2 x g i
    chk_arr gr fd W1 W2 x g n (i + 1) (acc + (fnear gi fi))

mkW1 =
  let W = float_arr_new 6 0.0
  let _ = float_arr_set W 0 0.5
  let _ = float_arr_set W 1 0.2
  let _ = float_arr_set W 2 (0.0 -. 0.1)
  let _ = float_arr_set W 3 0.4
  let _ = float_arr_set W 4 0.3
  let _ = float_arr_set W 5 (0.0 -. 0.2)
  W

mkW2 =
  let W = float_arr_new 6 0.0
  let _ = float_arr_set W 0 0.4
  let _ = float_arr_set W 1 (0.0 -. 0.1)
  let _ = float_arr_set W 2 0.2
  let _ = float_arr_set W 3 0.1
  let _ = float_arr_set W 4 0.3
  let _ = float_arr_set W 5 (0.0 -. 0.2)
  W

mkX =
  let x = float_arr_new 2 0.0
  let _ = float_arr_set x 0 0.5
  let _ = float_arr_set x 1 (0.0 -. 0.3)
  x

mkG =
  let g = float_arr_new 2 0.0
  let _ = float_arr_set g 0 0.7
  let _ = float_arr_set g 1 (0.0 -. 0.4)
  g

main =
  let _ = print "=== Rung 1 GATE: synthesized DOT-readout net__rgrad (vs finite-diff) ==="
  let W1 = mkW1
  let W2 = mkW2
  let x = mkX
  let g = mkG
  let gW1 = net__rgrad W1 W2 x g 1.0 0
  let gW2 = net__rgrad W1 W2 x g 1.0 1
  let gX  = net__rgrad W1 W2 x g 1.0 2
  let c1 = chk_arr gW1 fd_w1 W1 W2 x g 6 0 0
  let c2 = chk_arr gW2 fd_w2 W1 W2 x g 6 0 0
  let cx = chk_arr gX  fd_x  W1 W2 x g 2 0 0
  let total = c1 + c2 + cx
  let _ = print (cat [show c1, "/6 dW1  ", show c2, "/6 dW2  ", show cx, "/2 dx"])
  let _ = print (cat [show total, "/14 synthesized dot-readout reverse-mode checks passed"])
  if total == 14 then 0 else 1
