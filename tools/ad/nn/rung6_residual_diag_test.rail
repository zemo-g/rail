-- Rung 6 DIAGNOSE-FIRST: prove the RESIDUAL fan-out reverse math + atoms on the CURRENT
-- binary with a HAND-WRITTEN backward, before any compile.rail change. The new structural
-- piece vs. the layer-chain is FAN-OUT: x is used in TWO places (the skip and the sublayer),
-- so its cotangent is the SUM of the two incoming cotangents. Net (square W so dims match):
--   z = W . x ;  s = sq(z) ;  y = x + s ;  L = float_dot y g
-- Backward (seed cty = g .* gy):  cts = cty ;  ctz = sq'(z) .* cts ;  dW = outer(ctz, x) ;
--   ctx = cty + W^T . ctz     <-- the skip cotangent (cty) PLUS the sublayer cotangent.
-- Every hand grad is cross-checked vs central finite differences of the actual forward.
-- Run: ./rail_native run tools/ad/nn/rung6_residual_diag_test.rail

import "stdlib/float_arr.rail"

sq z = z *. z
sqd z = 2.0 *. z
mul2 a b = a *. b
add2 a b = a +. b

-- forward: residual block  y = x + sq(W x)  then scalar readout dot with g
net W x g =
  let z = float_mat_vec W x
  let s = float_arr_map sq z
  let y = float_arr_map2 add2 x s
  float_dot y g

-- hand-written residual reverse; wrt 0 -> dW, 1 -> dx (the fan-out sum)
netman_rgrad W x g gy wrt =
  let z   = float_mat_vec W x
  let gyv = float_arr_new (float_arr_len g) gy
  let cty = float_arr_map2 mul2 g gyv
  let dz  = float_arr_map sqd z
  let ctz = float_arr_map2 mul2 dz cty
  let dW  = float_outer ctz x
  let ctsub = float_mat_vec_t W ctz
  let ctx = float_arr_map2 add2 cty ctsub
  if wrt == 0 then dW else ctx

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. (0.005 +. (0.01 *. (fabs1 b))) then 1 else 0

fd_w W x g idx =
  let h = 0.0001
  let orig = float_arr_get W idx
  let _ = float_arr_set W idx (orig +. h)
  let fp = net W x g
  let _ = float_arr_set W idx (orig -. h)
  let fm = net W x g
  let _ = float_arr_set W idx orig
  (fp -. fm) /. (2.0 *. h)

fd_x W x g idx =
  let h = 0.0001
  let orig = float_arr_get x idx
  let _ = float_arr_set x idx (orig +. h)
  let fp = net W x g
  let _ = float_arr_set x idx (orig -. h)
  let fm = net W x g
  let _ = float_arr_set x idx orig
  (fp -. fm) /. (2.0 *. h)

chk_arr gr fd W x g n i acc =
  if i >= n then acc
  else
    let gi = float_arr_get gr i
    let fi = fd W x g i
    chk_arr gr fd W x g n (i + 1) (acc + (fnear gi fi))

mkW =
  let W = float_arr_new 9 0.0
  let _ = float_arr_set W 0 0.5
  let _ = float_arr_set W 1 0.2
  let _ = float_arr_set W 2 (0.0 -. 0.1)
  let _ = float_arr_set W 3 0.4
  let _ = float_arr_set W 4 0.3
  let _ = float_arr_set W 5 (0.0 -. 0.2)
  let _ = float_arr_set W 6 (0.0 -. 0.15)
  let _ = float_arr_set W 7 0.25
  let _ = float_arr_set W 8 0.1
  W

mkX =
  let x = float_arr_new 3 0.0
  let _ = float_arr_set x 0 0.5
  let _ = float_arr_set x 1 (0.0 -. 0.3)
  let _ = float_arr_set x 2 0.2
  x

mkG =
  let g = float_arr_new 3 0.0
  let _ = float_arr_set g 0 0.7
  let _ = float_arr_set g 1 (0.0 -. 0.4)
  let _ = float_arr_set g 2 0.5
  g

main =
  let _ = print "=== Rung 6 DIAG: hand-written residual fan-out reverse (vs finite-diff) ==="
  let W = mkW
  let x = mkX
  let g = mkG
  let gW = netman_rgrad W x g 1.0 0
  let gX = netman_rgrad W x g 1.0 1
  let cW = chk_arr gW fd_w W x g 9 0 0
  let cX = chk_arr gX fd_x W x g 3 0 0
  let total = cW + cX
  let _ = print (cat [show cW, "/9 dW  ", show cX, "/3 dx (fan-out sum)"])
  let _ = print (cat [show total, "/12 hand residual reverse checks passed"])
  if total == 12 then 0 else 1
