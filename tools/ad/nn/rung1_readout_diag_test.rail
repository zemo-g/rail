-- Rung 1 DIAGNOSE-FIRST: prove the dot-readout reverse math + atoms on the CURRENT
-- binary with a HAND-WRITTEN backward, before any compile.rail change. Splits a future
-- synthesis bug from an atom/codegen bug. Net (depth 2, non-square) ends in a DOT
-- readout against a fixed upstream cotangent g:   L = float_dot ( sq(W2 . sq(W1 . x)) ) g
-- d(sum_i y_i g_i)/dy = g, so the terminal cotangent seed is g (scaled by gy). Every
-- hand grad is cross-checked vs central finite differences of the actual forward.
-- Run: ./rail_native run tools/ad/nn/rung1_readout_diag_test.rail

import "stdlib/float_arr.rail"

sq z = z *. z
sqd z = 2.0 *. z
mul2 a b = a *. b

net W1 W2 x g =
  let h1 = float_arr_map sq (float_mat_vec W1 x)
  let y  = float_arr_map sq (float_mat_vec W2 h1)
  float_dot y g

-- hand-written whole-net reverse for the dot readout; wrt 0->dW1 1->dW2 2->dx
netman_rgrad W1 W2 x g gy wrt =
  let z1  = float_mat_vec W1 x
  let h1  = float_arr_map sq z1
  let z2  = float_mat_vec W2 h1
  let gyv = float_arr_new (float_arr_len g) gy
  let cty = float_arr_map2 mul2 g gyv
  let d2  = float_arr_map sqd z2
  let ctz2 = float_arr_map2 mul2 d2 cty
  let dW2 = float_outer ctz2 h1
  let cth1 = float_mat_vec_t W2 ctz2
  let d1  = float_arr_map sqd z1
  let ctz1 = float_arr_map2 mul2 d1 cth1
  let dW1 = float_outer ctz1 x
  let ctx = float_mat_vec_t W1 ctz1
  if wrt == 0 then dW1 else if wrt == 1 then dW2 else ctx

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. (0.005 +. (0.01 *. (fabs1 b))) then 1 else 0

fd_w1 W1 W2 x g idx =
  let h = 0.0001
  let orig = float_arr_get W1 idx
  let _ = float_arr_set W1 idx (orig +. h)
  let fp = net W1 W2 x g
  let _ = float_arr_set W1 idx (orig -. h)
  let fm = net W1 W2 x g
  let _ = float_arr_set W1 idx orig
  (fp -. fm) /. (2.0 *. h)

fd_w2 W1 W2 x g idx =
  let h = 0.0001
  let orig = float_arr_get W2 idx
  let _ = float_arr_set W2 idx (orig +. h)
  let fp = net W1 W2 x g
  let _ = float_arr_set W2 idx (orig -. h)
  let fm = net W1 W2 x g
  let _ = float_arr_set W2 idx orig
  (fp -. fm) /. (2.0 *. h)

fd_x W1 W2 x g idx =
  let h = 0.0001
  let orig = float_arr_get x idx
  let _ = float_arr_set x idx (orig +. h)
  let fp = net W1 W2 x g
  let _ = float_arr_set x idx (orig -. h)
  let fm = net W1 W2 x g
  let _ = float_arr_set x idx orig
  (fp -. fm) /. (2.0 *. h)

chk_arr gr fd W1 W2 x g n i acc =
  if i >= n then acc
  else
    let gi = float_arr_get gr i
    let fi = fd W1 W2 x g i
    chk_arr gr fd W1 W2 x g n (i + 1) (acc + (fnear gi fi))

mkW1 =
  let W = float_arr_new 6 0.0
  let _ = float_arr_set W 0 0.5
  let _ = float_arr_set W 1 0.2
  let _ = float_arr_set W 2 (0.0 -. 0.1)
  let _ = float_arr_set W 3 0.4
  let _ = float_arr_set W 4 0.3
  let _ = float_arr_set W 5 (0.0 -. 0.2)
  W

mkW2 =
  let W = float_arr_new 6 0.0
  let _ = float_arr_set W 0 0.4
  let _ = float_arr_set W 1 (0.0 -. 0.1)
  let _ = float_arr_set W 2 0.2
  let _ = float_arr_set W 3 0.1
  let _ = float_arr_set W 4 0.3
  let _ = float_arr_set W 5 (0.0 -. 0.2)
  W

mkX =
  let x = float_arr_new 2 0.0
  let _ = float_arr_set x 0 0.5
  let _ = float_arr_set x 1 (0.0 -. 0.3)
  x

mkG =
  let g = float_arr_new 2 0.0
  let _ = float_arr_set g 0 0.7
  let _ = float_arr_set g 1 (0.0 -. 0.4)
  g

main =
  let _ = print "=== Rung 1 DIAG: hand-written dot-readout reverse (vs finite-diff) ==="
  let W1 = mkW1
  let W2 = mkW2
  let x = mkX
  let g = mkG
  let gW1 = netman_rgrad W1 W2 x g 1.0 0
  let gW2 = netman_rgrad W1 W2 x g 1.0 1
  let gX  = netman_rgrad W1 W2 x g 1.0 2
  let c1 = chk_arr gW1 fd_w1 W1 W2 x g 6 0 0
  let c2 = chk_arr gW2 fd_w2 W1 W2 x g 6 0 0
  let cx = chk_arr gX  fd_x  W1 W2 x g 2 0 0
  let total = c1 + c2 + cx
  let _ = print (cat [show c1, "/6 dW1  ", show c2, "/6 dW2  ", show cx, "/2 dx"])
  let _ = print (cat [show total, "/14 hand dot-readout reverse checks passed"])
  if total == 14 then 0 else 1
