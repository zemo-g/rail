-- Rung 15 BONUS: "it really trains on ATTESTED gradients." An SGD loop whose weight
-- updates come from the COMPILER-SYNTHESIZED net__rgrad -- not a hand-written backward.
-- The net is the rung-1 #grad dot-readout 2-layer net. We minimize MSE(y, target) where
-- y = sq(W2 . sq(W1 . x)). d(MSE)/dy = 2(y - t), and net__rgrad seeds its terminal
-- cotangent __cty = g .* __gy ; so passing g = 2(y - t) (gy=1) makes the synthesized
-- gradient EXACTLY d(MSE)/dW. We never differentiate by hand: every dW1/dW2 is produced
-- by the re-attestable Rail that compile.rail emitted. Success = MSE strictly decreases
-- and lands near zero. This is the deferred "attested training" demo, now a gate bonus.
-- Run: ./rail_native run tools/ad/nn/rung15_attested_sgd_demo.rail

import "stdlib/float_arr.rail"

#grad sq
sq z = z *. z

-- The #grad net whose reverse compile.rail synthesizes (dot readout = cotangent inject).
#grad net
net W1 W2 x g =
  let h1 = float_arr_map sq (float_mat_vec W1 x)
  let y  = float_arr_map sq (float_mat_vec W2 h1)
  float_dot y g

-- plain forward returning the OUTPUT VECTOR y (so we can read MSE + build the seed g).
fwd W1 W2 x =
  let h1 = float_arr_map sq (float_mat_vec W1 x)
  float_arr_map sq (float_mat_vec W2 h1)

sub2 a b = a -. b
twodiff a b = 2.0 *. (a -. b)   -- 2(y - t) = d(MSE)/dy, the seed cotangent g

sqsum_go a n i acc =
  if i >= n then acc
  else sqsum_go a n (i + 1) (acc +. ((float_arr_get a i) *. (float_arr_get a i)))

mse y t =
  let d = float_arr_map2 sub2 y t
  sqsum_go d (float_arr_len d) 0 0.0

-- in-place axpy: W[i] -= lr * dW[i]
axpy_go W dW lr n i =
  if i >= n then 0
  else
    let _ = float_arr_set W i ((float_arr_get W i) -. (lr *. (float_arr_get dW i)))
    axpy_go W dW lr n (i + 1)

step W1 W2 x t lr =
  let y   = fwd W1 W2 x
  let g   = float_arr_map2 twodiff y t
  let dW1 = net__rgrad W1 W2 x g 1.0 0
  let dW2 = net__rgrad W1 W2 x g 1.0 1
  let _ = axpy_go W1 dW1 lr (float_arr_len W1) 0
  let _ = axpy_go W2 dW2 lr (float_arr_len W2) 0
  0

-- run K SGD steps; return final MSE. Prints the curve so the decrease is visible.
loop W1 W2 x t lr k i =
  if i >= k then mse (fwd W1 W2 x) t
  else
    let m = mse (fwd W1 W2 x) t
    let _ = if (i - ((i / 20) * 20)) == 0 then print (cat ["  step ", show i, "  mse=", show_float m]) else 0
    let _ = step W1 W2 x t lr
    loop W1 W2 x t lr k (i + 1)

mkW1 =
  let W = float_arr_new 6 0.0
  let _ = float_arr_set W 0 0.5
  let _ = float_arr_set W 1 0.2
  let _ = float_arr_set W 2 (0.0 -. 0.1)
  let _ = float_arr_set W 3 0.4
  let _ = float_arr_set W 4 0.3
  let _ = float_arr_set W 5 (0.0 -. 0.2)
  W

mkW2 =
  let W = float_arr_new 6 0.0
  let _ = float_arr_set W 0 0.4
  let _ = float_arr_set W 1 (0.0 -. 0.1)
  let _ = float_arr_set W 2 0.2
  let _ = float_arr_set W 3 0.1
  let _ = float_arr_set W 4 0.3
  let _ = float_arr_set W 5 (0.0 -. 0.2)
  W

mkX =
  let x = float_arr_new 2 0.0
  let _ = float_arr_set x 0 0.5
  let _ = float_arr_set x 1 (0.0 -. 0.3)
  x

mkT =
  let t = float_arr_new 2 0.0
  let _ = float_arr_set t 0 0.30
  let _ = float_arr_set t 1 0.10
  t

main =
  let _ = print "=== Rung 15 BONUS: SGD on the COMPILER-SYNTHESIZED net__rgrad (MSE target) ==="
  let W1 = mkW1
  let W2 = mkW2
  let x = mkX
  let t = mkT
  let m0 = mse (fwd W1 W2 x) t
  let mF = loop W1 W2 x t 0.5 200 0
  let _ = print (cat ["start mse=", show_float m0, "   final mse=", show_float mF])
  -- attested-gradient training PASSES if the loss fell to a small fraction of the start.
  if (mF <. (0.05 *. m0)) then
    let _ = print "PASS: attested-gradient SGD reduced MSE > 20x (trains on re-compilable gradients)"
    0
  else
    let _ = print "FAIL: loss did not decrease as expected"
    1
