-- Rung 8 gate oracle: single-head scaled dot-product attention FORWARD.
--   Q,K,V each [L,d] flat row-major (length L*d).
--   scores[i,j] = (sum_p Q[i*d+p]*K[j*d+p]) / sqrt(d)        -> [L,L]
--   A[i,:]      = softmax_j scores[i,:]   (MAX-SUBTRACT per row before exp)
--   O[i,q]      = sum_j A[i,j]*V[j*d+q]                       -> [L,d]
-- Plus a numeric sanity check against a hand-computed tiny case (L=2,d=2).
-- Standalone float_arr; floats routed through function params (callee-saved
-- float-reg trap), results parked in heap float_arr. ASCII-only literals.
-- Run: /tmp/rail_atoms --out-prefix /tmp/rung8 run tools/ad/nn/rung8_attention_fwd_oracle_test.rail

import "stdlib/float_arr.rail"

foreign exp x -> float
foreign sqrt x -> float

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. (0.005 +. (0.01 *. (fabs1 b))) then 1 else 0

-- raw dot of row i of Q with row j of K (length d), accumulator as a param
qk_dot Q K d i j p acc =
  if p >= d then acc
  else qk_dot Q K d i j (p + 1) (acc +. ((float_arr_get Q (i * d + p)) *. (float_arr_get K (j * d + p))))

-- fill scores[L,L] already divided by sqrt(d)
sc_fill Q K L d invs S idx =
  if idx >= L * L then S
  else
    let i = idx / L
    let j = idx - (i * L)
    let raw = qk_dot Q K d i j 0 0.0
    let _ = float_arr_set S idx (raw *. invs)
    sc_fill Q K L d invs S (idx + 1)

scores_of Q K L d =
  let invs = 1.0 /. (sqrt (to_float d))
  let S = float_arr_new (L * L) 0.0
  sc_fill Q K L d invs S 0

-- row max over S[i,:] (param accumulator)
row_max S L i j acc =
  if j >= L then acc
  else
    let v = float_arr_get S (i * L + j)
    let nacc = if v >. acc then v else acc
    row_max S L i (j + 1) nacc

-- sum of exp(S[i,j]-m) over the row (param accumulator)
row_esum S L i m j acc =
  if j >= L then acc
  else row_esum S L i m (j + 1) (acc +. (exp ((float_arr_get S (i * L + j)) -. m)))

-- write A[i,:] = exp(S[i,j]-m)/Z into A
arow_fill S A L i m Z j =
  if j >= L then A
  else
    let e = exp ((float_arr_get S (i * L + j)) -. m)
    let _ = float_arr_set A (i * L + j) (e /. Z)
    arow_fill S A L i m Z (j + 1)

-- build full attention matrix A[L,L] (rows softmaxed)
a_rows S A L i =
  if i >= L then A
  else
    let m = row_max S L i 0 (0.0 -. 1.0e30)
    let Z = row_esum S L i m 0 0.0
    let _ = arow_fill S A L i m Z 0
    a_rows S A L (i + 1)

softmax_rows S L =
  let A = float_arr_new (L * L) 0.0
  a_rows S A L 0

-- O[i,q] = sum_j A[i,j]*V[j*d+q]  (param accumulator over j)
ov_dot A V L d i q j acc =
  if j >= L then acc
  else ov_dot A V L d i q (j + 1) (acc +. ((float_arr_get A (i * L + j)) *. (float_arr_get V (j * d + q))))

ov_fill A V L d O idx =
  if idx >= L * d then O
  else
    let i = idx / d
    let q = idx - (i * d)
    let _ = float_arr_set O idx (ov_dot A V L d i q 0 0.0)
    ov_fill A V L d O (idx + 1)

-- full forward: returns O [L,d]
attn_fwd Q K V L d =
  let S = scores_of Q K L d
  let A = softmax_rows S L
  let O = float_arr_new (L * d) 0.0
  ov_fill A V L d O 0

mkQ =
  let Q = float_arr_new 4 0.0
  let _ = float_arr_set Q 0 0.5
  let _ = float_arr_set Q 1 0.2
  let _ = float_arr_set Q 2 (0.0 -. 0.3)
  let _ = float_arr_set Q 3 0.4
  Q

mkK =
  let K = float_arr_new 4 0.0
  let _ = float_arr_set K 0 0.1
  let _ = float_arr_set K 1 0.6
  let _ = float_arr_set K 2 0.3
  let _ = float_arr_set K 3 (0.0 -. 0.2)
  K

mkV =
  let V = float_arr_new 4 0.0
  let _ = float_arr_set V 0 1.0
  let _ = float_arr_set V 1 (0.0 -. 0.5)
  let _ = float_arr_set V 2 0.25
  let _ = float_arr_set V 3 0.75
  V

-- Hand-computed reference for L=2,d=2 (sqrt(d)=sqrt2~1.4142135623730951):
-- scores raw: s00=Q0.K0=0.5*0.1+0.2*0.6=0.17 ; s01=Q0.K1=0.5*0.3+0.2*-0.2=0.11
--             s10=Q1.K0=-0.3*0.1+0.4*0.6=0.21 ; s11=Q1.K1=-0.3*0.3+0.4*-0.2=-0.17
-- scaled: /1.4142135623730951
--   sc00=0.12020815, sc01=0.07778175, sc10=0.14849472, sc11=-0.12020815
-- row0: m=0.12020815; e0=1, e1=exp(-0.0424264)=0.95846136; Z=1.95846136
--   A00=0.51061..  A01=0.48938..
-- row1: m=0.14849472; e0=1, e1=exp(-0.26870287)=0.76441..; Z=1.76441..
--   A10=0.56676..  A11=0.43323..
-- O0q = A00*V0q + A01*V1q ; V row0=(1.0,-0.5) row1=(0.25,0.75)
--   O00=0.51061*1.0 + 0.48938*0.25 = 0.63296..
--   O01=0.51061*-0.5 + 0.48938*0.75 = 0.11173..
--   O10=0.56676*1.0 + 0.43323*0.25 = 0.67507..
--   O11=0.56676*-0.5 + 0.43323*0.75 = 0.04154..
mkRef =
  let R = float_arr_new 4 0.0
  let _ = float_arr_set R 0 0.63296615
  let _ = float_arr_set R 1 0.11173096
  let _ = float_arr_set R 2 0.67507887
  let _ = float_arr_set R 3 0.04154169
  R

chk_ref O R n idx acc =
  if idx >= n then acc
  else chk_ref O R n (idx + 1) (acc + (fnear (float_arr_get O idx) (float_arr_get R idx)))

main =
  let _ = print "=== Rung 8 GATE: single-head attention FORWARD (vs hand-computed L=2 d=2) ==="
  let Q = mkQ
  let K = mkK
  let V = mkV
  let O = attn_fwd Q K V 2 2
  let R = mkRef
  let c = chk_ref O R 4 0 0
  let _ = print (cat [show c, "/4 output entries match the hand reference"])
  if c == 4 then 0 else 1
