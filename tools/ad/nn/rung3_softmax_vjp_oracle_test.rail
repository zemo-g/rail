-- Rung 3 gate oracle: numerically-stable softmax + its VJP, cross-checked
-- against central finite differences. Standalone float_arr, no Tensor ADT.
--   s = softmax(z) with MAX-SUBTRACT (subtract max(z) before exp)
--   given a FIXED upstream cotangent g, VJP wrt z is:
--       dz_i = s_i * (g_i - dot(g, s))
--   readout L = sum_i g_i * s_i(z) ; FD of L wrt each z_i must equal dz_i.
-- Run: /tmp/rail_atoms --out-prefix /tmp/rung3 run tools/ad/nn/rung3_softmax_vjp_oracle_test.rail

import "stdlib/float_arr.rail"

foreign exp x -> float

-- max over the array, threaded via a float accumulator arg.
fmax_acc z n i acc =
  if i >= n then acc
  else
    let v = float_arr_get z i
    if v >. acc then fmax_acc z n (i + 1) v
    else fmax_acc z n (i + 1) acc

-- sum of exp(z_i - mx), threaded via a float accumulator.
expsum_acc z n mx i acc =
  if i >= n then acc
  else expsum_acc z n mx (i + 1) (acc +. (exp ((float_arr_get z i) -. mx)))

-- softmax: s_i = exp(z_i - mx) / Z.  mx and Z passed as params (not let-stored
-- across a call boundary) where it matters; here fill is a single pass.
sm_fill z n mx den s idx =
  if idx >= n then s
  else
    let v = (exp ((float_arr_get z idx) -. mx)) /. den
    let _ = float_arr_set s idx v
    sm_fill z n mx den s (idx + 1)

softmax z n =
  let mx = fmax_acc z n 0 (float_arr_get z 0)
  let den = expsum_acc z n mx 0 0.0
  let s = float_arr_new n 0.0
  sm_fill z n mx den s 0

-- readout L = sum_i g_i * s_i(z). s recomputed from z every call (FD-safe).
sm_loss z g n =
  let s = softmax z n
  dot_acc s g n 0 0.0

-- dot(a,b) threaded via float accumulator arg.
dot_acc a b n i acc =
  if i >= n then acc
  else dot_acc a b n (i + 1) (acc +. ((float_arr_get a i) *. (float_arr_get b i)))

-- analytic VJP: dz_i = s_i * (g_i - gs) where gs = dot(g,s).
vjp_fill s g n gs dz idx =
  if idx >= n then dz
  else
    let v = (float_arr_get s idx) *. ((float_arr_get g idx) -. gs)
    let _ = float_arr_set dz idx v
    vjp_fill s g n gs dz (idx + 1)

softmax_vjp z g n =
  let s = softmax z n
  let gs = dot_acc g s n 0 0.0
  let dz = float_arr_new n 0.0
  vjp_fill s g n gs dz 0

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. (0.005 +. (0.01 *. (fabs1 b))) then 1 else 0

fd_z z g n idx =
  let h = 0.0001
  let orig = float_arr_get z idx
  let _ = float_arr_set z idx (orig +. h)
  let fp = sm_loss z g n
  let _ = float_arr_set z idx (orig -. h)
  let fm = sm_loss z g n
  let _ = float_arr_set z idx orig
  (fp -. fm) /. (2.0 *. h)

chk dz z g n cnt idx acc =
  if idx >= cnt then acc
  else
    let gi = float_arr_get dz idx
    let fi = fd_z z g n idx
    chk dz z g n cnt (idx + 1) (acc + (fnear gi fi))

mkZ =
  let z = float_arr_new 5 0.0
  let _ = float_arr_set z 0 0.5
  let _ = float_arr_set z 1 (0.0 -. 0.3)
  let _ = float_arr_set z 2 1.1
  let _ = float_arr_set z 3 (0.0 -. 0.7)
  let _ = float_arr_set z 4 0.2
  z

mkG =
  let g = float_arr_new 5 0.0
  let _ = float_arr_set g 0 1.0
  let _ = float_arr_set g 1 (0.0 -. 0.5)
  let _ = float_arr_set g 2 0.3
  let _ = float_arr_set g 3 0.7
  let _ = float_arr_set g 4 (0.0 -. 0.2)
  g

main =
  let _ = print "=== Rung 3 GATE: stable softmax VJP (vs finite-diff, N=5) ==="
  let z = mkZ
  let g = mkG
  let dz = softmax_vjp z g 5
  let c = chk dz z g 5 5 0 0
  let _ = print (cat [show c, "/5 softmax VJP checks passed"])
  if c == 5 then 0 else 1
