-- Rung 4 gate oracle: cross-entropy(logits, target id) + its gradient,
-- cross-checked against central finite differences. Standalone float_arr.
--   logits z, integer target t.
--   L = log(sum_j exp(z_j)) - z_t   (computed with max-subtract for stability:
--       L = mx + log(sum_j exp(z_j - mx)) - z_t)
--   grad wrt z_i = softmax(z)_i - (1 if i==t else 0)
-- FD perturbs z. The loss is the scalar readout (no upstream Up).
-- Run: /tmp/rail_atoms --out-prefix /tmp/rung4 run tools/ad/nn/rung4_crossentropy_oracle_test.rail

import "stdlib/float_arr.rail"

foreign exp x -> float
foreign log x -> float

-- max over the array, threaded via a float accumulator arg.
fmax_acc z n i acc =
  if i >= n then acc
  else
    let v = float_arr_get z i
    if v >. acc then fmax_acc z n (i + 1) v
    else fmax_acc z n (i + 1) acc

-- sum of exp(z_i - mx), threaded via a float accumulator.
expsum_acc z n mx i acc =
  if i >= n then acc
  else expsum_acc z n mx (i + 1) (acc +. (exp ((float_arr_get z i) -. mx)))

-- L = mx + log(Z) - z_t,  Z = sum exp(z - mx).  All intermediates passed
-- through params / recomputed from z, so nothing relies on a let surviving
-- across a call boundary.
ce_loss z t n =
  let mx = fmax_acc z n 0 (float_arr_get z 0)
  let zsum = expsum_acc z n mx 0 0.0
  (mx +. (log zsum)) -. (float_arr_get z t)

-- softmax fill (stable), used only by the analytic grad.
sm_fill z n mx den s idx =
  if idx >= n then s
  else
    let v = (exp ((float_arr_get z idx) -. mx)) /. den
    let _ = float_arr_set s idx v
    sm_fill z n mx den s (idx + 1)

-- analytic grad: g_i = softmax(z)_i - (1 if i==t else 0).
ce_grad z t n =
  let mx = fmax_acc z n 0 (float_arr_get z 0)
  let den = expsum_acc z n mx 0 0.0
  let g = float_arr_new n 0.0
  let _ = sm_fill z n mx den g 0
  let cur = float_arr_get g t
  let _ = float_arr_set g t (cur -. 1.0)
  g

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. (0.005 +. (0.01 *. (fabs1 b))) then 1 else 0

fd_z z t n idx =
  let h = 0.0001
  let orig = float_arr_get z idx
  let _ = float_arr_set z idx (orig +. h)
  let fp = ce_loss z t n
  let _ = float_arr_set z idx (orig -. h)
  let fm = ce_loss z t n
  let _ = float_arr_set z idx orig
  (fp -. fm) /. (2.0 *. h)

chk g z t n cnt idx acc =
  if idx >= cnt then acc
  else
    let gi = float_arr_get g idx
    let fi = fd_z z t n idx
    chk g z t n cnt (idx + 1) (acc + (fnear gi fi))

mkZ =
  let z = float_arr_new 5 0.0
  let _ = float_arr_set z 0 0.6
  let _ = float_arr_set z 1 (0.0 -. 0.2)
  let _ = float_arr_set z 2 1.0
  let _ = float_arr_set z 3 (0.0 -. 0.9)
  let _ = float_arr_set z 4 0.3
  z

main =
  let _ = print "=== Rung 4 GATE: cross-entropy loss + grad (vs finite-diff, N=5, target=2) ==="
  let z = mkZ
  let g = ce_grad z 2 5
  let c = chk g z 2 5 5 0 0
  let _ = print (cat [show c, "/5 cross-entropy grad checks passed"])
  if c == 5 then 0 else 1
