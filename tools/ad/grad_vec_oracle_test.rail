-- P3 V-series array-AD differential oracle (V0 forward map .. V5-s3 chain readout).
-- These forms are what the compiler's synth_grad_decls dispatch detects; before this
-- file NONE of them had a committed executable gate (the suite exercises no AD path),
-- and all keyed on the float_arr_sum readout that was missing from stdlib until now.
--
-- Each synthesized gradient is cross-checked against a hand-derived closed form, and
-- the scalar-loss forms (V3/V4/s2/s3) ALSO against central finite differences on the
-- actual forward primal. Run: ./rail_native run tools/ad/grad_vec_oracle_test.rail

import "stdlib/float_arr.rail"

#grad sq
sq z = z *. z

#grad tpl
tpl z = 3.0 *. z

#grad gmul
gmul a b = a *. b

-- V0/V1: elementwise map.  f__grad xs = [g'(xs_i)] ; f__rgrad xs gys = [g'(xs_i)*gys_i]
#grad vmap
vmap xs = float_arr_map sq xs

-- V2: bare sum.  f__rgrad xs gy = broadcast(gy)
#grad vsum
vsum xs = float_arr_sum xs

-- V3: scalar loss = sum(map).  f__rgrad xs gy = [g'(xs_i)*gy]
#grad vloss
vloss xs = float_arr_sum (float_arr_map sq xs)

-- V4: contraction = sum(map2 g w x).  f__rgrad w x gy wrt -> dL/dw (0) / dL/dx (1)
#grad vdot
vdot w x = float_arr_sum (float_arr_map2 gmul w x)

-- V5 s2: strict linear map-chain ending in sum.  f__rgrad xs gy = dL/dxs
#grad vchain
vchain xs =
  let a0 = float_arr_map sq xs
  let a1 = float_arr_map tpl a0
  float_arr_sum a1

-- V5 s3: map-chain feeding a dot-product readout.  f__rgrad xs w gy wrt -> dL/dxs (0) / dL/dw (1)
#grad vread
vread xs w =
  let a0 = float_arr_map sq xs
  let z = float_arr_map tpl a0
  float_arr_sum (float_arr_map2 gmul w z)

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. 0.01 then 1 else 0

mk3 p q r =
  let a = float_arr_new 3 0.0
  let _ = float_arr_set a 0 p
  let _ = float_arr_set a 1 q
  let _ = float_arr_set a 2 r
  a

-- finite diff of a single-array-param primal at index i
fd1 prim xs i =
  let h = 0.0001
  let o = float_arr_get xs i
  let _ = float_arr_set xs i (o +. h)
  let fp = prim xs
  let _ = float_arr_set xs i (o -. h)
  let fm = prim xs
  let _ = float_arr_set xs i o
  (fp -. fm) /. (2.0 *. h)

main =
  let _ = print "=== P3 V-series array-AD oracle (synth grad vs analytic vs finite-diff) ==="
  let xs = mk3 1.0 2.0 3.0
  -- V0 forward: vmap__grad xs = [2,4,6]
  let g0 = vmap__grad xs
  let v0a = fnear (float_arr_get g0 0) 2.0
  let v0b = fnear (float_arr_get g0 1) 4.0
  let v0c = fnear (float_arr_get g0 2) 6.0
  -- V1 reverse at unit cotangent must equal forward; and weighted cotangent
  let ones = mk3 1.0 1.0 1.0
  let r1 = vmap__rgrad xs ones
  let v1a = fnear (float_arr_get r1 0) 2.0
  let v1b = fnear (float_arr_get r1 1) 4.0
  let v1c = fnear (float_arr_get r1 2) 6.0
  let wgt = mk3 0.5 1.0 2.0
  let r1w = vmap__rgrad xs wgt
  let v1d = fnear (float_arr_get r1w 0) 1.0
  let v1e = fnear (float_arr_get r1w 1) 4.0
  let v1f = fnear (float_arr_get r1w 2) 12.0
  -- V2 bare sum: vsum__rgrad xs 2.0 = [2,2,2]
  let r2 = vsum__rgrad xs 2.0
  let v2a = fnear (float_arr_get r2 0) 2.0
  let v2b = fnear (float_arr_get r2 1) 2.0
  let v2c = fnear (float_arr_get r2 2) 2.0
  -- V3 scalar loss: vloss__rgrad xs 1.0 = [2,4,6] ; cross fd
  let r3 = vloss__rgrad xs 1.0
  let v3a = fnear (float_arr_get r3 0) 2.0
  let v3b = fnear (float_arr_get r3 1) 4.0
  let v3c = fnear (float_arr_get r3 2) 6.0
  let v3d = fnear (float_arr_get r3 0) (fd1 vloss xs 0)
  let v3e = fnear (float_arr_get r3 1) (fd1 vloss xs 1)
  let v3f = fnear (float_arr_get r3 2) (fd1 vloss xs 2)
  -- V4 contraction: w=[1,2,3] x=[4,5,6] gy=1 -> dw=[4,5,6] dx=[1,2,3]
  let w = mk3 1.0 2.0 3.0
  let xx = mk3 4.0 5.0 6.0
  let dW = vdot__rgrad w xx 1.0 0
  let dX = vdot__rgrad w xx 1.0 1
  let v4a = fnear (float_arr_get dW 0) 4.0
  let v4b = fnear (float_arr_get dW 1) 5.0
  let v4c = fnear (float_arr_get dW 2) 6.0
  let v4d = fnear (float_arr_get dX 0) 1.0
  let v4e = fnear (float_arr_get dX 1) 2.0
  let v4f = fnear (float_arr_get dX 2) 3.0
  -- V5 s2 chain: vchain__rgrad xs 1.0 = [6,12,18] ; cross fd
  let r5 = vchain__rgrad xs 1.0
  let v5a = fnear (float_arr_get r5 0) 6.0
  let v5b = fnear (float_arr_get r5 1) 12.0
  let v5c = fnear (float_arr_get r5 2) 18.0
  let v5d = fnear (float_arr_get r5 0) (fd1 vchain xs 0)
  let v5e = fnear (float_arr_get r5 1) (fd1 vchain xs 1)
  let v5f = fnear (float_arr_get r5 2) (fd1 vchain xs 2)
  -- V5 s3 chain readout: xs=[1,2,3] w=[2,1,0.5] gy=1 -> dxs=[12,12,9] dw=z=[3,12,27]
  let w2 = mk3 2.0 1.0 0.5
  let dxs = vread__rgrad xs w2 1.0 0
  let dw2 = vread__rgrad xs w2 1.0 1
  let s3a = fnear (float_arr_get dxs 0) 12.0
  let s3b = fnear (float_arr_get dxs 1) 12.0
  let s3c = fnear (float_arr_get dxs 2) 9.0
  let s3d = fnear (float_arr_get dw2 0) 3.0
  let s3e = fnear (float_arr_get dw2 1) 12.0
  let s3f = fnear (float_arr_get dw2 2) 27.0
  let total = v0a+v0b+v0c + v1a+v1b+v1c+v1d+v1e+v1f + v2a+v2b+v2c + v3a+v3b+v3c+v3d+v3e+v3f + v4a+v4b+v4c+v4d+v4e+v4f + v5a+v5b+v5c+v5d+v5e+v5f + s3a+s3b+s3c+s3d+s3e+s3f
  let _ = print (cat [show total, "/36 V-series array-AD checks passed"])
  if total == 36 then 0 else 1
