-- tools/ad/grad_oracle_test.rail -- P3 C0.2: differential oracle for the #grad desugar.
--
-- Three INDEPENDENT witnesses of f'(x) for f(x) = x*x + 3x must agree at every point:
--   (1) synthesized -- the compiler's #grad desugar emits f__grad over the real Rail AST
--   (2) symbolic    -- diff.rail differentiates an independent Expr encoding of the same f
--   (3) numeric     -- central finite-difference on the Expr (totally different method)
-- (1) and (2) are bit-identical (same algebraic rules, same operand order); both match (3)
-- within tolerance. A mismatch is a miscompiled gradient -- exactly the class of silent
-- numeric bug that attestation must rule out.
--
-- Run from the repo root: ./rail_native run tools/ad/grad_oracle_test.rail

import "tools/ad/diff.rail"

#grad f
f x = (x *. x) +. (3.0 *. x)

-- check point k: compare synth (syns[k]) vs symbolic (eval) vs numeric (num_grad).
-- Floats flow only through float_arr_get / eval / num_grad (diff.rail's proven idiom) --
-- no float-scalar params, whose return-type inference is unreliable.
check_idx g0 fexpr inputs consts xs syns k =
  let x = float_arr_get xs k
  let _ = float_arr_set inputs 0 x
  let sym = eval g0 inputs consts
  let num = num_grad fexpr inputs consts 0
  let syn = float_arr_get syns k
  -- NB: typecheck warns "comparison < on int and float" below -- sym/num are floats
  -- (eval/num_grad returns) the inference pass conservatively tags int. Benign: codegen
  -- emits fcmp and results are correct; the vendored diff.rail demo warns identically.
  let dssr = sym - syn
  let dss = if dssr < 0.0 then 0.0 - dssr else dssr
  let dsnr = sym - num
  let dsn = if dsnr < 0.0 then 0.0 - dsnr else dsnr
  let ok = if dss == 0.0 then (if dsn < 0.001 then 1 else 0) else 0
  let _ = print (cat ["  x=", show_float x, "   synth=", show_float syn, "   symbolic=", show_float sym, "   numeric=", show_float num, "   ", (if ok == 1 then "AGREE" else "DIVERGE")])
  ok

main =
  let _ = print "=== P3 C0.2: three-witness differential oracle (#grad vs diff.rail vs numeric) ==="
  -- f(x) = x*x + 3x, single input x0. Encode as Expr; consts[2] = 3.0 (user constant).
  let fexpr = Add (Mul (Var 0) (Var 0)) (Mul (Kst 2) (Var 0))
  let consts = float_arr_new 3 0.0
  let _ = float_arr_set consts 0 0.0
  let _ = float_arr_set consts 1 1.0
  let _ = float_arr_set consts 2 3.0
  let inputs = float_arr_new 1 0.0
  let g0 = diff fexpr 0
  let _ = print (cat ["  f(x) = x*x + 3x   ;   f'(x) symbolic = ", show_expr g0])
  -- test points (incl. zero, a fractional, and a negative):
  let xs = float_arr_new 5 0.0
  let _ = float_arr_set xs 0 2.0
  let _ = float_arr_set xs 1 5.0
  let _ = float_arr_set xs 2 0.0
  let _ = float_arr_set xs 3 3.5
  let _ = float_arr_set xs 4 (0.0 -. 2.0)
  -- synthesized gradient evaluated by the COMPILER-EMITTED f__grad:
  let syns = float_arr_new 5 0.0
  let _ = float_arr_set syns 0 (f__grad 2.0)
  let _ = float_arr_set syns 1 (f__grad 5.0)
  let _ = float_arr_set syns 2 (f__grad 0.0)
  let _ = float_arr_set syns 3 (f__grad 3.5)
  let _ = float_arr_set syns 4 (f__grad (0.0 -. 2.0))
  let c0 = check_idx g0 fexpr inputs consts xs syns 0
  let c1 = check_idx g0 fexpr inputs consts xs syns 1
  let c2 = check_idx g0 fexpr inputs consts xs syns 2
  let c3 = check_idx g0 fexpr inputs consts xs syns 3
  let c4 = check_idx g0 fexpr inputs consts xs syns 4
  let total = c0 + c1 + c2 + c3 + c4
  let _ = print (cat ["RESULT: ", show total, "/5 points agree across all three witnesses"])
  if total == 5 then 0 else 1
