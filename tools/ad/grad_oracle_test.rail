-- tools/ad/grad_oracle_test.rail -- P3 C1: multi-input differential oracle for #grad.
--
-- C0.2 proved the single-input gradient against three witnesses. C1 extends the desugar
-- to n inputs: #grad f synthesizes f__grad <params...> __gi, an if-chain that selects the
-- partial w.r.t. the __gi-th param (forward-mode -- one directional derivative per call,
-- exactly mirroring diff.rail's `diff e i`). This harness exercises a 2-input f and checks
-- BOTH partials at every point against three INDEPENDENT witnesses of df/d(input_j):
--   (1) synthesized -- the compiler's #grad desugar emits f__grad over the real Rail AST
--   (2) symbolic    -- diff.rail differentiates an independent Expr encoding of the same f
--   (3) numeric     -- central finite-difference on the Expr (a totally different method)
-- (1) and (2) are bit-identical (same algebraic rules, same operand order); both match (3)
-- within tolerance. A mismatch on any partial is a miscompiled gradient -- the silent
-- numeric bug attestation must rule out.
--
-- Run from the repo root: ./rail_native run tools/ad/grad_oracle_test.rail

import "tools/ad/diff.rail"

#grad f
f x y = (x *. y) +. (3.0 *. x)

-- check partial j at the point currently loaded in inputs: synth (syn) vs symbolic (eval
-- of g, the j-th symbolic gradient) vs numeric (num_grad). Floats flow only through
-- float_arr_get / eval / num_grad (diff.rail's proven idiom) -- no float-scalar params.
check g fexpr inputs consts j syn =
  let sym = eval g inputs consts
  let num = num_grad fexpr inputs consts j
  -- NB: typecheck warns "comparison < on int and float" below -- sym/num are floats
  -- (eval/num_grad returns) the inference pass conservatively tags int. Benign: codegen
  -- emits fcmp and results are correct; the vendored diff.rail demo warns identically.
  let dssr = sym - syn
  let dss = if dssr < 0.0 then 0.0 - dssr else dssr
  let dsnr = sym - num
  let dsn = if dsnr < 0.0 then 0.0 - dsnr else dsnr
  let ok = if dss == 0.0 then (if dsn < 0.001 then 1 else 0) else 0
  let _ = print (cat ["    d/d", (if j == 0 then "x" else "y"), "   synth=", show_float syn, "   symbolic=", show_float sym, "   numeric=", show_float num, "   ", (if ok == 1 then "AGREE" else "DIVERGE")])
  ok

-- point k: xs is flat [x0,y0,x1,y1,...]; syns is flat [dx0,dy0,dx1,dy1,...].
check_pt g0 g1 fexpr inputs consts xs syns k =
  let x = float_arr_get xs (k * 2)
  let y = float_arr_get xs (k * 2 + 1)
  let _ = float_arr_set inputs 0 x
  let _ = float_arr_set inputs 1 y
  let syn0 = float_arr_get syns (k * 2)
  let syn1 = float_arr_get syns (k * 2 + 1)
  let _ = print (cat ["  (x,y) = (", show_float x, ", ", show_float y, ")"])
  let a = check g0 fexpr inputs consts 0 syn0
  let b = check g1 fexpr inputs consts 1 syn1
  a + b

main =
  let _ = print "=== P3 C1: multi-input three-witness oracle (#grad vs diff.rail vs numeric) ==="
  -- f(x,y) = x*y + 3x. Inputs: x = Var 0, y = Var 1. consts[2] = 3.0 (user constant).
  let fexpr = Add (Mul (Var 0) (Var 1)) (Mul (Kst 2) (Var 0))
  let consts = float_arr_new 3 0.0
  let _ = float_arr_set consts 0 0.0
  let _ = float_arr_set consts 1 1.0
  let _ = float_arr_set consts 2 3.0
  let inputs = float_arr_new 2 0.0
  let g0 = diff fexpr 0
  let g1 = diff fexpr 1
  let _ = print (cat ["  df/dx symbolic = ", show_expr g0, "   (expect y + 3)"])
  let _ = print (cat ["  df/dy symbolic = ", show_expr g1, "   (expect x)"])
  -- test points (x,y): incl. a zero, a fractional, and negatives.
  let xs = float_arr_new 8 0.0
  let _ = float_arr_set xs 0 2.0
  let _ = float_arr_set xs 1 5.0
  let _ = float_arr_set xs 2 0.0
  let _ = float_arr_set xs 3 3.0
  let _ = float_arr_set xs 4 3.5
  let _ = float_arr_set xs 5 (0.0 -. 2.0)
  let _ = float_arr_set xs 6 (0.0 -. 2.0)
  let _ = float_arr_set xs 7 4.0
  -- synthesized partials from the COMPILER-EMITTED f__grad (df/dx then df/dy per point):
  let syns = float_arr_new 8 0.0
  let _ = float_arr_set syns 0 (f__grad 2.0 5.0 0)
  let _ = float_arr_set syns 1 (f__grad 2.0 5.0 1)
  let _ = float_arr_set syns 2 (f__grad 0.0 3.0 0)
  let _ = float_arr_set syns 3 (f__grad 0.0 3.0 1)
  let _ = float_arr_set syns 4 (f__grad 3.5 (0.0 -. 2.0) 0)
  let _ = float_arr_set syns 5 (f__grad 3.5 (0.0 -. 2.0) 1)
  let _ = float_arr_set syns 6 (f__grad (0.0 -. 2.0) 4.0 0)
  let _ = float_arr_set syns 7 (f__grad (0.0 -. 2.0) 4.0 1)
  let c0 = check_pt g0 g1 fexpr inputs consts xs syns 0
  let c1 = check_pt g0 g1 fexpr inputs consts xs syns 1
  let c2 = check_pt g0 g1 fexpr inputs consts xs syns 2
  let c3 = check_pt g0 g1 fexpr inputs consts xs syns 3
  let total = c0 + c1 + c2 + c3
  let _ = print (cat ["RESULT: ", show total, "/8 partials agree across all three witnesses"])
  if total == 8 then 0 else 1
