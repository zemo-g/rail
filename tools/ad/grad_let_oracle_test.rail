-- tools/ad/grad_let_oracle_test.rail -- P3 C3: let-bearing forward-mode oracle for #grad.
--
-- C2 proved transcendentals on flat expression trees. C3 differentiates through `let v = e1
-- in e2` -- the desugar emits a primal binding `let v = e1` plus a tangent `let v__d = d(e1)`,
-- so a reference to v in e2 differentiates to v__d. This is the gateway to reverse-mode: a let
-- names a SHARED subexpression (a DAG node), and the gradient must thread through it correctly.
--
-- Four-way witness. For each function we keep a let-bearing form (f) and a flattened form (g)
-- that inlines the let -- mathematically identical. Then per point:
--   (1) synth-let   -- f__grad over the real AST, differentiating through `let`
--   (2) synth-flat  -- g__grad over the inlined AST (already proven by C0-C2)
--   (3) symbolic    -- diff.rail over an independent Expr encoding of the flattened form
--   (4) numeric     -- central finite-difference on that Expr
-- (1)==(2)==(3) are BIT-IDENTICAL (a let just names a shared subexpr -- the emitted gradient is
-- exactly the inlined one), and all match (4) within tolerance. (1)==(2) is the new C3 claim:
-- let-differentiation produces precisely the flattened gradient, bit-for-bit.
--
-- Run from the repo root: ./rail_native run tools/ad/grad_let_oracle_test.rail

import "tools/ad/diff.rail"

#grad f1
f1 x = let a = sin x in a *. a

#grad g1
g1 x = (sin x) *. (sin x)

#grad f2
f2 x = let a = x *. x in let b = a +. x in b *. b

#grad g2
g2 x = ((x *. x) +. x) *. ((x *. x) +. x)

-- four-way check at xs[xi]. Floats flow only through arrays / eval / num_grad. NB: the benign
-- "comparison < on int and float" warning applies here exactly as in the vendored diff.rail.
check_let label gexpr g inputs consts xs synf syng xi =
  let x = float_arr_get xs xi
  let sf = float_arr_get synf xi
  let sg = float_arr_get syng xi
  let _ = float_arr_set inputs 0 x
  let sym = eval g inputs consts
  let num = num_grad gexpr inputs consts 0
  let dfg = sf - sg
  let adfg = if dfg < 0.0 then 0.0 - dfg else dfg
  let dgs = sg - sym
  let adgs = if dgs < 0.0 then 0.0 - dgs else dgs
  let dsn = sym - num
  let adsn = if dsn < 0.0 then 0.0 - dsn else dsn
  let ok = if adfg == 0.0 then (if adgs == 0.0 then (if adsn < 0.001 then 1 else 0) else 0) else 0
  let _ = print (cat ["  ", label, " @", show_float x, "   let=", show_float sf, "   flat=", show_float sg, "   sym=", show_float sym, "   num=", show_float num, "   ", (if ok == 1 then "AGREE" else "DIVERGE")])
  ok

main =
  let _ = print "=== P3 C3: let-bearing forward-mode oracle (synth-let vs synth-flat vs symbolic vs numeric) ==="
  let consts = float_arr_new 2 0.0
  let _ = float_arr_set consts 0 0.0
  let _ = float_arr_set consts 1 1.0
  let inputs = float_arr_new 1 0.0
  -- flattened forms as independent Expr: g1 = sin(x)^2,  g2 = (x^2 + x)^2.
  let e1 = Mul (Sin (Var 0)) (Sin (Var 0))
  let d1 = diff e1 0
  let e2 = Mul (Add (Mul (Var 0) (Var 0)) (Var 0)) (Add (Mul (Var 0) (Var 0)) (Var 0))
  let d2 = diff e2 0
  let _ = print (cat ["  d/dx sin(x)^2  = ", show_expr d1])
  let _ = print (cat ["  d/dx (x^2+x)^2 = ", show_expr d2])
  -- six test points (incl. negatives and an exact-zero-by-cancellation at x=-0.5 for f2).
  let xs = float_arr_new 6 0.0
  let _ = float_arr_set xs 0 0.5
  let _ = float_arr_set xs 1 (0.0 -. 1.0)
  let _ = float_arr_set xs 2 1.25
  let _ = float_arr_set xs 3 2.0
  let _ = float_arr_set xs 4 0.0
  let _ = float_arr_set xs 5 (0.0 -. 0.5)
  -- synth-with-let (selector 0 = sole input):
  let synf = float_arr_new 6 0.0
  let _ = float_arr_set synf 0 (f1__grad 0.5 0)
  let _ = float_arr_set synf 1 (f1__grad (0.0 -. 1.0) 0)
  let _ = float_arr_set synf 2 (f1__grad 1.25 0)
  let _ = float_arr_set synf 3 (f2__grad 2.0 0)
  let _ = float_arr_set synf 4 (f2__grad 0.0 0)
  let _ = float_arr_set synf 5 (f2__grad (0.0 -. 0.5) 0)
  -- synth-flattened:
  let syng = float_arr_new 6 0.0
  let _ = float_arr_set syng 0 (g1__grad 0.5 0)
  let _ = float_arr_set syng 1 (g1__grad (0.0 -. 1.0) 0)
  let _ = float_arr_set syng 2 (g1__grad 1.25 0)
  let _ = float_arr_set syng 3 (g2__grad 2.0 0)
  let _ = float_arr_set syng 4 (g2__grad 0.0 0)
  let _ = float_arr_set syng 5 (g2__grad (0.0 -. 0.5) 0)
  let _ = print "sin(x)^2 (single let):"
  let a0 = check_let "f1'" e1 d1 inputs consts xs synf syng 0
  let a1 = check_let "f1'" e1 d1 inputs consts xs synf syng 1
  let a2 = check_let "f1'" e1 d1 inputs consts xs synf syng 2
  let _ = print "(x^2+x)^2 (nested let, shared subexpr a):"
  let b0 = check_let "f2'" e2 d2 inputs consts xs synf syng 3
  let b1 = check_let "f2'" e2 d2 inputs consts xs synf syng 4
  let b2 = check_let "f2'" e2 d2 inputs consts xs synf syng 5
  let total = a0 + a1 + a2 + b0 + b1 + b2
  let _ = print (cat ["RESULT: ", show total, "/6 points agree across all four witnesses"])
  if total == 6 then 0 else 1
