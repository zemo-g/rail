-- C4.2 reverse-mode-through-transcendental differential oracle. C4.0/C4.1 covered
-- rational reverse-mode (flat + let-DAG). C4.2 threads the single backward sweep
-- through the unary transcendental set (sin/cos/exp/tanh/sqrt/log), both flat and
-- inside a let-spine. For an A-node f(arg), the reverse rule pushes ct * f'(arg)
-- onto arg's leaves; the local factor f'(arg) mirrors grad_deriv's forward A-branch,
-- so the C4.1 spine machinery differentiates transcendentals for free.
--
-- Each reverse gradient component is cross-checked against TWO independent witnesses:
--   1. forward-mode f__grad .. i  (C2 transcendental + C3 let differentiator -- a
--      different code path, read through a tag-safe float_arr scratch)
--   2. a hand-derived closed-form analytic gradient (no primal call at all)
-- Reverse and forward emit different-but-equal symbolic expressions, so agreement is
-- to tolerance (fnear), not bit-identity. 22 checks total.
--
-- Run from the repo root: ./rail_native run tools/ad/grad_rev_trans_oracle_test.rail

-- p = sin(x)^2 (flat):  p' = 2 sin x cos x = sin 2x
#grad p
p x = (sin x) *. (sin x)

-- ef = exp x (flat, bare transcendental, no surrounding op):  ef' = exp x
#grad ef
ef x = exp x

-- q = sin(a*b) (flat, multi-input, transcendental of a product):
--   da = b cos(ab),  db = a cos(ab)
#grad q
q a b = sin (a *. b)

-- r = sin(x)^2 through a let (transcendental as a let-val):  r' = sin 2x
#grad r
r x =
  let a = sin x
  a *. a

-- s = sin x + cos x (sum of two transcendentals):  s' = cos x - sin x
#grad s
s x = (sin x) +. (cos x)

-- tf = tanh x:  tf' = 1 - tanh^2 x
#grad tf
tf x = tanh x

-- qf = sqrt x:  qf' = 1/(2 sqrt x)
#grad qf
qf x = sqrt x

-- lf = log x:  lf' = 1/x
#grad lf
lf x = log x

-- lm = b * exp a through a let (let-spine, multi-input, transcendental val plus a
-- param used only downstream):  da = b exp a,  db = exp a
#grad lm
lm a b =
  let u = exp a
  u *. b

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. 0.001 then 1 else 0

main =
  let _ = print "=== P3 C4.2: reverse-mode-through-transcendental oracle (rgrad vs forward-mode vs analytic) ==="
  let sd = float_arr_new 1 0.0
  -- p at 0.5: p' = sin 1.0 = 0.8414709848
  let gp = float_arr_new 1 0.0
  let _ = p__rgrad 0.5 gp
  let pa = float_arr_get gp 0
  let _ = float_arr_set sd 0 (p__grad 0.5 0)
  let c1 = fnear pa (float_arr_get sd 0)
  let c2 = fnear pa 0.8414709848
  -- ef at 1.0: ef' = exp 1.0 = 2.7182818285
  let ge = float_arr_new 1 0.0
  let _ = ef__rgrad 1.0 ge
  let ea = float_arr_get ge 0
  let _ = float_arr_set sd 0 (ef__grad 1.0 0)
  let c3 = fnear ea (float_arr_get sd 0)
  let c4 = fnear ea 2.7182818285
  -- q at (2.0, 0.5): ab=1.0; da = 0.5 cos1 = 0.2701511529, db = 2.0 cos1 = 1.0806046117
  let gq = float_arr_new 2 0.0
  let _ = q__rgrad 2.0 0.5 gq
  let qa = float_arr_get gq 0
  let qb = float_arr_get gq 1
  let _ = float_arr_set sd 0 (q__grad 2.0 0.5 0)
  let c5 = fnear qa (float_arr_get sd 0)
  let c6 = fnear qa 0.2701511529
  let _ = float_arr_set sd 0 (q__grad 2.0 0.5 1)
  let c7 = fnear qb (float_arr_get sd 0)
  let c8 = fnear qb 1.0806046117
  -- r at 0.5: r' = sin 1.0 = 0.8414709848 (same gradient as p, but through a let)
  let gr = float_arr_new 1 0.0
  let _ = r__rgrad 0.5 gr
  let ra = float_arr_get gr 0
  let _ = float_arr_set sd 0 (r__grad 0.5 0)
  let c9 = fnear ra (float_arr_get sd 0)
  let c10 = fnear ra 0.8414709848
  -- s at 0.5: s' = cos 0.5 - sin 0.5 = 0.3981570233
  let gs = float_arr_new 1 0.0
  let _ = s__rgrad 0.5 gs
  let ssa = float_arr_get gs 0
  let _ = float_arr_set sd 0 (s__grad 0.5 0)
  let c11 = fnear ssa (float_arr_get sd 0)
  let c12 = fnear ssa 0.3981570233
  -- tf at 0.5: tf' = 1 - tanh^2 0.5 = 0.7864477566
  let gt = float_arr_new 1 0.0
  let _ = tf__rgrad 0.5 gt
  let ta = float_arr_get gt 0
  let _ = float_arr_set sd 0 (tf__grad 0.5 0)
  let c13 = fnear ta (float_arr_get sd 0)
  let c14 = fnear ta 0.7864477566
  -- qf at 4.0: qf' = 1/(2*2) = 0.25
  let gqf = float_arr_new 1 0.0
  let _ = qf__rgrad 4.0 gqf
  let qfa = float_arr_get gqf 0
  let _ = float_arr_set sd 0 (qf__grad 4.0 0)
  let c15 = fnear qfa (float_arr_get sd 0)
  let c16 = fnear qfa 0.25
  -- lf at 2.0: lf' = 1/2 = 0.5
  let glf = float_arr_new 1 0.0
  let _ = lf__rgrad 2.0 glf
  let lfa = float_arr_get glf 0
  let _ = float_arr_set sd 0 (lf__grad 2.0 0)
  let c17 = fnear lfa (float_arr_get sd 0)
  let c18 = fnear lfa 0.5
  -- lm at (0.0, 3.0): da = 3 exp0 = 3.0, db = exp0 = 1.0
  let glm = float_arr_new 2 0.0
  let _ = lm__rgrad 0.0 3.0 glm
  let lma = float_arr_get glm 0
  let lmb = float_arr_get glm 1
  let _ = float_arr_set sd 0 (lm__grad 0.0 3.0 0)
  let c19 = fnear lma (float_arr_get sd 0)
  let c20 = fnear lma 3.0
  let _ = float_arr_set sd 0 (lm__grad 0.0 3.0 1)
  let c21 = fnear lmb (float_arr_get sd 0)
  let c22 = fnear lmb 1.0
  let total = c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19 + c20 + c21 + c22
  let _ = print (cat [show total, "/22 reverse-trans-oracle checks passed"])
  if total == 22 then 0 else 1
