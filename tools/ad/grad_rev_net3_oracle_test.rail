-- V5 slice 5b gate oracle: SYNTHESIZED whole-net reverse-mode AD at DEPTH 3.
-- A #grad-marked three-layer net  L = sum( sq( W3 . sq( W2 . sq( W1 . x ) ) ) )
-- makes compile.rail synthesize  net__rgrad W1 W2 W3 x __gy __wrt  returning:
--   __wrt=0 -> dL/dW1   __wrt=1 -> dL/dW2   __wrt=2 -> dL/dW3   __wrt=3 -> dL/dx
-- Non-square layers (W1 is 3x2, W2 is 2x3, W3 is 2x2) exercise the general-depth
-- spine walker on varying dims. Every synthesized gradient component is cross-checked
-- against central finite differences of the actual forward primal net -- the
-- load-bearing falsification of the depth-L synthesizer.
-- Run: ./rail_native run tools/ad/grad_rev_net3_oracle_test.rail

import "stdlib/float_arr.rail"

#grad sq
sq z = z *. z

#grad net
net W1 W2 W3 x =
  let h1 = float_arr_map sq (float_mat_vec W1 x)
  let h2 = float_arr_map sq (float_mat_vec W2 h1)
  let y  = float_arr_map sq (float_mat_vec W3 h2)
  float_arr_sum y

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. (0.005 +. (0.01 *. (fabs1 b))) then 1 else 0

fd_w1 W1 W2 W3 x idx =
  let h = 0.0001
  let orig = float_arr_get W1 idx
  let _ = float_arr_set W1 idx (orig +. h)
  let fp = net W1 W2 W3 x
  let _ = float_arr_set W1 idx (orig -. h)
  let fm = net W1 W2 W3 x
  let _ = float_arr_set W1 idx orig
  (fp -. fm) /. (2.0 *. h)

fd_w2 W1 W2 W3 x idx =
  let h = 0.0001
  let orig = float_arr_get W2 idx
  let _ = float_arr_set W2 idx (orig +. h)
  let fp = net W1 W2 W3 x
  let _ = float_arr_set W2 idx (orig -. h)
  let fm = net W1 W2 W3 x
  let _ = float_arr_set W2 idx orig
  (fp -. fm) /. (2.0 *. h)

fd_w3 W1 W2 W3 x idx =
  let h = 0.0001
  let orig = float_arr_get W3 idx
  let _ = float_arr_set W3 idx (orig +. h)
  let fp = net W1 W2 W3 x
  let _ = float_arr_set W3 idx (orig -. h)
  let fm = net W1 W2 W3 x
  let _ = float_arr_set W3 idx orig
  (fp -. fm) /. (2.0 *. h)

fd_x W1 W2 W3 x idx =
  let h = 0.0001
  let orig = float_arr_get x idx
  let _ = float_arr_set x idx (orig +. h)
  let fp = net W1 W2 W3 x
  let _ = float_arr_set x idx (orig -. h)
  let fm = net W1 W2 W3 x
  let _ = float_arr_set x idx orig
  (fp -. fm) /. (2.0 *. h)

mkW1 =
  let W = float_arr_new 6 0.0
  let _ = float_arr_set W 0 0.5
  let _ = float_arr_set W 1 0.2
  let _ = float_arr_set W 2 (0.0 -. 0.1)
  let _ = float_arr_set W 3 0.4
  let _ = float_arr_set W 4 0.3
  let _ = float_arr_set W 5 (0.0 -. 0.2)
  W

mkW2 =
  let W = float_arr_new 6 0.0
  let _ = float_arr_set W 0 0.4
  let _ = float_arr_set W 1 (0.0 -. 0.1)
  let _ = float_arr_set W 2 0.2
  let _ = float_arr_set W 3 0.1
  let _ = float_arr_set W 4 0.3
  let _ = float_arr_set W 5 (0.0 -. 0.2)
  W

mkW3 =
  let W = float_arr_new 4 0.0
  let _ = float_arr_set W 0 0.3
  let _ = float_arr_set W 1 0.2
  let _ = float_arr_set W 2 (0.0 -. 0.1)
  let _ = float_arr_set W 3 0.4
  W

mkX =
  let x = float_arr_new 2 0.0
  let _ = float_arr_set x 0 0.5
  let _ = float_arr_set x 1 (0.0 -. 0.3)
  x

chk_arr g fd W1 W2 W3 x n i acc =
  if i >= n then acc
  else
    let gi = float_arr_get g i
    let fi = fd W1 W2 W3 x i
    chk_arr g fd W1 W2 W3 x n (i + 1) (acc + (fnear gi fi))

main =
  let _ = print "=== P3 V5-s5b GATE: synthesized DEPTH-3 net__rgrad (vs finite-diff, non-square) ==="
  let W1 = mkW1
  let W2 = mkW2
  let W3 = mkW3
  let x = mkX
  let gW1 = net__rgrad W1 W2 W3 x 1.0 0
  let gW2 = net__rgrad W1 W2 W3 x 1.0 1
  let gW3 = net__rgrad W1 W2 W3 x 1.0 2
  let gX  = net__rgrad W1 W2 W3 x 1.0 3
  let c1 = chk_arr gW1 fd_w1 W1 W2 W3 x 6 0 0
  let c2 = chk_arr gW2 fd_w2 W1 W2 W3 x 6 0 0
  let c3 = chk_arr gW3 fd_w3 W1 W2 W3 x 4 0 0
  let cx = chk_arr gX  fd_x  W1 W2 W3 x 2 0 0
  let total = c1 + c2 + c3 + cx
  let _ = print (cat [show c1, "/6 dW1  ", show c2, "/6 dW2  ", show c3, "/4 dW3  ", show cx, "/2 dx"])
  let _ = print (cat [show total, "/18 synthesized depth-3 reverse-mode checks passed"])
  if total == 18 then 0 else 1
