-- C4.1 reverse-mode-through-let differential oracle. C4.0 proved reverse-mode on flat
-- rational bodies; C4.1 threads the single backward sweep through a let-SPINE, where a
-- `let v = e` names a SHARED DAG node. The synthesized f__rgrad re-emits the forward
-- primals, then walks the bindings in reverse, materializing each intermediate adjoint
-- (__radj_v) as one let -- so a subexpression used twice is differentiated once.
--
-- Each reverse gradient component is cross-checked against TWO independent witnesses:
--   1. forward-mode f__grad .. i  (the C3 let-differentiator -- a different code path,
--      read through a tag-safe float_arr scratch as in the C3/C4.0 oracles)
--   2. a hand-derived closed-form analytic gradient (no primal call at all)
-- Reverse and forward produce DIFFERENT-but-equal symbolic expressions, so agreement is
-- to tolerance (fnear), not bit-identity. 26 checks total.
--
-- Run from the repo root: ./rail_native run tools/ad/grad_rev_let_oracle_test.rail

-- f = (ab+a)(ab):  da = 2ab^2 + 2ab,  db = 2a^2 b + a^2
#grad f
f a b =
  let x = a *. b
  let y = x +. a
  y *. x

-- g = (a+b)^2 with p SHARED twice (the DAG payoff):  da = db = 2(a+b)
#grad g
g a b =
  let p = a +. b
  p *. p

-- h = (a+b)/(a-b):  da = -2b/(a-b)^2,  db = 2a/(a-b)^2
#grad h
h a b =
  let s = a +. b
  let d = a -. b
  s /. d

-- k = (ab+c)(ab):  da = 2ab^2 + bc,  db = 2a^2 b + ac,  dc = ab
#grad k
k a b c =
  let u = a *. b
  let v = u +. c
  v *. u

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. 0.001 then 1 else 0

main =
  let _ = print "=== P3 C4.1: reverse-mode-through-let oracle (rgrad vs forward-mode vs analytic) ==="
  let sd = float_arr_new 1 0.0
  -- f at (3,2): da=36, db=45 -- and at (1,4): da=40, db=9
  let gf1 = float_arr_new 2 0.0
  let _ = f__rgrad 3.0 2.0 gf1
  let f1a = float_arr_get gf1 0
  let f1b = float_arr_get gf1 1
  let _ = float_arr_set sd 0 (f__grad 3.0 2.0 0)
  let c1 = fnear f1a (float_arr_get sd 0)
  let c2 = fnear f1a 36.0
  let _ = float_arr_set sd 0 (f__grad 3.0 2.0 1)
  let c3 = fnear f1b (float_arr_get sd 0)
  let c4 = fnear f1b 45.0
  let gf2 = float_arr_new 2 0.0
  let _ = f__rgrad 1.0 4.0 gf2
  let f2a = float_arr_get gf2 0
  let f2b = float_arr_get gf2 1
  let _ = float_arr_set sd 0 (f__grad 1.0 4.0 0)
  let c5 = fnear f2a (float_arr_get sd 0)
  let c6 = fnear f2a 40.0
  let _ = float_arr_set sd 0 (f__grad 1.0 4.0 1)
  let c7 = fnear f2b (float_arr_get sd 0)
  let c8 = fnear f2b 9.0
  -- g at (3,2): da=db=10 (shared intermediate)
  let gg = float_arr_new 2 0.0
  let _ = g__rgrad 3.0 2.0 gg
  let gga = float_arr_get gg 0
  let ggb = float_arr_get gg 1
  let _ = float_arr_set sd 0 (g__grad 3.0 2.0 0)
  let c9 = fnear gga (float_arr_get sd 0)
  let c10 = fnear gga 10.0
  let _ = float_arr_set sd 0 (g__grad 3.0 2.0 1)
  let c11 = fnear ggb (float_arr_get sd 0)
  let c12 = fnear ggb 10.0
  -- h at (3,2): da=-4, db=6 -- and at (5,1): da=-0.125, db=0.625
  let gh1 = float_arr_new 2 0.0
  let _ = h__rgrad 3.0 2.0 gh1
  let h1a = float_arr_get gh1 0
  let h1b = float_arr_get gh1 1
  let _ = float_arr_set sd 0 (h__grad 3.0 2.0 0)
  let c13 = fnear h1a (float_arr_get sd 0)
  let c14 = fnear h1a (0.0 -. 4.0)
  let _ = float_arr_set sd 0 (h__grad 3.0 2.0 1)
  let c15 = fnear h1b (float_arr_get sd 0)
  let c16 = fnear h1b 6.0
  let gh2 = float_arr_new 2 0.0
  let _ = h__rgrad 5.0 1.0 gh2
  let h2a = float_arr_get gh2 0
  let h2b = float_arr_get gh2 1
  let _ = float_arr_set sd 0 (h__grad 5.0 1.0 0)
  let c17 = fnear h2a (float_arr_get sd 0)
  let c18 = fnear h2a (0.0 -. 0.125)
  let _ = float_arr_set sd 0 (h__grad 5.0 1.0 1)
  let c19 = fnear h2b (float_arr_get sd 0)
  let c20 = fnear h2b 0.625
  -- k at (1,2,3): da=14, db=7, dc=2
  let gk = float_arr_new 3 0.0
  let _ = k__rgrad 1.0 2.0 3.0 gk
  let ka = float_arr_get gk 0
  let kb = float_arr_get gk 1
  let kc = float_arr_get gk 2
  let _ = float_arr_set sd 0 (k__grad 1.0 2.0 3.0 0)
  let c21 = fnear ka (float_arr_get sd 0)
  let c22 = fnear ka 14.0
  let _ = float_arr_set sd 0 (k__grad 1.0 2.0 3.0 1)
  let c23 = fnear kb (float_arr_get sd 0)
  let c24 = fnear kb 7.0
  let _ = float_arr_set sd 0 (k__grad 1.0 2.0 3.0 2)
  let c25 = fnear kc (float_arr_get sd 0)
  let c26 = fnear kc 2.0
  let total = c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19 + c20 + c21 + c22 + c23 + c24 + c25 + c26
  let _ = print (cat [show total, "/26 reverse-let-oracle checks passed"])
  if total == 26 then 0 else 1
