-- C4.0 reverse-mode differential oracle. For each flat multi-input #grad fn, the
-- synthesized reverse-mode f__rgrad (one backward sweep, write-into-out float_arr) is
-- cross-checked against TWO independent witnesses at several points:
--   1. forward-mode f__grad .. i  (the C0-C3 differentiator -- a different code path)
--   2. numeric central finite-difference of the primal fn itself
-- Every component of every gradient must agree with both. 22 checks total.
--
-- The finite-difference primal evals are routed through a tag-safe scratch
-- float_arr (sd). This dodges a PRE-EXISTING, C4-independent compiler bug: a fn
-- whose body ends in a bare float param (fb = (x/.y) -. y) does not get the
-- __fret_ float-return marker, so (fb hi) -. (fb lo) reinterprets the raw double
-- bits as a tagged int -> garbage. float_arr_set's value slot + float_arr_get are
-- unconditionally float, so storing then reading the primal evals is bit-safe.

#grad fa
fa x y = (x *. y) +. (3.0 *. x)

#grad fb
fb x y = (x /. y) -. y

#grad fc
fc x y z = ((x *. y) *. z) +. (x *. x)

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. 0.001 then 1 else 0

main =
  let sd = float_arr_new 2 0.0
  -- fa at (2,5): df/dx = y+3 = 8, df/dy = x = 2
  let ga1 = float_arr_new 2 0.0
  let _ = fa__rgrad 2.0 5.0 ga1
  let ra1x = float_arr_get ga1 0
  let ra1y = float_arr_get ga1 1
  let c1 = fnear ra1x (fa__grad 2.0 5.0 0)
  let c2 = fnear ra1y (fa__grad 2.0 5.0 1)
  let _ = float_arr_set sd 0 (fa 2.001 5.0)
  let _ = float_arr_set sd 1 (fa 1.999 5.0)
  let c3 = fnear ra1x (((float_arr_get sd 0) -. (float_arr_get sd 1)) /. 0.002)
  let _ = float_arr_set sd 0 (fa 2.0 5.001)
  let _ = float_arr_set sd 1 (fa 2.0 4.999)
  let c4 = fnear ra1y (((float_arr_get sd 0) -. (float_arr_get sd 1)) /. 0.002)
  -- fa at (1,1): df/dx = 4, df/dy = 1
  let ga2 = float_arr_new 2 0.0
  let _ = fa__rgrad 1.0 1.0 ga2
  let ra2x = float_arr_get ga2 0
  let ra2y = float_arr_get ga2 1
  let c5 = fnear ra2x (fa__grad 1.0 1.0 0)
  let c6 = fnear ra2y (fa__grad 1.0 1.0 1)
  let _ = float_arr_set sd 0 (fa 1.001 1.0)
  let _ = float_arr_set sd 1 (fa 0.999 1.0)
  let c7 = fnear ra2x (((float_arr_get sd 0) -. (float_arr_get sd 1)) /. 0.002)
  let _ = float_arr_set sd 0 (fa 1.0 1.001)
  let _ = float_arr_set sd 1 (fa 1.0 0.999)
  let c8 = fnear ra2y (((float_arr_get sd 0) -. (float_arr_get sd 1)) /. 0.002)
  -- fb at (2,5): df/dx = 1/y = 0.2, df/dy = -x/y^2 - 1 = -1.08
  let gb1 = float_arr_new 2 0.0
  let _ = fb__rgrad 2.0 5.0 gb1
  let rb1x = float_arr_get gb1 0
  let rb1y = float_arr_get gb1 1
  let c9 = fnear rb1x (fb__grad 2.0 5.0 0)
  let c10 = fnear rb1y (fb__grad 2.0 5.0 1)
  let _ = float_arr_set sd 0 (fb 2.001 5.0)
  let _ = float_arr_set sd 1 (fb 1.999 5.0)
  let c11 = fnear rb1x (((float_arr_get sd 0) -. (float_arr_get sd 1)) /. 0.002)
  let _ = float_arr_set sd 0 (fb 2.0 5.001)
  let _ = float_arr_set sd 1 (fb 2.0 4.999)
  let c12 = fnear rb1y (((float_arr_get sd 0) -. (float_arr_get sd 1)) /. 0.002)
  -- fb at (3,2): df/dx = 0.5, df/dy = -0.75 - 1 = -1.75
  let gb2 = float_arr_new 2 0.0
  let _ = fb__rgrad 3.0 2.0 gb2
  let rb2x = float_arr_get gb2 0
  let rb2y = float_arr_get gb2 1
  let c13 = fnear rb2x (fb__grad 3.0 2.0 0)
  let c14 = fnear rb2y (fb__grad 3.0 2.0 1)
  let _ = float_arr_set sd 0 (fb 3.001 2.0)
  let _ = float_arr_set sd 1 (fb 2.999 2.0)
  let c15 = fnear rb2x (((float_arr_get sd 0) -. (float_arr_get sd 1)) /. 0.002)
  let _ = float_arr_set sd 0 (fb 3.0 2.001)
  let _ = float_arr_set sd 1 (fb 3.0 1.999)
  let c16 = fnear rb2y (((float_arr_get sd 0) -. (float_arr_get sd 1)) /. 0.002)
  -- fc at (1,2,3): df/dx = y*z+2x = 8, df/dy = x*z = 3, df/dz = x*y = 2
  let gc1 = float_arr_new 3 0.0
  let _ = fc__rgrad 1.0 2.0 3.0 gc1
  let rc0 = float_arr_get gc1 0
  let rc1 = float_arr_get gc1 1
  let rc2 = float_arr_get gc1 2
  let c17 = fnear rc0 (fc__grad 1.0 2.0 3.0 0)
  let c18 = fnear rc1 (fc__grad 1.0 2.0 3.0 1)
  let c19 = fnear rc2 (fc__grad 1.0 2.0 3.0 2)
  let _ = float_arr_set sd 0 (fc 1.001 2.0 3.0)
  let _ = float_arr_set sd 1 (fc 0.999 2.0 3.0)
  let c20 = fnear rc0 (((float_arr_get sd 0) -. (float_arr_get sd 1)) /. 0.002)
  let _ = float_arr_set sd 0 (fc 1.0 2.001 3.0)
  let _ = float_arr_set sd 1 (fc 1.0 1.999 3.0)
  let c21 = fnear rc1 (((float_arr_get sd 0) -. (float_arr_get sd 1)) /. 0.002)
  let _ = float_arr_set sd 0 (fc 1.0 2.0 3.001)
  let _ = float_arr_set sd 1 (fc 1.0 2.0 2.999)
  let c22 = fnear rc2 (((float_arr_get sd 0) -. (float_arr_get sd 1)) /. 0.002)
  let total = c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19 + c20 + c21 + c22
  let _ = print (cat [show total, "/22 reverse-oracle checks passed"])
  if total == 22 then 0 else 1
