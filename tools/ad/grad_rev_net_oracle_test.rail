-- V5 slice 5a gate oracle: SYNTHESIZED whole-net reverse-mode AD.
-- A #grad-marked two-layer net  L = sum( sq( W2 . sq( W1 . x ) ) )  makes
-- compile.rail synthesize  net__rgrad W1 W2 x __gy __wrt  returning:
--   __wrt=0 -> dL/dW1 (len out1*n)   __wrt=1 -> dL/dW2 (len out2*out1)
--   __wrt=2 -> dL/dx  (len n)
-- Each synthesized component is cross-checked TWO ways:
--   1. hand-derived analytic gradient (closed form, no primal call)
--   2. central finite differences of the actual forward primal net
-- This is the V5-s5 gate: it falsifies the synthesizer, not a hand-written kernel.
-- Run: ./rail_native run tools/ad/grad_rev_net_oracle_test.rail

import "stdlib/float_arr.rail"

#grad sq
sq z = z *. z

-- forward 2-layer net: the shape detect_layer_chain recognizes (slice 5a).
#grad net
net W1 W2 x =
  let h1 = float_arr_map sq (float_mat_vec W1 x)
  let y  = float_arr_map sq (float_mat_vec W2 h1)
  float_arr_sum y

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. (0.01 +. (0.005 *. (fabs1 b))) then 1 else 0

fd_w1 W1 W2 x idx =
  let h = 0.0001
  let orig = float_arr_get W1 idx
  let _ = float_arr_set W1 idx (orig +. h)
  let fp = net W1 W2 x
  let _ = float_arr_set W1 idx (orig -. h)
  let fm = net W1 W2 x
  let _ = float_arr_set W1 idx orig
  (fp -. fm) /. (2.0 *. h)

fd_w2 W1 W2 x idx =
  let h = 0.0001
  let orig = float_arr_get W2 idx
  let _ = float_arr_set W2 idx (orig +. h)
  let fp = net W1 W2 x
  let _ = float_arr_set W2 idx (orig -. h)
  let fm = net W1 W2 x
  let _ = float_arr_set W2 idx orig
  (fp -. fm) /. (2.0 *. h)

fd_x W1 W2 x idx =
  let h = 0.0001
  let orig = float_arr_get x idx
  let _ = float_arr_set x idx (orig +. h)
  let fp = net W1 W2 x
  let _ = float_arr_set x idx (orig -. h)
  let fm = net W1 W2 x
  let _ = float_arr_set x idx orig
  (fp -. fm) /. (2.0 *. h)

mkW1 =
  let W = float_arr_new 4 0.0
  let _ = float_arr_set W 0 1.0
  let _ = float_arr_set W 1 2.0
  let _ = float_arr_set W 2 0.0
  let _ = float_arr_set W 3 1.0
  W

mkW2 =
  let W = float_arr_new 4 0.0
  let _ = float_arr_set W 0 1.0
  let _ = float_arr_set W 1 (0.0 -. 1.0)
  let _ = float_arr_set W 2 0.5
  let _ = float_arr_set W 3 1.0
  W

mkX =
  let x = float_arr_new 2 0.0
  let _ = float_arr_set x 0 0.5
  let _ = float_arr_set x 1 (0.0 -. 1.0)
  x

main =
  let _ = print "=== P3 V5-s5a GATE: synthesized net__rgrad (vs analytic vs finite-diff) ==="
  let W1 = mkW1
  let W2 = mkW2
  let x = mkX
  -- dL/dW1 (__wrt=0), analytic [-6.9375, 13.875, -1.75, 3.5]
  let gW1 = net__rgrad W1 W2 x 1.0 0
  let p0 = float_arr_get gW1 0
  let p1 = float_arr_get gW1 1
  let p2 = float_arr_get gW1 2
  let p3 = float_arr_get gW1 3
  let a0 = fnear p0 (0.0 -. 6.9375)
  let a1 = fnear p1 13.875
  let a2 = fnear p2 (0.0 -. 1.75)
  let a3 = fnear p3 3.5
  let b0 = fnear p0 (fd_w1 W1 W2 x 0)
  let b1 = fnear p1 (fd_w1 W1 W2 x 1)
  let b2 = fnear p2 (fd_w1 W1 W2 x 2)
  let b3 = fnear p3 (fd_w1 W1 W2 x 3)
  -- dL/dW2 (__wrt=1), analytic [5.625, 2.5, 9.5625, 4.25]
  let gW2 = net__rgrad W1 W2 x 1.0 1
  let q0 = float_arr_get gW2 0
  let q1 = float_arr_get gW2 1
  let q2 = float_arr_get gW2 2
  let q3 = float_arr_get gW2 3
  let c0 = fnear q0 5.625
  let c1 = fnear q1 2.5
  let c2 = fnear q2 9.5625
  let c3 = fnear q3 4.25
  let d0 = fnear q0 (fd_w2 W1 W2 x 0)
  let d1 = fnear q1 (fd_w2 W1 W2 x 1)
  let d2 = fnear q2 (fd_w2 W1 W2 x 2)
  let d3 = fnear q3 (fd_w2 W1 W2 x 3)
  -- dL/dx (__wrt=2), analytic [-13.875, -31.25]
  let gX = net__rgrad W1 W2 x 1.0 2
  let r0 = float_arr_get gX 0
  let r1 = float_arr_get gX 1
  let e0 = fnear r0 (0.0 -. 13.875)
  let e1 = fnear r1 (0.0 -. 31.25)
  let f0 = fnear r0 (fd_x W1 W2 x 0)
  let f1 = fnear r1 (fd_x W1 W2 x 1)
  let total = a0+a1+a2+a3 + b0+b1+b2+b3 + c0+c1+c2+c3 + d0+d1+d2+d3 + e0+e1 + f0+f1
  let _ = print (cat [show total, "/20 synthesized whole-net reverse-mode checks passed"])
  if total == 20 then 0 else 1
