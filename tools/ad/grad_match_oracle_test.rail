-- C5.2 AD-through-match differential oracle. C5.0/C5.1 taught forward/reverse mode to
-- differentiate if-expressions piecewise; C5.2 does the same for `match`, the n-way analog.
-- Before C5.2 both modes punted the "M" AST node to 0.0 -- a silent miscompile (forward) and
-- an undefined f__rgrad symbol (reverse). C5.2: the scrutinee is a discriminant (int/str/ADT)
-- that selects one arm -- primal-only, emitted verbatim -- and each arm body is differentiated.
-- Forward: d(match s with Pi -> bi) = match s with Pi -> d(bi). Reverse: the cotangent ct
-- reaches arm i only when s selects arm i, so it is guarded per-arm by the same discriminant
-- (the n-way mirror of the "?" guarded-cotangent split). Only NON-BINDING discriminant arms
-- are differentiated (nullary ADT ctor / int|str literal / "_"); a payload-binding or guarded
-- arm falls back (forward -> 0.0, reverse -> forward-only), never a wrong nonzero gradient.
--
-- Each reverse gradient component is cross-checked against TWO independent witnesses:
--   1. forward-mode f__grad .. i  (the C5.2 differentiator -- a DIFFERENT code path)
--   2. a hand-derived closed-form analytic gradient (the step / sign / slope)
-- The forward/reverse cross-check is the load-bearing invariant: f__rgrad[i] == f__grad..i.
-- 33 checks total. Run from the repo root:
--   ./rail_native run tools/ad/grad_match_oracle_test.rail

-- int-discriminant: am = absf via a 3-way int-literal match.  d/dx = +1 (x>0) / -1 (x<0) / 0
sgn3 x = if x >. 0.0 then 1 else (if x <. 0.0 then 0 else 2)
#grad am
am x = match sgn3 x
  | 1 -> x
  | 0 -> 0.0 -. x
  | _ -> 0.0

-- ADT-discriminant: the same absf via a 3-way nullary-constructor match (uppercase ctors,
-- no binds) -- exercises the safe-ctor gate for real ADT tags, not just literals.
type Sgn = | SPos | SNeg | SZero
classify x = if x >. 0.0 then SPos else (if x <. 0.0 then SNeg else SZero)
#grad amc
amc x = match classify x
  | SPos -> x
  | SNeg -> 0.0 -. x
  | SZero -> 0.0

-- int-discriminant quadratic piece: qm = x^2 (x>0) else x.  d/dx = 2x (x>0) / 1 (x<=0).
-- The "_" wildcard arm carries a nonconstant body, so the active branch matters in both modes.
#grad qm
qm x = match sgn3 x
  | 1 -> x *. x
  | _ -> x

-- multi-input: gm a b = a^2 if a>b else b^2.  da = 2a (a>b) / 0 ;  db = 0 / 2b (a<=b).
-- The reverse sweep must guard EACH param's adjoint by the same discriminant, in ONE rgrad call.
cmp2 a b = if a >. b then 1 else 0
#grad gm
gm a b = match cmp2 a b
  | 1 -> a *. a
  | _ -> b *. b

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. 0.001 then 1 else 0

main =
  let _ = print "=== P3 C5.2: AD-through-match oracle (f__grad/f__rgrad vs analytic) ==="
  let sd = float_arr_new 1 0.0
  let gr = float_arr_new 1 0.0
  let gg = float_arr_new 2 0.0
  -- am at 2.0 (sgn3=1, active branch x): grad = 1.0
  let _ = float_arr_set sd 0 (am__grad 2.0 0)
  let c1 = fnear (float_arr_get sd 0) 1.0
  let _ = am__rgrad 2.0 gr
  let r2 = float_arr_get gr 0
  let c2 = fnear r2 (float_arr_get sd 0)
  let c3 = fnear r2 1.0
  -- am at -3.0 (sgn3=0, active branch -x): grad = -1.0  (the sign flip)
  let _ = float_arr_set sd 0 (am__grad (0.0 -. 3.0) 0)
  let c4 = fnear (float_arr_get sd 0) (0.0 -. 1.0)
  let _ = am__rgrad (0.0 -. 3.0) gr
  let rm3 = float_arr_get gr 0
  let c5 = fnear rm3 (float_arr_get sd 0)
  let c6 = fnear rm3 (0.0 -. 1.0)
  -- amc at 4.0 (classify=SPos, active branch x): grad = 1.0
  let _ = float_arr_set sd 0 (amc__grad 4.0 0)
  let c7 = fnear (float_arr_get sd 0) 1.0
  let _ = amc__rgrad 4.0 gr
  let a4 = float_arr_get gr 0
  let c8 = fnear a4 (float_arr_get sd 0)
  let c9 = fnear a4 1.0
  -- amc at -2.0 (classify=SNeg, active branch -x): grad = -1.0
  let _ = float_arr_set sd 0 (amc__grad (0.0 -. 2.0) 0)
  let c10 = fnear (float_arr_get sd 0) (0.0 -. 1.0)
  let _ = amc__rgrad (0.0 -. 2.0) gr
  let am2 = float_arr_get gr 0
  let c11 = fnear am2 (float_arr_get sd 0)
  let c12 = fnear am2 (0.0 -. 1.0)
  -- amc at 0.0 (classify=SZero, active branch 0.0): grad = 0.0
  let _ = float_arr_set sd 0 (amc__grad 0.0 0)
  let c13 = fnear (float_arr_get sd 0) 0.0
  let _ = amc__rgrad 0.0 gr
  let a0 = float_arr_get gr 0
  let c14 = fnear a0 (float_arr_get sd 0)
  let c15 = fnear a0 0.0
  -- qm at 3.0 (sgn3=1, active branch x^2): grad = 2x = 6.0
  let _ = float_arr_set sd 0 (qm__grad 3.0 0)
  let c16 = fnear (float_arr_get sd 0) 6.0
  let _ = qm__rgrad 3.0 gr
  let q3 = float_arr_get gr 0
  let c17 = fnear q3 (float_arr_get sd 0)
  let c18 = fnear q3 6.0
  -- qm at -1.0 (sgn3=0, active branch x via "_"): grad = 1.0
  let _ = float_arr_set sd 0 (qm__grad (0.0 -. 1.0) 0)
  let c19 = fnear (float_arr_get sd 0) 1.0
  let _ = qm__rgrad (0.0 -. 1.0) gr
  let qm1 = float_arr_get gr 0
  let c20 = fnear qm1 (float_arr_get sd 0)
  let c21 = fnear qm1 1.0
  -- gm at (3,2) (cmp2=1, active branch a^2): da = 2a = 6.0, db = 0.0  (multi-input, ONE rgrad call)
  let _ = float_arr_set sd 0 (gm__grad 3.0 2.0 0)
  let c22 = fnear (float_arr_get sd 0) 6.0
  let _ = gm__rgrad 3.0 2.0 gg
  let gda = float_arr_get gg 0
  let c23 = fnear gda (float_arr_get sd 0)
  let c24 = fnear gda 6.0
  let _ = float_arr_set sd 0 (gm__grad 3.0 2.0 1)
  let c25 = fnear (float_arr_get sd 0) 0.0
  let gdb = float_arr_get gg 1
  let c26 = fnear gdb (float_arr_get sd 0)
  let c27 = fnear gdb 0.0
  -- gm at (1,4) (cmp2=0, active branch b^2 via "_"): da = 0.0, db = 2b = 8.0
  let _ = float_arr_set sd 0 (gm__grad 1.0 4.0 0)
  let c28 = fnear (float_arr_get sd 0) 0.0
  let _ = gm__rgrad 1.0 4.0 gg
  let gda2 = float_arr_get gg 0
  let c29 = fnear gda2 (float_arr_get sd 0)
  let c30 = fnear gda2 0.0
  let _ = float_arr_set sd 0 (gm__grad 1.0 4.0 1)
  let c31 = fnear (float_arr_get sd 0) 8.0
  let gdb2 = float_arr_get gg 1
  let c32 = fnear gdb2 (float_arr_get sd 0)
  let c33 = fnear gdb2 8.0
  let total = c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19 + c20 + c21 + c22 + c23 + c24 + c25 + c26 + c27 + c28 + c29 + c30 + c31 + c32 + c33
  let _ = print (cat [show total, "/33 match-oracle checks passed"])
  if total == 33 then 0 else 1
