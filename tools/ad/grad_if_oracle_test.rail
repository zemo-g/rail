-- C5.0 forward-mode-through-control-flow differential oracle. Forward-mode previously
-- fell through if-expressions (the "?" AST node) to a 0.0 derivative -- a SILENT
-- miscompile: relu, the canonical ML activation, had a gradient that was identically
-- zero, so any net using it would be untrainable. C5.0 differentiates control flow
-- piecewise: the predicate is primal-only (non-differentiable), emitted verbatim, and
-- each branch is differentiated -- d(if c then a else b) = if c then d(a) else d(b).
-- The active branch carries the derivative; the boundary kink is measure-zero.
--
-- Each gradient is cross-checked against TWO independent witnesses:
--   1. a hand-derived closed-form analytic gradient (the step / sign / slope)
--   2. numeric central difference of the PRIMAL (no AD at all), evaluated strictly
--      INSIDE one branch so the function is locally smooth and the difference is exact
-- 22 checks total. Run from the repo root:
--   ./rail_native run tools/ad/grad_if_oracle_test.rail

-- relu x = max(x,0):  relu' = if x>0 then 1 else 0  (the step function)
#grad relu
relu x = if x >. 0.0 then x else 0.0

-- absf x = |x|:  absf' = if x>0 then 1 else -1  (the sign function)
#grad absf
absf x = if x >. 0.0 then x else (0.0 -. x)

-- pw x = if x>1 then x^2 else x:  pw' = if x>1 then 2x else 1  (slope changes branch)
#grad pw
pw x = if x >. 1.0 then x *. x else x

-- g a b = if a>b then a^2 else b^2:  da = if a>b then 2a else 0,  db = if a>b then 0 else 2b
#grad g
g a b = if a >. b then a *. a else b *. b

-- lif x = let t=2x in if t>1 then t else x:  lif' = if 2x>1 then 2 else 1  (if AFTER a let)
#grad lif
lif x =
  let t = x +. x
  if t >. 1.0 then t else x

fabs1 d = if d <. 0.0 then 0.0 -. d else d
fnear a b = if (fabs1 (a -. b)) <. 0.001 then 1 else 0

main =
  let _ = print "=== P3 C5.0: forward-mode-through-control-flow oracle (f__grad vs analytic vs numeric) ==="
  let fwd = float_arr_new 1 0.0
  let nd = float_arr_new 2 0.0
  -- relu at 2.0 (active branch x): grad = 1.0
  let _ = float_arr_set fwd 0 (relu__grad 2.0 0)
  let r2 = float_arr_get fwd 0
  let _ = float_arr_set nd 0 (relu 2.001)
  let _ = float_arr_set nd 1 (relu 1.999)
  let r2n = ((float_arr_get nd 0) -. (float_arr_get nd 1)) /. 0.002
  let c1 = fnear r2 1.0
  let c2 = fnear r2 r2n
  -- relu at -1.0 (active branch 0.0): grad = 0.0
  let _ = float_arr_set fwd 0 (relu__grad (0.0 -. 1.0) 0)
  let c3 = fnear (float_arr_get fwd 0) 0.0
  -- absf at 3.0 (active branch x): grad = 1.0
  let _ = float_arr_set fwd 0 (absf__grad 3.0 0)
  let a3 = float_arr_get fwd 0
  let _ = float_arr_set nd 0 (absf 3.001)
  let _ = float_arr_set nd 1 (absf 2.999)
  let a3n = ((float_arr_get nd 0) -. (float_arr_get nd 1)) /. 0.002
  let c4 = fnear a3 1.0
  let c5 = fnear a3 a3n
  -- absf at -2.0 (active branch -x): grad = -1.0  (the sign flip, numeric-checked)
  let _ = float_arr_set fwd 0 (absf__grad (0.0 -. 2.0) 0)
  let am2 = float_arr_get fwd 0
  let _ = float_arr_set nd 0 (absf (0.0 -. 1.999))
  let _ = float_arr_set nd 1 (absf (0.0 -. 2.001))
  let am2n = ((float_arr_get nd 0) -. (float_arr_get nd 1)) /. 0.002
  let c6 = fnear am2 (0.0 -. 1.0)
  let c7 = fnear am2 am2n
  -- pw at 3.0 (active branch x^2): grad = 2x = 6.0
  let _ = float_arr_set fwd 0 (pw__grad 3.0 0)
  let p3 = float_arr_get fwd 0
  let _ = float_arr_set nd 0 (pw 3.001)
  let _ = float_arr_set nd 1 (pw 2.999)
  let p3n = ((float_arr_get nd 0) -. (float_arr_get nd 1)) /. 0.002
  let c8 = fnear p3 6.0
  let c9 = fnear p3 p3n
  -- pw at 0.5 (active branch x): grad = 1.0
  let _ = float_arr_set fwd 0 (pw__grad 0.5 0)
  let p05 = float_arr_get fwd 0
  let _ = float_arr_set nd 0 (pw 0.501)
  let _ = float_arr_set nd 1 (pw 0.499)
  let p05n = ((float_arr_get nd 0) -. (float_arr_get nd 1)) /. 0.002
  let c10 = fnear p05 1.0
  let c11 = fnear p05 p05n
  -- g at (3,2) (active branch a^2): da = 2a = 6.0, db = 0.0
  let _ = float_arr_set fwd 0 (g__grad 3.0 2.0 0)
  let gda = float_arr_get fwd 0
  let _ = float_arr_set nd 0 (g 3.001 2.0)
  let _ = float_arr_set nd 1 (g 2.999 2.0)
  let gdan = ((float_arr_get nd 0) -. (float_arr_get nd 1)) /. 0.002
  let c12 = fnear gda 6.0
  let c13 = fnear gda gdan
  let _ = float_arr_set fwd 0 (g__grad 3.0 2.0 1)
  let gdb = float_arr_get fwd 0
  let _ = float_arr_set nd 0 (g 3.0 2.001)
  let _ = float_arr_set nd 1 (g 3.0 1.999)
  let gdbn = ((float_arr_get nd 0) -. (float_arr_get nd 1)) /. 0.002
  let c14 = fnear gdb 0.0
  let c15 = fnear gdb gdbn
  -- g at (1,4) (active branch b^2): da = 0.0, db = 2b = 8.0
  let _ = float_arr_set fwd 0 (g__grad 1.0 4.0 0)
  let c16 = fnear (float_arr_get fwd 0) 0.0
  let _ = float_arr_set fwd 0 (g__grad 1.0 4.0 1)
  let gdb2 = float_arr_get fwd 0
  let _ = float_arr_set nd 0 (g 1.0 4.001)
  let _ = float_arr_set nd 1 (g 1.0 3.999)
  let gdb2n = ((float_arr_get nd 0) -. (float_arr_get nd 1)) /. 0.002
  let c17 = fnear gdb2 8.0
  let c18 = fnear gdb2 gdb2n
  -- lif at 2.0 (t=4>1, active branch t): grad = d(2x) = 2.0
  let _ = float_arr_set fwd 0 (lif__grad 2.0 0)
  let l2 = float_arr_get fwd 0
  let _ = float_arr_set nd 0 (lif 2.001)
  let _ = float_arr_set nd 1 (lif 1.999)
  let l2n = ((float_arr_get nd 0) -. (float_arr_get nd 1)) /. 0.002
  let c19 = fnear l2 2.0
  let c20 = fnear l2 l2n
  -- lif at 0.2 (t=0.4<1, active branch x): grad = 1.0
  let _ = float_arr_set fwd 0 (lif__grad 0.2 0)
  let l02 = float_arr_get fwd 0
  let _ = float_arr_set nd 0 (lif 0.201)
  let _ = float_arr_set nd 1 (lif 0.199)
  let l02n = ((float_arr_get nd 0) -. (float_arr_get nd 1)) /. 0.002
  let c21 = fnear l02 1.0
  let c22 = fnear l02 l02n
  let total = c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19 + c20 + c21 + c22
  let _ = print (cat [show total, "/22 control-flow-oracle checks passed"])
  if total == 22 then 0 else 1
