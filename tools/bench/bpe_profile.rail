-- tools/bench/bpe_profile.rail — profile harness for the BPE trainer.
-- Reads a corpus from /tmp/rail_bench_corpus.txt and trains to a given
-- target vocab size. `sample <pid>` on this process reveals the hot
-- loops in bpe_count_pairs_arr / bpe_find_best_key_loop / bpe_apply_merge.
import "stdlib/bpe.rail"

bench_path = "/tmp/rail_bench_corpus.txt"

-- Target vocab baked in at the bottom end of the "it should finish"
-- range. Swap to 4096 for the full-corpus bake-off; 512 is cheap enough
-- to profile in seconds.
target_vocab = 2048

now_ms _ =
  let s = shell "perl -MTime::HiRes -e 'print int(Time::HiRes::time()*1000)'"
  bench_parse_int s

bench_digit_val c =
  if c == "0" then 0
  else if c == "1" then 1
  else if c == "2" then 2
  else if c == "3" then 3
  else if c == "4" then 4
  else if c == "5" then 5
  else if c == "6" then 6
  else if c == "7" then 7
  else if c == "8" then 8
  else if c == "9" then 9
  else (0 - 1)

bench_parse_int_acc cs acc =
  if length cs == 0 then acc
  else
    let d = bench_digit_val (head cs)
    if d < 0 then acc
    else bench_parse_int_acc (tail cs) (acc * 10 + d)

bench_parse_int s = bench_parse_int_acc (chars s) 0

main =
  let text = read_file bench_path
  let n = length (chars text)
  let _ = print (cat ["bpe_profile: corpus=", show n, " target=", show target_vocab])
  let _ = print (cat ["pid: ", shell "echo $PPID"])
  let t0 = now_ms 0
  let bpe = bpe_train text target_vocab
  let t1 = now_ms 0
  let V = bpe_vocab_size bpe
  let _ = print (cat ["trained V=", show V, "  ms=", show (t1 - t0)])
  0
