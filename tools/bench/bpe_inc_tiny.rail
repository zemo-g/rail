-- Tiny test: feed bpe_train a small corpus to surface any semantic bug.
import "stdlib/bpe.rail"

main =
  let corpus = "abcabcabcabcabcabcabcabc"  -- 24 chars, 3 distinct
  let _ = print (cat ["corpus: ", show (length (chars corpus))])
  let bpe = bpe_train corpus 6
  let V = bpe_vocab_size bpe
  let _ = print (cat ["V=", show V])
  let ids = bpe_encode bpe corpus
  let _ = print (cat ["ids=", show (length ids)])
  let back = bpe_decode bpe ids
  let _ = print (cat ["back_len=", show (length (chars back))])
  0
