-- transformer_fused_ops_bench.rail — measure GPU vs CPU wall time for the
-- elementwise ops the lm_v3_chunked transformer hits every step.
-- Run from ~/projects/rail/:
--   ./rail_native tools/bench/transformer_fused_ops_bench.rail
--   DYLD_LIBRARY_PATH=tools/metal /tmp/rail_out
--
-- Shapes match the live training: d=64, seq=512, d_ff=192, V=94.
-- That's what one block actually processes each step.

import "stdlib/transformer.rail"

-- fill an arr deterministically with small values in [-1, 1)
fill_seq arr n i =
  if i >= n then 0
  else
    let v = (int_to_float (i % 13)) * 0.1 - 0.6
    let _ = float_arr_set arr i v
    fill_seq arr n (i + 1)

time_ms_now = shell "perl -MTime::HiRes -e 'printf \"%.0f\", Time::HiRes::time()*1000'"

-- microbench wrappers: run fn iters times, report ms.
rmsnorm_cpu_loop x y g rstd dim n_rows iters i =
  if i >= iters then 0
  else
    let _ = rms_rows_save x y g rstd dim 0.00001 n_rows 0
    rmsnorm_cpu_loop x y g rstd dim n_rows iters (i + 1)

rmsnorm_gpu_loop x y g rstd dim n_rows iters i =
  if i >= iters then 0
  else
    let _ = tgl_rmsnorm_save_f64 x y g rstd dim n_rows
    rmsnorm_gpu_loop x y g rstd dim n_rows iters (i + 1)

rope_cpu_loop x seq d iters i =
  if i >= iters then 0
  else
    let _ = rope_positions x seq d 0 1.0
    rope_cpu_loop x seq d iters (i + 1)

rope_gpu_loop x seq d iters i =
  if i >= iters then 0
  else
    let _ = tgl_rope_apply_f64 x seq d 1.0
    rope_gpu_loop x seq d iters (i + 1)

silu_cpu_loop x y sig n iters i =
  if i >= iters then 0
  else
    let _ = silu_fwd_loop x y sig n 0
    silu_cpu_loop x y sig n iters (i + 1)

silu_gpu_loop x y sig n iters i =
  if i >= iters then 0
  else
    let _ = tgl_silu_fwd_f64 x y sig n
    silu_gpu_loop x y sig n iters (i + 1)

main =
  let _ = print "=== transformer fused-ops bench (training-shape: seq=512, d=64, d_ff=192) ==="

  -- RMSNorm: rows=seq=512, dim=d=64
  let rms_total = 512 * 64
  let xr = float_arr_new rms_total 0.0
  let _  = fill_seq xr rms_total 0
  let yr = float_arr_new rms_total 0.0
  let gr = float_arr_new 64 1.0
  let _  = fill_seq gr 64 7
  let rstd_r = float_arr_new 512 0.0
  let iters_rms = 200
  let _ = print (cat ["\n--- RMSNorm [512, 64], ", show iters_rms, " iters ---"])
  let t0_rms_cpu = time_ms_now
  let _ = rmsnorm_cpu_loop xr yr gr rstd_r 64 512 iters_rms 0
  let t1_rms_cpu = time_ms_now
  let _ = print (cat ["  CPU  start=", t0_rms_cpu, "  end=", t1_rms_cpu])
  let t0_rms_gpu = time_ms_now
  let _ = rmsnorm_gpu_loop xr yr gr rstd_r 64 512 iters_rms 0
  let t1_rms_gpu = time_ms_now
  let _ = print (cat ["  GPU  start=", t0_rms_gpu, "  end=", t1_rms_gpu])

  -- RoPE: in-place on [seq=512, d=64]
  let rope_total = 512 * 64
  let xrp = float_arr_new rope_total 0.0
  let _   = fill_seq xrp rope_total 0
  let iters_rope = 200
  let _ = print (cat ["\n--- RoPE [512, 64], ", show iters_rope, " iters ---"])
  let t0_rp_cpu = time_ms_now
  let _ = rope_cpu_loop xrp 512 64 iters_rope 0
  let t1_rp_cpu = time_ms_now
  let _ = print (cat ["  CPU  start=", t0_rp_cpu, "  end=", t1_rp_cpu])
  let t0_rp_gpu = time_ms_now
  let _ = rope_gpu_loop xrp 512 64 iters_rope 0
  let t1_rp_gpu = time_ms_now
  let _ = print (cat ["  GPU  start=", t0_rp_gpu, "  end=", t1_rp_gpu])

  -- SiLU: elementwise on [seq * d_ff] = [512 * 192] = 98304 elements
  let silu_n = 512 * 192
  let xs = float_arr_new silu_n 0.0
  let _  = fill_seq xs silu_n 0
  let ys = float_arr_new silu_n 0.0
  let sigs = float_arr_new silu_n 0.0
  let iters_silu = 200
  let _ = print (cat ["\n--- SiLU [98304], ", show iters_silu, " iters ---"])
  let t0_s_cpu = time_ms_now
  let _ = silu_cpu_loop xs ys sigs silu_n iters_silu 0
  let t1_s_cpu = time_ms_now
  let _ = print (cat ["  CPU  start=", t0_s_cpu, "  end=", t1_s_cpu])
  let t0_s_gpu = time_ms_now
  let _ = silu_gpu_loop xs ys sigs silu_n iters_silu 0
  let t1_s_gpu = time_ms_now
  let _ = print (cat ["  GPU  start=", t0_s_gpu, "  end=", t1_s_gpu])

  let _ = print "\n=== done ==="
  0
