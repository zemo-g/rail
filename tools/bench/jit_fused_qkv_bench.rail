-- jit_fused_qkv_bench.rail — Phase 1.3 wall-time bench.
-- Compare fused rmsnorm+QKV (one Metal dispatch) vs unfused chain
-- (rmsnorm_save + 3× tgl_matmul_f64 = 4 dispatches) at training shapes.
-- Run from ~/projects/rail/:
--   ./rail_native tools/bench/jit_fused_qkv_bench.rail
--   DYLD_LIBRARY_PATH=tools/metal /tmp/rail_out
import "stdlib/jit.rail"
import "stdlib/transformer.rail"
-- transformer.rail (-> tensor.rail) provides rmsnorm_save / matmul /
-- compute_strides for the unfused comparison loop; the jit chain does
-- not pull tensor itself.

fill_seq arr n i =
  if i >= n then 0
  else
    let v = (int_to_float (i % 13)) * 0.1 - 0.6
    let _ = float_arr_set arr i v
    fill_seq arr n (i + 1)

time_ms = shell "perl -MTime::HiRes -e 'printf \"%.0f\", Time::HiRes::time()*1000'"

-- Unfused: rmsnorm_save + 3× matmul (each is its own Metal dispatch)
unfused_loop x g wq wk wv seq d iters i =
  if i >= iters then 0
  else
    let xT = Tensor x (cons seq (cons d [])) (compute_strides (cons seq (cons d [])))
    let gT = Tensor g (cons d []) (cons 1 [])
    let wqT = Tensor wq (cons d (cons d [])) (compute_strides (cons d (cons d [])))
    let wkT = Tensor wk (cons d (cons d [])) (compute_strides (cons d (cons d [])))
    let wvT = Tensor wv (cons d (cons d [])) (compute_strides (cons d (cons d [])))
    let pack = rmsnorm_save xT gT
    let ln = head pack
    let _ = matmul ln wqT
    let _ = matmul ln wkT
    let _ = matmul ln wvT
    let _ = arena_reset (arena_mark 0)
    unfused_loop x g wq wk wv seq d iters (i + 1)

-- Fused: one JIT'd Metal dispatch
fused_loop kid x g wq wk wv qkv seq d iters i =
  if i >= iters then 0
  else
    let _ = jit_run_rmsnorm_qkv kid x g wq wk wv qkv seq d
    fused_loop kid x g wq wk wv qkv seq d iters (i + 1)

main =
  let _ = print "=== Phase 1.3 — fused rmsnorm+QKV bench ==="
  let seq = 512
  let d = 64
  let iters = 200

  let x = float_arr_new (seq * d) 0.0
  let _ = fill_seq x (seq * d) 0
  let g = float_arr_new d 1.0
  let _ = fill_seq g d 7
  let wq = float_arr_new (d * d) 0.0
  let _ = fill_seq wq (d * d) 13
  let wk = float_arr_new (d * d) 0.0
  let _ = fill_seq wk (d * d) 23
  let wv = float_arr_new (d * d) 0.0
  let _ = fill_seq wv (d * d) 31
  let qkv = float_arr_new (3 * seq * d) 0.0

  let _ = print (cat ["shapes: x=[", show seq, ",", show d, "]  W=[", show d, ",", show d, "]  iters=", show iters])

  let _ = print "[1] JIT compile"
  let kid = jit_compile_rmsnorm_qkv 0
  let _ = print (cat ["    kid=", show kid])

  -- warmup
  let _ = jit_run_rmsnorm_qkv kid x g wq wk wv qkv seq d
  let _ = unfused_loop x g wq wk wv seq d 1 0

  let _ = print "[2] unfused (rmsnorm + 3× matmul = 4 dispatches each iter)"
  let t0u = time_ms
  let _ = unfused_loop x g wq wk wv seq d iters 0
  let t1u = time_ms
  let _ = print (cat ["    start=", t0u, "  end=", t1u])

  let _ = print "[3] fused (1 JIT'd dispatch each iter)"
  let t0f = time_ms
  let _ = fused_loop kid x g wq wk wv qkv seq d iters 0
  let t1f = time_ms
  let _ = print (cat ["    start=", t0f, "  end=", t1f])

  let _ = print "\n=== headline: fused / unfused wall ratio (lower = better for fused) ==="
  let _ = print "(compute by hand: end-start for each)"
  0
