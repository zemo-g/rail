import "stdlib/bpe.rail"

main =
  let full = read_file "stdlib/tensor.rail"
  let corpus = str_sub full 0 10000
  let n = length (chars corpus)
  let _ = print (cat ["corpus=", show n])
  let bpe = bpe_train corpus 512
  let V = bpe_vocab_size bpe
  let _ = print (cat ["V=", show V])
  let ids = bpe_encode bpe corpus
  let _ = print (cat ["ids=", show (length ids)])
  let back = bpe_decode bpe ids
  let ok = back == corpus
  let _ = print (if ok then "roundtrip OK" else "roundtrip FAIL")
  0
