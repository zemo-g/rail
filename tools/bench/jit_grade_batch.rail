-- tools/bench/jit_grade_batch.rail — JIT-first batch grader for substrate hard-bench.
--
-- Usage:
--   ./rail_native run tools/bench/jit_grade_batch.rail <manifest>
--
-- Manifest format:
--   Each line is a single candidate file path. Lines whose first character is
--   '#' are comments. Empty lines ignored.
--
-- The grader processes each candidate:
--   1. Reads candidate source.
--   2. Attempts to lower via the in-tree JIT (jit/grade.rail :: jit_can_lower).
--      If it lowers cleanly, we emit `JIT_PASS:<path>`. The bench's notion of
--      "pass" is `as`+`ld` clean — and `jit_can_lower=1` is a strict subset of
--      that envelope, so this is a sound fast path (any program the JIT
--      lowers MUST parse-and-typecheck, and the JIT subset is conservative
--      relative to Rail's full compile pipeline).
--   3. If the JIT can't lower (most programs above the JIT's int+match+HOF
--      subset), shell out to `./rail_native <path>` for the canonical
--      shell-grade and emit `SHELL_PASS:<path>` or `FAIL:<path>`.
--
-- Output (stdout): one line per candidate, in input order:
--   JIT_PASS:<path>      -- JIT lowered cleanly
--   SHELL_PASS:<path>    -- JIT couldn't lower; rail_native compiled clean
--   FAIL:<path>          -- neither path succeeded
--
-- A trailing summary line:
--   SUMMARY:<jit_pass>,<shell_pass>,<fail>,<total>
--
-- LOWER ERR diagnostics from jit/lower.rail leak to this stdout; the
-- harness filters lines that don't start with JIT_PASS|SHELL_PASS|FAIL|SUMMARY.

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"
import "jit/lower.rail"
import "jit/grade.rail"

-- ============================================================================
-- Per-run unique paths so concurrent batch graders don't collide.
-- The parent PID is the natural disambiguator; if we can't get it, fall back
-- to a fixed-but-rare name and hope the host doesn't have two of us live.
-- ============================================================================

-- `trim` is a phantom builtin (declared but no codegen — see CLAUDE.md).
-- Inline a digit-walking + whitespace-stripper.
is_ws_char c = c == " " || c == "\n" || c == "\t" || c == "\r"

trim_left s =
  let n = length s
  trim_left_loop s 0 n

trim_left_loop s i n =
  if i >= n then ""
  else if is_ws_char (str_sub s i 1) then trim_left_loop s (i + 1) n
  else str_sub s i (n - i)

trim_right s =
  let n = length s
  trim_right_loop s n

trim_right_loop s n =
  if n <= 0 then ""
  else if is_ws_char (str_sub s (n - 1) 1) then trim_right_loop s (n - 1)
  else str_sub s 0 n

my_trim s = trim_right (trim_left s)

pid_str _ = my_trim (shell "echo $$")

-- Build a per-process exit-code probe path.
exit_path _ = cat ["/tmp/jit_grade_batch_exit_", pid_str 0]

-- ============================================================================
-- Shell-grade fallback (full `as`+`ld` cycle).
-- We compile-only (not run) because the bench's compile_check semantics is
-- "exit code of rail_native, which is 0 iff as+ld clean".
-- ============================================================================

shell_compile_ok path =
  let ep = exit_path 0
  let cmd = cat ["./rail_native ", path, " > /dev/null 2>&1; echo $? > ", ep]
  let _ = shell cmd
  let code = my_trim (read_file ep)
  if code == "0" then 1 else 0

-- ============================================================================
-- Manifest parsing.
-- ============================================================================

parse_manifest text =
  let lines = split "\n" text
  filter_non_empty lines

filter_non_empty xs =
  if length xs <= 0 then []
  else
    let h = my_trim (head xs)
    let rest = filter_non_empty (tail xs)
    if length h <= 0 then rest
    else
      let first_char = str_sub h 0 1
      if first_char == "#" then rest
      else cons h rest

-- ============================================================================
-- Soundness guard: the JIT subset overlaps but is NOT a strict subset of the
-- rail_native compile envelope. Specifically, the JIT recognizes a handful
-- of string builtins (str_eq, str_len, str_at) and a list predicate
-- (is_nil) that rail_native does NOT ship as builtins (rail_native uses
-- `==`, `length`, `str_sub`, and ADT-style match). If a candidate uses any
-- of these, `jit_can_lower=1` does NOT imply rail_native exit 0 — we'd
-- mismark it as JIT_PASS when shell-grade actually fails.
--
-- This was caught by tools/bench/test_jit_grade_parity.rail. The guard
-- below refuses the JIT fast path for any source containing one of these
-- tokens; falls through to the shell-grade.
--
-- If the JIT or rail_native gain or lose builtins, update this list AND
-- the parity test.
-- ============================================================================

contains_unsafe_jit_builtin src =
  if str_contains "str_eq" src then 1
  else if str_contains "str_len" src then 1
  else if str_contains "str_at" src then 1
  else if str_contains "is_nil" src then 1
  else 0

-- ============================================================================
-- Per-candidate grading.
-- ============================================================================

grade_one path =
  let src = read_file path
  let unsafe = contains_unsafe_jit_builtin src
  if unsafe == 1 then
    -- Soundness: skip JIT path; shell-grade only.
    let sh = shell_compile_ok path
    if sh == 1 then
      let _ = print (cat ["SHELL_PASS:", path])
      2
    else
      let _ = print (cat ["FAIL:", path])
      0
  else
    let lo = jit_can_lower src
    if lo == 1 then
      let _ = print (cat ["JIT_PASS:", path])
      1
    else
      let sh = shell_compile_ok path
      if sh == 1 then
        let _ = print (cat ["SHELL_PASS:", path])
        2
      else
        let _ = print (cat ["FAIL:", path])
        0

-- ============================================================================
-- Loop with counters.
-- ============================================================================

run_loop paths jp sp fl =
  if length paths <= 0 then [jp, sp, fl]
  else
    let r = grade_one (head paths)
    let new_jp = if r == 1 then jp + 1 else jp
    let new_sp = if r == 2 then sp + 1 else sp
    let new_fl = if r == 0 then fl + 1 else fl
    run_loop (tail paths) new_jp new_sp new_fl

-- ============================================================================
-- Entry: usage `./rail_native run jit_grade_batch.rail <manifest>`.
-- When run via `./rail_native run`, argv at runtime is the compiled binary's
-- own argv: argv[0]=/tmp/rail_out (or whatever prefix), argv[1..]=user args.
-- The script path and `run` keyword are consumed by rail_native, not passed
-- through. So manifest is at argv[1].
-- ============================================================================

usage _ =
  let _ = print "usage: rail_native run jit_grade_batch.rail <manifest>"
  1

main =
  let av = args
  let n = length av
  if n < 2 then usage 0
  else
    let manifest_path = head (tail av)
    let text = read_file manifest_path
    let paths = parse_manifest text
    let counts = run_loop paths 0 0 0
    let jp = head counts
    let sp = head (tail counts)
    let fl = head (tail (tail counts))
    let total = jp + sp + fl
    let _ = print (cat ["SUMMARY:", show jp, ",", show sp, ",", show fl, ",", show total])
    0
