-- substrate_hard_bench.rail — canonical Rail substrate hard-bench prompts.
--
-- 30 prompts across 6 bands (5 each). These are the function-signature-scale
-- comprehension probes that, paired with the 1KB Rail spec v3 and an N=20
-- compile-rerank loop, yielded 30/30 (100%) on 2026-05-09 with naked
-- Qwen-122B as the teacher.
--
-- See:
--   tools/bench/README.md            -- what this bench is, how to reproduce
--   tools/bench/repro_30of30.sh      -- one-line reproduction (auto MLX/Anthropic)
--   tools/bench/repro_anthropic.py   -- Anthropic-API path (no local model)
--   tools/train/spec_in_context_probe_full.py -- canonical MLX-internal path
--   memory:substrate_30_of_30_2026-05-09 -- canonical result documentation
--
-- This file is the public, grep-able snapshot of the bench. Each prompt name
-- is band/name; the actual prompt text is embedded in the Python probes
-- (Python lets us keep the multi-line/escape-heavy prompts readable). For
-- the prompt bodies, see BENCH dict in tools/train/spec_in_context_probe_full.py
-- or tools/bench/repro_anthropic.py.
--
-- `main` here is a sanity smoke: prints the prompt count + each prompt name
-- so partners can `./rail_native run tools/bench/substrate_hard_bench.rail`
-- and see the bench inventory without running the full reproduction.

all_prompts _ = [
  "fund/fact_120",
  "fund/add",
  "fund/square_sum",
  "fund/fib",
  "fund/triangular",
  "io/split_get",
  "io/join_csv",
  "io/second",
  "io/read_cfg",
  "io/first_line",
  "tools/opt",
  "tools/res",
  "tools/state",
  "tools/pair",
  "tools/maybe",
  "comp/expr",
  "comp/op",
  "comp/tok",
  "comp/asm",
  "comp/emit",
  "adv/count_lines",
  "adv/sum_list",
  "adv/reverse_str",
  "adv/doubled",
  "adv/filter_even",
  "comprehend/fact_complete",
  "comprehend/flatten",
  "comprehend/sum15",
  "comprehend/doubled246",
  "comprehend/find_key"
]

print_each xs = if length xs <= 0 then 0
  else let _ = print (head xs)
    print_each (tail xs)

main =
  let names = all_prompts 0
  let _ = print "substrate_hard_bench: 30 prompts across 6 bands (5 each)"
  let _ = print "----"
  let _ = print_each names
  let _ = print "----"
  let _ = print (cat ["count: ", show (length names)])
  0
