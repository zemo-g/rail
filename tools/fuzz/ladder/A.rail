-- Rung A check: bytes_to_str must be linear. 100,000 bytes (values 1..250, never 0x00: a NUL
-- vanishes by design, KNOWN_CASES char_from_int_nul) converted in one call; prints the length
-- and a checksum. The judge bounds the wall clock; the O(N^2) original does not finish in time.
import "stdlib/http_client.rail"

fill buf i n =
  if i >= n then 0
  else
    let _ = byte_set buf i (1 + (i % 250))
    fill buf (i + 1) n

sum_codes cs acc =
  if cs == [] then acc
  else sum_codes (tail cs) ((acc + char_to_int (head cs)) % 65521)

main =
  let n = 100000
  let buf = malloc n
  let _ = fill buf 0 n
  let s = bytes_to_str buf 0 n ""
  let _ = free buf
  let _ = print (show (length (chars s)))
  let _ = print (show (sum_codes (chars s) 0))
  0
