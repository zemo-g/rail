-- diff_fuzz repro: hand-minimized 2026-05-12 (Session B, branch
-- feat/b-diff-fuzz-floats-calls).
--
-- Bug class: cross-function float return inference fails for SELF-recursive
-- float-returning ADT walkers, producing garbage float bits (which are then
-- often dereferenced as a pointer downstream, causing segfaults).
--
-- Expected output: 6.28  (3.14 + 3.14)
-- Actual output:   -2.27820476895308e-48  (random-looking garbage)
--
-- Workaround: wrap every recursive call with `0.0 +` to force float typing.
-- See CLAUDE.md "Cross-function float return inference" limitation and the
-- rail_float_promotion_quirk memory entry.
--
-- This was surfaced during diff_fuzz v1 extension. The grammar's side-
-- interpreter for the float family hits this same bug when it recurses
-- through `evalf`; that's why diff_fuzz uses the `0.0 +` workaround in
-- evalf's body.
--
-- Filed by feat/b-diff-fuzz-floats-calls. Not fixed in this branch.

type Expr =
  | FLit f
  | FAdd l r

evalf e = match e
  | FLit f -> 3.14
  | FAdd l r -> evalf l + evalf r

main =
  let a = FLit 1.0
  let b = FLit 2.0
  let e = FAdd a b
  let v = evalf e
  let _ = print (show_float v)
  0
