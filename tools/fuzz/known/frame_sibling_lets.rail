probe ignored = (length [(let a = 0 in a), (let b = 0 in b), (let c = 0 in c), (let d = 0 in d), (let e = 0 in e)])
probe2 ignored = (length [(let x0 = 0 in 0), ((\x0 -> ((let x1 = 0 in x1) - ((\x1 -> 0) x0))) 0), ((\x0 -> x0) 0), ((\x0 -> ((\x1 -> 0) 0)) 0)])
main =
  let _ = print (show (probe 0))
  let _ = print (show (probe2 0))
  0
