-- A lambda applied where it is written, to a float (2026-09-22, t223). Found by the semantic
-- fuzzer (seeds 1 to 4). Before the fix the first line printed 0 and the second crashed:
-- the bound param held raw float bits that nothing marked as a float.
main =
  let _ = print (show (if ((\x0 -> x0) (65536.0 /. 3.0)) == 21845.333333333332 then 1 else 0))
  let _ = print (show ((\x -> x) 2.5))
  let _ = print (show (head [(\x -> x) 0.75]))
  let p = ((\x -> x) 1.25, 2)
  let (u, v) = p
  let _ = print (show u)
  let _ = print (show (if (\x -> x) 3.0 < 4.0 then 1 else 0))
  0
