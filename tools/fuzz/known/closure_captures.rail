-- Closure captures past the old register ceiling (2026-09-22, t213..t216).
-- Every line was silently wrong before the fix: 21008, 21006, 0, 2003, 1, 7, 54321.
main =
  let a = 1000
  let b = 20000
  let c = 300000
  let d = 4000000
  let e = 50000000
  let f = \p1 p2 p3 -> p1 + p2 + p3 + a + b + c + d + e
  let _ = print (show (f 1 2 3))
  let _ = print (show (head (map (\x -> x + a + b + c) [5])))
  let _ = print (show (length (filter (\x -> x == a + b) [21000, 7])))
  let _ = print (show (fold (\acc x -> acc + x + a + b) 0 [1, 2]))
  let _ = print (show (try (\_ -> a + 1) (\err -> 0)))
  let _ = print (show (try (\_ -> error "x") (\err -> b + 7)))
  let f6 = \u v w x y z -> u + v * 10 + w * 100 + x * 1000 + y * 10000 + z * 100000
  let _ = print (show (f6 1 2 3 4 5 6))
  0
