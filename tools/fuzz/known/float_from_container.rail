fn2 x y = x + y
cmp2 x y = if x < y then 1 else 0
type Box = | B v
unb x = match x
  | B v -> v
main =
  let tp = (1.5, 2.25)
  let (a, b) = tp
  let _ = print (show_float_exact (a + b))
  let _ = print (show_float_exact (a *. b))
  let _ = print (show (if a < b then 1 else 0))
  let _ = print (show_float_exact (fn2 a b))
  let _ = print (show (cmp2 a b))
  let xs = [1.5, 2.25]
  let _ = print (show_float_exact (head xs + head (tail xs)))
  let c = unb (B 1.5)
  let _ = print (show_float_exact (c - 0.25))
  let _ = print (show_float_exact (fn2 (head xs) 1))
  0
