-- A float-returning fn named as a value (2026-09-22, t219). Before the fix the reference
-- was read as a float constant and the closure pointer boxed as a double: bus error.
import "stdlib/float_arr.rail"
dbl x = x *. 2.0
halve x = x /. 2.0
main =
  let a = float_arr_new 3 1.5
  let b = float_arr_map dbl a
  let _ = print (show_float (float_arr_get b 1))
  let c = float_arr_map halve (float_arr_map dbl a)
  let _ = print (show_float (float_arr_get c 0))
  let _ = print (show_float (head (map dbl [0.25, 4.0])))
  0
