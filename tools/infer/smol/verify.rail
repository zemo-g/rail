-- verify.rail <transcript> [<index> <token>]: the verifier. ONE forward pass over the
-- prompt and every claimed token but the last recomputes, for each position, the row
-- the producer's token was chosen from. Because a row's arithmetic does not depend on
-- the pass it rides in (smol_engine.rail), each recomputed row must equal the
-- producer's row bit for bit: same greedy token, same FNV-64 of all 49152 logits.
-- No tolerance anywhere. The optional pair overwrites one claimed token first, to show
-- what a forgery looks like.
import "tools/infer/smol/smol_engine.rail"

arg i = head (drop_n args i)
drop_n xs i = if i <= 0 then xs else drop_n (tail xs) (i - 1)
nth_str xs i = if i <= 0 then head xs else nth_str (tail xs) (i - 1)
set_nth xs i v = if xs == [] then [] else if i == 0 then cons v (tail xs) else cons (head xs) (set_nth (tail xs) (i - 1) v)

-- claims: (token, hash) per generated position. Returns (tokens reproduced, hashes
-- reproduced, first bad index or -1).
zip2 xs ys = if xs == [] then [] else cons (head xs, head ys) (zip2 (tail xs) (tail ys))
check ah claims np i acc =
  if claims == [] then acc
  else
    let (a, h) = ah
    let (tok, hs) = head claims
    let (ntok, nh, first) = acc
    let row = np - 1 + i
    let tok_ok = sm_tok a row == tok
    let hash_ok = sm_hash h row == hs
    let bad = if tok_ok then (if hash_ok then false else true) else true
    let first2 = if first < 0 then (if bad then i else first) else first
    let ntok2 = if tok_ok then ntok + 1 else ntok
    let nh2 = if hash_ok then nh + 1 else nh
    check ah (tail claims) np (i + 1) (ntok2, nh2, first2)

main =
  let lines = split "\n" (read_file (arg 1))
  let prompt = ints (words (nth_str lines 0))
  let claimed = ints (words (nth_str lines 1))
  let hs = words (nth_str lines 2)
  let toks = if length args >= 4 then set_nth claimed (parse_int (arg 2)) (parse_int (arg 3)) else claimed
  let np = length prompt
  let n = length toks
  let seq = append prompt (take_n toks (n - 1))
  let k = sm_kernels 0
  let t = sm_load k "/tmp/rail_fload.bin"
  let t0 = now_ns 0
  let rows = sm_forward t k seq 0
  let (a, h) = sm_results t rows
  let ms = (now_ns 0 - t0) / 1000000
  let (ntok, nh, first) = check (a, h) (zip2 toks hs) np 0 (0, 0, 0 - 1)
  let _ = print (cat ["verifier: one pass over ", show rows, " rows in ", show ms, " ms"])
  let _ = print (cat ["  greedy tokens reproduced: ", show ntok, "/", show n, "   logit-row hashes reproduced: ", show nh, "/", show n])
  if first < 0 then
    let _ = print "  VERIFIED: every claimed token is exactly what this model greedy-decodes, and every logit row matches to the bit"
    0
  else
    let _ = print (cat ["  REJECTED: first divergence at token ", show first, " (claimed ", show (nth_int toks first), ", the model's greedy choice there is ", show (sm_tok a (np - 1 + first)), ")"])
    1
