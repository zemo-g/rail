-- spec.rail <prompt.ids> <n> <transcript>: the producer again, with n-gram speculation.
-- After each emitted token, look for the most recent earlier occurrence of the last three
-- tokens and guess that what followed then follows now (no draft model, no second set of
-- weights). The emitted token and up to seven guesses go through ONE pass; every guess the
-- model's own greedy choice confirms is kept, plus the model's choice at the first miss.
--
-- Because a row's bits do not depend on the pass it rides in, the kept rows are the rows
-- plain decoding would have computed. So this must write the SAME transcript as gen.rail,
-- byte for byte, fingerprints included, in fewer passes. `cmp` is the test.
import "tools/infer/smol/smol_engine.rail"

arg i = head (drop_n args i)
drop_n xs i = if i <= 0 then xs else drop_n (tail xs) (i - 1)
fst p = let (x, _) = p in x
snd p = let (_, y) = p in y

-- seq: token array, len tokens in it
put_all a xs i = if xs == [] then i else let _ = arr_set a i (head xs) in put_all a (tail xs) (i + 1)
same_at a i j n = if n <= 0 then true else if arr_get a i == arr_get a j then same_at a (i + 1) (j + 1) (n - 1) else false
-- latest j with seq[j..j+3) == seq[len-3..len), searched downward; -1 if none
find_ng a len j = if j < 0 then 0 - 1 else if same_at a j (len - 3) 3 then j else find_ng a len (j - 1)
take_from a i stop k = if k <= 0 then [] else if i >= stop then [] else cons (arr_get a i) (take_from a (i + 1) stop (k - 1))
guesses a len room =
  if len < 4 then []
  else
    let j = find_ng a len (len - 4)
    if j < 0 then [] else take_from a (j + 3) len room

-- walk the pass's rows: keep guess i while it equals the model's choice at row i
accept ah gs r acc =
  let (a, h) = ah
  let choice = sm_tok a r
  let acc2 = cons (choice, sm_hash h r) acc
  if gs == [] then (acc2, r + 1)
  else if head gs == choice then accept ah (tail gs) (r + 1) acc2
  else (acc2, r + 1)

-- st = (token array, len, emitted (tok, hash) reversed, count, passes)
spec_loop t k st n =
  let (a, len, acc, cnt, passes) = st
  if cnt >= n then st
  else
    let room0 = sm_maxt - len
    let room = if room0 < 7 then room0 else 7
    let gs = guesses a len room
    let rows = sm_forward t k (cons (arr_get a (len - 1)) gs) (len - 1)
    let (got, used) = accept (sm_results t rows) gs 0 []
    let toks = reverse got
    let _ = put_all a (map fst toks) len
    spec_loop t k (a, len + used, append got acc, cnt + used, passes + 1) n

main =
  let prompt = ints (words (read_file (arg 1)))
  let n = parse_int (arg 2)
  let np = length prompt
  let k = sm_kernels 0
  let t = sm_load k "/tmp/rail_fload.bin"
  let a = arr_new (sm_maxt + 16) 0
  let _ = put_all a prompt 0
  let t0 = now_ns 0
  let _ = sm_forward t k prompt 0
  let (am, hm) = sm_results t np
  let first = (sm_tok am (np - 1), sm_hash hm (np - 1))
  let _ = arr_set a np (fst first)
  let (_, _, acc, cnt, passes) = spec_loop t k (a, np + 1, [first], 1, 1) n
  let ms = (now_ns 0 - t0) / 1000000
  let all = take_n (reverse acc) n
  let _ = write_file (arg 3) (cat [join_ints prompt, "\n", join_ints (map fst all), "\n", join " " (map snd all), "\n"])
  let _ = print (cat ["speculative producer: ", show n, " tokens in ", show passes, " passes (plain decoding: ", show n, "), ", show ms, " ms"])
  0
