-- parity.rail <sequence.ids>: the property everything else rests on. The same tokens
-- go through the engine three ways (one row per pass as a decoder would, eight rows
-- per pass, and all at once) from empty caches, and every logit row, every greedy
-- token and every layer's K/V cache must come out bit-identical. A dead engine cannot
-- pass: the first row's logits must be finite and nonzero first.
import "tools/infer/smol/smol_engine.rail"

arg i = head (drop_n args i)
drop_n xs i = if i <= 0 then xs else drop_n (tail xs) (i - 1)

-- feed `ids` in slices of `w` rows from position pos; collect (token, hash) per row
run_slices t k ids w pos acc =
  if ids == [] then reverse acc
  else
    let sl = take_n ids w
    let n = sm_forward t k sl pos
    let (a, h) = sm_results t n
    run_slices t k (drop_n ids n) w (pos + n) (collect a h 0 n acc)
collect a h r n acc = if r >= n then acc else collect a h (r + 1) n (cons (sm_tok a r, sm_hash h r) acc)

same xs ys = if xs == [] then ys == [] else if ys == [] then false else if pair_eq (head xs) (head ys) then same (tail xs) (tail ys) else false
pair_eq p q = let (a, b) = p in let (c, d) = q in if a == c then b == d else false

live a n i acc = if i >= n then acc else let v = float_arr_get a i in live a n (i + 1) (if v *. v >. 0.0 then (if v == v then acc + 1 else acc) else acc)

main =
  let ids = ints (words (read_file (arg 1)))
  let n = length ids
  let k = sm_kernels 0
  let t = sm_load k "/tmp/rail_fload.bin"
  let r1 = run_slices t k ids 1 0 []
  let c1 = sm_cache_digest t n 0 ""
  let row0 = float_arr_new 49152 0.0
  let _ = sm_forward t k [head ids] 0
  let _ = tgl_fabuf_download (tb t 424) row0 49152
  let lv = live row0 49152 0 0
  let r8 = run_slices t k ids 8 0 []
  let c8 = sm_cache_digest t n 0 ""
  let ra = run_slices t k ids n 0 []
  let ca = sm_cache_digest t n 0 ""
  let _ = print (cat ["parity over ", show n, " positions, 30 layers:"])
  let _ = print (cat ["  live logits in row 0: ", show lv, "/49152"])
  let _ = print (cat ["  1-row passes == all-at-once (token + FNV-64 of every logit row): ", if same r1 ra then "yes" else "NO"])
  let _ = print (cat ["  8-row passes == all-at-once: ", if same r8 ra then "yes" else "NO"])
  let _ = print (cat ["  K/V caches identical all three ways: ", if c1 == ca then (if c8 == ca then "yes" else "NO") else "NO"])
  let ok = if lv > 49000 then (if same r1 ra then (if same r8 ra then (if c1 == ca then c8 == ca else false) else false) else false) else false
  let _ = print (if ok then "PARITY: PASS" else "PARITY: FAIL")
  if ok then 0 else 1
