-- gen.rail <prompt.ids> <n> <transcript>: the producer. Prefill the prompt in one
-- pass, then decode n greedy tokens one at a time against the KV cache, the way any
-- server does. The transcript records the prompt, the tokens, and for every token the
-- FNV-64 of the full 49152-wide logit row it was chosen from.
import "tools/infer/smol/smol_engine.rail"

arg i = head (drop_n args i)
drop_n xs i = if i <= 0 then xs else drop_n (tail xs) (i - 1)

decode_loop t k prev pos left acc =
  if left <= 0 then reverse acc
  else
    let _ = sm_forward t k [prev] pos
    let (a, h) = sm_results t 1
    let tok = sm_tok a 0
    decode_loop t k tok (pos + 1) (left - 1) (cons (tok, sm_hash h 0) acc)

fsts ps = map fst ps
snds ps = map snd ps
fst p = let (x, _) = p in x
snd p = let (_, y) = p in y

main =
  let prompt = ints (words (read_file (arg 1)))
  let n = parse_int (arg 2)
  let np = length prompt
  let k = sm_kernels 0
  let t = sm_load k "/tmp/rail_fload.bin"
  let t0 = now_ns 0
  let _ = sm_forward t k prompt 0
  let (a, h) = sm_results t np
  let first = (sm_tok a (np - 1), sm_hash h (np - 1))
  let t1 = now_ns 0
  let rest = decode_loop t k (fst first) np (n - 1) []
  let t2 = now_ns 0
  let all = cons first rest
  let _ = write_file (arg 3) (cat [join_ints prompt, "\n", join_ints (fsts all), "\n", join " " (snds all), "\n"])
  let dec_ms = (t2 - t1) / 1000000
  let _ = print (cat ["producer: prefill ", show np, " tokens in ", show ((t1 - t0) / 1000000), " ms, then ", show (n - 1), " decode steps in ", show dec_ms, " ms (", show ((t2 - t0) / 1000000), " ms total)"])
  let _ = print (cat ["tokens: ", join_ints (fsts all)])
  0
