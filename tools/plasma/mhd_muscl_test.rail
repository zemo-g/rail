-- tools/plasma/mhd_muscl_test.rail — MUSCL+minmod smoke + LF comparison
--
-- Two short Orszag-Tang runs from the same IC: one with the existing
-- Lax-Friedrichs integrator, one with the new MUSCL+minmod path.
-- Both should conserve mass and energy. MUSCL should retain sharper
-- features (visible as a higher max density at matched simulation time)
-- because minmod limiting only drops to first-order at extrema, not
-- everywhere like LF's neighbor-average.
--
-- Pass criteria:
--   - MUSCL completes the run with no NaNs or floor activations
--   - |Δm/m| < 1e-10 and |ΔE/E| < 1e-10 over the test window
--   - max_density(MUSCL) ≥ max_density(LF) at matched simulation time

import "stdlib/mhd_kernel.rail"

-- Max density helper for sharpness comparison.
maxrho_check state i acc =
  let rho = float_arr_get state i
  let cur = float_arr_get acc 0
  if rho > cur then float_arr_set acc 0 rho else 0

maxrho_loop state i acc =
  if i >= mk_nn2 then 0
  else
    let _ = maxrho_check state i acc
    maxrho_loop state (i + 1) acc

max_density state =
  let acc = float_arr_new 1 0.0
  let _ = maxrho_loop state 0 acc
  float_arr_get acc 0

-- LF run: N steps, returns the final state. ctx[0] = time.
lf_loop state ctx step max_step =
  if step >= max_step then state
  else
    let dt = mk_compute_dt state
    let ns = mk_lxf_step state dt
    let _ = float_arr_set ctx 0 (float_arr_get ctx 0 + dt)
    lf_loop ns ctx (step + 1) max_step

-- MUSCL run: same.
muscl_loop state ctx step max_step =
  if step >= max_step then state
  else
    let dt = mk_compute_dt_muscl state
    let ns = mk_muscl_step state dt
    let _ = float_arr_set ctx 0 (float_arr_get ctx 0 + dt)
    muscl_loop ns ctx (step + 1) max_step

main =
  let _ = print "================================================"
  let _ = print "  MUSCL+minmod smoke vs Lax-Friedrichs baseline"
  let _ = print "  Orszag-Tang vortex, 128x128, periodic"
  let _ = print "================================================"

  -- Shared initial state (each run gets its own copy via re-init).
  let s_lf = mk_init_state
  let s_mu = mk_init_state

  let m0 = mk_total_mass s_lf
  let e0 = mk_total_energy s_lf
  let rho0 = max_density s_lf
  let _ = print (cat ["IC:    mass=", show_float m0, " energy=", show_float e0, " rho_max=", show_float rho0])

  let n_steps = 100

  let _ = print ""
  let _ = print (cat ["LF: running ", show n_steps, " steps..."])
  let ctx_lf = float_arr_new 1 0.0
  let final_lf = lf_loop s_lf ctx_lf 0 n_steps
  let m_lf = mk_total_mass final_lf
  let e_lf = mk_total_energy final_lf
  let rho_max_lf = max_density final_lf
  let rho_min_lf = mk_min_density final_lf
  let divb_lf = mk_max_div_b final_lf
  let _ = print (cat ["LF:    t=", show_float (float_arr_get ctx_lf 0), " dm=", show_float ((m_lf - m0) / m0), " dE=", show_float ((e_lf - e0) / e0)])
  let _ = print (cat ["LF:    rho_max=", show_float rho_max_lf, " rho_min=", show_float rho_min_lf, " divB=", show_float divb_lf])

  let _ = print ""
  let _ = print (cat ["MUSCL: running ", show n_steps, " steps..."])
  let ctx_mu = float_arr_new 1 0.0
  let final_mu = muscl_loop s_mu ctx_mu 0 n_steps
  let m_mu = mk_total_mass final_mu
  let e_mu = mk_total_energy final_mu
  let rho_max_mu = max_density final_mu
  let rho_min_mu = mk_min_density final_mu
  let divb_mu = mk_max_div_b final_mu
  let _ = print (cat ["MUSCL: t=", show_float (float_arr_get ctx_mu 0), " dm=", show_float ((m_mu - m0) / m0), " dE=", show_float ((e_mu - e0) / e0)])
  let _ = print (cat ["MUSCL: rho_max=", show_float rho_max_mu, " rho_min=", show_float rho_min_mu, " divB=", show_float divb_mu])

  let _ = print ""
  let _ = print (cat ["sharpness ratio rho_max(MUSCL)/rho_max(LF) = ", show_float (rho_max_mu / rho_max_lf)])
  let _ = print "(MUSCL >= LF means features are better preserved.)"
  0
