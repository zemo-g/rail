-- tools/plasma/mhd_beacon.rail — Rail-native ledatic.org entropy beacon
--
-- Replaces the numpy mhd_ot_beacon.py driver.  Same Lax-Friedrichs
-- ideal-MHD core (now in stdlib/mhd_kernel.rail), same Orszag-Tang IC,
-- same reset-at-t=π behaviour, same ~3-4 Hz publish rate.  All physics
-- is in Rail; mhd_beacon_pack.py is a 30-line packer that consumes
-- six ASCII plane dumps + a metadata file and emits the canonical
-- /tmp/plasma_live.bin in the byte-format that entropy_beacon.sh +
-- the Pi witness Ed25519 chain + the homepage ticker already speak.
--
-- The dance per frame:
--   1. STEPS_PER_FRAME LF steps with CFL-adaptive dt
--   2. Reset state if sim_time has crossed t=π (keeps the chaos live)
--   3. Dump 6 primitive planes (rho, vx, vy, p, bx, by) as ASCII
--   4. Dump frame metadata (frame_id, dt, sim_time, m0, e0)
--   5. shell out to the Python packer to assemble /tmp/plasma_live.bin
--   6. Throttle to TARGET_FPS via shell sleep, then loop

import "stdlib/mhd_kernel.rail"
import "stdlib/time.rail"

-- Frame paths (intermediate files; the packer assembles the binary).
beacon_dir = "/tmp/mhd_beacon"
beacon_meta = "/tmp/mhd_beacon/meta.txt"
beacon_planes_bin = "/tmp/mhd_beacon/planes.f32"

-- Steps and frame-rate cadence (mirrors mhd_ot_beacon.py's defaults).
steps_per_frame = 4
target_fps = 1
target_period_us = 1000000 / target_fps
-- Adaptive scheduler: sleep_us = target_period - compute_us per frame.
-- cpu_us measures process CPU time (doesn't tick during usleep), so the
-- sleep complement gives a near-constant wall-clock frame period.  Trades
-- accuracy under heavy preemption for not needing a struct-arg FFI to
-- clock_gettime; at nice=10 + 12% duty cycle, preemption is negligible.

-- t-reset window mirrors the numpy beacon.
t_reset = 3.14159265358979

dump_planes state buf =
  mk_dump_primitives_bin state buf beacon_planes_bin

-- Metadata block consumed by the packer.  Newline-separated, one value
-- per line, fixed order.  ASCII keeps things debuggable; the packer
-- writes binary.
write_meta frame_id dt sim_time m0 e0 mass energy divb rho_min =
  let body = cat [
        show frame_id, "\n",
        show_float dt, "\n",
        show_float sim_time, "\n",
        show_float m0, "\n",
        show_float e0, "\n",
        show_float mass, "\n",
        show_float energy, "\n",
        show_float divb, "\n",
        show_float rho_min, "\n"
      ]
  write_file beacon_meta body

-- Wake the warm packer daemon by writing a byte to the named-pipe
-- /tmp/mhd_beacon/ready (set up by mhd_beacon.sh as `mkfifo`).  The
-- previous implementation shelled out to /tmp/mhd_beacon/run_packer
-- which itself just did `echo 1 > /tmp/mhd_beacon/ready`.  Eliminating
-- the per-frame fork+exec dropped this driver's RSS climb from
-- 135 KB/s -> 0 KB/s in 800-frame soak (2026-05-02): macOS's VM
-- accounting for fork-spawned shells doesn't decommit promptly.
-- write_file on a FIFO opens for write (blocks until daemon's reader
-- side is open, which it always is), writes one byte, closes.
run_packer =
  write_file "/tmp/mhd_beacon/ready" "1\n"

-- Diagnostic cadence — full mass/energy/divB/rho_min scan only every
-- N frames, since each scan iterates 16K cells.  Stale diagnostics
-- between scans are fine: the entropy ticker hashes raw bytes (not
-- the metric fields), and downstream consumers only need them as a
-- sanity readout.  Frames between scans reuse the last computed
-- values via ctx slots [4..7].
diag_every = 40

-- Multi-step LF inner loop, double-buffered.  Reads from state[parity],
-- writes to state[1-parity], swaps via the parity arg.  No per-step
-- allocation of state — we keep two pre-allocated 768 KB buffers for
-- the entire process lifetime.
--
-- buffers[0] = state A, buffers[1] = state B.
-- coeffs/fxr/fxl/fyu/fyd are caller-owned scratch (allocated once in main).
-- Returns the parity that holds the *current* state at end of frame.
--
-- ctx[0] = sim_time accumulator, ctx[1] = dt of last step.
inner_step buffers parity ctx coeffs fxr fxl fyu fyd i =
  if i >= steps_per_frame then parity
  else
    let cur = arr_get buffers parity
    let nxt = arr_get buffers (1 - parity)
    let dt = mk_compute_dt cur
    let _ = mk_lxf_step_into cur nxt dt coeffs fxr fxl fyu fyd
    let _ = float_arr_set ctx 0 (float_arr_get ctx 0 + dt)
    let _ = float_arr_set ctx 1 dt
    inner_step buffers (1 - parity) ctx coeffs fxr fxl fyu fyd (i + 1)

-- Fresh OS entropy, as a phase in [0, 2π), for the reset perturbation.
--
-- /dev/urandom rather than an in-language PRNG: Rail's 63-bit tagged ints
-- overflow multiplicative generators (see the traps index), and this value
-- must be genuinely unpredictable — it is the only thing standing between
-- the beacon and an exactly periodic output.  shell() inherits no PATH, so
-- every binary is spelled out in full.
--
-- If the read ever fails, parse_int returns 0 and the phase is 0, which is
-- exactly the old always-identical behaviour — degraded, not broken, and
-- visible in the reset log line below.
beacon_reset_phase _ =
  let s = shell "/bin/dd if=/dev/urandom bs=4 count=1 2>/dev/null | /usr/bin/od -An -tu4 | /usr/bin/tr -d ' \n'"
  let n = parse_int s
  to_float (n % 1000000) * 0.0000062831853

-- Perturb one cell after the deterministic init: a small phase-shifted
-- velocity kick, with the energy adjusted so PRESSURE IS UNCHANGED.
--
-- Adding momentum without touching energy would silently lower the thermal
-- pressure every cycle and eventually drive it negative, turning a fixed
-- beacon into a crashing one.  So the thermal term is recomputed from the
-- pre-kick pressure: e = p/(γ-1) + ke + me, with γ-1 = 2/3 exactly as
-- mk_init_cell builds it.
mk_perturb_cell state ph i =
  let x = i % mk_nn
  let y = i / mk_nn
  let xp = to_float x * 0.04908738521234052
  let yp = to_float y * 0.04908738521234052
  let rho = mk_get state mk_f_rho x y
  let mx  = mk_get state mk_f_mx x y
  let my  = mk_get state mk_f_my x y
  let bx  = mk_get state mk_f_bx x y
  let by  = mk_get state mk_f_by x y
  let en  = mk_get state mk_f_en x y
  let me  = 0.5 * (bx * bx + by * by)
  let ke0 = 0.5 * (mx * mx + my * my) / rho
  let p   = (en - ke0 - me) * 0.6666666666666667
  let mx2 = mx + rho * 0.02 * sin (yp + ph)
  let my2 = my + rho * 0.02 * sin (xp + ph)
  let ke1 = 0.5 * (mx2 * mx2 + my2 * my2) / rho
  let _ = mk_put state mk_f_mx x y mx2
  let _ = mk_put state mk_f_my x y my2
  mk_put state mk_f_en x y (p / 0.6666666666666667 + ke1 + me)

mk_perturb_loop state ph i =
  if i >= mk_nn2 then 0
  else
    let _ = mk_perturb_cell state ph i
    mk_perturb_loop state ph (i + 1)

-- Reset in place — re-run mk_init_loop on the current buffer.  Avoids
-- the 768 KB allocation that mk_init_state would do.  Returns 0 (parity
-- unchanged).
--
-- ★ The reset is then PERTURBED with fresh entropy, and that is the whole
-- point.  mk_init_cell is a pure function of the cell index, so re-running
-- it produced byte-identical state every cycle; a deterministic PDE from
-- identical initial conditions retraces the identical trajectory, and the
-- beacon therefore REPLAYED its values on a fixed period.  Measured
-- 2026-08-05 over 20,000 contiguous archived pulses: only 5,996 distinct
-- values (70% duplication), repeat gap clustered at ~5,258 pulses ≈ 4h.
-- A public randomness beacon that repeats itself is the one bug that can
-- be used to discredit "check me, don't trust me", and it is checkable by
-- anyone who pulls /pulse/log.
--
-- The comment this replaces said the reset "keeps the chaos live"; it did
-- the exact opposite, which is why it survived review for months.  Chaos
-- needs a different starting point each cycle, not the same one.
maybe_reset buffers parity ctx =
  let t = float_arr_get ctx 0
  if t > t_reset then
    let ph = beacon_reset_phase 0
    let _ = print (cat ["beacon: t > pi, resetting with fresh phase ", show ph])
    let _ = float_arr_set ctx 0 0.0
    let _ = mk_init_loop (arr_get buffers parity) 0
    let _ = mk_perturb_loop (arr_get buffers parity) ph 0
    0
  else 0

-- Beacon main loop.  The exit-on-step-count is the heartbeat budget;
-- launchd / shell wrapper restarts the process if it exits.  We give
-- it a generous frame budget so the daemon stays warm across resets.
-- `buf` is the per-frame primitive scratch buffer, allocated once in
-- main and reused — keeps per-frame allocation bounded so the bump
-- arena and GC don't have to grind through 100 KB+ of new state every
-- frame.
beacon_loop buffers parity ctx buf coeffs fxr fxl fyu fyd frame_id max_frames =
  if frame_id >= max_frames then 0
  else
    let frame_start_us = cpu_us 0
    let mark = arena_mark 0
    let _ = maybe_reset buffers parity ctx
    let p2 = inner_step buffers parity ctx coeffs fxr fxl fyu fyd 0
    let cur = arr_get buffers p2
    let dt = float_arr_get ctx 1
    let sim_time = float_arr_get ctx 0
    let m0 = float_arr_get ctx 2
    let e0 = float_arr_get ctx 3
    -- Diagnostics every diag_every frames; in between, reuse the
    -- last-computed values from ctx[4..7].  Saves ~50 ms/frame.
    let _ = if frame_id % diag_every == 0 then
              let _ = float_arr_set ctx 4 (mk_total_mass cur)
              let _ = float_arr_set ctx 5 (mk_total_energy cur)
              let _ = float_arr_set ctx 6 (mk_max_div_b cur)
              float_arr_set ctx 7 (mk_min_density cur)
            else 0
    let mass = float_arr_get ctx 4
    let energy = float_arr_get ctx 5
    let divb = float_arr_get ctx 6
    let rho_min = float_arr_get ctx 7
    let _ = dump_planes cur buf
    let _ = write_meta frame_id dt sim_time m0 e0 mass energy divb rho_min
    let _ = run_packer
    let _ = if frame_id % diag_every == 0 then
              print (cat ["beacon: frame ", show frame_id, " t=", show_float sim_time, " dm=", show_float ((mass - m0) / m0), " divB=", show_float divb])
            else 0
    -- Drain per-frame transient allocations (cat-built strings, small
    -- scratch, stdlib bookkeeping).  All long-lived buffers (state[],
    -- ctx, buf, flux scratch) were allocated before this mark, so
    -- they survive the reset.
    let _ = arena_reset mark
    let compute_us = cpu_us 0 - frame_start_us
    let sleep_us = target_period_us - compute_us
    let _ = if sleep_us > 0 then wait_us sleep_us else 0
    beacon_loop buffers p2 ctx buf coeffs fxr fxl fyu fyd (frame_id + 1) max_frames

main =
  let _ = print "================================================="
  let _ = print "  ledatic.org entropy beacon (Rail-native driver)"
  let _ = print "  128x128 Orszag-Tang, ideal MHD, LF + reset@t=pi"
  let _ = print "================================================="
  let _ = shell (cat ["mkdir -p ", beacon_dir])
  -- Double-buffered state. mk_init_state allocates and seeds buf A;
  -- buf B is zeroed and filled by the first LF step.  Both buffers
  -- are pre-allocated so the per-frame loop NEVER allocates a state
  -- (768 KB × 4 steps × 4 fps would otherwise leak ~12 MB/s past the
  -- conservative GC, as observed 2026-05-02).
  let state_a = mk_init_state
  let state_b = float_arr_new mk_state_size 0.0
  let buffers = arr_new 2 0
  let _ = arr_set buffers 0 state_a
  let _ = arr_set buffers 1 state_b
  let m0 = mk_total_mass state_a
  let e0 = mk_total_energy state_a
  let _ = print (cat ["IC: mass=", show_float m0, " energy=", show_float e0])
  -- ctx layout:
  --   [0] sim_time accumulator     [4] last mass diagnostic
  --   [1] dt of last step           [5] last energy diagnostic
  --   [2] initial mass m0           [6] last divB diagnostic
  --   [3] initial energy e0         [7] last rho_min diagnostic
  let ctx = float_arr_new 8 0.0
  let _ = float_arr_set ctx 2 m0
  let _ = float_arr_set ctx 3 e0
  -- Seed the diagnostic slots so the first frame's metrics aren't all zero.
  let _ = float_arr_set ctx 4 m0
  let _ = float_arr_set ctx 5 e0
  let _ = float_arr_set ctx 7 (m0 / to_float mk_nn2)
  -- Reusable plane-write scratch buffer (6 × 128² floats = ~768 KB).
  -- Allocated once; mk_fill_primitives reuses it every frame so we
  -- don't grow the bump arena per dump.
  let buf = float_arr_new mk_prim_buffer_size 0.0
  -- Pre-allocated flux scratch — passed into mk_lxf_step_into so each
  -- step is allocation-free.
  let coeffs = float_arr_new 2 0.0
  let fxr = float_arr_new 6 0.0
  let fxl = float_arr_new 6 0.0
  let fyu = float_arr_new 6 0.0
  let fyd = float_arr_new 6 0.0
  -- Frame budget is a LEAK BOUND, not a time budget. target_fps is 1 (not the
  -- 4 this once assumed), so the old 100000 cap ran ~28 h and let the residual
  -- bump-arena leak fill swap to 19 GB (2026-07-07). ~330 KB/frame residual
  -- observed then (a regression from 30 KB/frame, 2026-05-02 -- see the
  -- plasma-beacon-leak memory; the residual itself still wants bisecting).
  -- 6000 frames ~= 100 min ~= <2 GB peak before mhd_beacon.sh's while-loop
  -- respawns a fresh arena.
  let _ = beacon_loop buffers 0 ctx buf coeffs fxr fxl fyu fyd 0 6000
  0
