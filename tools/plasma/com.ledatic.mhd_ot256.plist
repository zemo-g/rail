<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ledatic.mhd_ot256</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/user/projects/rail/tools/plasma/mhd_ot_2d_256.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RAIL_DIR</key>
        <string>/Users/user/projects/rail</string>
        <key>OT256_OUT</key>
        <string>/tmp/plasma_ot256.bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/mhd_ot256.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/mhd_ot256.err</string>
</dict>
</plist>
