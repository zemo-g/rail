-- tools/plasma/chamber.rail — server + client chamber renderer.
--
-- Compiles to ARM64 (for Mini's beacon publisher) AND WebAssembly (for
-- browser-side fallback / audit).  One source, two targets.
--
-- Volumetric raymarch through a cylindrical chamber containing the 2D
-- MHD plane field.  Density drives emission via a viridis colormap;
-- vorticity tints the emission cyan↔magenta; cylinder rim adds a
-- subtle highlight.  ACES tonemap to LDR.  Output: 128×128 packed
-- RGB8 (3 bytes per pixel, 49152 bytes total).
--
-- Design doc: docs/plans/CHAMBER_PUBLISHER.md.
--
-- Status (v1 scaffold): function signatures + math sketch.  Bodies
-- TODO until the design is approved.

-- ── Constants ────────────────────────────────────────────────────────
-- Output image dimensions match the simulation grid for v1.  Could
-- be decoupled in v2 (server renders 256², client downscales).
img_w  = 128
img_h  = 128
img_n  = 16384       -- img_w * img_h
img_bytes = 49152    -- img_n * 3 (RGB8)

-- Volumetric raymarch: 24 sample steps per ray, balances quality vs
-- compute on Mini's M1 (~25 ms per render at 128²).  Lower N = noisier
-- chamber depth, higher N = scales linearly in cost.
march_steps = 24

-- Cylinder geometry (matches holo.html's iso view).  Radius and half
-- height are in simulation-cell units (the 128² grid spans 0..nn).
chamber_radius   = 64.0    -- nn/2 — inscribed cylinder fills the grid
chamber_halfh    = 30.0    -- ~1/2 the radius; cylinder is shorter than wide

-- Camera (fixed iso for v1).  Position in cell-space, looking at origin.
cam_x = 96.0     -- nn * 0.75
cam_y = 96.0
cam_z = 50.0
fov_scale = 1.4

-- ── Output buffer accessors ─────────────────────────────────────────
-- out_rgb is a flat float_arr of img_bytes cells.  We pack RGB8 by
-- writing each byte as a float in [0, 255], the publisher narrows to
-- u8 on attach.  (Doing this in Rail-WASM with raw u8 stores would
-- need bytes_arr_set primitives we don't have yet; float_arr is the
-- existing path.)

put_rgb out_rgb i r g b =
  let _ = float_arr_set out_rgb (i * 3)     r
  let _ = float_arr_set out_rgb (i * 3 + 1) g
  float_arr_set out_rgb (i * 3 + 2) b

-- ── Sampling: bilinear into the 2D plane field ──────────────────────
-- Returns rho, vx, vy, bx, by (omitting p — chamber doesn't use p) at
-- the projected (x, y) point on the simulation grid.  Periodic wrap.
-- TODO: bilinear interp.  Nearest-neighbor for the v1 sketch.

plane_get state field x y =
  let xi = float_to_int x
  let yi = float_to_int y
  sget state field xi yi

-- ── Camera + ray construction ───────────────────────────────────────
-- For a given pixel (px, py) in [0, img_w) × [0, img_h), produce a
-- ray origin + direction in cell-space.  Iso projection: orthographic
-- for v1 simplicity; perspective for v2 if needed.
-- Returns ray_ox, ray_oy, ray_oz, ray_dx, ray_dy, ray_dz packed in a
-- 6-cell float_arr (Rail's calling convention bottleneck dictates).

-- TODO: full ray construction.  Sketch:
--   uv = (px / img_w, py / img_h) - 0.5
--   ray_o = cam + uv.x * cam_right + uv.y * cam_up
--   ray_d = -cam_forward    (orthographic for v1)

-- ── Cylinder intersection ───────────────────────────────────────────
-- Standard ray-cylinder formula.  Returns (t_enter, t_exit) along the
-- ray; if t_enter > t_exit the ray misses.  Caller checks bounds.

-- TODO: implement.  Same math as holo.html WGSL fn intersect_cylinder.

-- ── Viridis colormap (5-stop, baked) ────────────────────────────────
-- Same stops as mobile.html's JS LUT.  Returns (r, g, b) in [0, 255].
-- TODO: implement as nested if/else or table-driven.

-- ── Per-pixel render ────────────────────────────────────────────────
-- For one output pixel, cast a ray, march through the cylinder,
-- accumulate emission with Beer-Lambert opacity.  Write final RGB.

-- TODO sketch:
--   1. Build ray for (px, py).
--   2. Intersect cylinder → (t_in, t_out).  Miss → write background
--      color (dark blue) and return.
--   3. dt = (t_out - t_in) / march_steps.
--   4. Walk t from t_in + 0.5*dt in march_steps increments.
--   5. At each t: project (ray_o + t * ray_d).xy onto grid, sample
--      rho + vx + vy + bx + by.
--   6. emission = viridis(rho_normalized) * vorticity_tint(vx, vy).
--   7. opacity_step = 1 - exp(-rho * dt * 0.05).
--   8. accum_color += emission * opacity_step * (1 - accum_opacity).
--   9. accum_opacity += opacity_step * (1 - accum_opacity).
--   10. Add cylinder rim highlight if t close to t_in or t_out.
--   11. ACES tonemap accum_color.
--   12. put_rgb at (px, py).

-- ── Public entry: render the full image into the caller's buffer ────
-- state:   the float_arr that mhd_beacon already maintains
-- out_rgb: pre-allocated float_arr of img_bytes cells, written in place
-- Returns the buffer (caller ignores; reads bytes directly).

chamber_render state out_rgb =
  -- TODO: real per-pixel raymarch loop.
  -- Sketch:  for py in 0..img_h: for px in 0..img_w: render_px state out_rgb px py.
  out_rgb

-- ── Native sanity check ─────────────────────────────────────────────
-- Seeds the OT IC, renders one chamber image, writes raw bytes to
-- /tmp/chamber.bin.  Eyeball with: convert -size 128x128 -depth 8
-- rgb:/tmp/chamber.bin /tmp/chamber.png && open /tmp/chamber.png

