-- tools/plasma/mhd_v2.rail — 2D MHD driver on the unified kernel
--
-- Reproduces tools/plasma/mhd.rail's behaviour byte-identically while
-- delegating all physics to stdlib/mhd_kernel.rail. The point of this
-- file is to be small: every line of physics has been lifted into the
-- kernel; this driver only sequences init → loop → diagnostics → dump.
--
-- Same Orszag-Tang vortex, same 128x128 grid, same Lax-Friedrichs scheme,
-- same conservation diagnostics. The kernel is the single source of
-- truth that every other surface (beacon, WASM, Metal, neural data gen)
-- will share.

import "stdlib/mhd_kernel.rail"

-- All float state in arrays (TCO loop integer-only).
-- ctx[0] = time, ctx[1] = m0, ctx[2] = e0
do_step state ctx step =
  let dt = mk_compute_dt state
  let ns = mk_lxf_step state dt
  let t = float_arr_get ctx 0
  let nt = t + dt
  let _ = float_arr_set ctx 0 nt
  let m0 = float_arr_get ctx 1
  let e0 = float_arr_get ctx 2
  let _ = if step % 50 == 0 then mk_print_diag step ns m0 e0 dt nt else 0
  let _ = if step % 15 == 0 then
    let fnum = step / 15
    let tag = if fnum < 10 then cat ["00", show fnum] else if fnum < 100 then cat ["0", show fnum] else show fnum
    let _ = mk_dump_field ns 0 (cat ["/tmp/mhd_live/frame_", tag, ".dat"])
    print (cat ["  -> frame ", tag])
  else 0
  ns

check_done ctx step max_steps =
  if step >= max_steps then 1
  else if float_arr_get ctx 0 > 3.14159265358979 then 2
  else 0

sim_loop state ctx step max_steps =
  let done = check_done ctx step max_steps
  if done == 1 then
    let _ = print (cat ["\nDone: ", show step, " steps, t=", show_float (float_arr_get ctx 0)])
    0
  else if done == 2 then
    let _ = print (cat ["\nReached t=pi at step ", show step])
    0
  else
    let ns = do_step state ctx step
    sim_loop ns ctx (step + 1) max_steps

main =
  let _ = print "=================================="
  let _ = print "  RAIL PLASMA — 2D MHD Simulator"
  let _ = print "  Orszag-Tang Vortex, 128x128"
  let _ = print "  Lax-Friedrichs, periodic BC"
  let _ = print "  (mhd_v2: stdlib/mhd_kernel.rail)"
  let _ = print "=================================="
  let _ = print ""
  let _ = print "Initializing..."
  let state = mk_init_state
  let m0 = mk_total_mass state
  let e0 = mk_total_energy state
  let d0 = mk_max_div_b state
  let _ = print (cat ["Initial: mass=", show_float m0, " energy=", show_float e0, " divB=", show_float d0])
  let _ = print ""
  let _ = mk_dump_field state 0 "/tmp/mhd_frame_000.dat"
  let _ = print "Running to t=pi (~800 steps)..."
  let ctx = float_arr_new 3 0.0
  let _ = float_arr_set ctx 1 m0
  let _ = float_arr_set ctx 2 e0
  let _ = sim_loop state ctx 0 800
  0
