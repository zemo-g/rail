-- tools/plasma/mhd_mpd_test.rail — MPD source pack smoke test
--
-- Realistic MPD operating point (~SX3 scale):
--   cathode 5 mm, anode 50 mm, channel 100 mm
--   arc current 1000 A, applied B 50 mT peak, argon
--   100 mg/s mass flow, 200 Pa inlet pressure
--
-- Pass criteria:
--   1. State stays bounded after N steps (rho > 0, no NaN)
--   2. Mass conservation respects inlet/outlet flux balance
--   3. Thrust integral is positive

import "stdlib/mhd_axisym.rail"
import "stdlib/mhd_mpd.rail"

maecker_thrust i_arc r_min r_max =
  let ratio = r_max / r_min
  let lr = log ratio
  0.0000001 * i_arc * i_arc * (lr + 0.75)

step_one s bz br ctx params dt =
  let ns = ma_lxf_step s ctx dt
  let _ = mpd_apply_sources s ns bz br params dt
  ns

step_loop s bz br ctx params dt step max_step =
  if step >= max_step then s
  else
    let ns = step_one s bz br ctx params dt
    step_loop ns bz br ctx params dt (step + 1) max_step

scan_min_rho_loop s i acc =
  if i >= ma_nrnz then 0
  else
    let v = float_arr_get s i
    let cur = float_arr_get acc 0
    let _ = if v < cur then float_arr_set acc 0 v else 0
    scan_min_rho_loop s (i + 1) acc

scan_min_rho s =
  let acc = float_arr_new 1 1000000.0
  let _ = scan_min_rho_loop s 0 acc
  float_arr_get acc 0

main =
  let _ = print "================================================="
  let _ = print "  MPD source pack smoke test (Argon, 1000 A)"
  let _ = print "================================================="
  let _ = print (cat ["  consts: ma_nr=", show ma_nr, " ma_nz=", show ma_nz, " ma_nrnz=", show ma_nrnz])

  let r_min = 0.005
  let r_max = 0.05
  let chan_len = 0.1
  let dr = (r_max - r_min) / to_float ma_nr
  let dz = chan_len / to_float ma_nz
  let _ = print (cat ["geom: ", show ma_nr, "x", show ma_nz, " dr=", show_float dr, " dz=", show_float dz])

  let i_arc = 1000.0
  let m_ion = 6.633e-26
  let rho_in = 0.001
  let vz_in = 50.0
  let p_in = 200.0

  let ctx = ma_make_ctx rho_in vz_in p_in i_arc r_min r_max dr dz

  let params = float_arr_new 5 0.0
  let _ = float_arr_set params 0 r_min
  let _ = float_arr_set params 1 r_max
  let _ = float_arr_set params 2 dr
  let _ = float_arr_set params 3 dz
  let _ = float_arr_set params 4 m_ion

  let _ = print ""
  let _ = print "Test 1: initial state from inlet conditions"
  let s = ma_init_state ctx
  let m0 = ma_total_mass s
  let _ = print (cat ["  total_mass init: ", show_float m0, " (expect rho_in * cells = ", show_float (rho_in * to_float ma_nrnz), ")"])

  let _ = print ""
  let _ = print "Test 2: zero applied field (self-field Lorentz only)"
  let bz = float_arr_new ma_nrnz 0.0
  let br = float_arr_new ma_nrnz 0.0
  let _ = print "  bz[],br[] zero-filled"

  let _ = print ""
  let _ = print "Test 3a: 10 LF-only steps (no sources) — control"
  let dt = 5.0e-9
  let n_steps = 10
  let lf_only = lf_step_loop s ctx dt 0 n_steps
  let m_lf = ma_total_mass lf_only
  let rho_min_lf = scan_min_rho lf_only
  let _ = print (cat ["  total_mass: ", show_float m0, " -> ", show_float m_lf])
  let _ = print (cat ["  rho_min:    ", show_float rho_min_lf])

  let _ = print ""
  let _ = print "Test 3b: 10 LF + source steps (the multi-step path)"
  let final_state = step_loop s bz br ctx params dt 0 n_steps
  let m_end = ma_total_mass final_state
  let rho_min_end = scan_min_rho final_state
  let _ = print (cat ["  total_mass: ", show_float m0, " -> ", show_float m_end])
  let _ = print (cat ["  rho_min:    ", show_float rho_min_end])

  let _ = print ""
  let _ = print "Test 4: thrust diagnostic"
  let thrust = mpd_thrust_integral final_state bz br params
  let mae = maecker_thrust i_arc r_min r_max
  let _ = print (cat ["  Lorentz body-force integral: ", show_float thrust, " N"])
  let _ = print (cat ["  Maecker self-field analytic: ", show_float mae, " N"])

  let _ = print ""
  let _ = if rho_min_end > 0.0 then print "PASS: LF kernel + source pack — multi-step end-to-end" else print "FAIL: density floor breached"
  0

-- LF-only step loop (no sources) for the control test.
lf_step_loop s ctx dt step max_step =
  if step >= max_step then s
  else
    let ns = ma_lxf_step s ctx dt
    lf_step_loop ns ctx dt (step + 1) max_step
