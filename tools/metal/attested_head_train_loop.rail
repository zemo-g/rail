-- attested_head_train_loop.rail -- a MULTI-STEP TRAINING LOOP on the real 138M
-- GPT (2026-07-05). Proves the loop plumbing end-to-end: forward (16-layer GPU
-- engine) -> softmax CE loss -> weight gradient -> F=24 weight update -> loss
-- descends -> checkpoint written. Composes everything: the forward engine, the
-- convergence-validated F=24 optimizer (bit-identical to the twin-verified GPU
-- sgd/adam kernels), and the safetensors writer.
--
-- Scoped for a clean, provable demonstration: the 16 lower layers are run ONCE
-- to produce the frozen final-LN feature xnf; the loop then trains ONLY the LM
-- head to predict a NON-argmax target token (6000). That is logistic regression
-- on fixed features, so F=24 SGD MUST drive CE(target) smoothly to ~0 and move
-- the argmax 5836 -> 6000 -- a decisive "the loop works" signal. (Full-model
-- training just adds the per-layer weight grads to the existing 16-layer
-- backward; see attested_model_train_fast.rail for the backward + HANDOFF.)
--
-- Build+run (big load -> run the BINARY with a large arena):
--   ./rail_native tools/metal/attested_head_train_loop.rail && RAIL_ARENA_MB=6000 /tmp/rail_out

import "stdlib/file.rail"
import "stdlib/env.rail"
import "stdlib/ijit.rail"

foreign pread fd buf count offset -> int
foreign malloc size -> ptr
foreign free p
foreign log x -> float   -- declared directly (NOT via math.rail, whose global `e` collides with softmax's local)

-- ===== F32 loader =====
pq_pow2_go acc k = if k == 0 then acc else pq_pow2_go (acc + acc) (k - 1)
pq_pow2 k = if k < 1 then 1 else pq_pow2_go 1 k
pq_f32_fixed b0 b1 b2 b3 =
  let bits = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216 in
  let sign = bits / 2147483648 in let rest = bits - sign * 2147483648 in
  let exp = rest / 8388608 in let mant = rest - exp * 8388608 in
  if exp == 0 then 0 else let mag = 8388608 + mant in let sh = exp - 126 in
    let xabs = if sh >= 0 then mag * (pq_pow2 sh) else (let dd = pq_pow2 (0 - sh) in (mag + dd / 2) / dd) in
    if sign == 1 then 0 - xabs else xabs
pq_match buf pos pcs = if pcs == [] then 1 else if byte_at buf pos == char_to_int (head pcs) then pq_match buf (pos + 1) (tail pcs) else 0
pq_find buf pos hi pcs = if pos >= hi then 0 - 1 else if pq_match buf pos pcs == 1 then pos else pq_find buf (pos + 1) hi pcs
pq_find_after buf pos hi pcs = let p = pq_find buf pos hi pcs in if p < 0 then 0 - 1 else p + length pcs
pq_int buf pos acc = let c = byte_at buf pos in if c < 48 then acc else if c > 57 then acc else pq_int buf (pos + 1) (acc * 10 + (c - 48))
pq_le_len buf off = byte_at buf off + byte_at buf (off + 1) * 256 + byte_at buf (off + 2) * 65536 + byte_at buf (off + 3) * 16777216 + byte_at buf (off + 4) * 4294967296 + byte_at buf (off + 5) * 1099511627776
pq_offset hdr hi name k = let np = pq_find hdr 0 hi (chars (cat ["\"", name, "\":"])) in let dp = pq_find_after hdr np hi (chars "\"data_offsets\":[") in pq_int hdr dp 0
gp_dec_f32 cbuf out obase count i = if i >= count then 0 else let ba = 4 * i in let _ = arr_set out (obase + i) (pq_f32_fixed (byte_at cbuf ba) (byte_at cbuf (ba + 1)) (byte_at cbuf (ba + 2)) (byte_at cbuf (ba + 3))) in gp_dec_f32 cbuf out obase count (i + 1)
ld_f32 fd hdrbuf base name count = let start = pq_offset hdrbuf base name 0 in let cbuf = malloc (count * 4) in let nr = pread fd cbuf (count * 4) (base + start) in let out = arr_new count 0 in let _ = gp_dec_f32 cbuf out 0 count 0 in let _ = free cbuf in out
bname li suffix = cat ["blocks.", show li, ".", suffix]

-- ===== F=24 math =====
bx4_sqrt_le r xq = let hr = mul_shr r r 24 in if hr < xq then true else if hr > xq then false else let c = r - (r / 16777216) * 16777216 in let cc = c * c in (cc - (cc / 16777216) * 16777216) == 0
bx4_bsqrt lo hi xq = if (lo + 1) >= hi then lo else let mid = (lo + hi) / 2 in if bx4_sqrt_le mid xq then bx4_bsqrt mid hi xq else bx4_bsqrt lo mid xq
bx4_fxsqrt xq = if xq < 1 then 0 else let a = 16384 in bx4_bsqrt 0 ((a * a) * 4096) xq
bx4_fxrsqrt xq = let q = bx4_fxsqrt xq in if q == 0 then 0 else 281474976710656 / q

-- ===== F=24 exp + softmax (for the LM-head CE loss) =====
bx4_pow2b_go acc k = if k == 0 then acc else bx4_pow2b_go (acc + acc) (k - 1)
bx4_pow2b k = if k < 1 then 1 else bx4_pow2b_go 1 k
bx4_exp_poly fq = let p8 = 416 in let p7 = 3329 + (p8 * fq) / 16777216 in let p6 = 23302 + (p7 * fq) / 16777216 in let p5 = 139810 + (p6 * fq) / 16777216 in let p4 = 699051 + (p5 * fq) / 16777216 in let p3 = 2796203 + (p4 * fq) / 16777216 in let p2 = 8388608 + (p3 * fq) / 16777216 in let p1 = 16777216 + (p2 * fq) / 16777216 in 16777216 + (p1 * fq) / 16777216
bx4_exp_neg ax = let k = ax / 11629080 in let fq = ax - k * 11629080 in let ef = bx4_exp_poly fq in let emf = 281474976710656 / ef in if k >= 50 then 0 else let p2 = bx4_pow2b k in (emf + p2 / 2) / p2
sm_max lg n i m = if i >= n then m else sm_max lg n (i + 1) (let v = arr_get lg i in if v > m then v else m)
sm_exp lg ex n m i sum = if i >= n then sum else let ev = bx4_exp_neg (m - (arr_get lg i)) in let _ = arr_set ex i ev in sm_exp lg ex n m (i + 1) (sum + ev)
sm_norm ex p n sum i = if i >= n then 0 else let _ = arr_set p i (((arr_get ex i) * 16777216) / sum) in sm_norm ex p n sum (i + 1)

-- softmax over logits -> p (F=24); returns p[target] (clamped >=1 for the log)
head_softmax logits ex p vocab target =
  let mx = sm_max logits vocab 1 (arr_get logits 0) in
  let ssum = sm_exp logits ex vocab mx 0 0 in
  let _ = sm_norm ex p vocab ssum 0 in
  let v = arr_get p target in if v < 1 then 1 else v

-- dlogits = p - onehot(target), written into dl (dl aliases p's values then subtract at target)
head_dlogits p dl vocab target i =
  if i >= vocab then (let _ = arr_set dl target ((arr_get dl target) - 16777216) in 0)
  else let _ = arr_set dl i (arr_get p i) in head_dlogits p dl vocab target (i + 1)

-- fused wgrad + F=24 SGD update of the whole LM head: for every (c,j)
--   g = dlogits[c] * xnf[j] ;  Head[c*d+j] -= lr * g   (single example, no /N)
head_sgd Head xnf dl vocab d lr c j =
  if c >= vocab then 0
  else if j >= d then head_sgd Head xnf dl vocab d lr (c + 1) 0
  else let g = mul_shr (arr_get dl c) (arr_get xnf j) 24 in
       let idx = c * d + j in
       let _ = arr_set Head idx ((arr_get Head idx) - (mul_shr lr g 24)) in
       head_sgd Head xnf dl vocab d lr c (j + 1)

-- ===== safetensors writer (checkpoint write-back; see safetensors_write_demo.rail) =====
oct3 v = let d0 = v / 64 in let r0 = v - d0 * 64 in let d1 = r0 / 8 in let d2 = r0 - d1 * 8 in cat ["\\", show d0, show d1, show d2]
le8_esc h = cat [oct3 (h - (h / 256) * 256), oct3 ((h / 256) - (h / 65536) * 256), oct3 ((h / 65536) - (h / 16777216) * 256), oct3 ((h / 16777216) - (h / 4294967296) * 256), "\\000\\000\\000\\000"]
i2f_into src n dst i = if i >= n then 0 else let _ = float_arr_set dst i ((to_float (arr_get src i)) /. 16777216.0) in i2f_into src n dst (i + 1)
write_one_st path name shape arr n =
  let payload = float_arr_new n 0.0 in let _ = i2f_into arr n payload 0 in
  let hdr = cat ["{\"", name, "\":{\"dtype\":\"F32\",\"shape\":[", shape, "],\"data_offsets\":[0,", show (n * 4), "]}}"] in
  let H = length hdr in
  let _ = float_arr_to_f32_file (cat [path, ".p"]) payload n in
  let _ = write_file (cat [path, ".h"]) hdr in
  let _ = shell (cat ["printf '", le8_esc H, "' > ", path, ".l"]) in
  let _ = shell (cat ["cat ", path, ".l ", path, ".h ", path, ".p > ", path, " && rm -f ", path, ".l ", path, ".h ", path, ".p"]) in
  0

-- ===== helpers =====
cpseg src soff dst doff n i = if i >= n then 0 else let _ = arr_set dst (doff + i) (arr_get src (soff + i)) in cpseg src soff dst doff n (i + 1)
resid_add A B out n i = if i >= n then 0 else let _ = arr_set out i ((arr_get A i) + (arr_get B i)) in resid_add A B out n (i + 1)
bias_add Y bias L d t i = if t >= L then 0 else if i >= d then bias_add Y bias L d (t + 1) 0 else let _ = arr_set Y (t * d + i) ((arr_get Y (t * d + i)) + (arr_get bias i)) in bias_add Y bias L d t (i + 1)
mk_x_row Tok Pos x tb ob d i = if i >= d then 0 else let _ = arr_set x (ob + i) ((arr_get Tok (tb + i)) + (arr_get Pos (ob + i))) in mk_x_row Tok Pos x tb ob d (i + 1)
argmax_go lg n i best bi = if i >= n then bi else let v = arr_get lg i in if v > best then argmax_go lg n (i + 1) v i else argmax_go lg n (i + 1) best bi
mk_x_loop Tok Pos ids H d L t = if t >= L then 0 else let id = arr_get ids t in let _ = mk_x_row Tok Pos H (id * d) (t * d) d 0 in mk_x_loop Tok Pos ids H d L (t + 1)

-- ===== GPU op wrappers =====
gpu_ln kid X g b out rows d = let P = arr_new (rows * d + d + d) 0 in let _ = cpseg X 0 P 0 (rows * d) 0 in let _ = cpseg g 0 P (rows * d) d 0 in let _ = cpseg b 0 P (rows * d + d) d 0 in ijit_run kid P P out (rows * d + d + d) 1 (rows * d) rows
gpu_proj_tok kid P rowbuf src out rows k L t = if t >= L then 0 else let _ = cpseg src (t * k) P (rows * k) k 0 in let _ = ijit_run kid P P rowbuf (rows * k + k) 1 rows rows in let _ = cpseg rowbuf 0 out (t * rows) rows 0 in gpu_proj_tok kid P rowbuf src out rows k L (t + 1)
gpu_proj kid W src out rows k L = let P = arr_new (rows * k + k) 0 in let _ = cpseg W 0 P 0 (rows * k) 0 in let rowbuf = arr_new rows 0 in gpu_proj_tok kid P rowbuf src out rows k L 0
-- LayerNorm at a single row (last position) into xn[0..d)
gpu_ln1 kid X base xn g b d = let P = arr_new (d + d + d) 0 in let _ = cpseg X base P 0 d 0 in let _ = cpseg g 0 P d d 0 in let _ = cpseg b 0 P (2 * d) d 0 in ijit_run kid P P xn (d + d + d) 1 d 1

-- ===== one GPU transformer block (weights streamed) =====
gpu_block fd hdr base H li L d nh hd qdim inter kLN kP1 kUp kDn kAt kGe =
  let g1 = ld_f32 fd hdr base (bname li "ln1.weight") d in
  let b1 = ld_f32 fd hdr base (bname li "ln1.bias") d in
  let Wq = ld_f32 fd hdr base (bname li "attn.query_proj.weight") (qdim * d) in
  let Wk = ld_f32 fd hdr base (bname li "attn.key_proj.weight") (qdim * d) in
  let Wv = ld_f32 fd hdr base (bname li "attn.value_proj.weight") (qdim * d) in
  let Wo = ld_f32 fd hdr base (bname li "attn.out_proj.weight") (d * qdim) in
  let g2 = ld_f32 fd hdr base (bname li "ln2.weight") d in
  let b2 = ld_f32 fd hdr base (bname li "ln2.bias") d in
  let Wm0 = ld_f32 fd hdr base (bname li "mlp.layers.0.weight") (inter * d) in
  let bm0 = ld_f32 fd hdr base (bname li "mlp.layers.0.bias") inter in
  let Wm2 = ld_f32 fd hdr base (bname li "mlp.layers.2.weight") (d * inter) in
  let bm2 = ld_f32 fd hdr base (bname li "mlp.layers.2.bias") d in
  let ln1 = arr_new (L * d) 0 in let _ = gpu_ln kLN H g1 b1 ln1 L d in
  let Q = arr_new (L * qdim) 0 in let _ = gpu_proj kP1 Wq ln1 Q qdim d L in
  let K = arr_new (L * qdim) 0 in let _ = gpu_proj kP1 Wk ln1 K qdim d L in
  let V = arr_new (L * qdim) 0 in let _ = gpu_proj kP1 Wv ln1 V qdim d L in
  let QKV = arr_new (3 * L * qdim) 0 in let _ = cpseg Q 0 QKV 0 (L * qdim) 0 in let _ = cpseg K 0 QKV (L * qdim) (L * qdim) 0 in let _ = cpseg V 0 QKV (2 * L * qdim) (L * qdim) 0 in
  let attn = arr_new (L * qdim) 0 in let _ = ijit_run kAt QKV QKV attn (3 * L * qdim) 1 (L * qdim) L in
  let ao = arr_new (L * d) 0 in let _ = gpu_proj kP1 Wo attn ao d qdim L in
  let r1 = arr_new (L * d) 0 in let _ = resid_add H ao r1 (L * d) 0 in
  let ln2 = arr_new (L * d) 0 in let _ = gpu_ln kLN r1 g2 b2 ln2 L d in
  let h1 = arr_new (L * inter) 0 in let _ = gpu_proj kUp Wm0 ln2 h1 inter d L in let _ = bias_add h1 bm0 L inter 0 0 in
  let h2 = arr_new (L * inter) 0 in let _ = ijit_run kGe h1 h1 h2 (L * inter) 1 (L * inter) (L * inter) in
  let mo = arr_new (L * d) 0 in let _ = gpu_proj kDn Wm2 h2 mo d inter L in let _ = bias_add mo bm2 L d 0 0 in
  let y = arr_new (L * d) 0 in let _ = resid_add r1 mo y (L * d) 0 in
  y

gpu_layers fd hdr base Hcur li nlayers L d nh hd qdim inter kLN kP1 kUp kDn kAt kGe =
  if li >= nlayers then 0
  else let m = arena_mark 0 in
       let y = gpu_block fd hdr base Hcur li L d nh hd qdim inter kLN kP1 kUp kDn kAt kGe in
       let _ = cpseg y 0 Hcur 0 (L * d) 0 in
       let _ = arena_reset m in
       gpu_layers fd hdr base Hcur (li + 1) nlayers L d nh hd qdim inter kLN kP1 kUp kDn kAt kGe

-- ===== the training loop: K steps of forward -> CE -> head-grad -> SGD =====
htrain kHead Head xnf logits ex p dl vocab d target lr step maxsteps =
  if step > maxsteps then 0
  else
    let _ = gpu_proj kHead Head xnf logits vocab d 1 in
    let pt = head_softmax logits ex p vocab target in
    let ce = 0.0 -. (log ((to_float pt) /. 16777216.0)) in
    let am = argmax_go logits vocab 1 (arr_get logits 0) 0 in
    let _ = if (step % 1) == 0 then print (cat ["  step ", show step, "  CE(target)=", show ce, "  argmax=", show am, "  logit[target]=", show (arr_get logits target)]) else 0 in
    let _ = head_dlogits p dl vocab target 0 in
    let _ = head_sgd Head xnf dl vocab d lr 0 0 in
    htrain kHead Head xnf logits ex p dl vocab d target lr (step + 1) maxsteps

-- CE loss readout only (no update) -- for the initial/final measurement
head_ce kHead Head xnf logits ex p vocab d target =
  let _ = gpu_proj kHead Head xnf logits vocab d 1 in
  let pt = head_softmax logits ex p vocab target in
  0.0 -. (log ((to_float pt) /. 16777216.0))

main =
  let blob = cat [getenv "HOME", "/.ledatic/railml-trial/canonical_bestpass.safetensors"] in
  if (read_file_size blob) < 10000000 then let _ = print "FATAL blob missing" in 1
  else
  let d = 768 in let nh = 12 in let hd = 64 in let qdim = 768 in let inter = 3072 in let L = 9 in let vocab = 16384 in let nlayers = 16 in
  let fd = fopen blob "rb" in
  let hbuf8 = malloc 8 in let _ = pread fd hbuf8 8 0 in let hlen = pq_le_len hbuf8 0 in let _ = free hbuf8 in
  let base = 8 + hlen in let hdrbuf = malloc base in let _ = pread fd hdrbuf base 0 in
  let _ = print "loading tok/pos/head + embedding the prompt ..." in
  let Tok = ld_f32 fd hdrbuf base "tok.weight" (vocab * d) in
  let Pos = ld_f32 fd hdrbuf base "pos.weight" (L * d) in
  let ids = arr_new L 0 in
  let _ = arr_set ids 0 328 in let _ = arr_set ids 1 2432 in let _ = arr_set ids 2 554 in let _ = arr_set ids 3 183 in
  let _ = arr_set ids 4 12154 in let _ = arr_set ids 5 533 in let _ = arr_set ids 6 197 in let _ = arr_set ids 7 27 in let _ = arr_set ids 8 661 in
  let H = arr_new (L * d) 0 in
  let _ = mk_x_loop Tok Pos ids H d L 0 in
  -- compile block kernels once (shape L,d fixed across layers)
  let kLN = ijit_compile (emit_msl_fx_layernorm24_shaped L d) in
  let kP1 = ijit_compile (emit_msl_fx_matmul24_shaped qdim d) in
  let kUp = ijit_compile (emit_msl_fx_matmul24_shaped inter d) in
  let kDn = ijit_compile (emit_msl_fx_matmul24_shaped d inter) in
  let kAt = ijit_compile (emit_msl_fx_attn24_shaped L qdim nh hd) in
  let kGe = ijit_compile (emit_msl_fx_gelu24_shaped (L * inter)) in
  let kLN1 = ijit_compile (emit_msl_fx_layernorm24_shaped 1 d) in
  let _ = print "running 16 GPU transformer layers ..." in
  let _ = gpu_layers fd hdrbuf base H 0 nlayers L d nh hd qdim inter kLN kP1 kUp kDn kAt kGe in
  -- final LN at last position + LM head
  let gnf = ld_f32 fd hdrbuf base "lnf.weight" d in
  let bnf = ld_f32 fd hdrbuf base "lnf.bias" d in
  let xnf = arr_new d 0 in
  let _ = gpu_ln1 kLN1 H ((L - 1) * d) xnf gnf bnf d in
  let _ = print "loading head.weight ..." in
  let Head = ld_f32 fd hdrbuf base "head.weight" (vocab * d) in
  let _ = fclose fd in
  let kHead = ijit_compile (emit_msl_fx_matmul24_shaped vocab d) in
  let logits = arr_new vocab 0 in
  let ex = arr_new vocab 0 in let p = arr_new vocab 0 in let dl = arr_new vocab 0 in
  -- forward once: confirm the frozen features reproduce the gold argmax (5836)
  let _ = gpu_proj kHead Head xnf logits vocab d 1 in
  let am0 = argmax_go logits vocab 1 (arr_get logits 0) 0 in
  let _ = print (cat ["  initial forward argmax = ", show am0, "   (gold 5836)"]) in
  -- TRAIN THE LM HEAD to predict a NON-argmax target on the real frozen features.
  -- Logistic regression on fixed features: F=24 SGD must drive CE(target) -> 0.
  -- This exercises the full loop -- forward (engine) -> CE -> head-grad -> update
  -- -> loss down -> checkpoint -- and the F=24 update is bit-identical to the
  -- twin-verified GPU sgd/adam kernels (numerics are identical CPU/GPU).
  let target = 6000 in
  let lr = 8388 in        -- 0.0005 in F=24 (gentle, to show the descent curve)
  let maxsteps = 24 in
  let ce0 = head_ce kHead Head xnf logits ex p vocab d target in
  let _ = print (cat ["train LM head to predict token ", show target, " (SGD, ", show maxsteps, " steps):"]) in
  let _ = print (cat ["  initial CE(target=", show target, ") = ", show ce0, "   logit[target]=", show (arr_get logits target)]) in
  let _ = htrain kHead Head xnf logits ex p dl vocab d target lr 0 maxsteps in
  let ceF = head_ce kHead Head xnf logits ex p vocab d target in
  let amF = argmax_go logits vocab 1 (arr_get logits 0) 0 in
  let _ = print (cat ["  final CE(target) = ", show ceF, "   argmax now = ", show amF, " (target ", show target, ")"]) in
  -- checkpoint the trained head
  let ckpt = cat [getenv "HOME", "/.ledatic/railml-trial/head_trained.safetensors"] in
  let _ = write_one_st ckpt "head.weight" (cat [show vocab, ",", show d]) Head (vocab * d) in
  let _ = print (cat ["  wrote checkpoint ", ckpt, " (", show (read_file_size ckpt), " bytes)"]) in
  -- verify: loss dropped a lot AND argmax moved to the target (the loop worked)
  let ok = if (ceF <. (ce0 /. 4.0)) && (amF == target) then 1 else 0 in
  let _ = print (cat ["  verdict: ", if ok == 1 then "HEAD-TRAIN-LOOP-OK -- CE descended + argmax->target + checkpoint written" else "LOOP-FAIL"]) in
  if ok == 1 then 0 else 1
