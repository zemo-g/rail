-- attested_fx_demo.rail — twin-kernel attestation, act 2 (2026-07-03).
--
-- Act 1 (attested_idot_demo.rail) proved integer GPU kernels are
-- bit-exact.  Act 2 proves the REAL Path-B fixed-point semantics run
-- on GPU: mul_shr, the 128-bit-intermediate primitive that made
-- pure-Rail LLM inference possible, twin-implemented:
--   CPU twin: Rail's mul_shr primitive (mul/smulh ARM64 sequence)
--   GPU twin: mulhi-based mul_shr_gpu in emitted MSL
--
-- Inputs are drawn in [-2^40, 2^40) -- the massive-activation regime.
-- Products reach ~2^80, far beyond int64 (and beyond float64's 53-bit
-- mantissa): only a genuine 128-bit path produces the right answer,
-- so twin agreement here is proof the GPU runs Path-B's arithmetic.
--
-- run from repo root: ./rail_native run tools/metal/attested_fx_demo.rail

import "stdlib/jit_emit.rail"
import "stdlib/sha256.rail"

lcg_next s = ((s * 1103515245) + 12345) % 2147483648

-- fill n slots with 41-bit signed values (two LCG draws per value);
-- returns the final seed so A and B draw from one continuous stream.
fill_fx a n s i =
  if i >= n then s
  else
    let s2 = lcg_next s in
    let s3 = lcg_next s2 in
    let v = (((s2 % 2097152) * 1048576) + (s3 % 1048576)) - 1099511627776 in
    let _ = arr_set a i v in
    fill_fx a n s3 (i + 1)

-- CPU twin: fixed-point dot via the mul_shr PRIMITIVE.
-- |mul_shr(a,b,40)| <= 2^40, so a 512-wide row sum stays under 2^49.
fx_dot_row a b d base j acc =
  if j >= d then acc
  else fx_dot_row a b d base (j + 1) (acc + (mul_shr (arr_get a (base + j)) (arr_get b j) 40))

fx_rows a b out rows d i =
  if i >= rows then 0
  else
    let _ = arr_set out i (fx_dot_row a b d (i * d) 0 0) in
    fx_rows a b out rows d (i + 1)

row_str a base d j accl =
  if j >= d then join " " (reverse accl)
  else row_str a base d (j + 1) (cons (show (arr_get a (base + j))) accl)

rows_text a rows d i accl =
  if i >= rows then join "\n" (reverse accl)
  else rows_text a rows d (i + 1) (cons (row_str a (i * d) d 0 []) accl)

out_text o rows i accl =
  if i >= rows then join "\n" (reverse accl)
  else out_text o rows (i + 1) (cons (show (arr_get o i)) accl)

pi_digits cs acc =
  if (length cs) == 0 then acc
  else pi_digits (tail cs) ((acc * 10) + ((char_to_int (head cs)) - 48))

parse_i s =
  let cs = chars s in
  if (head cs) == "-" then 0 - (pi_digits (tail cs) 0)
  else pi_digits cs 0

cmp_walk lines cpu i rows mism =
  if i >= rows then mism
  else
    let g = parse_i (head lines) in
    let c = arr_get cpu i in
    let m2 = if g == c then mism else mism + 1 in
    cmp_walk (tail lines) cpu (i + 1) rows m2

main =
  let rows = 512 in
  let d = 512 in
  let shift = 40 in
  let seed = 5678 in
  let _ = shell "mkdir -p /tmp/agk" in
  -- 1. emit the GPU twin (mul_shr semantics) from the Rail emitter
  let msl = emit_msl_fx_matvec_shaped rows d shift in
  let _ = write_file "/tmp/agk/fx_matvec.metal" msl in
  -- 2. deterministic inputs in the mul_shr overflow regime
  let a = arr_new (rows * d) 0 in
  let b = arr_new d 0 in
  let s1 = fill_fx a (rows * d) seed 0 in
  let _ = fill_fx b d s1 0 in
  let atext = cat [rows_text a rows d 0 [], "\n"] in
  let btext = cat [row_str b 0 d 0 [], "\n"] in
  let _ = write_file "/tmp/agk/fxA.txt" atext in
  let _ = write_file "/tmp/agk/fxB.txt" btext in
  -- 3. CPU twin via the mul_shr primitive
  let cpu = arr_new rows 0 in
  let _ = fx_rows a b cpu rows d 0 in
  let ctext = cat [out_text cpu rows 0 [], "\n"] in
  let _ = write_file "/tmp/agk/fx_cpu_out.txt" ctext in
  -- 4. build + run the GPU twin twice (i64 input mode)
  let _ = shell "test -x /tmp/agk/ikernel_harness || clang -fobjc-arc -O2 -framework Metal -framework Foundation -o /tmp/agk/ikernel_harness tools/metal/ikernel_harness.m 2>/tmp/agk/clang_err.txt" in
  let cmd1 = cat ["/tmp/agk/ikernel_harness /tmp/agk/fx_matvec.metal fx_matvec /tmp/agk/fxA.txt /tmp/agk/fxB.txt ", show rows, " ", show d, " /tmp/agk/fx_gpu_out1.txt i64 2>/tmp/agk/fx_gpu_ms1.txt"] in
  let cmd2 = cat ["/tmp/agk/ikernel_harness /tmp/agk/fx_matvec.metal fx_matvec /tmp/agk/fxA.txt /tmp/agk/fxB.txt ", show rows, " ", show d, " /tmp/agk/fx_gpu_out2.txt i64 2>/tmp/agk/fx_gpu_ms2.txt"] in
  let _ = shell cmd1 in
  let _ = shell cmd2 in
  -- 5. verify twins + run-to-run determinism
  let gtext = read_file "/tmp/agk/fx_gpu_out1.txt" in
  let gtext2 = read_file "/tmp/agk/fx_gpu_out2.txt" in
  let lines = split "\n" gtext in
  let mism = cmp_walk lines cpu 0 rows 0 in
  let msl_h = sha256_hex msl in
  let a_h = sha256_hex atext in
  let b_h = sha256_hex btext in
  let c_h = sha256_hex ctext in
  let g_h = sha256_hex gtext in
  let g2_h = sha256_hex gtext2 in
  let det = if g_h == g2_h then "true" else "false" in
  let verdict = if mism == 0 then "TWINS-AGREE" else "TWINS-DIVERGE" in
  -- 6. attestation record
  let record = cat ["{\n",
    "  \"schema\": \"twin-kernel-attest-v0\",\n",
    "  \"kernel\": \"fx_matvec\",\n",
    "  \"semantics\": \"mul_shr (128-bit intermediate, Path-B fixed-point)\",\n",
    "  \"emitter\": \"stdlib/jit_emit.rail:emit_msl_fx_matvec_shaped\",\n",
    "  \"rows\": ", show rows, ",\n",
    "  \"d\": ", show d, ",\n",
    "  \"shift\": ", show shift, ",\n",
    "  \"seed\": ", show seed, ",\n",
    "  \"msl_sha256\": \"", msl_h, "\",\n",
    "  \"a_sha256\": \"", a_h, "\",\n",
    "  \"b_sha256\": \"", b_h, "\",\n",
    "  \"cpu_out_sha256\": \"", c_h, "\",\n",
    "  \"gpu_out_sha256\": \"", g_h, "\",\n",
    "  \"gpu_run2_sha256\": \"", g2_h, "\",\n",
    "  \"gpu_deterministic\": ", det, ",\n",
    "  \"mismatches\": ", show mism, ",\n",
    "  \"verdict\": \"", verdict, "\"\n",
    "}\n"] in
  let _ = write_file "/tmp/agk/fx_attest_record.json" record in
  -- 7. report
  let _ = print "twin-kernel attestation act 2 (mul_shr fixed-point on GPU):" in
  let _ = print (cat ["  rows x d, shift: ", show rows, " x ", show d, ", >> ", show shift]) in
  let _ = print (cat ["  sample cpu[0]:   ", show (arr_get cpu 0)]) in
  let _ = print (cat ["  mismatches:      ", show mism, " of ", show rows]) in
  let _ = print (cat ["  cpu_out sha256:  ", c_h]) in
  let _ = print (cat ["  gpu_out sha256:  ", g_h]) in
  let _ = print (cat ["  gpu run1==run2:  ", det]) in
  let _ = print (cat ["  verdict:         ", verdict]) in
  let _ = print "  record:          /tmp/agk/fx_attest_record.json" in
  if mism == 0 then 0 else 1
