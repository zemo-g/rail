-- ijit_smoke.rail — validate in-process integer JIT dispatch (Phase 0).
-- Reproduces the backward dx = W^T.dy twin (attested_backward_demo.rail
-- act 15) via stdlib/ijit.rail instead of the ikernel_harness subprocess,
-- and checks GPU==CPU bit-for-bit.  If this agrees, the in-process engine
-- is a faithful twin of the text-file harness and we can wire the loop.
--
-- run: ./rail_native run tools/metal/ijit_smoke.rail

import "stdlib/ijit.rail"

-- CPU twin: dx = W^T . dy ; W [OUT x K] row-major, packed W(OUT*K)|dy(OUT)
bwd_col w dy out k i o acc = if o >= out then acc else bwd_col w dy out k i (o + 1) (acc + ((arr_get w (o * k + i)) * (arr_get dy o)))
bwd_dx w dy dx out k i = if i >= k then 0 else let _ = arr_set dx i (mul_shr (bwd_col w dy out k i 0 0) 1 24) in bwd_dx w dy dx out k (i + 1)

lcg s = ((s * 1103515245) + 12345) % 2147483648
fillv a n s i lo rng = if i >= n then s else let s2 = lcg s in let _ = arr_set a i ((s2 % rng) - lo) in fillv a n s2 (i + 1) lo rng
copy_seg src soff dst n i = if i >= n then 0 else let _ = arr_set dst i (arr_get src (soff + i)) in copy_seg src soff dst n (i + 1)
cmp_arr a b n i mism = if i >= n then mism else cmp_arr a b n (i + 1) (if (arr_get a i) == (arr_get b i) then mism else mism + 1)

run_one d =
  let mmtotal = (d * d) + d in
  let bp = arr_new mmtotal 0 in
  let s1 = fillv bp (d * d) 771 0 524288 1048576 in
  let _  = fillv bp mmtotal s1 (d * d) 8388608 16777216 in
  -- CPU reference
  let w = arr_new (d * d) 0 in let dy = arr_new d 0 in
  let _ = copy_seg bp 0 w (d * d) 0 in let _ = copy_seg bp (d * d) dy d 0 in
  let dxc = arr_new d 0 in
  let _ = bwd_dx w dy dxc d d 0 in
  -- GPU in-process: emit -> compile once -> dispatch
  let kid = ijit_compile (emit_msl_fx_matmul_bwd_shaped d d) in
  let _ = if kid < 0 then print (cat ["  COMPILE FAILED kid=", show kid]) else 0 in
  let dxg = arr_new d 0 in
  let rc = ijit_run kid bp bp dxg mmtotal 1 d d in
  let mism = cmp_arr dxc dxg d 0 0 in
  let _ = print (cat ["  d=", show d, " rc=", show rc, " mism=", show mism,
    " dxc[0..2]=", show (arr_get dxc 0), " ", show (arr_get dxc 1), " ", show (arr_get dxc 2),
    " dxg[0..2]=", show (arr_get dxg 0), " ", show (arr_get dxg 1), " ", show (arr_get dxg 2)]) in
  mism

main =
  let _ = print "in-process integer JIT dispatch smoke (dx = W^T.dy twin):" in
  let m1 = run_one 64 in
  let m2 = run_one 768 in
  let total = m1 + m2 in
  let _ = print (cat ["verdict: ", if total == 0 then "IN-PROCESS-TWIN-AGREES" else "DIVERGE"]) in
  if total == 0 then 0 else 1
