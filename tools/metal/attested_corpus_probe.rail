-- attested_corpus_probe.rail -- STAGE 1 of the shared A+B foundation (2026-07-05).
-- Reads a REAL batch from the tokenized corpus (train.bin, uint16 LE) that the MLX
-- pretrain path already uses, so the attested F=24 engine trains/witnesses on the
-- same data. Ground truth (Python): tokens[1000:1009] = 4051 349 11551 191 6640
-- 1134 252 3496 2683. Batch digest is sha256 over the comma-joined ids as TEXT
-- (not raw uint16 bytes) -- avoids the Rail cat-drops-NUL trap and is reproducible
-- identically on the Python side (hash the same comma string).
--
-- run: ./rail_native run tools/metal/attested_corpus_probe.rail

import "stdlib/file.rail"
import "stdlib/sha256.rail"

foreign pread fd buf count offset -> int
foreign malloc size -> ptr
foreign free p

-- read L tokens starting at token index `start` from a uint16-LE .bin into ids
read_tok buf ids L i = if i >= L then 0 else let _ = arr_set ids i ((byte_at buf (2 * i)) + 256 * (byte_at buf (2 * i + 1))) in read_tok buf ids L (i + 1)
load_batch path start L =
  let fd = fopen path "rb" in
  let nb = 2 * L in
  let buf = malloc nb in
  let _ = pread fd buf nb (2 * start) in
  let ids = arr_new L 0 in
  let _ = read_tok buf ids L 0 in
  let _ = free buf in let _ = fclose fd in ids

-- canonical batch text: "t0,t1,...,t{L-1}"  (no NULs; both sides hash this)
ids_csv ids L i acc = if i >= L then acc else ids_csv ids L (i + 1) (if i == 0 then show (arr_get ids i) else cat [acc, ",", show (arr_get ids i)])
show9 ids i acc = if i >= 9 then acc else show9 ids (i + 1) (cat [acc, " ", show (arr_get ids i)])

main =
  let path = cat [getenv "HOME", "/projects/rail-training/attested-base/pilot/data/train.bin"] in
  if (read_file_size path) < 1000 then let _ = print "FATAL train.bin missing" in 1
  else
  let L = 64 in let start = 1000 in
  let ids = load_batch path start L in
  let _ = print (cat ["batch @", show start, " L=", show L, "  first9:", show9 ids 0 ""]) in
  let csv = ids_csv ids L 0 "" in
  let dig = bytes_to_hex (sha256 csv) 32 in
  let _ = print (cat ["  csv[0..40]: ", str_sub csv 0 40]) in
  let _ = print (cat ["  batch_sha256(csv): ", dig]) in
  let ok = if (arr_get ids 0) == 4051 then (if (arr_get ids 8) == 2683 then 1 else 0) else 0 in
  let _ = print (cat ["  verdict: ", if ok == 1 then "CORPUS-READ-OK (matches Python ground truth)" else "CORPUS-READ-MISMATCH"]) in
  if ok == 1 then 0 else 1
