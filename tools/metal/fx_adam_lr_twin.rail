-- fx_adam_lr_twin.rail -- twin gate for the runtime-LR Adam kernel (Build 3).
-- emit_msl_fx_adam_step_lr must be BIT-IDENTICAL to the certified baked-LR
-- emit_msl_fx_adam_step at equal lr, across W'/m'/v', for several lr values
-- spanning the schedule range (floor 1e-5, sane 1e-4, hot 5e-3).
--
-- Deterministic integer fills (no randomness in Rail by design): mixed-sign W/m/G,
-- non-negative v (second moment). Any mismatch -> FAIL (exit 1).
--
-- run: ./rail_native --out-prefix /tmp/adamlr tools/metal/fx_adam_lr_twin.rail && /tmp/adamlr

import "stdlib/ijit.rail"

fill_ws A n i = if i >= n then 0 else let x = i * 2654435761 in let r = x - (x / 33554432) * 33554432 in let _ = arr_set A i (r - 16777216) in fill_ws A n (i + 1)
fill_ms A n i = if i >= n then 0 else let x = i * 1597334677 in let r = x - (x / 8388608) * 8388608 in let _ = arr_set A i (r - 4194304) in fill_ms A n (i + 1)
fill_vs A n i = if i >= n then 0 else let x = i * 2246822519 in let r = x - (x / 16777216) * 16777216 in let _ = arr_set A i r in fill_vs A n (i + 1)
fill_gs A n i = if i >= n then 0 else let x = i * 3266489917 in let r = x - (x / 67108864) * 67108864 in let _ = arr_set A i (r - 33554432) in fill_gs A n (i + 1)
cpseg src soff dst doff n i = if i >= n then 0 else let _ = arr_set dst (doff + i) (arr_get src (soff + i)) in cpseg src soff dst doff n (i + 1)
mism A B n i c = if i >= n then c else mism A B n (i + 1) (if (arr_get A i) == (arr_get B i) then c else c + 1)

-- one lr trial: baked kernel vs runtime-lr kernel on identical inputs
trial n b1 b2 eps c1 c2 W m v G lr =
  let kOld = ijit_compile (emit_msl_fx_adam_step n b1 b2 eps lr) in
  let kNew = ijit_compile (emit_msl_fx_adam_step_lr n b1 b2 eps) in
  let Po = arr_new (3 * n + 2) 0 in
  let _ = cpseg W 0 Po 0 n 0 in let _ = cpseg m 0 Po n n 0 in let _ = cpseg v 0 Po (2 * n) n 0 in
  let _ = arr_set Po (3 * n) c1 in let _ = arr_set Po (3 * n + 1) c2 in
  let Oo = arr_new (3 * n) 0 in
  let _ = ijit_run kOld Po G Oo (3 * n + 2) n (3 * n) n in
  let Pn = arr_new (3 * n + 3) 0 in
  let _ = cpseg W 0 Pn 0 n 0 in let _ = cpseg m 0 Pn n n 0 in let _ = cpseg v 0 Pn (2 * n) n 0 in
  let _ = arr_set Pn (3 * n) c1 in let _ = arr_set Pn (3 * n + 1) c2 in let _ = arr_set Pn (3 * n + 2) lr in
  let On = arr_new (3 * n) 0 in
  let _ = ijit_run kNew Pn G On (3 * n + 3) n (3 * n) n in
  let bad = mism Oo On (3 * n) 0 0 in
  let _ = print (cat ["  lr=", show lr, "  mismatches over W'/m'/v' (", show (3 * n), " elems): ", show bad]) in
  bad

main =
  let n = 4096 in
  let b1 = 15099494 in let b2 = 16760439 in let eps = 16777 in
  let c1 = 1677722 in let c2 = 16777 in   -- step-1 bias correction (worst case: largest mhat/vhat blowup)
  let W = arr_new n 0 in let _ = fill_ws W n 0 in
  let m = arr_new n 0 in let _ = fill_ms m n 0 in
  let v = arr_new n 0 in let _ = fill_vs v n 0 in
  let G = arr_new n 0 in let _ = fill_gs G n 0 in
  let _ = print "TWIN GATE: emit_msl_fx_adam_step_lr (runtime LR) vs certified baked-LR kernel" in
  let bad1 = trial n b1 b2 eps c1 c2 W m v G 168 in
  let bad2 = trial n b1 b2 eps c1 c2 W m v G 1677 in
  let bad3 = trial n b1 b2 eps c1 c2 W m v G 83886 in
  let total = bad1 + bad2 + bad3 in
  let _ = print (cat ["verdict: ", if total == 0 then "ADAM-LR-TWIN-OK -- runtime-LR kernel is bit-identical to the certified kernel" else "ADAM-LR-TWIN-FAIL"]) in
  if total == 0 then 0 else 1
