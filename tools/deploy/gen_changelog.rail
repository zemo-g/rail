-- gen_changelog.rail — Render CHANGELOG.md as /changelog on ledatic.org
-- Usage: ./rail_native run tools/deploy/gen_changelog.rail
--
-- Emits a full HTML page with <article id="vX.Y.Z"> per release, so feed
-- entries can deep-link to /changelog#v3.3.0.  Reuses /feed.css for styling.

cat parts = join "" parts
trim s = head (split "\n" s)

site_origin = "https://ledatic.org"

-- ── File-append helper (avoids giant in-memory string concat) ──
w path s =
  let _ = write_file "/tmp/_cl.txt" s
  shell (cat ["cat /tmp/_cl.txt >> ", path])

-- ── String helpers ──
str_len s = length (chars s)

str_starts_with prefix s =
  let pc = chars prefix
  let sc = chars s
  sw_loop pc sc

sw_loop pc sc =
  if length pc == 0 then true
  else if length sc == 0 then false
  else if head pc == head sc then sw_loop (tail pc) (tail sc)
  else false

-- ── Markdown stripping (same as gen_feed.rail) ──
clean_md s =
  let s1 = str_replace "**" "" s
  let s2 = str_replace "\n### " "\n" s1
  let s3 = str_replace "\n## " "\n" s2
  let s4 = str_replace "\n- " "\n• " s3
  let s5 = if str_starts_with "### " s4 then str_sub s4 4 (str_len s4 - 4) else s4
  let s6 = if str_starts_with "## " s5 then str_sub s5 3 (str_len s5 - 3) else s5
  let s7 = if str_starts_with "- " s6 then cat ["• ", str_sub s6 2 (str_len s6 - 2)] else s6
  s7

-- ── HTML escaping (element text) ──
esc_html s =
  let s1 = join "&amp;" (split "&" s)
  let s2 = join "&lt;" (split "<" s1)
  join "&gt;" (split ">" s2)

-- ── text → HTML paragraphs ──
text_to_html text =
  let paras = str_split "\n\n" text
  html_paras_loop paras ""

html_paras_loop paras acc =
  if length paras == 0 then acc
  else
    let p = head paras
    let p_trim = trim_ws p
    if str_len p_trim == 0 then html_paras_loop (tail paras) acc
    else
      let with_br = str_replace "\n" "<br/>" (esc_html p_trim)
      let wrapped = cat ["<p>", with_br, "</p>"]
      html_paras_loop (tail paras) (cat [acc, wrapped])

trim_ws s =
  let cs = chars s
  let dropped = drop_ws_left cs
  let reversed = reverse dropped
  let dropped2 = drop_ws_left reversed
  join "" (reverse dropped2)

drop_ws_left cs =
  if length cs == 0 then cs
  else
    let c = head cs
    if c == " " then drop_ws_left (tail cs)
    else if c == "\n" then drop_ws_left (tail cs)
    else if c == "\t" then drop_ws_left (tail cs)
    else cs

-- ── Header parsing ──
is_digit c = str_contains c "0123456789"

find_date_at s =
  let n = length (chars s)
  find_date_loop (chars s) 0 n

find_date_loop cs i n =
  if i + 10 > n then ""
  else
    let c0 = nth_char cs i
    let c1 = nth_char cs (i + 1)
    let c2 = nth_char cs (i + 2)
    let c3 = nth_char cs (i + 3)
    let c4 = nth_char cs (i + 4)
    let c7 = nth_char cs (i + 7)
    if is_digit c0 then
      if is_digit c1 then
        if is_digit c2 then
          if is_digit c3 then
            if c4 == "-" then
              if c7 == "-" then
                join "" [c0, c1, c2, c3, "-", nth_char cs (i + 5), nth_char cs (i + 6), "-", nth_char cs (i + 8), nth_char cs (i + 9)]
              else find_date_loop cs (i + 1) n
            else find_date_loop cs (i + 1) n
          else find_date_loop cs (i + 1) n
        else find_date_loop cs (i + 1) n
      else find_date_loop cs (i + 1) n
    else find_date_loop cs (i + 1) n

nth_char cs n =
  if n <= 0 then head cs
  else nth_char (tail cs) (n - 1)

split_first_space s =
  let parts = split " " s
  head parts

extract_title header =
  let parts = str_split " — " header
  if length parts < 2 then header
  else last_of parts

last_of xs =
  if length xs == 0 then ""
  else if length (tail xs) == 0 then head xs
  else last_of (tail xs)

-- Strip leading/trailing * from *italicized* release titles
strip_italics s =
  let s1 = if str_starts_with "*" s then str_sub s 1 (str_len s - 1) else s
  if str_len s1 == 0 then s1
  else if nth_char (chars s1) (str_len s1 - 1) == "*" then str_sub s1 0 (str_len s1 - 1) else s1

-- Normalize version token — anchors must match whatever gen_feed.rail emits
-- ("v3.3.0" etc).  Range headers like "v2.17.0 – v2.21.0" keep the first.
version_of header =
  let first = split_first_space header
  cat ["v", first]

-- ── Sections ──
get_sections txt =
  let parts = str_split "\n## v" txt
  tail parts

-- ── Emit a single article, appended to path ──
emit_article path sec =
  let lines = split "\n" sec
  let header = head lines
  let version = version_of header
  let raw_title = extract_title header
  let title = strip_italics raw_title
  let date = find_date_at header
  let body = join "\n" (tail lines)
  let clean_body = clean_md body
  let html_body = text_to_html clean_body
  let _ = w path (cat ["<article id=\"", version, "\">\n"])
  let _ = w path (cat ["<h2><a href=\"#", version, "\">", version, "</a> <span class=\"sep\">—</span> <span class=\"rt\">", esc_html title, "</span></h2>\n"])
  let _ = w path (cat ["<time>", date, "</time>\n"])
  let _ = w path (cat ["<div class=\"content\">", html_body, "</div>\n"])
  w path "</article>\n"

emit_all path secs =
  if length secs == 0 then 0
  else
    let _ = emit_article path (head secs)
    emit_all path (tail secs)

-- ── Navigation: list of versions on the left ──
emit_nav path secs =
  let _ = w path "<nav class=\"toc\"><h3>versions</h3><ul>\n"
  let _ = emit_nav_loop path secs
  w path "</ul></nav>\n"

emit_nav_loop path secs =
  if length secs == 0 then 0
  else
    let sec = head secs
    let lines = split "\n" sec
    let header = head lines
    let version = version_of header
    let date = find_date_at header
    let _ = w path (cat ["<li><a href=\"#", version, "\">", version, "</a> <span class=\"d\">", date, "</span></li>\n"])
    emit_nav_loop path (tail secs)

main =
  let _ = print "=== gen_changelog.rail ==="
  let f = "/tmp/changelog.html"
  let _ = shell (cat ["rm -f ", f])
  let txt = read_file "CHANGELOG.md"
  let secs = get_sections txt
  let _ = print (cat ["CHANGELOG sections: ", show (length secs)])

  -- HEAD
  let _ = w f "<!DOCTYPE html><html lang=\"en\"><head>"
  let _ = w f "<meta charset=\"UTF-8\">"
  let _ = w f "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">"
  let _ = w f "<title>Rail · Changelog</title>"
  let _ = w f "<meta name=\"description\" content=\"All Rail releases, newest first. A self-hosting functional language.\">"
  let _ = w f "<link rel=\"stylesheet\" href=\"/changelog.css\">"
  let _ = w f "<link rel=\"alternate\" type=\"application/atom+xml\" title=\"Rail releases\" href=\"/feed.xml\">"
  let _ = w f "</head><body>"

  let _ = w f "<header>"
  let _ = w f "<h1>Rail · Changelog</h1>"
  let _ = w f "<p>All Rail releases, newest first. Subscribe to the <a href=\"/feed.xml\">Atom feed</a> &middot; back to <a href=\"/\">ledatic.org</a>.</p>"
  let _ = w f "</header>"

  let _ = w f "<main>"
  let _ = emit_nav f secs
  let _ = w f "<div class=\"entries\">"
  let _ = emit_all f secs
  let _ = w f "</div>"
  let _ = w f "</main>"

  let _ = w f "<footer>"
  let _ = w f "Source: <a href=\"https://github.com/zemo-g/rail/blob/next/CHANGELOG.md\">CHANGELOG.md</a>"
  let _ = w f "</footer>"
  let _ = w f "</body></html>"

  let _ = print "deploying /changelog..."
  let _ = print (shell "./rail_native run tools/deploy/cf_deploy.rail /tmp/changelog.html changelog 2>&1")
  0
