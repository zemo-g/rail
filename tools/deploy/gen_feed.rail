-- gen_feed.rail — Generate Atom 1.0 feed from CHANGELOG.md
-- Usage: ./rail_native run tools/deploy/gen_feed.rail
-- Output: /tmp/feed.xml (ready for cf_deploy.rail to push to /feed.xml KV key)

cat parts = join "" parts

site_origin = "https://ledatic.org"
feed_title = "Rail"
feed_subtitle = "A self-hosting functional language. Updates from ledatic.org."
feed_author = "zemo-g"
max_entries = 15

-- ── XML escaping ──
esc_amp s = join "&amp;" (split "&" s)
esc_lt s = join "&lt;" (split "<" s)
esc_gt s = join "&gt;" (split ">" s)
esc_quot s = join "&quot;" (split "\"" s)
esc s = esc_quot (esc_gt (esc_lt (esc_amp s)))

-- ── Markdown → readable plain text ──
-- Removes ugly markup so feed readers don't show literal **, ###, etc.
-- Keep backticks (code refs read fine), convert bullets to •.
clean_md s =
  let s1 = str_replace "**" "" s
  let s2 = str_replace "\n### " "\n" s1
  let s3 = str_replace "\n## " "\n" s2
  let s4 = str_replace "\n- " "\n• " s3
  let s5 = if str_starts_with "### " s4 then str_sub s4 4 (str_len s4 - 4) else s4
  let s6 = if str_starts_with "## " s5 then str_sub s5 3 (str_len s5 - 3) else s5
  let s7 = if str_starts_with "- " s6 then cat ["• ", str_sub s6 2 (str_len s6 - 2)] else s6
  s7

-- ── Header parsing ──
-- Header forms seen in CHANGELOG:
--   vX.Y.Z — YYYY-MM-DD — title
--   vX.Y.Z (YYYY-MM-DD) — title
--   vX.Y.Z – vA.B.C (YYYY-MM-DD) — title   (range form)
-- The leading "## v" is already stripped by the split, so section[0] starts with "X.Y.Z"

-- Extract version token (everything up to first space)
split_first_space s =
  let parts = split " " s
  head parts

-- Find 10-char YYYY-MM-DD date pattern starting at given index
-- Returns "" if not found
is_digit c = str_contains c "0123456789"

find_date_at s =
  let n = length (chars s)
  find_date_loop (chars s) 0 n

find_date_loop cs i n =
  if i + 10 > n then ""
  else
    let c0 = nth_char cs i
    let c1 = nth_char cs (i + 1)
    let c2 = nth_char cs (i + 2)
    let c3 = nth_char cs (i + 3)
    let c4 = nth_char cs (i + 4)
    let c7 = nth_char cs (i + 7)
    if is_digit c0 then
      if is_digit c1 then
        if is_digit c2 then
          if is_digit c3 then
            if c4 == "-" then
              if c7 == "-" then
                join "" [c0, c1, c2, c3, "-", nth_char cs (i + 5), nth_char cs (i + 6), "-", nth_char cs (i + 8), nth_char cs (i + 9)]
              else find_date_loop cs (i + 1) n
            else find_date_loop cs (i + 1) n
          else find_date_loop cs (i + 1) n
        else find_date_loop cs (i + 1) n
      else find_date_loop cs (i + 1) n
    else find_date_loop cs (i + 1) n

nth_char cs n =
  if n <= 0 then head cs
  else nth_char (tail cs) (n - 1)

-- Extract title: the text after the LAST " — " separator
-- (em-dash surrounded by spaces). Fallback: full header.
extract_title header =
  let parts = str_split " — " header
  if length parts < 2 then header
  else last_of parts

last_of xs =
  if length xs == 0 then ""
  else if length (tail xs) == 0 then head xs
  else last_of (tail xs)

-- Strip trailing * or italic markers from title (CHANGELOG uses *italics*)
strip_italics s =
  let s1 = if str_starts_with "*" s then str_sub s 1 (str_len s - 1) else s
  if str_ends_with "*" s1 then str_sub s1 0 (str_len s1 - 1) else s1

str_starts_with prefix s =
  let pc = chars prefix
  let sc = chars s
  sw_loop pc sc

sw_loop pc sc =
  if length pc == 0 then true
  else if length sc == 0 then false
  else if head pc == head sc then sw_loop (tail pc) (tail sc)
  else false

str_ends_with suffix s =
  let n = str_len s
  let m = str_len suffix
  if m > n then false
  else str_sub s (n - m) m == suffix

str_len s = length (chars s)

-- ── Section → (version, date, title, body) ──
-- Input: text of one section (minus the leading "## v")
-- Output: list [version, date, title, body]
parse_section sec =
  let lines = split "\n" sec
  let header = head lines
  let version = cat ["v", split_first_space header]
  let date = find_date_at header
  let raw_title = extract_title header
  let title = strip_italics raw_title
  -- Body: skip header line, then trim trailing empty lines
  let body_lines = tail lines
  let body = join "\n" body_lines
  cons version (cons date (cons title (cons body [])))

-- ── Sections from CHANGELOG ──
-- We split on "\n## v" then the head is the pre-# preamble (skip it).
get_sections txt =
  let parts = str_split "\n## v" txt
  tail parts

-- Limit to first N sections (latest releases)
take_n xs n =
  if n <= 0 then []
  else if length xs == 0 then []
  else cons (head xs) (take_n (tail xs) (n - 1))

-- ── Atom feed emission ──
now_iso =
  let raw = shell "date -u +'%Y-%m-%dT%H:%M:%SZ'"
  head (split "\n" raw)

entry_xml sec =
  let parsed = parse_section sec
  let version = head parsed
  let date = head (tail parsed)
  let title = head (tail (tail parsed))
  let body = head (tail (tail (tail parsed)))
  let updated = if date == "" then now_iso else cat [date, "T00:00:00Z"]
  let anchor = cat [site_origin, "/#", version]
  let entry_id = cat [site_origin, "/releases/", version]
  let clean_body = clean_md body
  cat [
    "  <entry>\n",
    "    <title>", esc version, " — ", esc title, "</title>\n",
    "    <link href=\"", anchor, "\"/>\n",
    "    <id>", entry_id, "</id>\n",
    "    <updated>", updated, "</updated>\n",
    "    <summary>", esc title, "</summary>\n",
    "    <content type=\"text\">", esc clean_body, "</content>\n",
    "  </entry>\n"]

emit_entries secs =
  if length secs == 0 then ""
  else
    let first = entry_xml (head secs)
    let rest = emit_entries (tail secs)
    cat [first, rest]

build_feed secs =
  let body_entries = emit_entries secs
  let feed_updated = now_iso
  cat [
    "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n",
    "<?xml-stylesheet type=\"text/xsl\" href=\"/feed.xsl\"?>\n",
    "<feed xmlns=\"http://www.w3.org/2005/Atom\">\n",
    "  <title>", feed_title, "</title>\n",
    "  <subtitle>", feed_subtitle, "</subtitle>\n",
    "  <link href=\"", site_origin, "/feed.xml\" rel=\"self\"/>\n",
    "  <link href=\"", site_origin, "/\"/>\n",
    "  <updated>", feed_updated, "</updated>\n",
    "  <id>", site_origin, "/</id>\n",
    "  <author><name>", feed_author, "</name></author>\n",
    body_entries,
    "</feed>\n"]

main =
  let _ = print "=== gen_feed.rail ==="
  let txt = read_file "CHANGELOG.md"
  let all_secs = get_sections txt
  let n_total = length all_secs
  let secs = take_n all_secs max_entries
  let _ = print (cat ["CHANGELOG sections: ", show n_total, ", feeding latest ", show (length secs)])
  let feed = build_feed secs
  let _ = write_file "/tmp/feed.xml" feed
  let _ = print (cat ["wrote /tmp/feed.xml (", show (str_len feed), " bytes)"])
  let _ = print "preview (first entry):"
  let p_parts = str_split "</entry>" feed
  let _ = print (cat [head p_parts, "</entry>"])
  0
