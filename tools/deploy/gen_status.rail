-- tools/deploy/gen_status.rail — emits docs/STATUS.md, the verified truth matrix.
--
-- Rail computes its own status. Every number is recomputed from the source tree
-- on each run, so docs/STATUS.md cannot drift out of sync with reality (the bug
-- that an external review found across the hand-written docs). Where a claim
-- needs proof, the COMMAND to verify it is printed instead of a hardcoded value
-- the reader has to trust. Provenance, not assertion. "Check me", not "trust me".
--
-- Run from the repo root:  ./rail_native run tools/deploy/gen_status.rail

-- `cat` and `trim` are defined locally (trim is a phantom builtin — declared but
-- not code-generated, so it links only if defined here; mirrors gen_site.rail).
cat parts = join "" parts
trim s = head (split "\n" s)

-- Append one chunk to the output file (bump-allocator-safe: never builds the
-- whole document in memory, mirrors tools/deploy/gen_site.rail).
w path s =
  let _ = write_file "/tmp/_status_chunk.txt" s
  let _ = shell (cat ["cat /tmp/_status_chunk.txt >> ", path])
  0

main =
  let out = "docs/STATUS.md"
  let _ = shell (cat ["rm -f ", out])

  -- Facts recomputed from the tree (these are the ones the hand-docs drifted on).
  let date      = trim (shell "date -u '+%Y-%m-%d %H:%M UTC'")
  let version   = trim (shell "git describe --tags --abbrev=0 2>/dev/null")
  let loc       = trim (shell "wc -l < tools/compile.rail | tr -d ' '")
  let bin_sha   = trim (shell "shasum -a 256 rail_native | awk '{print $1}'")
  let bin_bytes = trim (shell "wc -c < rail_native | tr -d ' '")
  let stdlib_n  = trim (shell "ls -1 stdlib/*.rail | wc -l | tr -d ' '")
  let shims_n   = trim (shell "grep -m1 -oE '[0-9]+ in-tree files' SHIMS.md | grep -oE '^[0-9]+'")

  let _ = w out (cat ["# Rail - verified status (", version, ")\n\n"])
  let _ = w out (cat ["> Generated by `tools/deploy/gen_status.rail` on ", date, ".\n"])
  let _ = w out "> Every number is recomputed from the source tree on each run, so this file\n"
  let _ = w out "> cannot drift. Where a claim needs proof, the **command** is given - run it\n"
  let _ = w out "> yourself. These are reproducible provenance facts, not a proof of correctness.\n\n"

  let _ = w out "| Fact | Value | Verify it yourself |\n|---|---|---|\n"
  let _ = w out (cat ["| Release | ", version, " | `git describe --tags` |\n"])
  let _ = w out (cat ["| Compiler | ", loc, " lines of Rail | `wc -l tools/compile.rail` |\n"])
  let _ = w out (cat ["| Seed binary | ", bin_bytes, " bytes | `wc -c rail_native` |\n"])
  let _ = w out (cat ["| Seed sha256 | `", bin_sha, "` | `shasum -a 256 rail_native` |\n"])
  let _ = w out (cat ["| Stdlib | ", stdlib_n, " modules | `ls stdlib/*.rail \\| wc -l` |\n"])
  let _ = w out (cat ["| Non-Rail surface | ", shims_n, " in-tree files | `SHIMS.md` |\n"])
  let _ = w out "| Tests | runner self-reports N/N | `./rail_native test` |\n"
  let _ = w out "| Self-host | byte-identical fixed point | `./rail_native self && cmp rail_native /tmp/rail_self` |\n\n"

  let _ = w out "## Dependency boundary\n\n"
  let _ = w out "The seed binary has **no C**: the GC and runtime are ARM64 assembly embedded in the\n"
  let _ = w out "compiler, and since v5.2.0 it assembles, links, and code-signs itself (no `as` / `ld` /\n"
  let _ = w out (cat ["`codesign`). Optional concurrency, GPU (Metal), and JIT features use a small\n",
                      "asm/ObjC/C boundary - ", shims_n, " in-tree non-Rail files, each named in [`SHIMS.md`](../SHIMS.md).\n\n"])

  let _ = w out "## Backends\n\n"
  let _ = w out "ARM64 macOS (native) - Linux ARM64 - Linux x86_64 - WebAssembly (compiles; runtime\n"
  let _ = w out "fragile) - Cortex-M4 (Thumb-2) - RISC-V rv32imc.\n\n"

  let _ = w out "## Known surprising behaviors\n\n"
  let _ = w out "Compilation proves a program is *accepted by the binary you run*, not that it is\n"
  let _ = w out "*correct*. These are defined, but easy to trip over:\n\n"
  let _ = w out "- `&&` / `||` do not short-circuit - both sides always evaluate\n"
  let _ = w out "- `split` takes a single-character delimiter (use `str_split` for multi-char)\n\n"

  let _ = w out "## What this proves\n\n"
  let _ = w out "Signed, reproducible provenance: where the bytes came from and how to reproduce them.\n"
  let _ = w out "Not a proof of correctness, and not numerical truth. The defensible claim is **check\n"
  let _ = w out "me**, never *proof of truth*.\n"

  let _ = print (cat ["wrote ", out, "  (", version, ", ", loc, " loc, ", stdlib_n,
                      " stdlib, ", shims_n, " non-Rail, seed ", bin_sha, ")"])
  0
