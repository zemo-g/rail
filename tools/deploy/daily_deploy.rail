-- daily_deploy.rail — Rebuild and deploy dynamic ledatic.org pages
-- Called by com.ledatic.site-deploy at 06:00 daily
-- Usage: ./rail_native run tools/deploy/daily_deploy.rail
--
-- Static pages (home, rail, plasma, fleet, entropy, manifesto, playground,
-- changelog landing) live in Ledatic-Empire/ledatic-site and deploy from
-- there via deploy.sh. This script rebuilds the Rail-generated pages that
-- depend on live repo state.

cat parts = join "" parts
trim s = head (split "\n" s)

main =
  let _ = print (cat ["=== ", trim (shell "date -u"), " ==="])

  let _ = print "[1/2] Shared main.css + main.js + /llms.txt..."
  let _ = print (shell "./rail_native run tools/deploy/gen_site.rail 2>&1")

  let _ = print "[2/2] Atom feed (/feed.xml)..."
  let _ = print (shell "./rail_native run tools/deploy/gen_feed.rail 2>&1")

  let _ = print "Daily deploy complete."
  0
