-- tools/desk/quartz_smoke.rail
--
-- Minimal link-path smoke. Verifies that compile.rail auto-links
-- libquartz_bridge.dylib when stdlib/quartz.rail is imported.
--
-- Success criteria (link-path only):
--   - Compiles + links cleanly via `./rail_native run tools/desk/quartz_smoke.rail`
--   - Binary runs without "Symbol not found: _qb_init" error
--   - qb_init returns 0 (Accessibility granted) or -1 (not granted) — both fine
--     for the link smoke; we're testing that the foreign symbol resolves at all.
--
-- For a sustained event-flow test, see (TODO) tools/desk/quartz_event_smoke.rail.

import "stdlib/quartz.rail"

main =
  let _ = print "qb_init(0)..."
  let r = qb_init 0
  let _ = print (cat ["  qb_init returned ", show r, " (0=ok, -1=permission-denied or not-yet-granted)"])
  let _ = qb_shutdown 0
  let _ = print "qb_shutdown returned"
  0
