-- tools/runtime/test_concurrent.rail
--
-- Smoke for stdlib/concurrent.rail: producer/consumer through a bounded
-- blocking channel. Spawns one producer that sends 1..10, one consumer that
-- recvs+sums until close. Verifies sum == 55.
--
-- Build:
--   bash tools/runtime/build_concurrent.sh    # one-time, builds libconcurrent.dylib
--   ./rail_native run tools/runtime/test_concurrent.rail
--
-- Expected output:
--   sum=55
-- Expected exit: 0

import "stdlib/concurrent.rail"

main =
  let ch = rc_chan_make 4
  let _ = if ch == 0 then
            let _ = print "FAIL: rc_chan_make returned 0"
            0
          else 0
  let pt = rc_spawn_producer ch 10
  let ct = rc_spawn_consumer ch
  let _ = if pt == 0 then
            let _ = print "FAIL: rc_spawn_producer returned 0"
            0
          else 0
  let _ = if ct == 0 then
            let _ = print "FAIL: rc_spawn_consumer returned 0"
            0
          else 0
  let _producer_result = rc_join pt
  let sum = rc_join ct
  let _ = print (cat ["sum=", show sum])
  if sum == 55 then 0 else 1

cat parts = join "" parts
