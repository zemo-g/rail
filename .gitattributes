# Linguist overrides — Rail is the primary language
# (Haskell is a syntax-highlighting approximation: linguist has no Rail
# grammar yet, and Haskell's is the closest visual match.)
*.rail linguist-language=Haskell
tools/linux_libc.s linguist-vendored
tools/gpu_host.m linguist-vendored
tree-sitter-rail/** linguist-vendored
examples/*.css linguist-vendored
