{
  "grammars": [
    {
      "name": "rail",
      "camelcase": "Rail",
      "scope": "source.rail",
      "path": ".",
      "file-types": [
        "rail"
      ],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Rail programming language",
    "authors": [
      {
        "name": "zemo-g"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-rail"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
