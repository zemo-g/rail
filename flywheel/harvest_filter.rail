-- flywheel/harvest_filter.rail — Rebuild the self-train harvest.
--
-- Why: training/self_train/harvest.jsonl carries whatever the oracle
-- accepted at capture time.  The oracle has tightened since —
-- oracle_min_nw_for_bonus (64 → 128), oracle_min_unique_chars (4 → 8),
-- oracle_min_decls_for_bonus (new, 2026-04-20) — so many old entries
-- like `main = let _ = print (show (x - x)) in 0` now score 0.  Filter
-- the whole file through today's oracle + a SHA-256 dedup (same idiom
-- as flywheel/dataset.rail) and write the survivors to
-- harvest_clean_v2.jsonl.  The existing harvest_clean.jsonl stays as
-- the previous canonical — v2 is additive.
--
-- Pipeline:
--   1. Back up raw harvest.jsonl (cp -n — idempotent on re-run).
--   2. Python helper: JSONL parse + SHA-256 dedup + extract assistant
--      content → /tmp/rail_hf_prep/{manifest.tsv, content_<i>.txt,
--      line_<i>.jsonl, stats.tsv}.
--   3. Rail scoring per unique item: count_top_level_decls + oracle_quality.
--   4. Python helper: build HARVEST_FILTER_REPORT.md from TSV logs.
--
-- Usage:
--   cd ~/projects/rail && ./rail_native run flywheel/harvest_filter.rail

-- oracle.rail already pulls in file.rail transitively; importing it
-- here as well triggers duplicate foreign-symbol errors.
import "stdlib/oracle.rail"

harvest_path = "training/self_train/harvest.jsonl"
backup_path = "training/self_train/harvest.jsonl.pre_filter_2026_04_20"
v2_path = "training/self_train/harvest_clean_v2.jsonl"
prep_dir = "/tmp/rail_hf_prep"
manifest_path = "/tmp/rail_hf_prep/manifest.tsv"
keeps_tsv = "/tmp/rail_hf_prep/keeps.tsv"
drops_tsv = "/tmp/rail_hf_prep/drops.tsv"

-- ── Stage 1 ─ backup ──────────────────────────────────────────────
backup _ =
  let _ = shell (cat ["cp -n ", harvest_path, " ", backup_path])
  par_rstrip_nl (shell (cat ["wc -l < ", harvest_path]))

-- ── Stage 2 ─ Python dedup + extract ──────────────────────────────
run_prep _ =
  shell "python3 flywheel/harvest_filter_prep.py 2>&1"

-- ── Stage 3 ─ per-item scoring ────────────────────────────────────
read_manifest_idxs _ =
  let raw = shell (cat ["awk '{print $1}' ", manifest_path])
  str_split "\n" raw

-- Append the original JSONL line to the v2 file.  `cat` on a file
-- preserves newline tails; the line file already has a trailing \n.
emit_survivor idx =
  shell (cat ["cat ", prep_dir, "/line_", idx, ".jsonl >> ", v2_path])

-- Log kept + dropped to TSVs for the report generator.  Awk-friendly
-- TSV keeps the report script simple.
log_keep idx decls q clen =
  let entry = cat [idx, "\t", show decls, "\t", show q, "\t", show clen, "\n"]
  let _ = write_file "/tmp/rail_hf_entry.tmp" entry
  shell (cat ["cat /tmp/rail_hf_entry.tmp >> ", keeps_tsv])

log_drop idx decls q clen =
  let first = par_rstrip_nl (shell (cat ["head -1 ", prep_dir, "/content_", idx, ".txt | tr '\\n\\t' '  ' | cut -c1-160"]))
  let entry = cat [idx, "\t", show decls, "\t", show q, "\t", show clen, "\t", first, "\n"]
  let _ = write_file "/tmp/rail_hf_entry.tmp" entry
  shell (cat ["cat /tmp/rail_hf_entry.tmp >> ", drops_tsv])

score_one idx =
  let content = read_file (cat [prep_dir, "/content_", idx, ".txt"])
  let decls = count_top_level_decls content
  let q = oracle_quality content
  let clen = length (chars content)
  cons decls (cons q (cons clen []))

score_loop idxs kept dropped =
  if length idxs == 0 then cons kept (cons dropped [])
  else
    let raw_idx = head idxs
    if length (chars raw_idx) == 0 then score_loop (tail idxs) kept dropped
    else
      let stats = score_one raw_idx
      let decls = head stats
      let q = head (tail stats)
      let clen = head (tail (tail stats))
      if decls >= 1 then
        if q > 0 then
          let _ = emit_survivor raw_idx
          let _ = log_keep raw_idx decls q clen
          score_loop (tail idxs) (kept + 1) dropped
        else
          let _ = log_drop raw_idx decls q clen
          score_loop (tail idxs) kept (dropped + 1)
      else
        let _ = log_drop raw_idx decls q clen
        score_loop (tail idxs) kept (dropped + 1)

-- ── Stage 4 ─ Python report ──────────────────────────────────────
run_report _ =
  shell "python3 flywheel/harvest_filter_report.py 2>&1"

-- ── main ─────────────────────────────────────────────────────────
main =
  let _ = print "── harvest filter (2026-04-20) ──"
  let raw_count_str = backup 0
  let _ = print (cat ["raw harvest lines: ", raw_count_str])

  let _ = print "prep: json parse + sha-256 dedup"
  let prep_log = run_prep 0
  let _ = print (par_rstrip_nl prep_log)

  -- Reset outputs so the run is idempotent (the prep stage already
  -- purges prep_dir; we only need to reset v2 + tsv logs here).
  let _ = shell (cat ["rm -f ", v2_path, " ", keeps_tsv, " ", drops_tsv])
  let _ = shell (cat ["touch ", v2_path, " ", keeps_tsv, " ", drops_tsv])

  let _ = print "score: oracle gate per unique"
  let idxs = read_manifest_idxs 0
  let counts = score_loop idxs 0 0
  let kept = head counts
  let dropped = head (tail counts)
  let _ = print (cat ["kept: ", show kept, "  dropped: ", show dropped])

  let _ = print "report: building"
  let r_out = run_report 0
  let _ = print (par_rstrip_nl r_out)
  0
