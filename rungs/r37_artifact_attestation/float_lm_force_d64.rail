-- lm_transformer.rail — single-block pre-norm causal transformer LM.
--
-- v2.5 upgrade: adds layernorm (forward + backward via dylib), residual
-- connections, and an FFN block on top of the v2.4 attention spine.
--
-- Architecture (single block, single head):
--   x_pe   = embed(X) + sin/cos PE
--   ln1    = LayerNorm(x_pe)                          ← stats saved
--   attn   = causal_self_attention(ln1)
--   x_attn = x_pe + attn                              ← residual #1
--   ln2    = LayerNorm(x_attn)                        ← stats saved
--   ffn    = ReLU(ln2 @ W_F1) @ W_F2
--   x_blk  = x_attn + ffn                             ← residual #2
--   logits = x_blk @ W_O
--
-- Trains with Adam + cosine LR.  Goal: beat the v2.3 bigram baseline
-- (loss 2.10) on the same 383-char Shakespeare excerpt.
--
-- LayerNorm gamma/beta are fixed (γ=1, β=0) — making them learnable
-- adds dgamma/dbeta accumulation loops but no fundamental capacity.
import "stdlib/transformer.rail"
import "stdlib/optim.rail"
import "stdlib/tokenizer.rail"
import "stdlib/checkpoint.rail"
import "stdlib/sha256.rail"

corpus _ =
  cat ["To be, or not to be, that is the question.\n",
       "Whether tis nobler in the mind to suffer\n",
       "the slings and arrows of outrageous fortune,\n",
       "or to take arms against a sea of troubles\n",
       "and by opposing end them. To die, to sleep,\n",
       "no more; and by a sleep to say we end\n",
       "the heart-ache and the thousand natural shocks\n",
       "that flesh is heir to: tis a consummation\n",
       "devoutly to be wished. To die, to sleep;\n"]

-- ── Weight init (deterministic scatter) ──
init_weight arr n seed =
  init_w_loop arr n seed 0

init_w_loop arr n seed i =
  if i >= n then 0
  else
    let raw = ((i * 97 + seed * 13) % 100) - 50
    -- Scale: 0.01 * raw -> range ±0.5. Tuned empirically for d=64;
    -- proper Xavier would scale with 1/sqrt(fan_in) but that needs
    -- fan_in plumbed through, deferred.
    let _ = float_arr_set arr i (0.01 * int_to_float raw)
    init_w_loop arr n (seed + 1) (i + 1)

-- ── One-hot input fill ──
-- Walk the list head-first; each position writes one hot cell for the
-- current char id. Prior versions mixed `list_nth i ids` with a tailed
-- `ids`, which skipped every other char — trained v0.1 / v0.2 on that
-- corrupted distribution. See 31e4d17 + MODEL_CARD_v0.2.md.
fill_onehot dst ids V seq i =
  if i >= seq then 0
  else
    let c = head ids
    let _ = float_arr_set dst (i * V + c) 1.0
    fill_onehot dst (tail ids) V seq (i + 1)

fill_labels arr ids seq i =
  if i >= seq then 0
  else
    let _ = float_arr_set arr i (int_to_float (head ids))
    fill_labels arr (tail ids) seq (i + 1)

-- ── Sinusoidal positional encoding [seq, d] ──
pe_loop arr seq d p k =
  if p >= seq then 0
  else if k >= d then pe_loop arr seq d (p + 1) 0
  else
    let exp_arg = int_to_float (k - (k % 2)) / int_to_float d
    let denom = pow 10000.0 exp_arg
    let angle = int_to_float p / denom
    let v = if (k % 2) == 0 then sin angle else cos angle
    let _ = float_arr_set arr (p * d + k) v
    pe_loop arr seq d p (k + 1)

build_pe seq d =
  let arr = float_arr_new (seq * d) 0.0
  let _ = pe_loop arr seq d 0 0
  arr

-- ── Helpers ──
add_buf_inplace dst src n i =
  if i >= n then 0
  else
    let cur = float_arr_get dst i
    let s = float_arr_get src i
    let _ = float_arr_set dst i (cur + s)
    add_buf_inplace dst src n (i + 1)

unwrap t = match t | Tensor d _ _ -> d

-- ReLU forward + mask save in one pass.  mask[i] = 1 if x[i]>0 else 0.
-- mask is what backward needs (no need to keep x around).
relu_fwd src dst mask n i =
  if i >= n then 0
  else
    let v = float_arr_get src i
    let pos = if v > 0.0 then 1.0 else 0.0
    let _ = float_arr_set mask i pos
    let _ = float_arr_set dst i (v * pos)
    relu_fwd src dst mask n (i + 1)

-- ReLU backward: dx = dy * mask
relu_bwd dy mask dx n i =
  if i >= n then 0
  else
    let g = float_arr_get dy i
    let m = float_arr_get mask i
    let _ = float_arr_set dx i (g * m)
    relu_bwd dy mask dx (n + 0) (i + 1)

-- ── Cross-entropy loss + grad over [seq, V] probs ──
lm_ce_loss_loop pd ld seq V acc i =
  if i >= seq then 0
  else
    let target = float_to_int (float_arr_get ld i)
    let p = float_arr_get pd (i * V + target)
    let p2 = if p < 0.00000001 then 0.00000001 else p
    let cur = float_arr_get acc 0
    let _ = float_arr_set acc 0 (cur - log p2)
    lm_ce_loss_loop pd ld seq V acc (i + 1)

ce_loss probs labels seq V = match probs
  | Tensor pd _ _ -> match labels
    | Tensor ld _ _ ->
      let acc = float_arr_new 1 0.0
      let _ = lm_ce_loss_loop pd ld seq V acc 0
      (float_arr_get acc 0) / int_to_float seq

ce_grad_loop dst probs labels seq V invN i =
  if i >= seq * V then 0
  else
    let row = i / V
    let col = i % V
    let target = float_to_int (float_arr_get labels row)
    let p = float_arr_get probs i
    let g = if col == target then (p - 1.0) * invN else p * invN
    let _ = float_arr_set dst i g
    ce_grad_loop dst probs labels seq V invN (i + 1)

-- ── Forward pass.  Returns a 13-element list:
-- [probs, attn, x_blk, ln2_out, x_attn, ln1_out, x_pe, q, k, v,
--  ffn_h_pre, ffn_h_relu_mask, ln1_mean+rstd-pair, ln2_mean+rstd-pair]
-- We pack the LN stats inline:
--   slot 12 = ln1_mean_arr   slot 13 = ln1_rstd_arr
--   slot 14 = ln2_mean_arr   slot 15 = ln2_rstd_arr
-- Everything is funneled through `unwrap` to keep the body a flat let
-- stream. ──
-- ── One transformer block (RoPE), factored so we can stack N. wblk=[wq,wk,wv,wf1,wf2].
-- Returns [x_out, attn, x_attn, ln2_out, ln1_out, q, k, v, ffn_h, ffn_mask, ln1_mean, ln1_rstd, ln2_mean, ln2_rstd]. ──
block_fwd x_in wblk ln_g ln_b seq d d_ff =
  let w_q = list_nth 0 wblk
  let w_k = list_nth 1 wblk
  let w_v = list_nth 2 wblk
  let w_f1 = list_nth 3 wblk
  let w_f2 = list_nth 4 wblk
  let ln1_pack = layernorm_save x_in ln_g ln_b
  let ln1_out = head ln1_pack
  let ln1_mean = head (tail ln1_pack)
  let ln1_rstd = head (tail (tail ln1_pack))
  let q = rope_copy (matmul ln1_out w_q)
  let k = rope_copy (matmul ln1_out w_k)
  let v = matmul ln1_out w_v
  let kt = tensor_transpose k
  let scores = matmul q kt
  let scale = 1.0 / sqrt (int_to_float d)
  let scaled = tensor_scale scores scale
  let sd = unwrap scaled
  let _ = apply_causal_mask_loop sd seq 0 0
  let attn = tensor_softmax scaled
  let attn_out = matmul attn v
  let x_attn = tensor_add x_in attn_out
  let ln2_pack = layernorm_save x_attn ln_g ln_b
  let ln2_out = head ln2_pack
  let ln2_mean = head (tail ln2_pack)
  let ln2_rstd = head (tail (tail ln2_pack))
  let ffn_h_pre = matmul ln2_out w_f1
  let ffn_h_pre_d = unwrap ffn_h_pre
  let ffn_h_data = float_arr_new (seq * d_ff) 0.0
  let ffn_mask = float_arr_new (seq * d_ff) 0.0
  let _ = relu_fwd ffn_h_pre_d ffn_h_data ffn_mask (seq * d_ff) 0
  let ffn_h = Tensor ffn_h_data (cons seq (cons d_ff [])) (compute_strides (cons seq (cons d_ff [])))
  let ffn_out = matmul ffn_h w_f2
  let x_out = tensor_add x_attn ffn_out
  cons x_out (cons attn (cons x_attn (cons ln2_out (cons ln1_out (cons q (cons k (cons v (cons ffn_h (cons ffn_mask (cons ln1_mean (cons ln1_rstd (cons ln2_mean (cons ln2_rstd [])))))))))))))

block_bwd d_x_out acts x_in wblk ln_g ln_b seq d d_ff =
  let w_q = list_nth 0 wblk
  let w_k = list_nth 1 wblk
  let w_v = list_nth 2 wblk
  let w_f1 = list_nth 3 wblk
  let w_f2 = list_nth 4 wblk
  let attn = list_nth 1 acts
  let x_attn = list_nth 2 acts
  let ln2_out = list_nth 3 acts
  let ln1_out = list_nth 4 acts
  let q = list_nth 5 acts
  let k = list_nth 6 acts
  let v = list_nth 7 acts
  let ffn_h = list_nth 8 acts
  let ffn_mask = list_nth 9 acts
  let ln1_mean = list_nth 10 acts
  let ln1_rstd = list_nth 11 acts
  let ln2_mean = list_nth 12 acts
  let ln2_rstd = list_nth 13 acts
  let dffn_out = d_x_out
  let ffn_h_t = tensor_transpose ffn_h
  let d_wf2 = matmul ffn_h_t dffn_out
  let wf2_t = tensor_transpose w_f2
  let dffn_h = matmul dffn_out wf2_t
  let dffn_h_pre = float_arr_new (seq * d_ff) 0.0
  let dffn_h_d = unwrap dffn_h
  let _ = relu_bwd dffn_h_d ffn_mask dffn_h_pre (seq * d_ff) 0
  let dffn_h_pre_t = Tensor dffn_h_pre (cons seq (cons d_ff [])) (compute_strides (cons seq (cons d_ff [])))
  let ln2_t = tensor_transpose ln2_out
  let d_wf1 = matmul ln2_t dffn_h_pre_t
  let wf1_t = tensor_transpose w_f1
  let dln2_out = matmul dffn_h_pre_t wf1_t
  let dx_attn_ln = layernorm_backward_dx x_attn ln2_mean ln2_rstd ln_g dln2_out
  let dx_attn = tensor_add d_x_out dx_attn_ln
  let dattn_out = dx_attn
  let (d_q, d_k, d_v) = attention_backward q k v attn dattn_out
  let d_q = rope_copy_inv d_q
  let d_k = rope_copy_inv d_k
  let ln1_t = tensor_transpose ln1_out
  let d_wq = matmul ln1_t d_q
  let d_wk = matmul ln1_t d_k
  let d_wv = matmul ln1_t d_v
  let wq_t = tensor_transpose w_q
  let wk_t = tensor_transpose w_k
  let wv_t = tensor_transpose w_v
  let dx_q = matmul d_q wq_t
  let dx_k = matmul d_k wk_t
  let dx_v = matmul d_v wv_t
  let dln1_out = tensor_add (tensor_add dx_q dx_k) dx_v
  let dx_in_ln = layernorm_backward_dx x_in ln1_mean ln1_rstd ln_g dln1_out
  let d_x_in = tensor_add dx_attn dx_in_ln
  cons d_x_in (cons d_wq (cons d_wk (cons d_wv (cons d_wf1 (cons d_wf2 [])))))

-- ── 2-block forward. wb1/wb2 = the two blocks' weight lists. Returns
-- [probs, x_blk1, x_pe, acts1, acts2]. ──
fwd2 x w_e wb1 wb2 w_o ln_g ln_b pe seq V d d_ff =
  let e = matmul x w_e
  let x_pe = e
  let acts1 = block_fwd x_pe wb1 ln_g ln_b seq d d_ff
  let x_blk1 = list_nth 0 acts1
  let acts2 = block_fwd x_blk1 wb2 ln_g ln_b seq d d_ff
  let x_blk2 = list_nth 0 acts2
  let logits = matmul x_blk2 w_o
  let probs = tensor_softmax logits
  cons probs (cons x_blk1 (cons x_pe (cons acts1 (cons acts2 []))))

forward x w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff =
  let e = matmul x w_e
  let ed = unwrap e
  let _ = 0  -- abs PE removed; RoPE relative
  let x_pe = e

  -- LN1
  let ln1_pack = layernorm_save x_pe ln_g ln_b
  let ln1_out = head ln1_pack
  let ln1_mean = head (tail ln1_pack)
  let ln1_rstd = head (tail (tail ln1_pack))

  -- Self-attention from ln1_out
  let q = rope_copy (matmul ln1_out w_q)
  let k = rope_copy (matmul ln1_out w_k)
  let v = matmul ln1_out w_v
  let kt = tensor_transpose k
  let scores = matmul q kt
  let scale = 1.0 / sqrt (int_to_float d)
  let scaled = tensor_scale scores scale
  let sd = unwrap scaled
  let _ = apply_causal_mask_loop sd seq 0 0
  let attn = tensor_softmax scaled
  let attn_out = matmul attn v

  -- Residual #1
  let x_attn = tensor_add x_pe attn_out

  -- LN2
  let ln2_pack = layernorm_save x_attn ln_g ln_b
  let ln2_out = head ln2_pack
  let ln2_mean = head (tail ln2_pack)
  let ln2_rstd = head (tail (tail ln2_pack))

  -- FFN: ln2_out @ W_F1 → ReLU → @ W_F2
  let ffn_h_pre = matmul ln2_out w_f1
  let ffn_h_pre_d = unwrap ffn_h_pre
  let ffn_h_data = float_arr_new (seq * d_ff) 0.0
  let ffn_mask = float_arr_new (seq * d_ff) 0.0
  let _ = relu_fwd ffn_h_pre_d ffn_h_data ffn_mask (seq * d_ff) 0
  let ffn_h = Tensor ffn_h_data (cons seq (cons d_ff [])) (compute_strides (cons seq (cons d_ff [])))
  let ffn_out = matmul ffn_h w_f2

  -- Residual #2
  let x_blk = tensor_add x_attn ffn_out

  let logits = matmul x_blk w_o
  let probs = tensor_softmax logits

  let r0 = cons ln2_rstd []
  let r1 = cons ln2_mean r0
  let r2 = cons ln1_rstd r1
  let r3 = cons ln1_mean r2
  let r4 = cons ffn_mask r3
  let r5 = cons ffn_h r4
  let r6 = cons v r5
  let r7 = cons k r6
  let r8 = cons q r7
  let r9 = cons x_pe r8
  let r10 = cons ln1_out r9
  let r11 = cons x_attn r10
  let r12 = cons ln2_out r11
  let r13 = cons x_blk r12
  let r14 = cons attn r13
  cons probs r14

-- ── Training step ──
train_step x labels w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff dlog_buf st_we st_wq st_wk st_wv st_wo st_wf1 st_wf2 lr =
  let result = forward x w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff
  let probs = list_nth 0 result
  let attn = list_nth 1 result
  let x_blk = list_nth 2 result
  let ln2_out = list_nth 3 result
  let x_attn = list_nth 4 result
  let ln1_out = list_nth 5 result
  let x_pe = list_nth 6 result
  let q = list_nth 7 result
  let k = list_nth 8 result
  let v = list_nth 9 result
  let ffn_h = list_nth 10 result
  let ffn_mask = list_nth 11 result
  let ln1_mean = list_nth 12 result
  let ln1_rstd = list_nth 13 result
  let ln2_mean = list_nth 14 result
  let ln2_rstd = list_nth 15 result

  let loss = ce_loss probs labels seq V

  match probs | Tensor pd _ _ -> match labels | Tensor ld _ _ ->
    let invN = 1.0 / int_to_float seq
    let _ = ce_grad_loop dlog_buf pd ld seq V invN 0
    let dlog_t = Tensor dlog_buf (cons seq (cons V [])) (compute_strides (cons seq (cons V [])))

    -- dW_O = x_blk^T @ dLogits ;  dx_blk = dLogits @ W_O^T
    let xblk_t = tensor_transpose x_blk
    let d_wo = matmul xblk_t dlog_t
    let wo_t = tensor_transpose w_o
    let dx_blk = matmul dlog_t wo_t

    -- Residual #2: dx_attn += dx_blk ; dffn_out = dx_blk
    let dffn_out = dx_blk

    -- FFN backward:  ffn_out = ffn_h @ W_F2
    --   dW_F2 = ffn_h^T @ dffn_out ;  dffn_h = dffn_out @ W_F2^T
    let ffn_h_t = tensor_transpose ffn_h
    let d_wf2 = matmul ffn_h_t dffn_out
    let wf2_t = tensor_transpose w_f2
    let dffn_h = matmul dffn_out wf2_t

    -- ReLU backward to get dffn_h_pre
    let dffn_h_pre = float_arr_new (seq * d_ff) 0.0
    let dffn_h_d = unwrap dffn_h
    let _ = relu_bwd dffn_h_d ffn_mask dffn_h_pre (seq * d_ff) 0
    let dffn_h_pre_t = Tensor dffn_h_pre (cons seq (cons d_ff [])) (compute_strides (cons seq (cons d_ff [])))

    -- Linear backward of ffn_h_pre = ln2_out @ W_F1
    --   dW_F1 = ln2_out^T @ dffn_h_pre ;  dln2_out = dffn_h_pre @ W_F1^T
    let ln2_t = tensor_transpose ln2_out
    let d_wf1 = matmul ln2_t dffn_h_pre_t
    let wf1_t = tensor_transpose w_f1
    let dln2_out = matmul dffn_h_pre_t wf1_t

    -- LN2 backward: dx_attn (LN contribution) = layernorm_backward_dx
    let dx_attn_ln = layernorm_backward_dx x_attn ln2_mean ln2_rstd ln_g dln2_out
    -- Total dx_attn = residual contribution (dx_blk) + LN contribution
    let dx_attn = tensor_add dx_blk dx_attn_ln

    -- Residual #1: dx_pe += dx_attn ; dattn_out = dx_attn
    let dattn_out = dx_attn

    -- Attention backward
    let (d_q, d_k, d_v) = attention_backward q k v attn dattn_out
    let d_q = rope_copy_inv d_q
    let d_k = rope_copy_inv d_k

    -- dW_Q etc., dln1_out (via QKV)
    let ln1_t = tensor_transpose ln1_out
    let d_wq = matmul ln1_t d_q
    let d_wk = matmul ln1_t d_k
    let d_wv = matmul ln1_t d_v
    let wq_t = tensor_transpose w_q
    let wk_t = tensor_transpose w_k
    let wv_t = tensor_transpose w_v
    let dx_q = matmul d_q wq_t
    let dx_k = matmul d_k wk_t
    let dx_v = matmul d_v wv_t
    let dln1_out = tensor_add (tensor_add dx_q dx_k) dx_v

    -- LN1 backward → dx_pe (LN contribution); add to residual contribution dx_attn
    let dx_pe_ln = layernorm_backward_dx x_pe ln1_mean ln1_rstd ln_g dln1_out
    let dx_pe = tensor_add dx_attn dx_pe_ln

    -- Embedding gradient: dW_E = X^T @ dx_pe (X is one-hot → scatter-add)
    let xT = tensor_transpose x
    let d_we = matmul xT dx_pe

    -- Adam updates on every parameter tensor.
    let we_d = unwrap w_e
    let wq_d = unwrap w_q
    let wk_d = unwrap w_k
    let wv_d = unwrap w_v
    let wo_d = unwrap w_o
    let wf1_d = unwrap w_f1
    let wf2_d = unwrap w_f2
    let dwe_d = unwrap d_we
    let dwq_d = unwrap d_wq
    let dwk_d = unwrap d_wk
    let dwv_d = unwrap d_wv
    let dwo_d = unwrap d_wo
    let dwf1_d = unwrap d_wf1
    let dwf2_d = unwrap d_wf2
    let _ = adam_update_raw we_d dwe_d st_we lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw wq_d dwq_d st_wq lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw wk_d dwk_d st_wk lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw wv_d dwv_d st_wv lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw wo_d dwo_d st_wo lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw wf1_d dwf1_d st_wf1 lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw wf2_d dwf2_d st_wf2 lr adam_default_b1 adam_default_b2 adam_default_eps
    loss

-- `segment_stop` exits the recursion early so the outer driver can
-- checkpoint between segments. LR schedule still uses the global
-- `max_steps` so cosine decay doesn't restart each segment.
train_loop x labels w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff dlog_buf st_we st_wq st_wk st_wv st_wo st_wf1 st_wf2 base_lr warmup max_steps segment_stop step =
  if step >= segment_stop then 0
  else
    let lr = cosine_decay step warmup max_steps base_lr
    -- Drop all arena-allocated intermediates from the prior step before
    -- running this one. Weights and Adam state are mutated in place and
    -- live in tensors allocated in main, outside this arena region.
    let mk = arena_mark 0
    let loss = train_step x labels w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff dlog_buf st_we st_wq st_wk st_wv st_wo st_wf1 st_wf2 lr
    let _ = arena_reset mk
    let _ = if step % 10 == 0 then
      let _ = print (cat ["step ", show step, "  lr=", show_float lr, "  loss=", show_float loss])
      0
    else 0
    train_loop x labels w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff dlog_buf st_we st_wq st_wk st_wv st_wo st_wf1 st_wf2 base_lr warmup max_steps segment_stop (step + 1)

eval_loss x labels w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff =
  let result = forward x w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff
  let probs = list_nth 0 result
  ce_loss probs labels seq V

-- Argmax over a single row of [seq, V] probs. Returns best token id + its prob.
argmax_row_inner probs row V j best_id best_val =
  if j >= V then best_id
  else
    let p = float_arr_get probs (row * V + j)
    if p > best_val then argmax_row_inner probs row V (j + 1) j p
    else argmax_row_inner probs row V (j + 1) best_id best_val

argmax_row probs row V =
  argmax_row_inner probs row V 1 0 (float_arr_get probs (row * V))

-- Collect per-position argmax ids into a list.
collect_predictions_loop probs seq V i acc =
  if i >= seq then reverse acc
  else
    let id = argmax_row probs i V
    collect_predictions_loop probs seq V (i + 1) (cons id acc)

collect_predictions probs seq V =
  collect_predictions_loop probs seq V 0 []

-- Given trained weights + input x, decode "what the model predicts at each
-- position." Useful for checking memorization: should match the shifted
-- corpus for a near-fit model.
-- Note: probs is a Tensor ADT — extract the underlying float_arr before
-- indexing with float_arr_get.
sample_greedy x w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff vocab =
  let result = forward x w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff
  let probs_t = list_nth 0 result
  match probs_t
    | Tensor probs_data _ _ ->
      let ids = collect_predictions probs_data seq V
      decode vocab ids

-- Outer checkpoint driver. Weight tensors and Adam states are bundled
-- into `weights` and `adams` lists (and destructured at the top of the
-- body) so the param count stays under Rail's ARM64 codegen limit.
-- `best_val_arr` is a 1-slot float_arr; slot 0 < 0 means "no prior best".
run_segments x labels weights adams pe seq V d d_ff dlog_buf base_lr warmup max_steps save_every ckpt best_val_arr step =
  if step >= max_steps then 0
  else
    let w_e = list_nth 0 weights
    let w_q = list_nth 1 weights
    let w_k = list_nth 2 weights
    let w_v = list_nth 3 weights
    let w_o = list_nth 4 weights
    let w_f1 = list_nth 5 weights
    let w_f2 = list_nth 6 weights
    let ln_g = list_nth 7 weights
    let ln_b = list_nth 8 weights
    let st_we = list_nth 0 adams
    let st_wq = list_nth 1 adams
    let st_wk = list_nth 2 adams
    let st_wv = list_nth 3 adams
    let st_wo = list_nth 4 adams
    let st_wf1 = list_nth 5 adams
    let st_wf2 = list_nth 6 adams
    let next0 = step + save_every
    let next = if next0 > max_steps then max_steps else next0
    let _ = train_loop x labels w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff dlog_buf st_we st_wq st_wk st_wv st_wo st_wf1 st_wf2 base_lr warmup max_steps next step
    let loss_now = eval_loss x labels w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff
    let prev_best = float_arr_get best_val_arr 0
    let is_best = if prev_best < 0.0 then true else loss_now < prev_best
    let _ = if is_best then float_arr_set best_val_arr 0 loss_now else 0
    let b = float_arr_get best_val_arr 0
    let _ = save_checkpoint ckpt weights adams next b
    let _ = print (cat ["  ckpt@", show next, "  eval_loss=", show_float loss_now, "  best=", show_float b])
    run_segments x labels weights adams pe seq V d d_ff dlog_buf base_lr warmup max_steps save_every ckpt best_val_arr next

-- ===== R37: held-out echo eval (the deciding generalization test) =====
r37_chr s i = str_sub s i 1
r37_slen s = length (chars s)
r37_echo2 htext hpred dashidx =
  let c1 = if (r37_chr hpred (dashidx + 2)) == (r37_chr htext (dashidx + 3)) then 1 else 0
  let c2 = if (r37_chr hpred (dashidx + 3)) == (r37_chr htext (dashidx + 4)) then 1 else 0
  c1 + c2
r37_score htext hpred =
  let d1 = str_find "-- " htext
  let off = d1 + 3
  let tail2 = str_sub htext off ((r37_slen htext) - off)
  let d2r = str_find "-- " tail2
  let d2 = if d2r < 0 then (0 - 1) else off + d2r
  let s1 = if d1 < 0 then 0 else r37_echo2 htext hpred d1
  let s2 = if d2 < 0 then 0 else r37_echo2 htext hpred d2
  s1 + s2

-- B4/B5: quantize a float weight array to Q.24 in place (round(f*2^24)/2^24) — the committable,
-- exact-int-evaluable form. The hinge: train in float, commit + evaluate the Q.24 artifact.
q24_quant arr n i =
  if i >= n then 0
  else
    let q = (int_to_float (float_to_int ((float_arr_get arr i) * 16777216.0))) / 16777216.0
    let _ = float_arr_set arr i q
    q24_quant arr n (i + 1)
q24_ser arr n i acc =
  if i >= n then acc
  else q24_ser arr n (i + 1) (cat [acc, show (float_to_int ((float_arr_get arr i) * 16777216.0)), ","])

r37_arrcpy src dst n i = if i >= n then 0 else let _ = float_arr_set dst i (float_arr_get src i) in r37_arrcpy src dst n (i + 1)
rope_copy x = match x
  | Tensor xd shp st ->
    let sq = head shp
    let dd = head (tail shp)
    let nn = sq * dd
    let nd = float_arr_new nn 0.0
    let _ = r37_arrcpy xd nd nn 0
    let _ = rope_positions nd sq dd 0 1.0
    Tensor nd shp st
rope_copy_inv x = match x
  | Tensor xd shp st ->
    let sq = head shp
    let dd = head (tail shp)
    let nn = sq * dd
    let nd = float_arr_new nn 0.0
    let _ = r37_arrcpy xd nd nn 0
    let _ = rope_positions nd sq dd 0 (0.0 - 1.0)
    Tensor nd shp st

-- ── 2-block helpers ──
-- Glorot/Xavier uniform: limit = sqrt(6/(fan_in+fan_out)). Without this the
-- 2-block stack starts at loss ~17 (saturated softmax) instead of ~uniform.
xavier_fill arr n seed limit i =
  if i >= n then 0
  else
    let raw = ((i * 97 + seed * 13) % 100) - 50
    let v = limit * int_to_float raw / 50.0
    let _ = float_arr_set arr i v
    xavier_fill arr n (seed + 1) limit (i + 1)

mk_mat rows cols seed =
  let n = rows * cols
  let data = float_arr_new n 0.0
  let limit = sqrt (6.0 / int_to_float (rows + cols))
  let _ = xavier_fill data n seed limit 0
  Tensor data (cons rows (cons cols [])) (compute_strides (cons rows (cons cols [])))

mk_adam_block d d_ff =
  let a = adam_state (d * d)
  let b = adam_state (d * d)
  let c = adam_state (d * d)
  let e = adam_state (d * d_ff)
  let f = adam_state (d_ff * d)
  cons a (cons b (cons c (cons e (cons f []))))

-- Apply Adam to a block's 5 weights given the 5 gradients (order [wq,wk,wv,wf1,wf2]).
adam_block wblk dgrads stblk lr =
  let w_q = unwrap (list_nth 0 wblk)
  let w_k = unwrap (list_nth 1 wblk)
  let w_v = unwrap (list_nth 2 wblk)
  let w_f1 = unwrap (list_nth 3 wblk)
  let w_f2 = unwrap (list_nth 4 wblk)
  let d_q = unwrap (list_nth 0 dgrads)
  let d_k = unwrap (list_nth 1 dgrads)
  let d_v = unwrap (list_nth 2 dgrads)
  let d_f1 = unwrap (list_nth 3 dgrads)
  let d_f2 = unwrap (list_nth 4 dgrads)
  let s_q = list_nth 0 stblk
  let s_k = list_nth 1 stblk
  let s_v = list_nth 2 stblk
  let s_f1 = list_nth 3 stblk
  let s_f2 = list_nth 4 stblk
  let _ = adam_update_raw w_q d_q s_q lr adam_default_b1 adam_default_b2 adam_default_eps
  let _ = adam_update_raw w_k d_k s_k lr adam_default_b1 adam_default_b2 adam_default_eps
  let _ = adam_update_raw w_v d_v s_v lr adam_default_b1 adam_default_b2 adam_default_eps
  let _ = adam_update_raw w_f1 d_f1 s_f1 lr adam_default_b1 adam_default_b2 adam_default_eps
  let _ = adam_update_raw w_f2 d_f2 s_f2 lr adam_default_b1 adam_default_b2 adam_default_eps
  0

-- ── 2-block training step. wb1/wb2 = block weight lists; st_wb1/st_wb2 = block Adam-state lists. ──
train_step2 x labels w_e w_o wb1 wb2 ln_g ln_b seq V d d_ff dlog_buf st_we st_wo st_wb1 st_wb2 lr =
  let result = fwd2 x w_e wb1 wb2 w_o ln_g ln_b 0 seq V d d_ff
  let probs = list_nth 0 result
  let x_blk1 = list_nth 1 result
  let x_pe = list_nth 2 result
  let acts1 = list_nth 3 result
  let acts2 = list_nth 4 result
  let x_blk2 = list_nth 0 acts2
  let loss = ce_loss probs labels seq V
  match probs | Tensor pd _ _ -> match labels | Tensor ld _ _ ->
    let invN = 1.0 / int_to_float seq
    let _ = ce_grad_loop dlog_buf pd ld seq V invN 0
    let dlog_t = Tensor dlog_buf (cons seq (cons V [])) (compute_strides (cons seq (cons V [])))
    -- readout backward: dW_O = x_blk2^T @ dLogits ; dx_blk2 = dLogits @ W_O^T
    let xblk2_t = tensor_transpose x_blk2
    let d_wo = matmul xblk2_t dlog_t
    let wo_t = tensor_transpose w_o
    let dx_blk2 = matmul dlog_t wo_t
    -- block 2 backward (input was x_blk1)
    let bwd2 = block_bwd dx_blk2 acts2 x_blk1 wb2 ln_g ln_b seq d d_ff
    let dx_blk1 = list_nth 0 bwd2
    -- block 1 backward (input was x_pe)
    let bwd1 = block_bwd dx_blk1 acts1 x_pe wb1 ln_g ln_b seq d d_ff
    let dx_pe = list_nth 0 bwd1
    -- embedding gradient: dW_E = X^T @ dx_pe
    let xT = tensor_transpose x
    let d_we = matmul xT dx_pe
    -- Adam updates
    let _ = adam_update_raw (unwrap w_e) (unwrap d_we) st_we lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_update_raw (unwrap w_o) (unwrap d_wo) st_wo lr adam_default_b1 adam_default_b2 adam_default_eps
    let _ = adam_block wb2 (tail bwd2) st_wb2 lr
    let _ = adam_block wb1 (tail bwd1) st_wb1 lr
    loss

eval_loss2 x labels w_e w_o wb1 wb2 ln_g ln_b seq V d d_ff =
  let result = fwd2 x w_e wb1 wb2 w_o ln_g ln_b 0 seq V d d_ff
  let probs = list_nth 0 result
  ce_loss probs labels seq V

loop2 x labels w_e w_o wb1 wb2 ln_g ln_b seq V d d_ff dlog_buf st_we st_wo st_wb1 st_wb2 base_lr warmup max_steps step =
  if step >= max_steps then 0
  else
    let lr = cosine_decay step warmup max_steps base_lr
    let mk = arena_mark 0
    let loss = train_step2 x labels w_e w_o wb1 wb2 ln_g ln_b seq V d d_ff dlog_buf st_we st_wo st_wb1 st_wb2 lr
    let _ = arena_reset mk
    let _ = if step % 20 == 0 then
      let _ = print (cat ["step ", show step, "  lr=", show_float lr, "  loss=", show_float loss])
      0
    else 0
    loop2 x labels w_e w_o wb1 wb2 ln_g ln_b seq V d d_ff dlog_buf st_we st_wo st_wb1 st_wb2 base_lr warmup max_steps (step + 1)

sample_greedy2 x w_e w_o wb1 wb2 ln_g ln_b seq V d d_ff vocab =
  let result = fwd2 x w_e wb1 wb2 w_o ln_g ln_b 0 seq V d d_ff
  let probs_t = list_nth 0 result
  match probs_t
    | Tensor probs_data _ _ ->
      let ids = collect_predictions probs_data seq V
      decode vocab ids

-- ── DATA-SCALE FORCING: windowed training over a pool too large to memorize ──
-- Tokenize the whole pool once into an indexable float_arr of ids.
ids_to_arr_loop arr ids i =
  if ids == [] then 0
  else
    let _ = float_arr_set arr i (int_to_float (head ids))
    ids_to_arr_loop arr (tail ids) (i + 1)
ids_to_arr ids n =
  let arr = float_arr_new n 0.0
  let _ = ids_to_arr_loop arr ids 0
  arr

-- O(n) tokenizer: walk the char list ONCE writing ids straight to arr. Uses
-- `cs == []` (O(1)) not `length cs == 0` (O(n)) — the generic encode_loop is
-- O(n^2) and hangs on a 349K-char pool. Returns count written.
fast_fill_ids arr cs vocab i =
  if cs == [] then i
  else
    let _ = float_arr_set arr i (int_to_float (char_id vocab (head cs)))
    fast_fill_ids arr (tail cs) vocab (i + 1)

-- One-hot fill for a window [off, off+wlen) read from the id_arr (O(1) indexed).
-- NOTE: mutual recursion (not self-recursion) — a 6-arg self-loop here hangs
-- (Rail self-loop cross-dep-args miscompile corrupts the i>=wlen test).
fill_onehot_win dst id_arr off V wlen i =
  if i >= wlen then 0
  else fill_onehot_win_b dst id_arr off V wlen i
fill_onehot_win_b dst id_arr off V wlen i =
  let c = float_to_int (float_arr_get id_arr (off + i))
  let _ = float_arr_set dst (i * V + c) 1.0
  fill_onehot_win dst id_arr off V wlen (i + 1)
-- Labels = next id: label[i] = id_arr[off+i+1].
fill_labels_win arr id_arr off wlen i =
  if i >= wlen then 0
  else fill_labels_win_b arr id_arr off wlen i
fill_labels_win_b arr id_arr off wlen i =
  let _ = float_arr_set arr i (float_arr_get id_arr (off + i + 1))
  fill_labels_win arr id_arr off wlen (i + 1)

-- 4-digit echo scorer: at each "-- " marker, compare the 4 predicted echo digits
-- (hpred, shifted +1 for next-token) against the actual (htext). Sum matched digits.
force_score_at htext hpred m =
  let c0 = if (r37_chr hpred (m + 2)) == (r37_chr htext (m + 3)) then 1 else 0
  let c1 = if (r37_chr hpred (m + 3)) == (r37_chr htext (m + 4)) then 1 else 0
  let c2 = if (r37_chr hpred (m + 4)) == (r37_chr htext (m + 5)) then 1 else 0
  let c3 = if (r37_chr hpred (m + 5)) == (r37_chr htext (m + 6)) then 1 else 0
  c0 + c1 + c2 + c3
force_score_loop htext hpred hplen from acc =
  let remlen = (r37_slen htext) - from
  let rel = if remlen <= 0 then (0 - 1) else str_find "-- " (str_sub htext from remlen)
  if rel < 0 then acc
  else
    let m = from + rel
    let s = if (m + 6) < hplen then force_score_at htext hpred m else 0
    force_score_loop htext hpred hplen (m + 3) (acc + s)
force_score htext hpred = force_score_loop htext hpred (r37_slen hpred) 0 0

-- Windowed training loop. Each step trains on a DIFFERENT window of the pool, so
-- low train-window loss can only come from generalizing (copy rule), not memorizing
-- barely-seen lines. wsh=[w_e,w_o,ln_g,ln_b]; ash=[st_we,st_wo].
force_loop id_arr dims wsh ash wb1 wb2 st_wb1 st_wb2 hx htext vocab dlog_buf lr step =
  let V = list_nth 0 dims
  let d = list_nth 1 dims
  let d_ff = list_nth 2 dims
  let wlen = list_nth 3 dims
  let nwin = list_nth 4 dims
  let max_steps = list_nth 5 dims
  let eval_every = list_nth 6 dims
  if step >= max_steps then 0
  else
    let w_e = list_nth 0 wsh
    let w_o = list_nth 1 wsh
    let ln_g = list_nth 2 wsh
    let ln_b = list_nth 3 wsh
    let st_we = list_nth 0 ash
    let st_wo = list_nth 1 ash
    let off = (step % nwin) * wlen
    let mk = arena_mark 0
    let x_data = float_arr_new ((wlen + 0) * V) 0.0
    let _ = fill_onehot_win x_data id_arr off V wlen 0
    let x = Tensor x_data (cons wlen (cons V [])) (compute_strides (cons wlen (cons V [])))
    let labels_data = float_arr_new (wlen + 0) 0.0
    let _ = fill_labels_win labels_data id_arr off wlen 0
    let labels = Tensor labels_data (cons wlen []) (cons 1 [])
    let loss = train_step2 x labels w_e w_o wb1 wb2 ln_g ln_b wlen V d d_ff dlog_buf st_we st_wo st_wb1 st_wb2 lr
    let _ = arena_reset mk
    let _ = if step % eval_every == 0 then
      let mk2 = arena_mark 0
      let hseq = match hx | Tensor _ shp _ -> head shp
      let hpred = sample_greedy2 hx w_e w_o wb1 wb2 ln_g ln_b hseq V d d_ff vocab
      let sc = force_score htext hpred
      let _ = print (cat ["step ", show step, "  twloss=", show_float loss, "  HELDOUT=", show sc, "/64"])
      let _ = arena_reset mk2
      0
    else 0
    force_loop id_arr dims wsh ash wb1 wb2 st_wb1 st_wb2 hx htext vocab dlog_buf lr (step + 1)

-- ── r37 gate-grade attestation tail (audit fix 2026-06-09) ──
-- Serialize one quantized tensor to its own part file. Chunked writes + per-part
-- arena mark/reset keep the bump allocator flat (CLAUDE.md large-string rule).
r37_part nm s =
  let _ = write_file (cat ["rungs/r37_artifact_attestation/r37full_", nm, ".part"]) s
  print (cat ["R37_PART_", nm, "_LEN=", show (r37_slen s)])

train_and_attest id_arr dims wsh ash wb1 wb2 st_wb1 st_wb2 hx htext vocab dlog_buf =
  let V = list_nth 0 dims
  let d = list_nth 1 dims
  let d_ff = list_nth 2 dims
  let w_e = list_nth 0 wsh
  let w_o = list_nth 1 wsh
  let ln_g = list_nth 2 wsh
  let ln_b = list_nth 3 wsh
  let hseq = match hx | Tensor _ shp _ -> head shp
  let _ = print "(twloss = loss on each fresh window; low twloss => generalizing copy, not memorizing)"
  let _ = force_loop id_arr dims wsh ash wb1 wb2 st_wb1 st_wb2 hx htext vocab dlog_buf 0.003 0
  let hpred = sample_greedy2 hx w_e w_o wb1 wb2 ln_g ln_b hseq V d d_ff vocab
  let sc = force_score htext hpred
  let _ = print (cat ["FINAL HELDOUT_DIGITS=", show sc, "/64  (>=48 = GENERALIZES copy rule)"])
  let _ = print (cat ["predict sample: ", str_sub hpred 0 70])
  -- ===== ARTIFACT-ATTESTATION (gate-grade): quantize EVERY tensor to Q.24, commit ALL =====
  -- The 2026-06-09 audit found the v1 commitment covered only embed+readout (3,456 of
  -- 93,696 weights) — the induction circuit itself was uncommitted. This commits all 14.
  let wq1 = list_nth 0 wb1
  let wk1 = list_nth 1 wb1
  let wv1 = list_nth 2 wb1
  let wf11 = list_nth 3 wb1
  let wf21 = list_nth 4 wb1
  let wq2 = list_nth 0 wb2
  let wk2 = list_nth 1 wb2
  let wv2 = list_nth 2 wb2
  let wf12 = list_nth 3 wb2
  let wf22 = list_nth 4 wb2
  let _ = q24_quant (unwrap w_e) (V * d) 0
  let _ = q24_quant (unwrap w_o) (d * V) 0
  let _ = q24_quant (unwrap wq1) (d * d) 0
  let _ = q24_quant (unwrap wk1) (d * d) 0
  let _ = q24_quant (unwrap wv1) (d * d) 0
  let _ = q24_quant (unwrap wf11) (d * d_ff) 0
  let _ = q24_quant (unwrap wf21) (d_ff * d) 0
  let _ = q24_quant (unwrap wq2) (d * d) 0
  let _ = q24_quant (unwrap wk2) (d * d) 0
  let _ = q24_quant (unwrap wv2) (d * d) 0
  let _ = q24_quant (unwrap wf12) (d * d_ff) 0
  let _ = q24_quant (unwrap wf22) (d_ff * d) 0
  let _ = q24_quant (unwrap ln_g) d 0
  let _ = q24_quant (unwrap ln_b) d 0
  -- v1 commitment (embed+readout only) — kept for continuity with the 2026-06-09 push;
  -- superseded by the FULL artifact below. Reproducing the v1 SHA on re-run also proves
  -- the new gate code did not perturb the training trajectory.
  let wser = cat [q24_ser (unwrap w_e) (V * d) 0 "", q24_ser (unwrap w_o) (d * V) 0 ""]
  let whash = sha256_hex wser
  let _ = write_file "rungs/r37_artifact_attestation/r37_force_weights_q24.txt" wser
  let _ = print (cat ["R37_FORCE_WEIGHT_SHA=", whash])
  -- v2 FULL commitment: all 14 tensors, fixed order, row-major, Q.24 ints comma-terminated.
  -- The wrapper cats the parts in this order -> r37_force_weights_q24_full.txt and
  -- SHA-256s the result (cross-checked against shell shasum).
  let m01 = arena_mark 0
  let _ = r37_part "00_w_e" (q24_ser (unwrap w_e) (V * d) 0 "")
  let _ = arena_reset m01
  let m02 = arena_mark 0
  let _ = r37_part "01_w_o" (q24_ser (unwrap w_o) (d * V) 0 "")
  let _ = arena_reset m02
  let m03 = arena_mark 0
  let _ = r37_part "02_wq1" (q24_ser (unwrap wq1) (d * d) 0 "")
  let _ = arena_reset m03
  let m04 = arena_mark 0
  let _ = r37_part "03_wk1" (q24_ser (unwrap wk1) (d * d) 0 "")
  let _ = arena_reset m04
  let m05 = arena_mark 0
  let _ = r37_part "04_wv1" (q24_ser (unwrap wv1) (d * d) 0 "")
  let _ = arena_reset m05
  let m06 = arena_mark 0
  let _ = r37_part "05_wf11" (q24_ser (unwrap wf11) (d * d_ff) 0 "")
  let _ = arena_reset m06
  let m07 = arena_mark 0
  let _ = r37_part "06_wf21" (q24_ser (unwrap wf21) (d_ff * d) 0 "")
  let _ = arena_reset m07
  let m08 = arena_mark 0
  let _ = r37_part "07_wq2" (q24_ser (unwrap wq2) (d * d) 0 "")
  let _ = arena_reset m08
  let m09 = arena_mark 0
  let _ = r37_part "08_wk2" (q24_ser (unwrap wk2) (d * d) 0 "")
  let _ = arena_reset m09
  let m10 = arena_mark 0
  let _ = r37_part "09_wv2" (q24_ser (unwrap wv2) (d * d) 0 "")
  let _ = arena_reset m10
  let m11 = arena_mark 0
  let _ = r37_part "10_wf12" (q24_ser (unwrap wf12) (d * d_ff) 0 "")
  let _ = arena_reset m11
  let m12 = arena_mark 0
  let _ = r37_part "11_wf22" (q24_ser (unwrap wf22) (d_ff * d) 0 "")
  let _ = arena_reset m12
  let _ = r37_part "12_ln_g" (q24_ser (unwrap ln_g) d 0 "")
  let _ = r37_part "13_ln_b" (q24_ser (unwrap ln_b) d 0 "")
  let _ = print "R37_ARTIFACT_ORDER=w_e,w_o,wq1,wk1,wv1,wf11,wf21,wq2,wk2,wv2,wf12,wf22,ln_g,ln_b"
  -- Honest label (audit C2): this eval is the FLOAT forward on Q.24-grid-aligned weights.
  -- It proves generalization survives quantization. The exact-int forward (bit-exact by
  -- construction, cross-platform) is roadmap — see RESEARCH_GATE.md.
  let hpred2 = sample_greedy2 hx w_e w_o wb1 wb2 ln_g ln_b hseq V d d_ff vocab
  let sc2 = force_score htext hpred2
  let _ = print (cat ["R37_FORCE_ECHO_Q24GRID=", show sc2, "/64  (== float echo => Q.24 grid faithful; float fwd, exact-int fwd = roadmap)"])
  0

main =
  let _ = print "=== DATA-SCALE FORCING: 2-block RoPE, windowed over 9984 distinct 4-digit numbers ==="
  let text = read_file "rungs/r24/force_train_4d.txt"
  let vocab = build_vocab (str_sub text 0 2000)
  let V = vocab_size vocab
  let cs = chars text
  let total = length cs
  let id_arr = float_arr_new total 0.0
  let _ = fast_fill_ids id_arr cs vocab 0
  let _ = print (cat ["pool chars=", show total, "  vocab=", show V])

  let d = 64
  let d_ff = 256
  let wlen = 350
  let nwin = (total - 1) / wlen
  let _ = print (cat ["window=", show wlen, " chars (10 lines), nwin=", show nwin])

  let w_e = mk_mat V d 1
  let w_o = mk_mat d V 5
  let wb1 = cons (mk_mat d d 2) (cons (mk_mat d d 3) (cons (mk_mat d d 4) (cons (mk_mat d d_ff 6) (cons (mk_mat d_ff d 7) []))))
  let wb2 = cons (mk_mat d d 12) (cons (mk_mat d d 13) (cons (mk_mat d d 14) (cons (mk_mat d d_ff 16) (cons (mk_mat d_ff d 17) []))))

  let lng_data = float_arr_new d 1.0
  let _ = ones_loop lng_data d 0
  let ln_g = Tensor lng_data (cons d []) (cons 1 [])
  let lnb_data = float_arr_new d 0.0
  let ln_b = Tensor lnb_data (cons d []) (cons 1 [])

  let st_we = adam_state (V * d)
  let st_wo = adam_state (d * V)
  let st_wb1 = mk_adam_block d d_ff
  let st_wb2 = mk_adam_block d d_ff
  let dlbsz = wlen * V
  let dlog_buf = float_arr_new dlbsz 0.0

  -- Held-out: 16 unseen 4-digit numbers (never in the training pool).
  let htext = read_file "rungs/r24/force_holdout_4d.txt"
  let hids = encode vocab htext
  let htotal = length hids
  let hseq = htotal - 1
  let hx_data = float_arr_new (hseq * V) 0.0
  let _ = fill_onehot hx_data hids V hseq 0
  let hx = Tensor hx_data (cons hseq (cons V [])) (compute_strides (cons hseq (cons V [])))

  let wsh = cons w_e (cons w_o (cons ln_g (cons ln_b [])))
  let ash = cons st_we (cons st_wo [])
  let max_steps = 6000
  let dims = cons V (cons d (cons d_ff (cons wlen (cons nwin (cons max_steps (cons 250 []))))))
  -- ── GATE okSplitSig input: split pre-registration ──
  -- SHA-256 of the exact train/holdout BYTES, printed before any training step.
  -- The run wrapper (r37_attest_run.sh) binds these to a public beacon pulse
  -- fetched before launch and signs the tuple with the LOCAL/DEV key
  -- (ladder discipline: never the prod Pi-witness sign surface).
  let _ = print (cat ["R37_SPLIT_TRAIN_SHA=", sha256_hex text])
  let _ = print (cat ["R37_SPLIT_HOLDOUT_SHA=", sha256_hex htext])
  -- ── GATE okCkpt0Abort: the UNTRAINED model must score < T on the holdout. ──
  -- If it doesn't, the eval harness cannot fail and downstream claims are void.
  let pred0 = sample_greedy2 hx w_e w_o wb1 wb2 ln_g ln_b hseq V d d_ff vocab
  let sc0 = force_score htext pred0
  let _ = print (cat ["R37_CKPT0_CONTROL=", show sc0, "/64  (must be < 48)"])
  if sc0 >= 48 then
    let _ = print "R37-CKPT0-ABORT: untrained model scored >= T -- eval harness suspect, run void"
    1
  else
    train_and_attest id_arr dims wsh ash wb1 wb2 st_wb1 st_wb2 hx htext vocab dlog_buf

main_old =
  let _ = print "=== Pre-norm transformer LM (LN + residual + FFN) ==="

  let text = read_file "rungs/r24/r24_train_corpus.txt"
  let vocab = build_vocab text
  let V = vocab_size vocab
  let ids = encode vocab text
  let total = length ids
  let seq = total - 1
  let _ = print (cat ["corpus=", show total, " chars, vocab=", show V, ", seq=", show seq])

  let x_data = float_arr_new (seq * V) 0.0
  let _ = fill_onehot x_data ids V seq 0
  let x = Tensor x_data (cons seq (cons V [])) (compute_strides (cons seq (cons V [])))

  let labels_data = float_arr_new seq 0.0
  let _ = fill_labels labels_data (tail ids) seq 0
  let labels = Tensor labels_data (cons seq []) (cons 1 [])

  let d = 64
  let d_ff = 256

  -- Weight tensors.
  let we_data = float_arr_new (V * d) 0.0
  let _ = init_weight we_data (V * d) 1
  let w_e = Tensor we_data (cons V (cons d [])) (compute_strides (cons V (cons d [])))
  let wq_data = float_arr_new (d * d) 0.0
  let _ = init_weight wq_data (d * d) 2
  let w_q = Tensor wq_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wk_data = float_arr_new (d * d) 0.0
  let _ = init_weight wk_data (d * d) 3
  let w_k = Tensor wk_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wv_data = float_arr_new (d * d) 0.0
  let _ = init_weight wv_data (d * d) 4
  let w_v = Tensor wv_data (cons d (cons d [])) (compute_strides (cons d (cons d [])))
  let wo_data = float_arr_new (d * V) 0.0
  let _ = init_weight wo_data (d * V) 5
  let w_o = Tensor wo_data (cons d (cons V [])) (compute_strides (cons d (cons V [])))
  let wf1_data = float_arr_new (d * d_ff) 0.0
  let _ = init_weight wf1_data (d * d_ff) 6
  let w_f1 = Tensor wf1_data (cons d (cons d_ff [])) (compute_strides (cons d (cons d_ff [])))
  let wf2_data = float_arr_new (d_ff * d) 0.0
  let _ = init_weight wf2_data (d_ff * d) 7
  let w_f2 = Tensor wf2_data (cons d_ff (cons d [])) (compute_strides (cons d_ff (cons d [])))

  -- LayerNorm parameters: gamma=1, beta=0 (fixed, no training).
  let lng_data = float_arr_new d 1.0
  let _ = ones_loop lng_data d 0
  let ln_g = Tensor lng_data (cons d []) (cons 1 [])
  let lnb_data = float_arr_new d 0.0
  let ln_b = Tensor lnb_data (cons d []) (cons 1 [])

  let pe = build_pe seq d

  let st_we = adam_state (V * d)
  let st_wq = adam_state (d * d)
  let st_wk = adam_state (d * d)
  let st_wv = adam_state (d * d)
  let st_wo = adam_state (d * V)
  let st_wf1 = adam_state (d * d_ff)
  let st_wf2 = adam_state (d_ff * d)

  let dlog_buf = float_arr_new (seq * V) 0.0

  -- Bundled lists of weights + Adam states — used by the checkpoint
  -- driver. They alias the individual tensor/adam bindings above, so
  -- in-place loads update them both.
  let weights = cons w_e (cons w_q (cons w_k (cons w_v (cons w_o (cons w_f1 (cons w_f2 (cons ln_g (cons ln_b []))))))))
  let adams = cons st_we (cons st_wq (cons st_wk (cons st_wv (cons st_wo (cons st_wf1 (cons st_wf2 []))))))

  let ckpt = "training/rail_native/checkpoints/latest"
  let save_every = 100
  let max_steps = 2000

  -- Resume if a committed checkpoint exists.
  let resumed = ckpt_exists ckpt
  let start_step = if resumed then
      let _ = print (cat ["resuming from committed ckpt at ", ckpt])
      let _ = load_model_into ckpt weights
      let _ = load_adam_states_into ckpt adams
      meta_step ckpt
    else
      let _ = print "no prior checkpoint — starting fresh"
      0
  let start_best = if resumed then meta_best_val ckpt else (0.0 - 1.0)
  let best_val_arr = float_arr_new 1 start_best

  let loss0 = eval_loss x labels w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff
  let _ = print (cat ["initial/resume loss=", show_float loss0, "  step=", show start_step, "  best=", show_float start_best])
  let _ = print (cat ["uniform-baseline (log V)=", show_float (log (int_to_float V))])
  let _ = print (cat ["v2.3 bigram baseline=2.10"])
  let _ = print (cat ["v2.4 attention-only baseline=2.62"])

  let _ = print (cat ["\nTraining up to ", show max_steps, " steps, checkpoint every ", show save_every, ":"])
  let _ = run_segments x labels weights adams pe seq V d d_ff dlog_buf 0.02 100 max_steps save_every ckpt best_val_arr start_step

  let loss1 = eval_loss x labels w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff
  let _ = print (cat ["\nfinal loss=", show_float loss1])

  let beat_uniform = if loss1 < (log (int_to_float V)) then "YES" else "NO"
  let beat_bigram = if loss1 < 2.10 then "YES" else "NO"
  let beat_v24 = if loss1 < 2.62 then "YES" else "NO"
  let _ = print (cat ["beats uniform: ", beat_uniform])
  let _ = print (cat ["beats v2.3 bigram (2.10): ", beat_bigram])
  let _ = print (cat ["beats v2.4 attn-only (2.62): ", beat_v24])

  -- Sample: greedy argmax at each position on the training input.
  -- For a near-memorized model this should echo the shifted corpus.
  let _ = print "\n--- Greedy predictions (post-training) ---"
  let sample_str = sample_greedy x w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b pe seq V d d_ff vocab
  let _ = print sample_str
  let _ = print "--- end sample ---"
  -- ===== R37 HELD-OUT ECHO EVAL (the deciding test: does float generalize the copy rule?) =====
  let htext = read_file "rungs/r24/r24_holdout_corpus.txt"
  let hids = encode vocab htext
  let htotal = length hids
  let hseq = htotal - 1
  let hx_data = float_arr_new (hseq * V) 0.0
  let _ = fill_onehot hx_data hids V hseq 0
  let hx = Tensor hx_data (cons hseq (cons V [])) (compute_strides (cons hseq (cons V [])))
  let hpe = build_pe hseq d
  let hpred = sample_greedy hx w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b hpe hseq V d d_ff vocab
  let _ = print "=== R37 HELD-OUT ECHO (float) ==="
  let _ = print (cat ["holdout : ", htext])
  let _ = print (cat ["predict : ", hpred])
  let escore = r37_score htext hpred
  let _ = print (cat ["R37_ECHO=", show escore, "/4  (>=2 = GENERALIZES the copy rule)"])
  -- ===== B4: quantize-and-commit the trained weights (the attested ARTIFACT) =====
  let _ = q24_quant we_data (V * d) 0
  let _ = q24_quant wq_data (d * d) 0
  let _ = q24_quant wk_data (d * d) 0
  let _ = q24_quant wv_data (d * d) 0
  let _ = q24_quant wo_data (d * V) 0
  let _ = q24_quant wf1_data (d * d_ff) 0
  let _ = q24_quant wf2_data (d_ff * d) 0
  -- representative commitment over embed+readout (the semantic core); a full commit hashes every
  -- array the same way, chunked to dodge the O(N^2) string-cat trap. All weights are quantized above,
  -- so the re-eval below is on the fully-Q.24 model.
  let wser = cat [q24_ser we_data (V * d) 0 "", q24_ser wo_data (d * V) 0 ""]
  let whash = sha256_hex wser
  let _ = write_file "rungs/r37_artifact_attestation/r37_weights_q24.txt" wser
  let _ = print (cat ["R37_WEIGHT_SHA=", whash])
  -- ===== B5: re-eval the held-out echo on the QUANTIZED weights (train-float / eval-Q.24 hinge) =====
  let hpred2 = sample_greedy hx w_e w_q w_k w_v w_o w_f1 w_f2 ln_g ln_b hpe hseq V d d_ff vocab
  let escore2 = r37_score htext hpred2
  let _ = print (cat ["R37_ECHO_Q24=", show escore2, "/4  (== float echo => Q.24 commitment is faithful)"])

  -- Final checkpoint. Run_segments also saves after every segment, so
  -- this is mostly a belt-and-suspenders end-of-run snapshot.
  let final_best0 = float_arr_get best_val_arr 0
  let final_is_best = if final_best0 < 0.0 then true else loss1 < final_best0
  let _ = if final_is_best then float_arr_set best_val_arr 0 loss1 else 0
  let final_best = float_arr_get best_val_arr 0
  let _ = save_checkpoint ckpt weights adams max_steps final_best
  let _ = print (cat ["final ckpt saved at step=", show max_steps, " best=", show_float final_best])
  0

ones_loop arr n i =
  if i >= n then 0
  else
    let _ = float_arr_set arr i 1.0
    ones_loop arr n (i + 1)
