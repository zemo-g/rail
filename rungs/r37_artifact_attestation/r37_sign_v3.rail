-- r37 v3 Ed25519 attestation signer — EXACT-INT eval semantics (eval=xint-q24-v1).
--
-- v2 signed the float-forward metric. v3 signs the exact-integer metric AND the
-- SHA-256 of the full 559-char prediction string, so the signature binds the
-- ENTIRE eval output trace, not just the 64 scored digits. The metric is a
-- deterministic integer function of (weights, splits, r37_xint_spec.md) — any
-- implementation reproduces it bit-for-bit (Rail + Python proven identical).
--
-- DEV-KEY DISCIPLINE (ladder rule, honored from rung 28): the signing key is
-- the LOCAL/DEV key derived from a fixed dev string. Pulses are public
-- read-only input. This NEVER touches the prod Pi-witness sign surface.
--
-- Inputs (written by r37_attest_v3.sh):
--   rungs/r24/force_train_4d.txt / force_holdout_4d.txt          (split, re-hashed)
--   rungs/r37_artifact_attestation/out/r37_force_weights_q24_full.txt (re-hashed)
--   rungs/r37_artifact_attestation/out/metric_v3.txt              (e.g. "62")
--   rungs/r37_artifact_attestation/out/pred_sha_v3.txt            (64-hex)
--   rungs/r37_artifact_attestation/out/max_acc_bits_v3.txt        (e.g. "60")
--   rungs/r37_artifact_attestation/out/pulse_pre_v3_id.txt
--   rungs/r37_artifact_attestation/out/pulse_post_v3_id.txt
-- Output:
--   rungs/r37_artifact_attestation/out/r37_attestation_v3.txt  + stdout prints

import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"

-- PROVEN rung-28 idiom: cut at the first whitespace char.
r37s_ws c = str_find c " \n\t"
r37s_trim_go cs = if cs == [] then []
  else let c = head cs in
       if (r37s_ws c) >= 0 then []
       else cons c (r37s_trim_go (tail cs))
r37s_trim s = cat (r37s_trim_go (chars s))

main =
  let seed = sha256 "r37.local.ephemeral.dev.seed.v1"
  let pk = ed25519_pk_from_sk seed
  let pk_hex = bytes_to_hex pk 32
  let okDevKey = if (bytes_to_hex (ed25519_pk_from_sk (sha256 "r37.local.ephemeral.dev.seed.v1")) 32) == pk_hex then 1 else 0
  let train_sha = sha256_hex (read_file "rungs/r24/force_train_4d.txt")
  let holdout_sha = sha256_hex (read_file "rungs/r24/force_holdout_4d.txt")
  let weight_sha = sha256_hex (read_file "rungs/r37_artifact_attestation/out/r37_force_weights_q24_full.txt")
  let metric = r37s_trim (read_file "rungs/r37_artifact_attestation/out/metric_v3.txt")
  let pred_sha = r37s_trim (read_file "rungs/r37_artifact_attestation/out/pred_sha_v3.txt")
  let macc = r37s_trim (read_file "rungs/r37_artifact_attestation/out/max_acc_bits_v3.txt")
  let pre_id = r37s_trim (read_file "rungs/r37_artifact_attestation/out/pulse_pre_v3_id.txt")
  let post_id = r37s_trim (read_file "rungs/r37_artifact_attestation/out/pulse_post_v3_id.txt")
  let msg_str = cat ["r37|v3|train=", train_sha, "|holdout=", holdout_sha, "|weights=", weight_sha, "|metric=", metric, "/64|pred=", pred_sha, "|T=55|order=w_e,w_o,wq1,wk1,wv1,wf11,wf21,wq2,wk2,wv2,wf12,wf22,ln_g,ln_b|q=Q.24|eval=xint-q24-v1|pulse_pre=", pre_id, "|pulse_post=", post_id]
  let msg_b = sha256 msg_str
  let msg_hex = bytes_to_hex msg_b 32
  let sig = ed25519_sign seed msg_b 32
  let sig_hex = bytes_to_hex sig 64
  let ok = ed25519_verify pk msg_b 32 sig
  let _ = print (cat ["R37_SIGNV3_DEVKEY_OK=", show okDevKey])
  let _ = print (cat ["R37_SIGNV3_PK=", pk_hex])
  let _ = print (cat ["R37_SIGNV3_MSG=", msg_str])
  let _ = print (cat ["R37_SIGNV3_MSG_SHA=", msg_hex])
  let _ = print (cat ["R37_SIGNV3_SIG=", sig_hex])
  let _ = print (cat ["R37_SIGNV3_SELFVERIFY=", show ok, "  (1 = signature verifies under pk)"])
  let rec = cat ["# r37 v3 attestation — exact-int eval (dev key; evolve 2026-06-09)\n",
                 "msg=", msg_str, "\n",
                 "msg_sha256=", msg_hex, "\n",
                 "pk=", pk_hex, "\n",
                 "sig=", sig_hex, "\n",
                 "max_acc_bits=", macc, "\n",
                 "devkey_ok=", show okDevKey, "\n",
                 "selfverify=", show ok, "\n"]
  let _ = write_file "rungs/r37_artifact_attestation/out/r37_attestation_v3.txt" rec
  if ok == 1 then 0 else 1
