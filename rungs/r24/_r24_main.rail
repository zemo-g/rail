
-- ============================================================================================
-- RUNG 24 MAIN: attested generalization under a sealed holdout.
-- ============================================================================================
main =
  let d = 8 in
  let hidden = 64 in
  let cwin = 8 in
  let epochs = 40 in
  let beta1 = 15099494 in
  let beta2 = 16760439 in
  let lr = 209715 in
  let eps = 16777 in
  let sc = arr_new 1 0 in
  let _ = arr_set sc 0 16777216 in
  let s = arr_get sc 0 in
  let isdc = arr_new 1 0 in
  let _ = arr_set isdc 0 5931642 in
  let isd = arr_get isdc 0 in
  let ct = arr_new 32 0 in
  let _ = rt_set_cos ct in
  let st = arr_new 32 0 in
  let _ = rt_set_sin st in
  -- ===== PRE-REGISTERED metric + floor T (written BEFORE the run) =====
  -- T = tnum/tden = 1/2. Held-out ECHO-position accuracy must be >= 1/2. Random baseline = 1/vsize
  -- (~0.037 at vsize=27); lookup baseline = 0 (n-gram is WRONG on every echo position by construction
  -- since the held-out echo context never appears in train). 1/2 sits comfortably between them and is
  -- > 8x random. The gate asserts honest>=T AND lookup<T (the control bracket).
  let tnum = 1 in
  let tden = 2 in
  -- ===== sealed corpus: FIXED vocab over the union; train-only training set; holdout test set =====
  let vocab = read_file "rungs/r24/r24_vocab.txt" in
  let vsize = lm4_len (chars vocab) in
  let train_text = read_file "rungs/r24/r24_train_corpus.txt" in
  let hold_text = read_file "rungs/r24/r24_holdout_corpus.txt" in
  let chash = sha256_hex train_text in
  -- SPLIT commitments (canonical sorted-unique line sets)
  let train_sha = r24_split_sha train_text in
  let hold_sha = r24_split_sha hold_text in
  -- tokens use the FIXED union vocab so held-out digit ids match train digit ids
  let train_ids = lm4_tokens train_text vocab in
  let hold_ids = lm4_tokens hold_text vocab in
  let pairs = lm4_pairs train_ids cwin in
  let npairs = lm4_len pairs in
  let indim = cwin * d in
  let ff = d * 4 in
  -- ===== initial weights (deterministic; identical seeds to lm10) =====
  let w1c0 = lm4_initmat 0 hidden indim 0 in
  let w2c0 = lm4_initmat 1 vsize hidden 0 in
  let ec0 = lm4_emb_initmat vsize d in
  let wqc0 = lm5_qkv_init 30 d in
  let wkc0 = lm5_qkv_init 31 d in
  let wvc0 = lm5_qkv_init 32 d in
  let gammac0 = rn_gamma_init d in
  let gamma2c0 = rn_gamma_init d in
  let wff1c0 = lm4_initmat 33 ff d 0 in
  let wff2c0 = lm4_initmat 34 d ff 0 in
  let b1wqc0 = lm5_qkv_init 35 d in
  let b1wkc0 = lm5_qkv_init 36 d in
  let b1wvc0 = lm5_qkv_init 37 d in
  let b1gammac0 = rn_gamma_init d in
  let b1gamma2c0 = rn_gamma_init d in
  let b1wff1c0 = lm4_initmat 38 ff d 0 in
  let b1wff2c0 = lm4_initmat 39 d ff 0 in
  -- ===== LOCAL/DEV key + LOCAL genesis (never a prod sign surface) =====
  let seed = sha256 "r24.local.ephemeral.dev.seed.v1" in
  let pk = ed25519_pk_from_sk seed in
  let pk_hex = bytes_to_hex pk 32 in
  let genesis_hex = sha256_hex "R24.LOCAL.BEACON.GENESIS.dev" in
  -- falsification probes (tamper / wrong-key) -- same pattern as lm10
  let pmsg = sha256 "r24.tamper.probe" in
  let psig = ed25519_sign seed pmsg 32 in
  let okGood = ed25519_verify pk pmsg 32 psig in
  let tsig = arr_new 64 0 in
  let _ = sha_copy_bytes psig tsig 0 0 64 in
  let _ = arr_set tsig 5 (bit_xor (arr_get tsig 5) 1) in
  let okBad = ed25519_verify pk pmsg 32 tsig in
  let seed2 = sha256 "r24.other.key" in
  let wsig = ed25519_sign seed2 pmsg 32 in
  let okW = ed25519_verify pk pmsg 32 wsig in
  -- ===== SPLIT record: signed, prev=genesis, BEFORE checkpoint 0 =====
  let splitr = r24_split_record genesis_hex train_sha hold_sha cwin tnum tden seed pk in
  let split_link = lm4_nth splitr 0 in
  let split_line = lm4_nth splitr 1 in
  let okSplitSig = lm4_nth splitr 2 in
  -- wp0 bundle (17 configs)
  let wp0 = cons w1c0 (cons w2c0 (cons ec0 (cons wqc0 (cons wkc0 (cons wvc0 (cons gammac0 (cons gamma2c0 (cons wff1c0 (cons wff2c0 (cons b1wqc0 (cons b1wkc0 (cons b1wvc0 (cons b1gammac0 (cons b1gamma2c0 (cons b1wff1c0 (cons b1wff2c0 [])))))))))))))))) in
  -- ===== held-out echo mask + lookup baseline (computed once; weight-independent) =====
  let echomask = r24_echomask hold_ids vocab cwin in
  let train_wins = r24_build_train_wins train_ids cwin in
  let lookr = r24_lookup_eval train_wins hold_ids echomask cwin vsize in
  let lookup_ec = lm4_nth lookr 0 in
  let lookup_et = lm4_nth lookr 1 in
  -- ===== CHECKPOINT-0 ABORT GATE: held-out echo acc at epoch-0 (PRE-training) weights =====
  -- abort iff echo acc already >= T (split leak / trivial metric). honest model must START below T.
  let e0w1 = lm4_thmat w1c0 in
  let e0w2 = lm4_thmat w2c0 in
  let e0emb = lm4_thmat ec0 in
  let e0blk0 = lm4_blk0_of wp0 in
  let e0blk1 = lm4_blk1_of wp0 in
  let ev0 = r24_eval ct st e0w1 e0w2 e0emb e0blk0 e0blk1 isd hold_ids echomask cwin in
  let ec0count = lm4_nth ev0 0 in
  let et0count = lm4_nth ev0 1 in
  -- echo acc >= T  <=>  ec*tden >= et*tnum  (exact integer comparison; no division)
  let ckpt0_ge_T = if (ec0count * tden) >= (et0count * tnum) then 1 else 0 in
  let okCkpt0Abort = if ckpt0_ge_T == 0 then 1 else 0 in
  -- ===== attested training (checkpoint-cadence) -> final weights =====
  let mk = arena_mark 0 in
  let res = lm4_chain ct st wp0 pairs d hidden vsize indim isd s beta1 beta2 lr eps 16777216 16777216 seed pk epochs 0 split_link "" 1 in
  let all_ok = lm4_nth res 0 in
  let body = lm4_nth res 1 in
  let head_link = lm4_nth res 2 in
  let fwp = lm4_nth res 3 in
  let fw1 = lm4_thmat (lm4_nth fwp 0) in
  let fw2 = lm4_thmat (lm4_nth fwp 1) in
  let femb = lm4_thmat (lm4_nth fwp 2) in
  let fblk0 = lm4_blk0_of fwp in
  let fblk1 = lm4_blk1_of fwp in
  let ds0 = lm4_dsloss ct st pairs (lm4_thmat w1c0) (lm4_thmat w2c0) (lm4_thmat ec0) (lm4_blk0_of wp0) (lm4_blk1_of wp0) isd vsize s in
  let dsK = lm4_dsloss ct st pairs fw1 fw2 femb fblk0 fblk1 isd vsize s in
  -- ===== HELD-OUT eval on the honestly-trained final weights =====
  let evK = r24_eval ct st fw1 fw2 femb fblk0 fblk1 isd hold_ids echomask cwin in
  let honest_ec = lm4_nth evK 0 in
  let honest_et = lm4_nth evK 1 in
  let honest_fc = lm4_nth evK 2 in
  let honest_ft = lm4_nth evK 3 in
  -- ===== THE GATE: honest echo-acc >= T  AND  lookup echo-acc < T  (control bracket) =====
  let honest_ge_T = if (honest_ec * tden) >= (honest_et * tnum) then 1 else 0 in
  let lookup_lt_T = if (lookup_ec * tden) < (lookup_et * tnum) then 1 else 0 in
  let okGeneralize = honest_ge_T in
  let okBracket = if (honest_ge_T == 1) then lookup_lt_T else 0 in
  -- ===== FALSIFIER (1): train-on-holdout -> reconstructed train-SHA != signed SPLIT =====
  -- the overfit corpus = train ++ holdout. Its canonical split-SHA differs from the signed train_sha,
  -- so a ledger that trained on holdout cannot match the SPLIT commitment.
  let overfit_text = read_file "rungs/r24/r24_overfit_corpus.txt" in
  let overfit_sha = r24_split_sha overfit_text in
  let okSplitFalsify = if overfit_sha == train_sha then 0 else 1 in
  -- ===== FALSIFIER (3): post-hoc holdout swap -> recomputed holdout SHA != SPLIT =====
  -- swapping the holdout set (e.g. to the train set) changes hold_sha -> mismatch detected.
  let swapped_hold_sha = r24_split_sha train_text in
  let okSwapFalsify = if swapped_hold_sha == hold_sha then 0 else 1 in
  -- ===== ledger =====
  let header = cat ["# R24v1 ", pk_hex, " ", genesis_hex, " ", show epochs, " ", chash,
                    " d=", show d, " hidden=", show hidden, " vsize=", show vsize, " cwin=", show cwin,
                    " beta1=", show beta1, " beta2=", show beta2, " lr=", show lr, " eps=", show eps, " isd=", show isd,
                    " nheads=", show lm10_nh, " nblocks=2",
                    " tnum=", show tnum, " tden=", show tden,
                    " train_sha=", train_sha, " hold_sha=", hold_sha, "\n"] in
  let _ = write_file "rungs/r24/out/r24_chain.txt" (cat [header, split_line, "\n", body]) in
  let _ = write_file "rungs/r24/out/r24_eval.txt"
    (cat ["honest_echo=", show honest_ec, "/", show honest_et,
          " honest_full=", show honest_fc, "/", show honest_ft,
          " lookup_echo=", show lookup_ec, "/", show lookup_et,
          " ckpt0_echo=", show ec0count, "/", show et0count,
          " T=", show tnum, "/", show tden, "\n"]) in
  -- ===== D0 re-run (Rail self-witness): re-train from the SPLIT link, reproduce the head =====
  let _ = write_file "rungs/r24/out/u_head.txt" head_link in
  let _ = write_file "rungs/r24/out/u_split.txt" split_link in
  let _ = arena_reset mk in
  let head_link = read_file "rungs/r24/out/u_head.txt" in
  let split_link2 = read_file "rungs/r24/out/u_split.txt" in
  let res2 = lm4_chain_d0 ct st wp0 pairs d hidden vsize indim isd s beta1 beta2 lr eps 16777216 16777216 epochs 0 split_link2 in
  let head2 = lm4_nth res2 0 in
  let okD0 = if head_link == head2 then 1 else 0 in
  -- ===== gates =====
  let okSigs = if all_ok == 1 then 1 else 0 in
  let okSplit = if okSplitSig == 1 then 1 else 0 in
  let okProg = if dsK < ds0 then 1 else 0 in
  let okTamper = if okGood == 1 then (if okBad == 0 then 1 else 0) else 0 in
  let okWrongKey = if okW == 0 then 1 else 0 in
  let all = okSigs * okSplit * okProg * okTamper * okWrongKey * okD0 * okCkpt0Abort * okGeneralize * okBracket * okSplitFalsify * okSwapFalsify in
  let _ = print "================ RUNG 24: SEALED HOLDOUT (ATTESTED GENERALIZATION) ================" in
  let _ = print (cat ["train corpus pin: SHA-256 ", chash]) in
  let _ = print (cat ["SPLIT train_sha = ", train_sha]) in
  let _ = print (cat ["SPLIT hold_sha  = ", hold_sha]) in
  let _ = print (cat ["model: vocab=", show vsize, " d=", show d, " nheads=", show lm10_nh, " nblocks=2 hidden=", show hidden, " ctx=", show cwin, " epochs=", show epochs, " pairs=", show npairs, " (exact-integer Q.24)"]) in
  let _ = print (cat ["train loss descent: ", show ds0, " -> ", show dsK, "  (descent=", show okProg, ")"]) in
  let _ = print "------ pre-registered held-out gate ------" in
  let _ = print (cat ["floor T = ", show tnum, "/", show tden, "  (held-out ECHO-position next-token accuracy)"]) in
  let _ = print (cat ["checkpoint-0 echo acc = ", show ec0count, "/", show et0count, "  (must be < T at epoch 0; abort-ok=", show okCkpt0Abort, ")"]) in
  let _ = print (cat ["HONEST model echo acc = ", show honest_ec, "/", show honest_et, "  (>= T : ", show honest_ge_T, ")"]) in
  let _ = print (cat ["HONEST model full acc = ", show honest_fc, "/", show honest_ft]) in
  let _ = print (cat ["LOOKUP baseline echo  = ", show lookup_ec, "/", show lookup_et, "  (< T : ", show lookup_lt_T, ")  -- n-gram fails the copy rule by construction"]) in
  let _ = print "------ verification ------" in
  let _ = print (cat ["per-checkpoint sigs verify       = ", show okSigs]) in
  let _ = print (cat ["SPLIT record signature verifies  = ", show okSplit]) in
  let _ = print (cat ["training reproduces (D0)         = ", show okD0]) in
  let _ = print (cat ["GENERALIZES (honest >= T)        = ", show okGeneralize]) in
  let _ = print (cat ["CONTROL BRACKET (honest>=T>lookup)= ", show okBracket]) in
  let _ = print (cat ["FALSIFIER train-on-holdout->SHA!=  = ", show okSplitFalsify]) in
  let _ = print (cat ["FALSIFIER post-hoc holdout swap   = ", show okSwapFalsify]) in
  let _ = print (cat ["tamper-reject (flipped sig)      = ", show okTamper]) in
  let _ = print (cat ["wrong-key-reject                 = ", show okWrongKey]) in
  let _ = print (cat ["signed ledger: rungs/r24/out/r24_chain.txt  (1 SPLIT + ", show epochs, " checkpoints)"]) in
  let _ = print (if all == 1
    then "PASS: a Rail-native transformer trained on a SEALED train split, GENERALIZED to a signed holdout (echo-acc >= T while the lookup baseline fails), bound the SPLIT into its Ed25519 chain before checkpoint 0, and an independent re-run reproduced the head. Train-on-holdout and post-hoc swap are rejected by SHA mismatch."
    else "FAIL") in
  if all == 1 then 0 else 1
