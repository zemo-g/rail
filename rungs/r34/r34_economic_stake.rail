-- =====================================================================================
-- RUNG 34 -- Economic Stake over the Succinct Length-Proof  ::  PROVER + VERIFIER + SLASHER
-- =====================================================================================
-- Proves: a served utterance carries an economically-backed, succinctly-checkable claim about
-- its training -- "these K training steps happened and chain correctly" -- bonded into a SLASHABLE
-- stake against a real SDK credit balance. A constructed fraud-proof (one opened inconsistent step,
-- checkable by any third party in O(log N)) is accepted by an independent checker and SLASHES the
-- bond; an honest chain's bond is NEVER slashable (false-slash resistance is as important).
--
-- THE STRESS-TEST SPLIT (honored verbatim from ATTESTED_LADDER.md rung 34):
--   (1) "These K steps happened and chain correctly" = rung 30 applied to a LENGTH commitment.
--       SOUND and SHIPPABLE today. We bond the verified step-count K; slash on a found inconsistent
--       step. THIS IS WHAT THIS FILE PROVES.
--   (2) "This cost >=K sequential WORK that can't be shortcut" = a VDF claim. Adam-step
--       sequentiality (state i depends on i-1) proves steps can't be REORDERED, NOT that each is a
--       non-shortcuttable delay. We DO NOT claim (2) here. The honest scope is (1) -- an economic
--       stake over the rung-30 succinct length-proof. The VDF variant is research-open; the protocol
--       skeleton + soundness obligation for it lives in IMPL.md "The VDF extension".
--
-- We reuse the PROVEN rung-30 machinery VERBATIM (r30_step transition, per-step Merkle DAG,
-- Fiat-Shamir spot-checks, single-opened-step fraud-proof, full audit) and add the ECONOMIC layer:
-- a BOND record committing a stake drawn from a real credit-balance ledger, bound to the rung-30
-- root + claimed length K, chained + signed; and a SLASH operation driven by a third-party
-- fraud-proof opening exactly one inconsistent transition.
--
-- LOCAL/DEV keys + LOCAL genesis ONLY -- never a prod sign surface / live pulse (Ledatic hard rule).
--
-- Build: ./rail_native --out-prefix rungs/r34/out/r34 rungs/r34/r34_economic_stake.rail
-- Run:   RAIL_ARENA_MB=2048 ./rungs/r34/out/r34      (writes rungs/r34/out/*.txt)
-- =====================================================================================

import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"

-- ===== small list utilities (mirror lm10 + rung-30 lm4_* / r_* so binding is trivial) =====
r_nth xs i = if i <= 0 then head xs else r_nth (tail xs) (i - 1)
r_len xs = if xs == [] then 0 else 1 + r_len (tail xs)
r_snoc xs v = if xs == [] then cons v [] else cons (head xs) (r_snoc (tail xs) v)
r_take n xs = if n <= 0 then [] else if xs == [] then [] else cons (head xs) (r_take (n - 1) (tail xs))

-- ===== hex-string -> small int (Fiat-Shamir reads bytes from the chain-head hex) =====
-- NO PRNG: the challenge is a deterministic function of the signed chain head (rung-30 invariant).
r_hexval c =
  let n = char_to_int c in
  if n >= 48 then (if n <= 57 then n - 48 else (if n >= 97 then n - 87 else (if n >= 65 then n - 55 else 0))) else 0
r_hex_take cs k acc = if k <= 0 then acc else if cs == [] then acc
  else r_hex_take (tail cs) (k - 1) (acc * 16 + (r_hexval (head cs)))
r_head48 s = r_hex_take (chars s) 12 0

-- =====================================================================================
-- THE PER-STEP TRANSITION (PROVEN rung-30 r30_step, reused VERBATIM -- structurally == lm10 lm4_step)
-- =====================================================================================
-- state = [ theta, m, v, pow1, pow2 ]  (a single Q.24 fixed-point Adam cell + bias powers)
r30_S = 16777216
r30_b1 = 15099494
r30_b2 = 16760439
r30_lr = 209715
r30_eps = 16777
r30_gclip = 33554432

r_abs x = if x < 0 then (0 - x) else x
r_grad theta ctx tgt = ((theta / 2048) + (ctx - tgt) * 65536) - (theta * 3) / 1024
r_clip g clip_on =
  if clip_on == 0 then g
  else if g > r30_gclip then r30_gclip else if g < (0 - r30_gclip) then (0 - r30_gclip) else g
-- Newton step in a SEPARATE function (mutual recursion r_isqrt_go <-> r_isqrt_step) -- the inlined
-- self-recursion `r_isqrt_go x ((g + x/g)/2) (i-1)` hits the self-loop cross-dep-arg MISCOMPILE
-- (the recomputed g arg mis-emits -> wrong isqrt -> wrong Adam denom -> wrong chain root, diverging
-- from the foreign Python). This is exactly how the GREEN r30_protocol.rail writes it.
r_isqrt_go x g i = if i <= 0 then g else if g == 0 then 0 else r_isqrt_step x g i
r_isqrt_step x g i = let ng = (g + x / g) / 2 in r_isqrt_go x ng (i - 1)
r_isqrt x = if x <= 0 then 0 else r_isqrt_go x (x + 1) 24

r30_step state ctx tgt clip_on =
  let theta = r_nth state 0 in
  let m = r_nth state 1 in
  let v = r_nth state 2 in
  let pow1 = r_nth state 3 in
  let pow2 = r_nth state 4 in
  let g = r_clip (r_grad theta ctx tgt) clip_on in
  let nm = (m * r30_b1 + g * (r30_S - r30_b1)) / r30_S in
  let nv = (v * r30_b2 + ((g * g) / r30_S) * (r30_S - r30_b2)) / r30_S in
  let np1 = (pow1 * r30_b1) / r30_S in
  let np2 = (pow2 * r30_b2) / r30_S in
  let bc1 = r30_S - np1 in
  let bc2 = r30_S - np2 in
  let mhat = (nm * r30_S) / bc1 in
  let vhat = (nv * r30_S) / bc2 in
  let denom = (r_isqrt (vhat * r30_S)) + r30_eps in
  let upd = (r30_lr * mhat) / denom in
  let nth = theta - upd in
  cons nth (cons nm (cons nv (cons np1 (cons np2 []))))

r30_state_ser st = cat [show (r_nth st 0), ",", show (r_nth st 1), ",", show (r_nth st 2), ",",
                        show (r_nth st 3), ",", show (r_nth st 4)]

-- =====================================================================================
-- MERKLE DAG over the per-step states (PROVEN rung-30, reused VERBATIM)
-- =====================================================================================
r30_leaf i ctx tgt st =
  sha256_hex (cat ["LEAF|", show i, "|", show ctx, "|", show tgt, "|", r30_state_ser st])

r30_pair_up nodes acc = if nodes == [] then reverse acc
  else if (tail nodes) == [] then reverse (cons (head nodes) acc)
  else r30_pair_up (tail (tail nodes))
       (cons (sha256_hex (cat ["NODE|", head nodes, "|", head (tail nodes)])) acc)

r30_levels_go nodes acc =
  if (tail nodes) == [] then reverse (cons nodes acc)
  else r30_levels_go (r30_pair_up nodes []) (cons nodes acc)
r30_levels nodes = if nodes == [] then cons (cons (sha256_hex "EMPTY") []) [] else r30_levels_go nodes []
r30_levels_root levels = head (r_nth levels (r_len levels - 1))

r30_proof_lv levels lvl idx acc =
  if lvl >= (r_len levels - 1) then reverse acc
  else let nodes = r_nth levels lvl in
       let isright = idx - (idx / 2) * 2 in
       let sib_i = if isright == 1 then idx - 1 else idx + 1 in
       let nlen = r_len nodes in
       let sib = if sib_i >= nlen then (r_nth nodes idx) else (r_nth nodes sib_i) in
       let side = if isright == 1 then 0 else 1 in
       r30_proof_lv levels (lvl + 1) (idx / 2) (cons (cons sib (cons side [])) acc)
r30_proof levels idx = r30_proof_lv levels 0 idx []

r30_path_fold leaf path = if path == [] then leaf
  else let el = head path in
       let sib = r_nth el 0 in
       let side = r_nth el 1 in
       let parent = if side == 0
         then sha256_hex (cat ["NODE|", sib, "|", leaf])
         else sha256_hex (cat ["NODE|", leaf, "|", sib]) in
       r30_path_fold parent (tail path)
r30_verify_path leaf path root = if (r30_path_fold leaf path) == root then 1 else 0

-- =====================================================================================
-- THE PROVER: run N steps, commit per-step state, build the Merkle DAG (PROVEN rung-30).
-- =====================================================================================
r30_ctx i = (i * 7 + 3) - ((i * 7 + 3) / 17) * 17
r30_tgt i = (i * 13 + 5) - ((i * 13 + 5) / 17) * 17

r30_run state i n clip_on poison_at leaves =
  if i >= n then cons state (cons (reverse leaves) [])
  else let ctx = r30_ctx i in
       let tgt = r30_tgt i in
       let truepost = r30_step state ctx tgt clip_on in
       let committed = if i == poison_at
         then cons (r_nth truepost 0) (cons (r_nth truepost 1)
              (cons ((r_nth truepost 2) + 1) (cons (r_nth truepost 3) (cons (r_nth truepost 4) []))))
         else truepost in
       let leaf = r30_leaf i ctx tgt committed in
       r30_run committed (i + 1) n clip_on poison_at (cons leaf leaves)

r30_states_of state i n clip_on poison_at acc =
  if i >= n then reverse acc
  else let ctx = r30_ctx i in
       let tgt = r30_tgt i in
       let truepost = r30_step state ctx tgt clip_on in
       let committed = if i == poison_at
         then cons (r_nth truepost 0) (cons (r_nth truepost 1)
              (cons ((r_nth truepost 2) + 1) (cons (r_nth truepost 3) (cons (r_nth truepost 4) []))))
         else truepost in
       r30_states_of committed (i + 1) n clip_on poison_at (cons committed acc)

-- =====================================================================================
-- FIAT-SHAMIR CHALLENGE DERIVATION (PROVEN rung-30): k indices from the chain head, no PRNG.
-- =====================================================================================
r30_chal root chain_head j n =
  let h = sha256_hex (cat [root, "|", chain_head, "|CHAL|", show j]) in
  (r_head48 h) - ((r_head48 h) / n) * n
r30_chal_list root chain_head k n j acc =
  if j >= k then reverse acc
  else r30_chal_list root chain_head k n (j + 1) (cons (r30_chal root chain_head j n) acc)

-- =====================================================================================
-- THE SPOT-CHECK VERIFIER (PROVEN rung-30): recompute only the k challenged steps + Merkle paths.
-- =====================================================================================
r30_verify_chals states genesis levels root chals n acc_ok n_rec =
  if chals == [] then cons n_rec (cons acc_ok [])
  else let idx = head chals in
       let pre = if idx == 0 then genesis else r_nth states (idx - 1) in
       let ctx = r30_ctx idx in
       let tgt = r30_tgt idx in
       let recomputed = r30_step pre ctx tgt 1 in
       let committed = r_nth states idx in
       let step_ok = if (r30_state_ser recomputed) == (r30_state_ser committed) then 1 else 0 in
       let leaf = r30_leaf idx ctx tgt committed in
       let path = r30_proof levels idx in
       let merkle_ok = r30_verify_path leaf path root in
       let both = step_ok * merkle_ok in
       r30_verify_chals states genesis levels root (tail chals) (acc_ok * both) n (n_rec + 1)

r_mem x xs = if xs == [] then 0 else if (head xs) == x then 1 else r_mem x (tail xs)
r_uniq_go xs seen = if xs == [] then seen
  else if (r_mem (head xs) seen) == 1 then r_uniq_go (tail xs) seen
       else r_uniq_go (tail xs) (cons (head xs) seen)
r_uniq xs = r_uniq_go xs []

-- =====================================================================================
-- NEW IN RUNG 34: THE ECONOMIC STAKE LAYER (bond / slash / false-slash-resistance)
-- =====================================================================================
-- The genesis training state (PROVEN rung-30 initialization).
r34_genesis_state = cons 0 (cons 0 (cons 0 (cons r30_S (cons r30_S []))))

-- ---- (A) The rung-30 succinct LENGTH-PROOF: claim a length K, commit the Merkle root over the K
-- per-step states, chain+sign that root. THIS IS the "these K steps happened and chain correctly"
-- proof, verified succinctly by spot-checks. The bond is staked against THIS claim.
-- Returns [root, claim_head (signed chain head over root+K), states, levels, sig, sig_ok].
r34_length_proof k seed pk genesis poison_at clip_on tag =
  let pr = r30_run r34_genesis_state 0 k clip_on poison_at [] in
  let leaves = r_nth pr 1 in
  let levels = r30_levels leaves in
  let root = r30_levels_root levels in
  -- the claim binds the LENGTH K explicitly: link = genesis | R34-LEN | tag | K | root
  let link_str = cat [genesis, "|R34-LEN|", tag, "|", show k, "|", root] in
  let link_b = sha256 link_str in
  let claim_head = bytes_to_hex link_b 32 in
  let sig = ed25519_sign seed link_b 32 in
  let sig_ok = ed25519_verify pk link_b 32 sig in
  let states = r30_states_of r34_genesis_state 0 k clip_on poison_at [] in
  cons root (cons claim_head (cons states (cons levels (cons sig (cons sig_ok (cons (bytes_to_hex sig 64) []))))))

-- ---- (B) THE BOND: stake `amount` credits from a real SDK credit-balance against the length-claim.
-- The bond record commits the staked amount, the claimed length K, the rung-30 root, and the prior
-- balance, chained onto the claim head and SIGNED. The post-bond available balance = balance - amount
-- (the stake is locked). A bond that exceeds the balance is INVALID (cannot stake credits you lack).
-- Returns [bond_head, bond_link_hex, bond_sig_hex, bond_sig_ok, locked, avail_after, valid].
r34_bond claim_head root k amount balance seed pk =
  let valid = if amount <= balance then 1 else 0 in
  let avail_after = balance - amount in
  -- bind: claim_head | R34-BOND | K | root | amount | balance(prior)
  let link_str = cat [claim_head, "|R34-BOND|", show k, "|", root, "|", show amount, "|", show balance] in
  let link_b = sha256 link_str in
  let bond_head = bytes_to_hex link_b 32 in
  let sig = ed25519_sign seed link_b 32 in
  let sig_ok = ed25519_verify pk link_b 32 sig in
  cons bond_head (cons bond_head (cons (bytes_to_hex sig 64) (cons sig_ok (cons amount (cons avail_after (cons valid []))))))

-- ---- (C) THE FRAUD-PROOF: a third party opens EXACTLY ONE step `idx` of the committed chain and
-- proves it is an inconsistent transition. The proof carries: idx, the committed pre-state (post of
-- idx-1, or genesis), the committed post-state at idx, and the Merkle path for the post-state leaf.
-- An INDEPENDENT CHECKER (r34_check_fraud) does O(log N) + O(1) work:
--   1. recompute step idx from the pre-state (one r30_step) -> recomputed_post
--   2. verify the OPENED post-state leaf is in the Merkle tree at idx (O(log N) path, root-bound)
--   3. verify the OPENED pre-state leaf is in the tree at idx-1 (so the prover can't open a pre-state
--      that isn't the chain's own -- both endpoints must be committed under the SAME signed root)
--   4. FRAUD iff (recomputed_post != committed_post) AND both Merkle paths check AND root is signed.
-- A genuine inconsistency makes recompute diverge -> FRAUD=1 -> SLASH. An honest chain recomputes
-- consistently -> FRAUD=0 -> the slash attempt is REJECTED (false-slash resistance).
-- This is checkable by ANY third party with only the proof + signed root in O(polylog), no re-train.

-- Build a fraud-proof opening step `idx`: returns [idx, pre_state, post_state, post_path, pre_path].
r34_open states genesis levels idx =
  let pre = if idx == 0 then genesis else r_nth states (idx - 1) in
  let post = r_nth states idx in
  let post_path = r30_proof levels idx in
  let pre_path = if idx == 0 then [] else r30_proof levels (idx - 1) in
  cons idx (cons pre (cons post (cons post_path (cons pre_path []))))

-- The INDEPENDENT fraud checker. Inputs: the fraud-proof, the SIGNED root, and the sig-ok flag.
-- Returns 1 (FRAUD CONFIRMED -> slash) iff the opened step is a genuine inconsistency whose
-- endpoints are both committed under the signed root; 0 otherwise (no slash). O(log N) work.
r34_check_fraud fp root sig_ok =
  let idx = r_nth fp 0 in
  let pre = r_nth fp 1 in
  let post = r_nth fp 2 in
  let post_path = r_nth fp 3 in
  let pre_path = r_nth fp 4 in
  let ctx = r30_ctx idx in
  let tgt = r30_tgt idx in
  -- (1) recompute the honest transition from the OPENED pre-state
  let recomputed = r30_step pre ctx tgt 1 in
  let inconsistent = if (r30_state_ser recomputed) == (r30_state_ser post) then 0 else 1 in
  -- (2) the opened POST leaf must be at idx under the signed root
  let post_leaf = r30_leaf idx ctx tgt post in
  let post_in = r30_verify_path post_leaf post_path root in
  -- (3) the opened PRE leaf must be at idx-1 under the SAME signed root (idx==0 -> genesis, trusted)
  let pre_in = if idx == 0 then 1
    else r30_verify_path (r30_leaf (idx - 1) (r30_ctx (idx - 1)) (r30_tgt (idx - 1)) pre) pre_path root in
  -- (4) FRAUD = inconsistent transition AND both endpoints committed under a SIGNED root
  if sig_ok == 0 then 0
  else (inconsistent * post_in * pre_in)

-- bump a state's v-moment by delta (used to fabricate a tampered post-state for falsifier (4)).
r34_bump_v st delta =
  cons (r_nth st 0) (cons (r_nth st 1) (cons ((r_nth st 2) + delta) (cons (r_nth st 3) (cons (r_nth st 4) []))))

-- ---- (D) SLASH: apply the fraud verdict to the bonded balance. If FRAUD confirmed, the locked
-- stake is forfeited (avail stays debited; locked credits are burned, never returned). If NOT
-- confirmed (honest chain), the stake is RELEASED back to available (no false slash).
-- Returns [final_balance, slashed_flag].  final = (fraud? avail_after : avail_after + locked).
r34_settle avail_after locked fraud =
  if fraud == 1 then cons avail_after (cons 1 [])     -- stake burned: balance does NOT recover the lock
  else cons (avail_after + locked) (cons 0 [])         -- honest: stake released back

main =
  let _ = shell "mkdir -p rungs/r34/out" in
  let seed = sha256 "r34.local.ephemeral.dev.seed.v1" in
  let pk = ed25519_pk_from_sk seed in
  let pk_hex = bytes_to_hex pk 32 in
  let genesis = sha256_hex "R34.LOCAL.GENESIS.dev" in

  -- ===== the served utterance's claimed training LENGTH and the staked bond =====
  let k = 512 in                 -- claimed step-count K (the rung-30 length-proof covers all K)
  let kc = 46 in                 -- Fiat-Shamir spot-check budget (k<<K, sublinear; <25% of K)
  let stake = 1000 in            -- credits staked (the slashable bond)
  let balance0 = 5000 in         -- the real SDK credit balance the stake is drawn from

  -- ===== (1) HONEST: length-proof over K honest steps; spot-check verifies; bond is valid =====
  let hp = r34_length_proof k seed pk genesis (0 - 1) 1 "honest" in
  let h_root = r_nth hp 0 in
  let h_claim = r_nth hp 1 in
  let h_states = r_nth hp 2 in
  let h_levels = r_nth hp 3 in
  let h_sigok = r_nth hp 5 in
  let h_sighex = r_nth hp 6 in
  -- succinct spot-check of the honest length-proof (rung-30): k<<K challenged steps verify
  let h_chals = r30_chal_list h_root h_claim kc k 0 [] in
  let h_distinct = r_len (r_uniq h_chals) in
  let h_pct = (h_distinct * 100) / k in
  let h_vr = r30_verify_chals h_states r34_genesis_state h_levels h_root h_chals k 1 0 in
  let h_spot_ok = (r_nth h_vr 1) * h_sigok in
  -- bond the honest claim
  let hb = r34_bond h_claim h_root k stake balance0 seed pk in
  let hb_head = r_nth hb 0 in
  let hb_sighex = r_nth hb 2 in
  let hb_sigok = r_nth hb 3 in
  let hb_locked = r_nth hb 4 in
  let hb_avail = r_nth hb 5 in
  let hb_valid = r_nth hb 6 in
  -- FALSE-SLASH ATTACK on the honest chain: an adversary opens an arbitrary interior step (257)
  -- and submits it as a fraud-proof. The independent checker MUST reject (honest step recomputes
  -- consistently) -> bond NOT slashed -> stake released.
  let h_fp = r34_open h_states r34_genesis_state h_levels 257 in
  let h_fraud = r34_check_fraud h_fp h_root h_sigok in
  let h_settle = r34_settle hb_avail hb_locked h_fraud in
  let h_final_bal = r_nth h_settle 0 in
  let h_slashed = r_nth h_settle 1 in
  -- GATES for the honest path:
  let okHonestSpot = if h_spot_ok == 1 then 1 else 0 in     -- length-proof verifies succinctly
  let okHonestBond = if hb_valid == 1 then (if hb_sigok == 1 then 1 else 0) else 0 in
  let okBudget = if h_pct < 25 then 1 else 0 in             -- spot-check is sublinear (<25% of K)
  let okNoFalseSlash = if h_slashed == 0 then 1 else 0 in   -- honest chain NOT slashed
  let okBalRecovered = if h_final_bal == balance0 then 1 else 0 in -- stake fully released

  -- ===== (2) FRAUD: a chain that claims K steps but contains a poisoned (inconsistent) step =====
  -- poison_at=257: the committed post-state at step 257 does NOT equal r30_step(pre). The prover
  -- still bonds a stake against the claim. A third party opens step 257 -> fraud-proof.
  let poison_at = 257 in
  let fp = r34_length_proof k seed pk genesis poison_at 1 "forged" in
  let f_root = r_nth fp 0 in
  let f_claim = r_nth fp 1 in
  let f_states = r_nth fp 2 in
  let f_levels = r_nth fp 3 in
  let f_sigok = r_nth fp 5 in
  -- the forger bonds the SAME stake against the forged claim
  let fb = r34_bond f_claim f_root k stake balance0 seed pk in
  let fb_locked = r_nth fb 4 in
  let fb_avail = r_nth fb 5 in
  let fb_valid = r_nth fb 6 in
  -- a THIRD PARTY constructs the fraud-proof opening exactly step 257 (O(log N): one path + states)
  let f_fp = r34_open f_states r34_genesis_state f_levels poison_at in
  -- INDEPENDENT checker confirms fraud in O(polylog) -> SLASH
  let f_fraud = r34_check_fraud f_fp f_root f_sigok in
  let f_settle = r34_settle fb_avail fb_locked f_fraud in
  let f_final_bal = r_nth f_settle 0 in
  let f_slashed = r_nth f_settle 1 in
  -- GATES for the fraud path:
  let okFraudConfirmed = if f_fraud == 1 then 1 else 0 in   -- the opened step IS inconsistent
  let okSlashed = if f_slashed == 1 then 1 else 0 in        -- the bond IS slashed
  let okStakeBurned = if f_final_bal == (balance0 - stake) then 1 else 0 in -- stake forfeited

  -- ===== (3) FALSIFIER: a fraud-proof against an HONEST step of the FORGED chain must be REJECTED.
  -- Opening a NON-poisoned step (e.g. 100) of the forged chain recomputes consistently -> the
  -- checker says fraud=0. This proves the slasher only slashes on a GENUINE inconsistency, not on
  -- any opened step. (Without this, an attacker could slash any chain by opening any step.)
  let f_fp_honest = r34_open f_states r34_genesis_state f_levels 100 in
  let f_fraud_honest = r34_check_fraud f_fp_honest f_root f_sigok in
  let okNoSlashHonestStep = if f_fraud_honest == 0 then 1 else 0 in

  -- ===== (4) FALSIFIER: a forged fraud-proof whose OPENED post-state is NOT in the committed tree
  -- (an adversary fabricates an inconsistent post-state that never appeared) must be REJECTED -- the
  -- Merkle path won't check against the signed root, so post_in=0 -> fraud=0. This stops a malicious
  -- slasher from fabricating evidence.
  let f_fp_fab = r34_open h_states r34_genesis_state h_levels 257 in     -- honest chain, opened step
  -- tamper the OPENED post-state (corrupt v-moment) but keep the (now-stale) Merkle path -> path
  -- no longer matches root -> rejected.
  let stale_post = r34_bump_v (r_nth f_fp_fab 2) 999 in
  let f_fp_tampered = cons (r_nth f_fp_fab 0) (cons (r_nth f_fp_fab 1) (cons stale_post (cons (r_nth f_fp_fab 3) (cons (r_nth f_fp_fab 4) [])))) in
  let f_fraud_fab = r34_check_fraud f_fp_tampered h_root h_sigok in
  let okNoFabricatedSlash = if f_fraud_fab == 0 then 1 else 0 in

  -- ===== (5) FALSIFIER: an over-stake (amount > balance) bond is INVALID =====
  let ob = r34_bond h_claim h_root k 99999 balance0 seed pk in
  let okOverStakeInvalid = if (r_nth ob 6) == 0 then 1 else 0 in

  -- ===== (6) FALSIFIER: a slash attempt under an UNSIGNED root must be rejected (no authority) =====
  -- sig_ok=0 -> r34_check_fraud returns 0 even on a genuinely inconsistent step.
  let f_fraud_nosig = r34_check_fraud f_fp f_root 0 in
  let okNoSlashUnsigned = if f_fraud_nosig == 0 then 1 else 0 in

  let all = okHonestSpot * okHonestBond * okBudget * okNoFalseSlash * okBalRecovered * okFraudConfirmed * okSlashed * okStakeBurned * okNoSlashHonestStep * okNoFabricatedSlash * okOverStakeInvalid * okNoSlashUnsigned in

  -- ===== persist a machine-readable gate transcript (validate.sh + foreign check read this) =====
  let report = cat [
    "R34_ECONOMIC_STAKE v1\n",
    "pubkey ", pk_hex, "\n",
    "genesis ", genesis, "\n",
    "claim_K ", show k, " spot_k ", show kc, " stake ", show stake, " balance0 ", show balance0, "\n",
    "honest_root ", h_root, "\n",
    "honest_claim_head ", h_claim, "\n",
    "honest_claim_sig ", h_sighex, "\n",
    "honest_spot distinct=", show h_distinct, " pct=", show h_pct, " ok=", show okHonestSpot, "\n",
    "honest_bond head=", hb_head, " sig=", hb_sighex, " sigok=", show hb_sigok, " locked=", show hb_locked, " avail=", show hb_avail, " valid=", show hb_valid, "\n",
    "honest_false_slash fraud=", show h_fraud, " slashed=", show h_slashed, " final_bal=", show h_final_bal, " ok_no_false_slash=", show okNoFalseSlash, " ok_bal_recovered=", show okBalRecovered, "\n",
    "forged_root ", f_root, "\n",
    "forged_claim_head ", f_claim, "\n",
    "forged_poison_at ", show poison_at, "\n",
    "forged_bond locked=", show fb_locked, " avail=", show fb_avail, " valid=", show fb_valid, "\n",
    "fraud_proof opened=", show poison_at, " fraud=", show f_fraud, " slashed=", show f_slashed, " final_bal=", show f_final_bal, "\n",
    "fraud_confirmed ok=", show okFraudConfirmed, " slashed ok=", show okSlashed, " stake_burned ok=", show okStakeBurned, "\n",
    "falsify_no_slash_honest_step opened=100 fraud=", show f_fraud_honest, " ok=", show okNoSlashHonestStep, "\n",
    "falsify_no_fabricated_slash fraud=", show f_fraud_fab, " ok=", show okNoFabricatedSlash, "\n",
    "falsify_over_stake_invalid ok=", show okOverStakeInvalid, "\n",
    "falsify_no_slash_unsigned ok=", show okNoSlashUnsigned, "\n",
    "ALL ", show all, "\n"] in
  let _ = write_file "rungs/r34/out/r34_gate.txt" report in

  -- emit a compact fraud-proof transcript the foreign checker re-verifies independently:
  -- the forged chain's signed root + the single opened step (pre,post,paths) for step poison_at.
  let f_sighex = r_nth fp 6 in
  let fp_pre = r_nth f_fp 1 in
  let fp_post = r_nth f_fp 2 in
  let h_fp_pre = r_nth h_fp 1 in
  let h_fp_post = r_nth h_fp 2 in
  let fproof = cat [
    "R34_FRAUDPROOF v1\n",
    "pubkey ", pk_hex, "\n",
    "genesis ", genesis, "\n",
    "K ", show k, "\n",
    "forged_tag forged\n",
    "forged_root ", f_root, "\n",
    "forged_claim_head ", f_claim, "\n",
    "forged_claim_sig ", f_sighex, "\n",
    "poison_at ", show poison_at, "\n",
    "open_idx ", show poison_at, "\n",
    "open_pre ", r30_state_ser fp_pre, "\n",
    "open_post ", r30_state_ser fp_post, "\n",
    "honest_tag honest\n",
    "honest_root ", h_root, "\n",
    "honest_claim_head ", h_claim, "\n",
    "honest_open_idx 257\n",
    "honest_open_pre ", r30_state_ser h_fp_pre, "\n",
    "honest_open_post ", r30_state_ser h_fp_post, "\n",
    "stake ", show stake, "\n",
    "balance0 ", show balance0, "\n"] in
  let _ = write_file "rungs/r34/out/r34_fraudproof.txt" fproof in

  let _ = print "================ RUNG 34: ECONOMIC STAKE over the SUCCINCT LENGTH-PROOF ================" in
  let _ = print (cat ["pubkey                          = ", pk_hex]) in
  let _ = print (cat ["claimed length K                = ", show k, "  (rung-30 length-proof; spot-check k=", show kc, ", ", show h_pct, "% of K < 25%)"]) in
  let _ = print (cat ["HONEST length-proof verifies     = ", show okHonestSpot, "  (succinct spot-check over the K-step Merkle DAG)"]) in
  let _ = print (cat ["HONEST bond valid + signed       = ", show okHonestBond, "  (stake ", show stake, " <= balance ", show balance0, ", locked)"]) in
  let _ = print (cat ["false-slash REJECTED (honest)    = ", show okNoFalseSlash, "  (an opened honest step recomputes consistently -> no slash)"]) in
  let _ = print (cat ["honest bond fully released       = ", show okBalRecovered, "  (final balance == ", show balance0, ")"]) in
  let _ = print "------ fraud path ------" in
  let _ = print (cat ["FRAUD-PROOF confirmed (1 step)   = ", show okFraudConfirmed, "  (opened step ", show poison_at, " is an inconsistent transition, O(log N) checkable)"]) in
  let _ = print (cat ["bond SLASHED on fraud            = ", show okSlashed, "  (stake forfeited)"]) in
  let _ = print (cat ["stake burned (balance debited)   = ", show okStakeBurned, "  (final balance == ", show (balance0 - stake), ")"]) in
  let _ = print "------ slasher soundness (false-slash resistance) ------" in
  let _ = print (cat ["no-slash on honest step of forged chain = ", show okNoSlashHonestStep, "  (opening a consistent step != fraud)"]) in
  let _ = print (cat ["no-slash on fabricated evidence         = ", show okNoFabricatedSlash, "  (tampered post-state not in the signed Merkle tree)"]) in
  let _ = print (cat ["over-stake bond rejected                = ", show okOverStakeInvalid, "  (cannot stake credits you do not hold)"]) in
  let _ = print (cat ["no-slash under unsigned root            = ", show okNoSlashUnsigned, "  (slash requires a signed commitment)"]) in
  let _ = print (cat ["gate transcript: rungs/r34/out/r34_gate.txt ; fraud-proof: rungs/r34/out/r34_fraudproof.txt"]) in
  let _ = print (if all == 1
    then "PASS: a served utterance's training claim (K steps, rung-30 length-proof) is bonded into a slashable stake; a single-step fraud-proof is accepted by an independent O(log N) checker and slashes the bond; an honest chain's bond is never slashable. Foreign re-derivation in r34_foreign_check.py."
    else "FAIL") in
  if all == 1 then 0 else 1
