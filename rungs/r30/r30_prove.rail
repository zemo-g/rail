-- =====================================================================================
-- RUNG 30 -- BINDING THE SUCCINCT SPOT-CHECK TO THE REAL lm10 TRANSFORMER STEP.
-- =====================================================================================
-- r30_protocol.rail proved the Fiat-Shamir spot-check protocol (per-step FULL-state commitment,
-- streamed Merkle DAG, head-derived challenges, k-step recompute, sublinearity, falsifiers) on a
-- real-but-LIGHT scalar transition r30_step. THIS file wires the SAME protocol onto the actual
-- lm10 transformer step (lm4_step) -- the proven trainer from attested_utterance.rail / lm10.
--
-- *** COMPUTE DISCIPLINE: this is a DOCUMENTED SKELETON, not run by validate.sh. ***
-- Running it does the full lm10 training (8GB arena, multi-minute), which the shared compiler/GPU
-- budget forbids during the build phase. The protocol it invokes is the EXACT same one validate.sh
-- exercises (r30_protocol.rail) -- only the per-step transition is swapped from r30_step to lm4_step.
-- To actually run it (serially, alone): RAIL_ARENA_MB=8192 ./out/r30_prove_bin  (see footer).
--
-- WHAT CHANGES vs r30_protocol.rail (the 4 substitutions):
--   (1) STATE per step is the FULL lm10 weight bundle `wp` (17 cells x [theta,m,v]) PLUS pow1,pow2
--       PLUS the (ctx,tgt) pair index -- exactly the rung-21 gap the ladder names (epoch-only never
--       covered Adam m,v or the powers). Serialization REUSES the proven bnd_wp_ser / bnd_wp_deser.
--   (2) The per-step transition is the proven lm4_step (1 (ctx,tgt) pair -> new wp + powers). The
--       prover commits post-step states; the per-EPOCH chain (lm4_chain_d0_pw) is the coarse view,
--       this is the fine (per-pair) view the spot-check needs.
--   (3) The leaf preimage = SHA256("LEAF|" gstep "|" ctxidx "|" tgt "|" bnd_wp_ser(wp) "|" pow1 "|" pow2).
--       The (ctx,tgt) MUST be bound (rung-24 SPLIT commitment) so the spot-check verifies each step
--       used a REAL training pair, not an internally-consistent-but-wrong-corpus trajectory.
--   (4) The verifier recomputes lm4_step(pre_wp, pair) and checks bnd_wp_ser equality + Merkle path.
--
-- Everything else -- r30_levels / r30_proof / r30_verify_path / r30_chal / r30_chal_list (Fiat-Shamir
-- off the signed chain head) / arena_reset-per-segment streaming -- is REUSED VERBATIM from
-- r30_protocol.rail's design. (Here we re-declare the lm10-typed wrappers; the Merkle + FS + Ed25519
-- helpers are identical and would be imported/shared in a merged build.)

-- the proven lm10 transformer + optimizer + serialization (lm4_step, lm4_epoch, bnd_wp_ser/deser,
-- lm4_chain_d0_pw, lm4_canon17, lm4_pairs, lm4_vocab, lm4_tokens, init helpers) live here.
-- NOTE: import ONLY the lib (lm10_attested_train.rail MINUS its heavy ~180-line main). It brings
-- bx_fixed + sha256/sha512 + x25519 + ed25519{,_scalar,_sign} + tensor TRANSITIVELY -- importing
-- those directly too double-defined tensor.rail (check_g/gradient_test_main) -> duplicate-symbol at
-- link, since Rail does not dedup a direct import against the same file reached transitively.
import "tools/bitexact/lm10_lib.rail"

-- ===== reused protocol helpers (identical to r30_protocol.rail) =====
r_nth xs i = if i <= 0 then head xs else r_nth (tail xs) (i - 1)
r_len xs = if xs == [] then 0 else 1 + r_len (tail xs)
r_hexval c =
  let n = char_to_int c in
  if n >= 48 then (if n <= 57 then n - 48 else (if n >= 97 then n - 87 else (if n >= 65 then n - 55 else 0))) else 0
r_hex_take cs k acc = if k <= 0 then acc else if cs == [] then acc
  else r_hex_take (tail cs) (k - 1) (acc * 16 + (r_hexval (head cs)))
r_head48 s = r_hex_take (chars s) 12 0
r_mem x xs = if xs == [] then 0 else if (head xs) == x then 1 else r_mem x (tail xs)

-- Merkle (verbatim from r30_protocol.rail)
p_pair_up nodes acc = if nodes == [] then reverse acc
  else if (tail nodes) == [] then reverse (cons (sha256_hex (cat ["NODE|", head nodes, "|", head nodes])) acc)
  else p_pair_up (tail (tail nodes)) (cons (sha256_hex (cat ["NODE|", head nodes, "|", head (tail nodes)])) acc)
p_levels_go nodes acc = if (tail nodes) == [] then reverse (cons nodes acc) else p_levels_go (p_pair_up nodes []) (cons nodes acc)
p_levels nodes = if nodes == [] then cons (cons (sha256_hex "EMPTY") []) [] else p_levels_go nodes []
p_levels_root levels = head (r_nth levels (r_len levels - 1))
p_proof_lv levels lvl idx acc =
  if lvl >= (r_len levels - 1) then reverse acc
  else let nodes = r_nth levels lvl in
       let isright = idx - (idx / 2) * 2 in
       let sib_i = if isright == 1 then idx - 1 else idx + 1 in
       let nlen = r_len nodes in
       let sib = if sib_i >= nlen then (r_nth nodes idx) else (r_nth nodes sib_i) in
       let side = if isright == 1 then 0 else 1 in
       p_proof_lv levels (lvl + 1) (idx / 2) (cons (cons sib (cons side [])) acc)
p_proof levels idx = p_proof_lv levels 0 idx []
p_path_fold leaf path = if path == [] then leaf
  else let el = head path in let sib = r_nth el 0 in let side = r_nth el 1 in
       let parent = if side == 0 then sha256_hex (cat ["NODE|", sib, "|", leaf]) else sha256_hex (cat ["NODE|", leaf, "|", sib]) in
       p_path_fold parent (tail path)
p_verify_path leaf path root = if (p_path_fold leaf path) == root then 1 else 0

-- Fiat-Shamir challenge derivation (verbatim)
p_chal root chain_head j n =
  let h = sha256_hex (cat [root, "|", chain_head, "|CHAL|", show j]) in
  (r_head48 h) - ((r_head48 h) / n) * n
p_chal_list root chain_head k n j acc = if j >= k then reverse acc
  else p_chal_list root chain_head k n (j + 1) (cons (p_chal root chain_head j n) acc)

-- =====================================================================================
-- (1)+(3) lm10 PER-STEP COMMITMENT: the leaf binds the full wp + powers + the (ctx,tgt) pair.
-- bnd_wp_ser is the PROVEN bit-exact serializer of the 17-cell [theta,m,v] bundle (round-trips via
-- bnd_wp_deser). The pair's ctx is committed as its TOKEN-ID LIST joined; tgt as its id.
-- =====================================================================================
r30lm_ctx_ser ctx = if ctx == [] then "" else cat [show (head ctx), ".", r30lm_ctx_ser (tail ctx)]
r30lm_leaf gstep pair wp pow1 pow2 =
  let (ctx, tgt) = pair in
  sha256_hex (cat ["LEAF|", show gstep, "|", r30lm_ctx_ser ctx, "|", show tgt, "|",
                   bnd_wp_ser wp, "|", show pow1, "|", show pow2])

-- (2) ONE lm10 step = lm4_step over one (ctx,tgt) pair. Returns [wp', pow1', pow2'] split out of
-- lm4_step's 19-element result (first 17 = wp via lm4_first17, idx 17/18 = powers).
r30lm_step ct st wp pair d hidden v indim isd beta1 beta2 lr eps pow1 pow2 =
  let e = lm4_step ct st wp pair d hidden v indim isd beta1 beta2 lr eps pow1 pow2 in
  cons (lm4_first17 e) (cons (lm4_nth e 17) (cons (lm4_nth e 18) []))

-- PROVER: stream over (epoch x pairs) = the global step index; commit each post-step state as a leaf,
-- per-segment arena_reset to bound memory (the ladder's "Merkle DAG streamed with arena_reset").
-- The post-states are persisted to disk (bnd_wp_ser) so the verifier reads pre/post for any
-- challenged step without holding the whole trajectory in the arena. STREAMING (the skeleton's
-- stated intent, now real): per-step arena_reset bounds memory -- without it the conservative GC
-- pins each lm4_step's transient and the arena fills ~step 260 (551-step run STALLS). After the
-- reset, wp AND the powers are RELOADED FROM DISK (never relying on a value surviving the reset);
-- allpairs is allocated before the first mark, so its structural tail-sharing survives every reset.
-- Each leaf is persisted (.leaf) and read back post-stream; returns the final gstep (== nsteps).
r30lm_stream ct st wp pairs d hidden v indim isd beta1 beta2 lr eps pow1 pow2 gstep =
  if pairs == [] then gstep
  else
    let mk = arena_mark 0 in
    let nxt = r30lm_step ct st wp (head pairs) d hidden v indim isd beta1 beta2 lr eps pow1 pow2 in
    let nwp = r_nth nxt 0 in
    let np1 = r_nth nxt 1 in
    let np2 = r_nth nxt 2 in
    let _ = write_file (cat ["rungs/r30/out/lm_states/", show gstep, ".wp"]) (bnd_wp_ser nwp) in
    let _ = write_file (cat ["rungs/r30/out/lm_states/", show gstep, ".pw"]) (cat [show np1, " ", show np2]) in
    let _ = write_file (cat ["rungs/r30/out/lm_states/", show gstep, ".leaf"]) (r30lm_leaf gstep (head pairs) nwp np1 np2) in
    let _ = arena_reset mk in
    let wp2 = bnd_wp_deser (read_file (cat ["rungs/r30/out/lm_states/", show gstep, ".wp"])) in
    let pw = read_file (cat ["rungs/r30/out/lm_states/", show gstep, ".pw"]) in
    let p1 = lm4_hd_int pw in
    let p2 = lm4_hd_int (str_sub pw ((str_find " " pw) + 1) 64) in
    r30lm_stream ct st wp2 (tail pairs) d hidden v indim isd beta1 beta2 lr eps p1 p2 (gstep + 1)
-- read the persisted leaves [0..n) back into a list (post-stream, clean arena)
r30lm_readleaves i n = if i >= n then [] else cons (read_file (cat ["rungs/r30/out/lm_states/", show i, ".leaf"])) (r30lm_readleaves (i + 1) n)

-- VERIFIER: for a challenged global step `idx`, read pre (post-state idx-1, or wp0 if idx==0) from
-- disk, read the (ctx,tgt) pair from the corpus (rung-24 binding), recompute lm4_step, compare
-- bnd_wp_ser, and verify the Merkle path. O(1) disk reads per challenge -> sublinear in step count.
r30lm_verify_one ct st wp0 corpuspairs levels root idx d hidden v indim isd beta1 beta2 lr eps =
  let pre = if idx == 0 then wp0 else bnd_wp_deser (read_file (cat ["rungs/r30/out/lm_states/", show (idx - 1), ".wp"])) in
  let prepw = if idx == 0 then cons 16777216 (cons 16777216 [])
              else let s = read_file (cat ["rungs/r30/out/lm_states/", show (idx - 1), ".pw"]) in
                   cons (lm4_hd_int s) (cons (lm4_hd_int (str_sub s ((str_find " " s) + 1) 64)) []) in
  let pair = r_nth corpuspairs idx in
  let nxt = r30lm_step ct st pre pair d hidden v indim isd beta1 beta2 lr eps (r_nth prepw 0) (r_nth prepw 1) in
  let rec_wp = r_nth nxt 0 in
  let rec_p1 = r_nth nxt 1 in
  let rec_p2 = r_nth nxt 2 in
  let comm_wp = bnd_wp_deser (read_file (cat ["rungs/r30/out/lm_states/", show idx, ".wp"])) in
  let step_ok = if (bnd_wp_ser rec_wp) == (bnd_wp_ser comm_wp) then 1 else 0 in
  let leaf = r30lm_leaf idx pair rec_wp rec_p1 rec_p2 in
  let merkle_ok = p_verify_path leaf (p_proof levels idx) root in
  step_ok * merkle_ok

-- expand the per-epoch `pairs` into the full (epochs x pairs) step list, so r_nth allpairs idx
-- gives the exact pair the prover used at global step idx (epoch-outer, pair-inner order, matching
-- lm4_chain). Concat n copies in order.
r30lm_concat a b = if a == [] then b else cons (head a) (r30lm_concat (tail a) b)
r30lm_expand p0 n acc = if n <= 0 then acc else r30lm_expand p0 (n - 1) (r30lm_concat p0 acc)

-- verify a list of challenged global steps; product of per-step verdicts (1 iff ALL pass).
r30lm_verify_list ct st wp0 allpairs levels root chals d hidden v indim isd b1 b2 lr eps =
  if chals == [] then 1
  else let ok = r30lm_verify_one ct st wp0 allpairs levels root (head chals) d hidden v indim isd b1 b2 lr eps in
       ok * (r30lm_verify_list ct st wp0 allpairs levels root (tail chals) d hidden v indim isd b1 b2 lr eps)

-- The REAL main: mirrors attested_utterance.rail's lm10 setup (same d/hidden/cwin/betas/lr/eps/isd,
-- same corpus + wp0 init), runs the per-step prover over the REAL lm4_step (not the r30_step
-- stand-in), Merkle-commits every post-step state, signs the root with a LOCAL/DEV key, derives
-- Fiat-Shamir challenges off the signed head, and spot-checks ONLY k steps -- sublinear. A poisoned
-- committed state is rejected. epochs is REDUCED (the spot-check is scale-free; binding to the actual
-- transformer is the claim) -- raise to 19 for the full run.
main =
  let _ = shell "mkdir -p rungs/r30/out/lm_states" in
  let _ = shell "rm -f rungs/r30/out/lm_states/*.wp rungs/r30/out/lm_states/*.pw rungs/r30/out/lm_states/*.bak rungs/r30/out/lm_states/*.leaf" in
  let d = 8 in
  let hidden = 64 in
  let cwin = 8 in
  let epochs = 19 in
  let beta1 = 15099494 in
  let beta2 = 16760439 in
  let lr = 209715 in
  let eps = 16777 in
  let sc = arr_new 1 0 in
  let _ = arr_set sc 0 16777216 in
  let s = arr_get sc 0 in
  let isdc = arr_new 1 0 in
  let _ = arr_set isdc 0 5931642 in
  let isd = arr_get isdc 0 in
  let ct = arr_new 32 0 in
  let _ = rt_set_cos ct in
  let st = arr_new 32 0 in
  let _ = rt_set_sin st in
  let corpus = read_file "tools/bitexact/lm10_corpus.txt" in
  let chash = sha256_hex corpus in
  let vocab = lm4_vocab corpus in
  let vsize = lm4_len (chars vocab) in
  let ids = lm4_tokens corpus vocab in
  let pairs = lm4_pairs ids cwin in
  let npairs = lm4_len pairs in
  let indim = cwin * d in
  let w1c0 = lm4_initmat 0 hidden indim 0 in
  let w2c0 = lm4_initmat 1 vsize hidden 0 in
  let ec0 = lm4_emb_initmat vsize d in
  let ff = d * 4 in
  let wqc0 = lm5_qkv_init 30 d in
  let wkc0 = lm5_qkv_init 31 d in
  let wvc0 = lm5_qkv_init 32 d in
  let gammac0 = rn_gamma_init d in
  let gamma2c0 = rn_gamma_init d in
  let wff1c0 = lm4_initmat 33 ff d 0 in
  let wff2c0 = lm4_initmat 34 d ff 0 in
  let b1wqc0 = lm5_qkv_init 35 d in
  let b1wkc0 = lm5_qkv_init 36 d in
  let b1wvc0 = lm5_qkv_init 37 d in
  let b1gammac0 = rn_gamma_init d in
  let b1gamma2c0 = rn_gamma_init d in
  let b1wff1c0 = lm4_initmat 38 ff d 0 in
  let b1wff2c0 = lm4_initmat 39 d ff 0 in
  let wp0 = cons w1c0 (cons w2c0 (cons ec0 (cons wqc0 (cons wkc0 (cons wvc0 (cons gammac0 (cons gamma2c0 (cons wff1c0 (cons wff2c0 (cons b1wqc0 (cons b1wkc0 (cons b1wvc0 (cons b1gammac0 (cons b1gamma2c0 (cons b1wff1c0 (cons b1wff2c0 [])))))))))))))))) in
  let seed = sha256 "r30lm.local.ephemeral.dev.seed.v1" in
  let pk = ed25519_pk_from_sk seed in
  let pk_hex = bytes_to_hex pk 32 in
  let genesis_hex = sha256_hex "R30LM.LOCAL.SPOTCHECK.GENESIS.dev" in
  -- expand to the full step list + run the per-step prover (binds to the REAL lm4_step)
  let allpairs = r30lm_expand pairs epochs [] in
  let nsteps = lm4_len allpairs in
  let _ = print (cat ["r30_prove: REAL lm10 per-step prover -- steps=", show nsteps,
                      " (epochs=", show epochs, " x pairs=", show npairs, "), vsize=", show vsize]) in
  let _ = r30lm_stream ct st wp0 allpairs d hidden vsize indim isd beta1 beta2 lr eps 16777216 16777216 0 in
  let leaves = r30lm_readleaves 0 nsteps in
  let nleaves = lm4_len leaves in
  let _ = print (cat ["prover done: ", show nleaves, " committed per-step states (memory-bounded stream)"]) in
  -- Merkle commit over the per-step leaves
  let levels = p_levels leaves in
  let root = p_levels_root levels in
  -- sign the root with the LOCAL/DEV key -> the chain head FS challenges hang off
  let head_pre = cat [genesis_hex, "|R30LM|root=", root, "|steps=", show nsteps, "|corpus=", chash] in
  let head_b = sha256 head_pre in
  let chain_head = bytes_to_hex head_b 32 in
  let hsig = ed25519_sign seed head_b 32 in
  let hsig_hex = bytes_to_hex hsig 64 in
  let sigOk = ed25519_verify pk head_b 32 hsig in
  -- Fiat-Shamir: k challenges derived off (root, signed head)
  let k = if nsteps < 12 then nsteps else 12 in
  let chals = p_chal_list root chain_head k nsteps 0 [] in
  -- honest spot-check: recompute ONLY the k challenged steps; all must verify
  let honestOk = r30lm_verify_list ct st wp0 allpairs levels root chals d hidden vsize indim isd beta1 beta2 lr eps in
  -- sublinearity: verification recomputes k << nsteps steps
  let okSub = if k < nsteps then 1 else 0 in
  -- FALSIFIER: poison one committed state; a challenge hitting it MUST be rejected.
  let fidx = head chals in
  let other = if fidx == 0 then 1 else fidx - 1 in
  let honestF = r30lm_verify_one ct st wp0 allpairs levels root fidx d hidden vsize indim isd beta1 beta2 lr eps in
  let _ = shell (cat ["cp rungs/r30/out/lm_states/", show fidx, ".wp rungs/r30/out/lm_states/", show fidx, ".bak"]) in
  let _ = shell (cat ["cp rungs/r30/out/lm_states/", show other, ".wp rungs/r30/out/lm_states/", show fidx, ".wp"]) in
  let poisonV = r30lm_verify_one ct st wp0 allpairs levels root fidx d hidden vsize indim isd beta1 beta2 lr eps in
  let _ = shell (cat ["cp rungs/r30/out/lm_states/", show fidx, ".bak rungs/r30/out/lm_states/", show fidx, ".wp"]) in
  let okFalsify = if honestF == 1 then (if poisonV == 0 then 1 else 0) else 0 in
  -- emit the signed succinct-proof transcript for the foreign verifier
  let chal_str = r30lm_ctx_ser chals in
  let transcript = cat ["# R30LM-PROVE v1\npk=", pk_hex, "\ngenesis=", genesis_hex,
                        "\ncorpus_sha=", chash, "\nd=", show d, " hidden=", show hidden,
                        " cwin=", show cwin, " epochs=", show epochs, " vsize=", show vsize,
                        "\nnsteps=", show nsteps, "\nroot=", root, "\nchain_head=", chain_head,
                        "\nhead_sig=", hsig_hex, "\nk=", show k, "\nchallenges=", chal_str, "\n"] in
  let _ = write_file "rungs/r30/out/r30_prove_transcript.txt" transcript in
  -- gate
  let ALL = sigOk * honestOk * okSub * okFalsify in
  let _ = print (cat ["sigOk=", show sigOk, " honestSpotCheck(k=", show k, ")=", show honestOk,
                      " sublinear(k<nsteps)=", show okSub, " falsifier(poison rejected)=", show okFalsify]) in
  let _ = print (cat ["root=", root]) in
  let _ = print (cat ["chain_head=", chain_head]) in
  let _ = if ALL == 1 then print "PASS: succinct spot-check BOUND TO THE REAL lm10 step -- k challenged steps recomputed against the signed Merkle root, sublinear, poisoned state rejected."
          else print "FAIL: r30 lm10-bound gate red (see flags above)" in
  0

-- Full run (serially, alone -- raise epochs to 19, heavier):
--   ./rail_native --out-prefix rungs/r30/out/r30_prove_bin rungs/r30/r30_prove.rail
--   RAIL_ARENA_MB=8192 ./rungs/r30/out/r30_prove_bin
-- Then r30_foreign_check.py (extended to bnd_wp deserialize) cross-verifies the transcript.
