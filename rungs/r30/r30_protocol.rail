-- =====================================================================================
-- RUNG 30 -- Succinct Spot-Check of Training (Fiat-Shamir transcript)  ::  PROTOCOL CORE
-- =====================================================================================
-- Proves: a verifier confirms an entire training TRAJECTORY by recomputing only k randomly
-- challenged STEPS, in time SUBLINEAR in step count, with a stated soundness bound -- instead
-- of re-running every step (which is what every witness does today, so verification == training).
--
-- This file is the SOUND, FAST, FALSIFIABLE protocol core. It runs the IDENTICAL machinery that
-- the full lm10 prover (r30_prove.rail) runs -- per-step FULL-state commitment, a streamed Merkle
-- DAG over the step-states, Fiat-Shamir challenge derivation by HASHING THE CHAIN HEAD (forced:
-- Rail's PRNG overflows int63, so the prover cannot be trusted to pick), k challenged-step
-- recomputation, Merkle-path verification, and the sublinearity + falsification gates -- but over
-- a real-but-LIGHT per-step transition r30_step so the gate validates in seconds, not on an 8GB
-- lm10 training run. r30_prove.rail wires the EXACT lm4_step into these same commit/challenge/verify
-- functions (see IMPL.md "Binding to the real lm10 step").
--
-- The transition r30_step is a genuine exact-integer stateful update with the SAME structure that
-- makes the lm10 falsifier bite: an Adam-style moment pair (m,v) that CHAINS step-to-step (state i
-- depends on i-1) plus bias powers (pow1,pow2) that chain, plus a per-step (ctx,tgt) training-pair
-- index bound into the commitment, plus a gradient-clip whose removal changes the trajectory. A
-- prover who tampers an interior step (a v-moment, or disables clipping) produces a chain whose
-- challenged steps fail recomputation -- caught w.h.p. across head-derived seeds.
--
-- Build: ./rail_native --out-prefix rungs/r30/out/r30 rungs/r30/r30_protocol.rail
-- Run:   RAIL_ARENA_MB=2048 ./rungs/r30/out/r30      (writes rungs/r30/out/*.txt)
-- =====================================================================================

import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"

-- ===== small list utilities (mirror lm10's lm4_* so binding is trivial) =====
r_nth xs i = if i <= 0 then head xs else r_nth (tail xs) (i - 1)
r_len xs = if xs == [] then 0 else 1 + r_len (tail xs)
r_snoc xs v = if xs == [] then cons v [] else cons (head xs) (r_snoc (tail xs) v)
r_take n xs = if n <= 0 then [] else if xs == [] then [] else cons (head xs) (r_take (n - 1) (tail xs))
-- parse a small non-negative int from a string (read_file round-trip; to_int is float-only)
r30_digit c = str_find c "0123456789"
r30_hd_go cs acc = if cs == [] then acc else let d = r30_digit (head cs) in if d < 0 then acc else r30_hd_go (tail cs) (acc * 10 + d)
r30_hd_int s = r30_hd_go (chars s) 0

-- ===== hex-string -> small int (Fiat-Shamir reads bytes from the chain-head hex) =====
-- NO PRNG: the challenge is a deterministic function of the signed chain head, so neither prover
-- nor verifier can choose it. Reads the first 12 hex nibbles -> a 48-bit value (fits int63, no
-- multiplicative overflow because we accumulate in a 16-base Horner with bounded width).
r_hexval c =
  let n = char_to_int c in
  if n >= 48 then (if n <= 57 then n - 48 else (if n >= 97 then n - 87 else (if n >= 65 then n - 55 else 0))) else 0
r_hex_take cs k acc = if k <= 0 then acc else if cs == [] then acc
  else r_hex_take (tail cs) (k - 1) (acc * 16 + (r_hexval (head cs)))
-- a 48-bit unsigned value from a hex string (12 nibbles); stays well under int63
r_head48 s = r_hex_take (chars s) 12 0

-- =====================================================================================
-- THE PER-STEP TRANSITION (real, exact-integer, chained -- structurally == lm10 lm4_step)
-- =====================================================================================
-- state = [ theta, m, v, pow1, pow2 ]  (a single Q.24 fixed-point Adam cell + bias powers)
-- The per-step training pair is (ctx, tgt); the "gradient" is a deterministic exact-int function
-- of (theta, ctx, tgt) so the trajectory is reproducible bit-for-bit. CLIP bounds |g| <= GCLIP;
-- removing the clip changes the chain (the falsifier). This is the SAME shape the lm10 optimizer
-- uses: m,v EMA + bias-corrected step, just on one scalar cell instead of 17 matrices.
r30_S = 16777216
r30_b1 = 15099494
r30_b2 = 16760439
r30_lr = 209715
r30_eps = 16777
-- GCLIP must be BELOW the largest honest gradient so clipping is load-bearing (else clip_on==clip_off
-- and the clip-disable falsifier cannot bite). Measured max |grad| over a run = 2^20 (1048576);
-- 2^19 (524288) clips the largest steps -> a clip-OFF chain diverges from a clip-ON recompute.
r30_gclip = 524288

-- exact-int |x|
r_abs x = if x < 0 then (0 - x) else x
-- gradient: deterministic, exact-int, depends on the step's (theta, ctx, tgt)
r_grad theta ctx tgt = ((theta / 2048) + (ctx - tgt) * 65536) - (theta * 3) / 1024
-- clip (the toggle: clip_on=1 clamps to +-GCLIP, clip_on=0 leaves raw -> different trajectory)
r_clip g clip_on =
  if clip_on == 0 then g
  else if g > r30_gclip then r30_gclip else if g < (0 - r30_gclip) then (0 - r30_gclip) else g
-- isqrt for the Adam denominator (exact-int Newton, mirrors lm10's fixed-point sqrt usage).
-- MUTUAL RECURSION (go/step pair): the Newton update (g+x/g)/2 is a cross-dependent self-loop arg
-- (depends on BOTH x and g) which the self-loop arg scheduler MISCOMPILES (returns the initial guess
-- x+1 unchanged -- empirically confirmed). Splitting into go/step computes ng in a `let` first, so the
-- recursive call sees a single already-evaluated arg. See CLAUDE.md "self-loop cross-dep args".
r_isqrt_go x g i = if i <= 0 then g else if g == 0 then 0 else r_isqrt_step x g i
r_isqrt_step x g i = let ng = (g + x / g) / 2 in r_isqrt_go x ng (i - 1)
r_isqrt x = if x <= 0 then 0 else r_isqrt_go x (x + 1) 24

-- one step: consume (ctx,tgt), update [theta,m,v,pow1,pow2] exactly. clip_on selects honest/forged.
r30_step state ctx tgt clip_on =
  let theta = r_nth state 0 in
  let m = r_nth state 1 in
  let v = r_nth state 2 in
  let pow1 = r_nth state 3 in
  let pow2 = r_nth state 4 in
  let g = r_clip (r_grad theta ctx tgt) clip_on in
  let nm = (m * r30_b1 + g * (r30_S - r30_b1)) / r30_S in
  let nv = (v * r30_b2 + ((g * g) / r30_S) * (r30_S - r30_b2)) / r30_S in
  let np1 = (pow1 * r30_b1) / r30_S in
  let np2 = (pow2 * r30_b2) / r30_S in
  let bc1 = r30_S - np1 in
  let bc2 = r30_S - np2 in
  let mhat = (nm * r30_S) / bc1 in
  let vhat = (nv * r30_S) / bc2 in
  let denom = (r_isqrt (vhat * r30_S)) + r30_eps in
  let upd = (r30_lr * mhat) / denom in
  let nth = theta - upd in
  cons nth (cons nm (cons nv (cons np1 (cons np2 []))))

-- canonical serialization of a state (the leaf preimage; verifier reproduces it byte-for-byte)
r30_state_ser st = cat [show (r_nth st 0), ",", show (r_nth st 1), ",", show (r_nth st 2), ",",
                        show (r_nth st 3), ",", show (r_nth st 4)]

-- =====================================================================================
-- MERKLE DAG over the per-step states (streamed; one leaf per committed step-state)
-- =====================================================================================
-- Leaf i commits the FULL post-step state AND its (ctx,tgt) training-pair index (rung-24 binding):
--   leaf_i = SHA256( "LEAF|" i "|" ctx "|" tgt "|" state_ser )
-- This closes the rung-21 gap (epoch-only commitment never covered m,v or the powers).
r30_leaf i ctx tgt st =
  sha256_hex (cat ["LEAF|", show i, "|", show ctx, "|", show tgt, "|", r30_state_ser st])

-- A binary Merkle tree over a list of leaf-hex values. Internal node = SHA256("NODE|"L"|"R).
-- One pairing pass collapses a level. Odd tail carries up (duplicate-free promote).
r30_pair_up nodes acc = if nodes == [] then reverse acc
  else if (tail nodes) == [] then reverse (cons (head nodes) acc)
  else r30_pair_up (tail (tail nodes))
       (cons (sha256_hex (cat ["NODE|", head nodes, "|", head (tail nodes)])) acc)
r30_merkle_root nodes = if nodes == [] then sha256_hex "EMPTY"
  else if (tail nodes) == [] then head nodes
  else r30_merkle_root (r30_pair_up nodes [])

-- PRECOMPUTED LEVELS: build the tree ONCE as a list of levels [leaves, level1, ..., [root]].
-- This is the streamed-Merkle cache the ladder asks for: O(N) to build, then each proof is O(log N)
-- (walk the cached levels), instead of rebuilding the tree per proof (the O(N^2) trap).
r30_levels_go nodes acc =
  if (tail nodes) == [] then reverse (cons nodes acc)
  else r30_levels_go (r30_pair_up nodes []) (cons nodes acc)
r30_levels nodes = if nodes == [] then cons (cons (sha256_hex "EMPTY") []) [] else r30_levels_go nodes []
r30_levels_root levels = head (r_nth levels (r_len levels - 1))

-- Merkle PROOF for leaf at index `idx` from cached levels. Each element = [sibling_hex, side]
-- (side=0 sibling LEFT, side=1 sibling RIGHT). Walk levels bottom (0) up to just below the root.
r30_proof_lv levels lvl idx acc =
  if lvl >= (r_len levels - 1) then reverse acc
  else let nodes = r_nth levels lvl in
       let isright = idx - (idx / 2) * 2 in
       let sib_i = if isright == 1 then idx - 1 else idx + 1 in
       let nlen = r_len nodes in
       let sib = if sib_i >= nlen then (r_nth nodes idx) else (r_nth nodes sib_i) in
       let side = if isright == 1 then 0 else 1 in
       r30_proof_lv levels (lvl + 1) (idx / 2) (cons (cons sib (cons side [])) acc)
r30_proof levels idx = r30_proof_lv levels 0 idx []

-- VERIFY a Merkle proof: fold the leaf up through the siblings, must equal root.
r30_path_fold leaf path = if path == [] then leaf
  else let el = head path in
       let sib = r_nth el 0 in
       let side = r_nth el 1 in
       let parent = if side == 0
         then sha256_hex (cat ["NODE|", sib, "|", leaf])    -- sibling on LEFT
         else sha256_hex (cat ["NODE|", leaf, "|", sib]) in -- sibling on RIGHT
       r30_path_fold parent (tail path)
r30_verify_path leaf path root = if (r30_path_fold leaf path) == root then 1 else 0

-- =====================================================================================
-- THE PROVER: run N steps, commit per-step state, build the Merkle DAG, chain+sign the root.
-- =====================================================================================
-- training pairs: a deterministic schedule (ctx_i, tgt_i). Real here; in r30_prove.rail these are
-- the actual lm10 (ctx,tgt) pairs replayed across epochs.
r30_ctx i = (i * 7 + 3) - ((i * 7 + 3) / 17) * 17
r30_tgt i = (i * 13 + 5) - ((i * 13 + 5) / 17) * 17

-- run the chain, accumulating the list of leaf hexes (reversed) and returning final state too.
-- clip_on: 1 = honest; we also let the prover poison ONE step (poison_at) for the falsifier.
r30_run state i n clip_on poison_at leaves =
  if i >= n then cons state (cons (reverse leaves) [])
  else let ctx = r30_ctx i in
       let tgt = r30_tgt i in
       -- honest transition; if this is the poisoned step, corrupt the committed v-moment AFTER
       -- the true step (so the COMMITTED post-state is inconsistent with r30_step(pre)).
       let truepost = r30_step state ctx tgt clip_on in
       let committed = if i == poison_at
         then cons (r_nth truepost 0) (cons (r_nth truepost 1)
              (cons ((r_nth truepost 2) + 1) (cons (r_nth truepost 3) (cons (r_nth truepost 4) []))))
         else truepost in
       let leaf = r30_leaf i ctx tgt committed in
       -- the NEXT pre-state is the committed (forged) state -> the forged chain is internally
       -- "consistent" only at the tampered leaf; recomputing step poison_at from its pre-state
       -- yields truepost != committed -> caught.
       r30_run committed (i + 1) n clip_on poison_at (cons leaf leaves)

-- =====================================================================================
-- FIAT-SHAMIR CHALLENGE DERIVATION: k indices from the chain head (no PRNG).
-- =====================================================================================
-- challenge_j = H( root_hex "|" chain_head "|" "CHAL" j )  -> first 48 bits mod N.
-- Deterministic, public, unbiasable. Repeated j de-duplicated by the verifier's recompute set.
r30_chal root chain_head j n =
  let h = sha256_hex (cat [root, "|", chain_head, "|CHAL|", show j]) in
  (r_head48 h) - ((r_head48 h) / n) * n
r30_chal_list root chain_head k n j acc =
  if j >= k then reverse acc
  else r30_chal_list root chain_head k n (j + 1) (cons (r30_chal root chain_head j n) acc)

-- =====================================================================================
-- THE VERIFIER: recompute only the k challenged steps + verify their Merkle paths.
-- =====================================================================================
-- To recompute step idx we need its PRE-state. The prover commits post-states; the pre-state of
-- step idx is the committed post-state of step idx-1 (or the genesis state for idx 0). The verifier
-- reads ONLY those two committed states from the transcript per challenge (O(1) per challenge, not
-- a re-run). Here, in-process, we pass the full committed-state list `states` (states[i] = post i;
-- states[-1] conceptually = genesis). r30_prove.rail persists these and the verifier reads them.
-- Returns [n_recomputed, all_ok]. `levels` = the precomputed Merkle level cache (O(log N) proofs).
-- NOTE: NO trailing dead `n` arg between acc_ok and n_rec -- that triggered the documented self-loop
-- cross-dependency argument miscompile (acc_ok aliased to n). Mutual recursion (go/step pair) also
-- sidesteps the self-loop arg scheduler. We keep args lean and use the mutual-recursion form.
r30_verify_chals states genesis levels root chals acc_ok n_rec =
  if chals == [] then cons n_rec (cons acc_ok [])
  else r30_verify_step states genesis levels root chals acc_ok n_rec
r30_verify_step states genesis levels root chals acc_ok n_rec =
  let idx = head chals in
  let pre = if idx == 0 then genesis else r_nth states (idx - 1) in
  let ctx = r30_ctx idx in
  let tgt = r30_tgt idx in
  let recomputed = r30_step pre ctx tgt 1 in   -- verifier always assumes honest clip
  let committed = r_nth states idx in
  let step_ok = if (r30_state_ser recomputed) == (r30_state_ser committed) then 1 else 0 in
  -- Merkle: the committed leaf must be in the tree at idx (O(log N) path from the cache)
  let leaf = r30_leaf idx ctx tgt committed in
  let path = r30_proof levels idx in
  let merkle_ok = r30_verify_path leaf path root in
  let both = step_ok * merkle_ok in
  r30_verify_chals states genesis levels root (tail chals) (acc_ok * both) (n_rec + 1)

-- count distinct challenge indices (the real "steps touched" for the sublinearity gate)
r_mem x xs = if xs == [] then 0 else if (head xs) == x then 1 else r_mem x (tail xs)
r_uniq_go xs seen = if xs == [] then seen
  else if (r_mem (head xs) seen) == 1 then r_uniq_go (tail xs) seen
       else r_uniq_go (tail xs) (cons (head xs) seen)
r_uniq xs = r_uniq_go xs []

-- =====================================================================================
-- ONE FULL PROVE+VERIFY ROUND for N steps. Returns the gate facts.
-- =====================================================================================
-- [root, chain_head, n, k, n_distinct, all_ok]
r30_round n k seed pk genesis poison_at clip_on tag =
  let genesis_state = cons 0 (cons 0 (cons 0 (cons r30_S (cons r30_S [])))) in
  let pr = r30_run genesis_state 0 n clip_on poison_at [] in
  let leaves = r_nth pr 1 in
  let levels = r30_levels leaves in
  let root = r30_levels_root levels in
  -- chain the root onto a genesis link and SIGN it (the attested commitment to the whole trajectory)
  let link_str = cat [genesis, "|R30|", tag, "|", show n, "|", root] in
  let link_b = sha256 link_str in
  let chain_head = bytes_to_hex link_b 32 in
  let sig = ed25519_sign seed link_b 32 in
  let sig_ok = ed25519_verify pk link_b 32 sig in
  -- rebuild the committed post-state list for the verifier (states[i] = post-step i)
  let states = r30_states_of genesis_state 0 n clip_on poison_at [] in
  let chals = r30_chal_list root chain_head k n 0 [] in
  let distinct = r_len (r_uniq chals) in
  let vr = r30_verify_chals states genesis_state levels root chals 1 0 in
  let all_ok = (r_nth vr 1) * sig_ok in
  cons root (cons chain_head (cons n (cons k (cons distinct (cons all_ok (cons (r_nth vr 0) []))))))

-- rebuild committed post-states (mirror of r30_run's `committed`, list form for random access)
r30_states_of state i n clip_on poison_at acc =
  if i >= n then reverse acc
  else let ctx = r30_ctx i in
       let tgt = r30_tgt i in
       let truepost = r30_step state ctx tgt clip_on in
       let committed = if i == poison_at
         then cons (r_nth truepost 0) (cons (r_nth truepost 1)
              (cons ((r_nth truepost 2) + 1) (cons (r_nth truepost 3) (cons (r_nth truepost 4) []))))
         else truepost in
       r30_states_of committed (i + 1) n clip_on poison_at (cons committed acc)

-- run R independent (different-tag -> different-head -> different-challenge) rounds against a
-- poisoned chain; count rounds in which the poisoned step was a challenge (-> caught). Returns
-- [caught_rounds, total_chal_hits].
-- ONE falsify round, returns [round_caught, hit] (two small ints -> survive arena_reset).
r30_falsify_one n k genesis poison_at j =
  let genesis_state = cons 0 (cons 0 (cons 0 (cons r30_S (cons r30_S [])))) in
  let pr = r30_run genesis_state 0 n 1 poison_at [] in
  let leaves = r_nth pr 1 in
  let levels = r30_levels leaves in
  let root = r30_levels_root levels in
  -- distinct chain head per round via the round index in the tag
  let link_str = cat [genesis, "|R30|forge_", show j, "|", show n, "|", root] in
  let chain_head = bytes_to_hex (sha256 link_str) 32 in
  let chals = r30_chal_list root chain_head k n 0 [] in
  let hit = r_mem poison_at chals in
  -- verify: a poisoned chain where the challenge HIT poison_at must fail (all_ok=0)
  let states = r30_states_of genesis_state 0 n 1 poison_at [] in
  let vr = r30_verify_chals states genesis_state levels root chals 1 0 in
  let round_caught = if hit == 1 then (if (r_nth vr 1) == 0 then 1 else 0) else 0 in
  cons round_caught (cons hit [])
-- ARENA DISCIPLINE: bracket each round in mark/reset so a round's training+Merkle garbage is freed
-- before the next round -> bounded memory across R rounds (the ladder's "streamed with arena_reset").
r30_falsify_rounds n k seed pk genesis poison_at rounds j caught hits =
  if j >= rounds then cons caught (cons hits [])
  else let mk = arena_mark 0 in
       let one = r30_falsify_one n k genesis poison_at j in
       let rc = r_nth one 0 in
       let hh = r_nth one 1 in
       let _ = arena_reset mk in
       r30_falsify_rounds n k seed pk genesis poison_at rounds (j + 1) (caught + rc) (hits + hh)

-- guaranteed-detect control: recompute EVERY step of the poisoned chain; must find exactly the
-- inconsistency at poison_at (the fraud-proof a third party opens). Returns 1 if detected.
r30_idx_list n i acc = if i >= n then reverse acc else r30_idx_list n (i + 1) (cons i acc)
r30_full_audit_detects n seed pk genesis poison_at =
  let genesis_state = cons 0 (cons 0 (cons 0 (cons r30_S (cons r30_S [])))) in
  let states = r30_states_of genesis_state 0 n 1 poison_at [] in
  let allidx = r30_idx_list n 0 [] in
  let leaves_pr = r30_run genesis_state 0 n 1 poison_at [] in
  let leaves = r_nth leaves_pr 1 in
  let levels = r30_levels leaves in
  let root = r30_levels_root levels in
  let vr = r30_verify_chals states genesis_state levels root allidx 1 0 in
  if (r_nth vr 1) == 0 then 1 else 0

-- =====================================================================================
-- TRANSCRIPT EMITTER: write the signed succinct-proof transcript the foreign verifier reads.
-- =====================================================================================
-- Format (one record per line, space-separated):
--   #R30TX pubkey=.. genesis=.. tag=.. n=.. k=.. poison_at=.. clip_on=..
--   ROOT <root_hex>
--   HEAD <chain_head_hex>
--   SIG  <sig_hex>
--   STATE <i> <theta> <m> <v> <pow1> <pow2>      (n lines, committed post-states 0..n-1)
-- The foreign verifier reconstructs the Merkle root + FS challenges + signature + k step-recomputes.
r30_state_line i st = cat ["STATE ", show i, " ", show (r_nth st 0), " ", show (r_nth st 1), " ",
                           show (r_nth st 2), " ", show (r_nth st 3), " ", show (r_nth st 4), "\n"]
r30_states_lines states i acc = if states == [] then acc
  else r30_states_lines (tail states) (i + 1) (cat [acc, r30_state_line i (head states)])
r30_emit_transcript path n k seed pk_hex genesis poison_at clip_on tag =
  let genesis_state = cons 0 (cons 0 (cons 0 (cons r30_S (cons r30_S [])))) in
  let pr = r30_run genesis_state 0 n clip_on poison_at [] in
  let leaves = r_nth pr 1 in
  let levels = r30_levels leaves in
  let root = r30_levels_root levels in
  let link_str = cat [genesis, "|R30|", tag, "|", show n, "|", root] in
  let link_b = sha256 link_str in
  let chain_head = bytes_to_hex link_b 32 in
  let sig = ed25519_sign seed link_b 32 in
  let sig_hex = bytes_to_hex sig 64 in
  let states = r30_states_of genesis_state 0 n clip_on poison_at [] in
  let hdr = cat ["#R30TX pubkey=", pk_hex, " genesis=", genesis, " tag=", tag,
                 " n=", show n, " k=", show k, " poison_at=", show poison_at, " clip_on=", show clip_on, "\n",
                 "ROOT ", root, "\n", "HEAD ", chain_head, "\n", "SIG ", sig_hex, "\n"] in
  let body = r30_states_lines states 0 "" in
  write_file path (cat [hdr, body])

main =
  let _ = shell "mkdir -p rungs/r30/out" in
  let seed = sha256 "r30.local.ephemeral.dev.seed.v1" in
  let pk = ed25519_pk_from_sk seed in
  let pk_hex = bytes_to_hex pk 32 in
  let genesis = sha256_hex "R30.LOCAL.GENESIS.dev" in

  -- challenge budget: k ~ ceil(c*sqrt(N)), capped < 25% of N (the budget gate). Scales chosen so the
  -- whole gate runs in seconds (the protocol is O(N) per round regardless of N -- scale is purely
  -- demonstrative; r30_prove.rail runs the SAME functions on the real lm10 step at full size).
  -- soundness: a prover who tampered 1 of N steps escapes a round iff NONE of k challenges hit it:
  --   Pr[escape | 1 tampered] = (1 - 1/N)^k    (FS challenges ~ independent uniform).
  --   For N=256, k=48: Pr[escape] ~ (255/256)^48 ~ 0.829  PER ROUND -- weak for a SINGLE step, named
  --   honestly. Two independent strengtheners (both gated): (1) AMPLIFY across R head-derived rounds:
  --   Pr[escape all R] = product ~ 0.829^32 ~ 0.0026; (2) the FULL AUDIT is a guaranteed-detect
  --   third-party fraud-proof (recompute every step) that ALWAYS opens the inconsistency. The general
  --   bound for m tampered steps: Pr[escape] = (1 - m/N)^k, so larger forgeries are caught faster.
  --   See IMPL.md "Soundness obligation" for the full statement.

  -- ===== HONEST ROUND, N1 (bracketed in arena mark/reset -> bounded memory) =====
  let n1 = 256 in
  let k1 = 32 in
  let mk1 = arena_mark 0 in
  let r1 = r30_round n1 k1 seed pk genesis (0 - 1) 1 "honest_n1" in
  let ok1 = r_nth r1 5 in
  let touched1 = r_nth r1 4 in
  let root1 = r_nth r1 0 in
  let _ = write_file "rungs/r30/out/r30_root1.txt" root1 in
  let _ = arena_reset mk1 in
  let root1 = read_file "rungs/r30/out/r30_root1.txt" in
  let pct1 = (touched1 * 100) / n1 in

  -- ===== HONEST ROUND at 2x steps, N2 -- sublinearity demonstration =====
  -- train cost doubles (N2 = 2*N1); verify budget k grows only ~sqrt(2)x, NOT 2x.
  let n2 = 512 in
  let k2 = 45 in
  let mk2 = arena_mark 0 in
  let r2 = r30_round n2 k2 seed pk genesis (0 - 1) 1 "honest_n2" in
  let ok2 = r_nth r2 5 in
  let touched2 = r_nth r2 4 in
  let root2 = r_nth r2 0 in
  let _ = write_file "rungs/r30/out/r30_root2.txt" root2 in
  let _ = arena_reset mk2 in
  let root2 = read_file "rungs/r30/out/r30_root2.txt" in
  let pct2 = (touched2 * 100) / n2 in
  -- sublinearity gate: verify-work ratio (k2/k1) must be STRICTLY LESS than train ratio (n2/n1=2).
  -- integer form: k2 < (n2/n1)*k1  ->  45 < 64  -> TRUE (verify grew 1.41x while train grew 2x).
  let okSublinear = if k2 < ((n2 / n1) * k1) then 1 else 0 in
  let okBudget1 = if pct1 < 25 then 1 else 0 in
  let okBudget2 = if pct2 < 25 then 1 else 0 in

  -- ===== FALSIFIER: poison ONE interior step, run MANY head-derived rounds, must be CAUGHT =====
  -- Each round j re-derives challenges from a DIFFERENT tag (-> different chain head -> different FS
  -- challenges). The poisoned step is caught in round j iff a challenge hits it AND the recomputation
  -- diverges. We require caught>=1 across R rounds (the amplified gate) AND report the empirical rate.
  let poison_at = 129 in
  let nf = 256 in
  let kf = 48 in
  let rounds = 32 in
  let fr = r30_falsify_rounds nf kf seed pk genesis poison_at rounds 0 0 0 in
  let caught = r_nth fr 0 in
  let total_chal_hits = r_nth fr 1 in
  let okFalsifyCaught = if caught >= 1 then 1 else 0 in
  -- also: the poisoned chain, when ALL steps are recomputed (the third-party fraud-proof), MUST
  -- diverge -- a guaranteed-detect control independent of sampling.
  let mkfa = arena_mark 0 in
  let okFalsifyFull = r30_full_audit_detects nf seed pk genesis poison_at in
  let _ = write_file "rungs/r30/out/r30_fa.txt" (show okFalsifyFull) in
  let _ = arena_reset mkfa in
  let okFalsifyFull = r30_hd_int (read_file "rungs/r30/out/r30_fa.txt") in

  -- ===== CLIP-DISABLE FALSIFIER: a chain trained with clip OFF cannot pass a clip-ON verifier =====
  -- The verifier recomputes assuming honest clip (clip_on=1). A chain whose steps were taken with
  -- clip OFF (clip_on=0) diverges at the first step whose raw gradient exceeded GCLIP.
  let mkc = arena_mark 0 in
  let rc = r30_round nf kf seed pk genesis (0 - 1) 0 "cliphack" in
  let okClipFalsify = if (r_nth rc 5) == 0 then 1 else 0 in
  let _ = write_file "rungs/r30/out/r30_clip.txt" (show okClipFalsify) in
  let _ = arena_reset mkc in
  let okClipFalsify = r30_hd_int (read_file "rungs/r30/out/r30_clip.txt") in

  -- ===== EMIT TRANSCRIPTS for the FOREIGN cross-language verifier =====
  -- honest transcript (poison_at = -1, clip_on = 1) -> foreign party must fully reproduce + spot-check
  let mkt1 = arena_mark 0 in
  let _ = r30_emit_transcript "rungs/r30/out/r30_transcript.txt" n1 k1 seed pk_hex genesis (0 - 1) 1 "honest_n1" in
  let _ = arena_reset mkt1 in
  -- forged transcript (poison a v-moment at an interior step) -> foreign party must REJECT it
  let mkt2 = arena_mark 0 in
  let _ = r30_emit_transcript "rungs/r30/out/r30_transcript_forged.txt" nf kf seed pk_hex genesis poison_at 1 "honest_n1" in
  let _ = arena_reset mkt2 in

  let all = ok1 * ok2 * okSublinear * okBudget1 * okBudget2 * okFalsifyCaught * okFalsifyFull * okClipFalsify in

  -- persist a machine-readable gate transcript (validate.sh greps this)
  let report = cat [
    "R30_PROTOCOL v1\n",
    "pubkey ", pk_hex, "\n",
    "genesis ", genesis, "\n",
    "honest_n1 N=", show n1, " k=", show k1, " distinct=", show touched1, " pct=", show pct1, " ok=", show ok1, " root=", root1, "\n",
    "honest_n2 N=", show n2, " k=", show k2, " distinct=", show touched2, " pct=", show pct2, " ok=", show ok2, " root=", root2, "\n",
    "sublinear k1=", show k1, " k2=", show k2, " train_ratio=", show (n2 / n1), " verify_ratio_num=", show k2, " ok=", show okSublinear, "\n",
    "budget1 pct=", show pct1, " ok=", show okBudget1, "\n",
    "budget2 pct=", show pct2, " ok=", show okBudget2, "\n",
    "falsify_sampled poison_at=", show poison_at, " rounds=", show rounds, " caught=", show caught, " hits=", show total_chal_hits, " ok=", show okFalsifyCaught, "\n",
    "falsify_full_audit ok=", show okFalsifyFull, "\n",
    "clip_falsify ok=", show okClipFalsify, "\n",
    "ALL ", show all, "\n"] in
  let _ = write_file "rungs/r30/out/r30_gate.txt" report in

  let _ = print "================ RUNG 30: SUCCINCT SPOT-CHECK (Fiat-Shamir) ================" in
  let _ = print (cat ["pubkey                       = ", pk_hex]) in
  let _ = print (cat ["honest N1=", show n1, " k=", show k1, ": verifies=", show ok1, " distinct-steps-touched=", show touched1, " (", show pct1, "% < 25%)"]) in
  let _ = print (cat ["honest N2=", show n2, " k=", show k2, ": verifies=", show ok2, " distinct-steps-touched=", show touched2, " (", show pct2, "% < 25%)"]) in
  let _ = print (cat ["SUBLINEAR: train cost x", show (n2 / n1), " but verify budget k ", show k1, "->", show k2, " (", show okSublinear, ": k2<2*k1)"]) in
  let _ = print (cat ["FALSIFY (sampled, ", show rounds, " head-derived rounds): poisoned step caught in ", show caught, " rounds (", show total_chal_hits, " total challenge-hits) ok=", show okFalsifyCaught]) in
  let _ = print (cat ["FALSIFY (full audit, guaranteed): poisoned chain diverges at poison_at ok=", show okFalsifyFull]) in
  let _ = print (cat ["FALSIFY (clip disabled): clip-off chain rejected by clip-on verifier ok=", show okClipFalsify]) in
  let _ = print (cat ["gate transcript: rungs/r30/out/r30_gate.txt"]) in
  let _ = print (if all == 1
    then "PASS: an entire training trajectory is verified by recomputing only k<<N Fiat-Shamir-challenged steps (verify sublinear in N, <25% of steps), Merkle paths check, and forged interior steps are caught across head-derived rounds. Foreign re-derivation in r30_foreign_check.py."
    else "FAIL") in
  if all == 1 then 0 else 1
