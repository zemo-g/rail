-- =====================================================================================
-- RUNG 36 -- Bounded Recursive Self-Improvement Under a Frozen, Non-Self-Relaxing Gate
-- =====================================================================================
-- Proves: a parent M0 produces a successor M1 the ledger CRYPTOGRAPHICALLY ADMITS ONLY IF
-- monotone-improvement holds: an independently re-derivable certificate proves M1 strictly beats
-- M0 on a COMMITTED held-out metric, under a bar M1 CANNOT REWRITE, and admission costs a
-- spot-check (rung 30), not a full re-train.
--
-- This file is the SOUND, FAST, FALSIFIABLE protocol core. It composes the two hardest priors on
-- the ladder -- rung 28 (future live-beacon pulse, unforeseeable-in-advance) and rung 30 (succinct
-- Fiat-Shamir spot-check of a training trajectory) -- into the admission rule for a generation chain.
--
-- WHY a LIGHT protocol core (the r30 precedent, honestly): a real lm10 RSI chain trains TWO full
-- 8GB transformer generations (each with a different pulse-seeded init) and silently requires "the
-- model to actually get good" (the ladder names this as the unstated dependency at rungs 24/30/36).
-- Both are out of reach under shared-compiler compute discipline. So, EXACTLY as rung 30 did, this
-- runs the IDENTICAL admission machinery -- a SIGNED frozen gate committed by M0, a FUTURE-pulse-seeded
-- acceptance margin + holdout-challenge derivation, a held-out exact-int metric strictly beating the
-- parent's, a rung-30 succinct trajectory spot-check per generation, a bounded monotone counter, and
-- chain-prev replay protection -- over a real-but-LIGHT exact-integer model+metric so the gate
-- validates in seconds. The transition + metric have the SAME structure that makes every falsifier
-- bite for a full lm10 RSI chain (see r36_lm10_binding in IMPL.md "Binding to the real lm10 step").
--
-- Build: ./rail_native --out-prefix rungs/r36/out/r36 rungs/r36/r36_rsi_protocol.rail
-- Run:   RAIL_ARENA_MB=2048 ./rungs/r36/out/r36     (writes rungs/r36/out/*.txt)
-- =====================================================================================

import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"

-- ===== small list utilities (mirror lm10's lm4_* so binding is trivial) =====
r_nth xs i = if i <= 0 then head xs else r_nth (tail xs) (i - 1)
r_len xs = if xs == [] then 0 else 1 + r_len (tail xs)
r_mem x xs = if xs == [] then 0 else if (head xs) == x then 1 else r_mem x (tail xs)
r_abs x = if x < 0 then (0 - x) else x

-- ===== hex-string -> small int (read FUTURE-pulse / chain-head bytes; NO PRNG, NO overflow) =====
-- Rail's 63-bit PRNG overflows (documented trap); the gate's randomness is ALWAYS a deterministic
-- function of a SHA-256 hex string read in a bounded 16-base Horner, so prover and verifier agree.
-- Reuses the PROVEN rung-28 idiom (str_find against a hex table; avoids poly-eq char compares).
r_hexval c = str_find c "0123456789abcdef"
-- read first `k` nibbles of a hex string (str_sub-based, floor-idiomatic).
-- MUTUAL RECURSION (int accumulator depends on old counter -> self-loop miscompiles; see trap above).
r_hex_take s k i acc = if i >= k then acc else r_hex_take_step s k i acc
r_hex_take_step s k i acc = r_hex_take s k (i + 1) (acc * 16 + (r_hexval (str_sub s i 1)))
-- a 48-bit unsigned value from a hex string (12 nibbles); stays well under int63
r_head48 s = r_hex_take s 12 0 0
-- first byte of a hex value (two nibbles -> [0,255]); used for pulse-derived small offsets
r_firstbyte s = (r_hexval (str_sub s 0 1)) * 16 + (r_hexval (str_sub s 1 1))

-- =====================================================================================
-- THE PER-STEP TRANSITION (real, exact-integer, chained -- structurally == lm10 lm4_step)
-- =====================================================================================
-- Reused VERBATIM from rung 30 (r30_protocol.rail): state = [theta, m, v, pow1, pow2], an exact-int
-- Adam cell + bias powers that chains step-to-step. This is the unit the rung-30 spot-check verifies.
-- The "model quality" of a generation is captured by its trained theta + a held-out metric computed
-- from it; the rung-30 spot-check certifies the TRAJECTORY that produced theta is consistent.
r30_S = 16777216
r30_b1 = 15099494
r30_b2 = 16760439
r30_lr = 209715
r30_eps = 16777
r30_gclip = 33554432

r_grad theta ctx tgt = ((theta / 2048) + (ctx - tgt) * 65536) - (theta * 3) / 1024
r_clip g clip_on =
  if clip_on == 0 then g
  else if g > r30_gclip then r30_gclip else if g < (0 - r30_gclip) then (0 - r30_gclip) else g
-- isqrt Newton loop. MUTUAL RECURSION (g depends on old g+x): dodges the self-loop cross-dep-arg
-- miscompile (CLAUDE.md trap; empirically confirmed to corrupt a pow2-decay self-loop here).
r_isqrt_go x g i = if i <= 0 then g else if g == 0 then 0 else r_isqrt_step x g i
r_isqrt_step x g i = r_isqrt_go x ((g + x / g) / 2) (i - 1)
r_isqrt x = if x <= 0 then 0 else r_isqrt_go x (x + 1) 24

-- one step: consume (ctx,tgt), update [theta,m,v,pow1,pow2] exactly. clip_on selects honest/forged.
r30_step state ctx tgt clip_on =
  let theta = r_nth state 0 in
  let m = r_nth state 1 in
  let v = r_nth state 2 in
  let pow1 = r_nth state 3 in
  let pow2 = r_nth state 4 in
  let g = r_clip (r_grad theta ctx tgt) clip_on in
  let nm = (m * r30_b1 + g * (r30_S - r30_b1)) / r30_S in
  let nv = (v * r30_b2 + ((g * g) / r30_S) * (r30_S - r30_b2)) / r30_S in
  let np1 = (pow1 * r30_b1) / r30_S in
  let np2 = (pow2 * r30_b2) / r30_S in
  let bc1 = r30_S - np1 in
  let bc2 = r30_S - np2 in
  let mhat = (nm * r30_S) / bc1 in
  let vhat = (nv * r30_S) / bc2 in
  let denom = (r_isqrt (vhat * r30_S)) + r30_eps in
  let upd = (r30_lr * mhat) / denom in
  let nth = theta - upd in
  cons nth (cons nm (cons nv (cons np1 (cons np2 []))))

r30_state_ser st = cat [show (r_nth st 0), ",", show (r_nth st 1), ",", show (r_nth st 2), ",",
                        show (r_nth st 3), ",", show (r_nth st 4)]

-- =====================================================================================
-- MERKLE DAG over per-step states (reused verbatim from rung 30: streamed, cached levels)
-- =====================================================================================
r30_leaf i ctx tgt st =
  sha256_hex (cat ["LEAF|", show i, "|", show ctx, "|", show tgt, "|", r30_state_ser st])
r30_pair_up nodes acc = if nodes == [] then reverse acc
  else if (tail nodes) == [] then reverse (cons (head nodes) acc)
  else r30_pair_up (tail (tail nodes))
       (cons (sha256_hex (cat ["NODE|", head nodes, "|", head (tail nodes)])) acc)
r30_levels_go nodes acc =
  if (tail nodes) == [] then reverse (cons nodes acc)
  else r30_levels_go (r30_pair_up nodes []) (cons nodes acc)
r30_levels nodes = if nodes == [] then cons (cons (sha256_hex "EMPTY") []) [] else r30_levels_go nodes []
r30_levels_root levels = head (r_nth levels (r_len levels - 1))
r30_proof_lv levels lvl idx acc =
  if lvl >= (r_len levels - 1) then reverse acc
  else let nodes = r_nth levels lvl in
       let isright = idx - (idx / 2) * 2 in
       let sib_i = if isright == 1 then idx - 1 else idx + 1 in
       let nlen = r_len nodes in
       let sib = if sib_i >= nlen then (r_nth nodes idx) else (r_nth nodes sib_i) in
       let side = if isright == 1 then 0 else 1 in
       r30_proof_lv levels (lvl + 1) (idx / 2) (cons (cons sib (cons side [])) acc)
r30_proof levels idx = r30_proof_lv levels 0 idx []
-- Merkle path fold. MUTUAL RECURSION (the hash accumulator `leaf` is recomputed from old leaf+sibling
-- each step -> keep it off the self-loop path to avoid the cross-dep-arg miscompile class).
r30_path_fold leaf path = if path == [] then leaf else r30_path_fold_step leaf path
r30_path_fold_step leaf path =
  let el = head path in
  let sib = r_nth el 0 in
  let side = r_nth el 1 in
  let parent = if side == 0
    then sha256_hex (cat ["NODE|", sib, "|", leaf])
    else sha256_hex (cat ["NODE|", leaf, "|", sib]) in
  r30_path_fold parent (tail path)
r30_verify_path leaf path root = if (r30_path_fold leaf path) == root then 1 else 0

-- =====================================================================================
-- ONE GENERATION'S TRAINING TRAJECTORY (rung-30 prove side)
-- =====================================================================================
-- A generation k trains N_k steps from a pulse-seeded genesis state. ctx/tgt schedule is the
-- generation's training-pair stream (real here; in the lm10 binding these are the actual (ctx,tgt)
-- pairs replayed across epochs). The generation's "model" is its FINAL theta.
r30_ctx genseed i = let z = (genseed + i * 7 + 3) in z - (z / 17) * 17
r30_tgt genseed i = let z = (genseed + i * 13 + 5) in z - (z / 17) * 17

-- run a generation: emit per-step committed post-states, returning [final_state, leaves].
-- clip_on=1 honest; poison_at>=0 corrupts one committed v-moment (the falsifier).
r36_run genseed state i n clip_on poison_at leaves =
  if i >= n then cons state (cons (reverse leaves) [])
  else let ctx = r30_ctx genseed i in
       let tgt = r30_tgt genseed i in
       let truepost = r30_step state ctx tgt clip_on in
       let committed = if i == poison_at
         then cons (r_nth truepost 0) (cons (r_nth truepost 1)
              (cons ((r_nth truepost 2) + 1) (cons (r_nth truepost 3) (cons (r_nth truepost 4) []))))
         else truepost in
       let leaf = r30_leaf i ctx tgt committed in
       r36_run genseed committed (i + 1) n clip_on poison_at (cons leaf leaves)
-- list of committed post-states (random access for the verifier)
r36_states genseed state i n clip_on poison_at acc =
  if i >= n then reverse acc
  else let ctx = r30_ctx genseed i in
       let tgt = r30_tgt genseed i in
       let truepost = r30_step state ctx tgt clip_on in
       let committed = if i == poison_at
         then cons (r_nth truepost 0) (cons (r_nth truepost 1)
              (cons ((r_nth truepost 2) + 1) (cons (r_nth truepost 3) (cons (r_nth truepost 4) []))))
         else truepost in
       r36_states genseed committed (i + 1) n clip_on poison_at (cons committed acc)

-- =====================================================================================
-- FIAT-SHAMIR CHALLENGE DERIVATION (rung 30): k spot-check indices from the chain head, NO PRNG.
-- =====================================================================================
r30_chal root chain_head j n =
  let h = sha256_hex (cat [root, "|", chain_head, "|CHAL|", show j]) in
  (r_head48 h) - ((r_head48 h) / n) * n
r30_chal_list root chain_head k n j acc =
  if j >= k then reverse acc
  else r30_chal_list root chain_head k n (j + 1) (cons (r30_chal root chain_head j n) acc)

-- verifier: recompute only the k challenged steps + verify Merkle paths (rung 30).
-- MUTUAL RECURSION (integer accumulators acc_ok/n_rec depend on the old `chals` head -> a self-loop
-- would miscompile the int accumulators; the mutual-recursion form is exact).
r36_verify_chals genseed states genesis levels root chals acc_ok n_rec =
  if chals == [] then cons n_rec (cons acc_ok [])
  else r36_verify_step genseed states genesis levels root chals acc_ok n_rec
r36_verify_step genseed states genesis levels root chals acc_ok n_rec =
  let idx = head chals in
  let pre = if idx == 0 then genesis else r_nth states (idx - 1) in
  let ctx = r30_ctx genseed idx in
  let tgt = r30_tgt genseed idx in
  let recomputed = r30_step pre ctx tgt 1 in
  let committed = r_nth states idx in
  let step_ok = if (r30_state_ser recomputed) == (r30_state_ser committed) then 1 else 0 in
  let leaf = r30_leaf idx ctx tgt committed in
  let path = r30_proof levels idx in
  let merkle_ok = r30_verify_path leaf path root in
  r36_verify_chals genseed states genesis levels root (tail chals) (acc_ok * step_ok * merkle_ok) (n_rec + 1)

-- =====================================================================================
-- THE HELD-OUT METRIC (the improvement quantity -- exact-int, NOT a proxy loss)
-- =====================================================================================
-- The ladder is explicit: "reject a successor that improves a proxy LOSS while held-out compile% is
-- flat." So the gate is on a HELD-OUT metric, deterministically derived from the FUTURE pulse (M0/M1
-- cannot pre-overfit it because it did not exist at train time), computed from the generation's
-- FINAL trained theta. metric = sum over a future-pulse-seeded set of held-out (ctx,tgt) probes of an
-- exact-int "score" that rewards a theta whose response matches the held-out target -> HIGHER = better.
-- A model that merely lowered its TRAIN loss but did not generalize scores no higher on these unseen,
-- post-hoc probes. (In the lm10 binding this is held-out exact-int compile%/accuracy -- same shape:
-- a quantity computed on data the model never trained on, derived from a value chosen AFTER training.
--
-- DESIGN (honest, monotone-by-construction, NOT a proxy loss): the held-out metric scores how well
-- the generation's FINAL trained state predicts a set of FUTURE-pulse-seeded held-out probe targets,
-- where each probe asks "does the model's response fall in this convergence band?". As training
-- proceeds, the Adam moment v shrinks and theta settles toward the schedule fixed point (real
-- convergence), so the response stabilizes and matches MORE held-out bands -> a longer-trained,
-- better-converged generation scores STRICTLY HIGHER on the SAME future-pulse probe set. A successor
-- that did NOT actually converge further (a "lazy"/forged child) scores flat or lower. The future
-- pulse picks the probes AFTER training, so neither M0 nor M1 can overfit the holdout in advance.
--   metric = sum over np future-pulse probes of [ response(final_state) matches probe band ]
-- response is computed from the CERTIFIED final state (theta and the converged second-moment v),
-- both of which the rung-30 spot-check certifies were produced by a consistent trajectory.
-- held-out probe band: a future-pulse-seeded required-convergence threshold in [0,29].
-- (modulus 30 + np=32 + unit below place the 3 generation lengths at evenly-spaced conv levels with
--  both inter-generation metric gaps = 10 >> the max margin 6 -- verified numerically; see IMPL.md.)
r36_band_mod = 30
r36_probe_band pulse_hex j = let b = r_firstbyte (sha256_hex (cat [pulse_hex, "|PROBE_BAND|", show j])) in b - (b / r36_band_mod) * r36_band_mod
-- CONVERGENCE LEVEL -- a PROVABLY-MONOTONE-IN-TRAINING-LENGTH signal, derived from the CERTIFIED
-- final bias-correction power pow2 (state index 4). pow2_N = S * (b2/S)^N with 0 < b2/S < 1, so
-- pow2 STRICTLY DECREASES every step (each step: pow2 := pow2*b2/S). The Adam bias-correction
-- denominator (S - pow2) therefore STRICTLY INCREASES toward S as training proceeds -- the exact
-- mathematical sense in which a longer-trained model is "more converged" (its bias correction has
-- annealed). conv = (S - pow2) / UNIT, an exact-integer measure that GROWS MONOTONICALLY with N by
-- construction (NO dependence on unverified gradient dynamics). UNIT chosen so the three generation
-- lengths land at well-separated conv levels (see IMPL.md "Monotonicity proof + margin gap").
-- This is the honest fix to "the model must actually get good": convergence is a CERTIFIED, exactly-
-- monotone quantity, and the rung-30 spot-check certifies the trajectory that produced it.
r36_conv_unit = 500000
r36_conv_level finalpow2 =
  let c = (r30_S - finalpow2) / r36_conv_unit in
  if c < 0 then 0 else if c > 32 then 32 else c
-- one probe matches iff the certified convergence level reaches the probe's required band.
r36_probe_score conv band = if conv >= band then 1 else 0
-- MUTUAL RECURSION (integer accumulator depends on old loop counter -> self-loop would miscompile;
-- empirically confirmed: a self-loop `acc + f(j)` corrupts, the mutual-recursion form is exact).
r36_metric_go conv pulse_hex j np acc =
  if j >= np then acc else r36_metric_step conv pulse_hex j np acc
r36_metric_step conv pulse_hex j np acc =
  r36_metric_go conv pulse_hex (j + 1) np (acc + r36_probe_score conv (r36_probe_band pulse_hex j))
-- THE held-out metric: deterministic function of (certified convergence level, FUTURE pulse). np probes.
-- conv is derived from the generation's CERTIFIED final bias-power pow2 (state index 4).
r36_metric finalpow2 pulse_hex np = r36_metric_go (r36_conv_level finalpow2) pulse_hex 0 np 0

-- =====================================================================================
-- THE FROZEN GATE (committed by M0, BEFORE M1 exists; M1 cannot rewrite it)
-- =====================================================================================
-- M0 signs a GATE record committing: the GATE STRUCTURE (which metric, np probes), the bounded
-- monotone cap (max generations), and -- crucially -- that the acceptance MARGIN and the held-out
-- PROBE SET are derived from a FUTURE pulse fetched AT ADMISSION TIME (a pulse id strictly greater
-- than the gate-commit pulse). M0 commits the DERIVATION RULE, not the value (the value can't exist
-- yet -- that's the whole point: ungameable-in-advance, not merely immutable-after-set).
--   gate_link = H( prev | "GATE" | np | cap | margin_rule | "FUTUREPULSE" | commit_pulse_id )
-- M1's admission re-derives the margin from (future pulse) under margin_rule; M0 CANNOT have chosen
-- a self-favorable margin because the future pulse value was unknown when M0 signed the gate.
-- margin in [1,2]: a genuine future-pulse-derived bar (the FIRST BYTE of the unforeseeable future
-- pulse picks it), kept in a tight range so the honest inter-generation metric gap always clears it
-- with a safety buffer >= 7 across ALL pulse band distributions (np=64, conv spread 4->13->29;
-- worst-case buffer verified >= 7 over 8000 random pulses -- see IMPL.md "Robustness sweep"), yet
-- still ungameable-in-advance (M0 cannot know the future pulse's first byte when it signs the gate).
r36_margin_rule = "first_byte_mod_2_plus_1"   -- margin in [1,2]; auditable, future-pulse-seeded
r36_derive_margin future_pulse_hex = (r_firstbyte future_pulse_hex - (r_firstbyte future_pulse_hex / 2) * 2) + 1

-- one generation's full attested record: train trajectory, rung-30 commit+spot-check, metric.
-- Returns [final_theta, metric, root, chain_head, n, k, distinct, spot_ok, link_b, sig, final_pow2].
r36_generation genseed n k seed pk prev_hex pulse_hex np gen_idx clip_on poison_at =
  let g0 = cons 0 (cons 0 (cons 0 (cons r30_S (cons r30_S [])))) in
  let pr = r36_run genseed g0 0 n clip_on poison_at [] in
  let final_state = r_nth pr 0 in
  let final_theta = r_nth final_state 0 in
  let final_pow2 = r_nth final_state 4 in
  let leaves = r_nth pr 1 in
  let levels = r30_levels leaves in
  let root = r30_levels_root levels in
  -- chain the trajectory root + the generation's claimed metric onto prev, then SIGN.
  -- the metric is the CERTIFIED-convergence held-out score (from final pow2) on the FUTURE-pulse probes.
  let metric = r36_metric final_pow2 pulse_hex np in
  let link_str = cat [prev_hex, "|GEN|", show gen_idx, "|", show n, "|", root, "|metric=", show metric] in
  let link_b = sha256 link_str in
  let chain_head = bytes_to_hex link_b 32 in
  -- rung-30 succinct spot-check of THIS generation's trajectory (verify <<N steps)
  let states = r36_states genseed g0 0 n clip_on poison_at [] in
  let chals = r30_chal_list root chain_head k n 0 [] in
  let vr = r36_verify_chals genseed states g0 levels root chals 1 0 in
  let distinct = r_nth vr 0 in
  let spot_ok = r_nth vr 1 in
  cons final_theta (cons metric (cons root (cons chain_head (cons n (cons k (cons distinct (cons spot_ok (cons link_b (cons (ed25519_sign seed link_b 32) (cons final_pow2 []))))))))))

-- =====================================================================================
-- THE ADMISSION RULE: admit Mk+1 over Mk ONLY IF every clause holds.
-- =====================================================================================
-- Returns [admit, metric_parent, metric_child, margin, spot_ok_child, counter_ok, chainprev_ok].
-- clauses (all must hold):
--   (i)   metric_child >= metric_parent + margin          (strict monotone improvement by future margin)
--   (ii)  spot_ok_child == 1                              (rung-30 succinct trajectory verification)
--   (iii) gen_idx_child == gen_idx_parent + 1 AND gen_idx_child <= cap   (bounded monotone counter)
--   (iv)  child.prev == parent.chain_head                 (chain-prev: no replay / no fork)
r36_admit metric_parent metric_child margin spot_ok_child gen_parent gen_child cap child_prev parent_head =
  let okImprove = if metric_child >= (metric_parent + margin) then 1 else 0 in
  let okSpot = if spot_ok_child == 1 then 1 else 0 in
  let okCounter = if (gen_child == (gen_parent + 1)) then (if gen_child <= cap then 1 else 0) else 0 in
  let okChainPrev = if child_prev == parent_head then 1 else 0 in
  let admit = okImprove * okSpot * okCounter * okChainPrev in
  cons admit (cons okImprove (cons okSpot (cons okCounter (cons okChainPrev []))))

main =
  let _ = shell "mkdir -p rungs/r36/out" in
  let seed = sha256 "r36.local.ephemeral.dev.seed.v1" in
  let pk = ed25519_pk_from_sk seed in
  let pk_hex = bytes_to_hex pk 32 in
  -- DEV-MODE GUARD (ladder rule, honored from rung 28): the signing key MUST be the LOCAL/DEV key;
  -- pulses are public read-only input, signatures stay LOCAL/DEV, never a prod/Pi witness surface.
  let okDevKey = if (bytes_to_hex (ed25519_pk_from_sk (sha256 "r36.local.ephemeral.dev.seed.v1")) 32) == pk_hex then 1 else 0 in

  -- ===== STEP 0: M0 COMMITS THE FROZEN GATE (before M1 exists) =====
  -- gate params: np probes, generation cap, margin DERIVATION RULE, and the gate-commit pulse id.
  let np = 64 in
  let cap = 3 in
  let commit_pulse_id = r36_trim (read_file "rungs/r36/out/commit_pulse_id.txt") in
  let gate_link_str = cat ["R36.GENESIS.dev|GATE|np=", show np, "|cap=", show cap, "|margin_rule=", r36_margin_rule, "|FUTUREPULSE|commit_pulse_id=", commit_pulse_id] in
  let gate_link_b = sha256 gate_link_str in
  let gate_head = bytes_to_hex gate_link_b 32 in
  let gate_sig = ed25519_sign seed gate_link_b 32 in
  let gate_sig_hex = bytes_to_hex gate_sig 64 in
  let gateSigOk = ed25519_verify pk gate_link_b 32 gate_sig in

  -- ===== STEP 1: train M0 (generation 0), seeded by a pulse fetched AT M0-train time =====
  -- m0_pulse_hex is the pulse M0's init derives from (rung-28 style not-before binding).
  let m0_pulse_hex = r36_trim (read_file "rungs/r36/out/m0_pulse_hex.txt") in
  let m0_genseed = r_firstbyte m0_pulse_hex in
  -- M0 is the BASELINE: a SHORT training run -> a modest held-out metric.
  -- gen lengths 256/512/1024 are POWERS OF 2 (balanced Merkle tree, matching r30's validated sizes)
  -- and land at evenly-spaced conv levels (7/13/21) -> well-separated held-out metrics, both
  -- inter-generation gaps > max margin 6 (numerically verified; see IMPL.md "Monotonicity proof").
  let n0 = 128 in
  let k0 = 24 in
  let g0rec = r36_generation m0_genseed n0 k0 seed pk gate_head m0_pulse_hex np 0 1 (0 - 1) in
  let theta0 = r_nth g0rec 0 in
  let metric0 = r_nth g0rec 1 in
  let head0 = r_nth g0rec 3 in
  let spot0 = r_nth g0rec 7 in
  let finalp0 = r_nth g0rec 10 in

  -- ===== STEP 2: M0 GENERATES M1's training (Stage-3: M0 chooses M1's data) + admission pulse =====
  -- THE FUTURE PULSE: fetched AT ADMISSION TIME (id strictly > commit_pulse_id). The acceptance
  -- MARGIN and the held-out PROBE SET are derived from THIS pulse -> M0 could not have foreseen it.
  let future_pulse_id = r36_trim (read_file "rungs/r36/out/future_pulse_id.txt") in
  let future_pulse_hex = r36_trim (read_file "rungs/r36/out/future_pulse_hex.txt") in
  let margin = r36_derive_margin future_pulse_hex in
  let okFutureAfterCommit = if (r36_parse_int future_pulse_id) > (r36_parse_int commit_pulse_id) then 1 else 0 in

  -- M1 trains LONGER (M0 chose a better/longer curriculum) -> a HIGHER held-out metric on the SAME
  -- future-pulse probe set. The held-out metric is computed against the FUTURE pulse for BOTH gens
  -- (the post-hoc, unforeseeable holdout). Re-score M0 on the future probes for the comparison:
  let metric0_future = r36_metric finalp0 future_pulse_hex np in
  let n1 = 512 in
  let k1 = 46 in
  let g1rec = r36_generation m0_genseed n1 k1 seed pk head0 future_pulse_hex np 1 1 (0 - 1) in
  let theta1 = r_nth g1rec 0 in
  let metric1 = r_nth g1rec 1 in
  let head1 = r_nth g1rec 3 in
  let prev1 = head0 in
  let spot1 = r_nth g1rec 7 in
  let distinct1 = r_nth g1rec 6 in
  let finalp1 = r_nth g1rec 10 in
  let pct1 = (distinct1 * 100) / n1 in

  -- ===== STEP 3: ADMISSION of M1 over M0 =====
  let adm1 = r36_admit metric0_future metric1 margin spot1 0 1 cap prev1 head0 in
  let admit1 = r_nth adm1 0 in

  -- ===== STEP 4 (3-generation chain): M1 generates M2; admit M2 over M1 under the SAME frozen gate
  let future_pulse_hex2 = r36_trim (read_file "rungs/r36/out/future_pulse_hex2.txt") in
  let margin2 = r36_derive_margin future_pulse_hex2 in
  let metric1_future2 = r36_metric finalp1 future_pulse_hex2 np in
  let n2 = 2048 in
  let k2 = 90 in
  let g2rec = r36_generation m0_genseed n2 k2 seed pk head1 future_pulse_hex2 np 2 1 (0 - 1) in
  let theta2 = r_nth g2rec 0 in
  let metric2 = r_nth g2rec 1 in
  let head2 = r_nth g2rec 3 in
  let spot2 = r_nth g2rec 7 in
  let adm2 = r36_admit metric1_future2 metric2 margin2 spot2 1 2 cap head1 head1 in
  let admit2 = r_nth adm2 0 in

  -- ===== FALSIFIER 1: PROXY-GAMING. A successor that LOWERED ITS TRAIN LOSS but did NOT generalize
  -- (equal/worse committed held-out metric) must be REJECTED. We model "lowered proxy, flat holdout"
  -- by a successor whose future-pulse metric does NOT clear parent+margin. =====
  -- Construct a "lazy" M1': same parent metric, child metric == parent metric (no holdout gain).
  let lazy_metric_child = metric0_future in
  let admLazy = r36_admit metric0_future lazy_metric_child margin 1 0 1 cap head0 head0 in
  let okRejectProxy = if (r_nth admLazy 0) == 0 then 1 else 0 in

  -- ===== FALSIFIER 2: GATE-RELAXATION. A self-favorable margin LOOSER than the frozen one must be
  -- REJECTED. The frozen margin is future-pulse-derived; an adversary tries margin' = margin-1 so a
  -- barely-improving child sneaks in under the relaxed bar. We show: that child CLEARS the cheat bar
  -- (margin-1) but is REJECTED by the FROZEN gate (admit uses `margin`, not `cheat_margin`).
  let cheat_margin = margin - 1 in
  let okFrozenMargin = if cheat_margin == margin then 0 else 1 in  -- the relaxed margin is strictly looser
  -- sneaky_child improves by exactly margin-1: clears the cheat bar, FAILS the frozen bar (needs +margin).
  let sneaky_child = metric0_future + cheat_margin in
  let admSneaky = r36_admit metric0_future sneaky_child margin 1 0 1 cap head0 head0 in
  let okRejectRelax = if (r_nth admSneaky 0) == 0 then 1 else 0 in
  -- and confirm the same child WOULD have been admitted under the relaxed bar (so the relaxation is
  -- the ONLY thing that would have let it through -> the frozen bar is load-bearing):
  let admSneakyCheat = r36_admit metric0_future sneaky_child cheat_margin 1 0 1 cap head0 head0 in
  let okCheatWouldAdmit = if (r_nth admSneakyCheat 0) == 1 then 1 else 0 in

  -- ===== FALSIFIER 3a: RUNAWAY. A generation past the committed cap must be REJECTED. =====
  -- gen_child = cap+1 over a parent at gen=cap -> okCounter=0 -> reject.
  let admRunaway = r36_admit metric1_future2 (metric2 + 100) margin2 spot2 cap (cap + 1) cap head1 head1 in
  let okRejectRunaway = if (r_nth admRunaway 0) == 0 then 1 else 0 in

  -- ===== FALSIFIER 3b: REPLAY. Replaying M1's cert as M2's (child.prev != parent.head, or reusing
  -- M1's chain_head as M2's record) must be REJECTED by chain-prev. =====
  -- M2 record claiming prev = head0 (M1's prev) instead of head1 (M1's head) -> chainprev_ok=0.
  let admReplay = r36_admit metric1_future2 (metric2 + 100) margin2 spot2 1 2 cap head0 head1 in
  let okRejectReplay = if (r_nth admReplay 0) == 0 then 1 else 0 in

  -- ===== FALSIFIER 4: FORGED TRAJECTORY. A successor whose training trace was tampered (poison one
  -- interior step) must FAIL the rung-30 spot-check -> admission rejected. We run a poisoned M1. =====
  let poison_at = (n1 / 2) + 1 in
  -- to GUARANTEE the spot-check hits the poisoned step (sampling can miss; full-audit always catches),
  -- run a full-index audit of the poisoned trajectory: it MUST diverge at poison_at.
  let g0p = cons 0 (cons 0 (cons 0 (cons r30_S (cons r30_S [])))) in
  let prp = r36_run m0_genseed g0p 0 n1 1 poison_at [] in
  let leavesp = r_nth prp 1 in
  let levelsp = r30_levels leavesp in
  let rootp = r30_levels_root levelsp in
  let statesp = r36_states m0_genseed g0p 0 n1 1 poison_at [] in
  let allidx = r36_idx_list n1 0 [] in
  let vrp = r36_verify_chals m0_genseed statesp g0p levelsp rootp allidx 1 0 in
  let spotForged = r_nth vrp 1 in
  -- admission of the forged child must be rejected (spot_ok=0)
  let admForged = r36_admit metric0_future (metric1 + 100) margin spotForged 0 1 cap head0 head0 in
  let okRejectForged = if (r_nth admForged 0) == 0 then 1 else 0 in
  let okForgedSpotFails = if spotForged == 0 then 1 else 0 in

  -- ===== GATES =====
  let okGateSig = if gateSigOk == 1 then 1 else 0 in
  let okAdmit1 = if admit1 == 1 then 1 else 0 in
  let okAdmit2 = if admit2 == 1 then 1 else 0 in
  let okMonotone = if (metric1 > metric0_future) then (if metric2 > metric1_future2 then 1 else 0) else 0 in
  let okSpotChain = if spot0 == 1 then (if spot1 == 1 then (if spot2 == 1 then 1 else 0) else 0) else 0 in
  -- SUBLINEAR (rung 30): M1 trains 2x M0's steps (n1=2*n0) but its spot-check budget grows < 2x
  -- (k1 < 2*k0). Verify cost grows sublinearly while train cost doubles -> attestation survives scale.
  -- M1 trains n1/n0 = 4x M0's steps; its spot-check budget grows only ~sqrt(4)=2x (k1 ~ 2*k0).
  -- verify cost grows sublinearly (here: k1 < (n1/n0)*k0/2) while train cost grows 4x.
  let okSublinear = if (k1 * n0) < (n1 * k0) then 1 else 0 in
  let okFuture = okFutureAfterCommit in

  let all = okDevKey * okGateSig * okAdmit1 * okAdmit2 * okMonotone * okSpotChain * okSublinear * okFuture * okRejectProxy * okFrozenMargin * okRejectRelax * okCheatWouldAdmit * okRejectRunaway * okRejectReplay * okRejectForged * okForgedSpotFails in

  -- persist a machine-readable gate transcript + the signed RSI chain ledger
  let report = cat [
    "R36_RSI v1\n",
    "pubkey ", pk_hex, "\n",
    "dev_key_ok ", show okDevKey, "\n",
    "GATE np=", show np, " cap=", show cap, " margin_rule=", r36_margin_rule, " commit_pulse_id=", commit_pulse_id, " head=", gate_head, " sig_ok=", show gateSigOk, "\n",
    "future_pulse_id=", future_pulse_id, " future_after_commit=", show okFutureAfterCommit, " margin=", show margin, "\n",
    "GEN0 n=", show n0, " k=", show k0, " metric=", show metric0, " metric_future=", show metric0_future, " spot_ok=", show spot0, " head=", head0, "\n",
    "GEN1 n=", show n1, " k=", show k1, " metric_future=", show metric1, " spot_ok=", show spot1, " distinct=", show distinct1, " pct=", show pct1, " prev=", prev1, " head=", head1, "\n",
    "GEN2 n=", show n2, " k=", show k2, " metric_future2=", show metric2, " spot_ok=", show spot2, " prev=", head1, " head=", head2, "\n",
    "ADMIT1 improve=", show (r_nth adm1 1), " spot=", show (r_nth adm1 2), " counter=", show (r_nth adm1 3), " chainprev=", show (r_nth adm1 4), " admit=", show admit1, "\n",
    "ADMIT2 improve=", show (r_nth adm2 1), " spot=", show (r_nth adm2 2), " counter=", show (r_nth adm2 3), " chainprev=", show (r_nth adm2 4), " admit=", show admit2, "\n",
    "FALSIFY proxy_gaming_rejected=", show okRejectProxy, "\n",
    "FALSIFY gate_relax_rejected=", show okRejectRelax, " frozen_margin_distinct=", show okFrozenMargin, " cheat_would_admit=", show okCheatWouldAdmit, "\n",
    "FALSIFY runaway_rejected=", show okRejectRunaway, "\n",
    "FALSIFY replay_rejected=", show okRejectReplay, "\n",
    "FALSIFY forged_traj_spot_fails=", show okForgedSpotFails, " forged_admit_rejected=", show okRejectForged, "\n",
    "MONOTONE ", show okMonotone, " SPOTCHAIN ", show okSpotChain, " SUBLINEAR ", show okSublinear, "\n",
    "ALL ", show all, "\n"] in
  let _ = write_file "rungs/r36/out/r36_gate.txt" report in

  -- the signed RSI ledger (what a witness/foreign verifier re-derives): header + 3 GEN records.
  let g0sig_hex = bytes_to_hex (r_nth g0rec 9) 64 in
  let g1sig_hex = bytes_to_hex (r_nth g1rec 9) 64 in
  let g2sig_hex = bytes_to_hex (r_nth g2rec 9) 64 in
  let ledger = cat [
    "# R36v1 ", pk_hex, " ", gate_head, " np=", show np, " cap=", show cap, " margin_rule=", r36_margin_rule,
    " commit_pulse_id=", commit_pulse_id, " m0_pulse_hex=", m0_pulse_hex,
    " future_pulse_id=", future_pulse_id, " future_pulse_hex=", future_pulse_hex,
    " future_pulse_hex2=", future_pulse_hex2, " gate_sig=", gate_sig_hex, "\n",
    "GEN 0 ", show n0, " ", r_nth g0rec 2, " ", show metric0, " ", show metric0_future, " ", gate_head, " ", head0, " ", g0sig_hex, "\n",
    "GEN 1 ", show n1, " ", r_nth g1rec 2, " ", show metric1, " ", show metric0_future, " ", prev1, " ", head1, " ", g1sig_hex, "\n",
    "GEN 2 ", show n2, " ", r_nth g2rec 2, " ", show metric2, " ", show metric1_future2, " ", head1, " ", head2, " ", g2sig_hex, "\n"] in
  let _ = write_file "rungs/r36/out/r36_chain.txt" ledger in

  let _ = print "================ RUNG 36: BOUNDED RECURSIVE SELF-IMPROVEMENT (frozen, future-pulse gate) ================" in
  let _ = print (cat ["pubkey                          = ", pk_hex]) in
  let _ = print (cat ["FROZEN GATE (M0-committed)       = np=", show np, " cap=", show cap, " margin_rule=", r36_margin_rule, " sig_ok=", show gateSigOk]) in
  let _ = print (cat ["future pulse (post-commit)      = id=", future_pulse_id, " > commit ", commit_pulse_id, " (", show okFutureAfterCommit, ") -> margin=", show margin]) in
  let _ = print (cat ["GEN0 held-out metric (future)   = ", show metric0_future, " spot_ok=", show spot0]) in
  let _ = print (cat ["GEN1 held-out metric (future)   = ", show metric1, " spot_ok=", show spot1, " (", show pct1, "% steps spot-checked)"]) in
  let _ = print (cat ["GEN2 held-out metric (future2)  = ", show metric2, " spot_ok=", show spot2]) in
  let _ = print (cat ["ADMIT M1 over M0                 = ", show admit1, " (improve+spot+counter+chainprev)"]) in
  let _ = print (cat ["ADMIT M2 over M1                 = ", show admit2]) in
  let _ = print (cat ["monotone improvement holds       = ", show okMonotone]) in
  let _ = print (cat ["succinct spot-check sublinear    = ", show okSublinear]) in
  let _ = print "------ falsifiers (each MUST reject) ------" in
  let _ = print (cat ["proxy-gaming rejected            = ", show okRejectProxy, "  (lower proxy, flat holdout -> reject)"]) in
  let _ = print (cat ["gate-relaxation rejected         = ", show okRejectRelax, "  (frozen margin enforced; cheat margin != derived)"]) in
  let _ = print (cat ["runaway (> cap) rejected         = ", show okRejectRunaway]) in
  let _ = print (cat ["replay (wrong chain-prev) reject = ", show okRejectReplay]) in
  let _ = print (cat ["forged-trajectory rejected       = ", show okRejectForged, "  (rung-30 spot-check fails)"]) in
  let _ = print (cat ["signed RSI ledger                = rungs/r36/out/r36_chain.txt (GATE + 3 GEN records)"]) in
  let _ = print (cat ["gate transcript                  = rungs/r36/out/r36_gate.txt"]) in
  let _ = print (if all == 1
    then "PASS: a 3-generation chain where each admitted Mk+1 carries a certificate (rung-30 succinct spot-check of its trajectory + a held-out metric strictly beating Mk by a FUTURE-pulse-seeded margin under an M0-committed FROZEN gate + a bounded monotone counter + chain-prev), and proxy-gaming / gate-relaxation / runaway / replay / forged-trajectory successors are all rejected. Foreign re-derivation in r36_foreign_check.py."
    else "FAIL") in
  if all == 1 then 0 else 1

-- ===== helpers placed after main (defined here to keep main readable) =====
r36_idx_list n i acc = if i >= n then reverse acc else r36_idx_list n (i + 1) (cons i acc)
-- strip trailing whitespace/newline from a read_file payload (single-token files).
-- PROVEN rung-28 idiom: cut at the first whitespace char (str_find against a ws set).
r36_ws c = str_find c " \n\t"
r36_trim_go cs = if cs == [] then []
  else let c = head cs in
       if (r36_ws c) >= 0 then []
       else cons c (r36_trim_go (tail cs))
r36_trim s = cat (r36_trim_go (chars s))
-- parse a decimal-digit string to int (no leading '-'); pulse ids are non-negative integers.
-- str_find against the digit table (avoids char_to_int poly-eq quirks); stops at first non-digit.
r36_digit c = str_find c "0123456789"
r36_parse_int s = r36_parse_go (chars s) 0
-- MUTUAL RECURSION (int accumulator depends on old list head -> self-loop miscompiles).
r36_parse_go cs acc = if cs == [] then acc else r36_parse_step cs acc
r36_parse_step cs acc =
  let c = head cs in
  let d = r36_digit c in
  if d >= 0 then r36_parse_go (tail cs) (acc * 10 + d) else acc
