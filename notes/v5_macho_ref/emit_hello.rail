-- notes/v5_macho_ref/emit_hello.rail
-- v5 Phase 1: emit a runnable macOS ARM64 Mach-O in pure Rail (exit-42).

import "jit/arm64.rail"
import "stdlib/macho.rail"

n_load_cmds   = 9
sizeof_cmds   = 512
-- Leave a 480-byte headroom between end-of-load-commands (32 + 512 = 544)
-- and start-of-code (1024) so `codesign --sign -` has room to APPEND its
-- own LC_CODE_SIGNATURE entry without overwriting our code.
code_offset   = 1024
code_size     = 16
text_filesize = 16384
linkedit_off  = 16384
linkedit_size = 0
text_section_vmaddr = 4294968320    -- text_vmaddr + 1024 = 0x100000400
linkedit_vmaddr     = 4294983680    -- text_vmaddr + text_filesize = 0x100004000
macos_minos = 720896                 -- 11.0.0 packed
macos_sdk   = 720896

emit_program_code buf base =
  let _ = cb_emit buf  base       (enc_mov_imm16 16 1)
  let _ = cb_emit buf (base + 4)  (enc_mov_imm16 0 42)
  let _ = cb_emit buf (base + 8)  (enc_svc 128)
  let _ = cb_emit buf (base + 12) enc_ret
  base + 16

emit_all_cmds buf =
  let p1 = emit_mach_header buf 0 n_load_cmds sizeof_cmds mh_flags_pie_exec
  let p2 = emit_segment_64_nosects buf p1 "__PAGEZERO" 0 pagezero_vmsize 0 0 vm_prot_none vm_prot_none
  let p3 = emit_segment_64_text buf p2 text_vmaddr text_filesize 0 text_filesize text_section_vmaddr code_size code_offset 2
  let p4 = emit_segment_64_nosects buf p3 "__LINKEDIT" linkedit_vmaddr page_size linkedit_off linkedit_size vm_prot_r vm_prot_r
  let p5 = emit_symtab buf p4 linkedit_off 0 linkedit_off 0
  let p6 = emit_dysymtab_empty buf p5
  let p7 = emit_load_dylinker buf p6
  let p8 = emit_uuid buf p7
  let p9 = emit_build_version buf p8 macos_minos macos_sdk
  emit_main buf p9 code_offset 0

build_macho =
  let buf = arr_new text_filesize 0
  let r1 = emit_all_cmds buf
  let r2 = emit_program_code buf code_offset
  buf

main =
  let buf = build_macho
  let _ = macho_write_file "/tmp/v5_hello" buf text_filesize
  let _ = print "wrote /tmp/v5_hello (16384 bytes)"
  0
