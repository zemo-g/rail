-- jit/ir_b.rail
-- Session B's local copy of the IR contract. Sessions A and C will land
-- their own ir.rail; merging resolves to A's later. The naming avoids
-- collision in the meantime.
--
-- IR opcodes (frozen contract):
--   ir_const = 0   -- dst, imm, _
--   ir_add   = 1   -- dst, src1, src2
--   ir_sub   = 2   -- dst, src1, src2
--   ir_mul   = 3   -- dst, src1, src2
--   ir_lt    = 4   -- dst, src1, src2
--   ir_jmp   = 5   -- target_block_index, _, _
--   ir_jz    = 6   -- src1, target_block_index, _
--   ir_call  = 7   -- dst, fn_index, n_args
--   ir_ret   = 8   -- src1, _, _
--
-- Each instruction = 4 ints in an int_arr at indices [4*i .. 4*i+3] = [op, a, b, c].
-- Function = list [ir_arr, n_instructions, n_regs, block_offsets_arr]
--   where block_offsets_arr[k] = first instruction index of block k.

op_const = 0
op_add = 1
op_sub = 2
op_mul = 3
op_lt = 4
op_jmp = 5
op_jz = 6
op_call = 7
op_ret = 8

-- Per-instruction accessors (i is the instruction index, not the int offset).
ir_op arr i = arr_get arr (i * 4)
ir_a  arr i = arr_get arr (i * 4 + 1)
ir_b  arr i = arr_get arr (i * 4 + 2)
ir_c  arr i = arr_get arr (i * 4 + 3)

ir_set_op arr i v = arr_set arr (i * 4) v
ir_set_a  arr i v = arr_set arr (i * 4 + 1) v
ir_set_b  arr i v = arr_set arr (i * 4 + 2) v
ir_set_c  arr i v = arr_set arr (i * 4 + 3) v

-- Build a single instruction in arr at slot i.
make_ir arr i op a b c =
  let _ = arr_set arr (i * 4) op
  let _ = arr_set arr (i * 4 + 1) a
  let _ = arr_set arr (i * 4 + 2) b
  let _ = arr_set arr (i * 4 + 3) c
  0

-- Function struct accessors. fn is a list of 4 elements.
fn_ir fn = nth 0 fn
fn_ninstr fn = nth 1 fn
fn_nregs fn = nth 2 fn
fn_blocks fn = nth 3 fn

-- Local nth so this file is standalone.
nth n xs =
  if n == 0 then head xs
  else nth (n - 1) (tail xs)

-- Build a function struct.
make_fn ir n_instr n_regs blocks =
  cons ir (cons n_instr (cons n_regs (cons blocks [])))

-- Copy first `n_used` instruction slots from src into dst (n_used = #instructions).
copy_ir_slots src dst n_used i =
  if i >= n_used then 0
  else
    let _ = arr_set dst (i * 4) (arr_get src (i * 4))
    let _ = arr_set dst (i * 4 + 1) (arr_get src (i * 4 + 1))
    let _ = arr_set dst (i * 4 + 2) (arr_get src (i * 4 + 2))
    let _ = arr_set dst (i * 4 + 3) (arr_get src (i * 4 + 3))
    copy_ir_slots src dst n_used (i + 1)

-- Is this opcode a block-terminator? (jmp, jz, ret)
is_terminator op =
  if op == op_jmp then 1
  else if op == op_jz then 1
  else if op == op_ret then 1
  else 0

-- Does this opcode write to dst (field a)?
op_writes_dst op =
  if op == op_const then 1
  else if op == op_add then 1
  else if op == op_sub then 1
  else if op == op_mul then 1
  else if op == op_lt then 1
  else if op == op_call then 1
  else 0
