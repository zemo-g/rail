-- jit/test_lower.rail — end-to-end: Rail source → IR → ARM64 → JIT execute.
-- Covers the Stage-3 lowering pipeline.

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"
import "jit/lower.rail"

-- For programs that return a value via x0 (no print).
run_int label src arg expected =
  let r = lower_source src
  if (head r) == "err" then
    let _ = print (cat ["LOWER FAIL [", label, "]: ", head (tail r)])
    1
  else
    let fns = head (tail r)
    let pool = head (tail (tail r))
    let heap = heap_alloc 0
    let res = emit_program fns pool heap
    let buf = emitted_buf res
    let nbytes = emitted_size res
    let page = make_executable buf nbytes
    -- Pass heap as the JIT arg (ABI v2: x0 = heap_addr at fn entry).
    -- The user `arg` parameter is currently unused since all lower_source
    -- programs have main with n_args=0 (recursive calls handle their own args).
    let got = call_jit page heap
    let _ = free_jit page
    let _ = heap_free heap
    if got == expected then
      let _ = print (cat ["[", label, "] = ", show got, " OK (", show nbytes, "B)"])
      0
    else
      let _ = print (cat ["[", label, "] FAIL got=", show got, " expected=", show expected, " (", show nbytes, "B)"])
      1

-- For programs that PRINT via op_print_int. The driver runs the JIT
-- (which emits to stdout via syscall) and the test author manually
-- inspects the emitted line. Returns 0 on success regardless — this
-- driver only checks that lowering didn't fail and the JIT didn't crash.
run_print label src arg =
  let r = lower_source src
  if (head r) == "err" then
    let _ = print (cat ["LOWER FAIL [", label, "]: ", head (tail r)])
    1
  else
    let fns = head (tail r)
    let pool = head (tail (tail r))
    let heap = heap_alloc 0
    let res = emit_program fns pool heap
    let buf = emitted_buf res
    let nbytes = emitted_size res
    let _ = print (cat ["[", label, "] -- next line is JIT-printed:"])
    let page = make_executable buf nbytes
    let got = call_jit page heap
    let _ = free_jit page
    let _ = heap_free heap
    let _ = print (cat ["[", label, "] returned ", show got])
    0

-- Negative test: lowering should fail with a clear error.
expect_lower_fail label src =
  let r = lower_source src
  if (head r) == "err" then
    let _ = print (cat ["[", label, "] correctly rejected"])
    0
  else
    let _ = print (cat ["[", label, "] FAIL: should have rejected"])
    1

main =
  let _ = print "=== positive: int-return ==="
  let p1 = run_int "const_add"  "main = 7 + 13"                                                               0  20
  let p2 = run_int "let_form"   "main = let x = 7 + 13 in x"                                                  0  20
  let p3 = run_int "let_chain"  "main = let a = 1 + 2 in let b = a * 5 in b - 4"                              0  11
  let p4 = run_int "fact5"      "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = fact 5"               0  120
  let p5 = run_int "fact10"     "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = fact 10"              0  3628800
  let p6 = run_int "fib10"      "fib n = if n < 2 then n else (fib (n - 1)) + (fib (n - 2))\nmain = fib 10"   0  55
  let p7 = run_int "tri100"     "tri n = if n < 1 then 0 else n + tri (n - 1)\nmain = tri 100"                0  5050
  let p8 = run_int "ssq5"       "ssq n = if n < 1 then 0 else n * n + ssq (n - 1)\nmain = ssq 5"              0  55

  let _ = print "=== positive: print-show forms ==="
  let p9  = run_print "print_42"     "main = print (show 42)"                                                  0
  let p10 = run_print "print_fact5"  "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = print (show (fact 5))" 0
  let p11 = run_print "print_fib6"   "fib n = if n < 2 then n else (fib (n - 1)) + (fib (n - 2))\nmain = print (show (fib 6))" 0

  let _ = print "=== positive: string literals ==="
  let p12 = run_print "print_hello"  "main = print \"hello\""                       0
  let p13 = run_print "print_world"  "main = print \"world\\n\""                     0
  let p14 = run_print "print_caps"   "main = print \"THE QUICK BROWN FOX\""         0
  let p15 = run_print "let_str"      "main = let s = \"hello\" in print s"          0
  let p16 = run_print "let_str_chain" "main = let s = \"abc\" in let t = s in print t" 0
  let p_lbl = run_print "labeled"   "main = let _ = print \"answer = \" in print (show (5 * 9))" 0
  let p_mix = run_print "mixed_seq" "main = let _ = print \"a\" in let _ = print \"b\" in let _ = print \"c\\n\" in 0" 0
  let p_lst = run_print "print_list" "print_list xs = match xs | nil -> 0 | cons h t -> let _ = print (show h) in print_list t\nmain = print_list [10, 20, 30, 40, 50]" 0
  let p_nested = run_print "nested" "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = let _ = print \"5! = \" in print (show (fact 5))" 0

  let _ = print "=== positive: string ops ==="
  let s1 = run_int "strlen_hello" "main = str_len \"hello\""                    0  5
  let s2 = run_int "streq_eq"     "main = if str_eq \"abc\" \"abc\" then 1 else 0"   0  1
  let s3 = run_int "streq_neq"    "main = if str_eq \"ab\" \"abc\" then 1 else 0"    0  0
  let s4 = run_int "streq_diff"   "main = if str_eq \"abc\" \"abd\" then 1 else 0"   0  0
  let s5 = run_int "strat_0"      "main = str_at \"hello\" 0"  0  104
  let s6 = run_int "strat_4"      "main = str_at \"hello\" 4"  0  111

  let _ = print "=== positive: list ops ==="
  let l1 = run_int "isnil_yes"    "main = if is_nil nil then 1 else 0"          0  1
  let l2 = run_int "head_42"      "main = head [42]"                            0  42
  let l3 = run_int "head_lit"     "main = head [10, 20, 30]"                    0  10
  let l4 = run_int "head_tail"    "main = head (tail [10, 20, 30])"             0  20
  let l5 = run_int "head_tt"      "main = head (tail (tail [10, 20, 30]))"      0  30
  let l6 = run_int "list_len"     "len xs = if is_nil xs then 0 else 1 + len (tail xs)\nmain = len [1,2,3,4,5]"  0  5
  let l7 = run_int "list_sum"     "sum xs = if is_nil xs then 0 else (head xs) + (sum (tail xs))\nmain = sum [10, 20, 30]"  0  60

  let _ = print "=== positive: unary minus + bool ops ==="
  let u1 = run_int "neg_int"   "main = 0 - 5"                                                  0 (0 - 5)
  let u2 = run_int "neg_unary" "main = let x = 7 in 10 + (0 - x)"                              0 3
  let u3 = run_int "and_tt"    "main = if 1 == 1 && 2 == 2 then 1 else 0"                       0 1
  let u4 = run_int "and_tf"    "main = if 1 == 1 && 2 == 3 then 1 else 0"                       0 0
  let u5 = run_int "or_ft"     "main = if 1 == 2 || 3 == 3 then 1 else 0"                       0 1
  let u6 = run_int "or_ff"     "main = if 1 == 2 || 3 == 4 then 1 else 0"                       0 0
  let u7 = run_int "complex"   "main = if (5 > 3) && (10 <= 10) then 99 else 0"                  0 99
  let u8 = run_int "not_zero"  "main = not 0"                                                     0 1
  let u9 = run_int "not_int"   "main = not 42"                                                    0 0
  let u10 = run_int "not_chain" "main = if not (5 == 6) then 1 else 0"                             0 1

  let _ = print "=== positive: comparison + arith ops ==="
  let c1 = run_int "eq_yes"   "main = if 5 == 5 then 1 else 0"        0  1
  let c2 = run_int "eq_no"    "main = if 5 == 6 then 1 else 0"        0  0
  let c3 = run_int "gt"       "main = if 7 > 3 then 1 else 0"          0  1
  let c4 = run_int "le_yes"   "main = if 3 <= 3 then 1 else 0"         0  1
  let c5 = run_int "le_no"    "main = if 4 <= 3 then 1 else 0"         0  0
  let c6 = run_int "ge"       "main = if 3 >= 5 then 1 else 0"         0  0
  let c7 = run_int "div"      "main = 100 / 7"                         0  14
  let c8 = run_int "mod"      "main = mod 100 7"                       0  2
  let c9 = run_int "mod_div"  "main = let x = 137 in (x / 10) + (mod x 10)"  0  20

  let _ = print "=== positive: match syntax ==="
  let m1 = run_int "match_len"    "len xs = match xs | nil -> 0 | cons h t -> 1 + len t\nmain = len [1,2,3,4,5]"  0  5
  let m2 = run_int "match_sum"    "sum xs = match xs | nil -> 0 | cons h t -> h + sum t\nmain = sum [10, 20, 30]"  0  60
  let m3 = run_int "match_swap"   "len xs = match xs | cons h t -> 1 + len t | nil -> 0\nmain = len [7, 8, 9]"  0  3
  let m4 = run_int "match_max"    "imax xs = match xs | nil -> 0 | cons h t -> if (imax t) < h then h else imax t\nmain = imax [3, 7, 2, 9, 4]"  0  9

  let _ = print "=== positive: multi-arg fns ==="
  let p17 = run_int "add_2arg"  "add a b = a + b\nmain = add 7 13"                                                  0  20
  let p18 = run_int "max_2arg"  "imax a b = if a < b then b else a\nmain = imax 7 13"                                0  13
  let p19 = run_int "ack3_3arg" "muladd a b c = a * b + c\nmain = muladd 4 5 6"                                      0  26
  let p20 = run_int "two_args_with_recurse" "pow b e = if e < 1 then 1 else b * pow b (e - 1)\nmain = pow 2 10"      0  1024

  let _ = print "=== negative: should reject ==="
  let n2 = expect_lower_fail "unknown_var" "main = x + 5"
  let n3 = expect_lower_fail "unknown_fn"  "main = mystery 5"
  let n4 = expect_lower_fail "five_args"   "f a b c d e = a + b\nmain = f 1 2 3 4 5"

  let total = p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11 + p12 + p13 + p14 + p15 + p16 + p_lbl + p_mix + p_lst + p_nested + p17 + p18 + p19 + p20 + s1 + s2 + s3 + s4 + s5 + s6 + l1 + l2 + l3 + l4 + l5 + l6 + l7 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + m1 + m2 + m3 + m4 + u1 + u2 + u3 + u4 + u5 + u6 + u7 + u8 + u9 + u10 + n2 + n3 + n4
  if total == 0 then
    let _ = print "ALL LOWER PASS"
    0
  else
    let _ = print (cat ["LOWER FAILS: ", show total])
    1
