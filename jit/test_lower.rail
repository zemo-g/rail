-- jit/test_lower.rail — end-to-end: Rail source → IR → ARM64 → JIT execute.
-- Covers the Stage-3 lowering pipeline.

import "jit/emit.rail"
import "jit/loader.rail"
import "jit/lower.rail"

-- For programs that return a value via x0 (no print).
run_int label src arg expected =
  let r = lower_source src
  if (head r) == "err" then
    let _ = print (cat ["LOWER FAIL [", label, "]: ", head (tail r)])
    1
  else
    let fns = head (tail r)
    let pool = head (tail (tail r))
    let res = emit_program fns pool
    let buf = emitted_buf res
    let nbytes = emitted_size res
    let page = make_executable buf nbytes
    let got = call_jit page arg
    let _ = free_jit page
    if got == expected then
      let _ = print (cat ["[", label, "] = ", show got, " OK (", show nbytes, "B)"])
      0
    else
      let _ = print (cat ["[", label, "] FAIL got=", show got, " expected=", show expected, " (", show nbytes, "B)"])
      1

-- For programs that PRINT via op_print_int. The driver runs the JIT
-- (which emits to stdout via syscall) and the test author manually
-- inspects the emitted line. Returns 0 on success regardless — this
-- driver only checks that lowering didn't fail and the JIT didn't crash.
run_print label src arg =
  let r = lower_source src
  if (head r) == "err" then
    let _ = print (cat ["LOWER FAIL [", label, "]: ", head (tail r)])
    1
  else
    let fns = head (tail r)
    let pool = head (tail (tail r))
    let res = emit_program fns pool
    let buf = emitted_buf res
    let nbytes = emitted_size res
    let _ = print (cat ["[", label, "] -- next line is JIT-printed:"])
    let page = make_executable buf nbytes
    let got = call_jit page arg
    let _ = free_jit page
    let _ = print (cat ["[", label, "] returned ", show got])
    0

-- Negative test: lowering should fail with a clear error.
expect_lower_fail label src =
  let r = lower_source src
  if (head r) == "err" then
    let _ = print (cat ["[", label, "] correctly rejected"])
    0
  else
    let _ = print (cat ["[", label, "] FAIL: should have rejected"])
    1

main =
  let _ = print "=== positive: int-return ==="
  let p1 = run_int "const_add"  "main = 7 + 13"                                                               0  20
  let p2 = run_int "let_form"   "main = let x = 7 + 13 in x"                                                  0  20
  let p3 = run_int "let_chain"  "main = let a = 1 + 2 in let b = a * 5 in b - 4"                              0  11
  let p4 = run_int "fact5"      "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = fact 5"               0  120
  let p5 = run_int "fact10"     "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = fact 10"              0  3628800
  let p6 = run_int "fib10"      "fib n = if n < 2 then n else (fib (n - 1)) + (fib (n - 2))\nmain = fib 10"   0  55
  let p7 = run_int "tri100"     "tri n = if n < 1 then 0 else n + tri (n - 1)\nmain = tri 100"                0  5050
  let p8 = run_int "ssq5"       "ssq n = if n < 1 then 0 else n * n + ssq (n - 1)\nmain = ssq 5"              0  55

  let _ = print "=== positive: print-show forms ==="
  let p9  = run_print "print_42"     "main = print (show 42)"                                                  0
  let p10 = run_print "print_fact5"  "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = print (show (fact 5))" 0
  let p11 = run_print "print_fib6"   "fib n = if n < 2 then n else (fib (n - 1)) + (fib (n - 2))\nmain = print (show (fib 6))" 0

  let _ = print "=== positive: string literals ==="
  let p12 = run_print "print_hello"  "main = print \"hello\""                       0
  let p13 = run_print "print_world"  "main = print \"world\\n\""                     0
  let p14 = run_print "print_caps"   "main = print \"THE QUICK BROWN FOX\""         0
  let p15 = run_print "let_str"      "main = let s = \"hello\" in print s"          0
  let p16 = run_print "let_str_chain" "main = let s = \"abc\" in let t = s in print t" 0

  let _ = print "=== positive: multi-arg fns ==="
  let p17 = run_int "add_2arg"  "add a b = a + b\nmain = add 7 13"                                                  0  20
  let p18 = run_int "max_2arg"  "imax a b = if a < b then b else a\nmain = imax 7 13"                                0  13
  let p19 = run_int "ack3_3arg" "muladd a b c = a * b + c\nmain = muladd 4 5 6"                                      0  26
  let p20 = run_int "two_args_with_recurse" "pow b e = if e < 1 then 1 else b * pow b (e - 1)\nmain = pow 2 10"      0  1024

  let _ = print "=== negative: should reject ==="
  let n2 = expect_lower_fail "unknown_var" "main = x + 5"
  let n3 = expect_lower_fail "unknown_fn"  "main = mystery 5"
  let n4 = expect_lower_fail "five_args"   "f a b c d e = a + b\nmain = f 1 2 3 4 5"

  let total = p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11 + p12 + p13 + p14 + p15 + p16 + p17 + p18 + p19 + p20 + n2 + n3 + n4
  if total == 0 then
    let _ = print "ALL LOWER PASS"
    0
  else
    let _ = print (cat ["LOWER FAILS: ", show total])
    1
