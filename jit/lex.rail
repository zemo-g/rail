-- jit/lex.rail — tokenizer for the Rail subset the JIT can lower.
--
-- Tokens are 2-element Rail lists [tag, value]:
--   ["int", n]      -- integer literal
--   ["ident", "x"]  -- identifier or keyword (caller distinguishes)
--   ["op", "+"]     -- binary operator: + - * <
--   ["lparen", 0] / ["rparen", 0]
--   ["eq", 0]       -- =
--   ["nl", 0]       -- newline (significant for newline-form let)
--   ["eof", 0]
--
-- Public entry point: tokenize src -> List Token
-- Comments (`-- ...`) and runs of horizontal whitespace are skipped.

-- Token-tag helpers.
tok_tag t = head t
tok_val t = head (tail t)

mk_int n        = cons "int" (cons n [])
mk_ident s      = cons "ident" (cons s [])
mk_str s        = cons "str" (cons s [])
mk_op s         = cons "op" (cons s [])
mk_lparen _     = cons "lparen" (cons 0 [])
mk_rparen _     = cons "rparen" (cons 0 [])
mk_lbracket _   = cons "lbracket" (cons 0 [])
mk_rbracket _   = cons "rbracket" (cons 0 [])
mk_comma _      = cons "comma" (cons 0 [])
mk_pipe _       = cons "pipe" (cons 0 [])
mk_arrow _      = cons "arrow" (cons 0 [])
mk_eq _         = cons "eq" (cons 0 [])
mk_nl _         = cons "nl" (cons 0 [])
mk_eof _        = cons "eof" (cons 0 [])

-- Character predicates via `str_find` lookup against allowed-set strings.
-- Avoids deep if/else-if chains that exceed the parser's nesting tolerance.
digits_set  = "0123456789"
lower_set   = "abcdefghijklmnopqrstuvwxyz"
upper_set   = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
alpha_set   = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"
alnum_set   = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789"

is_in_set c s = if length c == 0 then 0 else if (str_find c s) >= 0 then 1 else 0

is_digit c  = is_in_set c digits_set
is_lower c  = is_in_set c lower_set
is_upper c  = is_in_set c upper_set
is_alpha c  = is_in_set c alpha_set
is_alnum c  = is_in_set c alnum_set

is_hspace c =
  if c == " " then 1
  else if c == "\t" then 1
  else 0

-- Read the character at index i, or "" if out of bounds.
char_at src i =
  let n = length src
  if i >= n then ""
  else if i < 0 then ""
  else str_sub src i 1

-- Scan a digit sequence starting at i; return its end index (exclusive).
scan_digits src i =
  if (is_digit (char_at src i)) == 1 then scan_digits src (i + 1)
  else i

-- Scan an identifier starting at i (alpha already verified at i).
scan_ident src i =
  if (is_alnum (char_at src i)) == 1 then scan_ident src (i + 1)
  else i

-- Skip horizontal whitespace from i; return new index.
skip_hspace src i =
  if (is_hspace (char_at src i)) == 1 then skip_hspace src (i + 1)
  else i

-- Skip a `-- ...` line comment starting at i (i points at the first `-`);
-- consumes through end-of-line (but not the newline itself).
skip_line_comment src i =
  let c = char_at src i
  if c == "" then i
  else if c == "\n" then i
  else skip_line_comment src (i + 1)

-- Convert a digit string to an int (no error checking; assumes all digits).
digits_to_int s =
  digits_to_int_loop s 0 (length s) 0

digits_to_int_loop s i n acc =
  if i >= n then acc
  else
    let c = str_sub s i 1
    let d = digit_val c
    digits_to_int_loop s (i + 1) n (acc * 10 + d)

digit_val c =
  if c == "0" then 0
  else if c == "1" then 1
  else if c == "2" then 2
  else if c == "3" then 3
  else if c == "4" then 4
  else if c == "5" then 5
  else if c == "6" then 6
  else if c == "7" then 7
  else if c == "8" then 8
  else 9

-- Main tokenize loop. Returns Rail list of tokens (in order, with eof).
tokenize src =
  reverse (tokenize_loop src 0 [])

tokenize_loop src i acc =
  let i2 = skip_hspace src i
  let c = char_at src i2
  if c == "" then cons (mk_eof 0) acc
  else if c == "\n" then tokenize_loop src (i2 + 1) (cons (mk_nl 0) acc)
  else if c == "-" then tokenize_dash src i2 acc
  else if c == "\"" then tokenize_string src (i2 + 1) "" acc
  else if (is_digit c) == 1 then tokenize_int src i2 acc
  else if (is_alpha c) == 1 then tokenize_ident src i2 acc
  else tokenize_punct src i2 c acc

-- After consuming opening `"`, scan to closing `"`, decoding escapes.
tokenize_string src i acc_str outer_acc =
  let c = char_at src i
  if c == "" then cons (mk_eof 0) outer_acc
  else if c == "\"" then tokenize_loop src (i + 1) (cons (mk_str acc_str) outer_acc)
  else if c == "\\" then tokenize_string_escape src (i + 1) acc_str outer_acc
  else tokenize_string src (i + 1) (cat [acc_str, c]) outer_acc

tokenize_string_escape src i acc_str outer_acc =
  let c = char_at src i
  if c == "" then cons (mk_eof 0) outer_acc
  else if c == "n" then tokenize_string src (i + 1) (cat [acc_str, "\n"]) outer_acc
  else if c == "t" then tokenize_string src (i + 1) (cat [acc_str, "\t"]) outer_acc
  else if c == "\\" then tokenize_string src (i + 1) (cat [acc_str, "\\"]) outer_acc
  else if c == "\"" then tokenize_string src (i + 1) (cat [acc_str, "\""]) outer_acc
  else tokenize_string src (i + 1) (cat [acc_str, c]) outer_acc

tokenize_int src i acc =
  let j = scan_digits src i
  let n = digits_to_int (str_sub src i (j - i))
  tokenize_loop src j (cons (mk_int n) acc)

tokenize_ident src i acc =
  let j = scan_ident src i
  let s = str_sub src i (j - i)
  tokenize_loop src j (cons (mk_ident s) acc)

-- Single/multi-char punctuation dispatch.
-- Multi-char: `==`, `<=`, `>=` (peek next char for `=`).
tokenize_punct src i c acc =
  if c == "+" then tokenize_loop src (i + 1) (cons (mk_op "+") acc)
  else if c == "*" then tokenize_loop src (i + 1) (cons (mk_op "*") acc)
  else if c == "/" then tokenize_loop src (i + 1) (cons (mk_op "/") acc)
  else if c == "&" then tokenize_punct_amp src i acc
  else if c == "|" then tokenize_punct_pipe_or_bar src i acc
  else if c == "<" then tokenize_punct_lt src i acc
  else if c == ">" then tokenize_punct_gt src i acc
  else if c == "=" then tokenize_punct_eq src i acc
  else if c == "(" then tokenize_loop src (i + 1) (cons (mk_lparen 0) acc)
  else if c == ")" then tokenize_loop src (i + 1) (cons (mk_rparen 0) acc)
  else if c == "[" then tokenize_loop src (i + 1) (cons (mk_lbracket 0) acc)
  else if c == "]" then tokenize_loop src (i + 1) (cons (mk_rbracket 0) acc)
  else if c == "," then tokenize_loop src (i + 1) (cons (mk_comma 0) acc)
  else tokenize_loop src (i + 1) (cons (mk_op c) acc)

tokenize_punct_lt src i acc =
  if (char_at src (i + 1)) == "=" then tokenize_loop src (i + 2) (cons (mk_op "<=") acc)
  else tokenize_loop src (i + 1) (cons (mk_op "<") acc)

tokenize_punct_gt src i acc =
  if (char_at src (i + 1)) == "=" then tokenize_loop src (i + 2) (cons (mk_op ">=") acc)
  else tokenize_loop src (i + 1) (cons (mk_op ">") acc)

tokenize_punct_eq src i acc =
  if (char_at src (i + 1)) == "=" then tokenize_loop src (i + 2) (cons (mk_op "==") acc)
  else tokenize_loop src (i + 1) (cons (mk_eq 0) acc)

tokenize_punct_amp src i acc =
  if (char_at src (i + 1)) == "&" then tokenize_loop src (i + 2) (cons (mk_op "&&") acc)
  else tokenize_loop src (i + 1) (cons (mk_op "&") acc)

-- `||` is the boolean-or operator; single `|` is the match-branch separator.
tokenize_punct_pipe_or_bar src i acc =
  if (char_at src (i + 1)) == "|" then tokenize_loop src (i + 2) (cons (mk_op "||") acc)
  else tokenize_loop src (i + 1) (cons (mk_pipe 0) acc)

-- Handle leading dash: comment (--), arrow (->), or minus operator.
tokenize_dash src i acc =
  let c2 = char_at src (i + 1)
  if c2 == "-" then
    let j = skip_line_comment src (i + 2)
    tokenize_loop src j acc
  else if c2 == ">" then
    tokenize_loop src (i + 2) (cons (mk_arrow 0) acc)
  else
    tokenize_loop src (i + 1) (cons (mk_op "-") acc)
