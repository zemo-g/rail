-- jit/test_capture.rail — verify P0/P1 output-capture pipeline end-to-end.
--
-- Each fixture: lower a Rail source string, run via JIT, read back the
-- captured stdout from the heap output buffer, compare to expected.
-- Drives `try_jit_grade_str` (the public training-session entry point).

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"
import "jit/lower.rail"
import "jit/grade.rail"

run_case label src expected =
  let r = try_jit_grade_str src expected
  if (head r) == "err" then
    let _ = print (cat ["[", label, "] ERR: ", head (tail r)])
    1
  else if (head r) == "jit_pass" then
    let _ = print (cat ["[", label, "] OK captured=\"", expected, "\""])
    0
  else
    let _ = print (cat ["[", label, "] FAIL got=\"", head (tail r), "\" expected=\"", expected, "\""])
    1

main =
  -- Pre-create fixture files for the read_file cases (P5).
  let _ = write_file "/tmp/jit_capture_hello.txt" "hello\n"
  let _ = write_file "/tmp/jit_capture_count.txt" "12345"
  let _ = print "=== output-capture grade ==="
  -- Bare integer printing.
  let r1 = run_case "print_42"      "main = print (show 42)"                                                                  "42\n"
  let r2 = run_case "print_0"       "main = print (show 0)"                                                                    "0\n"
  let r3 = run_case "print_neg"     "main = print (show (0 - 5))"                                                              "-5\n"
  let r4 = run_case "print_big"     "main = print (show 12345)"                                                                "12345\n"
  -- Computed integer expressions.
  let r5 = run_case "print_fact5"   "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = print (show (fact 5))"             "120\n"
  let r6 = run_case "print_fact10"  "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = print (show (fact 10))"            "3628800\n"
  let r7 = run_case "print_pow"     "pow b e = if e < 1 then 1 else b * pow b (e - 1)\nmain = print (show (pow 2 10))"         "1024\n"
  -- Plain string literal.
  let r8 = run_case "print_hello"   "main = print \"hello\\n\""                                                                "hello\n"
  -- Sequencing two prints.
  let r9 = run_case "labeled"       "main = let _ = print \"answer = \" in print (show (5 * 9))"                                "answer = 45\n"
  -- Print sequence.
  let r10 = run_case "abc"          "main = let _ = print \"a\" in let _ = print \"b\" in print \"c\\n\""                       "abc\n"
  -- File I/O via read_file (P5).
  let r12 = run_case "readfile"      "main = print (read_file \"/tmp/jit_capture_hello.txt\")"                                  "hello\n"
  let r13 = run_case "readfile_len"  "main = print (show (str_len (read_file \"/tmp/jit_capture_count.txt\")))"                 "5\n"
  let r14 = run_case "readfile_let"  "main = let s = read_file \"/tmp/jit_capture_hello.txt\" in print s"                       "hello\n"

  -- HOF (P3-variant).
  let r15 = run_case "hof_print"     "double x = x * 2\napply f x = f x\nmain = print (show (apply double 21))"                  "42\n"

  -- P4 float-print fixtures. Output is %g format (snprintf default).
  let f1 = run_case "f_const"       "main = print (show 3.14)"                          "3.14\n"
  let f2 = run_case "f_mul"         "main = print (show (3.14 * 2.0))"                  "6.28\n"
  let f3 = run_case "f_div"         "main = print (show (10.0 / 4.0))"                  "2.5\n"
  let f4 = run_case "f_sub"         "main = print (show (5.0 - 0.25))"                  "4.75\n"
  let f5 = run_case "f_promote"     "main = print (show (3 + 1.5))"                     "4.5\n"
  let f6 = run_case "f_zero"        "main = print (show 0.0)"                            "0\n"
  let f7 = run_case "f_neg"         "main = print (show (0.0 - 3.5))"                    "-3.5\n"
  let f8 = run_case "f_int_format"  "main = print (show 42.0)"                          "42\n"
  -- P4-ext fixtures (cross-call preservation, float-returning user fn).
  let f9 = run_case "f_x_call"      "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = print (show (1.5 * (fact 4)))"  "36\n"
  let f10 = run_case "f_user_fret"  "scale n = int_to_float n * 1.5\nmain = print (show (scale 10))"                          "15\n"
  let f11 = run_case "f_two_calls"  "scale n = int_to_float n * 1.5\nmain = print (show (scale 4 + scale 6))"                  "15\n"

  -- P4-arg fixtures: float user-fn args. DONE CRITERION = fa1 (area r * 5).
  let fa1 = run_case "fa_area"      "area r = 3.14 * r * r\nmain = print (show (area 5.0))"                                     "78.5\n"
  let fa2 = run_case "fa_square"    "square r = r * r\nmain = print (show (square 7.0))"                                        "49\n"
  let fa3 = run_case "fa_int_flt"   "scaled n r = int_to_float n * r\nmain = print (show (scaled 4 2.5))"                       "10\n"
  let fa4 = run_case "fa_flt_int"   "combine r n = r * int_to_float n\nmain = print (show (combine 2.5 4))"                     "10\n"
  let fa5 = run_case "fa_add2"      "add2 a b = a + b\nmain = print (show (add2 1.5 2.5))"                                       "4\n"
  let fa6 = run_case "fa_pow"       "pow b e = if e < 1.0 then 1.0 else b * pow b (e - 1.0)\nmain = print (show (pow 2.0 3.0))" "8\n"

  -- v2-A fixtures: 0-arg user fn calls (`pi = 3.14; print pi`).
  let z1 = run_case "z_pi_flt"      "pi = 3.14\nmain = print (show pi)"                                                          "3.14\n"
  let z2 = run_case "z_count_int"   "count = 42\nmain = print (show count)"                                                       "42\n"
  let z3 = run_case "z_let_alias"   "pi = 3.14\nmain = let x = pi in print (show x)"                                              "3.14\n"
  let z4 = run_case "z_use_in_op"   "two = 2.0\nmain = print (show (two * 3.0))"                                                  "6\n"
  let z5 = run_case "z_chain"       "a = 7\nb = a\nmain = print (show b)"                                                         "7\n"
  let z6 = run_case "z_arg_to_fn"   "pi = 3.14\nscale r = pi * r\nmain = print (show (scale 2.0))"                                "6.28\n"

  -- v2-B fixtures: more than 2 float callee-save slots (cap was 2 → 8).
  -- 3 float args all used after a call: requires 3 callee-save slots (would
  -- fail in v1's f8/f9 cap).
  let m1 = run_case "m_3_floats"    "square x = x * x\ncombine a b c = (square 2.0) + a + b + c\nmain = print (show (combine 1.0 0.5 0.25))" "5.75\n"
  -- 4 float args all used after a call → 4 callee-save slots.
  let m2 = run_case "m_4_floats"    "square x = x * x\ncombine a b c d = (square 2.0) + a + b + c + d\nmain = print (show (combine 1.0 0.5 0.25 0.125))" "5.875\n"
  -- Two-call sequence: each call clobbers d0..d7. Args must survive both.
  let m3 = run_case "m_two_calls"   "id x = x\ncombine a b c = (id 1.0) + a + (id 2.0) + b + c\nmain = print (show (combine 0.1 0.2 0.3))" "3.6\n"

  -- Negative grade (mismatched expected).
  let r11_inner = try_jit_grade_str "main = print (show 42)" "wrong"
  let r11 = if (head r11_inner) == "jit_fail" && (head (tail r11_inner)) == "42\n" then
    let _ = print "[mismatch] OK negative"
    0
  else
    let _ = print (cat ["[mismatch] FAIL: ", head r11_inner, " ", head (tail r11_inner)])
    1

  let total = r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + r11 + r12 + r13 + r14 + r15 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + fa1 + fa2 + fa3 + fa4 + fa5 + fa6 + z1 + z2 + z3 + z4 + z5 + z6 + m1 + m2 + m3
  if total == 0 then
    let _ = print "ALL CAPTURE PASS"
    0
  else
    let _ = print (cat ["CAPTURE FAILS: ", show total])
    1
