-- jit/test_lower_silent.rail — falsification test for Bug B.
--
-- lower_source must NOT print "LOWER ERR: ..." to stdout when it fails to
-- lower a program. The error should be retrievable only via the ["err",
-- reason] return tuple, so programmatic callers (e.g. bench-grade,
-- training rollouts) don't have to scrub the diagnostic out of stdout.
--
-- Before the fix, st_fail and mk_err_fn both printed "LOWER ERR: <msg>"
-- to stdout. The bench-grade harness had to filter for it.

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"
import "jit/lower.rail"

-- A program guaranteed to fail lowering: references an unbound variable.
bad_src _ = "main = x + 5"

-- Check 1: the err message comes back in the tuple, not via stdout.
-- We can't directly capture our own stdout in pure Rail, so we use a
-- sub-process strategy: write a tiny driver to a tmp file, compile it
-- with rail_native, run it redirecting stdout to a file, and grep.
driver_src _ =
  cat [
    "import \"jit/heap.rail\"\n",
    "import \"jit/emit.rail\"\n",
    "import \"jit/loader.rail\"\n",
    "import \"jit/lower.rail\"\n",
    "main =\n",
    "  let r = lower_source \"main = x + 5\"\n",
    "  let _ = print (cat [\"tag=\", head r])\n",
    "  0\n"
  ]

main =
  let _ = print "=== Bug B: lower_source must be silent on error ==="

  -- Path A: direct in-process check — call lower_source and verify the
  -- tuple shape.
  let r = lower_source "main = x + 5"
  let in_proc_ok =
    if (head r) == "err" then
      let msg = head (tail r)
      if msg == "" then 0
      else if msg == "lower failed (see prior LOWER ERR)" then 0
      else 1
    else 0
  let _ = if in_proc_ok == 1 then
            print (cat ["  in_proc: err tuple carries real msg = \"", head (tail r), "\" OK"])
          else
            print (cat ["  FAIL in_proc: bad err shape, msg=\"", head (tail r), "\""])

  -- Path B: sub-process check — capture FULL stdout to a file and grep
  -- for "LOWER ERR" (the polluting prefix).
  let _ = write_file "/tmp/jit_silent_driver.rail" (driver_src 0)
  let _ = shell "./rail_native run /tmp/jit_silent_driver.rail > /tmp/jit_silent_out.txt 2>&1"
  let captured = read_file "/tmp/jit_silent_out.txt"
  let polluted = str_contains "LOWER ERR" captured
  let sub_proc_ok = if polluted == 1 then 0 else 1
  let _ = if sub_proc_ok == 1 then
            print "  sub_proc: stdout free of \"LOWER ERR\" OK"
          else
            let _ = print "  FAIL sub_proc: captured stdout contains \"LOWER ERR\":"
            print (cat ["    ", captured])

  -- Also: ensure the err tuple still carries something useful (NOT empty
  -- and NOT just the boilerplate fallback).
  let msg_ok =
    if (head r) != "err" then 0
    else
      let m = head (tail r)
      if str_contains "unbound variable" m then 1 else 0
  let _ = if msg_ok == 1 then
            print "  msg_content: err message identifies root cause OK"
          else
            print (cat ["  FAIL msg_content: msg=\"", head (tail r), "\" should mention 'unbound variable'"])

  let total = in_proc_ok + sub_proc_ok + msg_ok
  if total == 3 then
    let _ = print "PASS"
    0
  else
    let _ = print (cat ["FAILS: ", show (3 - total), "/3"])
    1
