-- jit/profile.rail
-- Inline-cache counters for runtime feedback.
--
-- Intended use: one counter per call site / loop header. The JIT seeds an
-- int_arr at translation time and the interpreter bumps the matching slot
-- on every dispatch. When `is_hot` returns 1, the orchestrator triggers
-- the next-tier compilation step.

make_counters n =
  arr_new n 0

bump_counter arr i =
  let v = arr_get arr i
  let _ = arr_set arr i (v + 1)
  v + 1

is_hot arr i threshold =
  if arr_get arr i >= threshold then 1
  else 0

read_counter arr i =
  arr_get arr i

reset_counter arr i =
  let _ = arr_set arr i 0
  0
