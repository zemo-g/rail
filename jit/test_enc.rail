-- Minimal sanity check: encoder outputs match `as`.
import "jit/arm64.rail"

check label expected got =
  if expected == got then
    let _ = print (cat [label, ": OK"])
    0
  else
    let _ = print (cat [label, ": FAIL exp=", show expected, " got=", show got])
    1

main =
  -- Bytes verified from /tmp/asmtest.o disassembly.
  let f1 = check "mov_reg9_0"  2852127721 (enc_mov_reg 9 0)
  let f2 = check "mov_imm10_5" 3531604138 (enc_mov_imm16 10 5)
  let f3 = check "add"         2332688683 (enc_add 11 9 10)
  let f4 = check "mov0_11"     2852848608 (enc_mov_reg 0 11)
  let f5 = check "sub"         3406365036 (enc_sub 12 11 9)
  let f6 = check "mul"         2601155885 (enc_mul 13 9 10)
  let f7 = check "cmp"         3943301439 (enc_cmp 9 10)
  let f8 = check "cset_lt"     2594154478 (enc_cset_lt 14)
  let f9 = check "cbz_byte8"   3019898953 (enc_cbz_byte_off 9 8)
  let f10 = check "b_byte4"    335544321 (enc_b_byte_off 4)
  let f11 = check "ret"        3596551104 enc_ret
  let f12 = check "bl_off12"    2483027971 (enc_bl_byte_off 12)
  let f13 = check "stp_fp_lr32"  2847833085 inst_stp_fp_lr_pre
  let f14 = check "mov_x29_sp"   2432697341 inst_mov_x29_sp
  let f15 = check "stp_x19_20"   2835436531 inst_stp_x19_x20_16
  let f16 = check "ldp_x19_20"   2839630835 inst_ldp_x19_x20_16
  let f17 = check "ldp_fp_lr32"  2831318013 inst_ldp_fp_lr_post
  let total = f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12 + f13 + f14 + f15 + f16 + f17
  if total == 0 then
    let _ = print "ENC OK"
    0
  else
    let _ = print (cat ["ENC FAIL: ", show total])
    1
