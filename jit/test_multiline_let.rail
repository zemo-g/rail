-- jit/test_multiline_let.rail — falsification test for Bug A.
--
-- The newline-form let (`main =\n  let _ = ... \n  body`) is the canonical
-- Rail idiom and must lower + execute through the JIT identically to the
-- explicit `let ... in ...` form. Before the fix, parse_fn_body invoked
-- parse_expr directly on the post-`=` token stream — whose leading token
-- is `nl` after a newline body — and bailed with "primary: unexpected
-- token tag=nl". This test exercises 5 multi-line shapes.

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"
import "jit/lower.rail"

-- Lower + run; return 0 on success matching `expected`, 1 on failure.
run_int label src expected =
  let r = lower_source src
  if (head r) == "err" then
    let _ = print (cat ["FAIL [", label, "]: did not lower: ", head (tail r)])
    1
  else
    let fns = head (tail r)
    let pool = head (tail (tail r))
    let heap = heap_alloc 0
    let res = emit_program fns pool heap
    let buf = emitted_buf res
    let nbytes = emitted_size res
    let page = make_executable buf nbytes
    let got = call_jit page heap
    let _ = free_jit page
    let _ = heap_free heap
    if got == expected then
      let _ = print (cat ["[", label, "] = ", show got, " OK"])
      0
    else
      let _ = print (cat ["FAIL [", label, "] got=", show got, " expected=", show expected])
      1

main =
  let _ = print "=== multiline-let shapes ==="

  -- Shape 1: body starts on next line, no let — just a bare int.
  let t1 = run_int "bare_nl_body" "main =\n  42" 42

  -- Shape 2: classic newline-form let with a single binding.
  let t2 = run_int "single_let_nl" "main =\n  let x = 7\n  x + 3" 10

  -- Shape 3: two chained newline-form lets.
  let t3 = run_int "two_lets_nl" "main =\n  let a = 1\n  let b = 2\n  a + b" 3

  -- Shape 4: print + bare int via newline-form let.
  let t4 = run_int "print_then_int" "main =\n  let _ = print 0\n  99" 99

  -- Shape 5: mix of explicit `in` and newline forms in the same fn.
  let t5 = run_int "mixed_in_nl" "main =\n  let x = let y = 4 in y + 1\n  x * 2" 10

  let total = t1 + t2 + t3 + t4 + t5
  if total == 0 then
    let _ = print "PASS"
    0
  else
    let _ = print (cat ["FAILS: ", show total])
    1
