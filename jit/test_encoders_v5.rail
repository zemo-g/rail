-- jit/test_encoders_v5.rail — verify v5 Phase 5 new encoders byte-for-byte.

import "jit/arm64.rail"

-- Hand-paired Rail encoding vs ground-truth hex from `as` + objdump.
fixtures =
  [ (enc_ldrb_imm   0 1 0,    "39400020"),
    (enc_ldrb_imm   0 1 1,    "39400420"),
    (enc_ldrb_imm   0 1 4095, "397ffc20"),
    (enc_ldrb_regoff 0 1 2,   "38626820"),
    (enc_ldrb_postidx 0 1 1,  "38401420"),
    (enc_strb_imm   0 1 0,    "39000020"),
    (enc_strb_imm   0 1 1,    "39000420"),
    (enc_strb_regoff 0 1 2,   "38226820"),
    (enc_strb_postidx 0 1 1,  "38001420"),
    (enc_clz        3 4,      "dac01083"),
    (enc_neg        0 1,      "cb0103e0"),
    (enc_cmn_imm    0 4095,   "b13ffc1f"),
    (enc_cmn_reg    0 1,      "ab01001f"),
    (enc_rev        0 1,      "dac00c20"),
    (enc_rev16      0 1,      "5ac00420"),
    (enc_fneg       0 1,      "1e614020"),
    (enc_frinta     2 3,      "1e664062"),
    (enc_fcvt_s_d   0 1,      "1e624020"),
    (enc_fcvt_d_s   0 1,      "1e22c020"),
    (enc_tbnz_byte_off 1 63 36,  "b7f80121"),
    (enc_tbnz_byte_off 2 0  32,  "37000102"),
    (enc_stp_preidx  29 30 31 (0 - 32), "a9be7bfd"),
    (enc_ldp_postidx 29 30 31 32,       "a8c27bfd"),
    (enc_stp_preidx  29 30 31 (0 - 16), "a9bf7bfd"),
    (enc_ldp_postidx 29 30 31 16,       "a8c17bfd"),
    (enc_add_imm     0 1 0,    "91000020"),
    (enc_add_imm     0 1 1,    "91000420"),
    (enc_add_imm     0 1 4095, "913ffc20") ]

-- Hex-string parser: "39400020" -> 0x39400020
parse_hex s = parse_hex_acc (chars s) 0
parse_hex_acc cs acc =
  if cs == [] then acc
  else
    let c = char_to_int (head cs)
    if c >= 48 && c <= 57 then parse_hex_acc (tail cs) (acc * 16 + (c - 48))
    else if c >= 97 && c <= 102 then parse_hex_acc (tail cs) (acc * 16 + (c - 87))
    else if c >= 65 && c <= 70 then parse_hex_acc (tail cs) (acc * 16 + (c - 55))
    else acc

verify pairs i fails =
  if pairs == [] then fails
  else
    let p = head pairs
    let (got, want_hex) = p
    let want = parse_hex want_hex
    if got == want then verify (tail pairs) (i + 1) fails
    else
      let _ = print (cat ["MISMATCH @", show i, ": got=", show got, " want=", show want, " (hex ", want_hex, ")"])
      verify (tail pairs) (i + 1) (fails + 1)

main =
  let fails = verify fixtures 0 0
  let n = length fixtures
  if fails == 0 then
    let _ = print (cat ["PASS: ", show n, "/", show n, " v5 encoders match"])
    0
  else
    let _ = print (cat ["FAIL: ", show fails, "/", show n, " mismatched"])
    1
