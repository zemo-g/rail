-- jit/arm64.rail — ARM64 instruction encoder.
-- Each function returns a 32-bit ARM64 instruction word as a Rail int.
-- Encodings verified against `as` + `objdump -d` (see test_codegen.rail).

-- mov xD, xS   (alias of orr xD, xzr, xS)
-- Base: 0xAA0003E0 | (S << 16) | D
enc_mov_reg dst src =
  bit_or 2852127712 (bit_or (shl src 16) dst)

-- movz xD, #imm16            (mov xD, #imm)
-- Base: 0xD2800000 | (imm << 5) | D
enc_mov_imm16 dst imm =
  bit_or 3531603968 (bit_or (shl (bit_and imm 65535) 5) dst)

-- movk xD, #imm16, lsl #(N*16)   N in {0,1,2,3}
-- Base: 0xF2800000 | (N << 21) | (imm << 5) | D
enc_movk dst imm shift_n =
  bit_or 4068474880 (bit_or (shl shift_n 21) (bit_or (shl (bit_and imm 65535) 5) dst))

-- add xD, xA, xB    Base: 0x8B000000 | (B << 16) | (A << 5) | D
enc_add dst a b =
  bit_or 2332033024 (bit_or (shl b 16) (bit_or (shl a 5) dst))

-- sub xD, xA, xB    Base: 0xCB000000 | (B << 16) | (A << 5) | D
enc_sub dst a b =
  bit_or 3405774848 (bit_or (shl b 16) (bit_or (shl a 5) dst))

-- mul xD, xA, xB    (madd xD, xA, xB, xzr)
-- Base: 0x9B007C00 | (B << 16) | (A << 5) | D
enc_mul dst a b =
  bit_or 2600500224 (bit_or (shl b 16) (bit_or (shl a 5) dst))

-- cmp xA, xB        (subs xzr, xA, xB)
-- Base: 0xEB00001F | (B << 16) | (A << 5)
enc_cmp a b =
  bit_or 3942645791 (bit_or (shl b 16) (shl a 5))

-- cset xD, lt       Base: 0x9A9FA7E0 | D
enc_cset_lt dst =
  bit_or 2594154464 dst

-- cset xD, eq       Base: 0x9A9F17E0 | D  (csinc with cond=ne to invert)
enc_cset_eq dst = bit_or 2594117600 dst
-- cset xD, gt       Base: 0x9A9FD7E0 | D  (cond=le)
enc_cset_gt dst = bit_or 2594166752 dst
-- cset xD, le       Base: 0x9A9FC7E0 | D  (cond=gt)
enc_cset_le dst = bit_or 2594162656 dst
-- cset xD, ge       Base: 0x9A9FB7E0 | D  (cond=lt)
enc_cset_ge dst = bit_or 2594158560 dst

-- udiv xD, xA, xB    Base: 0x9AC00800 | (B<<16) | (A<<5) | D
enc_udiv dst a b = bit_or (bit_or (bit_or 2596276224 (shl b 16)) (shl a 5)) dst

-- msub xD, xN, xM, xA  Base: 0x9B008000 | (M<<16) | (A<<10) | (N<<5) | D
enc_msub dst n m a =
  bit_or (bit_or (bit_or (bit_or 2600501248 (shl m 16)) (shl a 10)) (shl n 5)) dst

-- cbz xR, #offset_in_instructions     (offset shifted left 2 to bytes by HW)
-- We accept the byte offset, divide by 4 inside.
-- Base: 0xB4000000 | ((off19 & 0x7FFFF) << 5) | R
-- off19 is the instruction offset (signed 19 bits).
enc_cbz_byte_off reg byte_off =
  let inst_off = byte_off / 4
  let masked = bit_and inst_off 524287
  bit_or 3019898880 (bit_or (shl masked 5) reg)

-- b #offset (byte_off must be multiple of 4)
-- Base: 0x14000000 | (off26 & 0x3FFFFFF)
enc_b_byte_off byte_off =
  let inst_off = byte_off / 4
  let masked = bit_and inst_off 67108863
  bit_or 335544320 masked

-- ret    Base: 0xD65F03C0
enc_ret = 3596551104

-- bl #offset    (offset must be multiple of 4; signed 26-bit instr offset)
-- Base: 0x94000000 | ((byte_off >> 2) & 0x3FFFFFF)
-- Same field layout as `b` but with bit 31 set (link).
enc_bl_byte_off byte_off =
  let inst_off = byte_off / 4
  let masked = bit_and inst_off 67108863
  bit_or 2483027968 masked

-- adr xD, #byte_off    PC-relative byte address into xD (signed 21-bit range).
-- Encoding: 0x10000000 | (immlo<<29) | (immhi<<5) | Rd
--   immlo = byte_off & 3        (low 2 bits)
--   immhi = (byte_off >> 2) & 0x7FFFF   (high 19 bits)
enc_adr dst byte_off =
  let imm21 = bit_and byte_off 2097151
  let immlo = bit_and imm21 3
  let immhi = bit_and (shr imm21 2) 524287
  bit_or 268435456 (bit_or (shl immlo 29) (bit_or (shl immhi 5) dst))

-- cmp xN, #imm12   (alias of `subs xzr, xN, #imm`, 64-bit, no shift)
-- Base: 0xF100001F | (imm12 << 10) | (N << 5)
-- NOTE: prior base 4043309343 (0xF100011F) had stray bit 8 set, corrupting
-- Rn whenever bit 3 of reg was 0 (regs 0..7, 16..23). Manifested as
-- chained-op_apply-over-let-bound-fn-ref returning 0 (cmp x19 → cmp x27).
enc_cmp_imm reg imm12 =
  bit_or 4043309087 (bit_or (shl (bit_and imm12 4095) 10) (shl reg 5))

-- b.ne #(byte_off)    Conditional branch (NE = cond 0x1).
-- Base: 0x54000001 | (imm19 << 5)  where imm19 = byte_off / 4 (signed 19-bit).
enc_bne_byte_off byte_off =
  let inst_off = byte_off / 4
  let masked = bit_and inst_off 524287
  bit_or 1409286145 (shl masked 5)

-- ============================================================================
-- Float (d-register) encoders. Verified via /tmp/asmfloat.s + as + otool.
-- All take 0..15 d-reg numbers in v1.
-- ============================================================================

-- fadd d_dst, d_lhs, d_rhs   Base: 0x1E602800 | dst | (lhs<<5) | (rhs<<16)
enc_fadd dst lhs rhs =
  bit_or 509618176 (bit_or dst (bit_or (shl lhs 5) (shl rhs 16)))

-- fsub d_dst, d_lhs, d_rhs   Base: 0x1E603800
enc_fsub dst lhs rhs =
  bit_or 509622272 (bit_or dst (bit_or (shl lhs 5) (shl rhs 16)))

-- fmul d_dst, d_lhs, d_rhs   Base: 0x1E600800
enc_fmul dst lhs rhs =
  bit_or 509609984 (bit_or dst (bit_or (shl lhs 5) (shl rhs 16)))

-- fdiv d_dst, d_lhs, d_rhs   Base: 0x1E601800
enc_fdiv dst lhs rhs =
  bit_or 509614080 (bit_or dst (bit_or (shl lhs 5) (shl rhs 16)))

-- fcmp d_lhs, d_rhs   Base: 0x1E602000 | (lhs<<5) | (rhs<<16)
enc_fcmp lhs rhs =
  bit_or 509616128 (bit_or (shl lhs 5) (shl rhs 16))

-- scvtf d_dst, x_src    (signed-int -> double)   Base: 0x9E620000 | dst | (src<<5)
enc_scvtf dst src =
  bit_or 2657222656 (bit_or dst (shl src 5))

-- fcvtzs x_dst, d_src   (double -> signed-int truncated)   Base: 0x9E780000
enc_fcvtzs dst src =
  bit_or 2658664448 (bit_or dst (shl src 5))

-- fmov d_dst, x_src     (bit-cast int -> double)   Base: 0x9E670000
enc_fmov_d_x dst src =
  bit_or 2657550336 (bit_or dst (shl src 5))

-- fmov d_dst, d_src     (double-to-double copy)   Base: 0x1E604000
enc_fmov_d_d dst src =
  bit_or 509624320 (bit_or dst (shl src 5))

-- cset x_dst, mi   (after fcmp: 1 if lhs<rhs ordered, NaN-safe)   Base: 0x9A9F57E0
enc_cset_mi dst = bit_or 2594133984 dst

-- cset x_dst, ls   (after fcmp: 1 if lhs<=rhs ordered, NaN-safe)  Base: 0x9A9F87E0
-- Used for op_fle. (`le` would also fire on unordered, so use `ls` instead.)
enc_cset_ls dst = bit_or 2594146272 dst

-- ldr xD, [x27, #imm]   imm must be 8-byte multiple in [0, 32760].
-- Base: 0xF9400360 | ((imm/8)<<10) | dst    (the 0x360 bakes Rn=27 into bits 5..9)
enc_ldr_x27 dst imm =
  bit_or 4181721952 (bit_or dst (shl (imm / 8) 10))

-- str xD, [x27, #imm]   imm must be 8-byte multiple.
-- Base: 0xF9000360 | ((imm/8)<<10) | dst
enc_str_x27 dst imm =
  bit_or 4177527648 (bit_or dst (shl (imm / 8) 10))

-- blr xR     Base: 0xD63F0000 | (R<<5)
enc_blr reg =
  bit_or 3594452992 (shl reg 5)

-- Function-frame fixed instructions (FP=x29, LR=x30, SP=x31).
-- 64-byte frame (post-P4-extension): 16 FP/LR, 16 x19/x20, 16 x27+pad,
--                                    16 d8/d9 (float callee-save).
-- (x27 is the heap_addr under ABI v2; saved/restored to preserve it across calls.
--  d8/d9 added in P4-extension to support cross-call float preservation.)
-- stp x29, x30, [sp, #-64]!     : 0xA9BC7BFD
-- mov x29, sp  (add x29, sp, #0): 0x910003FD
-- stp x19, x20, [sp, #16]       : 0xA90153F3
-- str x27, [sp, #32]            : 0xF90013FB   -- save caller's x27 (= heap chain)
-- stp d8, d9, [sp, #48]         : 0x6D0327E8   -- save callee-save floats (P4-ext)
-- ldp d8, d9, [sp, #48]         : 0x6D4327E8   -- restore on exit
-- ldr x27, [sp, #32]            : 0xF94013FB   -- restore on exit
-- ldp x19, x20, [sp, #16]       : 0xA94153F3
-- nop                           : 0xD503201F   -- placeholder where main does mov x27, x0
-- v2-B (112-byte frame): adds d10..d15 callee-save slots at [sp,#64..#111].
-- stp x29, x30, [sp, #-112]!    : 0xA9B97BFD
-- ldp x29, x30, [sp], #112      : 0xA8C77BFD
-- stp d10, d11, [sp, #64]       : 0x6D042FEA
-- ldp d10, d11, [sp, #64]       : 0x6D442FEA
-- stp d12, d13, [sp, #80]       : 0x6D0537EC
-- ldp d12, d13, [sp, #80]       : 0x6D4537EC
-- stp d14, d15, [sp, #96]       : 0x6D063FEE
-- ldp d14, d15, [sp, #96]       : 0x6D463FEE
inst_stp_fp_lr_pre   = 2847505405
inst_mov_x29_sp      = 2432697341
inst_stp_x19_x20_16  = 2835436531
inst_str_x27_32      = 4177531899
inst_stp_d8_d9_48    = 1828923368
inst_stp_d10_d11_64  = 1828990954
inst_stp_d12_d13_80  = 1829058540
inst_stp_d14_d15_96  = 1829126126
inst_ldp_d8_d9_48    = 1833117672
inst_ldp_d10_d11_64  = 1833185258
inst_ldp_d12_d13_80  = 1833252844
inst_ldp_d14_d15_96  = 1833320430
inst_ldr_x27_32      = 4181726203
inst_ldp_x19_x20_16  = 2839630835
inst_ldp_fp_lr_post  = 2831645693
inst_nop             = 3573751839

-- ============================================================================
-- v5 Phase 0 — AOT-completion encoders.
--
-- The JIT only needs what its hot path emits; AOT (compile.rail) emits a
-- broader ISA. This block fills the gap so jit/arm64.rail can encode every
-- mnemonic compile.rail currently produces as assembly text. Pre-cursor to
-- v5.0.0 (Rail emits Mach-O directly, retiring `as` + `ld`).
--
-- Encoding sources: ARM Architecture Reference Manual (DDI0487, Chapter C6).
-- Each base is verified by jit/test_encoders.rail against system `as`.
-- ============================================================================

-- ── Move ──────────────────────────────────────────────────────────────────
-- movn xD, #imm16, lsl #(N*16)   N in {0,1,2,3}
-- Base: 0x92800000 | (N << 21) | (imm << 5) | D
enc_movn dst imm shift_n =
  bit_or 2457862144 (bit_or (shl shift_n 21) (bit_or (shl (bit_and imm 65535) 5) dst))

-- ── Bitwise (shifted register, shift=0) ──────────────────────────────────
-- and xD, xA, xB    Base: 0x8A000000
enc_and dst a b =
  bit_or 2315255808 (bit_or (shl b 16) (bit_or (shl a 5) dst))

-- orr xD, xA, xB    Base: 0xAA000000
enc_orr dst a b =
  bit_or 2852126720 (bit_or (shl b 16) (bit_or (shl a 5) dst))

-- eor xD, xA, xB    Base: 0xCA000000
enc_eor dst a b =
  bit_or 3388997632 (bit_or (shl b 16) (bit_or (shl a 5) dst))

-- tst xA, xB        (alias of ands xzr, xA, xB)   Base: 0xEA00001F
enc_tst a b =
  bit_or 3925868575 (bit_or (shl b 16) (shl a 5))

-- ── Variable shifts (register form, 64-bit, data-processing 2-source) ───
-- lslv xD, xA, xB    Base: 0x9AC02000
enc_lsl dst a b =
  bit_or 2596282368 (bit_or (shl b 16) (bit_or (shl a 5) dst))

-- lsrv xD, xA, xB    Base: 0x9AC02400
enc_lsr dst a b =
  bit_or 2596283392 (bit_or (shl b 16) (bit_or (shl a 5) dst))

-- asrv xD, xA, xB    Base: 0x9AC02800
enc_asr dst a b =
  bit_or 2596284416 (bit_or (shl b 16) (bit_or (shl a 5) dst))

-- ── Arithmetic ───────────────────────────────────────────────────────────
-- sdiv xD, xA, xB    Base: 0x9AC00C00 (mirror of udiv 0x9AC00800)
enc_sdiv dst a b =
  bit_or 2596277248 (bit_or (shl b 16) (bit_or (shl a 5) dst))

-- madd xD, xN, xM, xA    Base: 0x9B000000 | (M<<16) | (A<<10) | (N<<5) | D
enc_madd dst n m a =
  bit_or 2600468480 (bit_or (shl m 16) (bit_or (shl a 10) (bit_or (shl n 5) dst)))

-- ── Conditional branches ─────────────────────────────────────────────────
-- b.cond #byte_off    Encoding: 0x54000000 | (imm19 << 5) | cond
-- Cond codes: EQ=0 NE=1 CS/HS=2 CC/LO=3 MI=4 PL=5 VS=6 VC=7
--             HI=8 LS=9 GE=10 LT=11 GT=12 LE=13 AL=14
enc_bcond_byte_off cond byte_off =
  let inst_off = byte_off / 4
  let masked = bit_and inst_off 524287
  bit_or (bit_or 1409286144 (shl masked 5)) cond

-- Named convenience wrappers (kept for call-site readability + grep).
enc_beq_byte_off byte_off = enc_bcond_byte_off 0 byte_off
enc_bcs_byte_off byte_off = enc_bcond_byte_off 2 byte_off
enc_bhs_byte_off byte_off = enc_bcond_byte_off 2 byte_off  -- alias of cs
enc_bcc_byte_off byte_off = enc_bcond_byte_off 3 byte_off
enc_blo_byte_off byte_off = enc_bcond_byte_off 3 byte_off  -- alias of cc
enc_bhi_byte_off byte_off = enc_bcond_byte_off 8 byte_off
enc_bls_byte_off byte_off = enc_bcond_byte_off 9 byte_off
enc_bge_byte_off byte_off = enc_bcond_byte_off 10 byte_off
enc_blt_byte_off byte_off = enc_bcond_byte_off 11 byte_off
enc_bgt_byte_off byte_off = enc_bcond_byte_off 12 byte_off
enc_ble_byte_off byte_off = enc_bcond_byte_off 13 byte_off

-- ── Compare-and-branch (non-zero variant of cbz) ────────────────────────
-- cbnz xR, #byte_off    Base: 0xB5000000 | ((off19 & 0x7FFFF) << 5) | R
enc_cbnz_byte_off reg byte_off =
  let inst_off = byte_off / 4
  let masked = bit_and inst_off 524287
  bit_or 3036676096 (bit_or (shl masked 5) reg)

-- ── Branch register (br = branch without link) ──────────────────────────
-- br xR    Base: 0xD61F0000 | (R << 5)
enc_br reg =
  bit_or 3592355840 (shl reg 5)

-- ── adrp xD, label    Page-relative address (immediate is page count) ───
-- Encoding: 0x90000000 | (immlo<<29) | (immhi<<5) | Rd
-- immlo = (byte_off >> 12) & 3
-- immhi = (byte_off >> 14) & 0x7FFFF
enc_adrp dst byte_off =
  let page_off = shr byte_off 12
  let imm21 = bit_and page_off 2097151
  let immlo = bit_and imm21 3
  let immhi = bit_and (shr imm21 2) 524287
  bit_or 2415919104 (bit_or (shl immlo 29) (bit_or (shl immhi 5) dst))

-- ── Supervisor call (Linux syscalls) ────────────────────────────────────
-- svc #imm16    Base: 0xD4000001 | (imm << 5)
enc_svc imm =
  bit_or 3556769793 (shl (bit_and imm 65535) 5)

-- ── Generalised load/store (any base reg, 8-byte-multiple unsigned offset)
-- ldr xD, [xN, #imm]    Base: 0xF9400000 | ((imm/8)<<10) | (N<<5) | D
-- imm must be in [0, 32760] and multiple of 8.
enc_ldr_imm dst n imm =
  bit_or 4181721088 (bit_or (shl (imm / 8) 10) (bit_or (shl n 5) dst))

-- str xD, [xN, #imm]    Base: 0xF9000000
enc_str_imm dst n imm =
  bit_or 4177526784 (bit_or (shl (imm / 8) 10) (bit_or (shl n 5) dst))

-- ── Load/store pair, signed offset (multi-register frame ops) ───────────
-- ldp xD1, xD2, [xN, #imm]    Base: 0xA9400000 | ((imm/8 & 0x7F)<<15) | (D2<<10) | (N<<5) | D1
-- imm is signed 7-bit scaled by 8 → range [-512, +504] in 8-byte steps.
-- Caller must pass non-negative for v1; signed support to come with relocations.
enc_ldp_imm d1 d2 n imm =
  let scaled = bit_and (imm / 8) 127
  bit_or 2839543808 (bit_or (shl scaled 15) (bit_or (shl d2 10) (bit_or (shl n 5) d1)))

-- stp xD1, xD2, [xN, #imm]    Base: 0xA9000000
enc_stp_imm d1 d2 n imm =
  let scaled = bit_and (imm / 8) 127
  bit_or 2835349504 (bit_or (shl scaled 15) (bit_or (shl d2 10) (bit_or (shl n 5) d1)))

-- ── Remaining cset variants compile.rail emits ──────────────────────────
-- cset xD, ne    Base: 0x9A9F07E0 (cond=eq inverted)
enc_cset_ne dst = bit_or 2594113504 dst
-- cset xD, hi    Base: 0x9A9F97E0 (cond=ls inverted)
enc_cset_hi dst = bit_or 2594150368 dst
-- cset xD, lo    Base: 0x9A9F27E0 (cond=hs inverted)   alias: cc
enc_cset_lo dst = bit_or 2594121696 dst
-- cset xD, hs    Base: 0x9A9F37E0 (cond=lo inverted)   alias: cs
enc_cset_hs dst = bit_or 2594125792 dst

-- ============================================================================
-- v5 Phase 5 — Linux/ELF-completion encoders.
--
-- compile.rail's Linux output uses a few mnemonics absent from the macOS
-- subset (byte ops, count-leading-zeros, integer negate / compare-negative,
-- byte-reverse, test-and-branch, single-precision float conversion).
-- Plus addressing modes: ldrb/strb register-offset, post-index writeback,
-- pre-index writeback stp/ldp.  All bases verified against `as` on canonical
-- exit programs (see tools/v5/exit42_linux.s and the new_mn.s reference).
-- ============================================================================

-- ── Byte loads / stores ──────────────────────────────────────────────────

-- ldrb wD, [xN, #imm12]    Base: 0x39400000 | (imm12<<10) | (N<<5) | D
-- imm12 is byte offset, 0..4095 unscaled (byte access).
enc_ldrb_imm dst n imm =
  bit_or 960495616 (bit_or (shl (bit_and imm 4095) 10) (bit_or (shl n 5) dst))

-- strb wD, [xN, #imm12]    Base: 0x39000000
enc_strb_imm dst n imm =
  bit_or 956301312 (bit_or (shl (bit_and imm 4095) 10) (bit_or (shl n 5) dst))

-- ldrb wD, [xN, xM]    Base: 0x38606800   (option=011, S=0, register offset LSL #0)
enc_ldrb_regoff dst n m =
  bit_or 945842176 (bit_or (shl m 16) (bit_or (shl n 5) dst))

-- strb wD, [xN, xM]    Base: 0x38206800
enc_strb_regoff dst n m =
  bit_or 941647872 (bit_or (shl m 16) (bit_or (shl n 5) dst))

-- ldrb wD, [xN], #imm9   (post-index)   Base: 0x38400400 | (imm9<<12) | (N<<5) | D
-- imm9 is signed 9-bit; positive form for our usage.
enc_ldrb_postidx dst n imm =
  bit_or 943719424 (bit_or (shl (bit_and imm 511) 12) (bit_or (shl n 5) dst))

-- strb wD, [xN], #imm9    Base: 0x38000400
enc_strb_postidx dst n imm =
  bit_or 939525120 (bit_or (shl (bit_and imm 511) 12) (bit_or (shl n 5) dst))

-- ── Integer ──────────────────────────────────────────────────────────────

-- clz xD, xS   Base: 0xDAC01000 | (S<<5) | D
enc_clz dst src = bit_or 3670020096 (bit_or (shl src 5) dst)

-- neg xD, xS    alias of sub xD, xzr, xS  (Rn=31 baked in)
-- Base: 0xCB0003E0 | (S<<16) | D
enc_neg dst src = bit_or 3405775840 (bit_or (shl src 16) dst)

-- cmn xN, #imm12   alias of adds xzr, xN, #imm
-- Base: 0xB100001F | (imm12<<10) | (N<<5)
enc_cmn_imm n imm =
  bit_or 2969567263 (bit_or (shl (bit_and imm 4095) 10) (shl n 5))

-- cmn xN, xM   alias of adds xzr, xN, xM
-- Base: 0xAB00001F | (M<<16) | (N<<5)
enc_cmn_reg n m =
  bit_or 2868903967 (bit_or (shl m 16) (shl n 5))

-- rev xD, xS    byte-reverse 64-bit   Base: 0xDAC00C00 | (S<<5) | D
enc_rev dst src = bit_or 3670019072 (bit_or (shl src 5) dst)

-- rev16 wD, wS   halfword byte-reverse 32-bit   Base: 0x5AC00400
enc_rev16 dst src = bit_or 1522533376 (bit_or (shl src 5) dst)

-- ── Float ────────────────────────────────────────────────────────────────

-- fneg dD, dS    Base: 0x1E614000 | (S<<5) | D
enc_fneg dst src = bit_or 509689856 (bit_or (shl src 5) dst)

-- frinta dD, dS   round-to-nearest, ties-away-from-zero
-- Base: 0x1E664000 | (S<<5) | D
enc_frinta dst src = bit_or 510017536 (bit_or (shl src 5) dst)

-- fcvt sD, dS    double -> single   Base: 0x1E624000 | (S<<5) | D
enc_fcvt_s_d dst src = bit_or 509755392 (bit_or (shl src 5) dst)

-- fcvt dD, sS    single -> double   Base: 0x1E22C000 | (S<<5) | D
enc_fcvt_d_s dst src = bit_or 505593856 (bit_or (shl src 5) dst)

-- ── tbnz xN, #bit, byte_off ──────────────────────────────────────────────
-- Encoding: (b5<<31) | 0x37000000 | (b40<<19) | ((off14)<<5) | Rt
-- off14 = byte_off / 4 (signed 14-bit instruction offset)
enc_tbnz_byte_off reg bit_pos byte_off =
  let b5 = bit_and (shr bit_pos 5) 1
  let b40 = bit_and bit_pos 31
  let inst_off = byte_off / 4
  let masked = bit_and inst_off 16383
  bit_or (bit_or (bit_or (bit_or (shl b5 31) 922746880) (shl b40 19)) (shl masked 5)) reg

-- ── Pre/post-index stp / ldp ─────────────────────────────────────────────
-- imm7 is signed 7-bit scaled by 8 (range [-512, +504]).
-- stp xD1, xD2, [xN, #imm]!   pre-index   Base: 0xA9800000
enc_stp_preidx d1 d2 n imm =
  let scaled = bit_and (imm / 8) 127
  bit_or 2843738112 (bit_or (shl scaled 15) (bit_or (shl d2 10) (bit_or (shl n 5) d1)))

-- ldp xD1, xD2, [xN, #imm]!   pre-index   Base: 0xA9C00000
enc_ldp_preidx d1 d2 n imm =
  let scaled = bit_and (imm / 8) 127
  bit_or 2847932416 (bit_or (shl scaled 15) (bit_or (shl d2 10) (bit_or (shl n 5) d1)))

-- stp xD1, xD2, [xN], #imm   post-index   Base: 0xA8800000
enc_stp_postidx d1 d2 n imm =
  let scaled = bit_and (imm / 8) 127
  bit_or 2826960896 (bit_or (shl scaled 15) (bit_or (shl d2 10) (bit_or (shl n 5) d1)))

-- ldp xD1, xD2, [xN], #imm   post-index   Base: 0xA8C00000
enc_ldp_postidx d1 d2 n imm =
  let scaled = bit_and (imm / 8) 127
  bit_or 2831155200 (bit_or (shl scaled 15) (bit_or (shl d2 10) (bit_or (shl n 5) d1)))

-- ── add immediate ────────────────────────────────────────────────────────
-- add xD, xN, #imm12    Base: 0x91000000 | (imm12<<10) | (N<<5) | D
enc_add_imm dst n imm =
  bit_or 2432696320 (bit_or (shl (bit_and imm 4095) 10) (bit_or (shl n 5) dst))

-- ── sub immediate (parallel of add_imm; not strictly required by tonight's
--    Linux output but cheap completion) ────────────────────────────────────
-- sub xD, xN, #imm12    Base: 0xD1000000
enc_sub_imm dst n imm =
  bit_or 3506438144 (bit_or (shl (bit_and imm 4095) 10) (bit_or (shl n 5) dst))

-- ── Shift-by-immediate (sbfm/ubfm aliases) ──────────────────────────────
-- asr xD, xN, #shift  →  sbfm xD, xN, #shift, #63
-- Base 0x9340FC00 | (shift<<16) | (Rn<<5) | Rd
enc_asr_imm dst src shift =
  bit_or 2470509568 (bit_or (shl (bit_and shift 63) 16) (bit_or (shl src 5) dst))

-- lsr xD, xN, #shift  →  ubfm xD, xN, #shift, #63
-- Base 0xD340FC00
enc_lsr_imm dst src shift =
  bit_or 3544251392 (bit_or (shl (bit_and shift 63) 16) (bit_or (shl src 5) dst))

-- lsl xD, xN, #shift  →  ubfm xD, xN, #((-shift) mod 64), #(63 - shift)
-- 0xD3400000 base | (immr<<16) | (imms<<10) | (Rn<<5) | Rd
enc_lsl_imm dst src shift =
  let immr = bit_and (64 - shift) 63
  let imms = 63 - shift
  bit_or 3544186880 (bit_or (shl immr 16) (bit_or (shl imms 10) (bit_or (shl src 5) dst)))
