-- jit/print.rail
--
-- Pretty-print an IR function struct (see jit/ir.rail) as a multi-line
-- string.  The format is round-trippable: parse(print(parse(src))) == ...
-- only meaningful when paired with re-parsing OF the original source, but
-- the textual form here is canonical so two separate parses of the same
-- source must produce byte-identical pretty output.  That's the assertion
-- jit/test_parse.rail makes.
--
-- Format (one line per instruction):
--   "  iN: OP a, b, c   ; block=K"
-- where N is the instruction index, K is the containing block.  Operand
-- field count is normalized for readability:
--   CONST   dst, imm
--   ADD/SUB/MUL/LT  dst, a, b
--   JMP     -> blockK
--   JZ      cond, -> blockK
--   RET     src
--   CALL    dst, fn, nargs
--
-- A header line "function: ninstr=N nregs=R nblocks=B" precedes the body.
--
-- NOTE: this file deliberately does NOT `import "jit/ir.rail"`.  See the
-- import-order note at the top of jit/parse.rail.

print_function fn =
  let header = print_header fn
  let body = print_body fn 0 (fn_ninstr fn) ""
  append header body

print_header fn =
  let s1 = append "function: ninstr=" (show (fn_ninstr fn))
  let s2 = append s1 " nregs="
  let s3 = append s2 (show (fn_nregs fn))
  let s4 = append s3 " nblocks="
  let s5 = append s4 (show (fn_nblocks fn))
  append s5 "\n"

print_body fn i n acc =
  if i >= n then acc
  else
    let line = print_instr fn i
    print_body fn (i + 1) n (append acc line)

print_instr fn i =
  let ir = fn_ir fn
  let op = ir_op ir i
  let a = ir_a ir i
  let b = ir_b ir i
  let c = ir_c ir i
  let blk = fn_block_of_inst fn i
  let prefix = print_instr_prefix i
  let body = print_instr_body op a b c
  let suffix = append "   ; block=" (show blk)
  append (append (append prefix body) suffix) "\n"

print_instr_prefix i =
  append (append "  i" (show i)) ": "

print_instr_body op a b c =
  if op == 0 then
    append (append (append "CONST r" (show a)) ", ") (show b)
  else if op == 1 then print_binop "ADD" a b c
  else if op == 2 then print_binop "SUB" a b c
  else if op == 3 then print_binop "MUL" a b c
  else if op == 4 then print_binop "LT"  a b c
  else if op == 5 then
    append "JMP -> block" (show a)
  else if op == 6 then
    append (append (append "JZ r" (show a)) ", -> block") (show b)
  else if op == 7 then
    append (append (append (append (append "CALL r" (show a)) ", fn=") (show b)) ", nargs=") (show c)
  else if op == 8 then
    append "RET r" (show a)
  else
    append "?? op=" (show op)

print_binop name a b c =
  let s1 = append name " r"
  let s2 = append s1 (show a)
  let s3 = append s2 ", r"
  let s4 = append s3 (show b)
  let s5 = append s4 ", r"
  append s5 (show c)
