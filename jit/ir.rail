-- jit/ir.rail
--
-- Frozen IR contract for the Session A/B/C JIT split.
--
-- Encoding:
--   Each instruction is 4 consecutive ints in an int_arr (arr_new):
--     [op, a, b, c].  Slot meanings depend on the opcode (see below).
--   Instruction `i` lives at indices [4*i, 4*i+1, 4*i+2, 4*i+3].
--
-- Opcodes (also re-exported as nullary helpers below for consumers
-- that prefer not to hardcode constants):
--   ir_const = 0 -- a=dst, b=imm,         c=0
--   ir_add   = 1 -- a=dst, b=src1,        c=src2
--   ir_sub   = 2 -- a=dst, b=src1,        c=src2
--   ir_mul   = 3 -- a=dst, b=src1,        c=src2
--   ir_lt    = 4 -- a=dst, b=src1,        c=src2  (1 if src1<src2 else 0)
--   ir_jmp   = 5 -- a=target_block_index, b=0,    c=0
--   ir_jz    = 6 -- a=src1 (cond),        b=target_block_index, c=0
--   ir_call  = 7 -- a=dst, b=fn_index,    c=n_args  (reserved; not emitted v1)
--   ir_ret   = 8 -- a=src1,               b=0,    c=0
--
-- Function struct is a 4-element Rail list:
--   [ir_arr, n_instructions, n_regs, block_offsets_arr]
--   block_offsets_arr is an int_arr where index k = start instr index of block k.

-- Opcode constants -----------------------------------------------------------

-- Bare nullary bindings (verified safe for == comparisons; do not sum two
-- of these directly — see rail_top_level_int_add_bug memory).
op_const     = 0
op_add       = 1
op_sub       = 2
op_mul       = 3
op_lt        = 4
op_jmp       = 5
op_jz        = 6
op_call      = 7   -- a=dst_reg, b=fn_index, c=packed args (see below)
-- op_call slot c encoding (multi-arg ABI):
--   bits 0..3   = n_args  (1..4 supported in v1; 0 reserved for niladic later)
--   bits 4..8   = arg0_reg
--   bits 9..13  = arg1_reg
--   bits 14..18 = arg2_reg
--   bits 19..23 = arg3_reg
-- Helpers: call_pack_1 / call_pack_2 / call_pack_3 / call_pack_4 in
-- jit/ir.rail; call_n_args / call_arg_n in jit/emit.rail decode.
op_ret       = 8
op_print_int = 9   -- a=src_reg; emits decimal repr + newline to fd 1
op_mov       = 10  -- a=dst_reg, b=src_reg
op_str_lit   = 11  -- a=dst_reg, b=pool_offset (offset of length-prefix in pool)
op_print_str = 12  -- a=src_ptr_reg (ptr to length-prefixed string); writes to fd 1
op_str_len   = 13  -- a=dst_reg, b=src_ptr_reg
op_str_eq    = 14  -- a=dst_reg (0/1), b=s1_ptr, c=s2_ptr

-- ABI v1 register classes:
--   v0..v9   -> x9..x18  (caller-save: clobbered by op_call)
--   v10..v19 -> x19..x28 (callee-save: preserved across op_call)
-- For v1 only x19/x20 are actually saved in prologue, so use v10/v11
-- for cross-call preservation. Higher vregs work but aren't preserved.

-- Mnemonic for an opcode int -------------------------------------------------

ir_op_name op =
  if op == 0 then "CONST"
  else if op == 1 then "ADD"
  else if op == 2 then "SUB"
  else if op == 3 then "MUL"
  else if op == 4 then "LT"
  else if op == 5 then "JMP"
  else if op == 6 then "JZ"
  else if op == 7 then "CALL"
  else if op == 8 then "RET"
  else if op == 9 then "PRINT_INT"
  else if op == 10 then "MOV"
  else if op == 11 then "STR_LIT"
  else if op == 12 then "PRINT_STR"
  else if op == 13 then "STR_LEN"
  else if op == 14 then "STR_EQ"
  else "??"

-- Instruction-buffer accessors ----------------------------------------------

make_ir n_instructions = arr_new (4 * n_instructions) 0

ir_op   ir i = arr_get ir (4 * i)
ir_a    ir i = arr_get ir (4 * i + 1)
ir_b    ir i = arr_get ir (4 * i + 2)
ir_c    ir i = arr_get ir (4 * i + 3)

ir_set_op ir i v = arr_set ir (4 * i)     v
ir_set_a  ir i v = arr_set ir (4 * i + 1) v
ir_set_b  ir i v = arr_set ir (4 * i + 2) v
ir_set_c  ir i v = arr_set ir (4 * i + 3) v

-- Pack a full instruction in one call (returns 0; mutates ir) ---------------
ir_emit ir i op a b c =
  let _ = ir_set_op ir i op
  let _ = ir_set_a  ir i a
  let _ = ir_set_b  ir i b
  let _ = ir_set_c  ir i c
  0

-- Function-struct accessors --------------------------------------------------
-- Layout: [ir_arr, n_instructions, n_regs, block_offsets_arr]

make_function ir n_instr n_regs blocks = [ir, n_instr, n_regs, blocks, 1]

fn_ir     fn = head fn
fn_ninstr fn = head (tail fn)
fn_nregs  fn = head (tail (tail fn))
fn_blocks fn = head (tail (tail (tail fn)))
fn_nargs  fn = head (tail (tail (tail (tail fn))))

fn_nblocks fn = arr_len (fn_blocks fn)
fn_block_start fn k = arr_get (fn_blocks fn) k

-- Compute which block instruction `i` belongs to (linear scan; small inputs).
fn_block_of_inst fn i =
  let blocks = fn_blocks fn
  let nb = arr_len blocks
  fn_block_of_inst_loop blocks nb i 0 0

fn_block_of_inst_loop blocks nb i k best =
  if k >= nb then best
  else
    let start = arr_get blocks k
    if start <= i then fn_block_of_inst_loop blocks nb i (k + 1) k
    else best

-- Session B compatibility helpers -------------------------------------------
-- Default 1-arg make_fn (back-compat for existing hand-built fixtures).
make_fn ir n_instr n_regs blocks = make_function ir n_instr n_regs blocks
-- Multi-arg variant: include n_args so emit_prologue knows how many
-- input registers to copy from x0..x(n_args-1) into v0..v(n_args-1).
make_fn_n ir n_instr n_regs blocks n_args = [ir, n_instr, n_regs, blocks, n_args]

is_terminator op =
  if op == op_jmp then 1
  else if op == op_jz then 1
  else if op == op_ret then 1
  else 0

op_writes_dst op =
  if op == op_const then 1
  else if op == op_add then 1
  else if op == op_sub then 1
  else if op == op_mul then 1
  else if op == op_lt then 1
  else if op == op_call then 1
  else 0

copy_ir_slots src dst n_used i =
  if i >= n_used then 0
  else
    let _ = arr_set dst (i * 4)     (arr_get src (i * 4))
    let _ = arr_set dst (i * 4 + 1) (arr_get src (i * 4 + 1))
    let _ = arr_set dst (i * 4 + 2) (arr_get src (i * 4 + 2))
    let _ = arr_set dst (i * 4 + 3) (arr_get src (i * 4 + 3))
    copy_ir_slots src dst n_used (i + 1)

-- op_call argument packing helpers. Each builds the int that goes into
-- ir_emit's `c` slot. v0..v31 (5-bit) per arg, n_args in low 4 bits.
call_pack_1 a0           = bit_or 1 (shl a0 4)
call_pack_2 a0 a1        = bit_or 2 (bit_or (shl a0 4) (shl a1 9))
call_pack_3 a0 a1 a2     = bit_or 3 (bit_or (shl a0 4) (bit_or (shl a1 9) (shl a2 14)))
call_pack_4 a0 a1 a2 a3  = bit_or 4 (bit_or (shl a0 4) (bit_or (shl a1 9) (bit_or (shl a2 14) (shl a3 19))))

call_n_args c       = bit_and c 15
call_arg_0    c     = bit_and (shr c 4)  31
call_arg_1    c     = bit_and (shr c 9)  31
call_arg_2    c     = bit_and (shr c 14) 31
call_arg_3    c     = bit_and (shr c 19) 31
