-- jit/codebuf.rail — byte-oriented code buffer.
-- Internally an int_arr where each Rail int holds one byte (0..255).
-- We keep it byte-granular so cb_emit can patch single bytes for branch
-- targets without re-encoding the whole instruction.

-- Make a buffer for n_instr 4-byte instructions.
make_codebuf n_instr =
  arr_new (n_instr * 4) 0

-- Emit a 32-bit ARM64 instruction at byte offset off.
-- ARM64 is little-endian: bits [7:0] go to off+0, [15:8]->+1, etc.
cb_emit buf off instr32 =
  let b0 = bit_and instr32 255
  let b1 = bit_and (shr instr32 8) 255
  let b2 = bit_and (shr instr32 16) 255
  let b3 = bit_and (shr instr32 24) 255
  let _ = arr_set buf off b0
  let _ = arr_set buf (off + 1) b1
  let _ = arr_set buf (off + 2) b2
  let _ = arr_set buf (off + 3) b3
  0

-- Read back a 32-bit instruction (for tests / debugging).
cb_read buf off =
  let b0 = arr_get buf off
  let b1 = arr_get buf (off + 1)
  let b2 = arr_get buf (off + 2)
  let b3 = arr_get buf (off + 3)
  bit_or b0 (bit_or (shl b1 8) (bit_or (shl b2 16) (shl b3 24)))

cb_size buf = arr_len buf

-- Patch helper: rewrite the instruction at byte offset `where`
-- with a new encoded value. Used by emit.rail for forward branches.
cb_patch buf where new_instr32 =
  cb_emit buf where new_instr32
