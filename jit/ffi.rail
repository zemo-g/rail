-- jit/ffi.rail — foreign bindings the JIT loader needs that aren't
-- already exposed by stdlib/mmap.rail or stdlib/dlopen.rail. Kept here
-- (per Session-C constraints) to avoid editing existing stdlib files.

-- Change page protection. PROT flags from stdlib/mmap.rail apply.
foreign mprotect addr len prot -> int

-- Invalidate the instruction cache for [addr, addr+len). Required on
-- ARM64 after writing executable code; without it the CPU may execute
-- stale prefetched bytes.
foreign sys_icache_invalidate addr len -> int

-- Threading primitives. macOS / libSystem ABI:
--   int pthread_create(pthread_t *thread, attr, void *(*start)(void *), void *arg)
--   int pthread_join(pthread_t thread, void **value_ptr)
-- pthread_t is a pointer-sized opaque handle on macOS, so a single-slot
-- 8-byte buffer fits it.
foreign pthread_create tidp attr start_routine arg -> int
foreign pthread_join tid retval_pp -> int

-- Direct-call trampoline (P6, option b). Lives in jit/libjit_call.dylib;
-- the compile.rail link line picks it up via `-L jit -weak-ljit_call` when
-- the dylib is present (build via `bash jit/build_trampoline.sh`).
--
-- Replaces pthread_create + pthread_join with a single C function-pointer
-- call:  long jit_call(long (*fn)(long), long arg) { return fn(arg); }
--
-- Saves ~50–200 µs/call (no thread spawn). Required for sub-ms RLVR grading.
-- If the dylib is absent, the symbol resolves to NULL via -weak — calls
-- crash. Loader.rail's `call_jit_direct` is the gated entry point.
foreign jit_call fn arg -> int

-- Raw 8-byte read/write — needed to read pthread_t out of the buffer
-- after pthread_create, and to read the returned long out of the
-- retval slot after pthread_join.
foreign malloc size -> ptr
foreign free p -> int

-- Read an 8-byte little-endian word from a raw byte ptr at offset
-- `off`. Implemented purely with byte_at to keep the surface tiny.
read_u64 p off =
  let b0 = byte_at p off
  let b1 = byte_at p (off + 1)
  let b2 = byte_at p (off + 2)
  let b3 = byte_at p (off + 3)
  let b4 = byte_at p (off + 4)
  let b5 = byte_at p (off + 5)
  let b6 = byte_at p (off + 6)
  let b7 = byte_at p (off + 7)
  let lo = bit_or b0 (bit_or (shl b1 8) (bit_or (shl b2 16) (shl b3 24)))
  let hi = bit_or b4 (bit_or (shl b5 8) (bit_or (shl b6 16) (shl b7 24)))
  bit_or lo (shl hi 32)

-- Write an 8-byte word to a raw byte ptr.
write_u64 p off v =
  let _ = byte_set p off       (bit_and v 255)
  let _ = byte_set p (off + 1) (bit_and (shr v 8) 255)
  let _ = byte_set p (off + 2) (bit_and (shr v 16) 255)
  let _ = byte_set p (off + 3) (bit_and (shr v 24) 255)
  let _ = byte_set p (off + 4) (bit_and (shr v 32) 255)
  let _ = byte_set p (off + 5) (bit_and (shr v 40) 255)
  let _ = byte_set p (off + 6) (bit_and (shr v 48) 255)
  let _ = byte_set p (off + 7) (bit_and (shr v 56) 255)
  0
