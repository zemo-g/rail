-- jit/icache.rail
-- Monomorphic inline cache. Records (call_site_id, observed_callee_id, hit_count).
-- Layout: flat int_arr, 3 ints per record. Slot k spans indices [3k, 3k+1, 3k+2].
--
-- Empty slot convention: site_id == -1 means "never used".
--
-- Update policy:
--   ic_record cache site_id callee_id:
--     - If a slot already exists for site_id and callee matches, hit_count++.
--     - If a slot exists for site_id but callee differs, RESET (callee = new,
--       hit_count = 1). This is a monomorphic cache; polymorphic call sites
--       degrade gracefully into "always miss" without growing the table.
--     - Else, allocate the first empty slot.
--     - If the cache is full and the site is unknown, drop the record
--       silently (caller should size n_records appropriately).
--
-- Lookup policy:
--   ic_lookup cache site_id:
--     - Returns the currently-recorded callee_id for site_id, else -1.
--     - After a callee mismatch + reset, the returned callee is the NEW one
--       (the most recently seen). This trades stability for recency,
--       matching the policy described in the test plan.

make_icache n_records =
  let arr = arr_new (n_records * 3) 0
  let _ = init_empty arr (n_records * 3) 0
  arr

init_empty arr n i =
  if i >= n then 0
  else
    let _ = arr_set arr i (0 - 1)
    let _ = arr_set arr (i + 1) 0
    let _ = arr_set arr (i + 2) 0
    init_empty arr n (i + 3)

ic_n_slots cache =
  arr_len cache / 3

-- Find slot index (0-based) for site_id, or -1 if not present.
ic_find_slot cache site_id =
  ic_find_slot_loop cache (ic_n_slots cache) site_id 0

ic_find_slot_loop cache n site_id k =
  if k >= n then (0 - 1)
  else if arr_get cache (k * 3) == site_id then k
  else ic_find_slot_loop cache n site_id (k + 1)

-- Find first empty slot (site_id == -1), or -1 if full.
ic_find_empty cache =
  ic_find_empty_loop cache (ic_n_slots cache) 0

ic_find_empty_loop cache n k =
  if k >= n then (0 - 1)
  else if arr_get cache (k * 3) == (0 - 1) then k
  else ic_find_empty_loop cache n (k + 1)

ic_record cache site_id callee_id =
  let s = ic_find_slot cache site_id
  if s >= 0 then
    let cur = arr_get cache (s * 3 + 1)
    if cur == callee_id then
      let h = arr_get cache (s * 3 + 2)
      let _ = arr_set cache (s * 3 + 2) (h + 1)
      h + 1
    else
      let _ = arr_set cache (s * 3 + 1) callee_id
      let _ = arr_set cache (s * 3 + 2) 1
      1
  else
    let e = ic_find_empty cache
    if e >= 0 then
      let _ = arr_set cache (e * 3) site_id
      let _ = arr_set cache (e * 3 + 1) callee_id
      let _ = arr_set cache (e * 3 + 2) 1
      1
    else 0

ic_lookup cache site_id =
  let s = ic_find_slot cache site_id
  if s >= 0 then arr_get cache (s * 3 + 1)
  else (0 - 1)

ic_hits cache site_id =
  let s = ic_find_slot cache site_id
  if s >= 0 then arr_get cache (s * 3 + 2)
  else 0
