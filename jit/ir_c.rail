-- jit/ir_c.rail
-- Session C's local copy of the IR contract. Will be unified with
-- Session A's ir.rail at merge time. Mirrors jit/ir_b.rail's shape.
--
-- IR opcodes (frozen):
--   ir_const = 0   -- a=dst, b=imm
--   ir_add   = 1   -- a=dst, b=src1, c=src2
--   ir_sub   = 2   -- a=dst, b=src1, c=src2
--   ir_mul   = 3   -- a=dst, b=src1, c=src2
--   ir_lt    = 4   -- a=dst, b=src1, c=src2
--   ir_jmp   = 5   -- a=target_block_index
--   ir_jz    = 6   -- a=src1, b=target_block_index
--   ir_call  = 7   -- a=dst, b=fn_index, c=n_args (skipped for v1)
--   ir_ret   = 8   -- a=src1
--
-- Each instruction = 4 ints in an arr at indices [4*i .. 4*i+3] = [op, a, b, c].
-- Function = list [ir_arr, n_instructions, n_regs, block_offsets_arr]
--   block_offsets_arr[k] = first instruction index of block k.

op_const = 0
op_add   = 1
op_sub   = 2
op_mul   = 3
op_lt    = 4
op_jmp   = 5
op_jz    = 6
op_call  = 7
op_ret   = 8

-- Per-instruction accessors.
ir_op arr i = arr_get arr (i * 4)
ir_a  arr i = arr_get arr (i * 4 + 1)
ir_b  arr i = arr_get arr (i * 4 + 2)
ir_c  arr i = arr_get arr (i * 4 + 3)

-- Build a single instruction.
make_ir arr i op a b c =
  let _ = arr_set arr (i * 4) op
  let _ = arr_set arr (i * 4 + 1) a
  let _ = arr_set arr (i * 4 + 2) b
  let _ = arr_set arr (i * 4 + 3) c
  0

-- Function struct (4-element list).
nth_c n xs =
  if n == 0 then head xs
  else nth_c (n - 1) (tail xs)

fn_ir     fn = nth_c 0 fn
fn_ninstr fn = nth_c 1 fn
fn_nregs  fn = nth_c 2 fn
fn_blocks fn = nth_c 3 fn

make_fn ir n_instr n_regs blocks =
  cons ir (cons n_instr (cons n_regs (cons blocks [])))

is_terminator op =
  if op == op_jmp then 1
  else if op == op_jz then 1
  else if op == op_ret then 1
  else 0
