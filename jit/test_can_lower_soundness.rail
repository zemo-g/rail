-- jit/test_can_lower_soundness.rail — falsification test for Bug C.
--
-- `jit_can_lower src` must return 0 for programs that USE builtins the JIT
-- recognises but `rail_native` REJECTS — otherwise naive fast-path users
-- silently mark fail cases as JIT_PASS.
--
-- The four problem tokens (today): str_eq, str_len, str_at, is_nil.
-- rail_native uses ==, length, str_sub, and ADT-style match instead.
--
-- Before the fix, jit_can_lower returned 1 for all four of these — and
-- tools/bench/jit_grade_batch.rail had to carry its own
-- contains_unsafe_jit_builtin guard as a workaround. The workaround
-- remains as defense-in-depth, but jit_can_lower is now correct at the
-- source.

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"
import "jit/lower.rail"
import "jit/grade.rail"

-- Expect jit_can_lower == 0 for `src`. Returns 0 on success, 1 on failure.
expect_unsound label src =
  let can = jit_can_lower src
  if can == 0 then
    let _ = print (cat ["[", label, "] jit_can_lower=0 OK"])
    0
  else
    let _ = print (cat ["FAIL [", label, "] jit_can_lower=", show can, " (expected 0)"])
    1

-- Sanity: jit_can_lower MUST still return 1 for programs that lower AND
-- compile under rail_native — otherwise we've made the predicate useless.
expect_sound label src =
  let can = jit_can_lower src
  if can == 1 then
    let _ = print (cat ["[", label, "] jit_can_lower=1 OK"])
    0
  else
    let _ = print (cat ["FAIL [", label, "] jit_can_lower=", show can, " (expected 1)"])
    1

main =
  let _ = print "=== Bug C: jit_can_lower soundness ==="

  -- Each of these JIT-lowers cleanly but rail_native rejects (`ld:
  -- Undefined symbols` or compile-time error).
  let u1 = expect_unsound "str_eq"        "main = if str_eq \"a\" \"a\" then 1 else 0"
  let u2 = expect_unsound "str_len"       "main = str_len \"hi\""
  let u3 = expect_unsound "str_at"        "main = str_at \"hi\" 0"
  let u4 = expect_unsound "is_nil_lit"    "main = if is_nil [] then 1 else 0"
  let u5 = expect_unsound "is_nil_in_def" "len xs = if is_nil xs then 0 else 1\nmain = len [1]"

  let _ = print "=== sanity: legitimate fast-path candidates ==="
  let s1 = expect_sound "plain_arith"   "main = 7 + 13"
  let s2 = expect_sound "factorial"     "fact n = if n < 2 then 1 else n * fact (n - 1)\nmain = fact 5"
  let s3 = expect_sound "multi_arg"     "add a b = a + b\nmain = add 7 13"

  let total = u1 + u2 + u3 + u4 + u5 + s1 + s2 + s3
  if total == 0 then
    let _ = print "PASS"
    0
  else
    let _ = print (cat ["FAILS: ", show total, "/8"])
    1
