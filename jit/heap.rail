-- jit/heap.rail — bump-pointer heap for cons cells (Stage 5 lists).
-- A separate mmap'd RW page (NOT the JIT code page). The first 8 bytes
-- hold the bump pointer; cells start at heap_base + 8.
--
-- Public:
--   heap_alloc 0  -> ptr (heap base)
--   heap_free h   -> 0
--
-- Each cons cell is 16 bytes: [head_value, tail_pointer].
-- nil sentinel = 0 (so any nonzero pointer is a valid cell).
--
-- This file is the CANONICAL importer for stdlib/mmap.rail and jit/ffi.rail.
-- Other files (jit/loader.rail, jit/emit.rail) DO NOT re-import them; they
-- rely on the caller importing jit/heap.rail before them.

import "stdlib/mmap.rail"
import "jit/ffi.rail"

heap_page_size = 65536    -- 64 KB; ~4096 cells before exhaust

heap_alloc _ =
  let p = alloc_pages heap_page_size
  -- KEY INSIGHT: Rail represents pointers from `foreign` returns as
  -- `real_address >> 1`. The foreign-call boundary multiplies by 2
  -- when passing args to C (so byte_set, mmap etc. see the real address).
  -- For the JIT to read the bump pointer correctly, we must store the
  -- REAL address (not the Rail handle) in heap[0..7]. Compute via shl 1.
  -- Verified empirically: a JIT receiving heap as its pthread arg sees
  -- x0 = (handle << 1) = real_address.
  let p_real = shl p 1
  let p_real_plus_8 = bit_or p_real 8
  let _ = write_u64 p 0 p_real_plus_8
  p

heap_free p = free_pages p heap_page_size

heap_bump_addr h = h
heap_first_cell h = h + 8
