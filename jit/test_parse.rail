-- jit/test_parse.rail
--
-- Round-trip parse/print test for five hand-written stack-VM programs.
-- For each program: parse -> print, then parse -> print again, and assert
-- both pretty-output strings are byte-identical.  Prints PASS/FAIL plus a
-- summary "K/5 PASS".  Exits 0 iff all five pass.

import "jit/ir.rail"
import "jit/parse.rail"
import "jit/print.rail"

-- The five programs --------------------------------------------------------

src_add _ =
  "PUSH 2\nPUSH 3\nADD\nRET"

src_chain _ =
  "PUSH 5\nPUSH 7\nADD\nPUSH 2\nMUL\nRET"

src_branch _ =
  "PUSH 1\nJZ ELSE\nPUSH 10\nJMP END\nLABEL ELSE\nPUSH 20\nLABEL END\nRET"

-- Decrementing loop:
--   PUSH 5         -- counter
--   LABEL TOP
--   PUSH 0         -- compare with 0
--   LT             -- (counter < 0) -> 0 since counter starts >0; but on iteration the cond is "counter == 0"
--   JZ TOP         -- (this is just a compile-test, semantics aren't asserted)
--   RET
-- Note: this program is intentionally simple-syntactic; semantics of LT are
-- not what a real loop wants, but parsing/printing round-trip is the goal.
src_loop _ =
  "PUSH 5\nLABEL TOP\nPUSH 0\nLT\nJZ TOP\nRET"

-- Branch-inside-branch: outer JZ skips a region that itself contains a JZ.
src_nested _ =
  "PUSH 1\nJZ OUTER_ELSE\nPUSH 2\nJZ INNER_ELSE\nPUSH 100\nJMP INNER_END\nLABEL INNER_ELSE\nPUSH 200\nLABEL INNER_END\nJMP OUTER_END\nLABEL OUTER_ELSE\nPUSH 300\nLABEL OUTER_END\nRET"

-- Test driver --------------------------------------------------------------

run_one name src =
  let fn1 = parse_bytecode src
  let s1 = print_function fn1
  let fn2 = parse_bytecode src
  let s2 = print_function fn2
  if s1 == s2 then
    let _ = print (append "PASS " name)
    1
  else
    let _ = print (append "FAIL " name)
    let _ = print "--- first ---"
    let _ = print s1
    let _ = print "--- second ---"
    let _ = print s2
    0

main =
  let r1 = run_one "add"     (src_add 0)
  let r2 = run_one "chain"   (src_chain 0)
  let r3 = run_one "branch"  (src_branch 0)
  let r4 = run_one "loop"    (src_loop 0)
  let r5 = run_one "nested"  (src_nested 0)
  let total = r1 + r2 + r3 + r4 + r5
  let _ = print (append (append (show total) "/5 ") "PASS")
  if total == 5 then 0 else 1
