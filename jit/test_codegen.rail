-- jit/test_codegen.rail — end-to-end JIT test.
-- Builds IR for tiny functions, emits ARM64 bytes, mmaps + runs them
-- via pthread_create, asserts the returned values match.

import "jit/emit.rail"
import "jit/loader.rail"

-- Build IR for f(x) = x + 5  (v0=x, v1=5, v2=v0+v1, ret v2).
build_addk =
  let n_instr = 4
  let ir = arr_new (n_instr * 4) 0
  let _ = ir_emit ir 0 op_const 1 5 0
  let _ = ir_emit ir 1 op_add 2 0 1
  let _ = ir_emit ir 2 op_ret 2 0 0
  -- Pad slot 3 unused; n_instr=3 actually.
  let blocks = arr_new 1 0
  let _ = arr_set blocks 0 0
  make_fn ir 3 3 blocks

-- Build IR for f(x) = x*x + 1  (v0=x, v1=v0*v0, v2=1, v3=v1+v2, ret v3).
build_sq1 =
  let n_instr = 5
  let ir = arr_new (n_instr * 4) 0
  let _ = ir_emit ir 0 op_mul 1 0 0
  let _ = ir_emit ir 1 op_const 2 1 0
  let _ = ir_emit ir 2 op_add 3 1 2
  let _ = ir_emit ir 3 op_ret 3 0 0
  let blocks = arr_new 1 0
  let _ = arr_set blocks 0 0
  make_fn ir 4 4 blocks

run_fixture label fn arg expected =
  let res = emit_function fn
  let buf = emitted_buf res
  let nbytes = emitted_size res
  let _ = print (cat ["[", label, "] emitted ", show nbytes, " bytes"])
  let page = make_executable buf nbytes
  let got = call_jit page arg
  let _ = free_jit page
  if got == expected then
    let _ = print (cat ["JIT WORKS: ", show got])
    0
  else
    let _ = print (cat ["FAIL [", label, "]: arg=", show arg, " expected=", show expected, " got=", show got])
    1

-- Pretty-print the bytes of fixture 1 so the report can include them.
dump_bytes buf nbytes i =
  if i >= nbytes then 0
  else
    let _ = print (cat ["  byte[", show i, "] = ", show (arr_get buf i)])
    dump_bytes buf nbytes (i + 1)

-- Build IR for fib(n) — two recursive op_calls per non-base case.
-- v0  = n (input)
-- v10 = preserved n
-- v11 = preserved fib(n-1) across the second recursive call
build_fib =
  let n_instr = 14
  let ir = arr_new (n_instr * 4) 0
  let _ = ir_emit ir 0  op_mov   10 0 0
  let _ = ir_emit ir 1  op_const 1 2 0
  let _ = ir_emit ir 2  op_lt    2 0 1
  let _ = ir_emit ir 3  op_jz    2 1 0
  let _ = ir_emit ir 4  op_ret   0 0 0
  let _ = ir_emit ir 5  op_const 3 1 0
  let _ = ir_emit ir 6  op_sub   4 10 3
  let _ = ir_emit ir 7  op_call  5 0 4
  let _ = ir_emit ir 8  op_mov   11 5 0
  let _ = ir_emit ir 9  op_const 6 2 0
  let _ = ir_emit ir 10 op_sub   7 10 6
  let _ = ir_emit ir 11 op_call  8 0 7
  let _ = ir_emit ir 12 op_add   9 11 8
  let _ = ir_emit ir 13 op_ret   9 0 0
  let blocks = arr_new 2 0
  let _ = arr_set blocks 0 0
  let _ = arr_set blocks 1 5
  make_fn ir 14 12 blocks

-- Build IR for factorial via single-fn self-recursive op_call.
-- v0  = n (input, x9)
-- v10 = preserved n (x19, callee-save)
-- block 0: base case + branch
-- block 1: recursive case
build_fact =
  let n_instr = 11
  let ir = arr_new (n_instr * 4) 0
  let _ = ir_emit ir 0  op_mov   10 0 0
  let _ = ir_emit ir 1  op_const 1 2 0
  let _ = ir_emit ir 2  op_lt    2 0 1
  let _ = ir_emit ir 3  op_jz    2 1 0
  let _ = ir_emit ir 4  op_const 3 1 0
  let _ = ir_emit ir 5  op_ret   3 0 0
  let _ = ir_emit ir 6  op_const 3 1 0
  let _ = ir_emit ir 7  op_sub   4 0 3
  let _ = ir_emit ir 8  op_call  5 0 4
  let _ = ir_emit ir 9  op_mul   6 10 5
  let _ = ir_emit ir 10 op_ret   6 0 0
  let blocks = arr_new 2 0
  let _ = arr_set blocks 0 0
  let _ = arr_set blocks 1 6
  make_fn ir 11 11 blocks

-- Run a fixture via emit_program (multi-fn capable; we use 1-fn list here
-- so op_call's fn_index=0 resolves to the fixture's own start).
run_program label fn arg expected =
  let res = emit_program (cons fn [])
  let buf = emitted_buf res
  let nbytes = emitted_size res
  let _ = print (cat ["[", label, "] emitted ", show nbytes, " bytes"])
  let page = make_executable buf nbytes
  let got = call_jit page arg
  let _ = free_jit page
  if got == expected then
    let _ = print (cat ["JIT WORKS: ", show got])
    0
  else
    let _ = print (cat ["FAIL [", label, "]: arg=", show arg, " expected=", show expected, " got=", show got])
    1

main =
  let fn1 = build_addk
  let res1 = emit_function fn1
  let buf1 = emitted_buf res1
  let n1 = emitted_size res1
  let _ = print (cat ["fixture1 bytes (", show n1, "):"])
  let _ = dump_bytes buf1 n1 0
  let f1 = run_fixture "addk" build_addk 3 8
  let f2 = run_fixture "sq1"  build_sq1  7 50
  let f3 = run_program "fact5" build_fact 5 120
  let f4 = run_program "fact1" build_fact 1 1
  let f5 = run_program "fact0" build_fact 0 1
  let f6 = run_program "fib10" build_fib 10 55
  let f7 = run_program "fib0"  build_fib 0  0
  let f8 = run_program "fib1"  build_fib 1  1
  if f1 == 0 && f2 == 0 && f3 == 0 && f4 == 0 && f5 == 0 && f6 == 0 && f7 == 0 && f8 == 0 then
    let _ = print "ALL PASS"
    0
  else
    let _ = print "FAIL"
    1
