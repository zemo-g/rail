-- jit/test_print.rail — exercise op_print_int (stdout emit via svc).
-- Prints a series of test values to stdout via the JIT, then a Rail-side
-- expected sentinel. Check via:
--   ./rail_native run jit/test_print.rail | grep -c "^42$"
-- should give 1, etc. The test driver below also verifies the int return
-- is zero, so a 0 exit indicates the JIT didn't crash and the syscall
-- was issued.

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"

-- Function: print(v0), return 0.
build_print_n =
  let ir = arr_new 12 0
  let _ = ir_emit ir 0 op_print_int 0 0 0
  let _ = ir_emit ir 1 op_const     1 0 0
  let _ = ir_emit ir 2 op_ret       1 0 0
  let blocks = arr_new 1 0
  let _ = arr_set blocks 0 0
  make_fn ir 3 2 blocks

run_print n =
  let heap = heap_alloc 0
  let res = emit_program (cons build_print_n []) [] heap
  let buf = emitted_buf res
  let nbytes = emitted_size res
  let page = make_executable buf nbytes
  let got = call_jit page n
  let _ = free_jit page
  let _ = heap_free heap
  got

main =
  let _ = print "--- begin JIT print ---"
  let r1 = run_print 42
  let r2 = run_print 0
  let r3 = run_print 1
  let r4 = run_print 12345
  let r5 = run_print 999999
  let _ = print "--- end JIT print ---"
  let _ = print (cat ["returns: ", show r1, " ", show r2, " ", show r3, " ", show r4, " ", show r5])
  if r1 == 0 && r2 == 0 && r3 == 0 && r4 == 0 && r5 == 0 then
    let _ = print "PRINT OK"
    0
  else
    let _ = print "PRINT FAIL"
    1
