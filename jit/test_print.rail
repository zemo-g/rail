-- jit/test_print.rail — exercise op_print_int via heap output capture (P0).
-- Builds an IR that prints a baked-in constant, runs it, and asserts the
-- captured output bytes equal "<n>\n" for various n.

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"

-- Function: v0 = const n; print(v0); v1 = 0; return v1.
build_print_n n =
  let ir = arr_new 16 0
  let _ = ir_emit ir 0 op_const     0 n 0
  let _ = ir_emit ir 1 op_print_int 0 0 0
  let _ = ir_emit ir 2 op_const     1 0 0
  let _ = ir_emit ir 3 op_ret       1 0 0
  let blocks = arr_new 1 0
  let _ = arr_set blocks 0 0
  -- n_args=0: main has no params; heap arrives via x27 only (ABI v2).
  make_fn ir 4 0 blocks

run_print n expected =
  let heap = heap_alloc 0
  let res = emit_program (cons (build_print_n n) []) [] heap
  let buf = emitted_buf res
  let nbytes = emitted_size res
  let page = make_executable buf nbytes
  let got = call_jit page heap
  let actual = read_jit_output heap
  let _ = free_jit page
  let _ = heap_free heap
  if got != 0 then
    let _ = print (cat ["FAIL n=", show n, ": JIT return ", show got, " (expected 0)"])
    1
  else if actual == expected then
    let _ = print (cat ["[print ", show n, "] OK captured=", expected])
    0
  else
    let _ = print (cat ["FAIL n=", show n, ": got=\"", actual, "\" expected=\"", expected, "\""])
    1

main =
  let _ = print "--- begin JIT print capture test ---"
  let r1 = run_print 42      "42\n"
  let r2 = run_print 0       "0\n"
  let r3 = run_print 1       "1\n"
  let r4 = run_print 12345   "12345\n"
  let r5 = run_print 999999  "999999\n"
  let total = r1 + r2 + r3 + r4 + r5
  if total == 0 then
    let _ = print "PRINT OK"
    0
  else
    let _ = print (cat ["PRINT FAIL: ", show total])
    1
