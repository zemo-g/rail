-- jit/emit.rail — IR -> ARM64 bytes.
-- Register mapping (ABI v1):
--   v0..v9   -> x9..x18   (caller-save: clobbered by op_call)
--   v10..v19 -> x19..x28  (callee-save: preserved across op_call;
--                          for v1 only x19/x20 are saved by prologue)
--
-- Function frame (32 bytes):
--   Prologue (16 bytes):
--     stp x29, x30, [sp, #-32]!     ; reserve frame, save FP/LR
--     mov x29, sp                    ; set up new FP
--     stp x19, x20, [sp, #16]       ; save callee-save pair
--     mov v0_preg, x0                ; copy input arg into v0
--   Epilogue (16 bytes, emitted as part of op_ret):
--     mov x0, vN                     ; load return value
--     ldp x19, x20, [sp, #16]       ; restore callee-save pair
--     ldp x29, x30, [sp], #32       ; restore FP/LR, dealloc frame
--     ret
--
-- op_call (12 bytes; ABI: 1 int arg, 1 int return):
--   IR: a=dst_reg, b=fn_index, c=arg_reg
--     mov x0, x_preg(c)              ; load arg
--     bl  <target_fn_offset>         ; relative call
--     mov x_preg(a), x0              ; capture return
--
-- op_mov (4 bytes): a=dst_reg, b=src_reg → mov xDst, xSrc

import "jit/ir.rail"
import "jit/arm64.rail"
import "jit/codebuf.rail"
-- heap.rail is imported by the caller (test driver) BEFORE emit.rail. We
-- accept heap_addr as an int; we don't call heap_alloc directly.

-- IR vreg N -> physical x(N + 9).
preg vreg = vreg + 9

-- Per-function fixed costs (inlined as literals to avoid Rail's
-- nullary-int + let-bound-int sum bug).
--   prologue = stp_fp_lr_-48 (4) + mov_x29_sp (4) + stp_x19_x20 (4)
--            + str_x27_32 (4)             -- save caller's x27 (= heap)
--            + (mov x27, x0  if main, else nop) (4)
--            + n_args movs (4 each)
--            = 20 + 4*n_args
--   op_ret   = mov x0, vN + ldr_x27_32 + ldp_x19_x20 + ldp_fp_lr_+48 + ret
--            = 20 bytes
-- ABI v2: heap_addr arrives in x0 from pthread_create. Only main captures
-- it via `mov x27, x0`; inner functions inherit x27 from the caller (kept
-- live by callee-save save/restore). All ops that need heap (op_cons,
-- op_print_int, op_print_str) read x27.

-- Bytes per IR opcode (FIXED-size opcodes only).
-- For variable-size opcodes (op_call), use ir_byte_size_at.
ir_byte_size op =
  if op == op_const then 16
  else if op == op_add then 4
  else if op == op_sub then 4
  else if op == op_mul then 4
  else if op == op_lt then 8
  else if op == op_jmp then 4
  else if op == op_jz then 4
  else if op == op_ret then 20
  else if op == op_print_int then 136
  else if op == op_mov then 4
  else if op == op_str_lit then 4
  else if op == op_print_str then 44
  else if op == op_str_len then 4
  else if op == op_str_eq then 72
  else if op == op_str_at then 8
  else if op == op_nil then 4
  else if op == op_cons then 24
  else if op == op_head then 4
  else if op == op_tail then 4
  else if op == op_is_nil then 8
  else if op == op_eq then 8
  else if op == op_gt then 8
  else if op == op_le then 8
  else if op == op_ge then 8
  else if op == op_div then 4
  else if op == op_mod then 8
  else 4

-- Variable-size lookup. Reads the instruction's c slot for op_call
-- to compute n_args, returning 4*(n_args+2) bytes. Other opcodes
-- forward to ir_byte_size.
ir_byte_size_at ir i =
  let op = ir_op ir i
  if op == op_call then
    let n = call_n_args (ir_c ir i)
    4 + 4 + 4 * n   -- bl(4) + mov dst,x0(4) + n arg-movs(4n)
  else ir_byte_size op

-- Pass 1: compute, for each IR instruction index i, the byte offset
-- where its emitted ARM64 sequence starts, RELATIVE TO THE FUNCTION'S
-- BODY START (i.e., after the prologue). Returns int_arr of size n+1
-- where slot[n] = total body bytes.
compute_body_offsets ir n_instr =
  let off_arr = arr_new (n_instr + 1) 0
  let _ = fill_offsets ir n_instr off_arr 0 0
  off_arr

fill_offsets ir n_instr off_arr i acc =
  if i >= n_instr then
    let _ = arr_set off_arr i acc
    0
  else
    let _ = arr_set off_arr i acc
    let sz = ir_byte_size_at ir i
    fill_offsets ir n_instr off_arr (i + 1) (acc + sz)

-- Total bytes for one function.
fn_total_bytes fn =
  let ir = fn_ir fn
  let n_instr = fn_ninstr fn
  let n_args = fn_nargs fn
  let body = compute_body_offsets ir n_instr
  let body_bytes = arr_get body n_instr
  20 + (4 * n_args) + body_bytes

-- emit_print_int: stub for now — body filled in below.
emit_print_int buf off src =
  emit_print_int_impl buf off src

-- Build a 64-bit constant via movz + 3 movks (fixed 16-byte budget).
emit_const buf off dst imm =
  let p0 = bit_and imm 65535
  let p1 = bit_and (shr imm 16) 65535
  let p2 = bit_and (shr imm 32) 65535
  let p3 = bit_and (shr imm 48) 65535
  let _ = cb_emit buf       off       (enc_mov_imm16 dst p0)
  let _ = cb_emit buf (off + 4)  (enc_movk dst p1 1)
  let _ = cb_emit buf (off + 8)  (enc_movk dst p2 2)
  let _ = cb_emit buf (off + 12) (enc_movk dst p3 3)
  0

-- Emit prologue at the function's start byte offset in the buffer.
-- Writes (20 + 4*n_args) bytes: frame setup (48-byte frame, saving FP/LR,
-- x19/x20, and x27) + conditional `mov x27, x0` (main only) + per-arg moves.
-- For non-main functions, we emit a NOP in place of the heap-capture mov
-- so x27 stays equal to the caller's value (= heap, propagated as
-- callee-save through the str/ldr at offset #32).
emit_prologue buf fn_start n_args is_main =
  let _ = cb_emit buf       fn_start       inst_stp_fp_lr_pre
  let _ = cb_emit buf (fn_start + 4)  inst_mov_x29_sp
  let _ = cb_emit buf (fn_start + 8)  inst_stp_x19_x20_16
  let _ = cb_emit buf (fn_start + 12) inst_str_x27_32
  -- mov x27, x0 ONLY for main (the JIT entry); else nop so x27 stays
  -- whatever the caller set it to (= heap by the callee-save chain).
  let cap = if is_main == 1 then enc_mov_reg 27 0 else inst_nop
  let _ = cb_emit buf (fn_start + 16) cap
  emit_arg_moves buf (fn_start + 20) 0 n_args

emit_arg_moves buf off i n =
  if i >= n then 0
  else
    -- mov preg(i), x_i
    let _ = cb_emit buf off (enc_mov_reg (preg i) i)
    emit_arg_moves buf (off + 4) (i + 1) n

-- Block-byte-offset lookup, given the function's body start and its
-- per-instruction body-relative offsets array.
block_byte_offset_in_fn body_start blocks body_offsets k =
  let instr_idx = arr_get blocks k
  body_start + (arr_get body_offsets instr_idx)

-- Pass 2 emit one IR instruction at its absolute byte offset in the buffer.
-- body_start = byte offset of function body start in buf (= fn_start + 12).
-- body_offsets = per-instruction body-relative offsets.
-- fn_offsets = per-function absolute start offset (only used by op_call); may be 0
--   for emit_function singletons that don't use op_call.
emit_one buf ir body_start body_offsets blocks fn_offsets i =
  let off = body_start + (arr_get body_offsets i)
  let op = ir_op ir i
  let a = ir_op_a_or_b ir i 1
  let b = ir_op_a_or_b ir i 2
  let c = ir_op_a_or_b ir i 3
  if op == op_const then
    emit_const buf off (preg a) b
  else if op == op_add then
    cb_emit buf off (enc_add (preg a) (preg b) (preg c))
  else if op == op_sub then
    cb_emit buf off (enc_sub (preg a) (preg b) (preg c))
  else if op == op_mul then
    cb_emit buf off (enc_mul (preg a) (preg b) (preg c))
  else if op == op_lt then
    let _ = cb_emit buf       off       (enc_cmp (preg b) (preg c))
    let _ = cb_emit buf (off + 4) (enc_cset_lt (preg a))
    0
  else if op == op_jmp then
    let target_off = block_byte_offset_in_fn body_start blocks body_offsets a
    let rel = target_off - off
    cb_emit buf off (enc_b_byte_off rel)
  else if op == op_jz then
    let target_off = block_byte_offset_in_fn body_start blocks body_offsets b
    let rel = target_off - off
    cb_emit buf off (enc_cbz_byte_off (preg a) rel)
  else if op == op_call then
    emit_op_call buf off a b c fn_offsets
  else if op == op_ret then
    let _ = cb_emit buf       off       (enc_mov_reg 0 (preg a))
    let _ = cb_emit buf (off + 4)  inst_ldr_x27_32
    let _ = cb_emit buf (off + 8)  inst_ldp_x19_x20_16
    let _ = cb_emit buf (off + 12) inst_ldp_fp_lr_post
    let _ = cb_emit buf (off + 16) enc_ret
    0
  else if op == op_mov then
    cb_emit buf off (enc_mov_reg (preg a) (preg b))
  else if op == op_print_int then
    emit_print_int buf off (preg a)
  else if op == op_str_lit then
    emit_op_str_lit buf off (preg a) b fn_offsets
  else if op == op_print_str then
    emit_op_print_str buf off (preg a)
  else if op == op_str_len then
    emit_op_str_len buf off (preg a) (preg b)
  else if op == op_str_eq then
    emit_op_str_eq buf off (preg a) (preg b) (preg c)
  else if op == op_str_at then
    emit_op_str_at buf off (preg a) (preg b) (preg c)
  else if op == op_nil then
    cb_emit buf off (bit_or 3531603968 (preg a))
  else if op == op_cons then
    emit_op_cons buf off (preg a) (preg b) (preg c)
  else if op == op_head then
    cb_emit buf off (bit_or (bit_or 4181721088 (preg a)) (shl (preg b) 5))
  else if op == op_tail then
    cb_emit buf off (bit_or (bit_or 4181722112 (preg a)) (shl (preg b) 5))
  else if op == op_is_nil then
    emit_op_is_nil buf off (preg a) (preg b)
  else if op == op_eq then
    let _ = cb_emit buf off (enc_cmp (preg b) (preg c))
    let _ = cb_emit buf (off + 4) (enc_cset_eq (preg a))
    0
  else if op == op_gt then
    let _ = cb_emit buf off (enc_cmp (preg b) (preg c))
    let _ = cb_emit buf (off + 4) (enc_cset_gt (preg a))
    0
  else if op == op_le then
    let _ = cb_emit buf off (enc_cmp (preg b) (preg c))
    let _ = cb_emit buf (off + 4) (enc_cset_le (preg a))
    0
  else if op == op_ge then
    let _ = cb_emit buf off (enc_cmp (preg b) (preg c))
    let _ = cb_emit buf (off + 4) (enc_cset_ge (preg a))
    0
  else if op == op_div then
    cb_emit buf off (enc_udiv (preg a) (preg b) (preg c))
  else if op == op_mod then
    -- udiv x21, b, c ; msub dst, x21, c, b
    let _ = cb_emit buf       off       (enc_udiv 21 (preg b) (preg c))
    let _ = cb_emit buf (off + 4)  (enc_msub (preg a) 21 (preg c) (preg b))
    0
  else
    -- Unknown op: emit a safe ret(0) so we never run garbage. Pads to 20
    -- bytes (5 inst) to match op_ret's new size accounting.
    let _ = cb_emit buf       off       (enc_mov_reg 0 0)
    let _ = cb_emit buf (off + 4)  inst_ldr_x27_32
    let _ = cb_emit buf (off + 8)  inst_ldp_x19_x20_16
    let _ = cb_emit buf (off + 12) inst_ldp_fp_lr_post
    let _ = cb_emit buf (off + 16) enc_ret
    0

-- Multi-arg op_call emit. Decodes packed c (n_args + arg vregs), emits:
--   for each i in 0..n-1: mov xi, x_preg(arg_i)
--   bl <target_fn_offset>
--   mov x_preg(dst), x0
emit_op_call buf off a b c fn_offsets =
  let n = call_n_args c
  let arg0 = call_arg_0 c
  let arg1 = call_arg_1 c
  let arg2 = call_arg_2 c
  let arg3 = call_arg_3 c
  let _ = if n >= 1 then cb_emit buf       off       (enc_mov_reg 0 (preg arg0)) else 0
  let _ = if n >= 2 then cb_emit buf (off + 4)  (enc_mov_reg 1 (preg arg1)) else 0
  let _ = if n >= 3 then cb_emit buf (off + 8)  (enc_mov_reg 2 (preg arg2)) else 0
  let _ = if n >= 4 then cb_emit buf (off + 12) (enc_mov_reg 3 (preg arg3)) else 0
  let bl_off = off + 4 * n
  let target_fn_start = arr_get fn_offsets b
  let rel = target_fn_start - bl_off
  let _ = cb_emit buf bl_off (enc_bl_byte_off rel)
  let _ = cb_emit buf (bl_off + 4) (enc_mov_reg (preg a) 0)
  0

-- Helper: read slot a/b/c from instruction i. Slot 1=a, 2=b, 3=c.
ir_op_a_or_b ir i which =
  if which == 1 then ir_a ir i
  else if which == 2 then ir_b ir i
  else ir_c ir i

emit_loop buf ir body_start body_offsets blocks fn_offsets i n_instr =
  if i >= n_instr then 0
  else
    let _ = emit_one buf ir body_start body_offsets blocks fn_offsets i
    emit_loop buf ir body_start body_offsets blocks fn_offsets (i + 1) n_instr

-- Emit one function into buf starting at fn_start. Returns the size in bytes.
-- is_main = 1 → prologue captures `mov x27, x0` (heap_addr from pthread arg).
-- is_main = 0 → prologue emits a NOP in the same slot; x27 is preserved as
-- callee-save through str/ldr at [sp, #32].
emit_one_function buf fn_start fn fn_offsets is_main =
  let ir = fn_ir fn
  let n_instr = fn_ninstr fn
  let n_args = fn_nargs fn
  let blocks = fn_blocks fn
  let body_offsets = compute_body_offsets ir n_instr
  let body_bytes = arr_get body_offsets n_instr
  let prologue_size = 20 + (4 * n_args)
  let body_start = fn_start + prologue_size
  let _ = emit_prologue buf fn_start n_args is_main
  let _ = emit_loop buf ir body_start body_offsets blocks fn_offsets 0 n_instr
  prologue_size + body_bytes

-- Emit a single-function program. For backward compat with existing tests.
-- Returns [buf, total_bytes]. (heap arg unused; kept for backward compat.)
-- Treated as main (is_main=1) since it's the JIT entry point.
emit_function fn heap =
  let total = fn_total_bytes fn
  let buf = make_codebuf (total / 4)
  let fn_offsets = arr_new 2 0
  let _ = arr_set fn_offsets 1 total
  let _ = emit_one_function buf 0 fn fn_offsets 1
  cons buf (cons total [])

-- Emit a multi-function program. With pool support.
-- Input: fn_list = Rail list of function structs;
--        pool    = [pool_buf int_arr, pool_size_cell int_arr] (or [] for none).
-- Output: [buf, total_bytes, fn_offsets_arr]
--   fn_offsets_arr is sized n+1; slot n holds total_code_bytes for the
--   adr-relative resolution of op_str_lit.
emit_program fn_list pool heap =
  let n = list_len fn_list
  let fn_offsets = arr_new (n + 1) 0
  let total_code = compute_fn_starts fn_list n fn_offsets 0 0
  let _ = arr_set fn_offsets n total_code
  let pool_size = if pool == [] then 0 else arr_get (head (tail pool)) 0
  let total_bytes = total_code + pool_size
  let buf = arr_new total_bytes 0
  let _ = emit_each_function buf fn_list n fn_offsets 0
  let _ = if pool_size > 0 then copy_pool_bytes buf total_code (head pool) pool_size 0 else 0
  cons buf (cons total_bytes (cons fn_offsets []))

copy_pool_bytes dst dst_off src_buf n_bytes i =
  if i >= n_bytes then 0
  else
    let _ = arr_set dst (dst_off + i) (arr_get src_buf i)
    copy_pool_bytes dst dst_off src_buf n_bytes (i + 1)

-- Walk fn_list, fill fn_offsets[k] with running byte offset, return total bytes.
compute_fn_starts fn_list n fn_offsets k acc =
  if k >= n then acc
  else
    let _ = arr_set fn_offsets k acc
    let fn = nth_fn fn_list k
    let sz = fn_total_bytes fn
    compute_fn_starts fn_list n fn_offsets (k + 1) (acc + sz)

emit_each_function buf fn_list n fn_offsets k =
  if k >= n then 0
  else
    let fn = nth_fn fn_list k
    let fn_start = arr_get fn_offsets k
    -- main is at index 0 (lower's move_main_first guarantees this).
    let is_main = if k == 0 then 1 else 0
    let _ = emit_one_function buf fn_start fn fn_offsets is_main
    emit_each_function buf fn_list n fn_offsets (k + 1)

-- Local helpers (don't depend on stdlib).
list_len xs =
  if xs == [] then 0
  else 1 + list_len (tail xs)

nth_fn xs k =
  if k == 0 then head xs
  else nth_fn (tail xs) (k - 1)

emitted_buf res = head res
emitted_size res = head (tail res)
emitted_offsets res = head (tail (tail res))
emitted_heap res =
  -- emit_function returns [buf, total, heap]; emit_program returns [buf, total, fn_offsets, heap]
  let n = list_len res
  if n == 3 then head (tail (tail res))
  else head (tail (tail (tail res)))

-- ============================================================================
-- String-op emitters
-- ============================================================================

-- op_str_lit: load PC-relative address of the pool entry into dst_preg.
-- fn_offsets's last slot holds total_code_bytes (set by emit_program).
emit_op_str_lit buf off dst_preg pool_offset fn_offsets =
  let n = arr_len fn_offsets
  let total_code = arr_get fn_offsets (n - 1)
  let target = total_code + pool_offset
  let rel = target - off
  cb_emit buf off (enc_adr dst_preg rel)

-- op_print_str: ptr in src_preg points to length-prefixed string.
-- Appends `len` bytes to the heap output buffer at [x27, #8].
-- Uses x21 (cursor) and x22 (byte scratch) — outside the v1 vreg map.
-- All constants verified via /tmp/asmtest_p0_v2.s + as+otool.
emit_op_print_str buf off src_preg =
  -- 0: ldr x2, [src_preg, #0]    = 0xF9400002 | (src_preg<<5)
  let _ = cb_emit buf       off       (bit_or 4181721090 (shl src_preg 5))
  -- 1: add x1, src_preg, #8      = 0x91002001 | (src_preg<<5)
  let _ = cb_emit buf (off + 4)  (bit_or 2432704513 (shl src_preg 5))
  -- 2: ldr x21, [x27, #8]        = 0xF9400775
  let _ = cb_emit buf (off + 8)  4181722997
  -- 3: cbz x2, +7 inst (skip)    = 0xB40000E2
  let _ = cb_emit buf (off + 12) 3019899106
  -- 4: ldrb w22, [x1]            = 0x39400036
  let _ = cb_emit buf (off + 16) 960495670
  -- 5: strb w22, [x21]           = 0x390002B6
  let _ = cb_emit buf (off + 20) 956302006
  -- 6: add x1, x1, #1            = 0x91000421
  let _ = cb_emit buf (off + 24) 2432697377
  -- 7: add x21, x21, #1          = 0x910006B5
  let _ = cb_emit buf (off + 28) 2432698037
  -- 8: sub x2, x2, #1            = 0xD1000442
  let _ = cb_emit buf (off + 32) 3506439234
  -- 9: cbnz x2, -5 inst          = 0xB5FFFF62
  let _ = cb_emit buf (off + 36) 3053453154
  -- 10: str x21, [x27, #8]       = 0xF9000775
  let _ = cb_emit buf (off + 40) 4177528693
  0

-- op_str_len: dst = *src (8-byte length prefix at offset 0).
-- ldr xdst, [xsrc, #0]   = 0xF9400000 | (src_preg<<5) | dst_preg
emit_op_str_len buf off dst_preg src_preg =
  cb_emit buf off (bit_or (bit_or 4181721088 dst_preg) (shl src_preg 5))

-- op_str_eq: 18-instruction byte-loop comparing two length-prefixed strings.
-- Returns 0/1 in dst_preg. Uses x21..x27 as scratch — outside the v1 vreg
-- map (v0..v11 → x9..x20), so won't clobber caller's live values.
-- All constants verified via /tmp/asmtest_streq2.s + python conversion.
emit_op_str_eq buf off dst_preg s1_preg s2_preg =
  -- 0: ldr x21, [s1_preg, #0]    = 0xF9400015 | (s1<<5)   -- len1
  let _ = cb_emit buf       off       (bit_or 4181721109 (shl s1_preg 5))
  -- 1: ldr x22, [s2_preg, #0]    = 0xF9400016 | (s2<<5)   -- len2
  let _ = cb_emit buf (off + 4)  (bit_or 4181721110 (shl s2_preg 5))
  -- 2: cmp x21, x22               = 0xEB1602BF
  let _ = cb_emit buf (off + 8)  3944088255
  -- 3: b.ne +12 instr              = 0x54000181
  let _ = cb_emit buf (off + 12) 1409286529
  -- 4: add x23, s1_preg, #8      = 0x91002017 | (s1<<5)   -- data1
  let _ = cb_emit buf (off + 16) (bit_or 2432704535 (shl s1_preg 5))
  -- 5: add x24, s2_preg, #8      = 0x91002018 | (s2<<5)   -- data2
  let _ = cb_emit buf (off + 20) (bit_or 2432704536 (shl s2_preg 5))
  -- 6: mov x25, #0                 = 0xD2800019            -- counter
  let _ = cb_emit buf (off + 24) 3531603993
  -- 7: cmp x25, x21                = 0xEB15033F (LOOP_TOP)
  let _ = cb_emit buf (off + 28) 3944022847
  -- 8: b.ge +9 instr               = 0x5400012A
  let _ = cb_emit buf (off + 32) 1409286442
  -- 9: ldrb w26, [x23, x25]       = 0x38796AFA
  let _ = cb_emit buf (off + 36) 947481338
  -- 10: ldrb w27, [x24, x25]      = 0x38796B1B
  let _ = cb_emit buf (off + 40) 947481371
  -- 11: cmp w26, w27               = 0x6B1B035F
  let _ = cb_emit buf (off + 44) 1796932447
  -- 12: b.ne +3 instr              = 0x54000061
  let _ = cb_emit buf (off + 48) 1409286241
  -- 13: add x25, x25, #1           = 0x91000739
  let _ = cb_emit buf (off + 52) 2432698169
  -- 14: b -7 instr (back to LOOP)  = 0x17FFFFF9
  let _ = cb_emit buf (off + 56) 402653177
  -- 15: mov dst_preg, #0           = 0xD2800000 | dst
  let _ = cb_emit buf (off + 60) (bit_or 3531603968 dst_preg)
  -- 16: b +2 instr                 = 0x14000002
  let _ = cb_emit buf (off + 64) 335544322
  -- 17: mov dst_preg, #1           = 0xD2800020 | dst
  let _ = cb_emit buf (off + 68) (bit_or 3531604000 dst_preg)
  0

-- op_str_at: 2-instruction emit. dst_preg = byte value (zero-extended).
-- Sequence: add x21, src_preg, #8 ; ldrb wDst, [x21, idx_preg]
emit_op_str_at buf off dst_preg src_preg idx_preg =
  -- add x21, src_preg, #8        = 0x91002015 | (src<<5)
  let _ = cb_emit buf       off       (bit_or 2432704533 (shl src_preg 5))
  -- ldrb wDst, [x21, idx_preg]   = 0x38606AA0 | (idx<<16) | dst
  let _ = cb_emit buf (off + 4)  (bit_or (bit_or 945842848 (shl idx_preg 16)) dst_preg)
  0

-- op_cons: 6-instruction emit. Allocates a 16-byte cell from x27 (heap_meta).
-- Sequence:
--   ldr x21, [x27, #0]      ; bump pointer
--   str head, [x21, #0]
--   str tail, [x21, #8]
--   add x22, x21, #16
--   str x22, [x27, #0]      ; advance bump
--   mov dst, x21            ; dst = old bump = allocated cell
emit_op_cons buf off dst_preg head_preg tail_preg =
  -- ldr x21, [x27, #0]       = 0xF9400375
  let _ = cb_emit buf       off       4181721973
  -- str head, [x21, #0]      = 0xF90002A0 | head
  let _ = cb_emit buf (off + 4)  (bit_or 4177527456 head_preg)
  -- str tail, [x21, #8]      = 0xF90006A0 | tail
  let _ = cb_emit buf (off + 8)  (bit_or 4177528480 tail_preg)
  -- add x22, x21, #16        = 0x910042B6
  let _ = cb_emit buf (off + 12) 2432713398
  -- str x22, [x27, #0]       = 0xF9000376
  let _ = cb_emit buf (off + 16) 4177527670
  -- mov dst, x21             = 0xAA0003E0 | (21<<16) | dst
  let _ = cb_emit buf (off + 20) (bit_or 2853503968 dst_preg)
  0

-- op_is_nil: cmp src, #0 ; cset dst, eq
emit_op_is_nil buf off dst_preg src_preg =
  -- cmp src, #0              = 0xF100001F | (src<<5)
  let _ = cb_emit buf       off       (bit_or 4043309087 (shl src_preg 5))
  -- cset dst, eq             = 0x9A9F17E0 | dst
  let _ = cb_emit buf (off + 4)  (bit_or 2594117600 dst_preg)
  0

-- ============================================================================
-- emit_print_int: emit ARM64 that prints `src` (a non-negative int) as decimal
-- followed by '\n' to fd=1 via the macOS svc syscall path. Fixed 64-byte
-- budget. Uses x9..x15 as scratch (caller-save, ABI-clean since we're inline
-- in a function body and don't outlive op_ret). Stack scratch at [sp,#-32]:
-- digits written right-to-left from offset +23, newline at +23, length
-- computed from final pointer.
--
-- Algorithm:
--   sub  sp, sp, #32
--   add  x10, sp, #23           ; ptr = scratch_end
--   mov  w11, #10               ; '\n'
--   strb w11, [x10]             ; *ptr = '\n'
--   mov  x12, src               ; n
--   mov  x13, #10               ; divisor
--   ; loop: emit digit, n /= 10, while n != 0
--   ; (we do at least one iteration so n=0 prints "0")
--   ; loop_top:
--   sub  x10, x10, #1
--   udiv x14, x12, x13
--   msub x15, x14, x13, x12     ; x15 = n % 10
--   add  w15, w15, #'0'
--   strb w15, [x10]
--   mov  x12, x14
--   cbnz x12, loop_top
--   ; write(1, x10, end - x10 + 1)
--   add  x9, sp, #24            ; end_excl = scratch + 24
--   sub  x2, x9, x10            ; len
--   mov  x1, x10                ; buf
--   mov  x0, #1                 ; fd=1
--   mov  x16, #4                ; SYS_write
--   svc  #0x80
--   add  sp, sp, #32
--
-- Total: 16 instructions = 64 bytes.

emit_print_int_impl buf off src =
  -- 34-instruction emit (136 bytes). Handles negative ints, writes digits
  -- to a stack-local scratch buffer, then APPENDS bytes to the heap output
  -- buffer at [x27, #8] (no syscall — output capture for distill grading).
  -- Constants verified via /tmp/asmtest_negprint.s and /tmp/asmtest_p0_v2.s.
  --
  -- Layout:
  --   0     mov x12, x_src
  --   1-5   sign detection: x21=sign_flag, neg if negative
  --   6-10  scratch buf setup, '\n', divisor
  --   11-17 digit loop (write digits backward into stack scratch)
  --   18-21 conditionally prepend '-' if x21==1
  --   22-23 length calc (x9 = sp+24, x2 = x9-x10)
  --   24-32 NEW: copy [x10, x10+x2) to [heap_cursor, heap_cursor+x2);
  --             update cursor at [x27, #8]
  --   33    add sp, sp, #32 (restore stack)

  -- 0: mov x12, x_src                  = 0xAA0003EC | (src<<16)
  let _ = cb_emit buf       off       (bit_or 2852127724 (shl src 16))
  -- 1: mov x21, #0                     = 0xD2800015
  let _ = cb_emit buf (off + 4)   3531603989
  -- 2: cmp x12, #0                     = 0xF100019F
  let _ = cb_emit buf (off + 8)   4043309471
  -- 3: b.ge +3 instr (skip neg setup)  = 0x5400006A
  let _ = cb_emit buf (off + 12)  1409286250
  -- 4: mov x21, #1                     = 0xD2800035
  let _ = cb_emit buf (off + 16)  3531604021
  -- 5: neg x12, x12                    = 0xCB0C03EC
  let _ = cb_emit buf (off + 20)  3406562284
  -- 6: sub sp, sp, #32                 = 0xD10083FF
  let _ = cb_emit buf (off + 24)  3506471935
  -- 7: add x10, sp, #23                = 0x91005FEA
  let _ = cb_emit buf (off + 28)  2432720874
  -- 8: mov w11, #10                    = 0x5280014B
  let _ = cb_emit buf (off + 32)  1384120651
  -- 9: strb w11, [x10]                 = 0x3900014B
  let _ = cb_emit buf (off + 36)  956301643
  -- 10: mov x13, #10                   = 0xD280014D
  let _ = cb_emit buf (off + 40)  3531604301
  -- 11: sub x10, x10, #1 (LOOP_TOP)    = 0xD100054A
  let _ = cb_emit buf (off + 44)  3506439498
  -- 12: udiv x14, x12, x13             = 0x9ACD098E
  let _ = cb_emit buf (off + 48)  2597128590
  -- 13: msub x15, x14, x13, x12        = 0x9B0DB1CF
  let _ = cb_emit buf (off + 52)  2601365967
  -- 14: add w15, w15, #0x30            = 0x1100C1EF
  let _ = cb_emit buf (off + 56)  285262319
  -- 15: strb w15, [x10]                = 0x3900014F
  let _ = cb_emit buf (off + 60)  956301647
  -- 16: mov x12, x14                   = 0xAA0E03EC
  let _ = cb_emit buf (off + 64)  2853045228
  -- 17: cbnz x12, LOOP_TOP -6 instr    = 0xB5FFFF4C
  let _ = cb_emit buf (off + 68)  3053453132
  -- 18: cbz x21, +3 instr (no_minus)   = 0xB4000075
  let _ = cb_emit buf (off + 72)  3019898997
  -- 19: sub x10, x10, #1               = 0xD100054A
  let _ = cb_emit buf (off + 76)  3506439498
  -- 20: mov w15, #45 ('-')             = 0x528005AF
  let _ = cb_emit buf (off + 80)  1384121775
  -- 21: strb w15, [x10]                = 0x3900014F
  let _ = cb_emit buf (off + 84)  956301647
  -- 22: add x9, sp, #24                = 0x910063E9
  let _ = cb_emit buf (off + 88)  2432721897
  -- 23: sub x2, x9, x10                = 0xCB0A0122
  let _ = cb_emit buf (off + 92)  3406430498
  -- 24: ldr x21, [x27, #8]             = 0xF9400775
  let _ = cb_emit buf (off + 96)  4181722997
  -- 25: cbz x2, +7 inst (mem_done)     = 0xB40000E2
  let _ = cb_emit buf (off + 100) 3019899106
  -- 26: ldrb w22, [x10]                = 0x39400156
  let _ = cb_emit buf (off + 104) 960495958
  -- 27: strb w22, [x21]                = 0x390002B6
  let _ = cb_emit buf (off + 108) 956302006
  -- 28: add x10, x10, #1               = 0x9100054A
  let _ = cb_emit buf (off + 112) 2432697674
  -- 29: add x21, x21, #1               = 0x910006B5
  let _ = cb_emit buf (off + 116) 2432698037
  -- 30: sub x2, x2, #1                 = 0xD1000442
  let _ = cb_emit buf (off + 120) 3506439234
  -- 31: cbnz x2, -5 inst (mem_loop)    = 0xB5FFFF62
  let _ = cb_emit buf (off + 124) 3053453154
  -- 32: str x21, [x27, #8]             = 0xF9000775
  let _ = cb_emit buf (off + 128) 4177528693
  -- 33: add sp, sp, #32                = 0x910083FF
  let _ = cb_emit buf (off + 132) 2432730111
  0
