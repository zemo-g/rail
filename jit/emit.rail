-- jit/emit.rail — IR -> ARM64 bytes.
-- Register mapping (ABI v1):
--   v0..v9   -> x9..x18   (caller-save: clobbered by op_call)
--   v10..v19 -> x19..x28  (callee-save: preserved across op_call;
--                          for v1 only x19/x20 are saved by prologue)
--
-- Function frame (32 bytes):
--   Prologue (16 bytes):
--     stp x29, x30, [sp, #-32]!     ; reserve frame, save FP/LR
--     mov x29, sp                    ; set up new FP
--     stp x19, x20, [sp, #16]       ; save callee-save pair
--     mov v0_preg, x0                ; copy input arg into v0
--   Epilogue (16 bytes, emitted as part of op_ret):
--     mov x0, vN                     ; load return value
--     ldp x19, x20, [sp, #16]       ; restore callee-save pair
--     ldp x29, x30, [sp], #32       ; restore FP/LR, dealloc frame
--     ret
--
-- op_call (12 bytes; ABI: 1 int arg, 1 int return):
--   IR: a=dst_reg, b=fn_index, c=arg_reg
--     mov x0, x_preg(c)              ; load arg
--     bl  <target_fn_offset>         ; relative call
--     mov x_preg(a), x0              ; capture return
--
-- op_mov (4 bytes): a=dst_reg, b=src_reg → mov xDst, xSrc

import "jit/ir.rail"
import "jit/arm64.rail"
import "jit/codebuf.rail"

-- IR vreg N -> physical x(N + 9).
preg vreg = vreg + 9

-- Per-function fixed costs (inlined as literals to avoid Rail's
-- nullary-int + let-bound-int sum bug).
--   prologue = stp_fp_lr + mov_x29_sp + stp_x19_x20 + mov_v0_x0 = 16
--   epilogue = ldp_x19_x20 + ldp_fp_lr + ret = 12 (mov_x0_vN counted in op_ret)

-- Bytes per IR opcode (FIXED-size opcodes only).
-- For variable-size opcodes (op_call), use ir_byte_size_at.
ir_byte_size op =
  if op == op_const then 16
  else if op == op_add then 4
  else if op == op_sub then 4
  else if op == op_mul then 4
  else if op == op_lt then 8
  else if op == op_jmp then 4
  else if op == op_jz then 4
  else if op == op_ret then 16
  else if op == op_print_int then 80
  else if op == op_mov then 4
  else if op == op_str_lit then 4
  else if op == op_print_str then 20
  else if op == op_str_len then 4
  else 4

-- Variable-size lookup. Reads the instruction's c slot for op_call
-- to compute n_args, returning 4*(n_args+2) bytes. Other opcodes
-- forward to ir_byte_size.
ir_byte_size_at ir i =
  let op = ir_op ir i
  if op == op_call then
    let n = call_n_args (ir_c ir i)
    4 + 4 + 4 * n   -- bl(4) + mov dst,x0(4) + n arg-movs(4n)
  else ir_byte_size op

-- Pass 1: compute, for each IR instruction index i, the byte offset
-- where its emitted ARM64 sequence starts, RELATIVE TO THE FUNCTION'S
-- BODY START (i.e., after the prologue). Returns int_arr of size n+1
-- where slot[n] = total body bytes.
compute_body_offsets ir n_instr =
  let off_arr = arr_new (n_instr + 1) 0
  let _ = fill_offsets ir n_instr off_arr 0 0
  off_arr

fill_offsets ir n_instr off_arr i acc =
  if i >= n_instr then
    let _ = arr_set off_arr i acc
    0
  else
    let _ = arr_set off_arr i acc
    let sz = ir_byte_size_at ir i
    fill_offsets ir n_instr off_arr (i + 1) (acc + sz)

-- Total bytes for one function.
fn_total_bytes fn =
  let ir = fn_ir fn
  let n_instr = fn_ninstr fn
  let body = compute_body_offsets ir n_instr
  let body_bytes = arr_get body n_instr
  16 + body_bytes

-- emit_print_int: stub for now — body filled in below.
emit_print_int buf off src =
  emit_print_int_impl buf off src

-- Build a 64-bit constant via movz + 3 movks (fixed 16-byte budget).
emit_const buf off dst imm =
  let p0 = bit_and imm 65535
  let p1 = bit_and (shr imm 16) 65535
  let p2 = bit_and (shr imm 32) 65535
  let p3 = bit_and (shr imm 48) 65535
  let _ = cb_emit buf       off       (enc_mov_imm16 dst p0)
  let _ = cb_emit buf (off + 4)  (enc_movk dst p1 1)
  let _ = cb_emit buf (off + 8)  (enc_movk dst p2 2)
  let _ = cb_emit buf (off + 12) (enc_movk dst p3 3)
  0

-- Emit prologue at the function's start byte offset in the buffer.
-- Writes 16 bytes: stp_fp_lr + mov_x29_sp + stp_x19_x20 + mov_v0_x0.
emit_prologue buf fn_start =
  let _ = cb_emit buf       fn_start       inst_stp_fp_lr_pre
  let _ = cb_emit buf (fn_start + 4)  inst_mov_x29_sp
  let _ = cb_emit buf (fn_start + 8)  inst_stp_x19_x20_16
  let _ = cb_emit buf (fn_start + 12) (enc_mov_reg (preg 0) 0)
  0

-- Block-byte-offset lookup, given the function's body start and its
-- per-instruction body-relative offsets array.
block_byte_offset_in_fn body_start blocks body_offsets k =
  let instr_idx = arr_get blocks k
  body_start + (arr_get body_offsets instr_idx)

-- Pass 2 emit one IR instruction at its absolute byte offset in the buffer.
-- body_start = byte offset of function body start in buf (= fn_start + 12).
-- body_offsets = per-instruction body-relative offsets.
-- fn_offsets = per-function absolute start offset (only used by op_call); may be 0
--   for emit_function singletons that don't use op_call.
emit_one buf ir body_start body_offsets blocks fn_offsets i =
  let off = body_start + (arr_get body_offsets i)
  let op = ir_op ir i
  let a = ir_op_a_or_b ir i 1
  let b = ir_op_a_or_b ir i 2
  let c = ir_op_a_or_b ir i 3
  if op == op_const then
    emit_const buf off (preg a) b
  else if op == op_add then
    cb_emit buf off (enc_add (preg a) (preg b) (preg c))
  else if op == op_sub then
    cb_emit buf off (enc_sub (preg a) (preg b) (preg c))
  else if op == op_mul then
    cb_emit buf off (enc_mul (preg a) (preg b) (preg c))
  else if op == op_lt then
    let _ = cb_emit buf       off       (enc_cmp (preg b) (preg c))
    let _ = cb_emit buf (off + 4) (enc_cset_lt (preg a))
    0
  else if op == op_jmp then
    let target_off = block_byte_offset_in_fn body_start blocks body_offsets a
    let rel = target_off - off
    cb_emit buf off (enc_b_byte_off rel)
  else if op == op_jz then
    let target_off = block_byte_offset_in_fn body_start blocks body_offsets b
    let rel = target_off - off
    cb_emit buf off (enc_cbz_byte_off (preg a) rel)
  else if op == op_call then
    emit_op_call buf off a b c fn_offsets
  else if op == op_ret then
    let _ = cb_emit buf       off       (enc_mov_reg 0 (preg a))
    let _ = cb_emit buf (off + 4)  inst_ldp_x19_x20_16
    let _ = cb_emit buf (off + 8)  inst_ldp_fp_lr_post
    let _ = cb_emit buf (off + 12) enc_ret
    0
  else if op == op_mov then
    cb_emit buf off (enc_mov_reg (preg a) (preg b))
  else if op == op_print_int then
    emit_print_int buf off (preg a)
  else if op == op_str_lit then
    emit_op_str_lit buf off (preg a) b fn_offsets
  else if op == op_print_str then
    emit_op_print_str buf off (preg a)
  else if op == op_str_len then
    emit_op_str_len buf off (preg a) (preg b)
  else
    -- Unknown op: emit a safe ret(0) so we never run garbage.
    let _ = cb_emit buf       off       (enc_mov_reg 0 0)
    let _ = cb_emit buf (off + 4)  inst_ldp_x19_x20_16
    let _ = cb_emit buf (off + 8)  inst_ldp_fp_lr_post
    let _ = cb_emit buf (off + 12) enc_ret
    0

-- Multi-arg op_call emit. Decodes packed c (n_args + arg vregs), emits:
--   for each i in 0..n-1: mov xi, x_preg(arg_i)
--   bl <target_fn_offset>
--   mov x_preg(dst), x0
emit_op_call buf off a b c fn_offsets =
  let n = call_n_args c
  let arg0 = call_arg_0 c
  let arg1 = call_arg_1 c
  let arg2 = call_arg_2 c
  let arg3 = call_arg_3 c
  let _ = if n >= 1 then cb_emit buf       off       (enc_mov_reg 0 (preg arg0)) else 0
  let _ = if n >= 2 then cb_emit buf (off + 4)  (enc_mov_reg 1 (preg arg1)) else 0
  let _ = if n >= 3 then cb_emit buf (off + 8)  (enc_mov_reg 2 (preg arg2)) else 0
  let _ = if n >= 4 then cb_emit buf (off + 12) (enc_mov_reg 3 (preg arg3)) else 0
  let bl_off = off + 4 * n
  let target_fn_start = arr_get fn_offsets b
  let rel = target_fn_start - bl_off
  let _ = cb_emit buf bl_off (enc_bl_byte_off rel)
  let _ = cb_emit buf (bl_off + 4) (enc_mov_reg (preg a) 0)
  0

-- Helper: read slot a/b/c from instruction i. Slot 1=a, 2=b, 3=c.
ir_op_a_or_b ir i which =
  if which == 1 then ir_a ir i
  else if which == 2 then ir_b ir i
  else ir_c ir i

emit_loop buf ir body_start body_offsets blocks fn_offsets i n_instr =
  if i >= n_instr then 0
  else
    let _ = emit_one buf ir body_start body_offsets blocks fn_offsets i
    emit_loop buf ir body_start body_offsets blocks fn_offsets (i + 1) n_instr

-- Emit one function into buf starting at fn_start. Returns the size in bytes.
emit_one_function buf fn_start fn fn_offsets =
  let ir = fn_ir fn
  let n_instr = fn_ninstr fn
  let blocks = fn_blocks fn
  let body_offsets = compute_body_offsets ir n_instr
  let body_bytes = arr_get body_offsets n_instr
  let body_start = fn_start + 16
  let _ = emit_prologue buf fn_start
  let _ = emit_loop buf ir body_start body_offsets blocks fn_offsets 0 n_instr
  16 + body_bytes

-- Emit a single-function program. For backward compat with existing tests.
-- Returns [buf, total_bytes].
emit_function fn =
  let total = fn_total_bytes fn
  let buf = make_codebuf (total / 4)
  let fn_offsets = arr_new 2 0
  let _ = arr_set fn_offsets 1 total       -- total_code at last slot for op_str_lit
  let _ = emit_one_function buf 0 fn fn_offsets
  cons buf (cons total [])

-- Emit a multi-function program. With pool support.
-- Input: fn_list = Rail list of function structs;
--        pool    = [pool_buf int_arr, pool_size_cell int_arr] (or [] for none).
-- Output: [buf, total_bytes, fn_offsets_arr]
--   fn_offsets_arr is sized n+1; slot n holds total_code_bytes for the
--   adr-relative resolution of op_str_lit.
emit_program fn_list pool =
  let n = list_len fn_list
  let fn_offsets = arr_new (n + 1) 0
  let total_code = compute_fn_starts fn_list n fn_offsets 0 0
  let _ = arr_set fn_offsets n total_code
  let pool_size = if pool == [] then 0 else arr_get (head (tail pool)) 0
  let total_bytes = total_code + pool_size
  let buf = arr_new total_bytes 0
  let _ = emit_each_function buf fn_list n fn_offsets 0
  let _ = if pool_size > 0 then copy_pool_bytes buf total_code (head pool) pool_size 0 else 0
  cons buf (cons total_bytes (cons fn_offsets []))

copy_pool_bytes dst dst_off src_buf n_bytes i =
  if i >= n_bytes then 0
  else
    let _ = arr_set dst (dst_off + i) (arr_get src_buf i)
    copy_pool_bytes dst dst_off src_buf n_bytes (i + 1)

-- Walk fn_list, fill fn_offsets[k] with running byte offset, return total bytes.
compute_fn_starts fn_list n fn_offsets k acc =
  if k >= n then acc
  else
    let _ = arr_set fn_offsets k acc
    let fn = nth_fn fn_list k
    let sz = fn_total_bytes fn
    compute_fn_starts fn_list n fn_offsets (k + 1) (acc + sz)

emit_each_function buf fn_list n fn_offsets k =
  if k >= n then 0
  else
    let fn = nth_fn fn_list k
    let fn_start = arr_get fn_offsets k
    let _ = emit_one_function buf fn_start fn fn_offsets
    emit_each_function buf fn_list n fn_offsets (k + 1)

-- Local helpers (don't depend on stdlib).
list_len xs =
  if xs == [] then 0
  else 1 + list_len (tail xs)

nth_fn xs k =
  if k == 0 then head xs
  else nth_fn (tail xs) (k - 1)

emitted_buf res = head res
emitted_size res = head (tail res)
emitted_offsets res = head (tail (tail res))

-- ============================================================================
-- String-op emitters
-- ============================================================================

-- op_str_lit: load PC-relative address of the pool entry into dst_preg.
-- fn_offsets's last slot holds total_code_bytes (set by emit_program).
emit_op_str_lit buf off dst_preg pool_offset fn_offsets =
  let n = arr_len fn_offsets
  let total_code = arr_get fn_offsets (n - 1)
  let target = total_code + pool_offset
  let rel = target - off
  cb_emit buf off (enc_adr dst_preg rel)

-- op_print_str: ptr in src_preg points to length-prefixed string.
-- Sequence: ldr x2,[src,#0] ; add x1,src,#8 ; mov x0,#1 ; mov x16,#4 ; svc #0x80
-- All constants verified via /tmp/asmtest_pstr.s + python conversion.
emit_op_print_str buf off src_preg =
  -- ldr x2, [src_preg, #0]   = 0xF9400002 | (src_preg<<5)
  let _ = cb_emit buf       off       (bit_or 4181721090 (shl src_preg 5))
  -- add x1, src_preg, #8     = 0x91002001 | (src_preg<<5)
  let _ = cb_emit buf (off + 4)  (bit_or 2432704513 (shl src_preg 5))
  -- mov x0, #1               = 0xD2800020
  let _ = cb_emit buf (off + 8)  3531604000
  -- mov x16, #4              = 0xD2800090
  let _ = cb_emit buf (off + 12) 3531604112
  -- svc #0x80                = 0xD4001001
  let _ = cb_emit buf (off + 16) 3556773889
  0

-- op_str_len: dst = *src (8-byte length prefix at offset 0).
-- ldr xdst, [xsrc, #0]   = 0xF9400000 | (src_preg<<5) | dst_preg
emit_op_str_len buf off dst_preg src_preg =
  cb_emit buf off (bit_or (bit_or 4181721088 dst_preg) (shl src_preg 5))

-- ============================================================================
-- emit_print_int: emit ARM64 that prints `src` (a non-negative int) as decimal
-- followed by '\n' to fd=1 via the macOS svc syscall path. Fixed 64-byte
-- budget. Uses x9..x15 as scratch (caller-save, ABI-clean since we're inline
-- in a function body and don't outlive op_ret). Stack scratch at [sp,#-32]:
-- digits written right-to-left from offset +23, newline at +23, length
-- computed from final pointer.
--
-- Algorithm:
--   sub  sp, sp, #32
--   add  x10, sp, #23           ; ptr = scratch_end
--   mov  w11, #10               ; '\n'
--   strb w11, [x10]             ; *ptr = '\n'
--   mov  x12, src               ; n
--   mov  x13, #10               ; divisor
--   ; loop: emit digit, n /= 10, while n != 0
--   ; (we do at least one iteration so n=0 prints "0")
--   ; loop_top:
--   sub  x10, x10, #1
--   udiv x14, x12, x13
--   msub x15, x14, x13, x12     ; x15 = n % 10
--   add  w15, w15, #'0'
--   strb w15, [x10]
--   mov  x12, x14
--   cbnz x12, loop_top
--   ; write(1, x10, end - x10 + 1)
--   add  x9, sp, #24            ; end_excl = scratch + 24
--   sub  x2, x9, x10            ; len
--   mov  x1, x10                ; buf
--   mov  x0, #1                 ; fd=1
--   mov  x16, #4                ; SYS_write
--   svc  #0x80
--   add  sp, sp, #32
--
-- Total: 16 instructions = 64 bytes.

emit_print_int_impl buf off src =
  -- All constants verified against `as`+otool. Source register moved to
  -- byte 0 (was byte 16) to avoid clobbering it via x10 setup when src
  -- happens to be x10 (preg(v1)). See /tmp/asmtest_print2.s.
  -- mov x12, x_src  (orr x12, xzr, x_src)    = 0xAA0003EC | (src<<16)
  let _ = cb_emit buf       off       (bit_or 2852127724 (shl src 16))
  -- sub sp, sp, #32                          ; 0xD10083FF
  let _ = cb_emit buf (off + 4)   3506471935
  -- add x10, sp, #23                         ; 0x91005FEA
  let _ = cb_emit buf (off + 8)   2432720874
  -- mov w11, #10                             ; 0x5280014B
  let _ = cb_emit buf (off + 12)  1384120651
  -- strb w11, [x10]                          ; 0x3900014B
  let _ = cb_emit buf (off + 16)  956301643
  -- mov x13, #10                             ; 0xD280014D
  let _ = cb_emit buf (off + 20)  3531604301
  -- LOOP_TOP:
  -- sub x10, x10, #1                         ; 0xD100054A
  let _ = cb_emit buf (off + 24)  3506439498
  -- udiv x14, x12, x13                       ; 0x9ACD098E
  let _ = cb_emit buf (off + 28)  2597128590
  -- msub x15, x14, x13, x12                  ; 0x9B0DB1CF
  let _ = cb_emit buf (off + 32)  2601365967
  -- add w15, w15, #0x30                      ; 0x1100C1EF
  let _ = cb_emit buf (off + 36)  285262319
  -- strb w15, [x10]                          ; 0x3900014F
  let _ = cb_emit buf (off + 40)  956301647
  -- mov x12, x14  (orr x12, xzr, x14)        ; 0xAA0E03EC
  let _ = cb_emit buf (off + 44)  2853045228
  -- cbnz x12, loop_top  (offset -6 instr)    ; 0xB5FFFF4C
  let _ = cb_emit buf (off + 48)  3053453132
  -- add x9, sp, #24                          ; 0x910063E9
  let _ = cb_emit buf (off + 52)  2432721897
  -- sub x2, x9, x10                          ; 0xCB0A0122
  let _ = cb_emit buf (off + 56)  3406430498
  -- mov x1, x10                              ; 0xAA0A03E1
  let _ = cb_emit buf (off + 60)  2852783073
  -- mov x0, #1                               ; 0xD2800020
  let _ = cb_emit buf (off + 64)  3531604000
  -- mov x16, #4                              ; 0xD2800090
  let _ = cb_emit buf (off + 68)  3531604112
  -- svc #0x80                                ; 0xD4001001
  let _ = cb_emit buf (off + 72)  3556773889
  -- add sp, sp, #32                          ; 0x910083FF
  let _ = cb_emit buf (off + 76)  2432730111
  0
