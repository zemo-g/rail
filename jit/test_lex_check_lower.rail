-- jit/test_lex_check_lower.rail — verify jit_lex_check.rail lowers cleanly
-- and executes correctly via the JIT pipeline.

import "jit/heap.rail"
import "jit/emit.rail"
import "jit/loader.rail"
import "jit/lower.rail"

-- Source string IS the body of tools/orch/jit_lex_check.rail (single-line
-- per fn — JIT lower.rail parser is newline-significant between decls).
-- If you edit tools/orch/jit_lex_check.rail, mirror the change here.
-- Packed-arg version: i*1048576 + n, avoids the 3-arg recursion limit
-- in lower.rail v1 (only 2 callee-save slots). 1M divisor caps file size
-- at ~1MB, ample for bench samples (<1KB typical).
lex_check_src _ =
  cat ["ascii_ok s ip = let i = ip / 1048576 in let n = ip - i * 1048576 in if i >= n then 1 else let b = str_at s i in if b == 9 then ascii_ok s (ip + 1048576) else if b == 10 then ascii_ok s (ip + 1048576) else if b == 13 then ascii_ok s (ip + 1048576) else if b < 32 then 0 else if b > 126 then 0 else ascii_ok s (ip + 1048576)\n",
       "has_eq s ip = let i = ip / 1048576 in let n = ip - i * 1048576 in if i >= n then 0 else if str_at s i == 61 then 1 else has_eq s (ip + 1048576)\n",
       "main = let s = read_file \"/tmp/jit_lex_input.txt\" in let n = str_len s in if n < 5 then 0 else if ascii_ok s n == 0 then 0 else has_eq s n\n"]

run_case label payload expected =
  let _ = write_file "/tmp/jit_lex_input.txt" payload
  let r = lower_source (lex_check_src 0)
  if (head r) == "err" then
    let _ = print (cat ["[", label, "] LOWER FAIL: ", head (tail r)])
    1
  else
    let fns = head (tail r)
    let pool = head (tail (tail r))
    let heap = heap_alloc 0
    let res = emit_program fns pool heap
    let buf = emitted_buf res
    let nbytes = emitted_size res
    let page = make_executable buf nbytes
    let got = call_jit page heap
    let _ = free_jit page
    let _ = heap_free heap
    if got == expected then
      let _ = print (cat ["[", label, "] OK got=", show got, " (", show nbytes, "B)"])
      0
    else
      let _ = print (cat ["[", label, "] FAIL got=", show got, " expected=", show expected])
      1

main =
  let c1 = run_case "valid_main"     "main = 7 + 13"               1
  let c2 = run_case "valid_with_eq"  "x = 5\nmain = x"             1
  let c3 = run_case "no_eq"          "just words no equals here"   0
  let c4 = run_case "too_short"      "ab"                          0
  let c5 = run_case "non_ascii"      "main = \xc3\xa9rror"         0
  let c6 = run_case "ctrl_char"      "main \x01 = 5"               0
  let c7 = run_case "newlines_ok"    "a = 1\nb = 2\n"              1
  let c8 = run_case "tabs_ok"        "a\t=\t1"                     1
  let total = c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8
  if total == 0 then
    let _ = print "JIT_LEX_CHECK ALL PASS (8/8)"
    0
  else
    let _ = print (cat ["JIT_LEX_CHECK FAILS: ", show total])
    1
