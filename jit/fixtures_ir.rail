-- jit/fixtures_ir.rail
--
-- Hand-built IR fixtures for Sessions B (optimizer) and C (codegen) so
-- they can test their passes without depending on the parser.
--
-- Each fixture is exported as a 1-arg helper (pass 0; arg ignored) returning
-- the function struct documented in jit/ir.rail.
--
-- Convention: r0 is the (single) input register where applicable; remaining
-- registers are SSA-style locals.  All fixtures have a single block (block 0)
-- so codegen consumers can ignore CFG complexity, except where noted.
--
-- NOTE: this file deliberately does NOT `import "jit/ir.rail"`.  See the
-- import-order note at the top of jit/parse.rail.

-- Helper: build a 1-block function struct from a fully-populated ir_arr.
fix_one_block ir n_instr n_regs =
  let blocks = arr_new 1 0
  let _ = arr_set blocks 0 0
  make_function ir n_instr n_regs blocks

-- (2+3)+x where x is in r0.
--   i0: CONST r1, 2
--   i1: CONST r2, 3
--   i2: ADD   r3, r1, r2     -- 2+3 (constant-foldable to 5)
--   i3: ADD   r4, r3, r0     -- + x
--   i4: RET   r4
fixture_add_constants _ =
  let ir = make_ir 5
  let _ = ir_emit ir 0 (op_const 0) 1 2 0
  let _ = ir_emit ir 1 (op_const 0) 2 3 0
  let _ = ir_emit ir 2 (op_add 0)   3 1 2
  let _ = ir_emit ir 3 (op_add 0)   4 3 0
  let _ = ir_emit ir 4 (op_ret 0)   4 0 0
  fix_one_block ir 5 5

-- Defined-but-never-used register (r1 is dead).
--   i0: CONST r1, 99         -- dead def
--   i1: CONST r2, 5
--   i2: RET   r2
fixture_dead_def _ =
  let ir = make_ir 3
  let _ = ir_emit ir 0 (op_const 0) 1 99 0
  let _ = ir_emit ir 1 (op_const 0) 2 5 0
  let _ = ir_emit ir 2 (op_ret 0)   2 0 0
  fix_one_block ir 3 3

-- f(x) = x + 5; x in r0.
--   i0: CONST r1, 5
--   i1: ADD   r2, r0, r1
--   i2: RET   r2
fixture_x_plus_5 _ =
  let ir = make_ir 3
  let _ = ir_emit ir 0 (op_const 0) 1 5 0
  let _ = ir_emit ir 1 (op_add 0)   2 0 1
  let _ = ir_emit ir 2 (op_ret 0)   2 0 0
  fix_one_block ir 3 3

-- f(x) = x*x + 1; x in r0.
--   i0: MUL   r1, r0, r0
--   i1: CONST r2, 1
--   i2: ADD   r3, r1, r2
--   i3: RET   r3
fixture_x_squared_plus_1 _ =
  let ir = make_ir 4
  let _ = ir_emit ir 0 (op_mul 0)   1 0 0
  let _ = ir_emit ir 1 (op_const 0) 2 1 0
  let _ = ir_emit ir 2 (op_add 0)   3 1 2
  let _ = ir_emit ir 3 (op_ret 0)   3 0 0
  fix_one_block ir 4 4
